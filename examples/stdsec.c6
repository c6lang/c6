/* examples/stdsec.c6 —— 第八十五批（密钥交换 + 传输安全策略 + 抓取许可 + 45 进制）。
 *
 *     make std-sec
 *
 * 五节，每节都按方法风格调用（`alice.init(...)`、`st.add(...)`、`d.next(&e)`）：
 *   1. X25519：双方各算一次公钥、交换后共享密钥一致，非法公钥被拒；
 *   2. HSTS：解析 `Strict-Transport-Security`，写进策略库，按主机/子域/有效期判定；
 *   3. robots.txt：装载规则，按最长匹配判定能不能抓；
 *   4. Base45：一次性编解码 + 流式编码器分片喂；
 *   5. 串联：一条「响应头 → 策略 → 抓取许可 → 密钥指纹」的流水线。
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.net.x25519;
import std.net.hsts;
import std.net.robots;
import std.encoding.base45;

static int checks = 0;
static int nfail = 0;

static void check(int cond, const char *what)
{
    checks++;
    if (!cond) {
        nfail++;
        printf("   ✗ %s\n", what);
    }
}

static void hex32(const u8 *b, char *out)
{
    static const char *hex = "0123456789abcdef";
    int i = 0;

    for (i = 0; i < 32; i++) {
        out[i * 2] = hex[b[i] >> 4];
        out[i * 2 + 1] = hex[b[i] & 0xf];
    }
    out[64] = 0;
}

/* 1. X25519 密钥交换 */
static void do_x25519(void)
{
    u8 sa[32] = { 0 }, sb[32] = { 0 };
    u8 zero[32] = { 0 };
    u8 ka[32] = { 0 }, kb[32] = { 0 };
    char hex[72] = { 0 };
    Dh alice = { { 0 }, { 0 }, 0 };
    Dh bob = { { 0 }, { 0 }, 0 };

    printf("== x25519（Curve25519 密钥交换）\n");
    /* 两个固定私钥（真实代码请用 std.encoding.random） */
    for (int i = 0; i < 32; i++) {
        sa[i] = (u8)(i + 1);
        sb[i] = (u8)(0x80 + i);
    }
    check(alice.init(sa) == 1, "alice.init");
    check(bob.init(sb) == 1, "bob.init");
    check(alice.is_ready() && bob.is_ready(), "双方都就绪");
    check(memcmp(alice.public_key(), bob.public_key(), 32) != 0, "两个公钥不同");
    /* clamp：私钥低 3 位清零、最高位清零、次高位置 1 */
    check((alice.private_key()[0] & 7) == 0, "私钥低 3 位被清零");
    check((alice.private_key()[31] & 0x80) == 0, "私钥最高位被清零");
    check((alice.private_key()[31] & 0x40) == 0x40, "私钥次高位被置 1");

    check(alice.agree(ka, bob.public_key()) == 1, "alice 算共享密钥");
    check(bob.agree(kb, alice.public_key()) == 1, "bob 算共享密钥");
    check(memcmp(ka, kb, 32) == 0, "双方共享密钥一致");
    hex32(ka, hex);
    printf("   shared = %s…\n", hex);

    /* 非法公钥（全零）必须被拒 */
    check(alice.agree(ka, zero) == 0, "全零公钥被拒");
    check(is_zero(zero) == 1, "is_zero 认得出全零");
    /* 自己和自己协商也能算（等价于用别人的公钥当自己的） */
    check(bob.agree(kb, bob.public_key()) == 1, "公钥和自己协商仍可算");
    /* 基点接口：x25519_base 与 init 的公钥一致 */
    {
        u8 base_pub[32] = { 0 };

        check(x25519_base(base_pub, alice.private_key()) == 1, "x25519_base");
        check(memcmp(base_pub, alice.public_key(), 32) == 0, "base 与 init 一致");
    }
}

/* 2. HSTS */
static void do_hsts(void)
{
    HstsPolicy p = { 0 };
    HstsStore st = { 0 };
    HstsDoc d = { 0 };
    HstsEntry e = { 0 };
    long now = 1700000000;

    printf("== hsts（Strict-Transport-Security 策略库）\n");
    check(hsts_parse("max-age=31536000; includeSubDomains", &p) == 1, "解析响应头");
    check(p.max_age == 31536000 && p.subdomains == 1, "两个字段都对");
    check(hsts_parse("includeSubDomains", &p) == 0, "缺 max-age 判失败");
    check(hsts_parse("max-age=600", &p) == 1 && p.subdomains == 0, "不带子域开关");

    st.init();
    check(st.count() == 0, "空库");
    check(st.add("Example.com.", 86400, 1, now) == 1, "写入（大写 + 末尾点）");
    check(st.match("example.com", now) == 1, "精确命中");
    check(st.match("api.example.com", now) == 1, "子域命中");
    check(st.match("example.org", now) != 1, "别的主机不命中");
    check(st.match("127.0.0.1", now) == 0, "IP 字面量不适用");
    check(st.add("plain.test", 60, 0, now) == 1, "第二条写入");
    check(st.match("sub.plain.test", now) == 0, "没开子域时不命中");
    check(st.match("plain.test", now + 59) == 1, "过期前命中");
    check(st.match("plain.test", now + 60) == 0, "到点算过期");
    check(st.expired(now + 3600) == 1, "过期计数 1");
    check(st.prune(now + 3600) == 1 && st.count() == 1, "prune 清掉 1 条");

    d.open(&st);
    check(d.count() == 0, "游标初始为 0");
    check(d.next(&e) == 1 && strcmp(e.host, "example.com") == 0, "第一条是 example.com");
    check(e.max_age == 86400 && e.subdomains == 1, "条目字段都在");
    check(d.next(&e) == 0, "只有一条");
    check(d.count() == 1, "游标走了 1 条");
    d.reset();
    check(d.next(&e) == 1, "reset 后还能从头读");
    check(st.add("example.com", 0, 0, now) == 0 && st.count() == 0, "max-age=0 撤销");
}

/* 3. robots.txt */
static void do_robots(void)
{
    const char *text = "User-agent: *\n"
                       "Disallow: /admin\n"
                       "Allow: /admin/public\n"
                       "Disallow: /*.zip$\n"
                       "Sitemap: https://example.com/sitemap.xml\n";
    Robots rb = { 0 };
    RobotsDoc d = { 0 };
    RobotsLine ln = { 0 };

    printf("== robots（robots.txt 抓取许可）\n");
    rb.init();
    check(rb.load(text, (int)strlen(text), "c6bot") == 3, "装载 3 条规则");
    check(rb.allowed("/index.html") == 1, "普通页面允许");
    check(rb.allowed("/admin/x") == 0, "Disallow 挡住");
    check(rb.allowed("/admin/public/a") == 1, "更长的 Allow 赢");
    check(rb.allowed("/dl/a.zip") == 0, "$ 锚定命中");
    check(rb.allowed("/dl/a.zip?x=1") == 1, "带查询串不命中 $");
    check(rb.sitemap_count() == 1, "收集到 1 条 sitemap");
    check(strcmp(rb.sitemap(0), "https://example.com/sitemap.xml") == 0, "sitemap 内容对");
    d.open(text, (int)strlen(text));
    while (d.next(&ln))
        ;
    check(d.count() == 5, "游标扫出 5 条指令");
    check(rb.dropped() == 0, "没有超容量丢弃");
}

/* 4. Base45 */
static void do_base45(void)
{
    char out[64] = { 0 };
    u8 back[64] = { 0 };
    u8 key[16] = { 0 };
    B45Enc enc = { 0 };
    char stream[64] = { 0 };

    printf("== base45（RFC 9285 编解码 + 流式编码器）\n");
    check(b45_encode((const u8 *)"Hello!!", 7, out, sizeof out) == 11, "编码长度 11");
    check(memcmp(out, "%69 VD92EX0", 11) == 0, "RFC 9285 向量");
    check(b45_decode((char[:]){ out, 11 }, back, sizeof back) == 7, "解码回 7 字节");
    check(memcmp(back, "Hello!!", 7) == 0, "解码内容对");
    check(b45_decoded_len((char[:]){ out, 11 }) == 7, "长度函数一致");

    for (int i = 0; i < 16; i++)
        key[i] = (u8)(i * 17 + 3);
    enc.init(stream, sizeof stream);
    /* 分三片喂：5 + 5 + 6 字节 */
    check(enc.put(key, 5) == 6, "第一片写出 6 个字符（4 字节成组，1 字节待定）");
    check(enc.put(key + 5, 5) == 15, "第二片累计 15 个字符");
    check(enc.put(key + 10, 6) == 24, "第三片累计 24 个字符");
    check(enc.finish() == 24, "收尾后 24 个字符（16 字节整分组）");
    check(enc.ok(), "流式编码成功");
    check(b45_encode(key, 16, out, sizeof out) == 24, "一次性也是 24 个字符");
    check(memcmp(out, stream, 24) == 0, "流式与一次性一致");
    check(b45_decode((char[:]){ stream, 24 }, back, sizeof back) == 16, "解回 16 字节");
    check(memcmp(back, key, 16) == 0, "16 字节回环一致");
    /* 非法输入 */
    check(b45_valid((char[:]){ "bb8", 3 }) == 0, "小写不接受");
    check(b45_valid((char[:]){ ":::", 3 }) == 0, "三位组越界不接受");
}

/* 5. 串起来：响应头 -> 策略 -> 抓取许可 -> 指纹 */
static void do_pipeline(void)
{
    const char *header = "max-age=86400; includeSubDomains";
    const char *robots_txt = "User-agent: c6bot\n"
                             "Disallow: /secret\n";
    HstsPolicy p = { 0 };
    HstsStore st = { 0 };
    Robots rb = { 0 };
    u8 sa[32] = { 0 }, sb[32] = { 0 }, shared[32] = { 0 };
    char fp[64] = { 0 };
    Dh client = { { 0 }, { 0 }, 0 };
    Dh server = { { 0 }, { 0 }, 0 };
    long now = 1700000000;

    printf("== 串联：策略 + 指纹\n");
    check(hsts_parse(header, &p) == 1, "1) 解析 HSTS 头");
    st.init();
    check(st.add("shop.example", p.max_age, p.subdomains, now) == 1, "2) 写策略");
    check(st.match("cdn.shop.example", now) == 1, "   子域要求 https");
    rb.init();
    check(rb.load(robots_txt, (int)strlen(robots_txt), "c6bot") == 1, "3) 装载 robots");
    check(rb.allowed("/secret/key") == 0, "   /secret 不许抓");
    check(rb.allowed("/public/list") == 1, "   /public 可以抓");

    for (int i = 0; i < 32; i++) {
        sa[i] = (u8)(0x11 * (i + 1));
        sb[i] = (u8)(0x7f - i);
    }
    check(client.init(sa) == 1 && server.init(sb) == 1, "4) 双方 init");
    check(client.agree(shared, server.public_key()) == 1, "5) 算共享密钥");
    /* 把共享密钥的前 16 字节编成可打印指纹 */
    check(b45_encode(shared, 16, fp, sizeof fp) == 24, "6) 共享密钥编成 base45");
    printf("   https://cdn.shop.example  fp = %.24s…\n", fp);
    check(b45_valid((char[:]){ fp, 24 }) == 1, "   指纹可解");
    /* 每节都用了方法调用：init/agree/is_ready、add/match/expire/prune、load/allowed、
       put/finish/ok —— 这里再确认一次句柄仍然可用 */
    check(client.is_ready() && server.is_ready(), "句柄仍就绪");
}

int main(void)
{
    do_x25519();
    do_hsts();
    do_robots();
    do_base45();
    do_pipeline();
    printf("\n%d check(s), %d failure(s)\n", checks, nfail);
    return nfail == 0 ? 0 : 1;
}
