/* std/encoding/aes：AES 分组密码（FIPS 197，128/192/256 位密钥）与 CTR 模式。
 *
 *     import std.encoding.aes;
 *
 *     Aes a = aes_key(key, 16);              // 16/24/32 字节
 *     if (!a.ok())
 *         return 1;
 *     u8 out[16] = { 0 };
 *     a.encrypt_block(in, out);              // 单块 ECB
 *     a.decrypt_block(out, back);
 *
 *     char buf[...];                          // CTR：加解密是同一个操作
 *     a.ctr_xor(iv, data, n, buf);
 *
 * 为什么手写：和哈希那几个模块一样——同一份输入在任何平台给出同一串字节、
 * 零分配、不链宿主的加密库。S 盒/逆 S 盒/Rcon 由 `GF(2^8)` 的乘法逆 + 仿射
 * 变换生成后写进表里（生成脚本不进仓库），实现本身只做按字节的置换、行移位、
 * 列混合与轮密钥加。
 *
 * **这一层只给分组原语和 CTR**：CTR 是流模式，**没有认证**——密文可以被改，
 * 调用方要么自己配 HMAC（`std.encoding.sha256` 的 `hmac_sha256`），要么用
 * ChaCha20-Poly1305 那种 AEAD。IV/counter 绝不能在同一密钥下重复使用，否则
 * 两条明文一异或就露馅；CTR 的 counter 在这里按整 16 字节大端递增（和
 * SP 800-38A 的约定一致）。
 *
 * 约定：
 *
 * - `aes_key` 的密钥长度只有 16/24/32 合法，其它给 `ok() == 0` 的句柄；
 * - `encrypt_block`/`decrypt_block` 的输入输出可以是同一块内存（先读到栈上
 *   再写回）；
 * - `ctr_xor` 允许 `in == out`，`n == 0` 是空操作，`n` 不是 16 的倍数时最后
 *   一块只用前几字节密钥流；
 * - 轮密钥在结构体里（60 个 u32），`aes_key` 按值返回，可以放进别的结构体；
 *   用完不强制清零（调用方要的话自己 memset）。
 */
#include <string.h>

module std.encoding.aes;
import std.core.types;

struct Aes {
    u32 rk[60];     /* 4 * (rounds + 1) 个轮密钥字 */
    int nr;         /* 10/12/14 轮 */
    int valid;
};

/* FIPS 197 §5.1.1 的 S 盒：GF(2^8) 乘法逆 + 仿射变换 */
