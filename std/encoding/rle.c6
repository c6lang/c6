/* std/encoding/rle：游程压缩（PackBits）与一阶差分（零分配、写调用方缓冲）。
 *
 *     import std.encoding.rle;
 *
 *     char packed[256] = { 0 };
 *     int n = rle_encode(src, src_len, packed, (int)sizeof packed);
 *     char back[256] = { 0 };
 *     int m = rle_decode(packed, n, back, (int)sizeof back);
 *
 * 两个原语，都是嵌入式/存储侧最便宜的那种：
 *
 * - **PackBits**（Apple/TIFF 的 RLE）：控制字节 c 的语义是
 *   `0..127` → 后面跟 `c+1` 个字面量；`129..255` → 后面那 1 个字节重复
 *   `257-c` 次（所以 `254` = 重复 3 次）；`128` 是 no-op。单段最多 128。
 * - **一阶差分** `delta_encode`/`delta_decode`：`d[0]=s[0]`、
 *   `d[i]=s[i]-s[i-1]`（模 256）。单调或缓变的采样（ADC、计数器）差分后
 *   全是小值/零，再交给 RLE 或 LZ4 压得更狠。
 *
 * 约定（和 `std.encoding.frame`/`std.encoding.lz4` 一致）：
 *
 * - 长度先算再写：`rle_bound` 是上界（拿来开缓冲），`rle_encoded_len` 是精确值；
 *   放不下返回 -1 且**一个字节都不写**。
 * - 解码会先校验控制字节与截断，再写输出；坏数据/放不下返回 -1（此时目标
 *   缓冲可能已被写了一部分，要保留原内容请先解到临时缓冲）。
 * - 差分不做长度检查之外的任何事：`delta_encode` 的输出长度永远等于输入长度。
 */
#include <string.h>

module std.encoding.rle;
import std.core.types;

enum RleLimits {
    RLE_MAX_RUN = 128,        /* PackBits 单段最多 128 字节 */
    RLE_NOOP = 128,           /* 控制字节 128 是空操作 */
};

/* PackBits 的最坏输出上界：每 128 字节多一个控制字节，再加一段的头 */
int rle_bound(int n)
{
    i64 v = 0;

    if (n < 0)
        return -1;
    v = (i64)n + (i64)n / 128 + 1;
    if (v > (i64)I32_MAX)
        return -1;
    return (int)v;
}

/* 精确编码长度：扫一遍，不写输出 */
int rle_encoded_len(const void *src, int n)
{
    const u8 *s = (const u8 *)src;
    int i = 0, out = 0;

    if (n < 0 || (n > 0 && !src))
        return -1;
    while (i < n) {
        int run = 1;

        while (i + run < n && s[i + run] == s[i] && run < RLE_MAX_RUN)
            run++;
        if (run >= 2) {
            out += 2;
            i += run;
        } else {
            int lit = 1;

            while (i + lit < n && lit < RLE_MAX_RUN) {
                if (i + lit + 1 < n && s[i + lit] == s[i + lit + 1])
                    break;
                lit++;
            }
            out += 1 + lit;
            i += lit;
        }
    }
    return out;
}

/* 编码：返回字节数；容量不够/参数非法返回 -1（不写半截） */
int rle_encode(const void *src, int n, void *dst, int cap)
{
    const u8 *s = (const u8 *)src;
    u8 *d = (u8 *)dst;
    int i = 0, di = 0, need = 0;

    if (n < 0 || cap < 0 || (n > 0 && !src) || (cap > 0 && !dst))
        return -1;
    need = rle_encoded_len(src, n);
    if (need < 0 || need > cap)
        return -1;
    while (i < n) {
        int run = 1;

        while (i + run < n && s[i + run] == s[i] && run < RLE_MAX_RUN)
            run++;
        if (run >= 2) {
            d[di++] = (u8)(257 - run);
            d[di++] = s[i];
            i += run;
        } else {
            int lit = 1, k = 0;

            while (i + lit < n && lit < RLE_MAX_RUN) {
                if (i + lit + 1 < n && s[i + lit] == s[i + lit + 1])
                    break;
                lit++;
            }
            d[di++] = (u8)(lit - 1);
            for (k = 0; k < lit; k++)
                d[di++] = s[i + k];
            i += lit;
        }
    }
    return di;
}

/* 解出来的长度（只解析头，不写输出）；坏数据返回 -1 */
int rle_decoded_len(const void *src, int n)
{
    const u8 *s = (const u8 *)src;
    int i = 0, out = 0;

    if (n < 0 || (n > 0 && !src))
        return -1;
    while (i < n) {
        int c = s[i++];

        if (c == RLE_NOOP)
            continue;
        if (c < 128) {
            if (i + c + 1 > n)
                return -1;
            i += c + 1;
            out += c + 1;
        } else {
            if (i >= n)
                return -1;
            i++;
            out += 257 - c;
        }
        if (out < 0)
            return -1;
    }
    return out;
}

/* 解码：返回字节数；坏数据/输出放不下返回 -1 */
int rle_decode(const void *src, int n, void *dst, int cap)
{
    const u8 *s = (const u8 *)src;
    u8 *d = (u8 *)dst;
    int i = 0, di = 0;

    if (n < 0 || cap < 0 || (n > 0 && !src) || (cap > 0 && !dst))
        return -1;
    while (i < n) {
        int c = s[i++];

        if (c == RLE_NOOP)
            continue;
        if (c < 128) {
            int lit = c + 1, k = 0;

            if (i + lit > n || di + lit > cap)
                return -1;
            for (k = 0; k < lit; k++)
                d[di + k] = s[i + k];
            i += lit;
            di += lit;
        } else {
            int run = 257 - c, k = 0;
            u8 b = 0;

            if (i >= n || di + run > cap)
                return -1;
            b = s[i++];
            for (k = 0; k < run; k++)
                d[di + k] = b;
            di += run;
        }
    }
    return di;
}

/* ---- 差分 ---- */

/* 一阶差分：d[0] = s[0]，d[i] = s[i] - s[i-1]（模 256） */
int delta_encode(const void *src, int n, void *dst, int cap)
{
    const u8 *s = (const u8 *)src;
    u8 *d = (u8 *)dst;
    int i = 0;

    if (n < 0 || (n > 0 && (!src || !dst)) || cap < n)
        return -1;
    if (n == 0)
        return 0;
    d[0] = s[0];
    for (i = 1; i < n; i++)
        d[i] = (u8)(s[i] - s[i - 1]);
    return n;
}

/* 差分还原（和 delta_encode 互逆） */
int delta_decode(const void *src, int n, void *dst, int cap)
{
    const u8 *s = (const u8 *)src;
    u8 *d = (u8 *)dst;
    int i = 0;

    if (n < 0 || (n > 0 && (!src || !dst)) || cap < n)
        return -1;
    if (n == 0)
        return 0;
    d[0] = s[0];
    for (i = 1; i < n; i++)
        d[i] = (u8)(d[i - 1] + s[i]);
    return n;
}

/* ---- 自测 ---- */

test "PackBits 的已知向量" {
    /* {0xFE,'A', 0x02,'x','y','z'}：'A' 重复 3 次 + 3 个字面量 */
    const u8 blk[6] = { 0xfe, 'A', 0x02, 'x', 'y', 'z' };
    char out[32] = { 0 };
    int m = 0;

    m = rle_decode(blk, 6, out, (int)sizeof out);
    if (m != 6 || memcmp(out, "AAAxyz", 6) != 0)
        return err(1, "标准向量");
    if (rle_decoded_len(blk, 6) != 6)
        return err(2, "decoded_len");
    /* 编码同一个串：AAA 走重复段，xyz 走字面量段 */
    {
        char enc[32] = { 0 };
        int n = rle_encode("AAAxyz", 6, enc, (int)sizeof enc);

        if (n != 6 || (u8)enc[0] != 0xfe || enc[1] != 'A'
            || (u8)enc[2] != 0x02)
            return err(3, "编码 AAAxyz");
        if (rle_encoded_len("AAAxyz", 6) != n)
            return err(4, "encoded_len 与 encode 不一致");
    }
    /* 128 是 no-op，跳过 */
    {
        const u8 blk2[4] = { 0x80, 0x01, 'a', 'b' };

        m = rle_decode(blk2, 4, out, (int)sizeof out);
        if (m != 2 || memcmp(out, "ab", 2) != 0)
            return err(5, "0x80 no-op");
    }
}

test "RLE 往返与边界" {
    char src[512] = { 0 };
    char enc[1024] = { 0 };
    char back[512] = { 0 };
    int i = 0, n = 0, m = 0;

    /* 空输入 */
    if (rle_encode("", 0, enc, (int)sizeof enc) != 0)
        return err(6, "空输入");
    if (rle_decode("", 0, back, (int)sizeof back) != 0)
        return err(7, "空输入解码");
    /* 单字节 */
    if (rle_encode("x", 1, enc, (int)sizeof enc) != 2
        || enc[0] != 0 || enc[1] != 'x')
        return err(8, "单字节");
    /* 128 个相同字节（一段装满）与 129 个（两段） */
    for (i = 0; i < 129; i++)
        src[i] = 'a';
    n = rle_encode(src, 129, enc, (int)sizeof enc);
    if (n != 4 || (u8)enc[0] != 0x81 || (u8)enc[2] != 0x00)
        return err(9, "128 一段 + 1 字面量");
    m = rle_decode(enc, n, back, (int)sizeof back);
    if (m != 129 || memcmp(back, src, 129) != 0)
        return err(10, "129 个 a 的往返");
    /* 交替数据（几乎全字面量） */
    for (i = 0; i < 300; i++)
        src[i] = (char)((i & 1) ? 'B' : 'A');
    n = rle_encode(src, 300, enc, (int)sizeof enc);
    m = rle_decode(enc, n, back, (int)sizeof back);
    if (m != 300 || memcmp(back, src, 300) != 0)
        return err(11, "交替数据往返");
    /* 伪随机数据 */
    {
        u32 seed = 99u;

        for (i = 0; i < 400; i++) {
            seed = seed * 1103515245u + 12345u;
            src[i] = (char)(seed >> 17);
        }
        n = rle_encode(src, 400, enc, (int)sizeof enc);
        m = rle_decode(enc, n, back, (int)sizeof back);
        if (m != 400 || memcmp(back, src, 400) != 0)
            return err(12, "随机数据往返");
        if (n != rle_encoded_len(src, 400))
            return err(13, "随机数据的长度一致");
    }
}

test "RLE 坏数据与容量" {
    char out[8] = { 0 };
    char enc[8] = { 0 };
    char src[16] = { 0 };
    int i = 0;

    /* 字面量越过输入末尾 */
    {
        const u8 bad[3] = { 0x05, 'a', 'b' };

        if (rle_decode(bad, 3, out, (int)sizeof out) != -1)
            return err(14, "截断的字面量");
        if (rle_decoded_len(bad, 3) != -1)
            return err(15, "截断的字面量（长度）");
    }
    /* 重复段缺字节 */
    {
        const u8 bad[1] = { 0xfe };

        if (rle_decode(bad, 1, out, (int)sizeof out) != -1)
            return err(16, "缺重复字节");
    }
    /* 输出放不下 */
    {
        const u8 blk[2] = { 0xfe, 'A' };

        if (rle_decode(blk, 2, out, 2) != -1)
            return err(17, "输出放不下");
    }
    /* 编码容量不够：不写半截 */
    for (i = 0; i < 16; i++)
        src[i] = (char)('a' + i % 4);
    for (i = 0; i < 8; i++)
        enc[i] = 'Z';
    if (rle_encode(src, 16, enc, 4) != -1)
        return err(18, "编码容量不够");
    for (i = 0; i < 8; i++)
        if (enc[i] != 'Z')
            return err(19, "编码容量不够时写了半截");
    if (rle_bound(-1) != -1 || rle_encoded_len((const void *)0, 4) != -1)
        return err(20, "非法参数");
}

test "差分编码" {
    char src[64] = { 0 };
    char d[64] = { 0 };
    char back[64] = { 0 };
    int i = 0, n = 0;

    if (delta_encode("", 0, d, (int)sizeof d) != 0
        || delta_decode("", 0, back, (int)sizeof back) != 0)
        return err(21, "空输入");
    /* 常数序列：差分只有第一个非零 */
    for (i = 0; i < 32; i++)
        src[i] = (char)100;
    n = delta_encode(src, 32, d, (int)sizeof d);
    if (n != 32 || d[0] != 100 || d[1] != 0 || d[31] != 0)
        return err(22, "常数序列的差分");
    /* 回绕：0 -> 255 的差是 -1（0xff） */
    src[0] = 0;
    src[1] = (char)255;
    delta_encode(src, 2, d, (int)sizeof d);
    if ((u8)d[1] != 0xff)
        return err(23, "0 -> 255 的差分");
    /* 随机往返 */
    {
        u32 seed = 7u;

        for (i = 0; i < 64; i++) {
            seed = seed * 1103515245u + 12345u;
            src[i] = (char)(seed >> 13);
        }
        n = delta_encode(src, 64, d, (int)sizeof d);
        if (n != 64)
            return err(24, "差分长度");
        n = delta_decode(d, 64, back, (int)sizeof back);
        if (n != 64 || memcmp(back, src, 64) != 0)
            return err(25, "差分往返");
    }
    /* 差分的输出再走 RLE：单调递增序列应该压得很好 */
    for (i = 0; i < 64; i++)
        src[i] = (char)i;
    delta_encode(src, 64, d, (int)sizeof d);
    {
        char enc[160] = { 0 };
        int en = rle_encode(d, 64, enc, (int)sizeof enc);

        if (en < 0 || en >= 64 + 1)
            return err(26, "差分 + RLE 的压缩");
        if (rle_decode(enc, en, back, (int)sizeof back) != 64
            || memcmp(back, d, 64) != 0)
            return err(27, "差分 + RLE 往返");
    }
    /* 容量不够 */
    if (delta_encode(src, 64, d, 8) != -1 || delta_decode(src, 64, d, 8) != -1)
        return err(28, "差分容量不够");
}
