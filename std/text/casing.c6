/* std/text/case：标识符的各种命名风格互转（snake / kebab / camel / Pascal / title）。
 *
 *     import std.text.casing;
 *
 *     char out[64] = { 0 };
 *     case_snake(S("HTTPServerConfig"), out, (int)sizeof out);  // "http_server_config"
 *     case_camel(S("hello_world"), out, (int)sizeof out);       // "helloWorld"
 *
 * 切词规则（与常见 linter 一致）：
 *
 * - 非字母数字（含空白、`_`、`-`、`.`）都是分隔；
 * - 小写/数字后接大写是边界（`helloWorld` → `hello` `World`）；
 * - 连续大写后面跟小写时，最后那个大写属于新词（`HTTPServer` → `HTTP` `Server`）；
 * - 数字不单独切（`v1`、`utf8` 各自算一个词）。
 *
 * 输入按字节处理（非 ASCII 字节一律当分隔），输出只含 ASCII。
 *
 * 约定：所有函数返回写入长度，容量不够返回 -1；`case_words` 把词的位置与长度写进
 * 调用方给的两个数组（最多 `max` 个），返回词数（超过 `max` 时只填前 `max` 个）。
 */
#include <string.h>

module std.text.casing;
import std.core.types;
import std.text.str;

static int case_is_lower(char c)
{
    return c >= 'a' && c <= 'z';
}

static int case_is_upper(char c)
{
    return c >= 'A' && c <= 'Z';
}

static int case_is_digit(char c)
{
    return c >= '0' && c <= '9';
}

static int case_is_word(char c)
{
    return case_is_lower(c) || case_is_upper(c) || case_is_digit(c);
}

static char case_lower(char c)
{
    if (case_is_upper(c))
        return (char)(c - 'A' + 'a');
    return c;
}

static char case_upper(char c)
{
    if (case_is_lower(c))
        return (char)(c - 'a' + 'A');
    return c;
}

int case_words(char[:] src, int *starts, int *lens, int max)
{
    int i = 0, n = src.len, count = 0;

    if (src.len < 0 || max < 0)
        return -1;
    while (i < n) {
        int start = 0, len = 0;

        while (i < n && !case_is_word(src.data[i]))
            i++;
        if (i >= n)
            break;
        start = i;
        while (i < n && case_is_word(src.data[i])) {
            if (i > start) {
                char prev = src.data[i - 1];
                char cur = src.data[i];

                if (case_is_upper(cur)
                    && (case_is_lower(prev) || case_is_digit(prev)))
                    break;
                if (case_is_upper(cur) && case_is_upper(prev)
                    && i + 1 < n && case_is_lower(src.data[i + 1]))
                    break;
            }
            i++;
        }
        len = i - start;
        if (count < max) {
            if (starts)
                starts[count] = start;
            if (lens)
                lens[count] = len;
        }
        count++;
    }
    return count;
}

static int case_put(char *dst, int cap, int o, char c)
{
    if (o >= cap)
        return -1;
    dst[o] = c;
    return o + 1;
}

static int case_join(char[:] src, char *dst, int cap, int style)
{
    int starts[64] = { 0 };
    int lens[64] = { 0 };
    int count = case_words(src, starts, lens, 64);
    int w = 0, o = 0;

    if (count < 0 || !dst || cap < 0)
        return -1;
    for (w = 0; w < count; w++) {
        int k = 0;

        for (k = 0; k < lens[w]; k++) {
            char c = src.data[starts[w] + k];

            if (style == 0) {           /* snake */
                if (w > 0 && k == 0)
                    o = case_put(dst, cap, o, '_');
                o = case_put(dst, cap, o, case_lower(c));
            } else if (style == 1) {    /* kebab */
                if (w > 0 && k == 0)
                    o = case_put(dst, cap, o, '-');
                o = case_put(dst, cap, o, case_lower(c));
            } else if (style == 2) {    /* camel */
                if (k == 0)
                    o = case_put(dst, cap, o,
                                 w == 0 ? case_lower(c) : case_upper(c));
                else
                    o = case_put(dst, cap, o, case_lower(c));
            } else if (style == 3) {    /* Pascal */
                if (k == 0)
                    o = case_put(dst, cap, o, case_upper(c));
                else
                    o = case_put(dst, cap, o, case_lower(c));
            }
            if (o < 0)
                return -1;
        }
        if (style == 4) {               /* title */
            int j = 0;

            for (j = 0; j < lens[w]; j++) {
                char c = src.data[starts[w] + j];

                o = case_put(dst, cap, o, j == 0 ? case_upper(c) : case_lower(c));
                if (o < 0)
                    return -1;
            }
            if (w + 1 < count) {
                o = case_put(dst, cap, o, ' ');
                if (o < 0)
                    return -1;
            }
        }
    }
    if (o < cap)
        dst[o] = 0;
    return o;
}

int case_snake(char[:] src, char *dst, int cap)
{
    return case_join(src, dst, cap, 0);
}

int case_kebab(char[:] src, char *dst, int cap)
{
    return case_join(src, dst, cap, 1);
}

int case_camel(char[:] src, char *dst, int cap)
{
    return case_join(src, dst, cap, 2);
}

int case_pascal(char[:] src, char *dst, int cap)
{
    return case_join(src, dst, cap, 3);
}

int case_title(char[:] src, char *dst, int cap)
{
    return case_join(src, dst, cap, 4);
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "case：切词" {
    int starts[16] = { 0 };
    int lens[16] = { 0 };
    int n = 0;

    n = case_words(S("helloWorld"), starts, lens, 16);
    if (n != 2 || lens[0] != 5 || lens[1] != 5)
        return err(1, "helloWorld 应该切成 2 个词");
    n = case_words(S("HTTPServerConfig"), starts, lens, 16);
    if (n != 3 || lens[0] != 4 || lens[1] != 6 || lens[2] != 6)
        return err(2, "缩略词边界不对");
    n = case_words(S("hello_world-config.v2"), starts, lens, 16);
    if (n != 4)
        return err(3, "多种分隔符应该切出 4 个词");
    if (starts[0] != 0 || starts[1] != 6 || starts[3] != 19)
        return err(4, "词的起点不对");
    n = case_words(S("utf8String"), starts, lens, 16);
    if (n != 2 || lens[0] != 4)
        return err(5, "数字不该单独切");
    if (case_words(S(""), starts, lens, 16) != 0)
        return err(6, "空串应该 0 个词");
    if (case_words(S("..."), starts, lens, 16) != 0)
        return err(7, "全是分隔应该 0 个词");
    if (case_words(S("a b c d"), starts, lens, 2) != 4)
        return err(8, "超过 max 时仍返回总数");
}

test "case：五种风格" {
    char out[64] = { 0 };
    int n = 0;

    n = case_snake(S("HTTPServerConfig"), out, (int)sizeof out);
    if (n != 18 || memcmp(out, "http_server_config", 18) != 0)
        return err(9, "snake 不对");
    n = case_kebab(S("HelloWorld"), out, (int)sizeof out);
    if (n != 11 || memcmp(out, "hello-world", 11) != 0)
        return err(10, "kebab 不对");
    n = case_camel(S("hello_world"), out, (int)sizeof out);
    if (n != 10 || memcmp(out, "helloWorld", 10) != 0)
        return err(11, "camel 不对");
    n = case_pascal(S("hello-world"), out, (int)sizeof out);
    if (n != 10 || memcmp(out, "HelloWorld", 10) != 0)
        return err(12, "Pascal 不对");
    n = case_title(S("the quick brown fox"), out, (int)sizeof out);
    if (n != 19 || memcmp(out, "The Quick Brown Fox", 19) != 0)
        return err(13, "title 不对");
    if (case_snake(S("HelloWorld"), out, 4) != -1)
        return err(14, "容量不够应该 -1");
    n = case_snake(S(""), out, (int)sizeof out);
    if (n != 0 || out[0] != 0)
        return err(15, "空输入应该空输出");
    n = case_pascal(S("a"), out, (int)sizeof out);
    if (n != 1 || out[0] != 'A')
        return err(16, "单个字母的 Pascal 不对");
}
