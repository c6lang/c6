/* c6 自测：切片 'T[:]'
 *
 * 运行（仓库根目录）：
 *   ./tcc/tcc -B tcc -test tests/slice.c6 tests/tu/slice.c6
 */
#include <stdio.h>
#include <string.h>

struct Pair { int a, b; };
typedef int Row[3];                 /* 数组作元素类型需要先起名字 */

/* 切片按值传递，也可以按值返回 */
int sum(int[:] s)
{
    int i = 0, total = 0;
    for (i = 0; i < (int)s.len; i++)
        total += s[i];
    return total;
}

int[:] tail(int[:] s)
{
    return s[1:];
}

/* 切片可以当结构体成员 */
struct Holder { int[:] s; };

int holder_sum(struct Holder *h)
{
    return sum(h->s);
}

package view {
    int first(int[:] s) { return s.len > 0 ? s[0] : -1; }
}
import view;

/* ---- 跨翻译单元（tests/tu/slice.c6）---- */
int tu_sum(int[:] s);
int[:] tu_tail(int[:] s);
int tu_first(int[:] s);

/* ---- 测试块 ---- */

test "数组隐式转切片，.len/.data 正确" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] s = a;
    if ((int)s.len != 5)
        err(1, ".len 不等于数组长度");
    if (s[0] != 10 || s[4] != 50)
        err(2, "下标取到的元素不对");
    if (s.data != a)
        err(3, ".data 没有指向数组首元素");
}

test "切片是视图：写穿到数组，数组改动也反映回来" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] s = a;
    s[0] = 99;
    a[1] = 21;
    if (a[0] != 99)
        err(1, "通过切片写入没有落到数组");
    if (s[1] != 21)
        err(2, "数组的改动没有反映到切片");
}

test "四种区间写法 [lo:hi]、[lo:]、[:hi]、[:]" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] s = a;
    int[:] t = a[1:4];
    int[:] u = t[1:];
    int[:] v = s[:2];
    int[:] w = t[:];
    if ((int)t.len != 3 || t[0] != 20 || t[2] != 40)
        err(1, "[lo:hi] 不对");
    if ((int)u.len != 2 || u[0] != 30)
        err(2, "[lo:] 不对");
    if ((int)v.len != 2)
        err(3, "[:hi] 长度不对");
    if ((int)w.len != 3)
        err(4, "[:] 长度不对");
}

test "空区间合法，长度为 0" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] s = a;
    if ((int)s[2:2].len != 0)
        err(1, "空区间的长度不为 0");
}

test "切片作为参数和返回值" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] s = a;
    if (sum(s) != 150)
        err(1, "按值传参求和不对");
    if ((int)tail(s).len != 4 || tail(s)[0] != 20)
        err(2, "返回切片不对");
}

test "切片作为结构体成员" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] s = a;
    struct Holder h = { s[2:4] };
    if (holder_sum(&h) != 70)
        err(1, "结构体成员切片求和不对");
    if (view.first(h.s) != 30)
        err(2, "包函数读到的首元素不对");
}

test "切片数组" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] s = a;
    int[:] parts[2] = { s[0:2], s[2:4] };
    if ((int)parts[0].len != 2 || parts[0][1] != 20)
        err(1, "parts[0] 不对");
    if (parts[1][0] != 30)
        err(2, "parts[1] 不对");
}

test "指向切片的指针" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] s = a;
    int[:] *p = &s;
    if ((int)p->len != 5)
        err(1, "p->len 不对");
    if ((*p)[3] != 40)
        err(2, "(*p)[3] 不对");
}

test "结构体元素的切片可以写成员" {
    struct Pair pairs[3] = { {1, 2}, {3, 4}, {5, 6} };
    struct Pair[:] ps = pairs;
    ps[1].a = 30;
    if (ps[1].a != 30)
        err(1, "通过切片写成员没生效");
    if (ps[2].b != 6)
        err(2, "ps[2].b 不对");
    if ((int)ps.len != 3)
        err(3, "ps.len 不对");
}

test "字符串字面量也是切片，长度含结尾 NUL" {
    char[:] m = "hello";
    if ((int)m.len != 6)
        err(1, "字符串切片的长度不对");
    if (m[0] != 'h' || m[4] != 'o')
        err(2, "字符串切片的元素不对");
}

test "数组元素的切片（typedef 起的数组类型）" {
    int grid[2][3] = { {1, 2, 3}, {4, 5, 6} };
    Row[:] rows = grid;
    if ((int)rows.len != 2)
        err(1, "rows.len 不对");
    if (rows[0][1] != 2 || rows[1][2] != 6)
        err(2, "按行取元素不对");
}

test "复合字面量用指针和长度构造切片" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] lit = (int[:]){ a + 2, 2 };
    if ((int)lit.len != 2 || lit[0] != 30 || lit[1] != 40)
        err(1, "(T[:]){p, n} 构造不对");
}

test "sizeof：切片两字，元素是普通对象" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] s = a;
    if ((int)sizeof(int[:]) != 2 * (int)sizeof(void *))
        err(1, "sizeof(int[:]) 不是两个机器字");
    if ((int)sizeof(s[0]) != (int)sizeof(int))
        err(2, "sizeof(s[0]) 不是元素大小");
    if ((int)sizeof(s.len) != (int)sizeof(void *))
        err(3, "sizeof(s.len) 不是一个机器字");
}

test "循环写穿、下标副作用" {
    int a[5] = { 10, 20, 30, 40, 50 };
    int[:] s = a;
    int i = 0, j = 1, v = 0;
    for (i = 0; i < (int)s.len; i++)
        s[i] += 1;
    if (a[0] != 11 || a[4] != 51)
        err(1, "循环写穿不对");
    v = s[j++];
    if (v != 21 || j != 2)
        err(2, "下标的副作用不对");
}

test "切片跨翻译单元共享同一个布局" {
    int a[5] = { 1, 2, 3, 4, 5 };
    int[:] s = a;
    int[:] t = tu_tail(s);
    if (tu_sum(s) != 15)
        err(1, "另一个 TU 的 sum 不对");
    if (tu_first(s) != 1)
        err(2, "另一个 TU 的 first 不对");
    if ((int)t.len != 4 || t[0] != 2 || t[(int)t.len - 1] != 5)
        err(3, "另一个 TU 返回的切片不对");
    if (tu_sum(a[1:3]) != 5)
        err(4, "本 TU 造的切片传给另一个 TU 不对");
}
