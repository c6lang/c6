/* std/data/html：HTML 标记分词器（零分配，不建 DOM）。
 *
 *     import std.data.html;
 *
 *     HtmlReader r = html_open(text, n);
 *     HtmlToken t = { 0 };
 *     while (r.next(&t) == 1) {
 *         // t.kind / t.name / t.text / t.attrs
 *         Str href = html_attr(&t, "href");
 *     }
 *
 * 出来的是标记流：文本、开始标签、结束标签、注释、DOCTYPE、CDATA。属性区
 * 只在原文里记下偏移，`html_attr` 需要时才去扫，所以一个 token 是可拷的
 * 小结构（四个 int + 两个视图）。层级、DOM、CSS 选择器都不在这里。
 *
 * 约定：
 *
 * - 标签名与属性名大小写不敏感（HTML 本身如此），`html_attr` 按不敏感匹配，
 *   返回第一个同名属性的值视图；没有就返回长度 0 的视图；
 * - `<script>`/`<style>`/`<textarea>`/`<title>` 的内容按原文文本吐出（里面的
 *   `<` 不算标签），直到对应的结束标签；
 * - 注释 `<!-- -->`、DOCTYPE `<!...>`、CDATA `<![CDATA[ ... ]]>` 各成一个
 *   token，内容放 `text`；
 * - 不带引号的属性值读到空白或 `>`；`/>` 置 `self_closing`（HTML5 里只有
 *   外来内容才有意义，这里只是照实记下）；
 * - 标签没闭合、注释没闭合返回 -1 并置 `bad`；
 * - `html_unescape` 只认 `&amp; &lt; &gt; &quot; &apos; &nbsp;` 与 `&#nn;` /
 *   `&#xnn;` 数字实体，其余原样保留（解码与否由调用方决定）。
 */
#include <string.h>

module std.data.html;
import std.core.types;
import std.text.str;

enum HtmlKind {
    HTML_TEXT,
    HTML_START,
    HTML_END,
    HTML_COMMENT,
    HTML_DOCTYPE,
    HTML_CDATA,
};

struct HtmlToken {
    int kind;
    Str name;           /* START/END 的标签名；其余为空 */
    Str text;           /* TEXT/COMMENT/DOCTYPE/CDATA 的内容 */
    int attrs;          /* 属性个数（START 才有意义） */
    int self_closing;
    Str attr_raw;       /* 属性区原文（指向输入缓冲） */
};

struct HtmlReader {
    const char *p;
    int n;
    int pos;
    int bad;
    int in_raw;         /* 正在吐 script/style 里的原文 */
    Str raw_name;       /* 对应的标签名 */
};

static int html_lower(int c)
{
    if (c >= 'A' && c <= 'Z')
        return c - 'A' + 'a';
    return c;
}

/* 已知长度的大小写不敏感比较（`b` 不必以 NUL 结束） */
static int html_ieq_n(const char *a, int n, const char *b, int bl)
{
    int i = 0;

    if (n != bl)
        return 0;
    for (i = 0; i < n; i++) {
        if (html_lower(a[i]) != html_lower(b[i]))
            return 0;
    }
    return 1;
}

/* 对 C 字符串（字面量）的大小写不敏感比较 */
static int html_ieq(const char *a, int n, const char *b)
{
    return html_ieq_n(a, n, b, (int)strlen(b));
}

static int html_is_space(int c)
{
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f';
}

static int html_is_alpha(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

static int html_is_raw_name(const char *p, int n)
{
    return html_ieq(p, n, "script") || html_ieq(p, n, "style")
           || html_ieq(p, n, "textarea") || html_ieq(p, n, "title");
}

HtmlReader html_open(const void *src, int n)
{
    HtmlReader r = { 0 };

    if (!src || n <= 0) {
        r.bad = 1;
        return r;
    }
    r.p = (const char *)src;
    r.n = n;
    return r;
}

/* 从 pos 起找 needle（大小写不敏感），返回下标或 -1 */
static int html_ifind(const char *p, int from, int n, const char *needle)
{
    int nl = (int)strlen(needle), i = 0, j = 0;

    for (i = from; i + nl <= n; i++) {
        for (j = 0; j < nl; j++) {
            if (html_lower(p[i + j]) != html_lower(needle[j]))
                break;
        }
        if (j == nl)
            return i;
    }
    return -1;
}

/* 扫开始标签的属性区，填 attrs，返回属性区结束位置（'>' 或 '/>' 的 '/') */
static int html_scan_attrs(HtmlReader *self, HtmlToken *t, int i)
{
    int n = self->n, begin = i;
    const char *p = self->p;

    (void)begin;
    while (i < n) {
        while (i < n && html_is_space(p[i]))
            i++;
        if (i >= n)
            return -1;
        if (p[i] == '>')
            break;
        if (p[i] == '/' && i + 1 < n && p[i + 1] == '>') {
            t->self_closing = 1;
            break;
        }
        t->attrs++;
        /* 名字 */
        while (i < n && !html_is_space(p[i]) && p[i] != '=' && p[i] != '>'
               && p[i] != '/')
            i++;
        while (i < n && html_is_space(p[i]))
            i++;
        if (i >= n || p[i] != '=')
            continue;
        i++;
        while (i < n && html_is_space(p[i]))
            i++;
        if (i < n && (p[i] == '"' || p[i] == '\'')) {
            int q = p[i];

            i++;
            while (i < n && p[i] != q)
                i++;
            if (i >= n)
                return -1;
            i++;
            continue;
        }
        while (i < n && !html_is_space(p[i]) && p[i] != '>') {
            if (p[i] == '/' && i + 1 < n && p[i + 1] == '>')
                break;              /* 无引号值尾部的 `/>` 归自闭合 */
            i++;
        }
    }
    if (i >= n)
        return -1;
    t->attr_raw.s = (char[:]){ (char *)p + begin, i - begin };
    return i;
}

int next(HtmlReader *self, HtmlToken *out)
{
    const char *p = 0;
    int n = 0, i = 0;

    if (!self || self->bad || !out)
        return -1;
    memset(out, 0, sizeof *out);
    p = self->p;
    n = self->n;
    i = self->pos;
    if (self->in_raw) {
        /* script/style 的原文：找到对应的 </name 为止 */
        const char *nm = self->raw_name.s.data;
        int nl = self->raw_name.s.len, at = -1, k = 0;

        for (k = i; k + 2 + nl <= n; k++) {
            if (p[k] != '<' || p[k + 1] != '/')
                continue;
            if (html_ieq_n(p + k + 2, nl, nm, nl)) {
                at = k;
                break;
            }
        }
        self->in_raw = 0;
        if (at < 0) {
            self->bad = 1;
            return -1;
        }
        out->kind = HTML_TEXT;
        out->text.s = (char[:]){ (char *)p + i, at - i };
        self->pos = at;
        return 1;
    }
    if (i >= n)
        return 0;
    if (p[i] != '<') {
        int at = i;

        while (at < n && p[at] != '<')
            at++;
        out->kind = HTML_TEXT;
        out->text.s = (char[:]){ (char *)p + i, at - i };
        self->pos = at;
        return 1;
    }
    /* 注释 */
    if (i + 4 <= n && memcmp(p + i, "<!--", 4) == 0) {
        int at = html_ifind(p, i + 4, n, "-->");

        if (at < 0) {
            self->bad = 1;
            return -1;
        }
        out->kind = HTML_COMMENT;
        out->text.s = (char[:]){ (char *)p + i + 4, at - (i + 4) };
        self->pos = at + 3;
        return 1;
    }
    /* CDATA */
    if (i + 9 <= n && memcmp(p + i, "<![CDATA[", 9) == 0) {
        int at = html_ifind(p, i + 9, n, "]]>");

        if (at < 0) {
            self->bad = 1;
            return -1;
        }
        out->kind = HTML_CDATA;
        out->text.s = (char[:]){ (char *)p + i + 9, at - (i + 9) };
        self->pos = at + 3;
        return 1;
    }
    /* DOCTYPE 之类的 <! ... > */
    if (i + 2 <= n && p[i + 1] == '!') {
        int at = i + 2;

        while (at < n && p[at] != '>')
            at++;
        if (at >= n) {
            self->bad = 1;
            return -1;
        }
        out->kind = HTML_DOCTYPE;
        out->text.s = (char[:]){ (char *)p + i + 2, at - (i + 2) };
        self->pos = at + 1;
        return 1;
    }
    /* 结束标签 */
    if (i + 2 <= n && p[i + 1] == '/') {
        int at = i + 2, b = 0, e = 0;

        while (at < n && p[at] != '>')
            at++;
        if (at >= n) {
            self->bad = 1;
            return -1;
        }
        b = i + 2;
        e = at;
        while (b < e && html_is_space(p[b]))
            b++;
        while (e > b && html_is_space(p[e - 1]))
            e--;
        out->kind = HTML_END;
        out->name.s = (char[:]){ (char *)p + b, e - b };
        self->pos = at + 1;
        return 1;
    }
    /* 开始标签 */
    if (i + 1 < n && html_is_alpha(p[i + 1])) {
        int at = i + 1, nb = 0, ne = 0, end = 0;

        nb = at;
        while (at < n && !html_is_space(p[at]) && p[at] != '>'
               && p[at] != '/')
            at++;
        ne = at;
        out->kind = HTML_START;
        out->name.s = (char[:]){ (char *)p + nb, ne - nb };
        end = html_scan_attrs(self, out, at);
        if (end < 0) {
            self->bad = 1;
            return -1;
        }
        if (p[end] == '/')
            end++;
        self->pos = end + 1;
        if (!out->self_closing && html_is_raw_name(out->name.s.data,
                                                   out->name.s.len)) {
            self->in_raw = 1;
            self->raw_name = out->name;
        }
        return 1;
    }
    /* 落单的 '<' 当文本 */
    out->kind = HTML_TEXT;
    out->text.s = (char[:]){ (char *)p + i, 1 };
    self->pos = i + 1;
    return 1;
}

/* 扫第 idx 个属性；越界返回 -1。name/value 是原文视图，value 可能为空。 */
int html_attr_at(const HtmlToken *t, int idx, Str *name, Str *value)
{
    const char *p = t->attr_raw.s.data;
    int left = t->attr_raw.s.len, i = 0, seen = 0;

    if (!t || idx < 0)
        return -1;
    while (i < left) {
        int nb = 0, ne = 0, vb = 0, ve = 0;

        while (i < left && html_is_space(p[i]))
            i++;
        if (i >= left)
            break;
        nb = i;
        while (i < left && !html_is_space(p[i]) && p[i] != '=')
            i++;
        ne = i;
        while (i < left && html_is_space(p[i]))
            i++;
        if (i < left && p[i] == '=') {
            i++;
            while (i < left && html_is_space(p[i]))
                i++;
            if (i < left && (p[i] == '"' || p[i] == '\'')) {
                int q = p[i];

                i++;
                vb = i;
                while (i < left && p[i] != q)
                    i++;
                ve = i;
                if (i < left)
                    i++;
            } else {
                vb = i;
                while (i < left && !html_is_space(p[i]))
                    i++;
                ve = i;
            }
        } else {
            vb = ne;
            ve = ne;
        }
        if (seen == idx) {
            if (name)
                name->s = (char[:]){ (char *)p + nb, ne - nb };
            if (value)
                value->s = (char[:]){ (char *)p + vb, ve - vb };
            return 1;
        }
        seen++;
    }
    return -1;
}

/* 按名字取属性值（大小写不敏感），没有返回长度 0 的视图 */
Str html_attr(const HtmlToken *t, const char *want)
{
    Str name = { 0 }, value = { 0 };
    int i = 0;

    if (!t || !want) {
        Str none = { 0 };

        return none;
    }
    while (html_attr_at(t, i, &name, &value) == 1) {
        if (html_ieq(name.s.data, name.s.len, want))
            return value;
        i++;
    }
    {
        Str none = { 0 };

        return none;
    }
}

/* 解实体：&amp; &lt; &gt; &quot; &apos; &nbsp; &#nn; &#xnn; */
int html_unescape(Str in, char *out, int cap)
{
    int i = 0, o = 0;

    if (!out || cap <= 0)
        return -1;
    while (i < in.s.len) {
        if (in.s.data[i] != '&') {
            if (o >= cap - 1)
                return -1;
            out[o++] = in.s.data[i++];
            continue;
        }
        {
            int semi = -1, k = 0;

            for (k = i + 1; k < in.s.len && k - i <= 10; k++) {
                if (in.s.data[k] == ';') {
                    semi = k;
                    break;
                }
            }
            if (semi < 0) {
                if (o >= cap - 1)
                    return -1;
                out[o++] = in.s.data[i++];
                continue;
            }
            {
                const char *e = in.s.data + i + 1;
                int el = semi - i - 1, ch = -1;

                if (html_ieq(e, el, "amp"))
                    ch = '&';
                else if (html_ieq(e, el, "lt"))
                    ch = '<';
                else if (html_ieq(e, el, "gt"))
                    ch = '>';
                else if (html_ieq(e, el, "quot"))
                    ch = '"';
                else if (html_ieq(e, el, "apos"))
                    ch = '\'';
                else if (html_ieq(e, el, "nbsp"))
                    ch = 0xA0;
                else if (el > 1 && e[0] == '#') {
                    int v = 0, base = 10, off = 1, digits = 0;

                    if (e[1] == 'x' || e[1] == 'X') {
                        base = 16;
                        off = 2;
                    }
                    for (k = off; k < el; k++) {
                        int d = e[k];

                        if (d >= '0' && d <= '9')
                            d -= '0';
                        else if (base == 16 && d >= 'a' && d <= 'f')
                            d = d - 'a' + 10;
                        else if (base == 16 && d >= 'A' && d <= 'F')
                            d = d - 'A' + 10;
                        else
                            return -1;
                        v = v * base + d;
                        digits++;
                    }
                    if (digits == 0 || v <= 0 || v > 0x10FFFF)
                        return -1;
                    ch = v;
                }
                if (ch < 0) {
                    if (o >= cap - 1)
                        return -1;
                    out[o++] = in.s.data[i++];
                    continue;
                }
                i = semi + 1;
                if (ch < 0x80) {
                    if (o >= cap - 1)
                        return -1;
                    out[o++] = (char)ch;
                } else if (ch < 0x800) {
                    if (o >= cap - 2)
                        return -1;
                    out[o++] = (char)(0xC0 | (ch >> 6));
                    out[o++] = (char)(0x80 | (ch & 0x3F));
                } else if (ch < 0x10000) {
                    if (o >= cap - 3)
                        return -1;
                    out[o++] = (char)(0xE0 | (ch >> 12));
                    out[o++] = (char)(0x80 | ((ch >> 6) & 0x3F));
                    out[o++] = (char)(0x80 | (ch & 0x3F));
                } else {
                    if (o >= cap - 4)
                        return -1;
                    out[o++] = (char)(0xF0 | (ch >> 18));
                    out[o++] = (char)(0x80 | ((ch >> 12) & 0x3F));
                    out[o++] = (char)(0x80 | ((ch >> 6) & 0x3F));
                    out[o++] = (char)(0x80 | (ch & 0x3F));
                }
            }
        }
    }
    out[o] = 0;
    return o;
}

/* ---- 自测 ---- */

static const char *PAGE =
    "<!DOCTYPE html>\n"
    "<html lang=\"zh\">\n"
    "<!-- 注释里有 <b> 标签 -->\n"
    "<a href=\"/x?a=1&amp;b=2\" target='_blank'>链接</a>\n"
    "<img src=x.png/>\n"
    "<script>if (a < b) { x(); }</script>\n"
    "<p class=note>a &lt; b &amp;&amp; c</p>\n"
    "</html>\n";

test "HTML：标签、属性与文本" {
    HtmlReader r = html_open(PAGE, (int)strlen(PAGE));
    HtmlToken t = { 0 };
    char buf[128] = { 0 };

    if (r.next(&t) != 1 || t.kind != HTML_DOCTYPE || t.text.s.len != 12)
        return err(1, "DOCTYPE 不对");
    r.next(&t);
    if (t.kind != HTML_TEXT)          /* 换行 */
        return err(2, "DOCTYPE 后的换行应该是文本");
    if (r.next(&t) != 1 || t.kind != HTML_START || t.name.s.len != 4)
        return err(3, "html 开始标签不对");
    {
        Str v = html_attr(&t, "lang");

        if (v.s.len != 2 || memcmp(v.s.data, "zh", 2) != 0)
            return err(4, "lang 属性不对");
        if (html_attr(&t, "LANG").s.len != 2)
            return err(5, "属性名应该大小写不敏感");
        if (html_attr(&t, "nope").s.len != 0)
            return err(6, "不存在的属性应该为空");
    }
    /* 注释 */
    for (;;) {
        if (r.next(&t) != 1)
            return err(7, "没读到注释");
        if (t.kind == HTML_COMMENT)
            break;
    }
    if (t.text.s.len != 25)
        return err(8, "注释内容不对");
    /* <a href=... target='...'> */
    for (;;) {
        if (r.next(&t) != 1)
            return err(9, "没读到 a 标签");
        if (t.kind == HTML_START && html_ieq(t.name.s.data, t.name.s.len, "a"))
            break;
    }
    {
        Str v = html_attr(&t, "href");

        if (t.attrs != 2)
            return err(10, "a 的属性个数不对");
        if (v.s.len != 14 || memcmp(v.s.data, "/x?a=1&amp;b=2", 14) != 0)
            return err(11, "href 不对");
        if (html_attr(&t, "target").s.len != 6)
            return err(12, "单引号属性不对");
    }
    /* 文本 `链接`，然后 </a> */
    r.next(&t);
    if (t.kind != HTML_TEXT || t.text.s.len != 6)
        return err(13, "中文文本长度不对");
    r.next(&t);
    if (t.kind != HTML_END || t.name.s.len != 1)
        return err(14, "结束标签不对");
    /* <img src=x.png/> 自闭合 + 无引号属性 */
    for (;;) {
        if (r.next(&t) != 1)
            return err(15, "没读到 img");
        if (t.kind == HTML_START && html_ieq(t.name.s.data, t.name.s.len, "img"))
            break;
    }
    if (!t.self_closing || t.attrs != 1)
        return err(16, "img 应该自闭合且一个属性");
    if (html_attr(&t, "src").s.len != 5)
        return err(17, "无引号属性值不对");
    /* script 里的 `<` 不算标签 */
    for (;;) {
        if (r.next(&t) != 1)
            return err(18, "没读到 script");
        if (t.kind == HTML_START && html_ieq(t.name.s.data, t.name.s.len,
                                              "script"))
            break;
    }
    if (r.next(&t) != 1 || t.kind != HTML_TEXT || t.text.s.len != 19)
        return err(19, "script 原文不对");
    if (memcmp(t.text.s.data, "if (a < b) { x(); }", 19) != 0)
        return err(20, "script 内容不对");
    r.next(&t);
    if (t.kind != HTML_END || !html_ieq(t.name.s.data, t.name.s.len, "script"))
        return err(21, "script 结束标签不对");
    /* p 的实体 */
    for (;;) {
        if (r.next(&t) != 1)
            return err(22, "没读到 p");
        if (t.kind == HTML_START && html_ieq(t.name.s.data, t.name.s.len, "p"))
            break;
    }
    if (r.next(&t) != 1 || t.kind != HTML_TEXT)
        return err(23, "p 的文本不对");
    if (html_unescape(t.text, buf, (int)sizeof buf) != 10)
        return err(24, "实体解码长度不对");
    if (memcmp(buf, "a < b && c", 10) != 0)
        return err(25, "实体解码不对");
}

test "HTML：实体、坏输入与边界" {
    char buf[32] = { 0 };
    HtmlReader r = html_open("<div", 4);
    HtmlToken t = { 0 };

    if (html_unescape((Str){ (char[:]){ "&#65;&#x42;&nbsp;", 17 } }, buf,
                      (int)sizeof buf) != 4)
        return err(26, "数字实体不对");
    if (memcmp(buf, "AB\xc2\xa0", 4) != 0)
        return err(27, "数字实体字节不对");
    if (html_unescape((Str){ (char[:]){ "&bogus;x", 8 } }, buf, (int)sizeof buf)
        != 8)
        return err(28, "未知实体原样保留");
    if (html_unescape((Str){ (char[:]){ "&amp;", 5 } }, buf, 1) != -1)
        return err(29, "放不下应该 -1");
    if (html_unescape((Str){ (char[:]){ "&#xZZ;", 6 } }, buf, (int)sizeof buf)
        != -1)
        return err(30, "坏数字实体应该 -1");
    /* 未闭合的开始标签 */
    if (r.next(&t) != -1 || r.bad == 0)
        return err(31, "未闭合标签应该 -1 并置 bad");
    /* 未闭合注释 */
    r = html_open("<!-- x", 6);
    if (r.next(&t) != -1)
        return err(32, "未闭合注释应该 -1");
    /* 空指针 */
    if (html_open(0, 5).bad == 0 || next(0, &t) != -1)
        return err(33, "空指针应该失败");
    /* 落单的 '<' 当文本 */
    r = html_open("a<3", 3);
    r.next(&t);
    if (r.next(&t) != 1 || t.kind != HTML_TEXT || t.text.s.len != 1
        || t.text.s.data[0] != '<')
        return err(34, "落单的 < 应该当文本");
    /* CDATA */
    r = html_open("<![CDATA[a<b]]>", 15);
    if (r.next(&t) != 1 || t.kind != HTML_CDATA || t.text.s.len != 3)
        return err(35, "CDATA 不对");
}
