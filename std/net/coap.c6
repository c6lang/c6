/* std/net/coap：CoAP 报文编解码（RFC 7252）——解析器 + 选项游标 + 构造器。
 *
 *     import std.net.coap;
 *
 *     CoapMsg m = { 0 };
 *     m.parse(buf, n);                   // 0 = 合法
 *     m.code_str(line, sizeof line);       // "0.01" / "2.05"
 *
 *     CoapDoc d = { 0 };
 *     CoapOpt o = { 0 };
 *     d.open(&m);                          // 游标：open / next / count / reset
 *     while (d.next(&o))                   // 选项按编号升序
 *         printf("%d = %.*s\n", o.num, o.len, o.val);
 *
 *     CoapBuilder b = { 0 };
 *     b.init(out, sizeof out);
 *     b.start(COAP_CON, COAP_GET, 0x1234); // 方法：start / token / option / payload / finish
 *     b.option(11, "temp", 4);             // Uri-Path
 *     b.finish();
 *
 * 只做**报文层**（不做重传、不做观察者）：4 字节头 + token + 选项串 + payload。
 * 选项是按编号升序排列的「delta + length」编码，delta 13/14 要额外字节，所以
 * 解析和构造都走同一套规则：
 *
 * - 解析：`coap_parse()` 把头部、token、payload 的位置记进 `CoapMsg`，选项留给
 *   `CoapDoc` 逐条走——不复制、不分配，值是指向原缓冲的指针；
 * - 构造：`CoapBuilder` 顺序追加，`option()` 自动算 delta（必须递增，否则失败），
 *   `payload()` 自动补 `0xFF` 分隔符；
 * - 校验：版本必须是 1、token 长度 ≤ 8、选项 delta 15 保留（非法）、payload
 *   标记后必须有内容（RFC 7252 §3：`0xFF` 后面不能为空）。
 */
#include <string.h>

module std.net.coap;
import std.core.types;

enum Error { OK = 0, PARSE = 1, INVAL = 2, RANGE = 3 };

#define COAP_CON 0
#define COAP_NON 1
#define COAP_ACK 2
#define COAP_RST 3

#define COAP_GET 1
#define COAP_POST 2
#define COAP_PUT 3
#define COAP_DELETE 4

#define COAP_OPT_URI_HOST 3
#define COAP_OPT_ETAG 4
#define COAP_OPT_OBSERVE 6
#define COAP_OPT_URI_PORT 7
#define COAP_OPT_LOCATION_PATH 8
#define COAP_OPT_URI_PATH 11
#define COAP_OPT_CONTENT_FORMAT 12
#define COAP_OPT_MAX_AGE 14
#define COAP_OPT_URI_QUERY 15

struct CoapMsg {
    int ok;
    int ver;
    int type;
    int tkl;
    int code;
    int mid;
    unsigned char token[8];
    int nopts;
    int payload_len;
    int payload_off;            /* payload 在缓冲里的偏移（-1 = 没有） */
    int opts_off;               /* 选项串起点 */
};

struct CoapOpt {
    int num;
    int len;
    int off;                    /* 值在缓冲里的偏移 */
};

struct CoapDoc {
    const unsigned char *buf;
    int len;
    int start;                  /* 选项串起点 */
    int pos;
    int last;
    int seen;
    int bad;
};

struct CoapBuilder {
    unsigned char *buf;
    int cap;
    int n;
    int last_opt;
    int ok;
    int started;
};

/* ---- 码点（class.detail） ---- */

int code_of(int cls, int detail)
{
    return ((cls & 0x7) << 5) | (detail & 0x1f);
}

int code_class(int code)
{
    return (code >> 5) & 0x7;
}

int code_detail(int code)
{
    return code & 0x1f;
}

/* 格式化成 "2.05"；返回长度，容量不够给 -1。 */
int code_str(int code, char *out, int cap)
{
    int cls = code_class(code);
    int det = code_detail(code);

    if (!out || cap < 4)
        return -1;
    out[0] = (char)('0' + cls);
    out[1] = '.';
    out[2] = (char)('0' + det / 10);
    out[3] = (char)('0' + det % 10);
    out[4] = 0;
    return 4;
}

/* ---- 解析 ---- */

int parse(CoapMsg *m, const unsigned char *buf, int len)
{
    int pos = 4;

    if (!m)
        return -1;
    memset(m, 0, sizeof *m);
    m->payload_off = -1;
    if (!buf || len < 4)
        return -1;
    m->ver = (buf[0] >> 6) & 0x3;
    m->type = (buf[0] >> 4) & 0x3;
    m->tkl = buf[0] & 0xf;
    m->code = buf[1];
    m->mid = (buf[2] << 8) | buf[3];
    if (m->ver != 1)
        return -1;
    if (m->tkl > 8)
        return -1;              /* 9..15 保留 */
    if (len < 4 + m->tkl)
        return -1;
    for (int i = 0; i < m->tkl; i++)
        m->token[i] = buf[pos + i];
    pos += m->tkl;
    m->opts_off = pos;
    /* 扫选项，统计个数并找 payload 起点 */
    {
        int last = 0;
        int cnt = 0;

        while (pos < len) {
            int b = buf[pos];

            if (b == 0xff) {
                pos++;
                if (pos >= len)
                    return -1;  /* 标记后面必须有内容 */
                m->payload_off = pos;
                m->payload_len = len - pos;
                break;
            }
            {
                int delta = (b >> 4) & 0xf;
                int olen = b & 0xf;

                pos++;
                if (delta == 15 || olen == 15)
                    return -1;  /* 保留值 */
                if (delta == 13) {
                    if (pos >= len)
                        return -1;
                    delta = 13 + buf[pos++];
                } else if (delta == 14) {
                    if (pos + 1 >= len)
                        return -1;
                    delta = 269 + ((buf[pos] << 8) | buf[pos + 1]);
                    pos += 2;
                }
                if (olen == 13) {
                    if (pos >= len)
                        return -1;
                    olen = 13 + buf[pos++];
                } else if (olen == 14) {
                    if (pos + 1 >= len)
                        return -1;
                    olen = 269 + ((buf[pos] << 8) | buf[pos + 1]);
                    pos += 2;
                }
                last += delta;
                if (pos + olen > len)
                    return -1;
                pos += olen;
                cnt++;
            }
        }
        m->nopts = cnt;
    }
    m->ok = 1;
    return 0;
}

/* ---- 选项游标 ---- */

int open(CoapDoc *d, const CoapMsg *m, const unsigned char *buf, int len)
{
    if (!d || !m || !m->ok || !buf)
        return -1;
    d->buf = buf;
    d->len = len;
    d->start = m->opts_off;
    d->pos = m->opts_off;
    d->last = 0;
    d->seen = 0;
    d->bad = 0;
    return 0;
}

/* 取下一条；取到返回 1（写进 out），到底返回 0。 */
int next(CoapDoc *d, CoapOpt *out)
{
    if (!d || d->bad)
        return 0;
    while (d->pos < d->len) {
        int b = (int)d->buf[d->pos];
        int delta = 0;
        int olen = 0;

        if (b == 0xff)
            return 0;           /* 到 payload 了 */
        delta = (b >> 4) & 0xf;
        olen = b & 0xf;
        d->pos++;
        if (delta == 13) {
            if (d->pos >= d->len) {
                d->bad = 1;
                return 0;
            }
            delta = 13 + (int)d->buf[d->pos++];
        } else if (delta == 14) {
            if (d->pos + 1 >= d->len) {
                d->bad = 1;
                return 0;
            }
            delta = 269 + (((int)d->buf[d->pos] << 8) | (int)d->buf[d->pos + 1]);
            d->pos += 2;
        }
        if (olen == 13) {
            if (d->pos >= d->len) {
                d->bad = 1;
                return 0;
            }
            olen = 13 + (int)d->buf[d->pos++];
        } else if (olen == 14) {
            if (d->pos + 1 >= d->len) {
                d->bad = 1;
                return 0;
            }
            olen = 269 + (((int)d->buf[d->pos] << 8) | (int)d->buf[d->pos + 1]);
            d->pos += 2;
        }
        d->last += delta;
        if (d->pos + olen > d->len) {
            d->bad = 1;
            return 0;
        }
        if (out) {
            out->num = d->last;
            out->len = olen;
            out->off = d->pos;
        }
        d->pos += olen;
        d->seen++;
        return 1;
    }
    return 0;
}

int count(CoapDoc *d)
{
    return d ? d->seen : -1;
}

void reset(CoapDoc *d)
{
    if (!d || !d->buf)
        return;
    d->pos = d->start;          /* 回到 open 记录的起点 */
    d->last = 0;
    d->seen = 0;
    d->bad = 0;
}

/* ---- 构造器 ---- */

void init(CoapBuilder *b, unsigned char *buf, int cap)
{
    if (!b)
        return;
    memset(b, 0, sizeof *b);
    b->buf = buf;
    b->cap = cap;
    b->last_opt = 0;
    b->ok = (buf == 0 || cap < 0) ? 0 : 1;
}

int start(CoapBuilder *b, int type, int code, int mid)
{
    if (!b || !b->ok)
        return -1;
    if (b->n != 0)
        return -1;              /* 已经 start 过 */
    if (b->cap < 4)
        return -1;
    b->buf[0] = (unsigned char)((1 << 6) | ((type & 0x3) << 4));   /* tkl 后面补 */
    b->buf[1] = (unsigned char)code;
    b->buf[2] = (unsigned char)((mid >> 8) & 0xff);
    b->buf[3] = (unsigned char)(mid & 0xff);
    b->n = 4;
    b->started = 1;
    return 0;
}

int token(CoapBuilder *b, const unsigned char *tok, int tkl)
{
    if (!b || !b->ok || !b->started)
        return -1;
    if (tkl < 0 || tkl > 8 || !tok)
        return -1;
    if (b->n != 4)
        return -1;              /* token 必须紧跟头部 */
    if (b->n + tkl > b->cap)
        return -1;
    memcpy(b->buf + b->n, tok, (size_t)tkl);
    b->n += tkl;
    b->buf[0] = (unsigned char)(b->buf[0] | (unsigned char)(tkl & 0xf));
    return 0;
}

static int coap_put_ext(CoapBuilder *b, int value)
{
    if (value >= 269) {
        int v = value - 269;

        if (b->n + 2 > b->cap)
            return -1;
        b->buf[b->n++] = (unsigned char)((v >> 8) & 0xff);
        b->buf[b->n++] = (unsigned char)(v & 0xff);
        return 0;
    }
    if (b->n + 1 > b->cap)
        return -1;
    b->buf[b->n++] = (unsigned char)(value - 13);
    return 0;
}

/* 追加一个选项；编号必须递增（RFC 要求按升序）。 */
int option(CoapBuilder *b, int num, const unsigned char *val, int vlen)
{
    int delta = 0;
    int dn = 0;
    int ln = 0;
    int first = 0;

    if (!b || !b->ok || !b->started || vlen < 0 || (vlen > 0 && !val))
        return -1;
    if (num <= b->last_opt)
        return -1;              /* 必须严格递增 */
    delta = num - b->last_opt;
    if (delta >= 269) {
        dn = 14;
        /* 额外 2 字节 */
    } else if (delta >= 13) {
        dn = 13;
    } else {
        dn = delta;
    }
    if (vlen >= 269)
        ln = 14;
    else if (vlen >= 13)
        ln = 13;
    else
        ln = vlen;
    if (b->n + 1 > b->cap)
        return -1;
    first = (dn << 4) | ln;
    b->buf[b->n++] = (unsigned char)first;
    if (dn == 13 || dn == 14) {
        if (coap_put_ext(b, delta) < 0)
            return -1;
    }
    if (ln == 13 || ln == 14) {
        if (coap_put_ext(b, vlen) < 0)
            return -1;
    }
    if (vlen > 0) {
        if (b->n + vlen > b->cap)
            return -1;
        memcpy(b->buf + b->n, val, (size_t)vlen);
        b->n += vlen;
    }
    b->last_opt = num;
    return 0;
}

/* 追加 payload（自动补 0xFF 标记）；只能调一次。 */
int payload(CoapBuilder *b, const unsigned char *data, int len)
{
    if (!b || !b->ok || !b->started || len <= 0 || !data)
        return -1;
    if (b->n + 1 + len > b->cap)
        return -1;
    b->buf[b->n++] = 0xff;
    memcpy(b->buf + b->n, data, (size_t)len);
    b->n += len;
    return 0;
}

int finish(CoapBuilder *b)
{
    if (!b || !b->ok || !b->started)
        return -1;
    return b->n;
}

int length(CoapBuilder *b)
{
    return b ? b->n : -1;
}

int ok(CoapBuilder *b)
{
    return b && b->ok && b->started;
}

/* ---- 自测 ---- */

test "CoAP：报文解析与选项游标" {
    /* CON GET /temp  mid=0x1234  token=0xAB  选项：Uri-Path="temp"  Content-Format=0 */
    unsigned char buf[64] = {
        0x41, 0x01, 0x12, 0x34, 0xab,
        0xb4, 't', 'e', 'm', 'p',
        0x10,
        0xff, 'o', 'k'
    };
    int n = 14;
    CoapMsg m = { 0 };
    CoapDoc d = { 0 };
    CoapOpt o = { 0 };
    char line[8] = { 0 };

    if (m.parse(buf, n) != 0 || !m.ok)
        return err(1, "解析失败");
    if (m.ver != 1 || m.type != COAP_CON || m.tkl != 1)
        return err(2, "头部字段不对");
    if (m.code != COAP_GET || m.mid != 0x1234 || m.token[0] != 0xab)
        return err(3, "code/mid/token 不对");
    if (m.nopts != 2)
        return err(4, "应有两个选项");
    if (m.payload_off < 0 || m.payload_len != 2
        || memcmp(buf + m.payload_off, "ok", 2) != 0)
        return err(5, "payload 不对");
    /* 码点格式化 */
    if (code_str(m.code, line, sizeof line) != 4 || strcmp(line, "0.01") != 0)
        return err(6, "code_str 应为 0.01");
    if (code_str(code_of(2, 5), line, sizeof line) != 4
        || strcmp(line, "2.05") != 0)
        return err(7, "2.05 格式化不对");
    /* 选项游标 */
    d.open(&m, buf, n);
    if (d.next(&o) != 1 || o.num != COAP_OPT_URI_PATH || o.len != 4)
        return err(8, "第一条应是 Uri-Path");
    if (memcmp(buf + o.off, "temp", 4) != 0)
        return err(9, "Uri-Path 值不对");
    if (d.next(&o) != 1 || o.num != COAP_OPT_CONTENT_FORMAT || o.len != 0)
        return err(10, "第二条应是 Content-Format=0（长度为 0）");
    if (d.next(&o) != 0 || d.count() != 2)
        return err(11, "应恰好两条");
    /* 坏报文 */
    {
        CoapMsg bad = { 0 };

        buf[0] = 0x01;          /* version 0 */
        if (bad.parse(buf, n) != -1)
            return err(12, "版本不是 1 应失败");
        buf[0] = 0x49;          /* tkl = 9（保留） */
        if (bad.parse(buf, n) != -1)
            return err(13, "token 长度 9 应失败");
        buf[0] = 0x41;
        if (bad.parse(buf, 5) != 0)
            return err(14, "只有头部 + token 的报文应合法");
        if (bad.parse(buf, 6) != -1)
            return err(16, "被截断的选项应失败");
        if (bad.parse(buf, 2) != -1)
            return err(15, "短于 4 字节应失败");
    }
}

test "CoAP：构造器与往返" {
    unsigned char buf[128] = { 0 };
    unsigned char tok[2] = { 0xde, 0xad };
    CoapBuilder b = { 0 };
    CoapMsg m = { 0 };
    CoapDoc d = { 0 };
    CoapOpt o = { 0 };
    int n = 0;

    b.init(buf, sizeof buf);
    if (b.start(COAP_NON, COAP_POST, 0xbeef) != 0)
        return err(1, "start 失败");
    if (b.token(tok, 2) != 0)
        return err(2, "token 失败");
    if (b.option(COAP_OPT_URI_PATH, (const unsigned char *)"sensors", 7) != 0)
        return err(3, "Uri-Path 失败");
    if (b.option(COAP_OPT_CONTENT_FORMAT, 0, 0) != 0)
        return err(4, "Content-Format 失败");
    if (b.payload((const unsigned char *)"21.5C", 5) != 0)
        return err(5, "payload 失败");
    n = b.finish();
    if (n != 4 + 2 + 8 + 1 + 6)     /* 头 + token + (1+7) 选项 + 1 选项 + 0xFF+5 */
        return err(6, "报文总长不对");
    if (m.parse(buf, n) != 0)
        return err(7, "往返解析失败");
    if (m.type != COAP_NON || m.code != COAP_POST || m.mid != 0xbeef
        || m.tkl != 2)
        return err(8, "头部往返不一致");
    if (m.token[0] != 0xde || m.token[1] != 0xad)
        return err(9, "token 往返不一致");
    d.open(&m, buf, n);
    if (d.next(&o) != 1 || o.num != COAP_OPT_URI_PATH || o.len != 7)
        return err(10, "Uri-Path 往返不一致");
    if (d.next(&o) != 1 || o.num != COAP_OPT_CONTENT_FORMAT || o.len != 0)
        return err(11, "Content-Format 往返不一致");
    if (m.payload_len != 5 || memcmp(buf + m.payload_off, "21.5C", 5) != 0)
        return err(12, "payload 往返不一致");
    /* 扩展 delta（269 以上）与扩展长度（13 字节）*/
    b.init(buf, sizeof buf);
    b.start(COAP_CON, COAP_GET, 1);
    if (b.option(300, (const unsigned char *)"0123456789abc", 13) != 0)
        return err(13, "扩展 delta/length 失败");
    n = b.finish();
    if (m.parse(buf, n) != 0)
        return err(14, "扩展编码解析失败");
    d.open(&m, buf, n);
    if (d.next(&o) != 1 || o.num != 300 || o.len != 13)
        return err(15, "扩展选项往返不一致");
    /* 选项编号必须递增 */
    b.init(buf, sizeof buf);
    b.start(COAP_CON, COAP_GET, 1);
    if (b.option(11, (const unsigned char *)"a", 1) != 0)
        return err(16, "第一次 option 失败");
    if (b.option(11, (const unsigned char *)"b", 1) != -1)
        return err(17, "编号不递增应失败");
    /* payload 标记后必须非空；容量不足 */
    b.init(buf, sizeof buf);
    b.start(COAP_CON, COAP_GET, 1);
    if (b.payload(0, 0) != -1)
        return err(18, "空 payload 应失败");
    {
        unsigned char small[5] = { 0 };
        CoapBuilder s = { 0 };

        s.init(small, sizeof small);
        s.start(COAP_CON, COAP_GET, 1);
        if (s.option(11, (const unsigned char *)"abc", 3) != -1)
            return err(19, "容量不足应失败");
    }
    /* 0xFF 后面为空是坏报文 */
    {
        unsigned char bad[5] = { 0x40, 0x01, 0x00, 0x01, 0xff };
        CoapMsg bm = { 0 };

        if (bm.parse(bad, 5) != -1)
            return err(20, "0xFF 后面为空应失败");
    }
}
