/* std/data/toml：TOML 配置的零分配读取器（事件式）。
 *
 *     import std.data.toml;
 *
 *     Str doc = { S("title = \"demo\"\n[server]\nhost = \"localhost\"\nport = 8080\n") };
 *     TomlReader r = toml_open(doc);
 *     TomlEntry e = { 0 };
 *     while (r.next(&e) == 1) {
 *         if (e.kind == TOML_KEY)
 *             // e.section / e.key / e.raw 都是输入上的视图
 *     }
 *
 * 和 `std.data.ini` 一样：**不分配、不复制**，所有字段都是指向输入文本的 `Str`
 * 视图，输入必须活得比 reader 久。`TomlEntry.decode` 才把字符串反转义写到调用方
 * 缓冲；数字/布尔/数组有独立的解析函数。
 *
 * 支持的 TOML 子集（有意做小，够读常见配置）：
 *
 * - 注释 `#` 到行尾；空白行忽略。
 * - 表 `[a.b.c]` 与表数组 `[[a.b]]`（只负责切出当前 section，不建索引）。
 * - `key = value`：裸键（`A-Za-z0-9_-`）或带引号的键（`"..."` / `'...'`）；
 *   键和值之间的 `=` 必须存在。
 * - 值：基本字符串 `"..."`（支持 `\b \t \n \f \r \" \\ \uXXXX \UXXXXXXXX`）、
 *   字面量字符串 `'...'`（不转义）、整数（十进制、`0x`、`0o`、`0b`、`_` 分隔符、
 *   `+/-`）、浮点（`1.5`、`-2e3`、`inf`/`nan`、`_`）、布尔 `true`/`false`、
 *   数组 `[...]`（可以跨行；元素用 `toml_array_at` 逐个取）。
 * - **不支持**：多行字符串 `"""`/`'''`、内联表 `{...}`（会当成原始文本，不报错）、
 *   日期时间类型（按原始文本保留）、点号键 `a.b = 1`（键会带点）。
 *
 * 语法错误（缺 `=`、表头没闭合、字符串没闭合、括号不平衡、空键/空值）：
 * `next` 返回 -1，并把行号（1 起）记在 `r.err` 里；之后 reader 停在坏行之后，
 * 可以继续读（错误不粘住，但 `err` 会保持最后一次的值）。
 */
#include <string.h>

module std.data.toml;
import std.core.types;
import std.text.str;
import std.text.num;

enum TomlKind {
    TOML_TABLE = 0,          /* [a.b] */
    TOML_ARRAY_TABLE = 1,    /* [[a.b]] */
    TOML_KEY = 2,            /* key = value */
};

struct TomlEntry {
    int kind;
    int line;
    Str section;             /* 表头之后是该表名；顶层是空视图 */
    Str key;                 /* TOML_KEY 时有值 */
    Str raw;                 /* 值的原始文本（已 trim） */
};

struct TomlReader {
    Str text;
    int pos;
    int line;
    Str section;
    int err;                 /* 0 或最后一次出错的行号（1 起） */
};

TomlReader toml_open(Str text)
{
    TomlReader r = { { { (char *)0, 0 } }, 0, 1, { { (char *)0, 0 } }, 0 };

    r.text = text;
    return r;
}

/* ---- 内部小工具 ---- */

static int t_at(TomlReader *r, int i)
{
    return (i >= 0 && i < r->text.s.len) ? (u8)r->text.s.data[i] : 0;
}

static int t_is_ws(int c)
{
    return c == ' ' || c == '\t' || c == '\r';
}

static int t_is_key_char(int c)
{
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
           || (c >= '0' && c <= '9') || c == '_' || c == '-';
}

static void t_eol(TomlReader *r)
{
    while (r->pos < r->text.s.len && t_at(r, r->pos) != '\n')
        r->pos++;
    if (r->pos < r->text.s.len) {
        r->pos++;
        r->line++;
    }
}

/* 跳过空白、注释与空行 */
static void t_skip_blank(TomlReader *r)
{
    while (r->pos < r->text.s.len) {
        int c = t_at(r, r->pos);

        if (t_is_ws(c)) {
            r->pos++;
            continue;
        }
        if (c == '#') {
            while (r->pos < r->text.s.len && t_at(r, r->pos) != '\n')
                r->pos++;
            continue;
        }
        if (c == '\n') {
            r->pos++;
            r->line++;
            continue;
        }
        break;
    }
}

/* 键：裸键或引号键（引号里的内容原样给出去） */
static int t_key(TomlReader *r, Str *out)
{
    int c = t_at(r, r->pos);
    int start = 0, end = 0, q = 0;

    if (c == '"' || c == '\'') {
        q = c;
        r->pos++;
        start = r->pos;
        while (r->pos < r->text.s.len) {
            c = t_at(r, r->pos);
            if (q == '"' && c == '\\') {
                r->pos += 2;
                continue;
            }
            if (c == q)
                break;
            if (c == '\n')
                return 0;
            r->pos++;
        }
        if (t_at(r, r->pos) != q)
            return 0;
        end = r->pos;
        r->pos++;
    } else {
        start = r->pos;
        while (t_is_key_char(t_at(r, r->pos)))
            r->pos++;
        end = r->pos;
        if (end == start)
            return 0;
    }
    {
        Str s = { { r->text.s.data + start, end - start } };

        *out = s;
    }
    return 1;
}

/* 值：从当前位置扫到行尾（数组/内联表可以跨行），返回 trim 后的视图 */
static int t_value(TomlReader *r, Str *out)
{
    int start = 0, end = 0, depth = 0, q = 0, c = 0;

    while (t_is_ws(t_at(r, r->pos)))
        r->pos++;
    start = r->pos;
    while (r->pos < r->text.s.len) {
        c = t_at(r, r->pos);
        if (q != 0) {
            if (q == '"' && c == '\\') {
                r->pos += 2;
                continue;
            }
            if (c == q)
                q = 0;
            r->pos++;
            continue;
        }
        if (c == '"' || c == '\'') {
            q = c;
            r->pos++;
            continue;
        }
        if (c == '#')
            break;
        if (c == '[' || c == '{') {
            depth++;
            r->pos++;
            continue;
        }
        if (c == ']' || c == '}') {
            depth--;
            if (depth < 0)
                return 0;
            r->pos++;
            continue;
        }
        if (c == '\n') {
            if (depth <= 0)
                break;
            r->line++;
            r->pos++;
            continue;
        }
        r->pos++;
    }
    if (q != 0 || depth != 0)
        return 0;
    end = r->pos;
    while (end > start && t_is_ws(t_at(r, end - 1)))
        end--;
    if (end == start)
        return 0;
    {
        Str s = { { r->text.s.data + start, end - start } };

        *out = s;
    }
    return 1;
}

/* ---- 读取 ---- */

/* 下一条：1 = 有，0 = 结束，-1 = 语法错误（行号在 self->err） */
int next(TomlReader *self, TomlEntry *out)
{
    TomlEntry e = { 0 };

    if (!out)
        return 0;
    t_skip_blank(self);
    if (self->pos >= self->text.s.len)
        return 0;
    e.line = self->line;
    e.section = self->section;
    if (t_at(self, self->pos) == '[') {
        int aot = (t_at(self, self->pos + 1) == '[');
        int start = 0, end = 0;
        Str name = { { (char *)0, 0 } };

        self->pos += aot ? 2 : 1;
        start = self->pos;
        while (self->pos < self->text.s.len && t_at(self, self->pos) != ']'
               && t_at(self, self->pos) != '\n')
            self->pos++;
        if (t_at(self, self->pos) != ']') {
            self->err = self->line;
            t_eol(self);
            return -1;
        }
        end = self->pos;
        {
            Str raw = { { self->text.s.data + start, end - start } };

            name = raw.trim();
        }
        if (name.s.len == 0) {
            self->err = self->line;
            t_eol(self);
            return -1;
        }
        self->pos++;
        if (aot) {
            if (t_at(self, self->pos) != ']') {
                self->err = self->line;
                t_eol(self);
                return -1;
            }
            self->pos++;
        }
        t_eol(self);
        self->section = name;
        e.kind = aot ? TOML_ARRAY_TABLE : TOML_TABLE;
        e.section = name;
        *out = e;
        return 1;
    }
    {
        Str key = { { (char *)0, 0 } };
        Str raw = { { (char *)0, 0 } };

        if (!t_key(self, &key)) {
            self->err = self->line;
            t_eol(self);
            return -1;
        }
        while (t_is_ws(t_at(self, self->pos)))
            self->pos++;
        if (t_at(self, self->pos) != '=') {
            self->err = self->line;
            t_eol(self);
            return -1;
        }
        self->pos++;
        if (!t_value(self, &raw)) {
            self->err = self->line;
            t_eol(self);
            return -1;
        }
        e.kind = TOML_KEY;
        e.key = key;
        e.raw = raw;
        t_eol(self);
        *out = e;
        return 1;
    }
}

/* ---- 字符串反转义 ---- */

static int t_hex(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
        return c - 'A' + 10;
    return -1;
}

/* 把码点按 UTF-8 写进 out；放不下/代理区返回 -1 */
static int t_utf8(u32 cp, char[:] out, int *di)
{
    if (cp > 0x10ffffu || (cp >= 0xd800u && cp <= 0xdfffu))
        return 0;
    if (cp < 0x80u) {
        if (*di + 1 > out.len)
            return 0;
        out.data[(*di)++] = (char)cp;
    } else if (cp < 0x800u) {
        if (*di + 2 > out.len)
            return 0;
        out.data[(*di)++] = (char)(0xc0u | (cp >> 6));
        out.data[(*di)++] = (char)(0x80u | (cp & 0x3fu));
    } else if (cp < 0x10000u) {
        if (*di + 3 > out.len)
            return 0;
        out.data[(*di)++] = (char)(0xe0u | (cp >> 12));
        out.data[(*di)++] = (char)(0x80u | ((cp >> 6) & 0x3fu));
        out.data[(*di)++] = (char)(0x80u | (cp & 0x3fu));
    } else {
        if (*di + 4 > out.len)
            return 0;
        out.data[(*di)++] = (char)(0xf0u | (cp >> 18));
        out.data[(*di)++] = (char)(0x80u | ((cp >> 12) & 0x3fu));
        out.data[(*di)++] = (char)(0x80u | ((cp >> 6) & 0x3fu));
        out.data[(*di)++] = (char)(0x80u | (cp & 0x3fu));
    }
    return 1;
}

/* 把字符串值反转义写进 out（含两侧引号才认）；返回字节数，失败 -1 */
int decode(TomlEntry *self, char[:] out)
{
    Str raw = self->raw;
    int q = 0, i = 0, di = 0;

    if (self->kind != TOML_KEY || raw.s.len < 2)
        return -1;
    q = (u8)raw.s.data[0];
    if (q != '"' && q != '\'')
        return -1;
    if ((u8)raw.s.data[raw.s.len - 1] != q)
        return -1;
    for (i = 1; i < raw.s.len - 1;) {
        int c = (u8)raw.s.data[i];

        if (q == '\'' || c != '\\') {
            if (di + 1 > out.len)
                return -1;
            out.data[di++] = (char)c;
            i++;
            continue;
        }
        i++;
        if (i >= raw.s.len - 1)
            return -1;
        c = (u8)raw.s.data[i];
        if (c == 'b') {
            c = '\b';
        } else if (c == 't') {
            c = '\t';
        } else if (c == 'n') {
            c = '\n';
        } else if (c == 'f') {
            c = '\f';
        } else if (c == 'r') {
            c = '\r';
        } else if (c == '"' || c == '\\') {
            /* 原样 */
        } else if (c == 'u' || c == 'U') {
            int n = (c == 'u') ? 4 : 8, k = 0;
            u32 cp = 0;

            i++;
            if (i + n > raw.s.len - 1)
                return -1;
            for (k = 0; k < n; k++) {
                int h = t_hex((u8)raw.s.data[i + k]);

                if (h < 0)
                    return -1;
                cp = (cp << 4) | (u32)h;
            }
            i += n;
            if (!t_utf8(cp, out, &di))
                return -1;
            continue;
        } else {
            return -1;
        }
        if (di + 1 > out.len)
            return -1;
        out.data[di++] = (char)c;
        i++;
    }
    return di;
}

/* ---- 值解析 ---- */

/* 整数：十进制/0x/0o/0b、允许 _ 分隔、可带正负号；放不下返回 0 */
int toml_int(Str raw, i64 *out)
{
    int i = 0, neg = 0, base = 10, digits = 0;
    u64 v = 0, lim = 0;

    if (!out || raw.s.len == 0)
        return 0;
    if (raw.s.data[0] == '+' || raw.s.data[0] == '-') {
        neg = (raw.s.data[0] == '-');
        i = 1;
    }
    if (i + 1 < raw.s.len && raw.s.data[i] == '0') {
        int c = (u8)raw.s.data[i + 1];

        if (c == 'x' || c == 'X') {
            base = 16;
            i += 2;
        } else if (c == 'o' || c == 'O') {
            base = 8;
            i += 2;
        } else if (c == 'b' || c == 'B') {
            base = 2;
            i += 2;
        }
    }
    lim = neg ? 9223372036854775808ULL : 9223372036854775807ULL;
    for (; i < raw.s.len; i++) {
        int c = (u8)raw.s.data[i];
        int d = -1;

        if (c == '_' && digits > 0) {
            continue;
        }
        if (c >= '0' && c <= '9')
            d = c - '0';
        else if (c >= 'a' && c <= 'f')
            d = c - 'a' + 10;
        else if (c >= 'A' && c <= 'F')
            d = c - 'A' + 10;
        if (d < 0 || d >= base)
            return 0;
        if (v > (lim - (u64)d) / (u64)base)
            return 0;
        v = v * (u64)base + (u64)d;
        digits++;
    }
    if (digits == 0)
        return 0;
    *out = neg ? (i64)(0u - v) : (i64)v;
    return 1;
}

/* 布尔：只认小写 true/false */
int toml_bool(Str raw, int *out)
{
    if (!out)
        return 0;
    if (raw.s.len == 4 && memcmp(raw.s.data, "true", 4) == 0) {
        *out = 1;
        return 1;
    }
    if (raw.s.len == 5 && memcmp(raw.s.data, "false", 5) == 0) {
        *out = 0;
        return 1;
    }
    return 0;
}

/* 浮点：去掉 _ 之后交给 std.text.num 的 parse_f64；inf/nan 自己处理 */
int toml_float(Str raw, f64 *out)
{
    char tmp[64] = { 0 };
    int i = 0, n = 0, neg = 0, off = 0;
    Str t = { { (char *)0, 0 } };
    f64 v = 0.0;

    if (!out || raw.s.len == 0)
        return 0;
    if (raw.s.data[0] == '+' || raw.s.data[0] == '-') {
        neg = (raw.s.data[0] == '-');
        off = 1;
    }
    if (raw.s.len - off == 3 && memcmp(raw.s.data + off, "inf", 3) == 0) {
        f64 zero = 0.0;

        *out = neg ? -1.0 / zero : 1.0 / zero;
        return 1;
    }
    if (raw.s.len - off == 3 && memcmp(raw.s.data + off, "nan", 3) == 0) {
        f64 zero = 0.0;

        *out = zero / zero;
        return 1;
    }
    if (raw.s.len >= (int)sizeof tmp)
        return 0;
    for (i = 0; i < raw.s.len; i++) {
        if (raw.s.data[i] == '_' && n > 0)
            continue;
        tmp[n++] = raw.s.data[i];
    }
    {
        Str s = { { tmp, n } };

        t = s;
    }
    parse_f64(t.s, &v) catch e { return 0; };
    *out = v;
    return 1;
}

/* 数组元素个数；不是 [..] 返回 -1 */
int toml_array_len(Str raw)
{
    int i = 1, depth = 0, q = 0, n = 0, has = 0;

    if (raw.s.len < 2 || raw.s.data[0] != '['
        || raw.s.data[raw.s.len - 1] != ']')
        return -1;
    while (i < raw.s.len - 1) {
        int c = (u8)raw.s.data[i];

        if (q != 0) {
            if (q == '"' && c == '\\') {
                i += 2;
                continue;
            }
            if (c == q)
                q = 0;
            i++;
            continue;
        }
        if (c == '"' || c == '\'') {
            q = c;
            has = 1;
            i++;
            continue;
        }
        if (c == '[' || c == '{') {
            depth++;
            has = 1;
            i++;
            continue;
        }
        if (c == ']' || c == '}') {
            depth--;
            i++;
            continue;
        }
        if (c == ',' && depth == 0) {
            if (has)
                n++;
            has = 0;
            i++;
            continue;
        }
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
            i++;
            continue;
        }
        has = 1;
        i++;
    }
    if (has)
        n++;
    return n;
}

/* 第 idx 个元素的原始文本（已 trim）；越界/不是数组返回 0 */
int toml_array_at(Str raw, int idx, Str *out)
{
    int i = 1, depth = 0, q = 0, n = 0, start = -1;

    if (!out || idx < 0 || raw.s.len < 2 || raw.s.data[0] != '['
        || raw.s.data[raw.s.len - 1] != ']')
        return 0;
    start = -1;
    while (i < raw.s.len - 1) {
        int c = (u8)raw.s.data[i];

        if (q != 0) {
            if (q == '"' && c == '\\') {
                i += 2;
                continue;
            }
            if (c == q)
                q = 0;
            i++;
            continue;
        }
        if (c == '"' || c == '\'') {
            if (start < 0)
                start = i;
            q = c;
            i++;
            continue;
        }
        if (c == '[' || c == '{') {
            if (start < 0)
                start = i;
            depth++;
            i++;
            continue;
        }
        if (c == ']' || c == '}') {
            depth--;
            i++;
            continue;
        }
        if (c == ',' && depth == 0) {
            if (start >= 0 && n == idx) {
                int e = i;

                while (e > start && t_is_ws((u8)raw.s.data[e - 1]))
                    e--;
                {
                    Str s = { { raw.s.data + start, e - start } };

                    *out = s;
                }
                return 1;
            }
            if (start >= 0)
                n++;
            start = -1;
            i++;
            continue;
        }
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
            i++;
            continue;
        }
        if (start < 0)
            start = i;
        i++;
    }
    if (start >= 0 && n == idx) {
        int e = raw.s.len - 1;

        while (e > start && t_is_ws((u8)raw.s.data[e - 1]))
            e--;
        {
            Str s = { { raw.s.data + start, e - start } };

            *out = s;
        }
        return 1;
    }
    return 0;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int t_eq(Str s, const char *want)
{
    int n = (int)strlen(want);

    return s.s.len == n && (n == 0 || memcmp(s.s.data, want, (usize)n) == 0);
}

test "表、键值与行号" {
    Str doc = { S("# demo\n"
                  "title = \"demo\"\n"
                  "count = 42\n"
                  "[server]\n"
                  "host = \"localhost\"   # comment\n"
                  "port = 8080\n"
                  "[[route]]\n"
                  "path = \"/a\"\n"
                  "[[route]]\n"
                  "path = \"/b\"\n") };
    TomlReader r = toml_open(doc);
    TomlEntry e = { 0 };
    int n = 0, tables = 0, keys = 0, aot = 0;

    while (r.next(&e) == 1) {
        n++;
        if (e.kind == TOML_TABLE) {
            tables++;
            if (tables == 1 && !t_eq(e.section, "server"))
                return err(1, "server 表名");
        } else if (e.kind == TOML_ARRAY_TABLE) {
            aot++;
            if (!t_eq(e.section, "route"))
                return err(2, "route 表数组");
        } else {
            keys++;
            if (t_eq(e.key, "title")) {
                if (!t_eq(e.raw, "\"demo\"") || e.line != 2)
                    return err(3, "title 的值/行号");
            } else if (t_eq(e.key, "count")) {
                i64 v = 0;

                if (!toml_int(e.raw, &v) || v != 42)
                    return err(4, "count");
            } else if (t_eq(e.key, "host")) {
                if (!t_eq(e.raw, "\"localhost\"") || !t_eq(e.section, "server"))
                    return err(5, "host 的 section");
            } else if (t_eq(e.key, "port")) {
                i64 v = 0;

                if (!toml_int(e.raw, &v) || v != 8080)
                    return err(6, "port");
            } else if (t_eq(e.key, "path")) {
                if (e.section.s.len != 5)
                    return err(7, "path 属于 route");
            }
        }
    }
    if (r.err != 0)
        return err(8, "不该有错误");
    if (n != 9 || tables != 1 || aot != 2 || keys != 6)
        return err(9, "条目计数");
}

test "字符串反转义" {
    Str doc = { S("a = \"x\\ty\"\n"
                  "b = 'x\\ty'\n"
                  "c = \"\\u4e2d\\u6587\"\n"
                  "d = \"quote: \\\"q\\\"\"\n"
                  "e = \"\\U0001F642\"\n"
                  "f = 12\n") };
    TomlReader r = toml_open(doc);
    TomlEntry e = { 0 };
    char buf[64] = { 0 };

    while (r.next(&e) == 1) {
        int n = e.decode((char[:]){ buf, (int)sizeof buf - 1 });

        buf[n > 0 ? n : 0] = 0;
        if (t_eq(e.key, "a")) {
            if (n != 3 || strcmp(buf, "x\ty") != 0)
                return err(10, "基本字符串的 \\t");
        } else if (t_eq(e.key, "b")) {
            if (n != 4 || strcmp(buf, "x\\ty") != 0)
                return err(11, "字面量字符串不转义");
        } else if (t_eq(e.key, "c")) {
            if (n != 6 || memcmp(buf, "\xe4\xb8\xad\xe6\x96\x87", 6) != 0)
                return err(12, "\\uXXXX");
        } else if (t_eq(e.key, "d")) {
            if (strcmp(buf, "quote: \"q\"") != 0)
                return err(13, "转义引号");
        } else if (t_eq(e.key, "e")) {
            if (n != 4 || memcmp(buf, "\xf0\x9f\x99\x82", 4) != 0)
                return err(14, "\\UXXXXXXXX");
        } else if (t_eq(e.key, "f")) {
            if (n != -1)
                return err(15, "非字符串 decode 要失败");
        }
    }
}

test "整数、浮点与布尔" {
    Str doc = { S("a = 42\n"
                  "b = -7\n"
                  "c = 0xFF\n"
                  "d = 0o17\n"
                  "e = 0b1010\n"
                  "f = 1_000_000\n"
                  "g = 0.75\n"
                  "h = -1.5e3\n"
                  "i = inf\n"
                  "j = nan\n"
                  "k = true\n"
                  "l = false\n"
                  "m = \"42\"\n") };
    TomlReader r = toml_open(doc);
    TomlEntry e = { 0 };
    i64 iv = 0;
    f64 fv = 0.0;
    int bv = 0;

    while (r.next(&e) == 1) {
        if (t_eq(e.key, "a")) {
            if (!toml_int(e.raw, &iv) || iv != 42)
                return err(16, "42");
        } else if (t_eq(e.key, "b")) {
            if (!toml_int(e.raw, &iv) || iv != -7)
                return err(17, "-7");
        } else if (t_eq(e.key, "c")) {
            if (!toml_int(e.raw, &iv) || iv != 255)
                return err(18, "0xFF");
        } else if (t_eq(e.key, "d")) {
            if (!toml_int(e.raw, &iv) || iv != 15)
                return err(19, "0o17");
        } else if (t_eq(e.key, "e")) {
            if (!toml_int(e.raw, &iv) || iv != 10)
                return err(20, "0b1010");
        } else if (t_eq(e.key, "f")) {
            if (!toml_int(e.raw, &iv) || iv != 1000000)
                return err(21, "1_000_000");
        } else if (t_eq(e.key, "g")) {
            if (!toml_float(e.raw, &fv) || fv < 0.7499 || fv > 0.7501)
                return err(22, "0.75");
        } else if (t_eq(e.key, "h")) {
            if (!toml_float(e.raw, &fv) || fv > -1499.9 || fv < -1500.1)
                return err(23, "-1.5e3");
        } else if (t_eq(e.key, "i")) {
            if (!toml_float(e.raw, &fv) || !(fv > 1e308))
                return err(24, "inf");
        } else if (t_eq(e.key, "j")) {
            if (!toml_float(e.raw, &fv) || fv == fv)
                return err(25, "nan");
        } else if (t_eq(e.key, "k")) {
            if (!toml_bool(e.raw, &bv) || bv != 1)
                return err(26, "true");
        } else if (t_eq(e.key, "l")) {
            if (!toml_bool(e.raw, &bv) || bv != 0)
                return err(27, "false");
        } else if (t_eq(e.key, "m")) {
            if (toml_int(e.raw, &iv))
                return err(28, "带引号的 42 不是整数");
        }
    }
    /* 溢出的整数要拒绝 */
    {
        Str big = { S("9223372036854775808") };

        if (toml_int(big, &iv))
            return err(29, "i64 溢出");
    }
    {
        Str neg = { S("-9223372036854775808") };
        Str bad = { S("12x") };
        Str empty = { S("") };
        Str upper = { S("TRUE") };

        if (!toml_int(neg, &iv) || iv != (-9223372036854775807LL - 1))
            return err(30, "i64 最小值");
        if (toml_int(bad, &iv) || toml_int(empty, &iv))
            return err(31, "坏整数");
        if (toml_bool(upper, &bv))
            return err(32, "TRUE 不是 TOML 布尔");
    }
}

test "数组" {
    Str doc = { S("names = [\"a\", \"b\", \"c\"]\n"
                  "empty = []\n"
                  "multi = [\n  1,\n  2,\n]\n"
                  "nested = [[1, 2], [3]]\n") };
    TomlReader r = toml_open(doc);
    TomlEntry e = { 0 };
    Str el = { { (char *)0, 0 } };

    while (r.next(&e) == 1) {
        if (t_eq(e.key, "names")) {
            if (toml_array_len(e.raw) != 3)
                return err(33, "names 的长度");
            if (!toml_array_at(e.raw, 1, &el) || !t_eq(el, "\"b\""))
                return err(34, "names[1]");
            if (toml_array_at(e.raw, 3, &el))
                return err(35, "越界");
        } else if (t_eq(e.key, "empty")) {
            if (toml_array_len(e.raw) != 0)
                return err(36, "空数组");
        } else if (t_eq(e.key, "multi")) {
            if (toml_array_len(e.raw) != 2 || !toml_array_at(e.raw, 1, &el)
                || !t_eq(el, "2"))
                return err(37, "跨行数组");
        } else if (t_eq(e.key, "nested")) {
            if (toml_array_len(e.raw) != 2 || !toml_array_at(e.raw, 0, &el)
                || !t_eq(el, "[1, 2]"))
                return err(38, "嵌套数组");
        }
    }
    {
        Str notarr = { S("42") };

        if (toml_array_len(notarr) != -1)
            return err(39, "不是数组");
    }
}

test "语法错误与恢复" {
    Str doc = { S("ok = 1\n"
                  "bad line\n"
                  "good = 2\n") };
    TomlReader r = toml_open(doc);
    TomlEntry e = { 0 };
    int rc = 0;

    if (r.next(&e) != 1 || !t_eq(e.key, "ok"))
        return err(40, "第一条");
    rc = r.next(&e);
    if (rc != -1 || r.err != 2)
        return err(41, "缺 = 的行号");
    if (r.next(&e) != 1 || !t_eq(e.key, "good"))
        return err(42, "错误后恢复");
    if (r.next(&e) != 0)
        return err(43, "结束");

    /* 表头没闭合 */
    {
        Str bad = { S("[server\nhost = 1\n") };
        TomlReader r2 = toml_open(bad);

        if (r2.next(&e) != -1 || r2.err != 1)
            return err(44, "表头没闭合");
    }
    /* 字符串没闭合 */
    {
        Str bad = { S("a = \"abc\nb = 1\n") };
        TomlReader r2 = toml_open(bad);

        if (r2.next(&e) != -1 || r2.err != 1)
            return err(45, "字符串没闭合");
    }
    /* 空键 */
    {
        Str bad = { S("= 1\n") };
        TomlReader r2 = toml_open(bad);

        if (r2.next(&e) != -1 || r2.err != 1)
            return err(46, "空键");
    }
    /* 空值 */
    {
        Str bad = { S("a =\n") };
        TomlReader r2 = toml_open(bad);

        if (r2.next(&e) != -1 || r2.err != 1)
            return err(47, "空值");
    }
}
