/* std/core/series：一组数的均值、方差、标准差、协方差与相关系数（方法优先）。
 *
 *     import std.core.series;
 *
 *     double xs[5] = { 1, 2, 3, 4, 5 };
 *     double ys[5] = { 2, 4, 6, 8, 10 };
 *     Series a = { 0 };
 *     Series b = { 0 };
 *     a.bind(xs, 5);              // 方法：bind / mean / stddev / corr …
 *     b.bind(ys, 5);
 *     a.mean();                   // 3
 *     a.corr(&b);                 // 1
 *
 * `Series` 只是「指针 + 长度」的视图，不拷贝也不拥有数据。
 *
 * 约定：
 *
 * - 方差/协方差用**样本**公式（除以 `n-1`），`n < 2` 时返回 0；
 * - `stddev` 是 `variance` 的平方根（用 libm 的 `sqrt`）；
 * - `corr` 是 Pearson 相关系数，任一序列标准差为 0 时返回 0（避免除零）；
 * - `cov`/`corr` 长度不等时按较短的算，并且**均值也只取配对的那 n 个样本**；
 * - `min`/`max` 空序列返回 0；`mean` 空序列返回 0；
 * - 不做离群点处理，也不排序（要分位数用 `std.core.quantile`）。
 */
#include <math.h>
#include <string.h>

module std.core.series;
import std.core.types;
import std.text.str;

struct Series {
    const double *p;
    int n;
};

int bind(Series *s, const double *p, int n)
{
    if (!s || !p || n < 0)
        return -1;
    s->p = p;
    s->n = n;
    return 1;
}

int count(Series *s)
{
    return s ? s->n : 0;
}

double mean(Series *s)
{
    double sum = 0;
    int i = 0;

    if (!s || !s->p || s->n <= 0)
        return 0;
    for (i = 0; i < s->n; i++)
        sum += s->p[i];
    return sum / (double)s->n;
}

double variance(Series *s)
{
    double m = 0, sum = 0;
    int i = 0;

    if (!s || !s->p || s->n < 2)
        return 0;
    m = mean(s);
    for (i = 0; i < s->n; i++) {
        double d = s->p[i] - m;

        sum += d * d;
    }
    return sum / (double)(s->n - 1);
}

double stddev(Series *s)
{
    double v = variance(s);

    if (v <= 0)
        return 0;
    return sqrt(v);
}

double minimum(Series *s)
{
    double best = 0;
    int i = 0;

    if (!s || !s->p || s->n <= 0)
        return 0;
    best = s->p[0];
    for (i = 1; i < s->n; i++) {
        if (s->p[i] < best)
            best = s->p[i];
    }
    return best;
}

double maximum(Series *s)
{
    double best = 0;
    int i = 0;

    if (!s || !s->p || s->n <= 0)
        return 0;
    best = s->p[0];
    for (i = 1; i < s->n; i++) {
        if (s->p[i] > best)
            best = s->p[i];
    }
    return best;
}

double cov(Series *a, Series *b)
{
    int n = 0, i = 0;
    double ma = 0, mb = 0, sum = 0;

    if (!a || !b || !a->p || !b->p)
        return 0;
    n = a->n < b->n ? a->n : b->n;
    if (n < 2)
        return 0;
    /* 均值只取配对的前 n 个，保证与协方差同一批样本 */
    for (i = 0; i < n; i++) {
        ma += a->p[i];
        mb += b->p[i];
    }
    ma /= (double)n;
    mb /= (double)n;
    for (i = 0; i < n; i++) {
        sum += (a->p[i] - ma) * (b->p[i] - mb);
    }
    return sum / (double)(n - 1);
}

double corr(Series *a, Series *b)
{
    double sa = 0, sb = 0;

    if (!a || !b)
        return 0;
    sa = stddev(a);
    sb = stddev(b);
    if (sa == 0 || sb == 0)
        return 0;
    return cov(a, b) / (sa * sb);
}

/* 一次算全：均值/样本标准差/最小值/最大值 */
int summarize(Series *s, double *mean_out, double *sd_out, double *min_out,
              double *max_out)
{
    if (!s || !s->p || s->n <= 0)
        return -1;
    if (mean_out)
        *mean_out = mean(s);
    if (sd_out)
        *sd_out = stddev(s);
    if (min_out)
        *min_out = minimum(s);
    if (max_out)
        *max_out = maximum(s);
    return 1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int snear2(double a, double b, double eps)
{
    double d = a - b;

    if (d < 0)
        d = -d;
    return d <= eps;
}

test "series：均值与离散度" {
    double xs[5] = { 1, 2, 3, 4, 5 };
    Series a = { 0 };
    double v = 0;

    if (a.bind(xs, 5) != 1)
        return err(1, "bind 失败");
    if (a.count() != 5 || !snear2(a.mean(), 3.0, 1e-9))
        return err(2, "均值应该是 3");
    if (!snear2(a.variance(), 2.5, 1e-9))
        return err(3, "样本方差应该是 2.5");
    if (!snear2(a.stddev(), sqrt(2.5), 1e-9))
        return err(4, "样本标准差不对");
    if (!snear2(a.minimum(), 1.0, 1e-9) || !snear2(a.maximum(), 5.0, 1e-9))
        return err(5, "最值不对");
    /* 单元素：方差 0 */
    {
        double one[1] = { 42 };
        Series s = { 0 };

        s.bind(one, 1);
        if (!snear2(s.variance(), 0.0, 1e-9) || !snear2(s.mean(), 42.0, 1e-9))
            return err(6, "单元素序列不对");
    }
    return 0;
}

test "series：协方差与相关" {
    double xs[5] = { 1, 2, 3, 4, 5 };
    double ys[5] = { 2, 4, 6, 8, 10 };
    double zs[5] = { 10, 8, 6, 4, 2 };
    Series a = { 0 };
    Series b = { 0 };
    Series c = { 0 };
    double m = 0, sd = 0, lo = 0, hi = 0;

    a.bind(xs, 5);
    b.bind(ys, 5);
    c.bind(zs, 5);
    if (!snear2(a.cov(&b), 5.0, 1e-9))
        return err(8, "协方差应该是 5");
    if (!snear2(a.corr(&b), 1.0, 1e-9))
        return err(9, "完全线性相关应该 1");
    if (!snear2(a.corr(&c), -1.0, 1e-9))
        return err(10, "完全负相关应该 -1");
    if (!snear2(a.summarize(&m, &sd, &lo, &hi), 1.0, 1e-9)
        || !snear2(m, 3.0, 1e-9) || !snear2(lo, 1.0, 1e-9)
        || !snear2(hi, 5.0, 1e-9))
        return err(11, "summarize 不对");
    /* 常数列与别人算相关 → 0（避免除零） */
    {
        double flat[5] = { 7, 7, 7, 7, 7 };
        Series f = { 0 };

        f.bind(flat, 5);
        if (!snear2(f.corr(&b), 0.0, 1e-9) || !snear2(f.stddev(), 0.0, 1e-9))
            return err(12, "常数列的标准差与相关都应该是 0");
    }
    /* 长度不等按较短的算 */
    {
        double short_y[3] = { 2, 4, 6 };
        Series sy = { 0 };

        sy.bind(short_y, 3);
        if (!snear2(a.cov(&sy), 2.0, 1e-9))
            return err(13, "长度不等时应该按前 3 个配对算（协方差 2）");
    }
    if (a.bind(0, 5) != -1)
        return err(14, "空指针应该 -1");
}
