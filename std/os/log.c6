/* std/os/log：带级别过滤的定长环形日志（不分配、不碰 I/O）。
 *
 *     import std.os.log;
 *
 *     LogRec recs[16] = { 0 };
 *     Log lg = { 0 };
 *     lg.init(recs, 16, LOG_INFO);
 *     lg.add(LOG_WARN, S("net"), S("timeout"));
 *     // 级别低的（TRACE/DEBUG）会被过滤掉
 *
 * 设计取舍：日志记录是**定长槽位**（`scope` 24 字节、`msg` 96 字节），
 * 环形覆盖最旧的记录；没有 malloc，也不写文件。真正的输出由调用方拿 `dump`
 * 或 `text` 自己决定。
 *
 * 约定：
 *
 * - 级别从 `LOG_TRACE`(0) 到 `LOG_FATAL`(5)，`max_level` 小于等于它的记录才会
 *   落盘（`LOG_INFO` 表示「INFO 及更严重」）；
 * - `add` 返回 1 写入、0 被过滤、-1 参数不合法；`filtered` 记被过滤的条数，
 *   `dropped` 记因环形覆盖而丢掉的条数；
 * - `at(lg, 0)` 是最新一条，`at(lg, n-1)` 是最旧一条（`n = count`）；
 * - `text` 生成 `"#<seq> LEVEL scope: msg"`，`dump` 按从旧到新逐行写；
 * - 超长 `scope`/`msg` 会被截断（仍以 0 结尾），不做省略号标记。
 */
#include <string.h>

module std.os.log;
import std.core.types;
import std.text.str;

enum {
    LOG_TRACE = 0,
    LOG_DEBUG = 1,
    LOG_INFO = 2,
    LOG_WARN = 3,
    LOG_ERROR = 4,
    LOG_FATAL = 5
};

struct LogRec {
    int level;
    i64 seq;
    int scope_len;
    int msg_len;
    char scope[24];
    char msg[96];
};

struct Log {
    LogRec *recs;
    int cap;
    int used;
    int next;
    i64 seq;
    int max_level;
    i64 nfilt;
    i64 ndrop;
};

static const char *log_names[6] = { "TRACE", "DEBUG", "INFO",
                                    "WARN",  "ERROR", "FATAL" };

int init(Log *lg, LogRec *recs, int cap, int max_level)
{
    if (!lg || !recs || cap <= 0)
        return -1;
    if (max_level < LOG_TRACE || max_level > LOG_FATAL)
        return -1;
    memset(recs, 0, sizeof(LogRec) * (size_t)cap);
    lg->recs = recs;
    lg->cap = cap;
    lg->used = 0;
    lg->next = 0;
    lg->seq = 0;
    lg->max_level = max_level;
    lg->nfilt = 0;
    lg->ndrop = 0;
    return 1;
}

int set_level(Log *lg, int level)
{
    if (!lg || level < LOG_TRACE || level > LOG_FATAL)
        return -1;
    lg->max_level = level;
    return 1;
}

int level(Log *lg)
{
    return lg ? lg->max_level : -1;
}

const char *log_level_name(int level)
{
    if (level < LOG_TRACE || level > LOG_FATAL)
        return "?";
    return log_names[level];
}

int log_level_parse(char[:] name)
{
    int i = 0;

    if (!name.data || name.len <= 0)
        return -1;
    for (i = 0; i < 6; i++) {
        int k = 0, eq = 1;

        for (k = 0; log_names[i][k]; k++) {
            char c = name.data[k];

            if (k >= name.len) {
                eq = 0;
                break;
            }
            if (c >= 'a' && c <= 'z')
                c = (char)(c - 'a' + 'A');
            if (c != log_names[i][k]) {
                eq = 0;
                break;
            }
        }
        if (eq && k == name.len)
            return i;
    }
    return -1;
}

static void log_copy(char *dst, int cap, char[:] src, int *out_len)
{
    int i = 0;

    for (i = 0; i < src.len && i + 1 < cap; i++)
        dst[i] = src.data[i];
    dst[i] = 0;
    if (out_len)
        *out_len = i;
}

int add(Log *lg, int level, char[:] scope, char[:] msg)
{
    LogRec *r = 0;

    if (!lg || !lg->recs || level < LOG_TRACE || level > LOG_FATAL)
        return -1;
    if (level < lg->max_level) {
        lg->nfilt++;
        return 0;
    }
    r = &lg->recs[lg->next];
    r->level = level;
    r->seq = lg->seq;
    log_copy(r->scope, (int)sizeof r->scope,
             (char[:]){ scope.data, scope.data ? scope.len : 0 },
             &r->scope_len);
    log_copy(r->msg, (int)sizeof r->msg,
             (char[:]){ msg.data, msg.data ? msg.len : 0 }, &r->msg_len);
    lg->seq++;
    lg->next = (lg->next + 1) % lg->cap;
    if (lg->used < lg->cap)
        lg->used++;
    else
        lg->ndrop++;
    return 1;
}

int count(Log *lg)
{
    return lg ? lg->used : 0;
}

int dropped(Log *lg)
{
    return lg ? (int)lg->ndrop : 0;
}

int filtered(Log *lg)
{
    return lg ? (int)lg->nfilt : 0;
}

LogRec *at(Log *lg, int idx)
{
    int pos = 0;

    if (!lg || !lg->recs || idx < 0 || idx >= lg->used)
        return 0;
    pos = (lg->next - 1 - idx) % lg->cap;
    if (pos < 0)
        pos += lg->cap;
    return &lg->recs[pos];
}

int count_level(Log *lg, int level)
{
    int i = 0, n = 0;

    for (i = 0; i < count(lg); i++) {
        LogRec *r = at(lg, i);

        if (r && r->level == level)
            n++;
    }
    return n;
}

static int log_puts(char *dst, int cap, int o, const char *s)
{
    int i = 0;

    for (i = 0; s[i]; i++) {
        if (o + 1 > cap)
            return -1;
        dst[o++] = s[i];
    }
    return o;
}

static int log_putnum(char *dst, int cap, int o, i64 v)
{
    char buf[24] = { 0 };
    int k = 0, i = 0;

    if (v < 0) {
        if (o + 1 > cap)
            return -1;
        dst[o++] = '-';
        v = -v;
    }
    if (v == 0) {
        buf[0] = '0';
        k = 1;
    }
    while (v > 0 && k < 22) {
        buf[k++] = (char)('0' + (int)(v % 10));
        v /= 10;
    }
    for (i = k - 1; i >= 0; i--) {
        if (o + 1 > cap)
            return -1;
        dst[o++] = buf[i];
    }
    return o;
}

int text(Log *lg, int idx, char *dst, int cap)
{
    LogRec *r = at(lg, idx);
    int o = 0;

    if (!dst || cap <= 0 || !r)
        return -1;
    o = log_puts(dst, cap, 0, "#");
    if (o < 0)
        return -1;
    o = log_putnum(dst, cap, o, r->seq);
    if (o < 0)
        return -1;
    o = log_puts(dst, cap, o, " ");
    if (o < 0)
        return -1;
    o = log_puts(dst, cap, o, log_level_name(r->level));
    if (o < 0)
        return -1;
    o = log_puts(dst, cap, o, " ");
    if (o < 0)
        return -1;
    o = log_puts(dst, cap, o, r->scope);
    if (o < 0)
        return -1;
    o = log_puts(dst, cap, o, ": ");
    if (o < 0)
        return -1;
    o = log_puts(dst, cap, o, r->msg);
    if (o < 0)
        return -1;
    if (o < cap)
        dst[o] = 0;
    return o;
}

int dump(Log *lg, char *dst, int cap)
{
    int o = 0, i = 0;

    if (!dst || cap <= 0)
        return -1;
    for (i = count(lg) - 1; i >= 0; i--) {
        int n = text(lg, i, dst + o, cap - o);

        if (n < 0)
            return -1;
        o += n;
        if (o + 1 >= cap)
            return -1;
        dst[o++] = '\n';
    }
    if (o < cap)
        dst[o] = 0;
    return o;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "log：级别过滤与环形覆盖" {
    LogRec recs[4] = { 0 };
    Log lg = { 0 };
    LogRec *r = 0;
    char out[256] = { 0 };

    if (lg.init(recs, 4, LOG_INFO) != 1)
        return err(1, "初始化失败");
    if (lg.add(LOG_DEBUG, S("app"), S("debug msg")) != 0)
        return err(2, "DEBUG 应该被过滤");
    if (lg.add(LOG_INFO, S("app"), S("info msg")) != 1)
        return err(3, "INFO 应该写入");
    if (lg.filtered() != 1)
        return err(4, "过滤计数不对");
    if (lg.add(LOG_ERROR, S("net"), S("boom")) != 1)
        return err(5, "ERROR 应该写入");
    if (lg.count() != 2)
        return err(6, "记录数不对");
    r = lg.at(0);
    if (!r || r->level != LOG_ERROR || memcmp(r->scope, "net", 3) != 0)
        return err(7, "最新一条应该是最先写的 ERROR");
    if (strcmp(r->msg, "boom") != 0)
        return err(8, "消息内容不对");
    r = lg.at(1);
    if (!r || r->level != LOG_INFO)
        return err(9, "第 2 条应该是 INFO");
    if (lg.text(0, out, (int)sizeof out) != 18
        || memcmp(out, "#1 ERROR net: boom", 18) != 0)
        return err(10, "格式化不对");
    if (lg.at(9) != 0)
        return err(11, "越界应该返回空指针");
    /* 塞满并覆盖 */
    lg.add(LOG_WARN, S("a"), S("1"));
    lg.add(LOG_WARN, S("b"), S("2"));
    lg.add(LOG_WARN, S("c"), S("3"));
    if (lg.count() != 4 || lg.dropped() != 1)
        return err(12, "环形覆盖计数不对");
    r = lg.at(0);
    if (!r || memcmp(r->scope, "c", 1) != 0)
        return err(13, "覆盖后最新的应该是 c");
    r = lg.at(3);
    if (!r || memcmp(r->scope, "net", 3) != 0)
        return err(14, "覆盖后最旧的应该是 net（app 那条被挤掉了）");
}

test "log：级别名与 dump" {
    LogRec recs[8] = { 0 };
    Log lg = { 0 };
    char out[512] = { 0 };
    int n = 0;

    if (log_level_parse(S("info")) != LOG_INFO
        || log_level_parse(S("WARN")) != LOG_WARN
        || log_level_parse(S("nope")) != -1)
        return err(15, "级别名解析不对");
    if (strcmp(log_level_name(LOG_FATAL), "FATAL") != 0
        || strcmp(log_level_name(9), "?") != 0)
        return err(16, "级别名输出不对");
    if (lg.init(recs, 8, LOG_TRACE) != 1)
        return err(17, "初始化失败");
    lg.add(LOG_TRACE, S("t"), S("one"));
    lg.add(LOG_FATAL, S("f"), S("two"));
    n = lg.dump(out, (int)sizeof out);
    if (n != 32)
        return err(18, "dump 长度不对");
    if (memcmp(out, "#0 TRACE t: one\n#1 FATAL f: two\n", 32) != 0)
        return err(19, "dump 内容不对");
    if (lg.count_level(LOG_TRACE) != 1
        || lg.count_level(LOG_INFO) != 0)
        return err(20, "按级别计数不对");
    if (lg.set_level(LOG_ERROR) != 1
        || lg.add(LOG_WARN, S("x"), S("y")) != 0)
        return err(21, "调高级别后 WARN 应该被过滤");
    if (lg.dump(out, 4) != -1)
        return err(22, "dump 容量不够应该 -1");
}
