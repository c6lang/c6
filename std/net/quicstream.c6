/* std/net/quicstream：QUIC 的流（RFC 9000 §2–§4）与流控（§4.1）。
 *
 *     import std.net.quicstream;
 *
 *     QStreams all = { 0 };
 *     all.init(0);                        -- 本端是客户端
 *     QStream *s = all.open(1, 0);        -- 打开一条双向流
 *     s.write("GET /\\r\\n", 7);
 *     u8 out[1200] = { 0 };
 *     int n = s->take(out, 1200);          -- 取出要装进 STREAM 帧的字节
 *     s.mark_fin();
 *
 * 这一层只管「一条流怎么收发字节、额度够不够」，不管包和加密——包交给
 * `std.net.quicconn`，加密交给 `std.net.quichp` / `std.net.aead`。
 *
 * 流的编号（RFC 9000 §2.1）就藏在那两个低位里：
 *
 *     bit 0：发起方，0 = 客户端，1 = 服务器
 *     bit 1：方向，0 = 双向，1 = 单向
 *     高位： 同一方向上的序号（第 0、1、2 … 条）
 *
 * 所以客户端的双向流是 0、4、8…，服务器发起的单向流是 3、7、11…
 *
 * 收发两个方向各有一块定长缓冲区（`QS_BUF`），都按**偏移**寻址：
 *
 * - 收：对端可以乱序、可以重叠重发，落到缓冲区的对应位置上就行；应用从头
 *   读，读过的字节就是可以丢的字节，`base` 跟着往前挪。对端声明的
 *   final_size 一旦给出就不能改，后面的数据越过它就按 PROTOCOL_VIOLATION
 *   处理（RFC 9000 §4.5）；
 * - 发：应用写进来的字节先排队，`take()` 一次取一段装进 STREAM 帧；能不能
 *   再写由流级（`send_max`）和连接级（`Streams.max_data`）两个额度共同决定，
 *   额度用光了就把 BLOCKED 帧发出去。
 *
 * 出了 `QS_BUF` 就报错，调用方要么先 `read()` 腾地方，要么自己加大缓冲区
 * ——这里不偷偷分配内存。
 *
 * 出错时返回 `-INVAL` / `-RANGE` / `-FULL` / `-BLOCKED` / `-PROTOCOL` 这些
 * 常量。模块里的 `enum Error` 成员会被编译器改写成带模块号段的值（见
 * grammar.md §8.1），所以**不要拿 -4 之类的字面量去比**，要么比常量，要么
 * 只看是不是负的。
 */
#include <string.h>

module std.net.quicstream;
import std.core.types;

enum Error {
    OK = 0,
    INVAL = 1,
    RANGE = 2,
    FULL = 3,                   /* 本地缓冲区不够，先读走再收 */
    BLOCKED = 4,                /* 流控额度用光 */
    PROTOCOL = 5                /* final_size 冲突、数据越过最终大小等 */
};

#define QS_BUF          4096
#define QS_MAX_STREAMS  16

/* ---- 流编号 ---- */

u64 qs_stream_id(int server, int uni, u64 index)
{
    return (index << 2) | (uni ? 2u : 0u) | (server ? 1u : 0u);
}

u64 qs_stream_index(u64 id) { return id >> 2; }
int qs_stream_uni(u64 id) { return (id & 2) != 0; }
int qs_stream_from_server(u64 id) { return (id & 1) != 0; }

/* ---- 一条流 ---- */

struct QStream {
    u64 id;
    int server;                 /* 本端是服务器 */

    /* 接收方向 */
    u64 base;                   /* buf[0] 对应的偏移 */
    u64 read_off;               /* 应用已读到的偏移 */
    u64 recv_off;               /* 已收到的最高偏移 */
    u64 final_size;
    u64 recv_max;               /* 本端允许对端发到的偏移（流级收额度） */
    int has_final;
    int fin_read;               /* 最终字节已经读出去了 */
    int stopped;                /* 本端发了 STOP_SENDING */
    u64 stop_err;

    /* 发送方向 */
    u64 tx_off;                 /* tx[0] 对应的偏移 */
    u64 tx_len;                 /* 排队待发的字节数 */
    u64 send_max;               /* 对端允许本端发到的偏移 */
    u64 sent_end;               /* 已经出队的最高偏移（= tx_off + tx_len 走过的） */
    int fin_pending;            /* 数据发完就带 FIN */
    int fin_sent;
    int reset;                  /* 本端发了 RESET_STREAM */
    u64 reset_err;

    u8 buf[QS_BUF];
    u8 tx[QS_BUF];
};

/* `server` 是本端的角色；`recv_max`/`send_max` 是双向各自的初值额度。 */
int init(QStream *s, u64 id, int server, u64 recv_max, u64 send_max)
{
    if (!s)
        return -1;
    memset(s, 0, sizeof *s);
    s->id = id;
    s->server = server ? 1 : 0;
    s->recv_max = recv_max;
    s->send_max = send_max;
    return 0;
}

u64 id_of(QStream *s) { return s ? s->id : 0; }
int is_uni(QStream *s) { return s ? qs_stream_uni(s->id) : 0; }
int is_server_stream(QStream *s) { return s ? s->server : 0; }

/* 本端能读、能写吗？单向流只有一个方向可用。 */
int can_read(QStream *s)
{
    if (!s)
        return 0;
    return !qs_stream_uni(s->id) || qs_stream_from_server(s->id) != s->server;
}

int can_write(QStream *s)
{
    if (!s)
        return 0;
    return !qs_stream_uni(s->id) || qs_stream_from_server(s->id) == s->server;
}

u64 read_off_of(QStream *s) { return s ? s->read_off : 0; }
u64 recv_off_of(QStream *s) { return s ? s->recv_off : 0; }
u64 send_off_of(QStream *s) { return s ? s->tx_off : 0; }
u64 send_max_of(QStream *s) { return s ? s->send_max : 0; }
u64 recv_max_of(QStream *s) { return s ? s->recv_max : 0; }
int fin_read_of(QStream *s) { return s ? s->fin_read : 0; }
int fin_sent_of(QStream *s) { return s ? s->fin_sent : 0; }
u64 final_size_of(QStream *s) { return s ? s->final_size : 0; }

/* 还有多少已收到、没读走的字节。 */
u64 pending_read(QStream *s)
{
    if (!s)
        return 0;
    return s->recv_off > s->read_off ? s->recv_off - s->read_off : 0;
}

/* 还有多少排队待发的字节。 */
u64 pending_write(QStream *s) { return s ? s->tx_len : 0; }

/* ---- 接收方向 ---- */

/* 把已读的字节从缓冲区里丢掉，给后面的数据腾地方。 */
static int slide(QStream *s, u64 need)
{
    u64 movable = 0;

    if (need == 0)
        return 0;
    movable = s->read_off - s->base;
    if (need > movable)
        return FULL;
    memmove(s->buf, s->buf + need, (size_t)(QS_BUF - need));
    s->base += need;
    return 0;
}

/* 收一段流数据（可乱序、可重叠）。`fin` 表示这是流的最后一段。 */
int put(QStream *s, u64 off, const void *data, int n, int fin)
{
    const u8 *p = (const u8 *)data;
    u64 end = 0;
    u64 i = 0;
    int rc = 0;

    if (!s || n < 0 || (n > 0 && !p))
        return -INVAL;
    end = off + (u64)n;
    if (end < off)
        return -RANGE;          /* 偏移回绕 */
    if (!can_read(s) || s->stopped)
        return -PROTOCOL;
    /* final_size 一旦出现就不能变，也不许有数据越过它 */
    if (s->has_final) {
        if (end > s->final_size)
            return -PROTOCOL;
    } else if (fin) {
        if (end < s->recv_off)
            return -PROTOCOL;
        s->final_size = end;
        s->has_final = 1;
    }
    if (fin && s->has_final && s->final_size != end)
        return -PROTOCOL;
    /* 流级收额度 */
    if (end > s->recv_max)
        return -BLOCKED;
    /* 缓冲区不够就先挪，挪不动说明应用一直没读 */
    if (end > s->base + QS_BUF) {
        rc = slide(s, end - (s->base + QS_BUF));
        if (rc != 0)
            return -rc;
    }
    /* 逐字节铺到位置上：已经收过的部分跳过，等价于「幂等」 */
    for (i = 0; i < (u64)n; i++) {
        u64 pos = off + i;

        if (pos >= s->base && pos < s->base + QS_BUF)
            s->buf[pos - s->base] = p[i];
    }
    if (end > s->recv_off)
        s->recv_off = end;
    return 0;
}

/* 读走已到齐的字节，返回读到的字节数。读到最后一块之后 `fin_read` 置 1。 */
int read(QStream *s, void *out, int cap)
{
    u64 avail = 0;
    int n = 0;

    if (!s || !out || cap <= 0)
        return -1;
    avail = s->recv_off - s->read_off;
    n = (int)(avail < (u64)cap ? avail : (u64)cap);
    if (n > 0) {
        memcpy(out, s->buf + (s->read_off - s->base), (size_t)n);
        s->read_off += (u64)n;
    }
    if (s->has_final && s->read_off == s->final_size)
        s->fin_read = 1;
    return n;
}

/* 本端不想收了：记下 STOP_SENDING 的错误码。 */
int stop(QStream *s, u64 app_err)
{
    if (!s)
        return -1;
    s->stopped = 1;
    s->stop_err = app_err;
    return 0;
}

int stopped_of(QStream *s) { return s ? s->stopped : 0; }
u64 stop_err_of(QStream *s) { return s ? s->stop_err : 0; }

/* 本端发过 RESET_STREAM 之后，对端还能发数据，但本端只统计不交付。 */
int reset_send(QStream *s, u64 app_err)
{
    if (!s)
        return -1;
    s->reset = 1;
    s->reset_err = app_err;
    return 0;
}

/* 调大一条流的发送额度（收到 MAX_STREAM_DATA 时用）。 */
int set_send_max(QStream *s, u64 v)
{
    if (!s)
        return -1;
    if (v > s->send_max)
        s->send_max = v;
    return 0;
}

/* 调大一条流的接收额度（对端读走数据之后我们放额度时用）。 */
int set_recv_max(QStream *s, u64 v)
{
    if (!s)
        return -1;
    if (v > s->recv_max)
        s->recv_max = v;
    return 0;
}

/* ---- 发送方向 ---- */

/* 应用写数据。受流级额度与本地缓冲区两道限制，返回写进去的字节数。 */
int write(QStream *s, const void *data, int n)
{
    const u8 *p = (const u8 *)data;
    u64 room = 0;

    if (!s || n < 0 || (n > 0 && !p))
        return -1;
    if (!can_write(s) || s->reset || s->fin_pending)
        return -1;
    if ((u64)n > QS_BUF - s->tx_len)
        n = (int)(QS_BUF - s->tx_len);
    /* 流级额度：已排队 + 新数据不能超过对端给的 send_max */
    room = s->send_max > s->tx_off + s->tx_len
        ? s->send_max - (s->tx_off + s->tx_len)
        : 0;
    if ((u64)n > room)
        n = (int)room;
    if (n <= 0)
        return 0;
    memcpy(s->tx + s->tx_len, p, (size_t)n);
    s->tx_len += (u64)n;
    s->sent_end = s->tx_off + s->tx_len;
    return n;
}

/* 取一段要装进 STREAM 帧的字节（从偏移 0 起按序取）。 */
int take(QStream *s, void *out, int cap)
{
    int n = 0;
    u64 rest = 0;

    if (!s || !out || cap <= 0)
        return -1;
    if (s->tx_len == 0)
        return 0;
    n = (int)(s->tx_len < (u64)cap ? s->tx_len : (u64)cap);
    memcpy(out, s->tx, (size_t)n);
    s->tx_off += (u64)n;
    rest = s->tx_len - (u64)n;
    if (rest > 0)
        memmove(s->tx, s->tx + n, (size_t)rest);
    s->tx_len = rest;
    if (s->fin_pending && s->tx_len == 0)
        s->fin_sent = 1;
    return n;
}

/* 所有数据都发完之后带 FIN。 */
int mark_fin(QStream *s)
{
    if (!s)
        return -1;
    s->fin_pending = 1;
    if (s->tx_len == 0)
        s->fin_sent = 1;
    return 0;
}

int fin_pending_of(QStream *s) { return s ? s->fin_pending : 0; }
int reset_of(QStream *s) { return s ? s->reset : 0; }
u64 reset_err_of(QStream *s) { return s ? s->reset_err : 0; }

/* ---- 连接级的流表与流控（§4.1） ---- */

struct QStreams {
    QStream s[QS_MAX_STREAMS];
    int count;
    int server;
    u64 max_data;               /* 对端给的连接级发送额度 */
    u64 sent_data;              /* 已从所有流里出队的总字节 */
    u64 recv_max_data;          /* 我们给对端的连接级接收额度 */
    u64 recv_data;              /* 从所有流里收到的总字节 */
    u64 max_streams_bidi;       /* 我们允许对端开的双向流数 */
    u64 max_streams_uni;
    int opened_bidi;            /* 对端已开的双向流数 */
    int opened_uni;
};

int init(QStreams *a, int server)
{
    if (!a)
        return -1;
    memset(a, 0, sizeof *a);
    a->server = server ? 1 : 0;
    return 0;
}

int count_of(QStreams *a) { return a ? a->count : 0; }
u64 max_data_of(QStreams *a) { return a ? a->max_data : 0; }
u64 recv_data_of(QStreams *a) { return a ? a->recv_data : 0; }
u64 recv_max_data_of(QStreams *a) { return a ? a->recv_max_data : 0; }

QStream *find(QStreams *a, u64 id)
{
    int i = 0;

    if (!a)
        return 0;
    for (i = 0; i < a->count; i++)
        if (a->s[i].id == id)
            return &a->s[i];
    return 0;
}

/* 按编号建一条流（本地发起或对端发起都走这里）。 */
QStream *create(QStreams *a, u64 id, u64 recv_max, u64 send_max)
{
    int from_peer = 0;
    int idx = 0;

    if (!a || a->count >= QS_MAX_STREAMS)
        return 0;
    if (a->find(id))
        return 0;
    /* 对端发起的流要占它的 max_streams 名额 */
    from_peer = qs_stream_from_server(id) != a->server;
    idx = (int)qs_stream_index(id);
    if (from_peer) {
        if (qs_stream_uni(id)) {
            if ((u64)a->opened_uni >= a->max_streams_uni)
                return 0;
            if (idx + 1 > a->opened_uni)
                a->opened_uni = idx + 1;
        } else {
            if ((u64)a->opened_bidi >= a->max_streams_bidi)
                return 0;
            if (idx + 1 > a->opened_bidi)
                a->opened_bidi = idx + 1;
        }
    }
    a->s[a->count].init(id, a->server, recv_max, send_max);
    a->count++;
    return &a->s[a->count - 1];
}

/* 本端开一条新流：取同方向上下一个没被占用的编号。 */
QStream *open(QStreams *a, int uni)
{
    u64 idx = 0;

    if (!a)
        return 0;
    for (;;) {
        u64 id = qs_stream_id(a->server, uni, idx);

        if (!a->find(id))
            return a->create(id, a->recv_max_data, a->max_data);
        idx++;
    }
}

/* 设本端的连接级发送额度（收到 MAX_DATA 时用）。 */
int set_max_data(QStreams *a, u64 v)
{
    if (!a)
        return -1;
    if (v > a->max_data)
        a->max_data = v;
    return 0;
}

/* 连接级收额度：本端愿意再收多少字节。 */
int set_recv_max_data(QStreams *a, u64 v)
{
    if (!a)
        return -1;
    if (v > a->recv_max_data)
        a->recv_max_data = v;
    return 0;
}

/* 允许对端开多少条流。 */
int set_max_streams(QStreams *a, int uni, u64 n)
{
    if (!a)
        return -1;
    if (uni) {
        if (n > a->max_streams_uni)
            a->max_streams_uni = n;
    } else if (n > a->max_streams_bidi) {
        a->max_streams_bidi = n;
    }
    return 0;
}

/* 连接级还能发多少字节。 */
u64 send_room(QStreams *a)
{
    if (!a)
        return 0;
    return a->max_data > a->sent_data ? a->max_data - a->sent_data : 0;
}

/* 从流里取数据、并且同时扣连接级额度。额度不够就少取一点。 */
int take_data(QStreams *a, QStream *s, void *out, int cap)
{
    u64 room = 0;
    int n = 0;

    if (!a || !s || !out || cap <= 0)
        return -1;
    room = send_room(a);
    if (room < (u64)cap)
        cap = (int)room;
    if (cap <= 0)
        return 0;
    n = s->take(out, cap);
    if (n > 0)
        a->sent_data += (u64)n;
    return n;
}

/* 收一段流数据：连接级额度 + 流级额度都要够，然后转给流。 */
int on_data(QStreams *a, u64 id, u64 off, const void *data, int n, int fin)
{
    QStream *s = 0;
    int rc = 0;

    if (!a || n < 0 || (n > 0 && !data))
        return -INVAL;
    if (a->recv_data + (u64)n > a->recv_max_data)
        return -BLOCKED;
    s = a->find(id);
    if (!s)
        s = a->create(id, a->recv_max_data, a->max_data);
    if (!s)
        return -RANGE;           /* 超出 max_streams 或者表满 */
    rc = s->put(off, data, n, fin);
    if (rc != 0)
        return rc;
    a->recv_data += (u64)n;
    return 0;
}

/* 把已读走的字节还成新的额度（应用读完之后调用）。 */
int credit(QStreams *a, QStream *s, u64 n)
{
    if (!a || !s)
        return -1;
    s->set_recv_max(s->read_off + s->recv_max - s->recv_off);
    a->set_recv_max_data(a->recv_data + a->recv_max_data - a->recv_data);
    if (n > 0 && s->recv_max < s->read_off + n)
        s->set_recv_max(s->read_off + n);
    if (n > 0 && a->recv_max_data < a->recv_data + n)
        a->set_recv_max_data(a->recv_data + n);
    return 0;
}

/* ---- 自测 ---- */

test "QUIC 流：编号（RFC 9000 §2.1）" {
    if (qs_stream_id(0, 0, 0) != 0 || qs_stream_id(0, 0, 1) != 4)
        return err(1, "客户端双向流应是 0、4、8");
    if (qs_stream_id(1, 0, 0) != 1 || qs_stream_id(1, 0, 2) != 9)
        return err(2, "服务器双向流应是 1、5、9");
    if (qs_stream_id(0, 1, 0) != 2 || qs_stream_id(1, 1, 0) != 3)
        return err(3, "单向流应是 2/3 起");
    if (!qs_stream_uni(2) || qs_stream_uni(0) || qs_stream_uni(1)
        || !qs_stream_uni(3))
        return err(4, "方向位应只由 bit 1 决定");
    if (!qs_stream_from_server(1) || qs_stream_from_server(2)
        || !qs_stream_from_server(3))
        return err(5, "发起方位应只由 bit 0 决定");
    if (qs_stream_index(11) != 2 || qs_stream_index(3) != 0)
        return err(6, "序号应是 id >> 2");
    {
        QStream a = { 0 };
        QStream b = { 0 };
        QStream c = { 0 };

        a.init(qs_stream_id(0, 0, 0), 0, 0, 0);   /* 客户端本地双向 */
        if (!a.can_read() || !a.can_write())
            return err(7, "双向流两个方向都该能用");
        b.init(qs_stream_id(0, 1, 0), 1, 0, 0);   /* 客户端发起的单向 */
        if (b.can_write() || !b.can_read())
            return err(8, "本端是服务器时只能读客户端的单向流");
        c.init(qs_stream_id(1, 1, 0), 1, 0, 0);   /* 服务器发起的单向 */
        if (!c.can_write() || c.can_read())
            return err(9, "服务器只能写自己发起的单向流");
    }
}

test "QUIC 流：接收（乱序、重叠、final_size）" {
    QStream s = { 0 };
    u8 out[32] = { 0 };
    int n = 0;

    s.init(0, 0, 64, 0);
    /* 乱序：先来第二段，再来第一段 */
    if (s.put(5, "world", 5, 0) != 0)
        return err(1, "乱序段应能收下");
    if (s.put(0, "hello", 5, 0) != 0)
        return err(2, "补上前面那段");
    if (s.pending_read() != 10 || s.recv_off_of() != 10)
        return err(3, "两段到齐后应有 10 字节可读");
    n = s.read(out, 10);
    if (n != 10 || memcmp(out, "helloworld", 10) != 0)
        return err(4, "读出来的应是 helloworld");
    /* 重叠重发：同样的数据再收一次不该出错，也不该重复计数 */
    if (s.put(3, "lo", 2, 0) != 0)
        return err(5, "重叠重发应被幂等吸收");
    if (s.pending_read() != 0 || s.recv_off_of() != 10)
        return err(6, "重叠不该让可读字节变多");
    /* 流级收额度：64 字节以外要报 BLOCKED */
    if (s.put(10, "x", 60, 0) != -BLOCKED)
        return err(7, "越过流级额度应报 BLOCKED");
    /* final_size 与 FIN */
    if (s.put(10, "!", 1, 1) != 0)
        return err(8, "带 FIN 的最后一段应能收");
    if (!s.has_final || s.final_size_of() != 11)
        return err(9, "final_size 应是 11");
    if (s.put(11, "more", 4, 0) != -PROTOCOL)
        return err(10, "越过 final_size 的数据应报 PROTOCOL");
    if (s.put(11, "z", 1, 1) != -PROTOCOL)
        return err(11, "重复的 FIN 位置不一致应报 PROTOCOL");
    n = s.read(out, 32);
    if (n != 1 || out[0] != '!' || !s.fin_read_of())
        return err(12, "读到最后一块应置 fin_read");
    /* STOP_SENDING 之后不再收 */
    s.stop(0x1234);
    if (s.put(11, "q", 1, 0) != -PROTOCOL || s.stop_err_of() != 0x1234)
        return err(13, "停止之后收到的数据应被拒");
    /* 偏移回绕 */
    if (s.put(0xffffffffffffffffULL, "a", 2, 0) != -RANGE)
        return err(14, "偏移回绕应报 RANGE");
}

test "QUIC 流：发送、缓冲区滑动与流控" {
    QStreams all = { 0 };
    QStream *s = 0;
    QStream *u = 0;
    u8 out[128] = { 0 };
    int n = 0;
    int i = 0;

    all.init(0);                /* 客户端 */
    all.set_max_data(40);
    all.set_recv_max_data(100);
    all.set_max_streams(0, 2);
    all.set_max_streams(1, 2);

    s = all.open(0);
    if (!s || s->id_of() != 0)
        return err(1, "第一条本地双向流应是 0");
    u = all.open(1);
    if (!u || u->id_of() != 2)
        return err(2, "第一条本地单向流应是 2");
    if (!u->is_uni() || s->is_uni())
        return err(3, "单向流的标志不对");
    if (all.count_of() != 2)
        return err(4, "流表里应有两条流");

    /* 流级额度是 open 时从连接级额度复制来的（40） */
    if (s->send_max_of() != 40)
        return err(5, "send_max 初值应是连接级额度");
    n = s->write("0123456789", 10);
    if (n != 10 || s->pending_write() != 10)
        return err(6, "写入 10 字节");
    /* write 之后排队超出 40 的部分要被截掉 */
    n = s->write("abcdefghijklmnopqrstuvwxyz0123456789", 36);
    if (n != 30 || s->pending_write() != 40)
        return err(7, "流级额度只允许排到 40 字节");
    /* 取数据：一次取 16 字节，连取三次到 40 */
    n = all.take_data(s, out, 16);
    if (n != 16 || out[0] != '0' || out[15] != 'f')
        return err(8, "前 16 字节应是 0123456789abcdef");
    if (all.send_room() != 40 - 16)
        return err(9, "连接级额度应扣掉 16");
    n = all.take_data(s, out, 100);
    if (n != 24 || s->pending_write() != 0)
        return err(10, "剩下的 24 字节一次取完");
    if (all.send_room() != 0)
        return err(11, "连接级额度应用光");
    if (all.take_data(s, out, 16) != 0)
        return err(12, "没有额度时不该再取出数据");
    /* 放额度之后继续 */
    all.set_max_data(100);
    s->set_send_max(100);
    n = s->write("xyz", 3);
    if (n != 3 || all.take_data(s, out, 3) != 3 || out[2] != 'z')
        return err(13, "放额度之后应能继续发");
    /* FIN 在数据发完之后才置位 */
    s->write("ab", 2);
    s->mark_fin();
    if (s->fin_sent_of() || !s->fin_pending_of())
        return err(14, "还有排队数据时 FIN 不该算发出");
    if (all.take_data(s, out, 16) != 2 || !s->fin_sent_of())
        return err(15, "数据发完之后 FIN 应置位");

    /* 缓冲滑动：写满、读走一部分、再收新数据 */
    {
        QStream t = { 0 };
        u8 big[QS_BUF] = { 0 };
        u8 chunk[512] = { 0 };
        u64 off = 0;

        memset(big, 'k', sizeof big);
        t.init(4, 0, 8192, 0);
        if (t.put(0, big, QS_BUF, 0) != 0)
            return err(16, "第一块应能装满缓冲区");
        if (t.read(chunk, 256) != 256)
            return err(17, "先读走 256 字节");
        /* 只读了 256，却想再收 300：腾不出地方，报 FULL */
        if (t.put(QS_BUF, chunk, 300, 0) != -FULL)
            return err(18, "应用没读干净时新数据应报 FULL");
        /* 读掉剩下的，读满 4096 之后就能继续收 */
        while (t.pending_read() > 0)
            t.read(chunk, 512);
        off = t.read_off_of();
        if (t.put(QS_BUF, chunk, 300, 0) != 0)
            return err(20, "读干净之后应能继续收");
        if (t.recv_off_of() != QS_BUF + 300 || off != QS_BUF)
            return err(21, "滑动之后的偏移不对");
    }

    /* 连接级收额度 */
    {
        QStreams b = { 0 };
        int rc = 0;

        b.init(1);
        b.set_recv_max_data(10);
        b.set_max_streams(0, 1);
        rc = b.on_data(0, 0, "0123456789", 10, 0);   /* 客户端发起的双向流 0 */
        if (rc != 0)
            return err(22, "客户端发来的 10 字节应能收");
        if (b.recv_data_of() != 10)
            return err(23, "连接级收计数应是 10");
        rc = b.on_data(0, 10, "a", 1, 0);
        if (rc != -BLOCKED)
            return err(24, "越过连接级额度应报 BLOCKED");
        /* 名额只有 1 条双向流（已被流 1 占走）：新流应被拒 */
        b.set_recv_max_data(64);
        rc = b.on_data(4, 0, "hi", 2, 0);
        if (rc != -RANGE || b.find(4))
            return err(25, "超出 max_streams 的新流应被拒");
        /* 放名额之后，没见过的流按需创建 */
        b.set_max_streams(0, 2);
        rc = b.on_data(4, 0, "hi", 2, 0);
        if (rc != 0 || !b.find(4))
            return err(26, "没见过的流应被建出来");
        if (b.find(8) != 0)
            return err(27, "不该凭空冒出流");
    }
}
