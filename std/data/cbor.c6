/* std/data/cbor：CBOR 编解码（RFC 8949，零分配，调用方给缓冲）。
 *
 *     import std.data.cbor;
 *
 *     char buf[256] = { 0 };
 *     CborWriter w = cbor_writer(buf, (int)sizeof buf);
 *     w.write_map(1);
 *     w.write_text(SS("a"));
 *     w.write_uint(1);
 *     // buf = a1 61 61 01
 *
 *     CborReader r = cbor_reader(buf, w.len());
 *     CborTag t = { 0 };
 *     while (r.next(&t) == 1) {
 *         if (t.type == CB_TEXT) ... t.s ...
 *         if (t.type == CB_ARRAY) ... t.count ...
 *     }
 *
 * CBOR 的头是「主类型 3 位 + 附加信息 5 位」：附加信息 <24 直接是值，24/25/26/27
 * 表示后面跟 1/2/4/8 字节大端值。主类型 0/1 是无符号/负数，2/3 是字节串/文本
 * 串，4/5 是数组/映射，6 是标签，7 是简单值/浮点。
 *
 * 约定：
 *
 * - 写：`write_uint`/`write_int`（负数走主类型 1）、`write_bytes`/`write_text`、
 *   `write_array`/`write_map`、`write_bool`/`write_null`、`write_f64`（固定
 *   `fb` 双精度）；缓冲满了置 `ok = 0`；
 * - 读：`next` 1 取到 / 0 结束 / -1 格式错；**不支持**不定长（附加信息 31）、
 *   标签（主类型 6）、简单值 0xf7/0xf8、以及需要 `break` 的流式容器——遇到
 *   这些一律 -1（这一层只做确定性长度的子集，够覆盖 COSE/JWT 之外的大多数
 *   配置与遥测格式）；
 * - 浮点：`f9` 半精度、`fa` 单精度、`fb` 双精度都转成 f64（Inf/NaN 当 0）；
 * - 文本串按字节给出，**不校验 UTF-8**；长度上限按规范（≤2^32-1）检查。
 */
#include <string.h>

module std.data.cbor;
import std.core.types;
import std.text.str;

enum CborType {
    CB_NULL = 0,
    CB_BOOL = 1,
    CB_UINT = 2,
    CB_INT = 3,
    CB_F64 = 4,
    CB_BYTES = 5,
    CB_TEXT = 6,
    CB_ARRAY = 7,
    CB_MAP = 8,
};

struct CborWriter {
    u8 *buf;
    int cap;
    int used;
    int bad;
};

struct CborTag {
    int type;
    int flag;       /* BOOL */
    u64 u;
    i64 i;
    f64 f;
    Str s;          /* BYTES/TEXT 的视图 */
    int count;      /* ARRAY/MAP */
};

struct CborReader {
    const u8 *p;
    int len;
    int pos;
    int bad;
};

CborWriter cbor_writer(void *buf, int cap)
{
    CborWriter w = { (u8 *)buf, cap, 0, 0 };

    if (!buf || cap <= 0)
        w.bad = 1;
    return w;
}

int ok(CborWriter *self) { return self && !self->bad; }

int len(CborWriter *self) { return self ? self->used : 0; }

static void cw_byte(CborWriter *w, int b)
{
    if (w->bad)
        return;
    if (w->used + 1 > w->cap) {
        w->bad = 1;
        return;
    }
    w->buf[w->used++] = (u8)b;
}

static void cw_bytes(CborWriter *w, const void *p, int n)
{
    if (w->bad || n < 0)
        return;
    if (w->used + n > w->cap) {
        w->bad = 1;
        return;
    }
    if (n > 0)
        memcpy(w->buf + w->used, p, (size_t)n);
    w->used += n;
}

static void cw_be(CborWriter *w, u64 v, int nbytes)
{
    int i = 0;

    for (i = nbytes - 1; i >= 0; i--)
        cw_byte(w, (int)((v >> (i * 8)) & 0xff));
}

/* 主类型 + 附加信息（RFC 8949 §3） */
static void cw_head(CborWriter *w, int major, u64 v)
{
    if (w->bad)
        return;
    if (v < 24ull) {
        cw_byte(w, (major << 5) | (int)v);
    } else if (v <= 0xffull) {
        cw_byte(w, (major << 5) | 24);
        cw_byte(w, (int)v);
    } else if (v <= 0xffffull) {
        cw_byte(w, (major << 5) | 25);
        cw_be(w, v, 2);
    } else if (v <= 0xffffffffull) {
        cw_byte(w, (major << 5) | 26);
        cw_be(w, v, 4);
    } else {
        cw_byte(w, (major << 5) | 27);
        cw_be(w, v, 8);
    }
}

void write_uint(CborWriter *self, u64 v) { cw_head(self, 0, v); }

void write_int(CborWriter *self, i64 v)
{
    if (!self || self->bad)
        return;
    if (v >= 0)
        cw_head(self, 0, (u64)v);
    else
        cw_head(self, 1, (u64)(-(v + 1)));
}

void write_bytes(CborWriter *self, const void *p, int n)
{
    if (!self || self->bad || n < 0 || (n > 0 && !p)) {
        if (self)
            self->bad = 1;
        return;
    }
    cw_head(self, 2, (u64)n);
    cw_bytes(self, p, n);
}

void write_text(CborWriter *self, Str s)
{
    if (!self || self->bad || s.s.len < 0 || (s.s.len > 0 && !s.s.data)) {
        if (self)
            self->bad = 1;
        return;
    }
    cw_head(self, 3, (u64)s.s.len);
    cw_bytes(self, s.s.data, s.s.len);
}

void write_array(CborWriter *self, int n)
{
    if (!self || self->bad || n < 0) {
        if (self)
            self->bad = 1;
        return;
    }
    cw_head(self, 4, (u64)n);
}

void write_map(CborWriter *self, int n)
{
    if (!self || self->bad || n < 0) {
        if (self)
            self->bad = 1;
        return;
    }
    cw_head(self, 5, (u64)n);
}

void write_null(CborWriter *self) { cw_byte(self, 0xf6); }

void write_bool(CborWriter *self, int v) { cw_byte(self, v ? 0xf5 : 0xf4); }

void write_f64(CborWriter *self, f64 v)
{
    u64 bits = 0;

    if (!self || self->bad)
        return;
    memcpy(&bits, &v, sizeof bits);
    cw_byte(self, 0xfb);
    cw_be(self, bits, 8);
}

CborReader cbor_reader(const void *p, int n)
{
    CborReader r = { (const u8 *)p, n, 0, 0 };

    if (!p || n < 0)
        r.bad = 1;
    return r;
}

int error_at(CborReader *self) { return self ? self->pos : -1; }

static int cr_byte(CborReader *r)
{
    if (r->pos >= r->len) {
        r->bad = 1;
        return -1;
    }
    return (int)r->p[r->pos++];
}

/* 读附加信息对应的值；返回 0 成功、-1 失败/不定长 */
static int cr_value(CborReader *r, int ai, u64 *out)
{
    u64 v = 0;
    int n = 0, i = 0;

    if (ai < 24) {
        *out = (u64)ai;
        return 0;
    }
    if (ai == 24)
        n = 1;
    else if (ai == 25)
        n = 2;
    else if (ai == 26)
        n = 4;
    else if (ai == 27)
        n = 8;
    else {
        r->bad = 1;
        return -1;              /* 28..30 保留，31 不定长 */
    }
    for (i = 0; i < n; i++) {
        int b = cr_byte(r);

        if (b < 0)
            return -1;
        v = (v << 8) | (u64)b;
    }
    *out = v;
    return 0;
}

static f64 cr_half(u16 b)
{
    int sign = (int)(b >> 15) & 1;
    int exp = (int)((b >> 10) & 0x1f);
    int frac = (int)(b & 0x3ff);
    f64 v = 0.0;

    if (exp == 0x1f)
        return 0.0;             /* Inf/NaN 不支持 */
    if (exp == 0) {
        v = (f64)frac / 1024.0;
        v = v / 16384.0;        /* 2^-14 */
    } else {
        v = 1.0 + (f64)frac / 1024.0;
        while (exp > 15) {
            v = v * 2.0;
            exp--;
        }
        while (exp < 15) {
            v = v / 2.0;
            exp++;
        }
    }
    return sign ? -v : v;
}

static f64 cr_float32(u32 b)
{
    int sign = (int)(b >> 31) & 1;
    int exp = (int)((b >> 23) & 0xff);
    u32 frac = b & 0x7fffffu;
    f64 v = 0.0;

    if (exp == 0xff)
        return 0.0;
    if (exp == 0) {
        int k = 0;

        v = (f64)frac / 8388608.0;
        for (k = 0; k < 126; k++)
            v = v / 2.0;
    } else {
        v = 1.0 + (f64)frac / 8388608.0;
        while (exp > 127) {
            v = v * 2.0;
            exp--;
        }
        while (exp < 127) {
            v = v / 2.0;
            exp++;
        }
    }
    return sign ? -v : v;
}

/* 1 取到 / 0 结束 / -1 错 */
int next(CborReader *self, CborTag *out)
{
    int ib = 0, major = 0, ai = 0;
    u64 v = 0;

    if (!self || self->bad || !out)
        return -1;
    if (self->pos >= self->len)
        return 0;
    ib = cr_byte(self);
    if (ib < 0)
        return -1;
    memset(out, 0, sizeof *out);
    major = (ib >> 5) & 7;
    ai = ib & 0x1f;
    if (major == 7) {
        if (ai == 20) {
            out->type = CB_BOOL;
            out->flag = 0;
            return 1;
        }
        if (ai == 21) {
            out->type = CB_BOOL;
            out->flag = 1;
            return 1;
        }
        if (ai == 22) {
            out->type = CB_NULL;
            return 1;
        }
        if (ai == 25) {
            u64 bits = 0;

            if (cr_value(self, ai, &bits) != 0)
                return -1;
            out->type = CB_F64;
            out->f = cr_half((u16)bits);
            return 1;
        }
        if (ai == 26) {
            u64 bits = 0;

            if (cr_value(self, ai, &bits) != 0)
                return -1;
            out->type = CB_F64;
            out->f = cr_float32((u32)bits);
            return 1;
        }
        if (ai == 27) {
            u64 bits = 0;
            f64 f = 0;

            if (cr_value(self, ai, &bits) != 0)
                return -1;
            memcpy(&f, &bits, sizeof f);
            out->type = CB_F64;
            out->f = f;
            return 1;
        }
        self->bad = 1;
        return -1;              /* 简单值/不定长 break 不支持 */
    }
    if (major == 6) {
        self->bad = 1;
        return -1;              /* 标签不支持 */
    }
    if (cr_value(self, ai, &v) != 0)
        return -1;
    if (major == 0) {
        out->type = CB_UINT;
        out->u = v;
        return 1;
    }
    if (major == 1) {
        out->type = CB_INT;
        out->i = -1 - (i64)v;
        return 1;
    }
    if (major == 2 || major == 3) {
        if (v > (u64)(self->len - self->pos)) {
            self->bad = 1;
            return -1;
        }
        out->type = (major == 2) ? CB_BYTES : CB_TEXT;
        out->s = (Str){ (char[:]){ (char *)self->p + self->pos, (int)v } };
        self->pos += (int)v;
        return 1;
    }
    if (major == 4 || major == 5) {
        if (v > 0x7fffffffull) {
            self->bad = 1;
            return -1;
        }
        out->type = (major == 4) ? CB_ARRAY : CB_MAP;
        out->count = (int)v;
        return 1;
    }
    self->bad = 1;
    return -1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })
#define SS(lit) ((Str){ S(lit) })

static int unhex(const char *s, u8 *dst, int cap)
{
    int n = 0, i = 0;

    while (s[0] && s[1] && n < cap) {
        int hi = -1, lo = -1;

        for (i = 0; i < 16; i++) {
            if ("0123456789abcdef"[i] == s[0])
                hi = i;
            if ("0123456789abcdef"[i] == s[1])
                lo = i;
        }
        if (hi < 0 || lo < 0)
            return -1;
        dst[n++] = (u8)(hi * 16 + lo);
        s += 2;
    }
    return n;
}

static int enc_is(CborWriter *w, void *buf, char *hex)
{
    u8 want[64] = { 0 };
    int n = unhex(hex, want, (int)sizeof want);

    if (!w->ok() || w->len() != n)
        return 0;
    return memcmp(buf, want, (size_t)n) == 0;
}

test "规范编码：整数、负数、字符串、容器" {
    char buf[64] = { 0 };
    CborWriter w = cbor_writer(buf, (int)sizeof buf);
    struct {
        u64 v;
        char *hex;
    } u[7] = {
        { 0ull, (char *)"00" },
        { 23ull, (char *)"17" },
        { 24ull, (char *)"1818" },
        { 1000ull, (char *)"1903e8" },
        { 1000000ull, (char *)"1a000f4240" },
        { 1000000000000ull, (char *)"1b000000e8d4a51000" },
        { 18446744073709551615ull, (char *)"1bffffffffffffffff" },
    };
    int i = 0;

    for (i = 0; i < 7; i++) {
        w = cbor_writer(buf, (int)sizeof buf);
        w.write_uint(u[i].v);
        if (!enc_is(&w, buf, u[i].hex))
            return err(1, "无符号整数的编码不对");
    }
    /* 负数：-1 -> 20，-1000 -> 3903e7 */
    w = cbor_writer(buf, (int)sizeof buf);
    w.write_int(-1);
    if (!enc_is(&w, buf, (char *)"20"))
        return err(2, "-1 的编码不对");
    w = cbor_writer(buf, (int)sizeof buf);
    w.write_int(-1000);
    if (!enc_is(&w, buf, (char *)"3903e7"))
        return err(3, "-1000 的编码不对");
    /* 文本 / 字节串 */
    w = cbor_writer(buf, (int)sizeof buf);
    w.write_text(SS("hello"));
    if (!enc_is(&w, buf, (char *)"6568656c6c6f"))
        return err(4, "文本串编码不对");
    w = cbor_writer(buf, (int)sizeof buf);
    w.write_bytes("\x01\x02\x03", 3);
    if (!enc_is(&w, buf, (char *)"43010203"))
        return err(5, "字节串编码不对");
    /* 数组 / 映射 / bool / null / f64 */
    w = cbor_writer(buf, (int)sizeof buf);
    w.write_array(3);
    w.write_uint(1);
    w.write_uint(2);
    w.write_uint(3);
    if (!enc_is(&w, buf, (char *)"83010203"))
        return err(6, "数组编码不对");
    w = cbor_writer(buf, (int)sizeof buf);
    w.write_map(1);
    w.write_text(SS("a"));
    w.write_uint(1);
    if (!enc_is(&w, buf, (char *)"a1616101"))
        return err(7, "映射编码不对");
    w = cbor_writer(buf, (int)sizeof buf);
    w.write_bool(1);
    w.write_bool(0);
    w.write_null();
    if (!enc_is(&w, buf, (char *)"f5f4f6"))
        return err(8, "bool/null 编码不对");
    w = cbor_writer(buf, (int)sizeof buf);
    w.write_f64(1.5);
    if (!enc_is(&w, buf, (char *)"fb3ff8000000000000"))
        return err(9, "f64 编码不对");
    /* 大数组头 */
    w = cbor_writer(buf, (int)sizeof buf);
    w.write_array(24);
    if (!enc_is(&w, buf, (char *)"9818"))
        return err(10, "24 个元素的数组头不对");
    /* 缓冲不够 */
    {
        char small[2] = { 0 };
        CborWriter sw = cbor_writer(small, (int)sizeof small);

        sw.write_text(SS("hello"));
        if (sw.ok())
            return err(11, "缓冲不够应该置 ok=0");
    }
}

test "解码：标记流、roundtrip 与坏输入" {
    char buf[128] = { 0 };
    CborWriter w = cbor_writer(buf, (int)sizeof buf);
    CborReader r = { 0 };
    CborTag t = { 0 };
    u8 enc[64] = { 0 };
    int n = 0;

    w.write_map(2);
    w.write_text(SS("name"));
    w.write_text(SS("demo"));
    w.write_text(SS("count"));
    w.write_int(-7);
    if (!w.ok())
        return err(12, "编码失败");
    r = cbor_reader(buf, w.len());
    if (r.next(&t) != 1 || t.type != CB_MAP || t.count != 2)
        return err(13, "map 标记不对");
    if (r.next(&t) != 1 || t.type != CB_TEXT || t.s.s.len != 4)
        return err(14, "键不对");
    if (r.next(&t) != 1 || t.type != CB_TEXT || memcmp(t.s.s.data, "demo", 4) != 0)
        return err(15, "值不对");
    if (r.next(&t) != 1 || t.type != CB_TEXT || t.s.s.len != 5)
        return err(16, "第二个键不对");
    if (r.next(&t) != 1 || t.type != CB_INT || t.i != -7)
        return err(17, "负数解码不对");
    if (r.next(&t) != 0)
        return err(18, "读完应该返回 0");
    /* uint64 上限、bool/null、半精度 1.5 = f93e00、单精度 1.5 = fa3fc00000 */
    n = unhex("1bffffffffffffffff", enc, (int)sizeof enc);
    r = cbor_reader(enc, n);
    if (r.next(&t) != 1 || t.type != CB_UINT
        || t.u != 18446744073709551615ull)
        return err(19, "uint64 上限解码不对");
    n = unhex("f5f4f6", enc, (int)sizeof enc);
    r = cbor_reader(enc, n);
    if (r.next(&t) != 1 || t.type != CB_BOOL || t.flag != 1)
        return err(20, "true 解码不对");
    if (r.next(&t) != 1 || t.type != CB_BOOL || t.flag != 0)
        return err(21, "false 解码不对");
    if (r.next(&t) != 1 || t.type != CB_NULL)
        return err(22, "null 解码不对");
    n = unhex("f93e00", enc, (int)sizeof enc);
    r = cbor_reader(enc, n);
    if (r.next(&t) != 1 || t.type != CB_F64 || t.f != 1.5)
        return err(23, "半精度解码不对");
    n = unhex("fa3fc00000", enc, (int)sizeof enc);
    r = cbor_reader(enc, n);
    if (r.next(&t) != 1 || t.type != CB_F64 || t.f != 1.5)
        return err(24, "单精度解码不对");
    /* 字节串视图 */
    n = unhex("43010203", enc, (int)sizeof enc);
    r = cbor_reader(enc, n);
    if (r.next(&t) != 1 || t.type != CB_BYTES || t.s.s.len != 3
        || (u8)t.s.s.data[2] != 3)
        return err(25, "字节串解码不对");
    /* 坏输入：截断、不定长、标签、保留附加信息 */
    {
        struct {
            char *hex;
            int len;
        } bad[5] = {
            { (char *)"6568656c6c", 5 },   /* 文本声明 5 只剩 4 */
            { (char *)"7f", 1 },           /* 不定长文本 */
            { (char *)"9f", 1 },           /* 不定长数组 */
            { (char *)"c0", 1 },           /* 标签 0 */
            { (char *)"fc", 1 },           /* 简单值 28 保留 */
        };
        int i = 0;

        for (i = 0; i < 5; i++) {
            n = unhex(bad[i].hex, enc, (int)sizeof enc);
            r = cbor_reader(enc, n);
            if (r.next(&t) != -1)
                return err(26, "坏输入应该返回 -1");
        }
    }
    /* 空输入 */
    {
        CborReader empty = cbor_reader("", 0);

        if (empty.bad || empty.next(&t) != 0)
            return err(27, "空输入应该返回 0");
    }
    {
        CborReader bad = cbor_reader(0, 1);

        if (!bad.bad)
            return err(28, "空指针应该是坏 reader");
    }
    (void)n;
}
