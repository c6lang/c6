/* std/text/fuzzy：模糊匹配用的三个距离/打分原语（零分配、按码点）。
 *
 *     import std.text.fuzzy;
 *
 *     lev_distance(S("kitten"), S("sitting"));       // 3
 *     lev_ratio(S("kitten"), S("sitting"));          // 571（千分比）
 *     damerau_distance(S("ab"), S("ba"));            // 1（相邻换位算一次）
 *     subsequence_match(S("fzf"), S("fuzzy finder"));// 1（子序列）
 *     subsequence_score(S("fzf"), S("fuzzy finder"));// 分数，连着的更高
 *     fuzzy_best(S("recieve"), cands, n, 2);         // 「did you mean」的下标
 *
 * 三件事各管一段：
 *
 * - **编辑距离**（Levenshtein）：插入/删除/替换各算 1；`damerau_distance`
 *   把相邻两字符换位也算 1（OSA 变体，不做完整的 Damerau）。
 * - **相似度** `lev_ratio`：`(maxlen - dist) * 1000 / maxlen`，0..1000 的千分比，
 *   两个空串给 1000。拿它排序「像不像」比拿距离直观。
 * - **子序列匹配**：needle 的字符按顺序出现在 hay 里就算匹配（fzf/补全的
 *   基本判据），`subsequence_score` 再给「连续命中、词首命中」加分、跳过字符
 *   扣分；分数只保证同一套打分下可比，不是标定过的值。
 *
 * 约定：
 *
 * - 全部**按码点**算，不是按字节：`lev_distance(S("中文"), S("中问"))` 是 1，
 *   不是 3。坏 UTF-8 字节按一个独立「字符」处理。
 * - ASCII 大小写不敏感只用在**子序列匹配/打分**上；编辑距离是大小写敏感的
 *   （要忽略就自己先规整）。
 * - 短串长度上限 `FUZZY_MAX`（256 码点）：超了返回 -1，不做近似。栈上大约
 *   5KB（两张码点表 + 两三行 DP），别在深递归里循环调。
 * - 时间 O(n*m)（`lev_ratio` 会调一次距离），`FUZZY_MAX` 以内最多 6.5 万次
 *   单元更新，够快；要扫几千个候选就先用 `subsequence_match` 粗筛。
 */
module std.text.fuzzy;
import std.core.types;
import std.text.utf8;

/* 短串的码点上限：超过就返回 -1（栈上的表按它定长） */
enum FuzzyLimit {
    FUZZY_MAX = 256,
};

/* ---- 解码与裁剪 ---- */

/* 把 s 解成码点写进 out；返回个数，超过 cap 给 -1。坏字节 = 一个码点。 */
static int f_decode(char[:] s, u32 *out, int cap)
{
    int i = 0, n = 0, k = 0;
    u32 cp = 0;

    while (i < s.len) {
        if (n >= cap)
            return -1;
        k = utf8_decode(s, i, &cp);
        if (k <= 0) {
            cp = (u8)s.data[i];
            k = 1;
        }
        out[n++] = cp;
        i += k;
    }
    return n;
}

static int f_prefix(u32 *a, int na, u32 *b, int nb)
{
    int n = 0;

    while (n < na && n < nb && a[n] == b[n])
        n++;
    return n;
}

static int f_suffix(u32 *a, int na, u32 *b, int nb, int pre)
{
    int n = 0;

    while (n < na - pre && n < nb - pre && a[na - 1 - n] == b[nb - 1 - n])
        n++;
    return n;
}

/* ---- 编辑距离 ---- */

/* 两行 DP 的 Levenshtein（对 a[0..na) 和 b[0..nb)） */
static int f_lev_core(u32 *a, int na, u32 *b, int nb, int *r1, int *r2)
{
    int i = 0, j = 0, cost = 0, v = 0;
    int *prev = r1, *cur = r2, *t = 0;

    for (j = 0; j <= nb; j++)
        prev[j] = j;
    for (i = 1; i <= na; i++) {
        cur[0] = i;
        for (j = 1; j <= nb; j++) {
            cost = (a[i - 1] == b[j - 1]) ? 0 : 1;
            v = prev[j - 1] + cost;
            if (prev[j] + 1 < v)
                v = prev[j] + 1;
            if (cur[j - 1] + 1 < v)
                v = cur[j - 1] + 1;
            cur[j] = v;
        }
        t = prev;
        prev = cur;
        cur = t;
    }
    return prev[nb];
}

/* 三行 DP 的 OSA（相邻换位算一次） */
static int f_osa_core(u32 *a, int na, u32 *b, int nb, int *r1, int *r2, int *r3)
{
    int i = 0, j = 0, cost = 0, v = 0;
    int *p2 = r3, *p1 = r1, *cur = r2, *t = 0;

    for (j = 0; j <= nb; j++)
        p1[j] = j;
    for (j = 0; j <= nb; j++)
        p2[j] = j;
    for (i = 1; i <= na; i++) {
        cur[0] = i;
        for (j = 1; j <= nb; j++) {
            cost = (a[i - 1] == b[j - 1]) ? 0 : 1;
            v = p1[j - 1] + cost;
            if (p1[j] + 1 < v)
                v = p1[j] + 1;
            if (cur[j - 1] + 1 < v)
                v = cur[j - 1] + 1;
            if (i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1]
                && p2[j - 2] + 1 < v)
                v = p2[j - 2] + 1;
            cur[j] = v;
        }
        t = p2;
        p2 = p1;
        p1 = cur;
        cur = t;
    }
    return p1[nb];
}

/* 内部：把两串解成码点、剥公共前后缀、跑核心；返回距离，超限给 -1 */
static int f_distance(char[:] a, char[:] b, int osa)
{
    u32 ca[FUZZY_MAX] = { 0 };
    u32 cb[FUZZY_MAX] = { 0 };
    int row1[FUZZY_MAX + 1] = { 0 };
    int row2[FUZZY_MAX + 1] = { 0 };
    int row3[FUZZY_MAX + 1] = { 0 };
    int na = 0, nb = 0, pre = 0, suf = 0, d = 0;

    na = f_decode(a, ca, FUZZY_MAX);
    nb = f_decode(b, cb, FUZZY_MAX);
    if (na < 0 || nb < 0)
        return -1;
    pre = f_prefix(ca, na, cb, nb);
    suf = f_suffix(ca, na, cb, nb, pre);
    if (osa)
        d = f_osa_core(ca + pre, na - pre - suf, cb + pre, nb - pre - suf,
                       row1, row2, row3);
    else
        d = f_lev_core(ca + pre, na - pre - suf, cb + pre, nb - pre - suf,
                       row1, row2);
    return d;
}

/* 完整 Levenshtein 距离（码点）；任一串超过 FUZZY_MAX 给 -1 */
int lev_distance(char[:] a, char[:] b)
{
    return f_distance(a, b, 0);
}

/* 只看「超过阈值没有」：d > maxd 时返回 maxd+1；长度差先挡一道 */
int lev_distance_max(char[:] a, char[:] b, int maxd)
{
    int na = 0, nb = 0, d = 0, diff = 0;

    if (maxd < 0)
        return 0;
    na = utf8_count(a);
    nb = utf8_count(b);
    if (na < 0 || nb < 0)
        return maxd + 1;
    diff = na - nb;
    if (diff < 0)
        diff = -diff;
    if (diff > maxd)
        return maxd + 1;
    d = f_distance(a, b, 0);
    if (d < 0 || d > maxd)
        return maxd + 1;
    return d;
}

/* OSA 距离：相邻两字符换位算一次编辑 */
int damerau_distance(char[:] a, char[:] b)
{
    return f_distance(a, b, 1);
}

/* 相似度千分比：0..1000；超限给 -1 */
int lev_ratio(char[:] a, char[:] b)
{
    int na = 0, nb = 0, max = 0, d = 0;

    na = utf8_count(a);
    nb = utf8_count(b);
    if (na < 0 || nb < 0 || na > FUZZY_MAX || nb > FUZZY_MAX)
        return -1;
    max = na > nb ? na : nb;
    if (max == 0)
        return 1000;
    d = f_distance(a, b, 0);
    if (d < 0)
        return -1;
    if (d >= max)
        return 0;
    return (max - d) * 1000 / max;
}

/* ---- 子序列匹配与打分 ---- */

static int f_fold(int c)
{
    return (c >= 'A' && c <= 'Z') ? c + 32 : c;
}

/* ASCII 词字符（\w 的口径） */
static int f_word(u32 cp)
{
    return (cp >= '0' && cp <= '9') || (cp >= 'A' && cp <= 'Z')
           || (cp >= 'a' && cp <= 'z') || cp == '_';
}

/* 下一个码点：返回消耗的字节数，pos 越界给 0，坏字节给 1 */
static int f_step(char[:] s, int pos, u32 *cp)
{
    int k = 0;

    if (pos < 0 || pos >= s.len)
        return 0;
    k = utf8_decode(s, pos, cp);
    if (k <= 0) {
        *cp = (u8)s.data[pos];
        k = 1;
    }
    return k;
}

/* pos 处的码点是不是「词首」（前面不是词字符、自己是） */
static int f_word_start(char[:] s, int pos)
{
    u32 prev = 0;
    int p = pos - 1, k = 0;

    if (pos <= 0)
        return 1;
    while (p > 0 && ((u8)s.data[p] & 0xc0) == 0x80)
        p--;
    k = f_step(s, p, &prev);
    if (k <= 0)
        return 1;
    if (p < 0 || p >= s.len)
        return 1;
    if (f_word(prev))
        return 0;
    /* 词首判定看当前位置的字符是不是词字符，由调用方保证 */
    return 1;
}

/* needle 的码点按顺序都出现在 hay 里？ASCII 大小写不敏感 */
int subsequence_match(char[:] needle, char[:] hay)
{
    int i = 0, j = 0, kn = 0, kh = 0;
    u32 cn = 0, ch = 0;

    while (i < needle.len && j < hay.len) {
        kn = f_step(needle, i, &cn);
        kh = f_step(hay, j, &ch);
        if (kn <= 0)
            break;
        if (kh <= 0)
            return 0;
        if (f_fold((int)cn) == f_fold((int)ch)) {
            i += kn;
            j += kh;
        } else {
            j += kh;
        }
    }
    return i >= needle.len;
}

/* 子序列打分：不匹配给 -1。
 * 每个命中 +1；紧跟上一次命中 +4；命中词首 +6；跳过 k 个字符扣 min(k,3)。 */
int subsequence_score(char[:] needle, char[:] hay)
{
    int score = 0, i = 0, j = 0, kn = 0, kh = 0, gap = 0;
    u32 cn = 0, ch = 0;

    while (i < needle.len) {
        kn = f_step(needle, i, &cn);
        if (kn <= 0)
            return -1;
        gap = 0;
        for (;;) {
            kh = f_step(hay, j, &ch);
            if (kh <= 0)
                return -1;
            if (f_fold((int)cn) == f_fold((int)ch))
                break;
            j += kh;
            gap++;
        }
        score += 1;
        if (gap == 0 && j > 0)
            score += 4;
        if (f_word(ch) && f_word_start(hay, j))
            score += 6;
        score -= (gap < 3) ? gap : 3;
        j += kh;
        i += kn;
    }
    return score;
}

/* 在候选里挑编辑距离最小、且不超过 maxd 的那个下标；没有给 -1（并列取最先） */
int fuzzy_best(char[:] needle, char[:] *list, int n, int maxd)
{
    int i = 0, best = -1, bestd = 0, d = 0;

    if (!list || n <= 0)
        return -1;
    bestd = maxd + 1;
    for (i = 0; i < n; i++) {
        d = lev_distance_max(needle, list[i], maxd);
        if (d <= maxd && d < bestd) {
            bestd = d;
            best = i;
        }
    }
    return best;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "Levenshtein 的已知向量" {
    if (lev_distance(S("kitten"), S("sitting")) != 3)
        return err(1, "kitten/sitting");
    if (lev_distance(S(""), S("abc")) != 3 || lev_distance(S("abc"), S("")) != 3)
        return err(2, "空串");
    if (lev_distance(S("abc"), S("abc")) != 0)
        return err(3, "相同");
    if (lev_distance(S("ab"), S("ba")) != 2)
        return err(4, "纯换位在 Levenshtein 里是 2");
    if (lev_distance(S("flaw"), S("lawn")) != 2)
        return err(5, "flaw/lawn");
    if (lev_distance(S("abc"), S("acb")) != 2)
        return err(6, "abc/acb");
}

test "OSA：相邻换位算一次" {
    if (damerau_distance(S("ab"), S("ba")) != 1)
        return err(7, "换位");
    if (damerau_distance(S("abc"), S("acb")) != 1)
        return err(8, "abc/acb 换位");
    if (damerau_distance(S("ca"), S("abc")) != 3)
        return err(9, "ca/abc");
    if (damerau_distance(S("kitten"), S("sitting")) != 3)
        return err(10, "OSA 在无换位时和 Levenshtein 一致");
    if (damerau_distance(S("ab"), S("ba")) >= lev_distance(S("ab"), S("ba")))
        return err(11, "OSA 不该比 Levenshtein 大");
}

test "按码点而不是按字节" {
    /* 中文一个字是 3 字节，但距离按码点算 */
    if (lev_distance(S("中文"), S("中问")) != 1)
        return err(12, "中文替换");
    if (lev_distance(S("中文"), S("中文中文")) != 2)
        return err(13, "中文插入");
    if (lev_distance(S("中"), S("文")) != 1)
        return err(14, "单字替换");
    /* 非法 UTF-8 字节各算一个字符 */
    if (lev_distance((char[:]){ "\xff\xfe", 2 }, (char[:]){ "\xff", 1 }) != 1)
        return err(15, "坏字节");
}

test "相似度千分比" {
    if (lev_ratio(S("abc"), S("abc")) != 1000)
        return err(16, "相同给 1000");
    if (lev_ratio(S(""), S("")) != 1000)
        return err(17, "两个空串给 1000");
    if (lev_ratio(S("abc"), S("abd")) != 666)
        return err(18, "abc/abd");
    if (lev_ratio(S("abc"), S("xyz")) != 0)
        return err(19, "完全不同给 0");
    if (lev_ratio(S("ab"), S("abcd")) != 500)
        return err(20, "长度差一半");
    if (lev_ratio(S("中文"), S("中文")) != 1000)
        return err(21, "中文相同");
}

test "阈值版本与长度上限" {
    if (lev_distance_max(S("kitten"), S("sitting"), 3) != 3)
        return err(22, "正好在阈值内");
    if (lev_distance_max(S("kitten"), S("sitting"), 2) != 3)
        return err(23, "超过阈值给 maxd+1");
    if (lev_distance_max(S("a"), S("abcdef"), 2) != 3)
        return err(24, "长度差先挡一道");
    if (lev_distance_max(S("abc"), S("abc"), 0) != 0)
        return err(25, "maxd=0");
    /* 超过 FUZZY_MAX 的串：-1，而不是悄悄截断 */
    {
        char big[400] = { 0 };
        int i = 0;

        for (i = 0; i < 300; i++)
            big[i] = 'a';
        if (lev_distance((char[:]){ big, 300 }, S("a")) != -1)
            return err(26, "超长串要给 -1");
        if (lev_ratio((char[:]){ big, 300 }, S("a")) != -1)
            return err(27, "超长串的相似度要给 -1");
        if (lev_distance_max((char[:]){ big, 300 }, S("a"), 2) != 3)
            return err(28, "超长串的阈值版按长度差挡掉");
    }
}

test "子序列匹配" {
    if (!subsequence_match(S("fzf"), S("fuzzy finder")))
        return err(29, "fzf");
    if (subsequence_match(S("fyz"), S("fuzzy finder")))
        return err(30, "顺序不对");
    if (!subsequence_match(S(""), S("anything")))
        return err(31, "空 needle 恒匹配");
    if (subsequence_match(S("a"), S("")))
        return err(32, "空 hay 不匹配非空 needle");
    if (!subsequence_match(S("ABC"), S("a1b2c3")))
        return err(33, "ASCII 大小写不敏感");
    if (!subsequence_match(S("中文"), S("这是中文文本")))
        return err(34, "中文按码点");
    if (subsequence_match(S("文中"), S("这是中文文本")))
        return err(35, "中文顺序");
}

test "子序列打分" {
    int cont = 0, scat = 0, word = 0, mid = 0;

    cont = subsequence_score(S("fzf"), S("fzf"));
    scat = subsequence_score(S("fzf"), S("f_z_f"));
    word = subsequence_score(S("ff"), S("fuzzy finder"));
    mid = subsequence_score(S("ff"), S("affbff"));
    if (subsequence_score(S("fyz"), S("fuzzy")) != -1)
        return err(36, "不匹配给 -1");
    if (cont <= scat)
        return err(37, "连续命中要比分散得分高");
    if (word <= mid)
        return err(38, "词首命中要比词中得分高");
    if (subsequence_score(S(""), S("x")) < 0)
        return err(39, "空 needle 给 0 分");
}

test "fuzzy_best 建议" {
    char a[] = "receive";
    char b[] = "recieve";
    char c[] = "relieve";
    char[:] cands[3] = { { 0 } };

    cands[0] = (char[:]){ a, 7 };
    cands[1] = (char[:]){ b, 7 };
    cands[2] = (char[:]){ c, 7 };
    if (fuzzy_best(S("recieve"), cands, 3, 2) != 1)
        return err(40, "应该挑中 recieve");
    if (fuzzy_best(S("reciev"), cands, 3, 0) != -1)
        return err(41, "maxd=0 时没有完全相同的候选");
    if (fuzzy_best(S("recive"), cands, 3, 1) != 0)
        return err(42, "少一个 e 也应该挑中（并列取最先）");
    if (fuzzy_best(S("zzz"), cands, 3, 1) != -1)
        return err(43, "完全不沾边给 -1");
    if (fuzzy_best(S("x"), (char[:] *)0, 3, 1) != -1)
        return err(44, "空候选表给 -1");
}
