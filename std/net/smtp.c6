/* std/net/smtp：SMTP 的应答行解析、命令拼装与 DATA 段的点填充。
 *
 *     import std.net.smtp;
 *
 *     SmtpReply r = { 0 };
 *     char cmd[128] = { 0 };
 *     if (smtp_reply((char[:]){ S("250 OK\r\n") }, &r) == 1)
 *         // r.code == 250、r.more == 0
 *
 * 应答行格式（RFC 5321 §4.2）：三位状态码 + 分隔符 + 文本；分隔符是空格表示最后一
 * 行，是 `-` 表示还有后续行。只有状态码没有文本也算合法。
 *
 * 约定：
 *
 * - `smtp_reply` 只解**一行**（不含行尾 CRLF 也行），`more` 是 1 表示后面还有行；
 * - 状态码必须是三位数字，否则返回 -1；
 * - `smtp_cmd` 拼「动词 + 可选参数 + CRLF」，参数里的 CR/LF 直接判错（防注入），
 *   容量不够返回 -1；
 * - `smtp_data` 做 DATA 段的三件事：统一成 CRLF 行尾、行首的 `.` 再补一个 `.`、
 *   末尾补 `.\r\n`；已经是 CRLF 的输入不会重复加 `\r`；
 * - `smtp_data_len` 给上界（`n*2 + 8`）。
 */
#include <string.h>

module std.net.smtp;
import std.core.types;
import std.text.str;

struct SmtpReply {
    int code;
    int more;
    int text_len;
    char text[256];
};

static int smtp_isdigit(char c)
{
    return c >= '0' && c <= '9';
}

int smtp_reply(char[:] line, SmtpReply *out)
{
    int i = 0, n = line.len, o = 0;

    if (!line.data || !out || n < 3)
        return -1;
    if (!smtp_isdigit(line.data[0]) || !smtp_isdigit(line.data[1])
        || !smtp_isdigit(line.data[2]))
        return -1;
    memset(out, 0, sizeof *out);
    out->code = (line.data[0] - '0') * 100 + (line.data[1] - '0') * 10
                + (line.data[2] - '0');
    if (out->code < 100 || out->code > 599)
        return -1;
    i = 3;
    if (i < n && line.data[i] == '-')
        out->more = 1;
    else if (i < n && line.data[i] != ' ' && line.data[i] != '\r')
        return -1;
    if (i < n)
        i++;
    for (; i < n && line.data[i] != '\r' && line.data[i] != '\n'; i++) {
        if (o + 1 < (int)sizeof out->text)
            out->text[o++] = line.data[i];
    }
    out->text[o] = 0;
    out->text_len = o;
    return 1;
}

int smtp_cmd(const char *verb, const char *arg, char *dst, int cap)
{
    int need = 0;

    if (!verb || !dst || cap <= 0)
        return -1;
    need = (int)strlen(verb) + 2;
    if (arg && arg[0]) {
        if (strchr(arg, '\r') || strchr(arg, '\n'))
            return -1;
        need += (int)strlen(arg) + 1;
    }
    if (need > cap)
        return -1;
    {
        int o = 0, i = 0;

        for (i = 0; verb[i]; i++)
            dst[o++] = verb[i];
        if (arg && arg[0]) {
            dst[o++] = ' ';
            for (i = 0; arg[i]; i++)
                dst[o++] = arg[i];
        }
        dst[o++] = '\r';
        dst[o++] = '\n';
        if (o < cap)
            dst[o] = 0;
        return o;
    }
}

int smtp_data_len(int n)
{
    if (n <= 0)
        return 3;
    return n * 2 + 8;
}

int smtp_data(char[:] src, char *dst, int cap)
{
    int i = 0, o = 0, bol = 1;

    if (!dst || cap < 0 || src.len < 0)
        return -1;
    for (i = 0; i < src.len; i++) {
        char c = src.data[i];

        if (bol && c == '.') {
            if (o + 1 > cap)
                return -1;
            dst[o++] = '.';
        }
        bol = 0;
        if (c == '\r') {
            if (i + 1 < src.len && src.data[i + 1] == '\n')
                continue;               /* 交给后面的 \n 统一处理 */
            if (o + 2 > cap)
                return -1;
            dst[o++] = '\r';
            dst[o++] = '\n';
            bol = 1;
            continue;
        }
        if (c == '\n') {
            if (o + 2 > cap)
                return -1;
            dst[o++] = '\r';
            dst[o++] = '\n';
            bol = 1;
            continue;
        }
        if (o + 1 > cap)
            return -1;
        dst[o++] = c;
    }
    if (!bol) {
        if (o + 2 > cap)
            return -1;
        dst[o++] = '\r';
        dst[o++] = '\n';
    }
    if (o + 3 > cap)
        return -1;
    dst[o++] = '.';
    dst[o++] = '\r';
    dst[o++] = '\n';
    if (o < cap)
        dst[o] = 0;
    return o;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "smtp：应答行" {
    SmtpReply r = { 0 };

    if (smtp_reply(S("250 OK\r\n"), &r) != 1)
        return err(1, "250 OK 解析失败");
    if (r.code != 250 || r.more != 0 || r.text_len != 2
        || memcmp(r.text, "OK", 2) != 0)
        return err(2, "250 OK 字段不对");
    if (smtp_reply(S("250-mail.example.com\r\n"), &r) != 1 || r.more != 1)
        return err(3, "连字符行应该 more=1");
    if (r.text_len != 16 || memcmp(r.text, "mail.example.com", 16) != 0)
        return err(4, "连字符行的文本不对");
    if (smtp_reply(S("354 End data with <CR><LF>.<CR><LF>"), &r) != 1
        || r.code != 354)
        return err(5, "354 解析失败");
    if (smtp_reply(S("221"), &r) != 1 || r.code != 221 || r.text_len != 0)
        return err(6, "只有状态码也应该合法");
    if (smtp_reply(S("22 OK"), &r) != -1)
        return err(7, "两位状态码应该 -1");
    if (smtp_reply(S("2x0 OK"), &r) != -1)
        return err(8, "非数字状态码应该 -1");
}

test "smtp：命令与 DATA 段" {
    char out[256] = { 0 };
    int n = 0;

    n = smtp_cmd("EHLO", "mail.example.com", out, (int)sizeof out);
    if (n != 23 || memcmp(out, "EHLO mail.example.com\r\n", 23) != 0)
        return err(9, "EHLO 命令拼装不对");
    n = smtp_cmd("QUIT", 0, out, (int)sizeof out);
    if (n != 6 || memcmp(out, "QUIT\r\n", 6) != 0)
        return err(10, "QUIT 命令拼装不对");
    if (smtp_cmd("MAIL", "a\r\nb", out, (int)sizeof out) != -1)
        return err(11, "参数含 CRLF 应该 -1");
    if (smtp_cmd("EHLO", "mail.example.com", out, 8) != -1)
        return err(12, "容量不够应该 -1");
    /* DATA：行首点填充 + CRLF 统一 + 结尾 .CRLF */
    n = smtp_data(S("Hello\n.hidden\nworld"), out, (int)sizeof out);
    if (n != 27)
        return err(13, "DATA 长度不对");
    if (memcmp(out, "Hello\r\n..hidden\r\nworld\r\n.\r\n", 27) != 0)
        return err(14, "DATA 内容不对");
    /* 已经是 CRLF 的输入 */
    n = smtp_data(S("a\r\nb\r\n"), out, (int)sizeof out);
    if (n != 9 || memcmp(out, "a\r\nb\r\n.\r\n", 9) != 0)
        return err(15, "CRLF 输入被重复处理");
    /* 空输入 */
    n = smtp_data(S(""), out, (int)sizeof out);
    if (n != 3 || memcmp(out, ".\r\n", 3) != 0)
        return err(16, "空输入应该只有 .CRLF");
}
