/* c6 自测：import 加载 '.c6' 模块（纯 C：`.c` 后缀，扩展不生效）
 *
 * 第二个翻译单元 tests/tu/c6mod.c6 同时是模块 tu.c6mod 的实现和
 * import 的声明来源。运行器会带上 '-I tests'，所以点号路径
 * 'tu/c6mod.c6' 能被找到。
 *
 * 运行（仓库根目录）：
 *   ./tcc/tcc -B tcc -I tests -test tests/c6ext/c6mod.c6 tests/tu/c6mod.c6
 */
import tu.c6mod;

test "import 找到 .c6 模块" {
    if (add(2, 3) != 5)
        return err(1, "add");
    if (twice(21) != 42)
        return err(2, "twice");
}

test "模块的 struct / enum / 全局变量" {
    Point p = { 3, 4 };
    if (area(&p) != 12)
        return err(3, "area");
    if (GREEN != 1)
        return err(4, "enum");
    if (counter != 7)
        return err(5, "counter");
    counter = 9;
    if (bump() != 10)
        return err(6, "bump");
}
