/* c6 自测：大块全零初始化数据 + 少量非零数据（LLVM 后端的数据段切分）
 *
 * 背景：.data 段在 LLVM 后端里是「一段一个 global」。修复前只要段里有一个
 * 非零字节，整段就被写成一条 c"..." 字符串；一个 1 MiB 的全零数组因此产生
 * 约 3.1 MB 的 .ll（每个零字节 4 个字符 \\00），.wasm 也跟着膨胀。
 * 现在长零段被切成独立的 zeroinitializer 成员，1 MiB 零数组 + 非零标量
 * 的 .ll 约 11 KB。
 *
 * 运行（仓库根目录）：
 *   ./tcc/c6 -B tcc -test tests/data_zero.c6
 *   BACKEND=llvm tests/run-tests.sh data_zero      # 走 .ll → clang 这条路
 */

typedef unsigned char u8;
typedef unsigned int u32;

#define BIG 262144u

/* 三块大零区，故意夹在非零数据前后：切分点必须在段内任意位置都成立 */
u8 head[4] = { 1, 2, 3, 4 };
u8 zero_a[BIG] = {0};
u32 mid = 0xDEADBEEFu;
u8 zero_b[BIG] = {0};
u8 tail[8] = "abcdefg";
u8 zero_c[64] = {0};

/* 结构体内部有长零段，但整个对象是「有数据」的 */
struct blob {
    u8 pad[BIG];
    u32 tag;
};
struct blob boxed = { .tag = 0x5A5A5A5Au };

test "大零区前后的数据都在原处" {
    if (head[0] != 1 || head[1] != 2 || head[2] != 3 || head[3] != 4)
        return err(1, "head 的前 4 个字节不对");
    if (mid != 0xDEADBEEFu)
        return err(2, "mid 被零区带偏了");
    if (tail[0] != 'a' || tail[6] != 'g' || tail[7] != 0)
        return err(3, "tail 字符串不对");
}

test "大零区确实是零" {
    u32 i = 0;

    for (i = 0; i < BIG; i++) {
        if (zero_a[i] != 0)
            return err(4, "zero_a 不是零");
        if (zero_b[i] != 0)
            return err(5, "zero_b 不是零");
    }
    for (i = 0; i < 64; i++)
        if (zero_c[i] != 0)
            return err(6, "zero_c 不是零");
}

test "跨零区做指针运算仍然线性" {
    u8 *p = 0;
    u8 *q = 0;

    p = &zero_a[0];
    q = &zero_a[BIG - 1];
    if ((u32)(q - p) != BIG - 1)
        return err(7, "zero_a 内部指针差不对");

    /* 依次写满两块零区，再读回来：写指针跨段边界时不能串到别的对象 */
    for (u32 i = 0; i < BIG; i++)
        zero_b[i] = (u8)(i & 0xFFu);
    for (u32 i = 0; i < BIG; i++)
        if (zero_b[i] != (u8)(i & 0xFFu))
            return err(8, "zero_b 写读不一致");
}

test "结构体内部的长零段不破坏尾部字段" {
    if (boxed.tag != 0x5A5A5A5Au)
        return err(9, "boxed.tag 不对");
    if (boxed.pad[0] != 0 || boxed.pad[BIG - 1] != 0)
        return err(10, "boxed.pad 不是零");
}
