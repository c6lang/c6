+                        if (n + 2 + strlen(get_tok_str(seg, NULL))
+                            >= (int)sizeof pfx)
+                            tcc_error("package name too long");
+                        sprintf(pfx + n, "__%s", get_tok_str(seg, NULL));
+                        n = strlen(pkgdisp);
+                        snprintf(pkgdisp + n, sizeof pkgdisp - n, ".%s",
