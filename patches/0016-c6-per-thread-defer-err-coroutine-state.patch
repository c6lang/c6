From 954390ec6e545c712b5f3c895467f4302ef7d7d5 Mon Sep 17 00:00:00 2001
From: c6 <c6@localhost>
Date: Sat, 7 Nov 2026 03:27:52 +0800
Subject: [PATCH] c6: per-thread defer/err/coroutine state

The c6 runtime used to keep one global defer stack, one error slot and one
coroutine pool, which is fine only while the whole program runs on a single
thread.  'go' is about to start real OS threads, so every stateful helper now
goes through a per-thread block (TccThCtx):

  * defer stack and scope-context stack, error slot, and the async task pool
    move into TccThCtx; the pool (512 KiB) and the stacks are allocated on
    first use, so threads that never run c6 code pay nothing;
  * the block is found through a pthread key instead of '__thread', because
    '-run' rejects TLS sections; a destructor releases it when a thread ends;
  * __c6_co_suspend/__c6_co_restore park and reload the records of the
    calling thread only.

Single-threaded programs behave exactly as before; the only difference is
that the runtime memory now comes from the heap.  libtcc1.c also grows the
pthread declarations the next patch needs (create/join/once/key).

Nothing in the language changed: tests/selftest and tests2 are unchanged.
---
 lib/libtcc1.c | 341 +++++++++++++++++++++++++++++++++++---------------
 1 file changed, 243 insertions(+), 98 deletions(-)

diff --git a/lib/libtcc1.c b/lib/libtcc1.c
index ec0378c..209f18f 100644
--- a/lib/libtcc1.c
+++ b/lib/libtcc1.c
@@ -625,11 +625,17 @@ long long __fixxfdi (long double a1)
 /* ------------------------------------------------------------------------- */
 /* c6 extension runtime: defer / errdefer / err                          */
 /*                                                                           */
-/* Deferred statements are recorded on a global (v1: single-threaded) stack.  */
-/* Each function stores the stack top at entry ("frame base") in a local slot */
-/* and passes it to every cleanup request, so a cleanup never touches records */
-/* that belong to the caller's frames.  Scope cleanups additionally filter by */
-/* lexical depth, which makes conditional registration and loops work.       */
+/* Deferred statements are recorded on a per-thread stack.  Each function     */
+/* stores the stack top at entry ("frame base") in a local slot and passes it */
+/* to every cleanup request, so a cleanup never touches records that belong   */
+/* to the caller's frames.  Scope cleanups additionally filter by lexical     */
+/* depth, which makes conditional registration and loops work.               */
+/*                                                                           */
+/* Every OS thread owns its defer stack, error slot and coroutine pool, so a  */
+/* thread that runs c6 code cannot corrupt the state of another one.  The     */
+/* per-thread block is found through a pthread key: '-run' rejects TLS        */
+/* sections, so '__thread' cannot be used.  A thread allocates its block      */
+/* lazily, the first time it touches the c6 runtime.                         */
 
 #define TCC_DEFER_MAX     8192
 #define TCC_DEFER_CTX_MAX 512
@@ -654,28 +660,131 @@ typedef struct TccDeferCtx {
     int base;    /* frame base: never pop records below this index */
 } TccDeferCtx;
 
-static TccDeferRec tcc_defer_stack[TCC_DEFER_MAX];
-static int tcc_defer_sp;
-static TccDeferCtx tcc_defer_ctx[TCC_DEFER_CTX_MAX];
-static int tcc_defer_csp;
+typedef struct TccCoPool TccCoPool;   /* completed with the async runtime */
+
+typedef struct TccThCtx {
+    TccDeferRec *dstack;  int dsp, stack_cap;
+    TccDeferCtx *dctx;    int dcsp, ctx_cap;
+    int err_flag, err_id;
+    const char *err_msg;
+    TccCoPool *co;
+} TccThCtx;
+
+#ifdef TCC_TARGET_PE
+/* The PE port has no c6 thread support yet: programs stay single threaded and
+   one static block is enough.  __tcc_th_start() traps there. */
+#else
+typedef unsigned long pthread_t;
+typedef unsigned int pthread_key_t;
+typedef int pthread_once_t;
+extern int pthread_once(pthread_once_t *, void (*)(void));
+extern int pthread_key_create(pthread_key_t *, void (*)(void *));
+extern void *pthread_getspecific(pthread_key_t);
+extern int pthread_setspecific(pthread_key_t, const void *);
+#endif
 
-static int tcc_err_flag;
-static int tcc_err_id;
-static const char *tcc_err_msg;
+extern void *calloc(unsigned long, unsigned long);
+extern void free(void *);
+
+static void tcc_th_trap(void)
+{
+    volatile int *p = (volatile int *)0;
+    *p = 0;
+}
+
+static void *tcc_th_alloc(unsigned long size)
+{
+    void *p = calloc(1, size);
+
+    if (!p)
+        tcc_th_trap();
+    return p;
+}
+
+static void tcc_th_co_free(TccCoPool *co);
+
+static void tcc_th_free(TccThCtx *th)
+{
+    if (!th)
+        return;
+    if (th->dstack)
+        free(th->dstack);
+    if (th->dctx)
+        free(th->dctx);
+    if (th->co)
+        tcc_th_co_free(th->co);
+    free(th);
+}
+
+#ifdef TCC_TARGET_PE
+static TccThCtx tcc_th_single;
+
+static TccThCtx *tcc_th(void)
+{
+    return &tcc_th_single;
+}
+#else
+static pthread_key_t tcc_th_key;
+static pthread_once_t tcc_th_once;
+
+static void tcc_th_key_init(void)
+{
+    if (pthread_key_create(&tcc_th_key, (void (*)(void *))tcc_th_free) != 0)
+        tcc_th_trap();
+}
+
+/* The per-thread block of the calling thread, allocated on first use. */
+static TccThCtx *tcc_th(void)
+{
+    TccThCtx *th;
+
+    if (pthread_once(&tcc_th_once, tcc_th_key_init) != 0)
+        tcc_th_trap();
+    th = (TccThCtx *)pthread_getspecific(tcc_th_key);
+    if (!th) {
+        th = (TccThCtx *)tcc_th_alloc(sizeof *th);
+        if (pthread_setspecific(tcc_th_key, th) != 0)
+            tcc_th_trap();
+    }
+    return th;
+}
+#endif
+
+static TccDeferRec *tcc_th_dstack(TccThCtx *th)
+{
+    if (!th->dstack) {
+        th->dstack = (TccDeferRec *)tcc_th_alloc(TCC_DEFER_MAX
+                                                * sizeof(TccDeferRec));
+        th->stack_cap = TCC_DEFER_MAX;
+    }
+    return th->dstack;
+}
+
+static TccDeferCtx *tcc_th_dctx(TccThCtx *th)
+{
+    if (!th->dctx) {
+        th->dctx = (TccDeferCtx *)tcc_th_alloc(TCC_DEFER_CTX_MAX
+                                              * sizeof(TccDeferCtx));
+        th->ctx_cap = TCC_DEFER_CTX_MAX;
+    }
+    return th->dctx;
+}
 
 /* Called once at function entry: remember where the frame starts.  The
    result is stored through OUT because helper functions are void-typed. */
 void __tcc_defer_func_enter(int *out)
 {
-    *out = tcc_defer_sp;
+    *out = tcc_th()->dsp;
 }
 
 void __tcc_defer_push(int id, int depth, int kind)
 {
+    TccThCtx *th = tcc_th();
     TccDeferRec *r;
-    if (tcc_defer_sp >= TCC_DEFER_MAX)
+
+    if (th->dsp >= TCC_DEFER_MAX)
         return;
-    r = &tcc_defer_stack[tcc_defer_sp++];
+    r = &tcc_th_dstack(th)[th->dsp++];
     r->id = id;
     r->depth = depth;
     r->kind = kind;
@@ -683,10 +792,12 @@ void __tcc_defer_push(int id, int depth, int kind)
 
 void __tcc_defer_begin_scope(int depth, int resume, int base)
 {
+    TccThCtx *th = tcc_th();
     TccDeferCtx *c;
-    if (tcc_defer_csp >= TCC_DEFER_CTX_MAX)
+
+    if (th->dcsp >= TCC_DEFER_CTX_MAX)
         return;
-    c = &tcc_defer_ctx[tcc_defer_csp++];
+    c = &tcc_th_dctx(th)[th->dcsp++];
     c->mode = TCC_DEFER_MODE_SCOPE;
     c->depth = depth;
     c->resume = resume;
@@ -695,10 +806,12 @@ void __tcc_defer_begin_scope(int depth, int resume, int base)
 
 void __tcc_defer_begin_func(int mode, int resume, int base)
 {
+    TccThCtx *th = tcc_th();
     TccDeferCtx *c;
-    if (tcc_defer_csp >= TCC_DEFER_CTX_MAX)
+
+    if (th->dcsp >= TCC_DEFER_CTX_MAX)
         return;
-    c = &tcc_defer_ctx[tcc_defer_csp++];
+    c = &tcc_th_dctx(th)[th->dcsp++];
     c->mode = mode;
     c->depth = 0;
     c->resume = resume;
@@ -710,21 +823,23 @@ void __tcc_defer_begin_func(int mode, int resume, int base)
    return-value handling. */
 void __tcc_defer_step(int *out)
 {
+    TccThCtx *th = tcc_th();
+
     *out = -1;
-    while (tcc_defer_csp > 0) {
-        TccDeferCtx *c = &tcc_defer_ctx[tcc_defer_csp - 1];
-        while (tcc_defer_sp > c->base) {
-            TccDeferRec *r = &tcc_defer_stack[tcc_defer_sp - 1];
+    while (th->dcsp > 0) {
+        TccDeferCtx *c = &tcc_th_dctx(th)[th->dcsp - 1];
+        while (th->dsp > c->base) {
+            TccDeferRec *r = &tcc_th_dstack(th)[th->dsp - 1];
             if (c->mode == TCC_DEFER_MODE_SCOPE && r->depth <= c->depth)
                 break;              /* belongs to an enclosing scope */
-            tcc_defer_sp--;
+            th->dsp--;
             if (r->kind == TCC_DEFER_KIND_ERRDEFER
                 && c->mode != TCC_DEFER_MODE_ERR)
                 continue;           /* errdefer only runs on the error path */
             *out = r->id;
             return;
         }
-        tcc_defer_csp--;
+        th->dcsp--;
         *out = -c->resume;
         return;
     }
@@ -732,14 +847,16 @@ void __tcc_defer_step(int *out)
 
 void __tcc_err_set(int id, const char *msg)
 {
-    tcc_err_flag = 1;
-    tcc_err_id = id;
-    tcc_err_msg = msg;
+    TccThCtx *th = tcc_th();
+
+    th->err_flag = 1;
+    th->err_id = id;
+    th->err_msg = msg;
 }
 
 int __tcc_err_flag_get(void)
 {
-    return tcc_err_flag;
+    return tcc_th()->err_flag;
 }
 
 /* Same value, but stored through OUT: generated code can call this without
@@ -747,17 +864,17 @@ int __tcc_err_flag_get(void)
    as void-typed everywhere in the code generator). */
 void __tcc_err_flag_peek(int *out)
 {
-    *out = tcc_err_flag;
+    *out = tcc_th()->err_flag;
 }
 
 int __tcc_err_id_get(void)
 {
-    return tcc_err_id;
+    return tcc_th()->err_id;
 }
 
 const char *__tcc_err_msg_get(void)
 {
-    return tcc_err_msg;
+    return tcc_th()->err_msg;
 }
 
 void __tcc_iface_init(void *self, const void *vt, void *dst)
@@ -769,9 +886,11 @@ void __tcc_iface_init(void *self, const void *vt, void *dst)
 
 void __tcc_err_clear(void)
 {
-    tcc_err_flag = 0;
-    tcc_err_id = 0;
-    tcc_err_msg = 0;
+    TccThCtx *th = tcc_th();
+
+    th->err_flag = 0;
+    th->err_id = 0;
+    th->err_msg = 0;
 }
 
 /* c6 'error' value: layout must match the 'error' typedef emitted by
@@ -786,10 +905,12 @@ typedef struct TccErrorValue {
    error never leaks to the enclosing function. */
 void __tcc_error_take(void *out)
 {
+    TccThCtx *th = tcc_th();
+
     if (out) {
         TccErrorValue *e = (TccErrorValue *)out;
-        e->id = tcc_err_id;
-        e->msg = tcc_err_msg;
+        e->id = th->err_id;
+        e->msg = th->err_msg;
     }
     __tcc_err_clear();
 }
@@ -860,7 +981,7 @@ void __tcc_slice_sub(void *out, const void *slice, TccSliceSize lo,
 /* wait) copies the used part of the native frame into the task and returns  */
 /* to whoever drives the task.  Resuming re-enters the body, copies the      */
 /* saved frame back to the same offsets and jumps to the recorded resume      */
-/* point.  'go f();' makes a coroutine top-level: it is put on the ready list */
+/* point.  'co f();' makes a coroutine top-level: it is put on the ready list */
 /* below and stepped by tcc_co_pump(), which is the scheduler.  Task objects   */
 /* live in this file so that 'struct __c6_task'                              */
 /* has exactly the layout that tcc_predefs() declares to compiled programs;  */
@@ -901,16 +1022,35 @@ typedef struct TccCoDesc {
 
 /* One slot per task, big enough for 'struct NAME_task' (the header plus the
    declared return value and parameters).  'long long' keeps every slot
-   8-byte aligned. */
-static long long tcc_co_task_mem[C6_CO_MAX][C6_CO_TASK_MAX / 8];
-#define C6_CO_TASK(i) ((TccCoTask *)(void *)tcc_co_task_mem[i])
-static char tcc_co_frames[C6_CO_MAX][C6_CO_FRAME_MAX];
-static TccDeferRec tcc_co_parked[C6_CO_MAX][C6_CO_DEFER_MAX];
-static char tcc_co_live[C6_CO_MAX];
