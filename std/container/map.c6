/* std/container/map：哈希表 Map@(K, V)。
 *
 *     import std.container.map;
 *
 *     @Map@(int, int) m = new Map@(int, int);
 *     m->put(1, 100) catch e { return e.id; };
 *     int v = 0;
 *     if (m->get(1, &v))
 *         printf("%d\n", v);
 *     Iter@(int, int) iv = { m, 0, { 0, 0 } };    // 迭代器是纯值
 *     Iter@(int, int) *it = &iv;
 *     while (it->has()) { int v = it->next(); int k = it->cur.key; ... }
 *
 * 键的要求：**POD**（没有托管字段、可以按字节比较）。c6 没有「约束/接口」来
 * 给用户类型注入 hash/eq，所以这里按 `sizeof(K)` 个字节做 FNV-1a 哈希、用
 * memcmp 判断相等：整数、指针、扁平的小结构体都直接可用。键类型里若有填充
 * 字节，请用 memset/聚合初始化保证两个相等的键逐字节相同。
 *
 * 设计要点：
 * - 开放寻址 + 线性探测，`flags` 区分空槽(0)/占用(1)/墓碑(2)，删除留墓碑；
 * - 负载因子到 3/4 时扩容并重新插入，容量是 2 的幂；
 * - 数组都是托管数组（`@K` / `@V` / `@u8`），没有手写释放；
 * - 因为字段里有托管引用，Map 只能 `new` 出来用 `@Map@(...)` 持有。
 */
#include <string.h>

module std.container.map;
import std.core.types;
import std.core.err;

enum Slot { SLOT_EMPTY = 0, SLOT_LIVE = 1, SLOT_DEAD = 2 };

struct Map@(K, V) {
    @K keys;
    @V vals;
    @u8 flags;
    int cap;
    int n;      /* 有效条目 */
    int used;   /* 占用 + 墓碑 */

    int count() { return n; }

    int capacity() { return cap; }

    int!error reserve(int want)
    {
        @K ok = keys;
        @V ov = vals;
        @u8 of = flags;
        @K nk = keys;
        @V nv = vals;
        @u8 nf = flags;
        int oldcap = cap;
        int ncap = cap > 0 ? cap : 8;
        int i = 0;

        if (want <= cap)
            return 0;
        while (ncap < want)
            ncap *= 2;
        nk = new K[ncap];
        nv = new V[ncap];
        nf = new u8[ncap];
        if (!nk || !nv || !nf)
            return err(std.core.err.NOMEM, "map: out of memory");
        memset(nf, 0, (usize)ncap);
        memset(nk, 0, (usize)ncap * sizeof(K));
        memset(nv, 0, (usize)ncap * sizeof(V));
        keys = nk;
        vals = nv;
        flags = nf;
        cap = ncap;
        used = 0;
        for (i = 0; i < oldcap; i++) {
            int j = 0;

            /* 只搬活着的条目：DEAD 也是非零，写成 `if (!of[i])` 会把墓碑
               连同旧键值一起「复活」，重建之后 count 少一、旧键又出现 */
            if (of[i] != SLOT_LIVE)
                continue;
            j = probe(&ok[i]);
            flags[j] = SLOT_LIVE;
            used++;
            keys[j] = ok[i];
            vals[j] = ov[i];
        }
        return 0;
    }

    /* 键的哈希：按字节 FNV-1a */
    u32 hash(K *k)
    {
        u8 *p = (u8 *)k;
        u32 h = 2166136261u;
        int i = 0;

        for (i = 0; i < (int)sizeof(K); i++)
            h = (h ^ (u32)p[i]) * 16777619u;
        return h;
    }

    /* 已有键 -> 它的槽位；否则 -> 沿探测路径第一个可用的槽位（墓碑优先） */
    int probe(K *k)
    {
        u32 mask = (u32)cap - 1;
        u32 i = hash(k) & mask;
        int first = -1;

        for (;;) {
            if (flags[i] == SLOT_EMPTY)
                return first >= 0 ? first : (int)i;
            if (flags[i] == SLOT_LIVE && !memcmp(&keys[i], k, sizeof(K)))
                return (int)i;
            if (flags[i] == SLOT_DEAD && first < 0)
                first = (int)i;
            i = (i + 1) & mask;
        }
    }

    int find(K *k)
    {
        u32 mask = 0;
        u32 i = 0;

        if (!cap || !flags)
            return -1;
        mask = (u32)cap - 1;
        i = hash(k) & mask;
        for (;;) {
            if (flags[i] == SLOT_EMPTY)
                return -1;
            if (flags[i] == SLOT_LIVE && !memcmp(&keys[i], k, sizeof(K)))
                return (int)i;
            i = (i + 1) & mask;
        }
    }

    int!error put(K k, V v)
    {
        int i = 0;

        if (cap == 0 || (used + 1) * 4 >= cap * 3)
            try reserve(cap ? cap * 2 : 8);   /* 原样转发 */
        i = probe(&k);
        if (flags[i] == SLOT_LIVE) {
            vals[i] = v;
            return 0;
        }
        if (flags[i] == SLOT_EMPTY)
            used++;
        flags[i] = SLOT_LIVE;
        n++;
        keys[i] = k;
        vals[i] = v;
        return 0;
    }

    /* 命中返回 1 并写 *out */
    int get(K k, V *out)
    {
        int i = find(&k);

        if (i < 0)
            return 0;
        *out = vals[i];
        return 1;
    }

    int has(K k) { return find(&k) >= 0; }

    /* 命中返回值，没命中返回 dflt（省掉 get + 判断两句） */
    V get_or(K k, V dflt)
    {
        int i = find(&k);

        if (i < 0)
            return dflt;
        return vals[i];
    }

    /* 命中则改成 v 并返回 1；没命中不改、返回 0（**不插入**，要插入用 put） */
    int set(K k, V v)
    {
        int i = find(&k);

        if (i < 0)
            return 0;
        vals[i] = v;
        return 1;
    }

    /* 没有就插入、有就原样不动：返回 1 表示本次插入，0 表示本来就有。
       常用来做去重 /「首次出现」计数。 */
    int!error put_new(K k, V v)
    {
        if (find(&k) >= 0)
            return 0;
        try put(k, v);        /* 原样转发 */
        return 1;
    }

    /* 删除：留墓碑，容量不回收 */
    int remove(K k)
    {
        int i = find(&k);

        if (i < 0)
            return 0;
        flags[i] = SLOT_DEAD;
        n--;
        return 1;
    }

    void clear()
    {
        if (flags)
            memset(flags, 0, (usize)cap);
        n = 0;
        used = 0;
    }

};

/* 遍历产出的一对键值。用结构体而不是元组：模板体内的方法还不能拿元组或
   多参数泛型实例当返回类型（`(K, V) next()` / `Entry@(K, V) next()` 都会
   把参数表读成形参声明），但可以拿它当**字段**，所以游标放在 `cur` 里。
   也因此 Map 没有 `iter()` 方法（它的返回类型正是多参数泛型实例）：迭代器
   请直接聚合初始化 `Iter@(K, V) it = { m, 0, { 0, 0 } };`。 */
struct Entry@(K, V) {
    K key;
    V val;
};

struct Iter@(K, V) {
    Map@(K, V) *map;
    int i;
    Entry@(K, V) cur;    /* next() 填好这一格：cur.key / cur.val */

    int has()
    {
        while (i < map->cap) {
            if (map->flags[i] == SLOT_LIVE)
                return 1;
            i++;
        }
        return 0;
    }

    /* foreach 只认 next()，它返回「值」；键在同一次调用填好的 cur.key 里 */
    V next()
    {
        cur.key = map->keys[i];
        cur.val = map->vals[i];
        i++;
        return cur.val;
    }
};

/* ---- 自测 ---- */

test "put / get / has / count" {
    @Map@(int, int) m = new Map@(int, int);
    int out = 0;

    m->put(1, 100) catch e { return err(1, "put 失败"); };
    m->put(2, 200) catch e { return err(2, "put 失败"); };
    if (m->count() != 2)
        return err(3, "count 不对");
    if (m->get(1, &out) != 1 || out != 100)
        return err(4, "get 1 不对");
    if (m->get(2, &out) != 1 || out != 200)
        return err(5, "get 2 不对");
    if (m->get(3, &out) != 0)
        return err(6, "不存在的键没有返回 0");
    if (m->has(2) != 1 || m->has(3) != 0)
        return err(7, "has 不对");
}

test "同一个键覆盖而不增加条目" {
    @Map@(int, int) m = new Map@(int, int);
    int out = 0;

    m->put(7, 1) catch e { return err(8, "put 失败"); };
    m->put(7, 2) catch e { return err(9, "put 失败"); };
    if (m->count() != 1)
        return err(10, "覆盖之后 count 变大了");
    if (m->get(7, &out) != 1 || out != 2)
        return err(11, "覆盖没有生效");
}

test "大量条目触发扩容，全部仍在" {
    @Map@(int, int) m = new Map@(int, int);
    int i = 0, out = 0;

    for (i = 0; i < 500; i++)
        m->put(i * 3, i) catch e { return err(12, "put 失败"); };
    if (m->count() != 500)
        return err(13, "count 不是 500");
    if (m->capacity() < 500)
        return err(14, "容量不够");
    for (i = 0; i < 500; i++) {
        if (m->get(i * 3, &out) != 1 || out != i)
            return err(15, "扩容后丢了键");
    }
}

test "删除留墓碑，之后还能插入新键" {
    @Map@(int, int) m = new Map@(int, int);
    int i = 0, out = 0;

    for (i = 0; i < 20; i++)
        m->put(i, i * 10) catch e { return err(16, "put 失败"); };
    if (m->remove(5) != 1)
        return err(17, "remove 没有命中");
    if (m->remove(5) != 0)
        return err(18, "第二次 remove 仍然命中");
    if (m->has(5) != 0)
        return err(19, "删除之后 has 仍为真");
    if (m->count() != 19)
        return err(20, "删除之后 count 不对");
    m->put(5, 999) catch e { return err(21, "put 失败"); };
    if (m->get(5, &out) != 1 || out != 999)
        return err(22, "重新插入没有生效");
    for (i = 0; i < 20; i++) {
        if (i == 5)
            continue;
        if (m->get(i, &out) != 1 || out != i * 10)
            return err(23, "删除影响了别的键");
    }
}

test "clear 之后是空的，容量保留" {
    @Map@(int, int) m = new Map@(int, int);
    int cap0 = 0;

    m->put(1, 1) catch e { return err(24, "put 失败"); };
    cap0 = m->capacity();
    m->clear();
    if (m->count() != 0 || m->has(1) != 0)
        return err(25, "clear 之后还有条目");
    if (m->capacity() != cap0)
        return err(26, "clear 把容量也丢了");
}

test "foreach 遍历 (K, V)" {
    @Map@(int, int) m = new Map@(int, int);
    int ks = 0, vs = 0, cnt = 0;

    m->put(1, 10) catch e { return err(27, "put 失败"); };
    m->put(2, 20) catch e { return err(28, "put 失败"); };
    m->put(3, 30) catch e { return err(29, "put 失败"); };
    Iter@(int, int) iv = { m, 0, { 0, 0 } };
    Iter@(int, int) *it = &iv;      /* 值容器调用方法要走指针 */

    while (it->has()) {
        int v = it->next();

        vs += v;
        ks += it->cur.key;      /* next() 填好的那一格 */
        cnt++;
    }
    if (cnt != 3 || vs != 60 || ks != 6)
        return err(30, "迭代结果不对");
}

/* 键类型要能被泛型参数指名，所以这个结构体放在文件作用域（块作用域里的
   tag 不适合当类型参数）。 */
struct TestKey { int x, y; };

test "键是指针，值是结构体" {
    TestKey a = { 1, 2 };
    TestKey b = { 3, 4 };
    @Map@(TestKey *, TestKey) m = new Map@(TestKey *, TestKey);
    TestKey out = { 0, 0 };

    m->put(&a, b) catch e { return err(32, "put 失败"); };
    if (m->get(&a, &out) != 1 || out.x != 3 || out.y != 4)
        return err(33, "指针键取值不对");
    if (m->get(&b, &out) != 0)
        return err(34, "不同的指针键命中了");
}

test "get_or / set / put_new" {
    @Map@(int, int) m = new Map@(int, int);
    int got = 0;
    int ins = 0;

    m->put(1, 100) catch e { return err(60, "put 失败"); };
    if (m->get_or(1, -1) != 100)
        return err(61, "get_or 命中的值不对");
    if (m->get_or(2, -1) != -1)
        return err(62, "get_or 没命中应给默认值");
    if (m->set(1, 111) != 1 || m->get_or(1, 0) != 111)
        return err(63, "set 命中没改成新值");
    if (m->set(2, 222) != 0 || m->has(2) != 0)
        return err(64, "set 没命中不该插入");
    m->put_new(3, 300) catch e { return err(65, "put_new 首次失败"); };
    if (m->has(3) != 1)
        return err(66, "put_new 首次应插入");
    m->put_new(3, 999) catch e { return err(70, "put_new 已存在不该报错"); };
    if (m->get_or(3, 0) != 300)
        return err(68, "put_new 已存在不该覆盖");
    got = m->count();
    if (got != 2)
        return err(69, "最终 count 不对");
}

test "墓碑不会在扩容时复活" {
    @Map@(int, int) m = new Map@(int, int);
    int i = 0, out = 0;

    for (i = 0; i < 20; i++)
        m->put(i, i) catch e { return err(71, "put 失败"); };
    if (m->remove(7) != 1)
        return err(72, "remove 没命中");
    if (m->count() != 19)
        return err(73, "remove 之后 count 不对");
    /* 继续插到触发扩容（cap 32 -> 64），此时表里还留着 7 的墓碑 */
    for (i = 20; i < 40; i++)
        m->put(i, i) catch e { return err(74, "扩容期间 put 失败"); };
    if (m->count() != 39)
        return err(75, "扩容之后 count 不对");
    if (m->has(7) != 0 || m->get(7, &out) != 0)
        return err(76, "墓碑在扩容时复活了");
    for (i = 0; i < 40; i++) {
        if (i == 7)
            continue;
        if (m->get(i, &out) != 1 || out != i)
            return err(77, "扩容之后丢了条目");
    }
    /* 复活过的键如果还在，set 会更新到它而不是新槽：这里再验一次插入 */
    m->put(7, 777) catch e { return err(78, "重新插入失败"); };
    if (m->count() != 40 || m->get_or(7, 0) != 777)
        return err(79, "墓碑位置重用不对");
}
