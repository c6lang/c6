/* std/core/polynomial：多项式的求值、加减乘、求导与二次求根（系数数组表示）。
 *
 *     import std.core.polynomial;
 *
 *     double c[4] = { 1, 0, -1, 2 };      // 1 + 0x - x^2 + 2x^3（升幂）
 *     double v = poly_eval(c, 4, 2.0);   // 15
 *
 * 表示约定：
 *
 * - 系数**升幂**排列：`c[0] + c[1]*x + … + c[n-1]*x^(n-1)`；
 * - `n` 是系数个数（不是次数），`n <= 0` 一律返回 -1 或 0；
 * - 运算的输出写到调用方给的数组，`cap` 是能容纳的系数个数；
 * - `poly_trim` 把尾部为 0 的高阶系数去掉并返回新的个数（至少 1）；
 * - 求值用 Horner 法，`poly_eval` 对任意 `n >= 1` 都成立。
 *
 * 二次求根 `poly_roots2`：给 `a, b, c`（`a*x^2 + b*x + c`），按判别式返回根数
 * （0/1/2），`a == 0` 时退化成一次方程（返回 0 或 1），并在 `*x1`/`*x2` 里按
 * 由小到大写根。
 */
#include <math.h>

module std.core.polynomial;
import std.core.types;

int poly_trim(const double *c, int n)
{
    int k = n;

    if (!c || n <= 0)
        return 0;
    while (k > 1 && c[k - 1] == 0)
        k--;
    return k;
}

double poly_eval(const double *c, int n, double x)
{
    double v = 0;
    int i = 0;

    if (!c || n <= 0)
        return 0;
    for (i = n - 1; i >= 0; i--)
        v = v * x + c[i];
    return v;
}

double poly_eval_deriv(const double *c, int n, double x)
{
    double v = 0;
    int i = 0;

    if (!c || n <= 1)
        return 0;
    for (i = n - 1; i >= 1; i--)
        v = v * x + (double)i * c[i];
    return v;
}

int poly_add(const double *a, int na, const double *b, int nb, double *out,
             int cap)
{
    int n = na > nb ? na : nb;
    int i = 0;

    if (!a || !b || !out || na <= 0 || nb <= 0 || cap < n)
        return -1;
    for (i = 0; i < n; i++) {
        double v = 0;

        if (i < na)
            v += a[i];
        if (i < nb)
            v += b[i];
        out[i] = v;
    }
    return poly_trim(out, n);
}

int poly_sub(const double *a, int na, const double *b, int nb, double *out,
             int cap)
{
    int n = na > nb ? na : nb;
    int i = 0;

    if (!a || !b || !out || na <= 0 || nb <= 0 || cap < n)
        return -1;
    for (i = 0; i < n; i++) {
        double v = 0;

        if (i < na)
            v += a[i];
        if (i < nb)
            v -= b[i];
        out[i] = v;
    }
    return poly_trim(out, n);
}

int poly_mul(const double *a, int na, const double *b, int nb, double *out,
             int cap)
{
    int n = 0, i = 0, j = 0;

    if (!a || !b || !out || na <= 0 || nb <= 0)
        return -1;
    n = na + nb - 1;
    if (cap < n)
        return -1;
    for (i = 0; i < n; i++)
        out[i] = 0;
    for (i = 0; i < na; i++)
        for (j = 0; j < nb; j++)
            out[i + j] += a[i] * b[j];
    return poly_trim(out, n);
}

int poly_deriv(const double *c, int n, double *out, int cap)
{
    int i = 0;

    if (!c || !out || n <= 0)
        return -1;
    if (n == 1) {
        if (cap < 1)
            return -1;
        out[0] = 0;
        return 1;
    }
    if (cap < n - 1)
        return -1;
    for (i = 1; i < n; i++)
        out[i - 1] = (double)i * c[i];
    return poly_trim(out, n - 1);
}

int poly_roots2(double a, double b, double c, double *x1, double *x2)
{
    double d = 0;

    if (!x1 || !x2)
        return -1;
    *x1 = 0;
    *x2 = 0;
    if (a == 0) {
        if (b == 0)
            return 0;
        *x1 = -c / b;
        *x2 = *x1;
        return 1;
    }
    d = b * b - 4 * a * c;
    if (d < 0)
        return 0;
    if (d == 0) {
        *x1 = -b / (2 * a);
        *x2 = *x1;
        return 1;
    }
    {
        double s = sqrt(d);
        double r1 = (-b - s) / (2 * a);
        double r2 = (-b + s) / (2 * a);

        if (r1 <= r2) {
            *x1 = r1;
            *x2 = r2;
        } else {
            *x1 = r2;
            *x2 = r1;
        }
    }
    return 2;
}

/* ---- 自测 ---- */

static int pnear(double a, double b)
{
    double d = a - b;

    if (d < 0)
        d = -d;
    return d < 1e-9;
}

test "polynomial：求值与求导" {
    double c[4] = { 1, 0, -1, 2 };      /* 1 - x^2 + 2x^3 */
    double d[8] = { 0 };
    int n = 0;

    if (!pnear(poly_eval(c, 4, 0), 1))
        return err(1, "x=0 的值不对");
    if (!pnear(poly_eval(c, 4, 2), 13))
        return err(2, "x=2 的值应该是 13");
    if (!pnear(poly_eval_deriv(c, 4, 2), 20))
        return err(3, "x=2 的导数应该是 20");
    if (!pnear(poly_eval(c, 0, 5), 0))
        return err(4, "空多项式求值应该是 0");
    n = poly_deriv(c, 4, d, 8);
    if (n != 3 || !pnear(d[0], 0) || !pnear(d[1], -2) || !pnear(d[2], 6))
        return err(5, "导数系数不对");
    if (poly_deriv(c, 4, d, 2) != -1)
        return err(6, "容量不够应该 -1");
    n = poly_trim((double[]){ 1, 2, 0, 0 }, 4);
    if (n != 2)
        return err(7, "去尾零应该剩 2 项");
}

test "polynomial：加减乘与求根" {
    double a[3] = { 1, 2, 3 };
    double b[2] = { 0, 1 };             /* x */
    double out[8] = { 0 };
    double x1 = 0, x2 = 0;
    int n = 0;

    n = poly_add(a, 3, b, 2, out, 8);
    if (n != 3 || !pnear(out[0], 1) || !pnear(out[1], 3) || !pnear(out[2], 3))
        return err(8, "加法不对");
    n = poly_sub(a, 3, b, 2, out, 8);
    if (n != 3 || !pnear(out[1], 1))
        return err(9, "减法不对");
    n = poly_mul(a, 3, b, 2, out, 8);
    if (n != 4 || !pnear(out[0], 0) || !pnear(out[1], 1) || !pnear(out[2], 2)
        || !pnear(out[3], 3))
        return err(10, "乘法不对");
    /* (x-1)(x-2) = x^2 - 3x + 2 → 根 1 和 2 */
    if (poly_roots2(1, -3, 2, &x1, &x2) != 2)
        return err(11, "应该有两个根");
    if (!pnear(x1, 1) || !pnear(x2, 2))
        return err(12, "根不对");
    if (poly_roots2(1, 2, 1, &x1, &x2) != 1 || !pnear(x1, -1))
        return err(13, "重根不对");
    if (poly_roots2(1, 0, 1, &x1, &x2) != 0)
        return err(14, "无实根应该 0");
    if (poly_roots2(0, 2, -4, &x1, &x2) != 1 || !pnear(x1, 2))
        return err(15, "一次方程不对");
    if (poly_roots2(0, 0, 5, &x1, &x2) != 0)
        return err(16, "常数方程应该 0");
}
