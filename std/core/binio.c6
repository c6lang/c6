/* std/core/binio：小端/大端的整数读写游标（Reader / Writer）。
 *
 *     import std.core.binio;
 *
 *     Reader r = { 0 };
 *     Writer w = { 0 };
 *     unsigned char buf[16] = { 0 };
 *     w.bind(buf, (int)sizeof buf);       // 方法：bind / u16le / u32le / bytes / size
 *     w.u16le(0x1234);
 *     w.u32be(0xDEADBEEF);
 *     r.bind(buf, w.size());
 *     r.u16le();                          // 0x1234
 *     r.u32be();                          // 0xDEADBEEF
 *
 * 设计：`Reader`/`Writer` 都是「绑定一段内存 + 当前偏移 + ok 标记」的游标。所有读
 * 函数在越界时把 `ok` 置 0 并返回 0（不抛错），所以可以用 `r.ok()` 在序列末尾统一
 * 检查；写函数同理，越界后 `ok` 置 0 且不再写入。
 *
 * 约定：
 *
 * - `bind(src, n)` 复位游标并清 `ok`；`remaining()` 是剩余字节数，`pos()` 是当前
 *   偏移，`size()` 是已写字节数（Writer）；
 * - `bytes(dst, len)` 读 `len` 字节；`bytes(src, len)` 写 `len` 字节；
 * - `skip(n)` 只前进（越界置 `ok=0`）；`seek(pos)` 直接定位（越界置 `ok=0`）；
 * - 读写都是**按字节**拼装，不受主机字节序影响；
 * - 没有动态分配，也不会自己扩展缓冲区（Writer 容量由调用方给）。
 */
#include <string.h>

module std.core.binio;
import std.core.types;
import std.text.str;

struct Reader {
    const unsigned char *p;
    int n;
    int off;
    int okflag;
};

struct Writer {
    unsigned char *p;
    int cap;
    int off;
    int okflag;
};

int bind(Reader *r, const void *src, int n)
{
    if (!r)
        return -1;
    r->p = (const unsigned char *)src;
    r->n = n < 0 ? 0 : n;
    r->off = 0;
    r->okflag = 1;
    return 1;
}

int ok(Reader *r)
{
    return r ? r->okflag : 0;
}

int position(Reader *r)
{
    return r ? r->off : -1;
}

int remaining(Reader *r)
{
    return r ? r->n - r->off : 0;
}

int seek(Reader *r, int pos)
{
    if (!r || pos < 0 || pos > r->n) {
        if (r)
            r->okflag = 0;
        return -1;
    }
    r->off = pos;
    return 1;
}

int skip(Reader *r, int n)
{
    return seek(r, r ? r->off + n : 0);
}

static int rd_need(Reader *r, int k)
{
    if (!r || !r->okflag || k < 0 || r->off + k > r->n) {
        if (r)
            r->okflag = 0;
        return 0;
    }
    return 1;
}

u32 u8(Reader *r)
{
    u32 v = 0;

    if (!rd_need(r, 1))
        return 0;
    v = (u32)r->p[r->off];
    r->off += 1;
    return v;
}

u32 u16le(Reader *r)
{
    u32 v = 0;

    if (!rd_need(r, 2))
        return 0;
    v = (u32)r->p[r->off] | ((u32)r->p[r->off + 1] << 8);
    r->off += 2;
    return v;
}

u32 u24le(Reader *r)
{
    u32 v = 0;

    if (!rd_need(r, 3))
        return 0;
    v = (u32)r->p[r->off] | ((u32)r->p[r->off + 1] << 8)
        | ((u32)r->p[r->off + 2] << 16);
    r->off += 3;
    return v;
}

u32 u32le(Reader *r)
{
    u32 v = 0;

    if (!rd_need(r, 4))
        return 0;
    v = (u32)r->p[r->off] | ((u32)r->p[r->off + 1] << 8)
        | ((u32)r->p[r->off + 2] << 16) | ((u32)r->p[r->off + 3] << 24);
    r->off += 4;
    return v;
}

u64 u64le(Reader *r)
{
    u64 v = 0;

    if (!rd_need(r, 8))
        return 0;
    v = (u64)u32le(r);
    v |= (u64)u32le(r) << 32;
    return v;
}

u32 u16be(Reader *r)
{
    u32 v = 0;

    if (!rd_need(r, 2))
        return 0;
    v = ((u32)r->p[r->off] << 8) | (u32)r->p[r->off + 1];
    r->off += 2;
    return v;
}

u32 u32be(Reader *r)
{
    u32 v = 0;

    if (!rd_need(r, 4))
        return 0;
    v = ((u32)r->p[r->off] << 24) | ((u32)r->p[r->off + 1] << 16)
        | ((u32)r->p[r->off + 2] << 8) | (u32)r->p[r->off + 3];
    r->off += 4;
    return v;
}

u64 u64be(Reader *r)
{
    u64 v = 0;

    if (!rd_need(r, 8))
        return 0;
    v = (u64)u32be(r) << 32;
    v |= (u64)u32be(r);
    return v;
}

int bytes(Reader *r, void *dst, int len)
{
    if (!dst || len < 0 || !rd_need(r, len))
        return -1;
    memcpy(dst, r->p + r->off, (size_t)len);
    r->off += len;
    return len;
}

/* ---- Writer ---- */

int bind(Writer *w, void *dst, int cap)
{
    if (!w || !dst || cap < 0)
        return -1;
    w->p = (unsigned char *)dst;
    w->cap = cap;
    w->off = 0;
    w->okflag = 1;
    return 1;
}

int ok(Writer *w)
{
    return w ? w->okflag : 0;
}

int size(Writer *w)
{
    return w ? w->off : -1;
}

int capacity(Writer *w)
{
    return w ? w->cap : 0;
}

static int wr_need(Writer *w, int k)
{
    if (!w || !w->okflag || k < 0 || w->off + k > w->cap) {
        if (w)
            w->okflag = 0;
        return 0;
    }
    return 1;
}

int put_u8(Writer *w, u32 v)
{
    if (!wr_need(w, 1))
        return -1;
    w->p[w->off++] = (unsigned char)(v & 0xFF);
    return 1;
}

int put_u16le(Writer *w, u32 v)
{
    if (!wr_need(w, 2))
        return -1;
    w->p[w->off++] = (unsigned char)(v & 0xFF);
    w->p[w->off++] = (unsigned char)((v >> 8) & 0xFF);
    return 1;
}

int put_u24le(Writer *w, u32 v)
{
    if (!wr_need(w, 3))
        return -1;
    w->p[w->off++] = (unsigned char)(v & 0xFF);
    w->p[w->off++] = (unsigned char)((v >> 8) & 0xFF);
    w->p[w->off++] = (unsigned char)((v >> 16) & 0xFF);
    return 1;
}

int put_u32le(Writer *w, u32 v)
{
    if (!wr_need(w, 4))
        return -1;
    w->p[w->off++] = (unsigned char)(v & 0xFF);
    w->p[w->off++] = (unsigned char)((v >> 8) & 0xFF);
    w->p[w->off++] = (unsigned char)((v >> 16) & 0xFF);
    w->p[w->off++] = (unsigned char)((v >> 24) & 0xFF);
    return 1;
}

int put_u64le(Writer *w, u64 v)
{
    if (!wr_need(w, 8))
        return -1;
    put_u32le(w, (u32)(v & 0xFFFFFFFFu));
    put_u32le(w, (u32)(v >> 32));
    return 1;
}

int put_u16be(Writer *w, u32 v)
{
    if (!wr_need(w, 2))
        return -1;
    w->p[w->off++] = (unsigned char)((v >> 8) & 0xFF);
    w->p[w->off++] = (unsigned char)(v & 0xFF);
    return 1;
}

int put_u32be(Writer *w, u32 v)
{
    if (!wr_need(w, 4))
        return -1;
    w->p[w->off++] = (unsigned char)((v >> 24) & 0xFF);
    w->p[w->off++] = (unsigned char)((v >> 16) & 0xFF);
    w->p[w->off++] = (unsigned char)((v >> 8) & 0xFF);
    w->p[w->off++] = (unsigned char)(v & 0xFF);
    return 1;
}

int put_u64be(Writer *w, u64 v)
{
    if (!wr_need(w, 8))
        return -1;
    put_u32be(w, (u32)(v >> 32));
    put_u32be(w, (u32)(v & 0xFFFFFFFFu));
    return 1;
}

int put_bytes(Writer *w, const void *src, int len)
{
    if (!src || len < 0 || !wr_need(w, len))
        return -1;
    memcpy(w->p + w->off, src, (size_t)len);
    w->off += len;
    return len;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "binio：写读往返" {
    static unsigned char buf[32] = { 0 };
    Reader r = { 0 };
    Writer w = { 0 };

    if (w.bind(buf, (int)sizeof buf) != 1)
        return err(1, "Writer bind 失败");
    w.put_u8(0x7F);
    w.put_u16le(0x1234);
    w.put_u24le(0xABCDEF);
    w.put_u32le(0xDEADBEEFu);
    w.put_u16be(0x1234);
    w.put_u32be(0xCAFEBABEu);
    w.put_u64le(0x1122334455667788uLL);
    if (w.ok() != 1)
        return err(2, "写入应该都成功");
    if (w.size() != 1 + 2 + 3 + 4 + 2 + 4 + 8)
        return err(3, "写入字节数不对");
    if (r.bind(buf, w.size()) != 1)
        return err(4, "Reader bind 失败");
    if (r.u8() != 0x7F)
        return err(5, "u8 不对");
    if (r.u16le() != 0x1234)
        return err(6, "u16le 不对");
    if (r.u24le() != 0xABCDEF)
        return err(7, "u24le 不对");
    if (r.u32le() != 0xDEADBEEFu)
        return err(8, "u32le 不对");
    if (r.u16be() != 0x1234)
        return err(9, "u16be 不对");
    if (r.u32be() != 0xCAFEBABEu)
        return err(10, "u32be 不对");
    if (r.u64le() != 0x1122334455667788uLL)
        return err(11, "u64le 不对");
    if (r.remaining() != 0 || r.ok() != 1)
        return err(12, "读完之后应该没有剩余且 ok");
}

test "binio：越界与字节块" {
    static unsigned char buf[16] = { 0 };
    Reader r = { 0 };
    Writer w = { 0 };
    static const char *msg = "hello";
    char out[8] = { 0 };

    /* 越界读：ok 变 0，返回 0 */
    if (r.bind(buf, 2) != 1)
        return err(13, "bind 失败");
    if (r.u32le() != 0 || r.ok() != 0)
        return err(14, "越界读应该置 ok=0 并返回 0");
    /* 越界写 */
    if (w.bind(buf, 3) != 1)
        return err(15, "Writer bind 失败");
    if (w.put_u32le(1) != -1 || w.ok() != 0)
        return err(16, "越界写应该返回 -1 并置 ok=0");
    /* 字节块 */
    if (w.bind(buf, (int)sizeof buf) != 1)
        return err(17, "Writer bind 失败");
    if (w.put_bytes(msg, 5) != 5)
        return err(18, "写字节块失败");
    if (r.bind(buf, 5) != 1)
        return err(19, "Reader bind 失败");
    if (r.bytes(out, 5) != 5 || memcmp(out, "hello", 5) != 0)
        return err(20, "读字节块不对");
    /* seek / skip */
    if (r.bind(buf, 5) != 1 || r.seek(3) != 1 || r.remaining() != 2)
        return err(21, "seek 不对");
    if (r.skip(5) != -1 || r.ok() != 0)
        return err(22, "越界 skip 应该 -1");
}
