/* examples/stdfont.c6 —— 第四十批（字体与矢量）的集成示例。
 *
 *     cmake --build build --target std-font
 *
 * 四节：BDF 位图字体（度量 + 位图）、WOFF 容器（表目录）、SVG 路径（规范化 +
 * 包围盒）、TrueType（表目录 + cmap + hmtx）。数据都现场拼在内存里。
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.text.str;
import std.data.bdf;
import std.data.woff;
import std.data.svg;
import std.data.ttf;

static int checks = 0;
static int fails = 0;

static void check(int cond, const char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("   ✗ %s\n", what);
    }
}

static const char *bdf_src =
    "STARTFONT 2.1\n"
    "FONT -misc-fixed-medium-r-normal--8-80-75-75-c-80-iso10646-1\n"
    "SIZE 8 75 75\n"
    "FONTBOUNDINGBOX 8 8 0 0\n"
    "CHARS 1\n"
    "STARTCHAR A\n"
    "ENCODING 65\n"
    "DWIDTH 8 0\n"
    "BBX 8 8 0 0\n"
    "BITMAP\n"
    "18\n"
    "24\n"
    "42\n"
    "7E\n"
    "42\n"
    "42\n"
    "42\n"
    "00\n"
    "ENDCHAR\n"
    "ENDFONT\n";

static void do_bdf(void)
{
    BdfInfo fi = { 0 };
    BdfChar ch = { 0 };
    static unsigned char bits[8] = { 0 };
    int n = (int)strlen(bdf_src);

    printf("== bdf\n");
    check(bdf_info(bdf_src, n, &fi) == 1, "字体解析");
    printf("   %dpt，%dx%d，%d 个字符\n", fi.size_pt, fi.fbw, fi.fbh,
           fi.nchars);
    check(fi.size_pt == 8 && fi.nchars == 1, "字段");
    check(bdf_find(bdf_src, n, 'A', &ch) == 1, "找到 A");
    check(ch.bbw == 8 && ch.bbh == 8 && ch.dwidth_x == 8, "A 的度量");
    check(bdf_bitmap(bdf_src, n, &ch, bits, (int)sizeof bits) == 8,
          "位图字节数");
    printf("   位图首行 0x%02X，第 4 行 0x%02X\n", bits[0], bits[3]);
    check(bits[0] == 0x18 && bits[3] == 0x7E && bits[7] == 0x00, "位图内容");
}

static void put32(u8 *p, u32 v)
{
    p[0] = (u8)(v >> 24);
    p[1] = (u8)((v >> 16) & 0xFF);
    p[2] = (u8)((v >> 8) & 0xFF);
    p[3] = (u8)(v & 0xFF);
}

static void put16(u8 *p, int v)
{
    p[0] = (u8)((v >> 8) & 0xFF);
    p[1] = (u8)(v & 0xFF);
}

static void do_woff(void)
{
    static u8 buf[128] = { 0 };
    WoffInfo info = { 0 };
    WoffTable t = { 0 };
    int off = 84, n = 0;

    printf("== woff\n");
    memcpy(buf, "wOFF", 4);
    put32(buf + 4, 0x00010000u);
    put16(buf + 12, 2);
    put32(buf + 16, 120);
    put16(buf + 20, 1);
    memcpy(buf + 44, "cmap", 4);
    put32(buf + 48, (u32)off);
    put32(buf + 52, 4);
    put32(buf + 56, 4);
    memcpy(buf + 64, "glyf", 4);
    put32(buf + 68, (u32)off + 4);
    put32(buf + 72, 4);
    put32(buf + 76, 16);
    buf[off] = 0xAA;
    buf[off + 1] = 0xBB;
    buf[off + 2] = 0xCC;
    buf[off + 3] = 0xDD;
    n = off + 8;
    put32(buf + 8, (u32)n);
    check(woff_info(buf, n, &info) == 1, "容器解析");
    printf("   %d 张表，sfnt %u 字节，版本 %d.%d\n", info.ntables,
           info.sfnt_size, info.major, info.minor);
    check(info.ntables == 2 && info.flavor == 0x00010000u, "头字段");
    check(woff_find(buf, n, "cmap", &t) == 1, "找到 cmap");
    check(t.comp_len == 4 && t.orig_len == 4, "cmap 未压缩");
    check(woff_find(buf, n, "glyf", &t) == 1 && t.comp_len == 4
          && t.orig_len == 16, "glyf 有原始长度");
    check(woff_find(buf, n, "head", &t) == 0, "没有 head 表");
}

static void do_svg(void)
{
    Str d = { S("M0 0 L10 0 C10 10 0 10 0 0 Z") };
    SvgSeg seg = { 0 };
    double x0 = 0, y0 = 0, x1 = 0, y1 = 0;

    printf("== svg\n");
    check(svg_path_count(d) == 4, "段数");
    printf("   %d 段：", svg_path_count(d));
    {
        int i = 0;

        for (i = 0; i < 4; i++) {
            if (svg_path_at(d, i, &seg) == 1)
                printf("%c ", (char)seg.cmd);
        }
    }
    printf("\n");
    check(svg_path_at(d, 1, &seg) == 1 && seg.cmd == 'L' && seg.p[0] == 10,
          "第二段是 L");
    check(svg_path_at(d, 3, &seg) == 1 && seg.cmd == 'Z', "末段是 Z");
    check(svg_path_bbox(d, &x0, &y0, &x1, &y1) == 1, "包围盒");
    printf("   bbox = (%g, %g) - (%g, %g)\n", x0, y0, x1, y1);
    check(x0 == 0 && y0 == 0 && x1 == 10 && y1 == 10, "包围盒数值");
}

static void do_ttf(void)
{
    static u8 buf[512] = { 0 };
    Ttf f = { 0 };
    int cmap = 128, head = 172, hhea = 228, maxp = 264, hmtx = 296;
    int off = 12 + 5 * 16, i = 0;

    printf("== ttf\n");
    memset(buf, 0, sizeof buf);
    memcpy(buf, "OTTO", 4);
    put16(buf + 4, 5);
    memcpy(buf + 12, "cmap", 4);
    put32(buf + 20, (u32)cmap);
    put32(buf + 24, 44);
    memcpy(buf + 28, "head", 4);
    put32(buf + 36, (u32)head);
    put32(buf + 40, 54);
    memcpy(buf + 44, "hhea", 4);
    put32(buf + 52, (u32)hhea);
    put32(buf + 56, 36);
    memcpy(buf + 60, "hmtx", 4);
    put32(buf + 68, (u32)hmtx);
    put32(buf + 72, 8);
    memcpy(buf + 76, "maxp", 4);
    put32(buf + 84, (u32)maxp);
    put32(buf + 88, 32);
    /* cmap format 4，一段覆盖 'A'..'Z' */
    put16(buf + cmap, 0);
    put16(buf + cmap + 2, 1);
    put16(buf + cmap + 4, 3);
    put16(buf + cmap + 6, 1);
    put32(buf + cmap + 8, 12);
    {
        u8 *s = buf + cmap + 12;

        put16(s, 4);
        put16(s + 2, 32);
        put16(s + 6, 4);
        put16(s + 14, 0x5A);
        put16(s + 16, 0xFFFF);
        put16(s + 20, 0x41);
        put16(s + 22, 0xFFFF);
        put16(s + 24, (0x10000 - 0x41 + 1) & 0xFFFF);
        put16(s + 26, 1);
    }
    put32(buf + head, 0x00010000u);
    put16(buf + head + 18, 2048);
    put32(buf + hhea, 0x00010000u);
    put16(buf + hhea + 4, 1600);
    put16(buf + hhea + 6, (u16)(-400 & 0xFFFF));
    put16(buf + hhea + 34, 2);
    put32(buf + maxp, 0x00010000u);
    put16(buf + maxp + 4, 2);
    put16(buf + hmtx, 1024);
    put16(buf + hmtx + 4, 512);
    (void)off;
    i = hmtx + 8;
    check(ttf_info(buf, i, &f) == 1, "字体解析");
    printf("   upem=%d，%d 个字形，ascender=%d\n", f.units_per_em,
           f.n_glyphs, f.ascender);
    check(f.units_per_em == 2048 && f.n_glyphs == 2, "基本字段");
    check(f.ascender == 1600 && f.descender == -400, "升降部");
    check(ttf_glyph(buf, i, &f, 'A') == 1 && ttf_glyph(buf, i, &f, 'Z') == 26,
          "cmap 段映射");
    check(ttf_glyph(buf, i, &f, 'a') == -1, "小写不在段里");
    check(ttf_advance(buf, i, &f, 0) == 1024 && ttf_advance(buf, i, &f, 1) == 512,
          "hmtx 宽度");
    check(ttf_advance(buf, i, &f, 7) == 512, "超界用最后一个宽度");
}

int main(void)
{
    do_bdf();
    do_woff();
    do_svg();
    do_ttf();
    printf("\n%d check(s), %d failure(s)\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
