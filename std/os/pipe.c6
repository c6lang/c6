/* std/os/pipe：匿名管道（`pipe(2)`）：非阻塞开关、按字节读写、两端分别关闭。
 *
 *     import std.os.pipe;
 *
 *     Pipe p = { 0 };
 *     if (!p.init())                // 默认阻塞
 *         return err(1, "pipe");
 *     p.write_bytes("hello", 5);
 *     p.close_write();              // 读端会在取完数据之后看到 EOF
 *     char buf[32] = { 0 };
 *     int n = p.read_bytes(buf, sizeof(buf));   // 5，然后再读是 0
 *     p.close_all();
 *
 * 用途：把「生产数据」和「消费数据」解耦——子进程 stdout（`std.os.proc`）、
 * 线程之间传字节、给 `poll`/`select` 造一个可以等的 fd。管道没有消息边界，
 * 一次 `write` 的字节可能被拆成几次 `read`，要边界就自己加长度前缀或者用
 * `std.container.chan`（它按元素拷贝，有边界）。
 *
 * 约定：
 *
 * - 结构里是两个 fd 加一个「打开过没有」的标记：`Pipe p = { 0 };` 之后必须
 *   `init()`/`init_nonblock()` 才有真正的 fd（0 和 0 不是「已经打开」）。
 * - `read_bytes` 返回**读到的字节数**，`0` 是 EOF（写端全关了），`-1` 是错误；
 *   非阻塞且暂时没数据时也是 `-1`，紧跟其后调 `would_block()` 判断。
 * - `write_bytes` 返回**实际写进去的字节数**（非阻塞/管道满时可能小于 `len`），
 *   `-1` 表示一个字节都没写进去。管道缓冲（Linux 上 64 KiB）满了写端会阻塞，
 *   读端不读就会卡住——所以生产者要么配 `poll`，要么用非阻塞。
 * - `close_read`/`close_write` 只关一端，重复关返回 0；`close_all` 两端都关。
 *   **写端没关之前 read 永远等不到 EOF**，这是管道最常见的坑。
 * - `read_exact` 一直读到凑满 `len` 或 EOF，返回实际字节数（协议解析用它）。
 * - 所有读写都自己重试 `EINTR`；fd 带 `FD_CLOEXEC`，`exec` 之后不会漏给子进程。
 */
#define _GNU_SOURCE 1

#include <errno.h>
#include <fcntl.h>
#include <string.h>
#include <unistd.h>

module std.os.pipe;
import std.core.types;

struct Pipe {
    int rd;
    int wr;
    int opened;
};

/* 开/关两端的 O_NONBLOCK */
int set_nonblock(Pipe *self, int on)
{
    int flags = 0;

    if (!self || !self->opened)
        return 0;
    if (self->rd >= 0) {
        flags = fcntl(self->rd, F_GETFL);
        if (flags < 0)
            return 0;
        if (on)
            flags = flags | O_NONBLOCK;
        else
            flags = flags & ~O_NONBLOCK;
        if (fcntl(self->rd, F_SETFL, flags) != 0)
            return 0;
    }
    if (self->wr >= 0) {
        flags = fcntl(self->wr, F_GETFL);
        if (flags < 0)
            return 0;
        if (on)
            flags = flags | O_NONBLOCK;
        else
            flags = flags & ~O_NONBLOCK;
        if (fcntl(self->wr, F_SETFL, flags) != 0)
            return 0;
    }
    return 1;
}

/* 建一对管道；nonblock 非 0 时两端都设成非阻塞 */
static int open_pair(Pipe *self, int nonblock)
{
    int fds[2] = { -1, -1 };
    int flags = 0;

    if (!self || self->opened)
        return 0;
    if (pipe(fds) != 0)
        return 0;
    flags = fcntl(fds[0], F_GETFD);
    if (flags >= 0)
        fcntl(fds[0], F_SETFD, flags | FD_CLOEXEC);
    flags = fcntl(fds[1], F_GETFD);
    if (flags >= 0)
        fcntl(fds[1], F_SETFD, flags | FD_CLOEXEC);
    self->rd = fds[0];
    self->wr = fds[1];
    self->opened = 1;
    if (nonblock && !set_nonblock(self, 1)) {
        close(self->rd);
        close(self->wr);
        self->rd = -1;
        self->wr = -1;
        self->opened = 0;
        return 0;
    }
    return 1;
}

/* 建一对管道：默认阻塞 */
int init(Pipe *self) { return open_pair(self, 0); }

/* 建一对非阻塞管道 */
int init_nonblock(Pipe *self) { return open_pair(self, 1); }

/* 读一次：>0 字节数、0 EOF、-1 错误（非阻塞下 errno=EAGAIN） */
int read_bytes(Pipe *self, char *buf, int cap)
{
    int n = 0;

    if (!self || !self->opened || self->rd < 0 || !buf || cap <= 0)
        return -1;
    for (;;) {
        n = (int)read(self->rd, buf, (size_t)cap);
        if (n >= 0)
            return n;
        if (errno != EINTR)
            return -1;
    }
}

/* 读满 len 或到 EOF：返回实际字节数，出错 -1 */
int read_exact(Pipe *self, char *buf, int len)
{
    int done = 0;
    int n = 0;

    if (!self || !buf || len < 0)
        return -1;
    while (done < len) {
        n = read_bytes(self, buf + done, len - done);
        if (n == 0)
            break;
        if (n < 0)
            return done > 0 ? done : -1;
        done += n;
    }
    return done;
}

/* 写一次：>=0 实际字节数（可能小于 len）、-1 一个都没写进去 */
int write_bytes(Pipe *self, const char *buf, int len)
{
    int done = 0;
    int n = 0;

    if (!self || !self->opened || self->wr < 0 || !buf || len < 0)
        return -1;
    while (done < len) {
        n = (int)write(self->wr, buf + done, (size_t)(len - done));
        if (n > 0) {
            done += n;
            continue;
        }
        if (n < 0 && errno == EINTR)
            continue;
        if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
            return done > 0 ? done : -1;
        return done > 0 ? done : -1;
    }
    return done;
}

/* 刚返回过 -1 的话：是不是「非阻塞下暂时没数据/写不进去」 */
int would_block(void)
{
    return errno == EAGAIN || errno == EWOULDBLOCK;
}

/* 关读端；关过/没打开返回 0 */
int close_read(Pipe *self)
{
    if (!self || !self->opened || self->rd < 0)
        return 0;
    close(self->rd);
    self->rd = -1;
    if (self->wr < 0)
        self->opened = 0;
    return 1;
}

/* 关写端：读端读完剩下的数据之后会读到 EOF */
int close_write(Pipe *self)
{
    if (!self || !self->opened || self->wr < 0)
        return 0;
    close(self->wr);
    self->wr = -1;
    if (self->rd < 0)
        self->opened = 0;
    return 1;
}

/* 两端都关 */
int close_all(Pipe *self)
{
    int ok = 0;

    if (close_read(self))
        ok = 1;
    if (close_write(self))
        ok = 1;
    return ok;
}

int is_open(Pipe *self) { return self && self->opened; }

int read_fd(Pipe *self) { return self && self->opened ? self->rd : -1; }

int write_fd(Pipe *self) { return self && self->opened ? self->wr : -1; }

/* ==== 测试 ==== */

test "写进去再读出来，关掉写端之后读到 EOF" {
    Pipe p = { 0 };
    char buf[32] = { 0 };
    int n = 0;

    if (!p.init())
        return err(1, "init");
    if (!p.is_open() || p.read_fd() < 0 || p.write_fd() < 0)
        return err(2, "打开之后两端都该有效");
    if (p.write_bytes("hello", 5) != 5)
        return err(3, "写");
    n = p.read_bytes(buf, sizeof(buf));
    if (n != 5 || strncmp(buf, "hello", 5) != 0)
        return err(4, "读回来的内容不对");
    if (!p.close_write())
        return err(5, "关写端");
    if (p.close_write())
        return err(6, "重复关写端应当返回 0");
    if (p.read_bytes(buf, sizeof(buf)) != 0)
        return err(7, "写端关掉之后应当读到 EOF");
    if (!p.close_read())
        return err(8, "关读端");
    if (p.is_open() || p.read_fd() != -1 || p.write_fd() != -1)
        return err(9, "两端都关掉之后不该还是打开状态");
    if (p.read_bytes(buf, sizeof(buf)) != -1)
        return err(10, "关掉之后读应当报错");
}

test "非阻塞：没数据时 EAGAIN，写一个字节就能读到" {
    Pipe p = { 0 };
    char buf[8] = { 0 };

    if (!p.init_nonblock())
        return err(1, "init_nonblock");
    if (p.read_bytes(buf, sizeof(buf)) != -1)
        return err(2, "非阻塞且没有数据时应当报错");
    if (!would_block())
        return err(3, "errno 应当是 EAGAIN");
    if (p.write_bytes("x", 1) != 1)
        return err(4, "写");
    if (p.read_bytes(buf, sizeof(buf)) != 1 || buf[0] != 'x')
        return err(5, "读到刚写的字节");
    if (!p.set_nonblock(0))
        return err(6, "关掉非阻塞");
    if (p.close_all() != 1)
        return err(7, "close_all");
    if (p.close_all())
        return err(8, "重复 close_all 应当返回 0");
}

test "read_exact：凑满或到 EOF" {
    Pipe p = { 0 };
    Pipe q = { 0 };
    char buf[8] = { 0 };

    /* 写端关掉：只有 3 个字节，读满 5 个会停在 EOF */
    if (!p.init())
        return err(1, "init");
    if (p.write_bytes("abc", 3) != 3)
        return err(2, "写");
    if (!p.close_write())
        return err(3, "关写端");
    if (p.read_exact(buf, 5) != 3)
        return err(4, "只有 3 个字节，读满 5 个应当只拿到 3");
    if (strncmp(buf, "abc", 3) != 0)
        return err(5, "内容不对");
    p.close_all();

    /* 够 5 个：一次读满 */
    if (!q.init())
        return err(6, "init");
    if (q.write_bytes("defgh", 5) != 5)
        return err(7, "写");
    if (!q.close_write())
        return err(8, "关写端");
    if (q.read_exact(buf, 5) != 5 || strncmp(buf, "defgh", 5) != 0)
        return err(9, "够 5 个字节就该读满");
    q.close_all();
}

/* 跨线程：一个线程分十次写，主线程读到 EOF，字节数必须对上 */
static Pipe t_pair;
static int t_written;

static void t_producer(void)
{
    int i = 0;

    for (i = 0; i < 10; i++)
        t_written = t_written + t_pair.write_bytes("abcd", 4);
    t_pair.close_write();               /* 让读端能读到 EOF */
}

test "跨线程：写完关掉写端，读端读到 EOF" {
    char buf[16] = { 0 };
    int total = 0;
    int n = 0;

    t_written = 0;
    if (!t_pair.init())
        return err(1, "init");
    thread th = spawn t_producer();
    for (;;) {
        n = t_pair.read_bytes(buf, sizeof(buf));
        if (n < 0)
            return err(2, "读出错");
        if (n == 0)
            break;
        total += n;
    }
    th->join();
    if (t_written != 40)
        return err(3, "写端应当写进去 40 字节");
    if (total != 40)
        return err(4, "读端应当读到 40 字节");
    if (!t_pair.close_all())
        return err(5, "close_all");
}
