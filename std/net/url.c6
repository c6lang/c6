/* std/net/url：URL 解析、相对解析与百分号编解码（RFC 3986）。
 *
 *     import std.net.url;
 *
 *     Url u = url_parse(S("https://example.com:8443/a/b?q=1#frag"));
 *     u.ok;                    // 1
 *     u.scheme;                // "https"
 *     u.host;                  // "example.com"
 *     u.port;                  // 8443
 *     u.path;                  // "/a/b"
 *     u.query;                 // "q=1"
 *     u.fragment;              // "frag"
 *
 *     char out[256] = { 0 };
 *     url_resolve(S("https://example.com/dir/"), S("../x?y"), out, sizeof out);
 *                                                          // "https://example.com/x?y"
 *
 * 这一层**不分配**：`Url` 的每个字段都是指向输入串的 `Str` 视图，没出现的
 * 组件就是 `{ 0, 0 }` 的空视图，没有别的哨兵。所以「URL 里有空 query（`?`）」
 * 和「没有 query」在视图层面被合并——这是有意的简化：标准库不做 URL 的规范化
 * 比较，`?` 与 `#` 是否存在只有 `url_parse` 内部的切分知道，要区分就自己看
 * 原始串。
 *
 * 解析规则（RFC 3986 第 3 节的分解，逐条被自测钉住）：
 *   - 有 `scheme:` 前缀（字母开头，其后字母/数字/`+`/`-`/`.`）才算 scheme；
 *     否则整个串是相对引用，`scheme` 为空；
 *   - `//authority` 可选；authority 里 `@` 之前是 userinfo（最后一个 `@`），
 *     其后 `[v6]:port` 里 IPv6 字面量**不拆冒号**，端口只认十进制；
 *   - `?query` 与 `#fragment` 按**第一个**出现的分隔符切，`#` 之后不再认 `?`；
 *   - 端口非法（非数字、> 65535）让 `ok` 为 0 且保留原文——不静默改值。
 *
 * `url_resolve` 是 RFC 3986 §5.2 的完整算法（含第 4 节的 abnormal 用例），
 * 结果写调用方缓冲，放不下返回 -1 且不写半截。
 */
#include <stdio.h>
#include <string.h>

module std.net.url;
import std.core.types;
import std.core.err;
import std.text.str;

enum Error { OK = 0, INVAL = 1, RANGE = 2, PARSE = 3 };

/* 解析结果：全是输入串里的视图（不拥有内存） */
struct Url {
    Str scheme;
    Str userinfo;
    Str host;
    Str port_str;
    Str path;
    Str query;
    Str fragment;
    int port;       /* -1 = 没给端口 */
    int has_authority;
    int is_abs;     /* 有 scheme */
    int ok;         /* 端口合法就是 1 */
};

static int url_is_alpha(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

static int url_is_digit(int c) { return c >= '0' && c <= '9'; }

static int url_is_scheme_char(int c)
{
    return url_is_alpha(c) || url_is_digit(c) || c == '+' || c == '-'
        || c == '.';
}

/* 十六进制位 -> 0..15，非法给 -1 */
static int url_hex(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
        return c - 'A' + 10;
    return -1;
}

static Str url_sub(char[:] s, int from, int to)
{
    return (Str){ (char[:]){ s.data + from, to - from } };
}

/* 从 from 起找字符 c，返回下标；找不到返回 end */
static int url_find_from(char[:] s, int from, char c)
{
    int i = 0;

    for (i = from; i < s.len; i++)
        if (s.data[i] == c)
            return i;
    return s.len;
}

/* ---- 解析 ---- */

Url url_parse(char[:] s)
{
    Url u = { { { (char *)0, 0 } }, { { (char *)0, 0 } }, { { (char *)0, 0 } },
              { { (char *)0, 0 } }, { { (char *)0, 0 } }, { { (char *)0, 0 } },
              { { (char *)0, 0 } }, -1, 0, 0, 1 };
    int i = 0;
    int rest = 0;       /* 当前的起点 */
    int hash = 0;
    int q = 0;

    if (s.len < 0) {
        u.ok = 0;
        return u;
    }

    /* fragment：第一个 '#'，之后不再认 '?' */
    hash = url_find_from(s, 0, '#');
    if (hash < s.len) {
        u.fragment = url_sub(s, hash + 1, s.len);
        s = (char[:]){ s.data, hash };
    }
    /* query：'#' 之前的第一个 '?' */
    q = url_find_from(s, 0, '?');
    if (q < s.len) {
        u.query = url_sub(s, q + 1, s.len);
        s = (char[:]){ s.data, q };
    }

    /* scheme：`:` 之前必须是合法 scheme 字符，且首字符是字母 */
    if (s.len > 0 && url_is_alpha((u8)s.data[0])) {
        int colon = url_find_from(s, 0, ':');
        int k = 0;

        if (colon < s.len) {
            for (k = 1; k < colon; k++)
                if (!url_is_scheme_char((u8)s.data[k]))
                    break;
            if (k == colon) {
                u.scheme = url_sub(s, 0, colon);
                u.is_abs = 1;
                rest = colon + 1;
            }
        }
    }

    /* authority：`//` 开头 */
    if (rest + 1 < s.len && s.data[rest] == '/' && s.data[rest + 1] == '/') {
        int start = rest + 2;
        int end = url_find_from(s, start, '/');
        int at = -1;
        int k = 0;
        int colon = -1;

        u.has_authority = 1;
        /* 最后一个 '@' 才是 userinfo 的边界（password 里可以有 '@' 转义前形态） */
        for (k = start; k < end; k++)
            if (s.data[k] == '@')
                at = k;
        if (at >= 0) {
            u.userinfo = url_sub(s, start, at);
            start = at + 1;
        }
        /* IPv6 字面量 [::1] 里的冒号不是端口分隔符 */
        if (start < end && s.data[start] == '[') {
            int close = start + 1;

            while (close < end && s.data[close] != ']')
                close++;
            if (close < end) {
                u.host = url_sub(s, start, close + 1);
                if (close + 1 < end && s.data[close + 1] == ':')
                    colon = close + 1;
            } else {
                /* 没有右括号：整段当主机名，标成不合法 */
                u.host = url_sub(s, start, end);
                u.ok = 0;
            }
        } else {
            for (k = start; k < end; k++)
                if (s.data[k] == ':') {
                    colon = k;
                    break;
                }
            if (colon >= 0)
                u.host = url_sub(s, start, colon);
            else
                u.host = url_sub(s, start, end);
        }
        if (colon >= 0) {
            int p = 0;
            int v = 0;

            u.port_str = url_sub(s, colon + 1, end);
            if (u.port_str.s.len == 0)
                u.ok = 0;           /* "host:" 后面空着 */
            for (p = 0; p < u.port_str.s.len && u.ok; p++) {
                int c = (u8)u.port_str.s.data[p];

                if (!url_is_digit(c)) {
                    u.ok = 0;
                    break;
                }
                v = v * 10 + (c - '0');
                if (v > 65535) {
                    u.ok = 0;
                    break;
                }
            }
            if (u.ok)
                u.port = v;
        }
        rest = end;
    }

    u.path = url_sub(s, rest, s.len);
    return u;
}

/* 有 scheme 且是绝对引用 */
int url_is_absolute(Url *self) { return self->is_abs; }

/* 有 scheme 且 authority 为空（如 "mailto:" / "file:"） */
int url_has_host(Url *self) { return self->host.s.len > 0; }

/* 有效端口：没有显式端口时按 scheme 给默认值，未知 scheme 给 -1。
 *
 * 判据是 `port_str` 有没有内容，不是 `port >= 0`：`Url u = { 0 };` 这种全零
 * 初始化是 C 里的自然写法，它的 `port` 是 0、看起来像个显式端口，只有
 * `port_str` 空着才说明「没给端口」。 */
int url_effective_port(Url *self)
{
    char[:] sc = self->scheme.s;

    if (self->port_str.s.len > 0)
        return self->port;
    if (sc.len == 4 && !memcmp(sc.data, "http", 4))
        return 80;
    if (sc.len == 5 && !memcmp(sc.data, "https", 5))
        return 443;
    if (sc.len == 3 && !memcmp(sc.data, "ftp", 3))
        return 21;
    if (sc.len == 6 && !memcmp(sc.data, "telnet", 6))
        return 23;
    return -1;
}

/* 单个查询参数：key 与 value 都是原始（未解码）视图 */
struct Pair {
    Str key;
    Str value;
};

/* 在 query 里按 '&' 切出下一个参数；返回 1 取到、0 结束。
   `at` 是调用方的游标（从 0 开始）。没有 '=' 时 value 是空视图。 */
int url_next_pair(Str *query, int *at, Pair *out)
{
    int i = *at;
    int start = 0;
    int end = 0;
    int eq = 0;

    if (i >= query->s.len)
        return 0;
    start = i;
    end = url_find_from(query->s, start, '&');
    *at = end + 1;
    eq = url_find_from((char[:]){ query->s.data + start, end - start }, 0, '=');
    if (eq < end - start) {
        out->key = url_sub(query->s, start, start + eq);
        out->value = url_sub(query->s, start + eq + 1, end);
    } else {
        out->key = url_sub(query->s, start, end);
        out->value = url_sub(query->s, end, end);
    }
    return 1;
}

/* ---- 百分号编解码 ---- */

/* 解码需要多少字节：%XX 三个字符算一个（非法转义原样保留，也算一个） */
int url_decoded_len(char[:] s)
{
    int n = 0;
    int i = 0;

    if (s.len < 0)
        return 0;
    for (i = 0; i < s.len; i++) {
        if (s.data[i] == '%' && i + 2 < s.len
            && url_hex((u8)s.data[i + 1]) >= 0 && url_hex((u8)s.data[i + 2]) >= 0)
            i += 2;
        n++;
    }
    return n;
}

/* 解码：%XX -> 字节，'+' 可选当空格（plus 非 0）。
 *
 * **不写结尾 NUL**：返回值就是解出来的字节数（和 `std.encoding.codec` 同一约定），
 * 要当 C 字符串用就自己多给一格并写 `buf[n] = 0`。
   非法转义**原样保留**（不报错）——URL 里的 `%` 不总是转义，宽容比中断有用。
   放不下返回 -1 且不写。 */
int url_decode_at(char[:] s, char *dst, int cap, int plus)
{
    int need = url_decoded_len(s);
    int o = 0;
    int i = 0;

    if (dst == 0 || need > cap)
        return -1;
    for (i = 0; i < s.len; i++) {
        int c = (u8)s.data[i];

        if (c == '%' && i + 2 < s.len && url_hex((u8)s.data[i + 1]) >= 0
            && url_hex((u8)s.data[i + 2]) >= 0) {
            dst[o++] = (char)((url_hex((u8)s.data[i + 1]) << 4)
                              | url_hex((u8)s.data[i + 2]));
            i += 2;
        } else if (c == '+' && plus) {
            dst[o++] = ' ';
        } else {
            dst[o++] = (char)c;
        }
    }
    return o;
}

int url_decode(char[:] s, char *dst, int cap)
{
    return url_decode_at(s, dst, cap, 0);
}

/* 哪些字节不转义：unreserved（字母数字 - . _ ~）加调用方给的 extra 里的字符。
   extra 传 0 表示只保留 unreserved（最严格）。 */
static int url_safe(int c, char *extra)
{
    if (url_is_alpha(c) || url_is_digit(c))
        return 1;
    if (c == '-' || c == '.' || c == '_' || c == '~')
        return 1;
    while (extra && *extra) {
        if ((u8)*extra++ == c)
            return 1;
    }
    return 0;
}

int url_encoded_len(char[:] s, char *extra)
{
    int n = 0;
    int i = 0;

    if (s.len < 0)
        return 0;
    for (i = 0; i < s.len; i++) {
        if (url_safe((u8)s.data[i], extra))
            n += 1;
        else
            n += 3;
    }
    return n;
}

/* 编码：不安全的字节写成 %XX（大写十六进制）。放不下返回 -1 且不写。
 *
 * 和 `url_decode` 一样**不写结尾 NUL**：返回值就是长度，要当 C 字符串用就
 * 自己多给一格。`url_encode` 保留 `/`（整条路径用），`url_encode_component`
 * 连 `/` 也编（单个查询参数用）。 */
int url_encode_at(char[:] s, char *dst, int cap, char *extra)
{
    char *hex = (char *)"0123456789ABCDEF";
    int need = url_encoded_len(s, extra);
    int o = 0;
    int i = 0;

    if (dst == 0 || need > cap)
        return -1;
    for (i = 0; i < s.len; i++) {
        int c = (u8)s.data[i];

        if (url_safe(c, extra)) {
            dst[o++] = (char)c;
        } else {
            dst[o++] = '%';
            dst[o++] = hex[(c >> 4) & 15];
            dst[o++] = hex[c & 15];
        }
    }
    return o;
}

int url_encode(char[:] s, char *dst, int cap)
{
    return url_encode_at(s, dst, cap, (char *)"/");
}

int url_encode_component(char[:] s, char *dst, int cap)
{
    return url_encode_at(s, dst, cap, (char *)0);
}

/* ---- 相对解析（RFC 3986 §5.2） ---- */

/* dst == 0 时只数长度、不落笔：相对解析用它做第一遍，保证「要么整段写出，
 * 要么一格都不动」——调用方缓冲太小时不会留下半截。 */
static int url_put(char *dst, int cap, int *o, char[:] s)
{
    if (*o + s.len > cap)
        return -1;
    if (s.len > 0 && dst)
        memcpy(dst + *o, s.data, (size_t)s.len);
    *o += s.len;
    return 0;
}

static int url_put_c(char *dst, int cap, int *o, char c)
{
    if (*o + 1 > cap)
        return -1;
    if (dst)
        dst[(*o)++] = c;
    else
        (*o)++;
    return 0;
}

/* 把 userinfo@host:port 写进 out（不含前导 "//"） */
static int url_put_host_port(Url *u, char *dst, int cap, int *o)
{
    if (u->userinfo.s.len > 0) {
        if (url_put(dst, cap, o, u->userinfo.s) < 0)
            return -1;
        if (url_put_c(dst, cap, o, '@') < 0)
            return -1;
    }
    if (url_put(dst, cap, o, u->host.s) < 0)
        return -1;
    if (u->port_str.s.len > 0) {
        if (url_put_c(dst, cap, o, ':') < 0)
            return -1;
        if (url_put(dst, cap, o, u->port_str.s) < 0)
            return -1;
    }
    return 0;
}

/* 整段 authority：userinfo@host:port */
static int url_put_authority(Url *u, char *dst, int cap, int *o)
{
    return url_put_host_port(u, dst, cap, o);
}

/* 从 out 的末尾弹掉一段（连同它前面的 '/'），返回新的长度。
 * 只在 remove_dot_segments 里用；dst == 0（只计长度）时没有内容可弹，
 * 由调用方直接给 0——见下面算法里对 dst 为空的处理。 */
static int url_pop_seg(char *dst, int o)
{
    if (dst == 0 || o <= 0)
        return 0;
    if (dst[o - 1] == '/')
        o -= 1;
    while (o > 0 && dst[o - 1] != '/')
        o -= 1;
    if (o > 0)
        o -= 1;                 /* 连前面的 '/' 一起弹 */
    return o;
}

/* RFC 3986 §5.2.4 的 remove_dot_segments，逐条照算法走。
 *
 * 照抄算法而不是「按段重组」的好处：结尾斜杠、"//" 里的空段、弹到根就停这些
 * 细节全是算法的自然结果，不用逐条特判（自测里 §5.4 的 23 条用例就是这么钉住的）。
 * `dst == 0` 时只数长度。
 */
static int url_remove_dots(char[:] in, char *dst, int cap)
{
    int i = 0;
    int o = 0;
    int n = in.len;

    while (i < n) {
        int rem = n - i;
        char *p = in.data + i;

        /* A. "../" 或 "./" 前缀：直接丢 */
        if (rem >= 3 && p[0] == '.' && p[1] == '.' && p[2] == '/') {
            i += 3;
            continue;
        }
        if (rem >= 2 && p[0] == '.' && p[1] == '/') {
            i += 2;
            continue;
        }
        /* B. "/./" 换成 "/"；以 "/." 结尾时换成 "/" */
        if (rem >= 3 && p[0] == '/' && p[1] == '.' && p[2] == '/') {
            i += 2;
            continue;
        }
        if (rem == 2 && p[0] == '/' && p[1] == '.') {
            /* "/." 在结尾要换成 "/"：把那个 '/' 写出去，"." 丢掉 */
            if (url_put_c(dst, cap, &o, '/') < 0)
                return -1;
            i += 2;
            continue;
        }
        /* C. "/../" 换成 "/"，并弹掉输出里最后一段 */
        if (rem >= 4 && p[0] == '/' && p[1] == '.' && p[2] == '.'
            && p[3] == '/') {
            i += 3;
            o = url_pop_seg(dst, o);
            continue;
        }
        if (rem == 3 && p[0] == '/' && p[1] == '.' && p[2] == '.') {
            o = url_pop_seg(dst, o);
            if (url_put_c(dst, cap, &o, '/') < 0)
                return -1;
            i += 3;
            continue;
        }
        /* D. 整个输入就是 "." 或 ".."：丢掉 */
        if (rem == 1 && p[0] == '.') {
            i += 1;
            continue;
        }
        if (rem == 2 && p[0] == '.' && p[1] == '.') {
            i += 2;
            continue;
        }
        /* E. 搬走第一个路径段（含前导 '/'，不含下一个 '/'） */
        {
            int k = (p[0] == '/') ? 1 : 0;

            while (k < rem && p[k] != '/')
                k++;
            if (url_put(dst, cap, &o, (char[:]){ p, k }) < 0)
                return -1;
            i += k;
        }
    }
    return o;
}

/* 把 base 与 ref 拼成绝对 URL，写调用方缓冲。
 *
 * 完全照 RFC 3986 §5.2.2 的伪代码：ref 有 scheme 就整体替换，否则按
 * authority / path / query 三个分支走 §5.2.3 的合并与 §5.2.4 的去点。
 *
 * 结果先在栈上的一块缓冲里拼好，**最后一步才写 dst**：这样「放不下」返回 -1
 * 时调用方的缓冲一个字节都没动（自测里用填了哨兵的缓冲钉住）。
 * 返回长度；放不下或 base/ref 解析失败返回 -1。
 */
int url_resolve(char[:] base, char[:] ref, char *dst, int cap)
{
    Url b = url_parse(base);
    Url r = url_parse(ref);
    int maxlen = base.len + ref.len + 8;
    char acc[maxlen];
    char tmp[maxlen];
    int o = 0;
    int m = 0;

    if (!b.ok || !r.ok || dst == 0 || cap < 0 || maxlen <= 8)
        return -1;

    /* ---- scheme + authority ---- */
    if (r.is_abs) {
        if (url_put(acc, maxlen, &o, r.scheme.s) < 0)
            return -1;
        if (url_put_c(acc, maxlen, &o, ':') < 0)
            return -1;
        if (r.has_authority) {
            if (url_put(acc, maxlen, &o, (char[:]){ (char *)"//", 2 }) < 0)
                return -1;
            if (url_put_authority(&r, acc, maxlen, &o) < 0)
                return -1;
        }
    } else {
        if (url_put(acc, maxlen, &o, b.scheme.s) < 0)
            return -1;
        if (url_put_c(acc, maxlen, &o, ':') < 0)
            return -1;
        if (r.has_authority) {
            if (url_put(acc, maxlen, &o, (char[:]){ (char *)"//", 2 }) < 0)
                return -1;
            if (url_put_authority(&r, acc, maxlen, &o) < 0)
                return -1;
        } else if (b.has_authority) {
            if (url_put(acc, maxlen, &o, (char[:]){ (char *)"//", 2 }) < 0)
                return -1;
            if (url_put_host_port(&b, acc, maxlen, &o) < 0)
                return -1;
        }
    }

    /* ---- path（§5.2.3 + §5.2.4） ---- */
    if (r.is_abs || r.has_authority) {
        m = url_remove_dots(r.path.s, tmp, maxlen);
    } else if (r.path.s.len == 0) {
        m = url_remove_dots(b.path.s, tmp, maxlen);   /* 继承 base 的路径 */
    } else if (r.path.s.data[0] == '/') {
        m = url_remove_dots(r.path.s, tmp, maxlen);
    } else {
        /* 合并：base 路径去掉最后一段，接上 ref 路径 */
        int cut = -1;
        int i = 0;
        char merged[maxlen];
        int k = 0;

        if (b.has_authority && b.path.s.len == 0) {
            merged[0] = '/';                    /* §5.2.3 第一条：补一个根 */
            k = 1;
        } else {
            for (i = 0; i < b.path.s.len; i++)
                if (b.path.s.data[i] == '/')
                    cut = i;
            k = (cut < 0) ? 0 : cut + 1;
            if (k > 0)
                memcpy(merged, b.path.s.data, (size_t)k);
        }
        if (k + r.path.s.len > maxlen)
            return -1;
        if (r.path.s.len > 0)
            memcpy(merged + k, r.path.s.data, (size_t)r.path.s.len);
        m = url_remove_dots((char[:]){ merged, k + r.path.s.len }, tmp, maxlen);
    }
    if (m < 0)
        return -1;
    if (m > 0)
        if (url_put(acc, maxlen, &o, (char[:]){ tmp, m }) < 0)
            return -1;

    /* ---- query：ref 有就用 ref 的，否则空路径时继承 base 的 ---- */
    if (r.query.s.len > 0) {
        if (url_put_c(acc, maxlen, &o, '?') < 0)
            return -1;
        if (url_put(acc, maxlen, &o, r.query.s) < 0)
            return -1;
    } else if (r.path.s.len == 0 && !r.is_abs && !r.has_authority
               && b.query.s.len > 0) {
        if (url_put_c(acc, maxlen, &o, '?') < 0)
            return -1;
        if (url_put(acc, maxlen, &o, b.query.s) < 0)
            return -1;
    }

    /* ---- fragment ---- */
    if (r.fragment.s.len > 0) {
        if (url_put_c(acc, maxlen, &o, '#') < 0)
            return -1;
        if (url_put(acc, maxlen, &o, r.fragment.s) < 0)
            return -1;
    }

    /* ---- 最后一刻才碰 dst ---- */
    if (o > cap)
        return -1;
    if (o > 0)
        memcpy(dst, acc, (size_t)o);
    return o;
}

/* ---- 自测 ---- */

/* 比较 Str 与 C 字面量：长度相同且逐字节相同 */
static int url_eq(Str *s, char *lit)
{
    int n = (int)strlen(lit);

    return s->s.len == n && (n == 0 || !memcmp(s->s.data, lit, (size_t)n));
}

/* 空视图：没出现的组件 */
static int url_empty(Str *s) { return s->s.len == 0 && s->s.data == 0; }

test "RFC 3986 第 1.1.2 节的示例 URL 分解" {
    Url u = url_parse(S("foo://example.com:8042/over/there?name=ferret#nose"));
    Url v = url_parse(S("urn:example:animal:ferret:nose"));
    Url w = url_parse(S("mailto:John.Doe@example.com"));

    if (!u.ok || !url_eq(&u.scheme, "foo") || !url_eq(&u.host, "example.com")
        || u.port != 8042 || !url_eq(&u.path, "/over/there")
        || !url_eq(&u.query, "name=ferret") || !url_eq(&u.fragment, "nose"))
        return err(1, "foo:// 那个例子分解不对");
    if (!url_is_absolute(&u) || !url_has_host(&u))
        return err(2, "foo:// 应当是绝对引用且有主机");
    /* urn: 有 scheme、没有 authority */
    if (!v.ok || !url_eq(&v.scheme, "urn") || v.has_authority
        || !url_eq(&v.path, "example:animal:ferret:nose"))
        return err(3, "urn: 分解不对");
    if (!w.ok || !url_eq(&w.scheme, "mailto")
        || !url_eq(&w.path, "John.Doe@example.com"))
        return err(4, "mailto: 分解不对");
    if (!url_empty(&w.host) || !url_empty(&w.userinfo))
        return err(5, "没有 authority 时主机应当是空视图");
    if (w.port != -1)
        return err(6, "没有端口时 port 应当是 -1");
}

test "相对引用与空组件" {
    Url a = url_parse(S("//example.com/x"));
    Url b = url_parse(S("/just/a/path"));
    Url c = url_parse(S("a/b"));
    Url d = url_parse(S(""));

    if (!a.ok || a.is_abs || !a.has_authority || !url_eq(&a.host, "example.com")
        || !url_eq(&a.path, "/x"))
        return err(7, "网络路径引用分解不对");
    if (b.is_abs || b.has_authority || !url_eq(&b.path, "/just/a/path"))
        return err(8, "绝对路径引用分解不对");
    if (c.is_abs || !url_eq(&c.path, "a/b"))
        return err(9, "相对路径引用分解不对");
    if (!d.ok || d.is_abs || d.has_authority || d.path.s.len != 0)
        return err(10, "空串应当解析成空引用");
}

test "authority 的 userinfo、IPv6 与端口" {
    Url u = url_parse(S("http://user:pw@host.example:8080/p"));
    Url v6 = url_parse(S("http://[::1]:9090/x"));
    Url v6b = url_parse(S("http://[2001:db8::1]/x"));
    Url nohost = url_parse(S("http://example.com/p"));

    if (!u.ok || !url_eq(&u.userinfo, "user:pw") || !url_eq(&u.host, "host.example")
        || u.port != 8080)
        return err(11, "userinfo/端口分解不对");
    if (!v6.ok || !url_eq(&v6.host, "[::1]") || v6.port != 9090)
        return err(12, "IPv6 字面量的冒号被当成了端口分隔符");
    if (!v6b.ok || !url_eq(&v6b.host, "[2001:db8::1]") || v6b.port != -1)
        return err(13, "不带端口的 IPv6 分解不对");
    if (!nohost.ok || nohost.port != -1)
        return err(14, "没有冒号的主机不该给出端口");
}

test "非法端口让 ok 为 0 但保留原文" {
    Url a = url_parse(S("http://h:0x10/"));
    Url b = url_parse(S("http://h:70000/"));
    Url c = url_parse(S("http://h:/"));
    Url d = url_parse(S("http://h:65535/"));

    if (a.ok || b.ok || c.ok)
        return err(15, "非法端口没有让 ok 为 0");
    if (!url_eq(&b.port_str, "70000"))
        return err(16, "非法端口的原文没保留");
    if (!d.ok || d.port != 65535)
        return err(17, "65535 是合法端口");
}

test "默认端口按 scheme 给" {
    Url a = url_parse(S("http://h/"));
    Url b = url_parse(S("https://h/"));
    Url c = url_parse(S("ftp://h/"));
    Url d = url_parse(S("telnet://h/"));
    Url e = url_parse(S("ws://h/"));
    Url f = url_parse(S("http://h:81/"));

    if (url_effective_port(&a) != 80 || url_effective_port(&b) != 443)
        return err(18, "http/https 默认端口不对");
    if (url_effective_port(&c) != 21 || url_effective_port(&d) != 23)
        return err(19, "ftp/telnet 默认端口不对");
    if (url_effective_port(&e) != -1)
        return err(20, "未知 scheme 应当给 -1");
    if (url_effective_port(&f) != 81)
        return err(21, "显式端口应当优先");
    /* 全零初始化（C 的自然写法）不能被当成「显式端口 0」 */
    {
        Url z = { 0 };

        if (url_effective_port(&z) != -1)
            return err(22, "全零初始化的 URL 不该给出端口");
        Url z0 = url_parse(S("http://h:0/"));

        if (z0.port != 0 || url_effective_port(&z0) != 0)
            return err(23, "显式 :0 应当就是 0 端口");
    }
}

test "查询参数逐个取出" {
    Str q = { S("a=1&b=2&novalue&c=") };
    Pair p = { { { (char *)0, 0 } }, { { (char *)0, 0 } } };
    int at = 0;
    int n = 0;

    if (!url_next_pair(&q, &at, &p) || !url_eq(&p.key, "a")
        || !url_eq(&p.value, "1"))
        return err(22, "第一个参数不对");
    n++;
    if (!url_next_pair(&q, &at, &p) || !url_eq(&p.key, "b")
        || !url_eq(&p.value, "2"))
        return err(23, "第二个参数不对");
    n++;
    if (!url_next_pair(&q, &at, &p) || !url_eq(&p.key, "novalue")
        || p.value.s.len != 0)
        return err(24, "没有 = 的参数应当给空值");
    n++;
    if (!url_next_pair(&q, &at, &p) || !url_eq(&p.key, "c")
        || p.value.s.len != 0)
        return err(25, "空值参数不对");
    n++;
    if (url_next_pair(&q, &at, &p))
        return err(26, "参数取完之后应当返回 0");
    if (n != 4)
        return err(27, "参数个数不对");
}

test "百分号编码：reserved 与 unreserved 的边界" {
    char buf[64] = { 0 };
    char small[4] = { 'Z', 'Z', 'Z', 0 };

    if (url_encode(S("a b/c?d"), buf, sizeof buf) != 11
        || strcmp(buf, "a%20b/c%3Fd") != 0)
        return err(28, "url_encode 不该转义 '/'");
    memset(buf, 0, sizeof buf);        /* 编码不写 NUL，比之前先清尾巴 */
    if (url_encode_component(S("a b/c"), buf, sizeof buf) != 9
        || strcmp(buf, "a%20b%2Fc") != 0)
        return err(29, "url_encode_component 应当转义 '/'");
    memset(buf, 0, sizeof buf);
    if (url_encode(S("a-z.A_Z~9"), buf, sizeof buf) != 9
        || strcmp(buf, "a-z.A_Z~9") != 0)
        return err(30, "unreserved 不该被转义");
    memset(buf, 0, sizeof buf);
    if (url_encode(S("\xe4\xb8\xad"), buf, sizeof buf) != 9
        || strcmp(buf, "%E4%B8%AD") != 0)
        return err(31, "多字节字符应当逐字节转义");
    if (url_encode(S("a b"), small, 3) != -1 || small[0] != 'Z')
        return err(32, "放不下时应当 -1 且不写");
    if (url_encoded_len(S("a b"), (char *)"/") != 5)
        return err(33, "encoded_len 不对");
}

test "百分号解码：非法转义原样保留、'+' 可选" {
    char buf[32] = { 0 };

    memset(buf, 0, sizeof buf);
    if (url_decode(S("a%20b%2Fc"), buf, sizeof buf) != 5
        || strcmp(buf, "a b/c") != 0)
        return err(34, "百分号解码不对");
    memset(buf, 0, sizeof buf);
    if (url_decode(S("%41%42"), buf, sizeof buf) != 2
        || memcmp(buf, "AB", 2) != 0)
        return err(35, "大写十六进制解码不对");
    memset(buf, 0, sizeof buf);
    if (url_decode(S("%e4%b8%ad"), buf, sizeof buf) != 3
        || (u8)buf[0] != 0xe4 || (u8)buf[2] != 0xad)
        return err(36, "多字节解码不对");
    memset(buf, 0, sizeof buf);
    if (url_decode(S("100%"), buf, sizeof buf) != 4 || strcmp(buf, "100%") != 0)
        return err(37, "孤立的 % 应当原样保留");
    memset(buf, 0, sizeof buf);
    if (url_decode(S("%zz"), buf, sizeof buf) != 3 || strcmp(buf, "%zz") != 0)
        return err(38, "非法转义应当原样保留");
    memset(buf, 0, sizeof buf);
    if (url_decode(S("a+b"), buf, sizeof buf) != 3 || strcmp(buf, "a+b") != 0)
        return err(39, "plus = 0 时 + 不该变空格");
    if (url_decode_at(S("a+b"), buf, sizeof buf, 1) != 3
        || strcmp(buf, "a b") != 0)
        return err(40, "plus = 1 时 + 应当变空格");
    if (url_decoded_len(S("%zz")) != 3 || url_decoded_len(S("%41")) != 1)
        return err(41, "decoded_len 不对");
    /* 往返 */
    if (url_encode(S("a b/c?d=e&f#g"), buf, sizeof buf) != 23)
        return err(42, "编码长度不对");
    {
        char back[32] = { 0 };

        if (url_decode((char[:]){ buf, (int)strlen(buf) }, back, sizeof back)
                != 13
            || strcmp(back, "a b/c?d=e&f#g") != 0)
            return err(43, "编码再解码没还原");
    }
}

/* 相对解析的一条用例：base、ref、期望结果 */
struct RcCase {
    char *base;
    char *ref;
    char *want;
};

test "RFC 3986 §5.4 的相对解析（normal + abnormal）" {
    RcCase cs[23] = {
        { (char *)"http://a/b/c/d;p?q", (char *)"g:h", (char *)"g:h" },
        { (char *)"http://a/b/c/d;p?q", (char *)"g", (char *)"http://a/b/c/g" },
        { (char *)"http://a/b/c/d;p?q", (char *)"./g", (char *)"http://a/b/c/g" },
        { (char *)"http://a/b/c/d;p?q", (char *)"g/", (char *)"http://a/b/c/g/" },
        { (char *)"http://a/b/c/d;p?q", (char *)"/g", (char *)"http://a/g" },
        { (char *)"http://a/b/c/d;p?q", (char *)"//g", (char *)"http://g" },
        { (char *)"http://a/b/c/d;p?q", (char *)"?y", (char *)"http://a/b/c/d;p?y" },
        { (char *)"http://a/b/c/d;p?q", (char *)"g?y", (char *)"http://a/b/c/g?y" },
        { (char *)"http://a/b/c/d;p?q", (char *)"#s", (char *)"http://a/b/c/d;p?q#s" },
        { (char *)"http://a/b/c/d;p?q", (char *)"g#s", (char *)"http://a/b/c/g#s" },
        { (char *)"http://a/b/c/d;p?q", (char *)";x", (char *)"http://a/b/c/;x" },
        { (char *)"http://a/b/c/d;p?q", (char *)"", (char *)"http://a/b/c/d;p?q" },
        { (char *)"http://a/b/c/d;p?q", (char *)".", (char *)"http://a/b/c/" },
        { (char *)"http://a/b/c/d;p?q", (char *)"./", (char *)"http://a/b/c/" },
        { (char *)"http://a/b/c/d;p?q", (char *)"..", (char *)"http://a/b/" },
        { (char *)"http://a/b/c/d;p?q", (char *)"../", (char *)"http://a/b/" },
        { (char *)"http://a/b/c/d;p?q", (char *)"../g", (char *)"http://a/b/g" },
        { (char *)"http://a/b/c/d;p?q", (char *)"../../../g", (char *)"http://a/g" },
        { (char *)"http://a/b/c/d;p?q", (char *)"/./g", (char *)"http://a/g" },
        { (char *)"http://a/b/c/d;p?q", (char *)"g/../h", (char *)"http://a/b/c/h" },
        { (char *)"http://a/b/c/d;p?q", (char *)"g;x=1/../y", (char *)"http://a/b/c/y" },
        { (char *)"http://a/b/c/d;p?q", (char *)"../..//g", (char *)"http://a//g" },
        { (char *)"http://a/b/c/d;p?q", (char *)"g?y/./x", (char *)"http://a/b/c/g?y/./x" },
    };
    char buf[128] = { 0 };
    int i = 0;
    int n = 0;
    int bad = 0;

    for (i = 0; i < 23; i++) {
        memset(buf, 0, sizeof buf);
        n = url_resolve((char[:]){ cs[i].base, (int)strlen(cs[i].base) },
                        (char[:]){ cs[i].ref, (int)strlen(cs[i].ref) },
                        buf, sizeof buf);
        if (n < 0 || strcmp(buf, cs[i].want) != 0) {
            printf("case %d: ref='%s' got='%s' want='%s'\n", i, cs[i].ref,
                   n < 0 ? "<-1>" : buf, cs[i].want);
            bad++;
        }
    }
    if (bad)
        return err(44, "相对解析与 RFC 3986 用例不符");
}

test "相对解析：放不下与非法 base" {
    char buf[64] = { 0 };
    char small[4] = { 'Z', 'Z', 'Z', 0 };

    {
        char tiny[8] = { 0 };

        /* "http://a/b/d/e/f" 是 16 字节，8 格装不下 */
        if (url_resolve(S("http://a/b/c"), S("d/e/f"), tiny, sizeof tiny) != -1)
            return err(45, "放不下时应当 -1");
        if (tiny[0] != 0)
            return err(45, "放不下时不该写");
    }
    if (url_resolve(S("http://a/b/c"), S("d"), small, sizeof small) != -1
        || small[0] != 'Z')
        return err(46, "放不下时不该写");
    if (url_resolve(S("http://h:bad/"), S("x"), buf, sizeof buf) != -1)
        return err(47, "非法 base 应当 -1");
    memset(buf, 0, sizeof buf);
    if (url_resolve(S("https://h/a/"), S("/b?q#f"), buf, sizeof buf) != 15
        || strcmp(buf, "https://h/b?q#f") != 0)
        return err(48, "绝对路径 + query + fragment 组合不对");
}
