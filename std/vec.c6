/* std/vec：可增长数组 Vect@T。
 *
 *     import std.vec;
 *
 *     @Vect@int v = new Vect@int;
 *     v->push(10) catch e { return e.id; };
 *     foreach (int x = v->iter()) { printf("%d\n", x); }
 *
 * 设计要点：
 * - 元素放在一段托管数组 `@T data` 里（`new T[cap]` 返回的就是 `@T`），所以
 *   整个向量由 GC 管理，不需要手写释放；
 * - 因为字段里有托管引用，Vect 不能按值声明，只能 `new` 出来用 `@T` 持有；
 *   方法的接收者是指针，所以值容器调用要写 `v->count()`；
 * - 方法名不能与字段同名：字段是 `n` / `cap`，访问器是 `count()` / `capacity()`；
 * - `push` / `reserve` 会分配，失败时返回 `T!error`，调用方必须 `try` 或
 *   `catch` 消费结果；
 * - `at` 要求下标在范围内（越界是调用方的错）；要检查就读 `get(i, &out)`。
 */
#include <string.h>
#include <stdlib.h>

module std.vec;
import std.types;
import std.err;
import std.sort;

struct Vect@T {
    @T data;
    int n;
    int cap;

    /* 元素个数 */
    int count() { return n; }

    /* 已分配容量 */
    int capacity() { return cap; }

    int is_empty() { return n == 0; }

    /* 下标访问：要求 0 <= i < count() */
    T at(int i) { return data[i]; }

    /* 带检查的读：命中返回 1 并写 *out */
    int get(int i, T *out)
    {
        if (!data || i < 0 || i >= n)
            return 0;
        *out = data[i];
        return 1;
    }

    void set(int i, T v)
    {
        if (data && i >= 0 && i < n)
            data[i] = v;
    }

    /* 预留容量；cap 只增不减 */
    int!error reserve(int want)
    {
        int newcap = cap > 0 ? cap : 8;
        @T nd = data;
        int i = 0;

        if (want <= cap)
            return 0;
        while (newcap < want)
            newcap *= 2;
        nd = new T[newcap];
        if (!nd)
            return err(std.err.NOMEM, "vector: out of memory");
        for (i = 0; i < n; i++)
            nd[i] = data[i];
        data = nd;
        cap = newcap;
        return 0;
    }

    /* 追加一个元素，必要时扩容 */
    int!error push(T v)
    {
        try reserve(n + 1);   /* 原样转发 */
        data[n] = v;
        n++;
        return 0;
    }

    /* 末尾元素出栈：成功返回 1 并写 *out，空容器返回 0 */
    int pop(T *out)
    {
        if (n == 0)
            return 0;
        n--;
        *out = data[n];
        return 1;
    }

    void clear() { n = 0; }

    /* 首个 / 末个元素：空容器返回 0（不写 *out） */
    int first(T *out)
    {
        if (n == 0)
            return 0;
        *out = data[0];
        return 1;
    }

    int last(T *out)
    {
        if (n == 0)
            return 0;
        *out = data[n - 1];
        return 1;
    }

    /* 按字节相等线性查找：命中返回下标，否则 -1。
       元素里有指针/填充字节时要求两个相等的值逐字节相同（和 std.map 的键一个要求）。 */
    int index_of(T v)
    {
        int i = 0;

        for (i = 0; i < n; i++)
            if (!memcmp(&data[i], &v, sizeof(T)))
                return i;
        return -1;
    }

    int contains(T v) { return index_of(v) >= 0; }

    /* 在下标 i 处插入：i 可以等于 count()（等价于 push）；插入需要空间，会失败 */
    int!error insert(int i, T v)
    {
        int j = 0;

        if (i < 0 || i > n)
            return err(std.err.RANGE, "vector: insert out of range");
        try reserve(n + 1);   /* 原样转发 */
        for (j = n; j > i; j--)
            data[j] = data[j - 1];
        data[i] = v;
        n++;
        return 0;
    }

    /* 删除下标 i：返回 1；越界返回 0（不做事） */
    int remove_at(int i)
    {
        int j = 0;

        if (i < 0 || i >= n)
            return 0;
        for (j = i; j + 1 < n; j++)
            data[j] = data[j + 1];
        n--;
        return 1;
    }

    /* 只保留前 k 个（k 为负当 0，超过 count() 不做事）；容量保留 */
    void truncate(int k)
    {
        if (k < 0)
            k = 0;
        if (k < n)
            n = k;
    }

    /* 原地反转 */
    void reverse()
    {
        int i = 0, j = n - 1;

        while (i < j) {
            T t = data[i];

            data[i] = data[j];
            data[j] = t;
            i++;
            j--;
        }
    }

    /* 当前内容（不含未用容量）的切片；只读它，别拿它扩容后继续用 */
    T[:] slice() { return (T[:]){ data, n }; }

    /* 追加整段：够快、不需要先手写循环，空间不够会失败 */
    int!error extend(T[:] more)
    {
        int i = 0;

        try reserve(n + more.len);   /* 原样转发 */
        for (i = 0; i < more.len; i++)
            data[n + i] = more[i];
        n += more.len;
        return 0;
    }

    /* 迭代器：随实例生成，`foreach (T x = v->iter()) { ... }` 直接可用 */
    Iter@T iter()
    {
        Iter@T it = { self, 0 };
        return it;
    }

    /* 原地排序：cmp 是 `int f(const void *, const void *)` 风格的比较器，
       返回 <0 / 0 / >0。元素必须是 POD（按字节搬）。返回 0 成功、-1 失败。
       c6 没有泛型函数指针，所以比较器用 C 函数指针；最常用的是
       `v->sort(&cmp_int)`。要排序别的东西就自己写一个同签名的。 */
    int sort(int (*cmp)(const void *, const void *))
    {
        return sort_bytes(data, n, sizeof(T), cmp);
    }

    /* 原地排序，按字节序（memcmp）：整数/字符这类纯小端数够用，
       负数会排在正数后面（按字节比较的结果），要正确的整数序请用 cmp_int。 */
    int sort_lex(void)
    {
        return sort_bytes(data, n, sizeof(T), cmp_mem4);
    }

    /* 对每个元素调一次 f（f 返回非 0 时提前停下，返回已处理的个数） */
    int each(int (*f)(T v))
    {
        int i = 0;

        for (i = 0; i < n; i++)
            if (f(data[i]))
                return i + 1;
        return n;
    }

    /* 只留满足 keep 的元素（原地压缩），返回留下的个数 */
    int filter(int (*keep)(T v))
    {
        int i = 0, k = 0;

        for (i = 0; i < n; i++)
            if (keep(data[i]))
                data[k++] = data[i];
        n = k;
        return k;
    }

    /* 二元归约：acc = acc op data[i]，从左往右；n 为 0 时返回 init */
    T fold(T init, T (*op)(T acc, T v))
    {
        T acc = init;
        int i = 0;

        for (i = 0; i < n; i++)
            acc = op(acc, data[i]);
        return acc;
    }
};

struct Iter@T {
    Vect@T *vec;
    int i;

    int has() { return i < vec->n; }

    T next()
    {
        T x = vec->data[i];
        i++;
        return x;
    }
};

/* ---- 自测 ---- */

test "push / at / count / pop" {
    @Vect@int v = new Vect@int;
    int out = 0;

    v->push(10) catch e { return err(1, "push 失败"); };
    v->push(20) catch e { return err(2, "push 失败"); };
    if (v->count() != 2)
        return err(3, "count 不对");
    if (v->at(1) != 20)
        return err(4, "at 不对");
    if (v->get(1, &out) != 1 || out != 20)
        return err(5, "get 不对");
    if (v->get(2, &out) != 0)
        return err(6, "get 越界没有返回 0");
    if (v->pop(&out) != 1 || out != 20 || v->count() != 1)
        return err(7, "pop 不对");
    if (v->pop(&out) != 1 || out != 10)
        return err(8, "第二次 pop 不对");
    if (v->pop(&out) != 0)
        return err(9, "空容器 pop 没有返回 0");
}

test "扩容后元素仍在，容量按 2 倍增长" {
    @Vect@int v = new Vect@int;
    int i = 0;

    for (i = 0; i < 100; i++)
        v->push(i) catch e { return err(10, "push 失败"); };
    if (v->count() != 100)
        return err(11, "count 不是 100");
    if (v->capacity() < 100)
        return err(12, "容量不够");
    for (i = 0; i < 100; i++)
        if (v->at(i) != i)
            return err(13, "扩容后元素顺序不对");
}

test "foreach 走迭代器" {
    @Vect@int v = new Vect@int;
    int sum = 0;

    v->push(1) catch e { return err(14, "push 失败"); };
    v->push(2) catch e { return err(15, "push 失败"); };
    v->push(3) catch e { return err(16, "push 失败"); };
    foreach (int x = v->iter()) {
        sum += x;
    }
    if (sum != 6)
        return err(17, "迭代和不对");
}

test "clear 只清零长度，容量保留" {
    @Vect@int v = new Vect@int;
    int cap0 = 0;

    v->push(1) catch e { return err(18, "push 失败"); };
    cap0 = v->capacity();
    v->clear();
    if (v->count() != 0)
        return err(19, "clear 之后 count 不为 0");
    if (v->capacity() != cap0)
        return err(20, "clear 把容量也丢了");
    if (v->is_empty() != 1)
        return err(21, "is_empty 不对");
}

test "元素类型不限于整数" {
    @Vect@f64 v = new Vect@f64;
    f64 sum = 0.0;

    v->push(0.5) catch e { return err(22, "push 失败"); };
    v->push(1.25) catch e { return err(23, "push 失败"); };
    foreach (f64 x = v->iter()) {
        sum += x;
    }
    if (sum != 1.75)
        return err(24, "f64 元素的不对");
}

test "insert / remove_at / truncate" {
    @Vect@int v = new Vect@int;
    int i = 0;

    for (i = 0; i < 3; i++)
        v->push(i) catch e { return err(25, "push 失败"); };
    v->insert(1, 99) catch e { return err(26, "insert 失败"); };
    if (v->count() != 4)
        return err(27, "insert 之后 count 不对");
    if (v->at(0) != 0 || v->at(1) != 99 || v->at(2) != 1 || v->at(3) != 2)
        return err(28, "insert 的位置不对");
    v->insert(4, 7) catch e { return err(29, "尾部 insert 失败"); };
    if (v->at(4) != 7)
        return err(30, "尾插等价于 push");
    if (v->remove_at(1) != 1 || v->count() != 4)
        return err(31, "remove_at 没删掉");
    if (v->at(1) != 1 || v->at(3) != 7)
        return err(32, "remove_at 之后的顺序不对");
    if (v->remove_at(4) != 0)
        return err(33, "越界 remove_at 应返回 0");
    v->truncate(2);
    if (v->count() != 2 || v->at(0) != 0 || v->at(1) != 1)
        return err(34, "truncate 不对");
    v->truncate(99);
    if (v->count() != 2)
        return err(35, "truncate 到更大值不该长");
}

test "first / last / index_of / contains" {
    @Vect@int v = new Vect@int;
    int out = 0;

    if (v->first(&out) != 0 || v->last(&out) != 0)
        return err(36, "空容器 first/last 应返回 0");
    v->push(10) catch e { return err(37, "push 失败"); };
    v->push(20) catch e { return err(38, "push 失败"); };
    v->push(10) catch e { return err(39, "push 失败"); };
    if (v->first(&out) != 1 || out != 10)
        return err(40, "first 不对");
    if (v->last(&out) != 1 || out != 10)
        return err(41, "last 不对");
    if (v->index_of(20) != 1 || v->index_of(10) != 0)
        return err(42, "index_of 不对");
    if (v->index_of(99) != -1)
        return err(43, "找不到应返回 -1");
    if (v->contains(20) != 1 || v->contains(99) != 0)
        return err(44, "contains 不对");
}

test "reverse / slice / extend" {
    @Vect@int v = new Vect@int;
    @Vect@int w = new Vect@int;
    int i = 0;

    for (i = 0; i < 3; i++)
        v->push(i + 1) catch e { return err(45, "push 失败"); };
    v->reverse();
    if (v->at(0) != 3 || v->at(1) != 2 || v->at(2) != 1)
        return err(46, "reverse 不对");
    {
        int[:] s = v->slice();

        if (s.len != 3 || s.data[0] != 3)
            return err(47, "slice 不对");
    }
    w->push(7) catch e { return err(48, "push 失败"); };
    w->push(8) catch e { return err(49, "push 失败"); };
    v->extend(w->slice()) catch e { return err(50, "extend 失败"); };
    if (v->count() != 5 || v->at(3) != 7 || v->at(4) != 8)
        return err(51, "extend 之后内容不对");
}

/* 自测用的回调：c6 没有闭包，所以 each/filter/fold 的实参用文件作用域函数 */
static int is_even(int v) { return v % 2 == 0; }

static int stop_at5(int v) { return v >= 5; }

static int add2(int acc, int v) { return acc + v; }

test "sort / sort_lex" {
    @Vect@int v = new Vect@int;
    int i = 0;

    v->push(5) catch e { return err(52, "push 失败"); };
    v->push(2) catch e { return err(53, "push 失败"); };
    v->push(9) catch e { return err(54, "push 失败"); };
    v->push(1) catch e { return err(55, "push 失败"); };
    v->push(7) catch e { return err(56, "push 失败"); };
    v->push(3) catch e { return err(57, "push 失败"); };
    if (v->sort(&cmp_int) != 0)
        return err(58, "sort 失败");
    for (i = 1; i < 6; i++)
        if (v->at(i - 1) > v->at(i))
            return err(59, "sort 之后没排好");
    if (v->at(0) != 1 || v->at(5) != 9)
        return err(60, "sort 结果不对");
}

test "each / filter / fold" {
    @Vect@int v = new Vect@int;
    @Vect@int w = new Vect@int;
    int seen = 0, left = 0, sum = 0;

    v->push(1) catch e { return err(61, "push 失败"); };
    v->push(2) catch e { return err(62, "push 失败"); };
    v->push(3) catch e { return err(63, "push 失败"); };
    v->push(4) catch e { return err(64, "push 失败"); };
    seen = v->each(&stop_at5);
    if (seen == 0)
        return err(65, "each 没生效");
    sum = v->fold(0, &add2);
    if (sum != 10)
        return err(66, "fold 求和不对");
    w->push(1) catch e { return err(67, "push 失败"); };
    w->push(2) catch e { return err(68, "push 失败"); };
    w->push(3) catch e { return err(69, "push 失败"); };
    w->push(4) catch e { return err(70, "push 失败"); };
    left = w->filter(&is_even);
    if (left != 2 || w->count() != 2)
        return err(71, "filter 留下的个数不对");
    if (w->at(0) != 2 || w->at(1) != 4)
        return err(72, "filter 结果不对");
}
