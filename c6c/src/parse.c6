         * 内核对它的用法（include/linux/compiler.h:386 的 sign-选择）两支都
         * 是纯值表达式，所以"两支都生成、丢掉没选中的"在正确性上没问题；
         * 这条注释先把这个限制写明，真要支持带副作用的未选支再补跳过逻辑。 */
        i64 c = 0;
        u32 va = 0;
        u32 ta = 0;
        u32 vb = 0;
        u32 tb = 0;

        pa_advance();
        pa_expect_ch('(');
        c = const_expr();
        pa_expect_ch(',');
        va = value_of(gen_assign());
        ta = GEN_TY;
        pa_expect_ch(',');
        vb = value_of(gen_assign());
        tb = GEN_TY;
        pa_expect_ch(')');
        if (c) {
            GEN_TY = ta;
            return gen_postfix_ops(va);
        }
        GEN_TY = tb;
        return gen_postfix_ops(vb);
    }
    if (TOK_EQ(t, "__builtin_extract_return_addr")) {
        /* `__builtin_extract_return_addr(p)`：把 return_address 给的值还原成
         * 真实地址。x86-64 上编译器已经返回真实地址，这里就是恒等。
         * 内核 lib/vsprintf.c:993 的 %pS 打印要用。 */
        u32 a = 0;

        pa_advance();
        pa_expect_ch('(');
        a = value_of(gen_assign());
        pa_expect_ch(')');
        GEN_TY = ty_ulong();
        return gen_postfix_ops(a);
    }
    if (TOK_EQ(t, "__builtin_prefetch")) {
        /* `__builtin_prefetch(addr[, rw[, locality]])`：纯提示，没有语义。
         * 内核 include/linux/prefetch.h 的 prefetch()/prefetchw() 就是它。
         * 实参照常求值（副作用要保留），然后整条丢掉、值给 0。 */
        u32 d = 0;

        pa_advance();
        pa_expect_ch('(');
        while (!pa_is_ch(')') && pa_cur()->kind != TK_EOF) {
            (void)value_of(gen_assign());
            if (!pa_accept_ch(','))
                break;
        }
        pa_expect_ch(')');
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, 0);
        GEN_TY = ty_int();
        return gen_postfix_ops(d);
    }
    if (TOK_EQ(t, "__builtin_return_address")
        || TOK_EQ(t, "__builtin_frame_address")) {
        /* `__builtin_return_address(N)` / `__builtin_frame_address(N)`。
         *
         * 内核 include/linux/instruction_pointer.h 的 _RET_IP_ 就是
         * `(unsigned long)__builtin_return_address(0)`，而 _RET_IP_ 被
         * lockdep / tracing / printk 的 %pS 一路用下来。
         *
         * **当前实现返回 0**。IR 里没有"读寄存器"的算子（rbp/rsp 只在
         * IR_ALLOCA/IR_SETRSP 里被间接摆弄），而为了这一条内建函数给三个
         * 后端各加一个新 op 不划算。语义上这会让同一函数里的 _RET_IP_ 全部
         * 相等——编译期能过，运行期只在调试/追踪路径上失真。
         * 真要支持，得先有 IR_FRAME（读 rbp）这个算子。 */
        u32 d0 = 0;

        pa_advance();
        pa_expect_ch('(');
        if (pa_cur()->kind == TK_NUM)
            pa_advance();
        pa_expect_ch(')');
        d0 = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, d0, 0, 0, 0, 0);
        GEN_TY = ty_ulong();
        return gen_postfix_ops(d0);
    }
    if (TOK_EQ(t, "__builtin_memcpy") || TOK_EQ(t, "__builtin_memmove")
        || TOK_EQ(t, "__builtin_memset")) {
        /* `__builtin_memcpy/memmove/memset`：**内建**，不需要先有声明。
         *
         * c6c 以前在预定义宏表里写 `#define __builtin_memcpy(a,b,c) memcpy(a,b,c)`，
         * 把它文本替换成一次普通调用——于是 TU 里没先声明过 memcpy 的地方就报
         * "未声明的标识符 'memcpy'"。内核 include/vdso/unaligned.h:37 的
         * get_unaligned() 正是这种情形：它在 GNU 语句表达式里直接用
         * __builtin_memcpy（lib/xxhash.c、lib/hexdump.c、lib/test_rhashtable.c
         * 各刷 3 条）。
         *
         * 实现就是"隐式声明 + 普通调用"：按名字去符号表找，找不到就现造一个
         * extern 函数符号（real 编译器对内建正是这么做的），然后发 IR_CALL。
         * 目标符号按名字解析（见 addr_sym_of），所以别的 TU 里定义也能连上。
         */
        int is_set = TOK_EQ(t, "__builtin_memset");
        const char *nm = is_set ? "memset"
                         : TOK_EQ(t, "__builtin_memmove") ? "memmove" : "memcpy";
        u32 nlen = (u32)strlen(nm);
        u32 a[3] = {0};
        u32 na = 0;
        u32 i = 0;
        Sym *fs = sym_find(nm, nlen);

        pa_advance();
        pa_expect_ch('(');
        for (;;) {
            a[na] = value_of(gen_assign());
            na++;
            if (!pa_accept_ch(',') || na >= 3) {
                while (pa_accept_ch(','))
                    (void)value_of(gen_assign());   /* 多余的实参照吃 */
                break;
            }
        }
        pa_expect_ch(')');
        if (!fs || !fs->is_func) {
            u32 params[3] = {0};

            params[0] = ty_ptr(ty_void());
            params[1] = is_set ? ty_int() : ty_ptr(ty_void());
            params[2] = ty_ulong();
            fs = sym_add(nm, nlen,
                         ty_func(ty_ptr(ty_void()), params, 3, 0), SC_GLOBAL);
            if (fs)
                fs->is_func = 1;
        }
        for (i = 0; i < na; i++)
            irfn_push(&FN, IR_ARG, IRT_U64, 0, a[i], 0, 0, i);
        {
            u32 d = irfn_vreg(&FN);

            irfn_push(&FN, IR_CALL, IRT_PTR, d, 0, 0, 0,
                      fs ? addr_sym_of(fs) : x64_sym(&X64, nm));
            GEN_TY = ty_ptr(ty_void());
            return gen_postfix_ops(d);
        }
    }
    if (TOK_EQ(t, "__builtin_strlen")) {
        /* `__builtin_strlen(s)`。
         *
         * 实参是字符串字面量时折成常数——内核 include/linux/moduleparam.h 的
         * MODULE_INFO 里有一条
         *     _Static_assert(sizeof(s) - 1 == strlen(s),
         *                    "MODULE_INFO(...) contains embedded NUL byte")
         * 而 include/linux/string.h 在非 FORTIFY 下把 strlen 指到
         * __builtin_strlen（`#define strlen __builtin_strlen`）。
         * lib/btree.c 的 MODULE_AUTHOR("Joern Engel <…>") 就撞在这条断言上。
         *
         * 非字面量实参**必须退化成真正的 strlen() 调用**：c6c 以前是在
         * 预定义宏表里写 `#define __builtin_strlen(a) strlen(a)` 把它整个
         * 改写掉的，去掉那条宏以后运行期语义要在这里原样保住。
         */
        u32 ln = 0;
        int folded = 0;

        if (pa_peek(1) && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), "(")
            && pa_peek(2) && pa_peek(2)->kind == TK_STR) {
            pa_advance();              /* 名字 */
            pa_advance();              /* ( */
            while (pa_cur()->kind == TK_STR) {
                ln += str_lit_byte_len(pa_cur());   /* 解转义，和 sizeof 同口径 */
                pa_advance();
            }
            pa_expect_ch(')');
            folded = 1;
        }
        if (!folded) {
            Sym *fs = sym_find("strlen", 6);

            if (fs && fs->is_func) {
                pa_advance();          /* 名字，游标停在 '(' 上 */
                return gen_postfix_ops(gen_call(fs));
            }
            /* 连 strlen 都没有：跳过实参、值给 0（不把整条表达式打死） */
            {
                int d0 = 0;

                pa_advance();
                while (pa_cur()->kind != TK_EOF) {
                    if (pa_is_ch('(') || pa_is_ch('['))
                        d0++;
                    else if (pa_is_ch(')') || pa_is_ch(']')) {
                        d0--;
                        if (d0 == 0) {
                            pa_advance();
                            break;
                        }
                    }
                    pa_advance();
                }
            }
        }
        {
            u32 d = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, ln);
            GEN_TY = ty_ulong();
            return gen_postfix_ops(d);
        }
    }
    if (TOK_EQ(t, "__builtin_object_size")) {
