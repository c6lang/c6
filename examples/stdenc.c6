    "ad75cb29905d6f440ef25e2417c8ec59025a9b911d3e1f3b539b993cee59393a"
    "05d2e279e848fca9ac369d91811109271bc1671382e7ee2f774ed4f68245d5e3"
    "bf930904fc4722cbeeafa6d2363773405f7f17a3a560d87ae7b11e5bff";

static void demo_asn1(void)
{
    /* SEQUENCE { INTEGER 7, OID 2.5.4.3, UTF8String "hi", UTCTime } */
    static const char *hex =
        "301b"
        "020107"
        "0603550403"
        "0c026869"
        "170d3236303130313030303030305a";
    u8 der[128] = { 0 };
    int n = unhex(hex, der, (int)sizeof der);
    Asn1 r = asn1(der, n);
    Asn1Tag t = { 0 };

    printf("== asn1\n");
    check(n > 0, "DEMO DER 解开");
    if (r.next(&t) != 1 || t.tag != ASN1_SEQUENCE) {
        check(0, "外层是 SEQUENCE");
        return;
    }
    {
        Asn1 body = asn1_sub(&r, &t);
        Asn1Tag f = { 0 };
        i64 v = 0;
        char oid[64] = { 0 };
        int tm[6] = { 0 };

        if (body.next(&f) == 1 && asn1_int(&body, &f, &v) == 0) {
            check(v == 7, "INTEGER = 7");
            printf("   INTEGER %lld\n", (long long)v);
        }
        if (body.next(&f) == 1 && asn1_oid(&body, &f, oid, (int)sizeof oid) > 0) {
            check(strcmp(oid, "2.5.4.3") == 0, "OID = 2.5.4.3");
            printf("   OID %s\n", oid);
        }
        if (body.next(&f) == 1) {
            Str s = asn1_string(&body, &f);

            check(s.s.len == 2 && memcmp(s.s.data, "hi", 2) == 0,
                  "UTF8String = hi");
            printf("   UTF8String %.*s\n", (int)s.s.len, s.s.data);
        }
        if (body.next(&f) == 1 && asn1_time(&body, &f, tm) == 0) {
            check(tm[0] == 2026 && tm[1] == 1 && tm[2] == 1, "UTCTime = 2026-01-01");
            printf("   UTCTime %04d-%02d-%02d %02d:%02d:%02d\n", tm[0], tm[1],
                   tm[2], tm[3], tm[4], tm[5]);
        }
    }
}

static void demo_x509(void)
{
    u8 der[1024] = { 0 };
    int n = unhex(CERT_DER, der, (int)sizeof der);
    X509Cert c = { 0 };

    printf("== x509\n");
    check(n == 829, "证书是 829 字节");
    c = x509_parse(der, n);
    check(c.valid, "证书能解析");
    if (!c.valid)
        return;
    check(c.version == 3, "版本 v3");
    check(strcmp(c.serial, "1092") == 0, "序列号 1092");
    check(strcmp(c.subject.common_name, "example.test") == 0, "subject CN");
    check(strcmp(c.issuer.common_name, "example.test") == 0, "issuer CN（自签）");
    check(c.key_bits == 2048, "RSA 公钥 2048 位");
    check(strcmp(c.sig_alg, "1.2.840.113549.1.1.11") == 0, "sha256WithRSA");
    printf("   subject: C=%s O=%s CN=%s\n", c.subject.country, c.subject.org,
           c.subject.common_name);
    printf("   serial=%s  v%d  key=%d  sig=%d 字节\n", c.serial, c.version,
           c.key_bits, c.sig_len);
    printf("   有效期: %04d-%02d-%02d -> %04d-%02d-%02d\n", c.not_before[0],
           c.not_before[1], c.not_before[2], c.not_after[0], c.not_after[1],
           c.not_after[2]);
}

static void demo_jwt(void)
{
    char *token =
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9."
        "eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2"
        "MjM5MDIyfQ."
        "XbPfbIHMI6arZ3Y922BhjWgQzWXcXNrz0ogtVhfEd2o";
    char hdr[256] = { 0 }, pay[512] = { 0 };
    Jwt j = { 0 };

    printf("== jwt\n");
    j = jwt_verify(token, (int)strlen(token), "secret", 6, hdr,
                   (int)sizeof hdr, pay, (int)sizeof pay);
    check(j.valid, "HS256 验签通过");
    check(j.alg == JWT_ALG_HS256, "alg = HS256");
    if (j.valid) {
        check(strstr(pay, "\"sub\":\"1234567890\"") != 0, "payload 里有 sub");
        printf("   header : %s\n", hdr);
        printf("   payload: %s\n", pay);
    }
    {
        char bad[512] = { 0 };

        memcpy(bad, token, strlen(token) + 1);
        bad[45] = (bad[45] == 'A') ? 'B' : 'A';
        check(!jwt_verify(bad, (int)strlen(bad), "secret", 6, hdr,
                          (int)sizeof hdr, pay, (int)sizeof pay).valid,
              "改一个字节就被拒");
    }
    check(!jwt_verify(token, (int)strlen(token), "Secret", 6, hdr,
                      (int)sizeof hdr, pay, (int)sizeof pay).valid,
          "换密钥就被拒");
}

static void demo_otp(void)
{
    static const char *K = "12345678901234567890";
    char buf[16] = { 0 };
    int i = 0;

    printf("== otp\n");
    printf("   HOTP(6) 前五个：");
    for (i = 0; i < 5; i++) {
        u32 c = hotp(K, 20, (u64)i, 6);

        otp_format(c, 6, buf, (int)sizeof buf);
        printf("%s%s", i ? " " : "", buf);
    }
    printf("\n");
    check(hotp(K, 20, 0, 6) == 755224, "HOTP counter=0 是 755224");
    check(hotp(K, 20, 9, 6) == 520489, "HOTP counter=9 是 520489");
    {
        u32 t = totp(K, 20, 1234567890ull, 30, 8);

        otp_format(t, 8, buf, (int)sizeof buf);
        check(t == 89005924, "TOTP t=1234567890 是 89005924");
        printf("   TOTP(8) t=1234567890 -> %s\n", buf);
        check(otp_verify_totp(K, 20, buf, 1234567890ull, 30, 8, 0), "当步通过");
        check(otp_verify_totp(K, 20, buf, 1234567890ull + 30, 30, 8, 1),
              "漂移一步通过");
        check(!otp_verify_totp(K, 20, buf, 1234567890ull + 120, 30, 8, 1),
              "漂移四步不通过");
    }
}

int main(void)
{
    demo_asn1();
    demo_x509();
    demo_jwt();
    demo_otp();
    printf("\n%d check(s), %d failure(s)\n", checks, fails);
    return fails ? 1 : 0;
}
