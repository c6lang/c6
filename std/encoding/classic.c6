/* std/encoding/classic：经典替换/移位密码（凯撒、ROT13、Atbash、维吉尼亚、栅栏）。
 *
 *     import std.encoding.classic;
 *
 *     char out[64] = { 0 };
 *     caesar(S("Hello, World!"), 3, out, (int)sizeof out);   // Khoor, Zruog!
 *     vigenere(S("ATTACKATDAWN"), S("LEMON"), 0, out, (int)sizeof out);
 *     // LXFOPVEFRNHR
 *
 * 全部只处理 **ASCII 字母**（大写保大写、小写保小写），其它字符原样拷贝。这些密码
 * 没有任何安全性，只适合教学、谜题与「别让人一眼看懂」的场合。
 *
 * 约定：
 *
 * - `caesar(src, shift, dst, cap)`：位移 `shift` 可以是负数，内部对 26 取模；
 * - `rot13` 就是 shift=13 的凯撒（自逆）；
 * - `atbash` 把 a↔z、b↔y…（自逆）；
 * - `vigenere(src, key, decrypt, dst, cap)`：`key` 只用字母，非字母被忽略；
 *   `decrypt` 非 0 时做减法；
 * - `xor_cipher(src, key, dst, cap)`：按 key 循环异或（自逆，key 不能为空）；
 * - `railfence`/`railfence_decode` 是栅栏（之字形）换位密码，`rails >= 2`；
 * - 所有函数返回写入长度，容量不够返回 -1。
 */
#include <string.h>

module std.encoding.classic;
import std.core.types;
import std.text.str;

static int cl_is_upper(char c)
{
    return c >= 'A' && c <= 'Z';
}

static int cl_is_lower(char c)
{
    return c >= 'a' && c <= 'z';
}

static char cl_shift(char c, int k)
{
    if (cl_is_upper(c))
        return (char)('A' + (((c - 'A' + k) % 26) + 26) % 26);
    if (cl_is_lower(c))
        return (char)('a' + (((c - 'a' + k) % 26) + 26) % 26);
    return c;
}

int caesar(char[:] src, int shift, char *dst, int cap)
{
    int i = 0;

    if (!src.data || !dst || cap < src.len)
        return -1;
    for (i = 0; i < src.len; i++)
        dst[i] = cl_shift(src.data[i], shift);
    return src.len;
}

int rot13(char[:] src, char *dst, int cap)
{
    return caesar(src, 13, dst, cap);
}

int atbash(char[:] src, char *dst, int cap)
{
    int i = 0;

    if (!src.data || !dst || cap < src.len)
        return -1;
    for (i = 0; i < src.len; i++) {
        char c = src.data[i];

        if (cl_is_upper(c))
            dst[i] = (char)('Z' - (c - 'A'));
        else if (cl_is_lower(c))
            dst[i] = (char)('z' - (c - 'a'));
        else
            dst[i] = c;
    }
    return src.len;
}

int vigenere(char[:] src, char[:] key, int decrypt, char *dst, int cap)
{
    int i = 0, k = 0;
    int klen = 0;

    if (!src.data || !key.data || !dst || cap < src.len || key.len <= 0)
        return -1;
    /* 只数 key 里的字母 */
    for (i = 0; i < key.len; i++) {
        if (cl_is_upper(key.data[i]) || cl_is_lower(key.data[i]))
            klen++;
    }
    if (klen == 0)
        return -1;
    k = 0;
    for (i = 0; i < src.len; i++) {
        char c = src.data[i];

        if (!cl_is_upper(c) && !cl_is_lower(c)) {
            dst[i] = c;
            continue;
        }
        while (k < key.len
               && !(cl_is_upper(key.data[k]) || cl_is_lower(key.data[k])))
            k++;
        if (k >= key.len)
            k = 0;
        {
            int base = cl_is_upper(key.data[k]) ? 'A' : 'a';
            int shift = key.data[k] - base;

            dst[i] = cl_shift(c, decrypt ? -shift : shift);
        }
        k++;
        if (k >= key.len)
            k = 0;
    }
    return src.len;
}

int xor_cipher(char[:] src, char[:] key, char *dst, int cap)
{
    int i = 0;

    if (!src.data || !key.data || !dst || cap < src.len || key.len <= 0)
        return -1;
    /* 就地也可：先读 src 的字节再写 dst，同一块内存没问题 */
    for (i = 0; i < src.len; i++)
        dst[i] = (char)((unsigned char)src.data[i]
                        ^ (unsigned char)key.data[i % key.len]);
    return src.len;
}

int railfence(char[:] src, int rails, char *dst, int cap)
{
    int r = 0, i = 0, o = 0;
    int n = src.len;

    if (!src.data || !dst || cap < src.len || rails < 2 || rails > n)
        return -1;
    for (r = 0; r < rails; r++) {
        int cycle = 2 * (rails - 1);

        for (i = 0; i < n; i++) {
            int pos = i % cycle;

            if (pos == r || pos == cycle - r) {
                if (pos == r || r == 0 || r == rails - 1) {
                    if (pos == r)
                        dst[o++] = src.data[i];
                } else {
                    dst[o++] = src.data[i];
                }
            }
        }
    }
    return o;
}

int railfence_decode(char[:] src, int rails, char *dst, int cap)
{
    int r = 0, i = 0, o = 0;
    int n = src.len;
    char order[512] = { 0 };
    int k = 0;

    if (!src.data || !dst || cap < src.len || rails < 2 || rails > n)
        return -1;
    if (n > 512)
        return -1;
    /* 先算出「读入顺序」下每个位置对应的原文下标 */
    for (r = 0; r < rails; r++) {
        int cycle = 2 * (rails - 1);

        for (i = 0; i < n; i++) {
            int pos = i % cycle;

            if (pos == r || (pos == cycle - r && r != 0 && r != rails - 1)) {
                if (pos == r || pos == cycle - r)
                    order[i] = (char)r;
            }
        }
    }
    /* order[] 现在记的是「原文位置 i 属于第几栏」；按栏顺序回填 */
    for (r = 0; r < rails; r++) {
        for (i = 0; i < n; i++) {
            if ((int)order[i] == r) {
                if (o >= cap || k >= n)
                    return -1;
                dst[i] = src.data[k++];
                o++;
            }
        }
    }
    return o;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "classic：凯撒、ROT13、Atbash" {
    char out[64] = { 0 };
    char back[64] = { 0 };
    int n = 0;

    n = caesar(S("Hello, World!"), 3, out, (int)sizeof out);
    if (n != 13 || memcmp(out, "Khoor, Zruog!", 13) != 0)
        return err(1, "凯撒 +3 不对");
    n = caesar((char[:]){ out, n }, -3, back, (int)sizeof back);
    if (n != 13 || memcmp(back, "Hello, World!", 13) != 0)
        return err(2, "凯撒 -3 应该还原");
    n = rot13(S("Hello"), out, (int)sizeof out);
    if (n != 5 || memcmp(out, "Uryyb", 5) != 0)
        return err(3, "ROT13 不对");
    n = atbash(S("abcXYZ"), out, (int)sizeof out);
    if (n != 6 || memcmp(out, "zyxCBA", 6) != 0)
        return err(4, "Atbash 不对");
    if (caesar(S("Hello, World!"), 3, out, 4) != -1)
        return err(5, "容量不够应该 -1");
}

test "classic：维吉尼亚、异或、栅栏" {
    char out[64] = { 0 };
    char back[64] = { 0 };
    int n = 0;

    n = vigenere(S("ATTACKATDAWN"), S("LEMON"), 0, out, (int)sizeof out);
    if (n != 12 || memcmp(out, "LXFOPVEFRNHR", 12) != 0)
        return err(6, "维吉尼亚加密结果不对");
    n = vigenere((char[:]){ out, n }, S("LEMON"), 1, back, (int)sizeof back);
    if (n != 12 || memcmp(back, "ATTACKATDAWN", 12) != 0)
        return err(7, "维吉尼亚解密应该还原");
    /* 大小写与标点保留 */
    n = vigenere(S("Attack at dawn!"), S("lemon"), 0, out, (int)sizeof out);
    if (n != 15 || memcmp(out, "Lxfopv ef rnhr!", 15) != 0)
        return err(8, "大小写/标点处理不对");
    n = xor_cipher(S("secret"), S("key"), out, (int)sizeof out);
    if (n != 6 || memcmp(out, "secret", 6) == 0)
        return err(9, "异或之后应该变化");
    n = xor_cipher((char[:]){ out, n }, S("key"), back, (int)sizeof back);
    if (n != 6 || memcmp(back, "secret", 6) != 0)
        return err(10, "异或应该自逆");
    n = railfence(S("WEAREDISCOVEREDFLEEATONCE"), 3, out, (int)sizeof out);
    if (n != 25 || memcmp(out, "WECRLTEERDSOEEFEAOCAIVDEN", 25) != 0)
        return err(11, "栅栏密码结果不对");
    n = railfence_decode((char[:]){ out, n }, 3, back, (int)sizeof back);
    if (n != 25 || memcmp(back, "WEAREDISCOVEREDFLEEATONCE", 25) != 0)
        return err(12, "栅栏解码应该还原");
    n = railfence(S("HELLOWORLD"), 2, out, (int)sizeof out);
    if (n != 10 || memcmp(out, "HLOOLELWRD", 10) != 0)
        return err(13, "两栏栅栏的密文不对");
    n = railfence_decode((char[:]){ out, n }, 2, back, (int)sizeof back);
    if (n != 10 || memcmp(back, "HELLOWORLD", 10) != 0)
        return err(14, "两栏栅栏应该能还原");
}
