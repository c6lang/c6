/* std/encoding/md5：MD5（RFC 1321）。
 *
 *     import std.encoding.md5;
 *
 *     u8 d[16] = { 0 };
 *     md5("abc", 3, d);                    // 一次性，摘要 16 字节
 *     char hex[33] = { 0 };
 *     md5_hex("abc", 3, hex);              // 32 个小写十六进制 + NUL
 *
 *     Md5 st = { 0 };                      // 流式：任意切分结果相同
 *     st.init();
 *     st.update("a", 1);
 *     st.update("bc", 2);
 *     st.final(d);                         // 之后状态失效
 *
 * **MD5 已经不安全**：碰撞是分钟级的，不要用它做签名、口令、证书或任何需要
 * 「抗碰撞」的地方。这个模块存在是因为它仍然是文件校验、协议指纹、老数据的
 * 兼容格式里绕不开的一环；要安全摘要用 `std.encoding.sha256` 或
 * `std.encoding.sha512`，要消息认证用 HMAC。
 *
 * 实现是教科书版：小端 32 位字、64 步、四轮不同逻辑函数，T 表是
 * `floor(2^32 * |sin(i+1)|)`；旋转借 `std.core.bits` 的 `rotr32`，链接时把
 * `std/core/bits.c6` 放上命令行。零分配、不链 libm。
 *
 * 空指针约定与 sha256 一致：`p == 0` 当 0 字节输入，`out == 0` 直接返回；
 * `md5_eq` 是 16 字节常数时间比较。
 */
#include <string.h>

module std.encoding.md5;
import std.core.types;
import std.core.bits;

struct Md5 {
    u32 h[4];
    u64 n;        /* 已喂入的字节数 */
    u8  buf[64];  /* 未满一块的尾巴 */
    u32 used;
};

/* floor(2^32 * |sin(i+1)|)：RFC 1321 的 T 表 */
static const u32 md5_t[64] = {
    0xd76aa478u, 0xe8c7b756u, 0x242070dbu, 0xc1bdceeeu,
    0xf57c0fafu, 0x4787c62au, 0xa8304613u, 0xfd469501u,
    0x698098d8u, 0x8b44f7afu, 0xffff5bb1u, 0x895cd7beu,
    0x6b901122u, 0xfd987193u, 0xa679438eu, 0x49b40821u,
    0xf61e2562u, 0xc040b340u, 0x265e5a51u, 0xe9b6c7aau,
    0xd62f105du, 0x02441453u, 0xd8a1e681u, 0xe7d3fbc8u,
    0x21e1cde6u, 0xc33707d6u, 0xf4d50d87u, 0x455a14edu,
    0xa9e3e905u, 0xfcefa3f8u, 0x676f02d9u, 0x8d2a4c8au,
    0xfffa3942u, 0x8771f681u, 0x6d9d6122u, 0xfde5380cu,
    0xa4beea44u, 0x4bdecfa9u, 0xf6bb4b60u, 0xbebfbc70u,
    0x289b7ec6u, 0xeaa127fau, 0xd4ef3085u, 0x04881d05u,
    0xd9d4d039u, 0xe6db99e5u, 0x1fa27cf8u, 0xc4ac5665u,
    0xf4292244u, 0x432aff97u, 0xab9423a7u, 0xfc93a039u,
    0x655b59c3u, 0x8f0ccc92u, 0xffeff47du, 0x85845dd1u,
    0x6fa87e4fu, 0xfe2ce6e0u, 0xa3014314u, 0x4e0811a1u,
    0xf7537e82u, 0xbd3af235u, 0x2ad7d2bbu, 0xeb86d391u,
};

/* 每步的循环左移位数：四轮各 4 个，轮内重复 */
static const u8 md5_s[64] = {
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
};

static u32 md5_load_le(const u8 *p)
{
    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16)
           | ((u32)p[3] << 24);
}

/* 压一块（64 字节）：A/B/C/D 四寄存器的 64 步 */
static void md5_block(Md5 *self, const u8 *p)
{
    u32 m[16] = { 0 };
    u32 a = 0, b = 0, c = 0, d = 0;
    int i = 0;

    for (i = 0; i < 16; i++)
        m[i] = md5_load_le(p + i * 4);
    a = self->h[0];
    b = self->h[1];
    c = self->h[2];
    d = self->h[3];
    for (i = 0; i < 64; i++) {
        u32 f = 0, tmp = 0;
        int g = 0;

        if (i < 16) {
            f = (b & c) | (~b & d);
            g = i;
        } else if (i < 32) {
            f = (d & b) | (~d & c);
            g = (5 * i + 1) % 16;
        } else if (i < 48) {
            f = b ^ c ^ d;
            g = (3 * i + 5) % 16;
        } else {
            f = c ^ (b | ~d);
            g = (7 * i) % 16;
        }
        tmp = d;
        d = c;
        c = b;
        b = b + rotl32(a + f + md5_t[i] + m[g], (int)md5_s[i]);
        a = tmp;
    }
    self->h[0] += a;
    self->h[1] += b;
    self->h[2] += c;
    self->h[3] += d;
}

void init(Md5 *self)
{
    /* RFC 1321 §3.3：四个小端初始值 */
    self->h[0] = 0x67452301u;
    self->h[1] = 0xefcdab89u;
    self->h[2] = 0x98badcfeu;
    self->h[3] = 0x10325476u;
    self->n = 0ull;
    self->used = 0u;
    memset(self->buf, 0, sizeof self->buf);
}

/* 喂数据：任意切分（1 字节一喂、63/64/65 跨块）都给同一个结果 */
void update(Md5 *self, const void *p, usize n)
{
    const u8 *b = (const u8 *)p;
    usize i = 0;

    if (!self || !b)
        return;
    self->n += (u64)n;
    if (self->used != 0u) {
        while (self->used < 64u && i < n)
            self->buf[self->used++] = b[i++];
        if (self->used < 64u)
            return;
        md5_block(self, self->buf);
        self->used = 0u;
    }
    for (; i + 64 <= n; i += 64)
        md5_block(self, b + i);
    while (i < n)
        self->buf[self->used++] = b[i++];
}

/* 收尾：0x80 填充 + 比特长度（小端）追加，交出 16 字节摘要 */
void final(Md5 *self, u8 *out16)
{
    u64 bits = 0ull;
    int i = 0;

    if (!self || !out16)
        return;
    bits = self->n * 8ull;
    self->buf[self->used++] = 0x80;
    if (self->used > 56u) {
        while (self->used < 64u)
            self->buf[self->used++] = 0;
        md5_block(self, self->buf);
        self->used = 0u;
    }
    while (self->used < 56u)
        self->buf[self->used++] = 0;
    for (i = 0; i < 8; i++)
        self->buf[56 + i] = (u8)(bits >> (i * 8));
    md5_block(self, self->buf);
    for (i = 0; i < 4; i++) {
        out16[i * 4]     = (u8)self->h[i];
        out16[i * 4 + 1] = (u8)(self->h[i] >> 8);
        out16[i * 4 + 2] = (u8)(self->h[i] >> 16);
        out16[i * 4 + 3] = (u8)(self->h[i] >> 24);
    }
    memset(self, 0, sizeof(Md5));
}

void md5(const void *p, usize n, u8 *out16)
{
    Md5 st = { 0 };

    if (!out16)
        return;
    st.init();
    st.update(p, n);
    st.final(out16);
}

static const char md5_hex_digits[] = "0123456789abcdef";

/* 16 字节摘要 → 32 个小写十六进制 + NUL（调用方给 33 字节） */
void md5_hex(const void *p, usize n, char *out33)
{
    u8 d[16] = { 0 };
    int i = 0;

    if (!out33)
        return;
    md5(p, n, d);
    for (i = 0; i < 16; i++) {
        out33[i * 2]     = md5_hex_digits[(d[i] >> 4) & 0xf];
        out33[i * 2 + 1] = md5_hex_digits[d[i] & 0xf];
    }
    out33[32] = 0;
    memset(d, 0, sizeof d);
}

/* 16 字节常数时间比较：相等 1，否则 0（不短路，空指针一律 0） */
int md5_eq(const u8 *a, const u8 *b)
{
    u32 diff = 0u;
    int i = 0;

    if (!a || !b)
        return 0;
    for (i = 0; i < 16; i++)
        diff |= (u32)(a[i] ^ b[i]);
    return diff == 0u ? 1 : 0;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int md5_hex_is(const char *msg, int n, const char *want)
{
    char got[33] = { 0 };

    md5_hex(msg, (usize)n, got);
    return strcmp(got, want) == 0;
}

test "RFC 1321 的七组向量" {
    if (!md5_hex_is("", 0, "d41d8cd98f00b204e9800998ecf8427e"))
        return err(1, "空串摘要不对");
    if (!md5_hex_is("a", 1, "0cc175b9c0f1b6a831c399e269772661"))
        return err(2, "a 的摘要不对");
    if (!md5_hex_is("abc", 3, "900150983cd24fb0d6963f7d28e17f72"))
        return err(3, "abc 的摘要不对");
    if (!md5_hex_is("message digest", 14,
                    "f96b697d7cb7938d525a2f31aaf161d0"))
        return err(4, "message digest 的摘要不对");
    if (!md5_hex_is("abcdefghijklmnopqrstuvwxyz", 26,
                    "c3fcd3d76192e4007dfb496cca67e13b"))
        return err(5, "字母表的摘要不对");
    if (!md5_hex_is("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                    "0123456789",
                    62, "d174ab98d277d9f5a5611c2c9f419d9f"))
        return err(6, "字母表+数字的摘要不对");
    if (!md5_hex_is("1234567890123456789012345678901234567890"
                    "1234567890123456789012345678901234567890",
                    80, "57edf4a22be3c955ac49da2e2107b67a"))
        return err(7, "80 位数字的摘要不对");
}

static void hex16(const u8 *d, char *out)
{
    int i = 0;

    for (i = 0; i < 16; i++) {
        out[i * 2] = "0123456789abcdef"[(d[i] >> 4) & 0xf];
        out[i * 2 + 1] = "0123456789abcdef"[d[i] & 0xf];
    }
    out[32] = 0;
}

test "流式喂入与跨块边界" {
    char all[33] = { 0 }, hex[33] = { 0 };
    u8 a[16] = { 0 }, b[16] = { 0 };
    Md5 st = { 0 };
    char text[200] = { 0 };
    int i = 0;

    for (i = 0; i < (int)sizeof text; i++)
        text[i] = (char)('a' + i % 26);
    md5_hex(text, (usize)sizeof text, all);
    /* 1 字节一喂 */
    st.init();
    for (i = 0; i < (int)sizeof text; i++)
        st.update(text + i, 1);
    st.final(a);
    hex16(a, hex);
    if (strcmp(hex, all) != 0)
        return err(8, "1 字节一喂和一次性不一致");
    /* 63 / 64 / 65 字节边界 */
    st.init();
    st.update(text, 63);
    st.update(text + 63, 64);
    st.update(text + 127, (usize)sizeof text - 127);
    st.final(b);
    if (!md5_eq(a, b))
        return err(9, "跨块切分结果不一致");
    /* 长度敏感：少一个字节必须不同 */
    md5_hex(text, (usize)sizeof text - 1, hex);
    if (strcmp(hex, all) == 0)
        return err(10, "长度不一样的摘要不该相同");
}

test "常数时间比较与参数边界" {
    u8 a[16] = { 0 }, b[16] = { 0 }, e1[16] = { 0 }, e2[16] = { 0 };
    char hex[33] = { 0 };

    md5("abc", 3, a);
    memcpy(b, a, sizeof a);
    if (!md5_eq(a, b))
        return err(11, "相同摘要应该相等");
    b[15] ^= 1;
    if (md5_eq(a, b))
        return err(12, "改一字节应该不相等");
    if (md5_eq(0, b) || md5_eq(a, 0) || md5_eq(0, 0))
        return err(13, "空指针比较应该给 0");
    /* NULL 输入 == 空输入；out == 0 不写也不崩 */
    md5(0, 0, e1);
    md5("", 0, e2);
    if (!md5_eq(e1, e2))
        return err(14, "NULL 输入应该等于空输入");
    md5_hex(0, 0, hex);
    if (strcmp(hex, "d41d8cd98f00b204e9800998ecf8427e") != 0)
        return err(15, "NULL 输入的 hex 不对");
    md5("abc", 3, 0);
    md5_hex("abc", 3, 0);
}
