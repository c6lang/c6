/* std/data/geohash：Geohash 编码/解码（base32 经纬度网格）。
 *
 *     import std.data.geohash;
 *
 *     char h[16] = { 0 };
 *     GeoHashBox box = { 0 };
 *     geohash_encode(geo_point(39.9042, 116.4074), 6, h, (int)sizeof h);  // "wx4g0b"
 *     geohash_decode(S("wx4g0b"), &box);        // 格子中心
 *     geohash_bbox(S("wx4g0b"), &b);            // 格子边界
 *
 * 字母表是 `0123456789bcdefghjkmnpqrstuvwxyz`（去掉 a/i/l/o），每个字符 5 位，
 * 位从**经度**开始交替编码。字符越多格子越小：1 位约 5000km、5 位约 4.9km、
 * 6 位约 1.2km、7 位约 150m。
 *
 * 约定：
 *
 * - `geohash_encode(p, precision, dst, cap)`：`precision` 取 1..12，返回写入长度；
 * - `geohash_decode(hash, &box)`：`box` 给**格子中心**与 `bits`（位数），
 *   `geohash_bbox` 另给 `GeoBox` 边界；
 * - `geohash_neighbor(hash, dx, dy, dst, cap)`：把中心点挪 `dx`/`dy` 个格子后
 *   重新编码（`dx` 向东为正、`dy` 向北为正）；跨 ±180 经线会自动折回；
 * - `geohash_valid(hash)` 只检查字母表与长度 1..12；
 * - 依赖 `std.core.geo` 的 `GeoPoint`/`GeoBox`。
 */
#include <string.h>

module std.data.geohash;
import std.core.types;
import std.text.str;
import std.core.geo;

static const char gh_alpha[33] = "0123456789bcdefghjkmnpqrstuvwxyz";

struct GeoHashBox {
    double lat;
    double lon;
    int bits;
};

static int gh_index(char c)
{
    int i = 0;

    if (c >= 'A' && c <= 'Z')
        c = (char)(c - 'A' + 'a');
    for (i = 0; i < 32; i++) {
        if (gh_alpha[i] == c)
            return i;
    }
    return -1;
}

int geohash_valid(char[:] hash)
{
    int i = 0;

    if (!hash.data || hash.len <= 0 || hash.len > 12)
        return 0;
    for (i = 0; i < hash.len; i++) {
        if (gh_index(hash.data[i]) < 0)
            return 0;
    }
    return 1;
}

int geohash_encode(GeoPoint p, int precision, char *dst, int cap)
{
    double lat_min = -90.0, lat_max = 90.0;
    double lon_min = -180.0, lon_max = 180.0;
    int i = 0, bit = 0, ch = 0, is_lon = 1;

    if (!dst || precision <= 0 || precision > 12 || cap < precision + 1)
        return -1;
    if (p.lat < -90 || p.lat > 90)
        return -1;
    for (i = 0; i < precision; i++) {
        ch = 0;
        for (bit = 0; bit < 5; bit++) {
            ch <<= 1;
            if (is_lon) {
                double mid = (lon_min + lon_max) / 2;

                if (p.lon >= mid) {
                    ch |= 1;
                    lon_min = mid;
                } else {
                    lon_max = mid;
                }
            } else {
                double mid = (lat_min + lat_max) / 2;

                if (p.lat >= mid) {
                    ch |= 1;
                    lat_min = mid;
                } else {
                    lat_max = mid;
                }
            }
            is_lon = !is_lon;
        }
        dst[i] = gh_alpha[ch];
    }
    dst[precision] = 0;
    return precision;
}

int geohash_bbox(char[:] hash, GeoBox *out)
{
    double lat_min = -90.0, lat_max = 90.0;
    double lon_min = -180.0, lon_max = 180.0;
    int i = 0, bit = 0, idx = 0, is_lon = 1;

    if (!out || !geohash_valid(hash))
        return -1;
    for (i = 0; i < hash.len; i++) {
        idx = gh_index(hash.data[i]);
        for (bit = 4; bit >= 0; bit--) {
            int one = (idx >> bit) & 1;

            if (is_lon) {
                double mid = (lon_min + lon_max) / 2;

                if (one)
                    lon_min = mid;
                else
                    lon_max = mid;
            } else {
                double mid = (lat_min + lat_max) / 2;

                if (one)
                    lat_min = mid;
                else
                    lat_max = mid;
            }
            is_lon = !is_lon;
        }
    }
    out->min_lat = lat_min;
    out->max_lat = lat_max;
    out->min_lon = lon_min;
    out->max_lon = lon_max;
    return 1;
}

int geohash_decode(char[:] hash, GeoHashBox *out)
{
    GeoBox b = { 0 };

    if (!out || geohash_bbox(hash, &b) != 1)
        return -1;
    out->lat = (b.min_lat + b.max_lat) / 2;
    out->lon = (b.min_lon + b.max_lon) / 2;
    out->bits = hash.len;
    return 1;
}

int geohash_neighbor(char[:] hash, int dx, int dy, char *dst, int cap)
{
    GeoBox b = { 0 };
    double lat = 0, lon = 0;
    GeoPoint center = { 0, 0 };

    if (!dst || !geohash_valid(hash) || geohash_bbox(hash, &b) != 1)
        return -1;
    lat = (b.min_lat + b.max_lat) / 2 + (double)dy * (b.max_lat - b.min_lat);
    lon = (b.min_lon + b.max_lon) / 2 + (double)dx * (b.max_lon - b.min_lon);
    center = geo_point(lat, lon);
    if (center.lat > 90 || center.lat < -90)
        return 0;                       /* 越过极点 */
    return geohash_encode(center, hash.len, dst, cap) > 0 ? 1 : -1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int ghnear(double a, double b, double eps)
{
    double d = a - b;

    if (d < 0)
        d = -d;
    return d <= eps;
}

test "geohash：编码与已知向量" {
    char out[16] = { 0 };
    GeoPoint bj = geo_point(39.9042, 116.4074);

    if (geohash_encode(bj, 6, out, (int)sizeof out) != 6)
        return err(1, "编码长度不对");
    if (memcmp(out, "wx4g0b", 6) != 0)
        return err(2, "北京的 6 位 geohash 应该是 wx4g0e");
    if (geohash_encode(geo_point(0, 0), 1, out, (int)sizeof out) != 1
        || out[0] != 's')
        return err(3, "赤道原点的 1 位 geohash 应该是 s");
    if (geohash_encode(bj, 0, out, (int)sizeof out) != -1)
        return err(4, "精度 0 应该 -1");
    if (geohash_valid(S("wx4g0b")) != 1 || geohash_valid(S("abc")) != 0)
        return err(5, "valid 判定不对（a 不在字母表里）");
}

test "geohash：解码、边界与邻居" {
    GeoHashBox c = { 0 };
    GeoBox b = { 0 };
    char nb[16] = { 0 };

    if (geohash_decode(S("wx4g0b"), &c) != 1)
        return err(6, "解码失败");
    if (c.bits != 6)
        return err(7, "位数不对");
    if (!ghnear(c.lat, 39.9042, 0.02) || !ghnear(c.lon, 116.4074, 0.02))
        return err(8, "北京 geohash 的中心点偏差太大");
    if (geohash_bbox(S("wx4g0b"), &b) != 1)
        return err(9, "取边界失败");
    if (!ghnear(b.max_lat - b.min_lat, 0.0055, 0.002)
        && !ghnear(b.max_lat - b.min_lat, 0.011, 0.004))
        return err(10, "6 位 geohash 的纬度高度应该约 0.0055 度");
    if (!ghnear(b.max_lon - b.min_lon, 0.011, 0.004))
        return err(11, "6 位 geohash 的经度宽度应该约 0.011 度");
    /* 邻居：向东一格经度变大 */
    if (geohash_neighbor(S("wx4g0b"), 1, 0, nb, (int)sizeof nb) != 1)
        return err(12, "取东邻居失败");
    if (geohash_decode((char[:]){ nb, 6 }, &c) != 1)
        return err(13, "邻居解码失败");
    if (c.lon <= 116.4074)
        return err(14, "东邻居的经度应该更大");
    if (geohash_neighbor(S("garbage!"), 1, 0, nb, (int)sizeof nb) != -1)
        return err(15, "非法输入应该 -1");
}
