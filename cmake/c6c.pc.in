
prefix=@C6C_PC_PREFIX@
exec_prefix=${prefix}
bindir=${prefix}/@C6_BINDIR_REL@
libdir=${prefix}/@C6_LIBDIR_REL@
includedir=${prefix}/@C6_INCLUDEDIR_REL@

Name: @C6C_PC_NAME@
Description: @C6C_PC_DESCRIPTION@
URL: https://github.com/c6lang/c6
Version: @C6_VERSION_RAW@
Libs: -L${libdir} @C6C_PC_LIBS@
Libs.private: @C6_PC_PRIVATE_LIBS@
Cflags: -I${includedir}

# 变量：pkgconf --variable=c6c c6c / pkgconf --variable=libdir c6c
c6c=${bindir}/c6c@C6_TCC_EXESUF@
