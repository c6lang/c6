/* c6 自测：结构体方法（'ret f(struct T *self, ...)'，调用写作 p->f()）
 *
 * 运行（仓库根目录）：
 *   ./tcc/tcc -B tcc -test tests/method.c6 tests/tu/method.c6
 */
#include <stdio.h>
#include <string.h>
#include <unistd.h>

void __tcc_err_clear(void);

struct Vec { int x, y; };
struct Pair { int a, b; };

/* 方法就是第一个参数是接收者的普通函数 */
int vec_sum(struct Vec *v) { return v->x + v->y; }

/* 方法可以调用同一个接收者的其它方法 */
int vec_twice(struct Vec *v) { return v->vec_sum() * 2; }

/* 值接收者：'v.vec_bump()' 就是 'vec_bump(&v)'，改的是 v 本身 */
void vec_bump(struct Vec *v) { v->x = v->x + 1; }

/* 值上的同名字段仍然优先：'d.dup_size' 是字段，方法只能普通调用 */
struct Dup { int n; int dup_size; };
int dup_size(struct Dup *d) { return d->n * 2; }

/* 值接收者也认 '|T|' 方法模板：'v.vat(0)' 与 'vat@int(&v, 0)' 等价 */
struct Vect@T { T *data; int len; };
|T| T vat(Vect@T *self, int i) { return self->data[i]; }

/* 返回结构体时，隐藏的接收者在 sret 缓冲区之后 */
struct Pair vec_pair(struct Vec *v)
{
    struct Pair p = { v->x * 2, v->y * 3 };
    return p;
}

/* 真字段优先于同名方法 */
struct Holder { int v; int area; };
int holder_area(struct Holder *h) { return h->v * 2; }

/* 只要原型就够：类型可以还是不完整的 */
struct Node;
int node_depth(struct Node *n);
struct Node { int d; };
int node_depth(struct Node *n) { return n->d; }

/* 不同的结构体可以用同名方法：符号分别是 Circle_area / Rect_area，
   不需要 package */
struct Circle { int r; };
struct Rect { int w, h; };
int area(struct Circle *c) { return 3 * c->r * c->r; }
int area(struct Rect *r) { return r->w * r->h; }

/* 与方法同名的普通函数不受影响：方法叫 Box_plain_area，普通名 plain_area
   已经属于这个普通函数，不会被方法抢走 */
int plain_area(void) { return 7; }
struct Box { int w, h; };
int plain_area(struct Box *b) { return b->w * b->h; }

/* 与 libc 里的声明同名的方法（unistd.h 只声明、没定义）：源码名 getpid
   属于 libc，不能被方法抢走，普通调用必须还是 libc 的 getpid */
struct Pid { int v; };
int getpid(struct Pid *p) { (void)p; return 4242; }

/* 方法里的 __func__ 显示源码里写的名字，不是 mangled 符号 */
const char *vec_name(struct Vec *v) { (void)v; return __func__; }

/* 同名方法的另一半在 tests/tu/method.c6 */
struct Depth { int d; };
int depth(struct Depth *p);
int depth(struct Vec *v) { return v->x - v->y; }

/* 方法不进命名空间：符号按接收者取名，不同类型同名互不干扰 */
int scaled(struct Vec *v, int k) { return vec_sum(v) * k; }
int vec_area(struct Vec *v) { return v->x * v->y; }

/* 'T!error' 方法同样可以走接收者语法 */
int!error vec_checked(struct Vec *v)
{
    if (v->x < 0)
        return err(1, "negative x");
    return v->x;
}

/* 'try' 把通过接收者语法抛出的错误原样传回 */
int!error checked_times_ten(struct Vec *v)
{
    return (try v->vec_checked()) * 10;
}

static int probe(struct Vec *v)
{
    int x = checked_times_ten(v) catch e {
        return -e.id;
    };
    return x;
}

/* 值接收者调 '!error' 方法：错误照常经过 'try' 往上走 */
int!error checked_by_value(struct Vec v)
{
    return (try v.vec_checked()) * 10;
}

static int probe_value(struct Vec v)
{
    int x = checked_by_value(v) catch e {
        return -e.id;
    };
    return x;
}

test "不同结构体可以用同名方法（不需要 package）" {
    struct Circle c = { 2 };
    struct Rect r = { 2, 3 };
    if ((&c)->area() != 12)
        return err(1, "Circle 的 area 不对");
    if ((&r)->area() != 6)
        return err(2, "Rect 的 area 不对");
}

test "和方法同名的普通函数不会被方法顶掉" {
    struct Box b = { 3, 4 };
    if (plain_area() != 7)
        return err(1, "普通调用 plain_area() 被方法抢走了");
    if ((&b)->plain_area() != 12)
        return err(2, "方法调用 (&b)->plain_area() 不对");
}

test "和 libc 声明同名的方法不抢 libc 的名字" {
    struct Pid p = { 0 };
    if ((&p)->getpid() != 4242)
        return err(1, "方法 getpid 不对");
    if (getpid() == 4242)
        return err(2, "普通调用 getpid() 被方法抢走了");
}

test "同名方法按接收者区分，可以跨翻译单元" {
    struct Vec v = { 5, 2 };
    struct Depth d = { 3 };
    if ((&v)->depth() != 3)
        return err(1, "本 TU 的 depth 不对");
    if ((&d)->depth() != 12)
        return err(2, "另一个 TU 的 depth 不对");
}

test "普通调用形式在方法被改名后仍然可用" {
    struct Vec v = { 3, 4 };
    struct Circle c = { 2 };
    if (vec_sum(&v) != 7)
        return err(1, "普通调用 vec_sum 不对");
    if (area(&c) != 12)          /* 弱别名指向本 TU 的第一个 area */
        return err(2, "普通调用 area 不对");
}

test "方法里的 __func__ 是源码名" {
    struct Vec v = { 1, 2 };
    if (strcmp((&v)->vec_name(), "vec_name") != 0)
        return err(1, "__func__ 不是源码名");
}

test "系统头里声明的 libc 函数仍然是方法" {
    FILE *f = stdout;
    f->fflush();                 /* 不改名，仍然调 libc 的 fflush */
}

/* ---- 跨翻译单元（tests/tu/method.c6）---- */
int vec_scale(struct Vec *v, int k);
int tu_scale(struct Vec *v, int k);

/* ---- 测试块 ---- */

test "方法调用就是普通函数调用" {
    struct Vec v = { 3, 4 };
    struct Vec *p = &v;
    if (p->vec_sum() != 7)
        return err(1, "p->vec_sum() 不对");
    if (vec_sum(p) != 7)
        return err(2, "普通调用形式不对");
    if (p->vec_twice() != 14)
        return err(3, "方法调用另一个方法不对");
}

test "返回结构体的方法" {
    struct Vec v = { 3, 4 };
    struct Vec *p = &v;
    struct Pair q = p->vec_pair();
    if (q.a != 6 || q.b != 12)
        return err(1, "sret 方法返回的结构体不对");
}

test "真字段优先于同名方法" {
    struct Holder h = { 5, 99 };
    if (h.area != 99)
        return err(1, "字段没有优先");
    if (holder_area(&h) != 10)
        return err(2, "同名方法本身仍可普通调用");
}

test "只有原型、类型尚不完整时也能调用方法" {
    struct Node n = { 7 };
    if ((&n)->node_depth() != 7)
        return err(1, "不完整类型的方法调用不对");
}

test "包里定义的方法按裸名字查找" {
    struct Vec v = { 3, 4 };
    struct Vec *p = &v;
    if (p->scaled(10) != 70)
        return err(1, "包方法 p->scaled 不对");
    if (p->vec_area() != 12)
        return err(2, "包方法 p->vec_area 不对");
    if (vec_area(p) != 12)
        return err(3, "限定调用 vec_area 不对");
}

test "impl 现在是普通标识符" {
    int impl = 1;
    if (impl != 1)
        return err(1, "impl 不能当普通变量名");
}

test "T!error 方法通过接收者语法传播错误" {
    struct Vec v = { 3, 4 };
    struct Vec *p = &v;
    __tcc_err_clear();
    if (probe(p) != 30)
        return err(1, "正常路径的返回值不对");
    p->x = -1;
    if (probe(p) != -1)
        return err(2, "错误路径没有把错误码带回来");
    __tcc_err_clear();
}

test "方法可以跨翻译单元：本 TU 声明、另一个 TU 定义" {
    struct Vec v = { 3, 4 };
    struct Vec *p = &v;
    if (p->vec_scale(10) != 70)
        return err(1, "另一个 TU 的 vec_scale 不对");
    if (p->tu_scale(2) != 14)
        return err(2, "另一个 TU 的方法里调用本 TU 的方法不对");
    if (vec_scale(p, 1) != 7)
        return err(3, "跨 TU 的普通调用形式不对");
}

/* ---- 值接收者：'a.m()' 就是 'm(&a)' ---- */

test "值接收者：v.f() 等价于 f(&v)" {
    struct Vec v = { 3, 4 };
    if (v.vec_sum() != 7)
        return err(1, "v.vec_sum() 不对");
    if (v.vec_sum() != vec_sum(&v))
        return err(2, "v.f() 与 f(&v) 不是同一个调用");
    v.vec_bump();
    if (v.x != 4)
        return err(3, "方法通过接收者改的是 v 本身");
    v.vec_bump();
    if (v.x != 5 || (&v)->x != 5)
        return err(4, "连续两次 v.vec_bump() 不对");
}

test "值接收者：返回结构体的方法" {
    struct Vec v = { 3, 4 };
    struct Pair q = v.vec_pair();
    if (q.a != 6 || q.b != 12)
        return err(1, "v.vec_pair() 的 sret 不对");
}

test "值接收者：'!error' 方法照常传播错误" {
    struct Vec v = { 3, 4 };
    __tcc_err_clear();
    if (probe_value(v) != 30)
        return err(1, "正常路径的返回值不对");
    v.x = -1;
    if (probe_value(v) != -1)
        return err(2, "错误路径没有把错误码带回来");
    __tcc_err_clear();
}

test "值上的同名字段仍然优先于方法" {
    struct Dup d = { 4, 99 };
    if (d.dup_size != 99)
        return err(1, "字段 dup_size 没有优先");
    if (dup_size(&d) != 8)
        return err(2, "同名方法本身仍然可以普通调用");
}

test "泛型实例的值也能点调用方法" {
    int a[2] = { 7, 8 };
    Vect@int v = { a, 2 };
    if (v.vat(1) != 8)
        return err(1, "值接收者的 vat 不对");
    if ((&v)->vat(0) != 7)
        return err(2, "指针接收者仍然可用");
    if (v.vat(0) != vat@int(&v, 0))
        return err(3, "v.vat(0) 与 vat@int(&v, 0) 不是同一个调用");
}

test "接口值上的点调用仍然走 vtable" {
    struct Circle c = { 2 };
    if (c.area() != 12)          /* 结构体值：方法接收者是 '&c' */
        return err(1, "结构体值上的 area 不对");
}

/* 接口值上的点调用由 vtable 分派，不被「值接收者」这条新规则接管 */
interface Weigh { int weight(); }

struct Sack { int n; };
int weight(struct Sack *s) { return s->n * 3; }

test "接口值的点调用仍然走 vtable，不是值接收者" {
    struct Sack k = { 4 };
    Weigh w = k;                 /* Sack 实现了 Weigh */
    if (w.weight() != 12)
        return err(1, "接口值的点调用没有走 vtable");
    if (k.weight() != 12)        /* 结构体值：接收者是 '&k' */
        return err(2, "结构体值上的 weight 不对");
}
