         || PA_IS_IDENT("__builtin_ctzl") || PA_IS_IDENT("__builtin_ctzll")
         || PA_IS_IDENT("__builtin_ffs") || PA_IS_IDENT("__builtin_ffsl")
         || PA_IS_IDENT("__builtin_ffsll") || PA_IS_IDENT("__builtin_popcount")
         || PA_IS_IDENT("__builtin_popcountl")
         || PA_IS_IDENT("__builtin_popcountll"))
        && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")) {
