+/* parse '#macro NAME(params) { body }' */
+static void parse_superc_macro(void)
+{
+    Sym *s, *first, **ps;
+    int v, t, t0, level;
+    int saved_parse_flags = parse_flags;
+    TokenString str;
+
+    next_nomacro();
+    v = tok;
+    if (v < TOK_IDENT || v == TOK_DEFINED)
+        tcc_error("invalid macro name '%s'", get_tok_str(tok, &tokc));
+    first = NULL;
+    t = MACRO_FUNC;
+    parse_flags = ((parse_flags & ~PARSE_FLAG_ASM_FILE) | PARSE_FLAG_SPACES);
+    next_nomacro();
+    parse_flags &= ~PARSE_FLAG_SPACES;
+    if (tok == '(') {
+        int dotid = set_idnum('.', 0);
+        next_nomacro();
+        ps = &first;
+        if (tok != ')') for (;;) {
+            int varg = tok;
+            next_nomacro();
+            if (varg < TOK_IDENT)
+        bad_list:
+                tcc_error("bad macro parameter list");
+            s = sym_push2(&define_stack, varg | SYM_FIELD, 0, 0);
+            *ps = s;
+            ps = &s->next;
+            if (tok == ')')
+                break;
+            if (tok != ',')
+                goto bad_list;
+            next_nomacro();
+        }
+        parse_flags |= PARSE_FLAG_SPACES;
+        next_nomacro();
+        set_idnum('.', dotid);
+    }
+    while (is_space(tok))
+        next_nomacro();
+    if (tok != '{')
+        tcc_error("'{' expected in '#macro' definition");
+    parse_flags |= PARSE_FLAG_ACCEPT_STRAYS | PARSE_FLAG_SPACES;
+    tok_str_new(&str);
+    t0 = 0;
+    level = 1;
+    next_nomacro();
+    while (level > 0) {
+        if (tok == TOK_EOF)
+            tcc_error("unexpected end of file in '#macro' definition");
+        if (tok == '{') {
+            level++;
+        } else if (tok == '}') {
+            level--;
+            if (level == 0)
+                break;
+        }
+        if (is_space(tok) || tok == TOK_LINEFEED) {
+            str.need_spc |= 1;
+        } else {
+            if (TOK_TWOSHARPS == tok) {
+                if (0 == t0)
+                    goto bad_twosharp;
+                tok = TOK_PPJOIN;
+                t |= MACRO_JOIN;
+            }
+            tok_str_add2_spc(&str, tok, &tokc);
+            t0 = tok;
+        }
+        next_nomacro();
+    }
+    parse_flags = saved_parse_flags;
+    tok_str_add(&str, 0);
+    if (t0 == TOK_PPJOIN)
+bad_twosharp:
+        tcc_error("'##' cannot appear at either end of macro");
+    t |= MACRO_SUPERC_LOCAL;
+    define_push(v, t, str.str, first);
+    next_nomacro();          /* consume '}' */
+}
