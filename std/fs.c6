/* std/fs：文件系统元数据与目录操作（POSIX）。
 *
 *     import std.fs;
 *
 *     StatInfo st = { 0 };
 *     fs_stat("docs/stdlib.md", &st) catch e { return e.id; };
 *     if (st.is_file)
 *         printf("%lld 字节\n", (long long)st.size);
 *
 *     Dir d = dir_open("std");
 *     Dir *pd = &d;
 *     char name[256] = { 0 };
 *     int is_dir = 0;
 *     while (pd->dir_next(name, sizeof name, &is_dir) > 0) { ... }
 *     pd->dir_close();
 *
 * 这一层是 `std.io`（流读写）的姊妹：io 管**内容**，fs 管**元数据与目录**。
 * 它比 io 更依赖宿主：用到 `stat`/`mkdir`/`opendir`/`chdir`，freestanding 目标
 * 用不了（`std.io` 至少只需要 stdio）。错误统一是 `int!error`，`errno` 被翻译
 * 成 `std.err` 的码：不存在 → `NO_ENT`、已存在 → `EXIST`、参数/不是目录 →
 * `INVAL`、其余 → `IO`。要原始 `errno` 的调用方自己直接调 POSIX。
 *
 * 约定：
 * - 路径都是 NUL 结尾的 `char *`（POSIX 接口如此）；要拼路径用 `std.path`；
 * - `fs_stat`/`fs_lstat` 只在成功时写 `*out`；
 * - `dir_next` 返回 1 取到、0 结束、-1 出错、**-2 名字比 cap 长**（不截断，
 *   让调用方把 buffer 加大再重来）；"." / ".." 照常返回，由调用方过滤；
 * - `is_dir` 取自 `dirent.d_type`；文件系统不支持时（`DT_UNKNOWN`）给 0。
 */
#include <sys/stat.h>
#include <sys/types.h>
#include <dirent.h>
#include <unistd.h>
#include <errno.h>
#include <limits.h>
#include <stdio.h>
#include <string.h>

module std.fs;
import std.types;
import std.err;

/* ---- 元数据 ---- */

struct StatInfo {
    i64 size;       /* 字节数 */
    i64 mtime;      /* 修改时间（Unix 秒） */
    u32 mode;       /* 原始 st_mode */
    int is_dir;
    int is_file;    /* 普通文件（S_ISREG） */
    int is_link;    /* 符号链接（只有 lstat 能给） */
};

/* errno -> std.err 的码；消息由调用方给（这里是出错的动作名） */
static int!error fs_fail(char *what)
{
    if (errno == ENOENT)
        return err(std.err.NO_ENT, what);
    if (errno == EEXIST)
        return err(std.err.EXIST, what);
    if (errno == EACCES || errno == EPERM || errno == EINVAL
        || errno == ENOTDIR)
        return err(std.err.INVAL, what);
    return err(std.err.IO, what);
}

static void fs_fill(StatInfo *out, struct stat *st)
{
    out->size = (i64)st->st_size;
    out->mtime = (i64)st->st_mtime;
    out->mode = (u32)st->st_mode;
    out->is_dir = S_ISDIR(st->st_mode) ? 1 : 0;
    out->is_file = S_ISREG(st->st_mode) ? 1 : 0;
    out->is_link = S_ISLNK(st->st_mode) ? 1 : 0;
}

/* 跟随符号链接的 stat */
int!error fs_stat(char *path, StatInfo *out)
{
    struct stat st = { 0 };

    if (!path || !out)
        return err(std.err.INVAL, "fs_stat: null argument");
    if (stat(path, &st) != 0) {
        try fs_fail("fs_stat");
    }
    fs_fill(out, &st);
    return 0;
}

/* 不跟随符号链接的 lstat：is_link 只有这条路径能看出来 */
int!error fs_lstat(char *path, StatInfo *out)
{
    struct stat st = { 0 };

    if (!path || !out)
        return err(std.err.INVAL, "fs_lstat: null argument");
    if (lstat(path, &st) != 0) {
        try fs_fail("fs_lstat");
    }
    fs_fill(out, &st);
    return 0;
}

/* 存在性：不区分「不存在」和「没权限」，要区分用 fs_stat */
int fs_exists(char *path)
{
    struct stat st = { 0 };

    if (!path || !*path)
        return 0;
    return stat(path, &st) == 0;
}

int fs_is_dir(char *path)
{
    struct stat st = { 0 };

    if (!path || !*path)
        return 0;
    if (stat(path, &st) != 0)
        return 0;
    return S_ISDIR(st.st_mode) ? 1 : 0;
}

int fs_is_file(char *path)
{
    struct stat st = { 0 };

    if (!path || !*path)
        return 0;
    if (stat(path, &st) != 0)
        return 0;
    return S_ISREG(st.st_mode) ? 1 : 0;
}

/* 文件大小：目录也能查（给的是目录项大小，不是递归和） */
i64!error fs_size(char *path)
{
    StatInfo st = { 0 };

    try fs_stat(path, &st);
    return st.size;
}

/* ---- 创建 / 删除 / 改名 ---- */

int!error fs_mkdir(char *path, u32 mode)
{
    if (!path || !*path)
        return err(std.err.INVAL, "fs_mkdir: empty path");
    if (mkdir(path, (mode_t)mode) != 0) {
        try fs_fail("fs_mkdir");
    }
    return 0;
}

/* 递归建目录：已存在的部分跳过（EEXIST 不视为错误）。
   路径长度上限是 PATH_MAX；超长返回 RANGE，不写任何东西。 */
int!error fs_mkdir_p(char *path, u32 mode)
{
    char buf[PATH_MAX] = { 0 };
    int len = 0, i = 0;

    if (!path || !*path)
        return err(std.err.INVAL, "fs_mkdir_p: empty path");
    len = (int)strlen(path);
    if (len >= (int)sizeof buf)
        return err(std.err.RANGE, "fs_mkdir_p: path too long");
    memcpy(buf, path, (size_t)len);
    buf[len] = 0;
    while (len > 1 && buf[len - 1] == '/')
        buf[--len] = 0;
    for (i = 1; i <= len; i++) {
        if (i < len && buf[i] != '/')
            continue;
        {
            char save = buf[i];

            buf[i] = 0;
            if (*buf && mkdir(buf, (mode_t)mode) != 0) {
                if (errno != EEXIST) {
                    buf[i] = save;
                    try fs_fail("fs_mkdir_p");
                }
            }
            buf[i] = save;
        }
    }
    return 0;
}

int!error fs_remove(char *path)
{
    if (!path || !*path)
        return err(std.err.INVAL, "fs_remove: empty path");
    if (unlink(path) != 0) {
        try fs_fail("fs_remove");
    }
    return 0;
}

int!error fs_rmdir(char *path)
{
    if (!path || !*path)
        return err(std.err.INVAL, "fs_rmdir: empty path");
    if (rmdir(path) != 0) {
        try fs_fail("fs_rmdir");
    }
    return 0;
}

int!error fs_rename(char *from, char *to)
{
    if (!from || !*from || !to || !*to)
        return err(std.err.INVAL, "fs_rename: empty path");
    if (rename(from, to) != 0) {
        try fs_fail("fs_rename");
    }
    return 0;
}

/* ---- 当前目录 ---- */

/* getcwd 写进调用方缓冲；cap 不够返回 RANGE（不写半截） */
int!error fs_getcwd(char *buf, int cap)
{
    char tmp[PATH_MAX] = { 0 };

    if (!buf || cap <= 0)
        return err(std.err.INVAL, "fs_getcwd: bad buffer");
    if (!getcwd(tmp, sizeof tmp))
        try fs_fail("fs_getcwd");
    if ((int)strlen(tmp) + 1 > cap)
        return err(std.err.RANGE, "fs_getcwd: buffer too small");
    strcpy(buf, tmp);
    return 0;
}

int!error fs_chdir(char *path)
{
    if (!path || !*path)
        return err(std.err.INVAL, "fs_chdir: empty path");
    if (chdir(path) != 0) {
        try fs_fail("fs_chdir");
    }
    return 0;
}

/* ---- 目录遍历（零分配） ---- */

struct Dir {
    DIR *d;
    int err;        /* 上一次 dir_next 失败时的 errno（0 = 没有） */
};

Dir dir_open(char *path)
{
    Dir r = { 0 };

    if (!path || !*path)
        return r;
    r.d = opendir(path);
    if (!r.d)
        r.err = errno;
    return r;
}

int dir_ok(Dir *self) { return self->d ? 1 : 0; }

/* 打开/读取失败的 errno；0 表示没有错误 */
int dir_error(Dir *self) { return self->err; }

/* 1 = 取到、0 = 结束、-1 = 出错、-2 = 名字放不下（没写 name） */
int dir_next(Dir *self, char *name, int cap, int *is_dir)
{
    struct dirent *e = 0;
    int n = 0;

    if (!self->d || !name || cap <= 0)
        return -1;
    errno = 0;
    e = readdir(self->d);
    if (!e) {
        if (errno) {
            self->err = errno;
            return -1;
        }
        return 0;
    }
    n = (int)strlen(e->d_name);
    if (n + 1 > cap)
        return -2;
    memcpy(name, e->d_name, (size_t)n);
    name[n] = 0;
    if (is_dir) {
#if defined(DT_DIR)
        *is_dir = e->d_type == DT_DIR ? 1 : 0;
#else
        *is_dir = 0;
#endif
    }
    return 1;
}

/* 回到目录开头，重新遍历 */
void dir_rewind(Dir *self)
{
    if (self->d)
        rewinddir(self->d);
}

void dir_close(Dir *self)
{
    if (self->d) {
        closedir(self->d);
        self->d = 0;
    }
}

/* ---- 自测 ---- */

/* 测试都在 build/fs-test/ 下，跑完删干净；不依赖 std.io（少一份依赖）。 */
static char *fs_test_root(void) { return (char *)"build/fs-test"; }

static int fs_put(char *path, char *text)
{
    FILE *f = fopen(path, "wb");
    int n = 0;

    if (!f)
        return -1;
    n = (int)fwrite(text, 1, strlen(text), f);
    fclose(f);
    return n;
}

test "mkdir_p 建嵌套目录、重复调用不报错" {
    int rc = 0;

    fs_mkdir_p(fs_test_root(), 0755) catch e { return err(1, "建根目录失败"); };
    fs_mkdir_p((char *)"build/fs-test/a/b/c", 0755)
        catch e { return err(2, "建嵌套目录失败"); };
    if (!fs_is_dir((char *)"build/fs-test/a/b/c"))
        return err(3, "嵌套目录不存在");
    rc = (try fs_mkdir_p((char *)"build/fs-test/a/b/c", 0755));
    if (rc != 0)
        return err(4, "重复 mkdir_p 应当成功");
}

test "stat / size / is_file / is_dir" {
    StatInfo st = { 0 };
    i64 sz = 0;

    if (fs_put((char *)"build/fs-test/a/hello.txt", (char *)"hello") != 5)
        return err(5, "写测试文件失败");
    fs_stat((char *)"build/fs-test/a/hello.txt", &st)
        catch e { return err(6, "stat 文件失败"); };
    if (!st.is_file || st.is_dir || st.is_link)
        return err(7, "文件的类型判断不对");
    if (st.size != 5)
        return err(8, "文件大小不对");
    if ((int)(st.mode & 0170000) != 0100000)
        return err(9, "st_mode 的高位不对");

    sz = (try fs_size((char *)"build/fs-test/a/hello.txt"));
    if (sz != 5)
        return err(10, "fs_size 不对");

    fs_stat((char *)"build/fs-test/a", &st) catch e { return err(11, "stat 目录失败"); };
    if (!st.is_dir || st.is_file)
        return err(12, "目录的类型判断不对");
    if (fs_is_dir((char *)"build/fs-test/a") != 1
        || fs_is_file((char *)"build/fs-test/a") != 0)
        return err(13, "is_dir / is_file 不对");
    if (fs_exists((char *)"build/fs-test/a/hello.txt") != 1
        || fs_exists((char *)"build/fs-test/nope") != 0)
        return err(14, "exists 不对");
}

test "不存在的路径返回 NO_ENT，不写 *out" {
    StatInfo st = { 0 };
    int seen = -1;

    st.size = 123;
    fs_stat((char *)"build/fs-test/definitely-not-here", &st) catch e {
        seen = e.id;
        goto checked;
    };
    return err(15, "不存在的路径没有报错");
checked:
    if (seen != std.err.NO_ENT)
        return err(16, "错误码不是 NO_ENT");
    if (st.size != 123)
        return err(17, "失败时改了 *out");

    seen = -1;
    fs_remove((char *)"build/fs-test/definitely-not-here") catch e {
        seen = e.id;
        goto checked2;
    };
    return err(18, "删不存在的文件没有报错");
checked2:
    if (seen != std.err.NO_ENT)
        return err(19, "fs_remove 的错误码不是 NO_ENT");
}

test "目录遍历：数量、名字、is_dir" {
    Dir d = dir_open((char *)"build/fs-test");
    Dir *pd = &d;
    char name[256] = { 0 };
    int is_dir = 0, n = 0, saw_a = 0, saw_none_entries = 0, rc = 0;

    if (!pd->dir_ok())
        return err(20, "dir_open 失败");
    while ((rc = pd->dir_next(name, sizeof name, &is_dir)) > 0) {
        n++;
        if (strcmp(name, "a") == 0) {
            saw_a = 1;
            if (!is_dir)
                return err(21, "子目录的 is_dir 是 0");
        }
        if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0)
            saw_none_entries = 1;
    }
    if (rc != 0)
        return err(22, "dir_next 返回了错误");
    if (n < 2 || !saw_a || !saw_none_entries)
        return err(23, "目录项不全");
    pd->dir_rewind();
    pd->dir_close();
    pd->dir_close();
    if (pd->dir_ok())
        return err(24, "close 之后仍然 ok");
}

test "dir_next 的 buffer 太小返回 -2 且不写" {
    Dir d = dir_open((char *)"build/fs-test");
    Dir *pd = &d;
    char tiny[1] = { 'X' };
    int rc = 0;
    Dir missing = { 0 };

    if (!pd->dir_ok())
        return err(25, "dir_open 失败");
    rc = pd->dir_next(tiny, sizeof tiny, 0);
    if (rc != -2)
        return err(26, "buffer 太小时应当返回 -2");
    if (tiny[0] != 'X')
        return err(27, "buffer 太小时写了内容");
    pd->dir_close();
    missing = dir_open((char *)"build/fs-test/no-such-dir");
    if ((&missing)->dir_ok())
        return err(28, "不存在的目录不该打开成功");
}

test "rename / remove / rmdir 的生命周期" {
    StatInfo st = { 0 };

    if (fs_put((char *)"build/fs-test/a/tmp.txt", (char *)"abc") != 3)
        return err(29, "写临时文件失败");
    fs_rename((char *)"build/fs-test/a/tmp.txt",
              (char *)"build/fs-test/a/moved.txt")
        catch e { return err(30, "rename 失败"); };
    if (fs_exists((char *)"build/fs-test/a/tmp.txt") != 0)
        return err(31, "旧名字还在");
    if (!fs_exists((char *)"build/fs-test/a/moved.txt"))
        return err(32, "新名字不存在");
    fs_stat((char *)"build/fs-test/a/moved.txt", &st)
        catch e { return err(33, "改名后 stat 失败"); };
    if (st.size != 3)
        return err(34, "改名后内容长度不对");
    fs_remove((char *)"build/fs-test/a/moved.txt")
        catch e { return err(35, "remove 失败"); };
    if (fs_exists((char *)"build/fs-test/a/moved.txt") != 0)
        return err(36, "remove 之后文件还在");
    fs_remove((char *)"build/fs-test/a/hello.txt")
        catch e { return err(37, "remove hello 失败"); };
    fs_rmdir((char *)"build/fs-test/a/b/c")
        catch e { return err(38, "rmdir c 失败"); };
    fs_rmdir((char *)"build/fs-test/a/b")
        catch e { return err(39, "rmdir b 失败"); };
    fs_rmdir((char *)"build/fs-test/a")
        catch e { return err(40, "rmdir a 失败"); };
    fs_rmdir((char *)"build/fs-test")
        catch e { return err(41, "rmdir 根目录失败"); };
    if (fs_exists((char *)"build/fs-test") != 0)
        return err(42, "清理之后目录还在");
}

test "getcwd / chdir 往返" {
    char cwd[PATH_MAX] = { 0 };
    char back[PATH_MAX] = { 0 };

    fs_mkdir_p((char *)"build", 0755) catch e { return err(43, "建 build 失败"); };
    fs_getcwd(cwd, sizeof cwd) catch e { return err(43, "getcwd 失败"); };
    fs_chdir((char *)"build") catch e { return err(44, "chdir build 失败"); };
    fs_getcwd(back, sizeof back) catch e { return err(45, "chdir 之后 getcwd 失败"); };
    if (strlen(back) <= strlen(cwd))
        return err(46, "chdir 之后路径没有变长");
    fs_chdir(cwd) catch e { return err(47, "chdir 回去失败"); };
    fs_getcwd(back, sizeof back) catch e { return err(48, "回去之后 getcwd 失败"); };
    if (strcmp(cwd, back) != 0)
        return err(49, "chdir 往返没有回到原目录");
    fs_getcwd(back, 4) catch e {
        if (e.id != std.err.RANGE)
            return err(50, "buffer 太小时错误码不是 RANGE");
        goto small_ok;
    };
    return err(51, "buffer 太小时没有报错");
small_ok:
    if (strlen(back) != 0 && strcmp(back, cwd) != 0)
        return err(52, "buffer 太小时写了半截");
}
