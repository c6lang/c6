/* std/env：环境变量与命令行参数。
 *
 *     import std.env;
 *
 *     Str home = env_home();                        // HOME，缺省 ""
 *     int  jobs = env_get_int((char *)"C6_JOBS", 4);
 *     Str  user = env_get_or((char *)"USER", (char *)"nobody");
 *
 *     int main(int argc, char **argv) {
 *         env_args(argc, argv);                     // 只喂一次，模块自己记着
 *         Str prog = env_prog();                    // argv[0]
 *         ...
 *     }
 *
 * 这一层是宿主环境的门面：环境变量靠 `getenv`/`setenv`/`unsetenv`（也就是
 * environ），命令行靠入口喂进来的 `argc`/`argv`——`import` 只带来声明，模块
 * 拿不到真实的 main 参数，所以必须由入口调一次 `env_args`。
 *
 * 因此它**依赖宿主提供 environ**：POSIX 主机上没问题，freestanding / 裸机目标
 * 没有环境块，用不了（`std.io` 至少只要 stdio，这一层比它更靠外）。
 *
 * 约定：
 * - `env_get` 返回的是 **environ 里的视图**：不分配、不复制。它活到下一次
 *   `env_set`/`env_unset` 为止（POSIX 允许它们重排、释放环境块），所以「先读出
 *   来、再改变量」的代码要先把值拷进自己的缓冲——`env_take` 就是干这个的；
 *   否则用 `env_get_or` 只读一次就完事，或者自己 `memcpy` 走。
 *   变量**没设**时给的视图是 `data == 0 && len == 0`，据此可以和「设成空串」
 *   （`data` 非 0、`len == 0`）区分开。
 * - 名字为 0 或空串一律 `INVAL`；`env_set` 的 `value == 0` 按空串处理（写一个
 *   空变量，而不是删掉它）；`env_unset` 删不存在的变量不算错（POSIX 语义，
 *   可重复调用）。
 * - 错误码：参数空 → `INVAL`、宿主没内存（ENOMEM）→ `NOMEM`、名字里带 `=`
 *   （setenv 的 EINVAL）→ `INVAL`、其余 → `IO`；`NO_ENT` 只给 `env_take`
 *   （变量不存在）。
 * - 数值解析是**严格**的：可选 `+`/`-`、至少一位十进制数字、其余只允许尾部
 *   空白；前后空白忽略；语法错或溢出都回落到调用方给的默认值。空白认 C 的
 *   整个 isspace 集合（比 `std.str` 的 trim 多 `\v`/`\f`）。
 * - `env_get_u64` 不接受负号（`-0` 也算），只有成功才写 `*out`。
 * - `env_get_bool` 认 `1/true/yes/on` 和 `0/false/no/off`，大小写不敏感，
 *   前后空白忽略，其余情况给默认值。
 *
 * 便捷读法（缺省值只在变量**没设**时生效；设成空串就按空串给）：
 *
 *     env_home()    HOME    ""
 *     env_tmpdir()  TMPDIR  "/tmp"
 *     env_path()    PATH    "/usr/bin:/bin"
 *     env_user()    USER    ""
 */
#include <stdlib.h>
#include <string.h>
#include <limits.h>
#include <errno.h>

module std.env;
import std.types;
import std.err;
import std.str;

enum Error {
    INVAL  = 1,
    NOMEM  = 3,
    IO     = 4,
    NO_ENT = 12,   /* 只给 env_take；查询/删除按 POSIX 语义不报「不存在」 */
};

/* u64 的上界：写成十六进制，免得十进制字面量本身被溢出检查卡住 */
#define ENV_U64_MAX 0xffffffffffffffffull

/* ---- 内部工具 ---- */

/* 空白集合：C 的 isspace 全集（`std.str` 的 trim 认的是它的子集） */
static int env_space(char c)
{
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'
        || c == '\v' || c == '\f';
}

/* errno -> std.env 的错误码；消息用出错的动作名 */
static int!error env_fail(char *what)
{
    if (errno == EINVAL)
        return err(INVAL, what);
    if (errno == ENOMEM)
        return err(NOMEM, what);
    return err(IO, what);
}

struct EnvNum {
    int ok;     /* 1 = 语法合法且幅值没溢出 */
    int neg;    /* 带负号 */
    u64 mag;    /* 无符号幅值 */
};

/* 严格十进制扫描：前后空白忽略、可选 +/-、至少一位数字、其余字符一律算错。
   溢出时 `ok` 保持 0（幅值不再有意义）。 */
static EnvNum env_scan(char[:] s)
{
    EnvNum r = { 0, 0, 0ull };
    int i = 0, ndig = 0;

    if (!s.data || s.len <= 0)
        return r;
    while (i < s.len && env_space(s.data[i]))
        i++;
    if (i < s.len && (s.data[i] == '+' || s.data[i] == '-')) {
        r.neg = s.data[i] == '-' ? 1 : 0;
        i++;
    }
    while (i < s.len && s.data[i] >= '0' && s.data[i] <= '9') {
        int d = (int)(s.data[i] - '0');

        if (r.mag > (ENV_U64_MAX - (u64)d) / 10ull)
            return r;               /* 溢出：ok 还是 0 */
        r.mag = r.mag * 10ull + (u64)d;
        ndig++;
        i++;
    }
    if (ndig == 0)                  /* 只有符号、什么都没有 */
        return r;
    while (i < s.len && env_space(s.data[i]))
        i++;
    if (i != s.len)                 /* 尾巴上有非空白字符 */
        return r;
    r.ok = 1;
    return r;
}

/* 去掉两端空白，返回新视图（不改入参） */
static char[:] env_trim(char[:] s)
{
    int b = 0, e = s.len;

    if (!s.data)
        return s;
    while (b < e && env_space(s.data[b]))
        b++;
    while (e > b && env_space(s.data[e - 1]))
        e--;
    return (char[:]){ s.data + b, e - b };
}

/* 小写化后比字面量（len 必须完全相等） */
static int env_ieq(char[:] s, char *lit)
{
    int i = 0, n = 0;

    if (!lit)
        return 0;
    n = (int)strlen(lit);
    if (s.len != n)
        return 0;
    for (i = 0; i < n; i++) {
        char a = s.data[i];

        if (a >= 'A' && a <= 'Z')
            a = (char)(a - 'A' + 'a');
        if (a != lit[i])
            return 0;
    }
    return 1;
}

/* ---- 环境变量 ---- */

/* environ 里的视图；没设时给 data == 0 的空视图 */
Str env_get(char *name)
{
    Str r = { (char[:]){ 0, 0 } };
    char *v = 0;

    if (!name || !name[0])
        return r;
    v = getenv(name);
    if (!v)
        return r;
    r.s = (char[:]){ v, (int)strlen(v) };
    return r;
}

int env_has(char *name)
{
    if (!name || !name[0])
        return 0;
    return getenv(name) ? 1 : 0;
}

/* 有就给变量值的视图，没有就给 dflt 的视图（dflt 为 0 时给空视图） */
Str env_get_or(char *name, char *dflt)
{
    Str r = env_get(name);

    if (r.s.data)
        return r;
    return str(dflt);
}

/* setenv(name, value, 1)：覆盖已有变量；value == 0 当空串 */
int!error env_set(char *name, char *value)
{
    if (!name || !name[0])
        return err(INVAL, (char *)"env_set: empty name");
    if (setenv(name, value ? value : (char *)"", 1) != 0) {
        try env_fail((char *)"env_set");
    }
    return 0;
}

int!error env_unset(char *name)
{
    if (!name || !name[0])
        return err(INVAL, (char *)"env_unset: empty name");
    if (unsetenv(name) != 0) {
        try env_fail((char *)"env_unset");
    }
    return 0;
}

/* 取走：把旧值拷进调用方缓冲，然后删掉变量。变量不存在 → NO_ENT，
   缓冲放不下（含结尾 NUL）→ INVAL。拷贝在 unset 之前做完，所以不存在
   「视图被自己 invalidate」的问题（env_get + env_unset 的组合版）。 */
int!error env_take(char *name, char *out, int cap)
{
    Str v = { (char[:]){ 0, 0 } };

    if (!name || !name[0])
        return err(INVAL, (char *)"env_take: empty name");
    v = env_get(name);
    if (!v.s.data)
        return err(NO_ENT, (char *)"env_take: not set");
    if (!out || cap <= v.s.len)
        return err(INVAL, (char *)"env_take: buffer too small");
    if (v.s.len > 0)
        memcpy(out, v.s.data, (usize)v.s.len);
    out[v.s.len] = 0;
    if (unsetenv(name) != 0) {
        try env_fail((char *)"env_unset");
    }
    return 0;
}

Str env_home(void) { return env_get_or((char *)"HOME", (char *)""); }
Str env_tmpdir(void) { return env_get_or((char *)"TMPDIR", (char *)"/tmp"); }
Str env_path(void) { return env_get_or((char *)"PATH", (char *)"/usr/bin:/bin"); }
Str env_user(void) { return env_get_or((char *)"USER", (char *)""); }

/* ---- 数值 / 布尔 ---- */

/* 严格十进制；不存在、语法错、超 int 范围都给 def */
int env_get_int(char *name, int def)
{
    Str v = env_get(name);
    EnvNum n = env_scan(v.s);

    if (!n.ok)
        return def;
    if (n.neg) {
        if (n.mag > (u64)INT_MAX + 1ull)
            return def;
        if (n.mag == (u64)INT_MAX + 1ull)
            return INT_MIN;         /* -2147483648：取负会溢出，直接给常量 */
        return -(int)n.mag;
    }
    if (n.mag > (u64)INT_MAX)
        return def;
    return (int)n.mag;
}

/* 存在且合法才写 *out 并返回 1；负号、语法错、溢出、*out 为空都给 0。
   `def` 不参与判断（契约是「失败不写 *out」），保留它只为和 env_get_int 对称、
   让调用点读起来像个默认值。 */
int env_get_u64(char *name, u64 def, u64 *out)
{
    Str v = env_get(name);
    EnvNum n = env_scan(v.s);

    if (!out)
        return 0;
    if (!n.ok || n.neg)
        return 0;
    *out = n.mag;
    return 1;
}

int env_get_bool(char *name, int def)
{
    Str v = env_get(name);
    char[:] t = env_trim(v.s);

    if (env_ieq(t, (char *)"1") || env_ieq(t, (char *)"true")
        || env_ieq(t, (char *)"yes") || env_ieq(t, (char *)"on"))
        return 1;
    if (env_ieq(t, (char *)"0") || env_ieq(t, (char *)"false")
        || env_ieq(t, (char *)"no") || env_ieq(t, (char *)"off"))
        return 0;
    return def;
}

/* ---- 命令行 ----
   argv 只是存指针：不复制字符串，生命周期由入口保证（main 的 argv 通常活到
   进程结束，够用）。没调过 env_args 时 argc 是 0、所有查询给空串。 */

static int env_argc_v;
static char **env_argv_v;

void env_args(int argc, char **argv)
{
    if (!argv || argc <= 0) {
        env_argc_v = 0;
        env_argv_v = 0;
        return;
    }
    env_argc_v = argc;
    env_argv_v = argv;
}

int env_argc(void) { return env_argc_v; }

Str env_arg(int i)
{
    Str r = { (char[:]){ 0, 0 } };

    if (!env_argv_v || i < 0 || i >= env_argc_v)
        return r;
    return str(env_argv_v[i]);
}

Str env_prog(void) { return env_arg(0); }

/* ---- 自测 ---- */

/* S() 这类宏不随 import 传递：谁的代码里用，谁自己定义一次 */
#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "env_set/env_get/env_has 的往返与覆盖" {
    Str v = { (char[:]){ 0, 0 } };

    env_set((char *)"C6_TEST_ENV_A", (char *)"hello") catch e {
        return err(1, "env_set 失败");
    };
    if (!env_has((char *)"C6_TEST_ENV_A"))
        return err(2, "env_has 没看到刚设的变量");
    v = env_get((char *)"C6_TEST_ENV_A");
    if (!(&v)->eq(S("hello")))
        return err(3, "env_get 的值不对");
    if ((&v)->count() != 5)
        return err(4, "env_get 的长度不对");
    env_set((char *)"C6_TEST_ENV_A", (char *)"world!") catch e {
        return err(5, "覆盖写失败");
    };
    v = env_get((char *)"C6_TEST_ENV_A");
    if (!(&v)->eq(S("world!")))
        return err(6, "覆盖之后的值不对");
    env_unset((char *)"C6_TEST_ENV_A") catch e {
        return err(7, "env_unset 失败");
    };
    if (env_has((char *)"C6_TEST_ENV_A"))
        return err(8, "unset 之后 env_has 仍然是 1");
    v = env_get((char *)"C6_TEST_ENV_A");
    if ((&v)->count() != 0 || v.s.data != 0)
        return err(9, "unset 之后视图不是空视图");
    env_unset((char *)"C6_TEST_ENV_A") catch e {
        return err(10, "删不存在的变量不该报错");
    };
}

test "空值仍算存在，value == 0 按空串写" {
    Str v = { (char[:]){ 0, 0 } };

    env_set((char *)"C6_TEST_ENV_B", (char *)"") catch e {
        return err(11, "设为空串失败");
    };
    if (!env_has((char *)"C6_TEST_ENV_B"))
        return err(12, "空值变量不算存在");
    v = env_get((char *)"C6_TEST_ENV_B");
    if ((&v)->count() != 0)
        return err(13, "空值变量读出来不是空串");
    if (!v.s.data)
        return err(14, "空值变量的视图没有数据指针（和「没设」混了）");
    env_set((char *)"C6_TEST_ENV_B", (char *)0) catch e {
        return err(15, "value == 0 没有按空串处理");
    };
    if (!env_has((char *)"C6_TEST_ENV_B"))
        return err(16, "value == 0 之后变量不存在了");
    env_unset((char *)"C6_TEST_ENV_B") catch e {
        return err(17, "清理失败");
    };
    if (env_has((char *)"C6_TEST_ENV_B"))
        return err(18, "清理之后变量还在");
}

test "参数为空返回 INVAL" {
    int id = 0;

    env_set((char *)0, (char *)"v") catch e { id = e.id; goto set_null; };
    return err(19, "env_set(name == 0) 没有报错");
set_null:
    if (id != INVAL)
        return err(20, "env_set(NULL) 的错误码不是 INVAL");

    id = 0;
    env_set((char *)"", (char *)"v") catch e { id = e.id; goto set_empty; };
    return err(21, "env_set(name == \"\") 没有报错");
set_empty:
    if (id != INVAL)
        return err(22, "env_set(\"\") 的错误码不是 INVAL");

    id = 0;
    env_unset((char *)0) catch e { id = e.id; goto unset_null; };
    return err(23, "env_unset(name == 0) 没有报错");
unset_null:
    if (id != INVAL)
        return err(24, "env_unset(NULL) 的错误码不是 INVAL");

    id = 0;
    env_unset((char *)"") catch e { id = e.id; goto unset_empty; };
    return err(25, "env_unset(name == \"\") 没有报错");
unset_empty:
    if (id != INVAL)
        return err(26, "env_unset(\"\") 的错误码不是 INVAL");

    /* 名字里带 '='：setenv 给 EINVAL，我们翻译成 INVAL */
    id = 0;
    env_set((char *)"C6=A", (char *)"v") catch e { id = e.id; goto set_eq; };
    return err(27, "名字里带 '=' 没有报错");
set_eq:
    if (id != INVAL)
        return err(28, "名字带 '=' 的错误码不是 INVAL");
}

test "错误码落在 std.env 自己的号段" {
    /* id = (area << 27) | (slot << 12) | code，std.env 的 slot 是 0x601c */
    if ((INVAL & 0xfff) != 1)
        return err(29, "INVAL 的 code 不是 1");
    if (((INVAL >> 12) & 0x7fff) != 0x601c)
        return err(30, "INVAL 没有落在 std.env 的号段");
    if (INVAL == std.err.INVAL)
        return err(31, "std.env 的错误码和 std.err 撞了");
    if (NO_ENT == std.err.NO_ENT)
        return err(32, "std.env 的错误码和 std.err 撞了");
}

test "env_take 拷出旧值并删掉变量" {
    char buf[8] = { 'X', 'X', 'X', 'X', 'X', 'X', 'X', 'X' };
    int id = 0;

    env_set((char *)"C6_TEST_ENV_T", (char *)"abc") catch e {
        return err(33, "env_set 失败");
    };
    env_take((char *)"C6_TEST_ENV_T", buf, (int)sizeof buf) catch e {
        return err(34, "env_take 失败");
    };
    if (strcmp(buf, "abc") != 0)
        return err(35, "env_take 没有把旧值拷出来");
    if (env_has((char *)"C6_TEST_ENV_T"))
        return err(36, "env_take 之后变量还在");

    env_take((char *)"C6_TEST_ENV_T", buf, (int)sizeof buf) catch e {
        id = e.id;
        goto take_missing;
    };
    return err(37, "取不存在的变量没有报错");
take_missing:
    if (id != NO_ENT)
        return err(38, "env_take 不存在的变量时错误码不是 NO_ENT");

    env_set((char *)"C6_TEST_ENV_T", (char *)"abcdefgh") catch e {
        return err(39, "env_set 失败");
    };
    id = 0;
    env_take((char *)"C6_TEST_ENV_T", buf, 4) catch e { id = e.id; goto take_small; };
    return err(40, "缓冲太小时没有报错");
take_small:
    if (id != INVAL)
        return err(41, "缓冲太小时的错误码不是 INVAL");
    if (!env_has((char *)"C6_TEST_ENV_T"))
        return err(42, "失败时不该删掉变量");
    env_unset((char *)"C6_TEST_ENV_T") catch e {
        return err(43, "清理失败");
    };
}

test "env_get_int：正负号、空白与边界" {
    char *n = (char *)"C6_TEST_ENV_I";

    env_set(n, (char *)"42") catch e { return err(44, "env_set 失败"); };
    if (env_get_int(n, -1) != 42)
        return err(45, "正整数没解析出来");
    env_set(n, (char *)"  -7\t") catch e { return err(46, "env_set 失败"); };
    if (env_get_int(n, 0) != -7)
        return err(47, "负号或空白没处理好");
    env_set(n, (char *)"+13") catch e { return err(48, "env_set 失败"); };
    if (env_get_int(n, 0) != 13)
        return err(49, "前导 + 没处理好");
    env_set(n, (char *)"0") catch e { return err(50, "env_set 失败"); };
    if (env_get_int(n, 7) != 0)
        return err(51, "0 被当成没设了");
    env_set(n, (char *)"2147483647") catch e { return err(52, "env_set 失败"); };
    if (env_get_int(n, 0) != 2147483647)
        return err(53, "INT_MAX 没解析出来");
    env_set(n, (char *)"-2147483648") catch e { return err(54, "env_set 失败"); };
    if (env_get_int(n, 0) != (-2147483647 - 1))
        return err(55, "INT_MIN 没解析出来（取负溢出了？）");
    env_unset(n) catch e { return err(56, "清理失败"); };
}

test "env_get_int：语法错与溢出回落到 def" {
    char *n = (char *)"C6_TEST_ENV_I";

    env_set(n, (char *)"12x") catch e { return err(57, "env_set 失败"); };
    if (env_get_int(n, 99) != 99)
        return err(58, "\"12x\" 没有回落到 def");
    env_set(n, (char *)"1 2") catch e { return err(59, "env_set 失败"); };
    if (env_get_int(n, 99) != 99)
        return err(60, "\"1 2\" 没有回落到 def");
    env_set(n, (char *)"   ") catch e { return err(61, "env_set 失败"); };
    if (env_get_int(n, 99) != 99)
        return err(62, "全空白没有回落到 def");
    env_set(n, (char *)"") catch e { return err(63, "env_set 失败"); };
    if (env_get_int(n, 99) != 99)
        return err(64, "空串没有回落到 def");
    env_set(n, (char *)"-") catch e { return err(65, "env_set 失败"); };
    if (env_get_int(n, 99) != 99)
        return err(66, "只有符号没有回落到 def");
    env_set(n, (char *)"99999999999999999999") catch e {
        return err(67, "env_set 失败");
    };
    if (env_get_int(n, 99) != 99)
        return err(68, "超长正整数没有回落到 def");
    env_set(n, (char *)"-99999999999999999999") catch e {
        return err(69, "env_set 失败");
    };
    if (env_get_int(n, 99) != 99)
        return err(70, "超长负整数没有回落到 def");
    env_set(n, (char *)"2147483648") catch e { return err(71, "env_set 失败"); };
    if (env_get_int(n, 99) != 99)
        return err(72, "INT_MAX + 1 没有回落到 def");
    env_set(n, (char *)"-2147483649") catch e { return err(73, "env_set 失败"); };
    if (env_get_int(n, 99) != 99)
        return err(74, "INT_MIN - 1 没有回落到 def");
    env_unset(n) catch e { return err(75, "清理失败"); };
    if (env_get_int(n, 5) != 5)
        return err(76, "不存在的变量没有回落到 def");
    if (env_get_int((char *)0, 6) != 6 || env_get_int((char *)"", 7) != 7)
        return err(77, "name 为空时没有回落到 def");
}

test "env_get_u64：合法才写 *out，负号被拒" {
    char *n = (char *)"C6_TEST_ENV_U";
    u64 out = 0ull;

    env_set(n, (char *)"0") catch e { return err(78, "env_set 失败"); };
    out = 1ull;
    if (!env_get_u64(n, 0ull, &out) || out != 0ull)
        return err(79, "\"0\" 没有写出 0");
    env_set(n, (char *)" 12345 ") catch e { return err(80, "env_set 失败"); };
    if (!env_get_u64(n, 0ull, &out) || out != 12345ull)
        return err(81, "带空白的中等数没解析出来");
    env_set(n, (char *)"+9") catch e { return err(82, "env_set 失败"); };
    if (!env_get_u64(n, 0ull, &out) || out != 9ull)
        return err(83, "前导 + 没处理好");
    env_set(n, (char *)"18446744073709551615") catch e {
        return err(84, "env_set 失败");
    };
    if (!env_get_u64(n, 0ull, &out) || out != 0xffffffffffffffffull)
        return err(85, "u64 上界没解析出来");

    out = 4242ull;
    env_set(n, (char *)"-1") catch e { return err(86, "env_set 失败"); };
    if (env_get_u64(n, 0ull, &out) != 0)
        return err(87, "负号没有被拒");
    if (out != 4242ull)
        return err(88, "失败时写了 *out");
    env_set(n, (char *)"-0") catch e { return err(89, "env_set 失败"); };
    if (env_get_u64(n, 0ull, &out) != 0)
        return err(90, "\"-0\" 没有按负号拒掉");
    env_set(n, (char *)"18446744073709551616") catch e {
        return err(91, "env_set 失败");
    };
    if (env_get_u64(n, 0ull, &out) != 0 || out != 4242ull)
        return err(92, "u64 上界 + 1 没有失败或写了 *out");
    env_unset(n) catch e { return err(93, "清理失败"); };
    if (env_get_u64(n, 0ull, &out) != 0 || out != 4242ull)
        return err(94, "不存在的变量没有失败或写了 *out");
    if (env_get_u64(n, 0ull, (u64 *)0) != 0)
        return err(95, "out == 0 时应当返回 0");
}

test "env_get_bool：真假词表与默认值" {
    char *n = (char *)"C6_TEST_ENV_BOOL";

    env_set(n, (char *)"YES") catch e { return err(96, "env_set 失败"); };
    if (env_get_bool(n, 0) != 1)
        return err(97, "\"YES\" 不算真");
    env_set(n, (char *)" True ") catch e { return err(98, "env_set 失败"); };
    if (env_get_bool(n, 0) != 1)
        return err(99, "\" True \" 不算真");
    env_set(n, (char *)"on") catch e { return err(100, "env_set 失败"); };
    if (env_get_bool(n, 0) != 1)
        return err(101, "\"on\" 不算真");
    env_set(n, (char *)"off") catch e { return err(102, "env_set 失败"); };
    if (env_get_bool(n, 1) != 0)
        return err(103, "\"off\" 不算假");
    env_set(n, (char *)"nO") catch e { return err(104, "env_set 失败"); };
    if (env_get_bool(n, 1) != 0)
        return err(105, "\"nO\" 不算假");
    env_set(n, (char *)"2") catch e { return err(106, "env_set 失败"); };
    if (env_get_bool(n, 1) != 1)
        return err(107, "\"2\" 没有回落到 def（1）");
    if (env_get_bool(n, 0) != 0)
        return err(108, "\"2\" 没有回落到 def（0）");
    env_set(n, (char *)"") catch e { return err(109, "env_set 失败"); };
    if (env_get_bool(n, 1) != 1)
        return err(110, "空串没有回落到 def");
    env_unset(n) catch e { return err(111, "清理失败"); };
    if (env_get_bool(n, 1) != 1)
        return err(112, "不存在的变量没有回落到 def");
    if (env_get_bool((char *)0, 1) != 1)
        return err(113, "name 为 0 时没有回落到 def");
}

test "env_args 之后 env_argc/env_arg 就位" {
    char *argv[3] = { (char *)"myprog", (char *)"--flag", (char *)"x y" };
    Str s = { (char[:]){ 0, 0 } };

    env_args(3, argv);
    if (env_argc() != 3)
        return err(114, "env_argc 不是 3");
    s = env_arg(0);
    if (!(&s)->eq(S("myprog")))
        return err(115, "argv[0] 不对");
    s = env_arg(1);
    if (!(&s)->eq(S("--flag")))
        return err(116, "argv[1] 不对");
    s = env_arg(2);
    if ((&s)->count() != 3 || !(&s)->eq(S("x y")))
        return err(117, "argv[2] 不对（含空格的参数被截了？）");
    s = env_arg(3);
    if ((&s)->count() != 0)
        return err(118, "越界应当给空串");
    s = env_arg(-1);
    if ((&s)->count() != 0)
        return err(119, "负下标应当给空串");
    if (env_argc() != 3)
        return err(120, "env_arg 改动了 env_argc");
}

test "env_args 对空 argv 与空槽是安全的" {
    char *argv[2] = { (char *)"p", (char *)0 };
    Str s = { (char[:]){ 0, 0 } };

    env_args(2, argv);
    s = env_arg(0);
    if (!(&s)->eq(S("p")))
        return err(121, "argv[0] 不对");
    s = env_arg(1);
    if ((&s)->count() != 0)
        return err(122, "空槽应当给空串");
    env_args(0, argv);
    if (env_argc() != 0)
        return err(123, "argc 0 没有生效");
    s = env_arg(0);
    if ((&s)->count() != 0)
        return err(124, "argc == 0 之后 arg(0) 不是空串");
    env_args(3, (char **)0);
    if (env_argc() != 0)
        return err(125, "argv == 0 时 argc 应当是 0");
    if (env_arg(0).s.len != 0)
        return err(126, "argv == 0 时 arg(0) 不是空串");
}

test "env_prog 给 argv[0]，没有 argv 时是空串" {
    char *argv[1] = { (char *)"tool" };
    Str p = { (char[:]){ 0, 0 } };

    env_args(1, argv);
    p = env_prog();
    if (!(&p)->eq(S("tool")))
        return err(127, "env_prog 不是 argv[0]");
    if ((&p)->count() != 4)
        return err(128, "env_prog 的长度不对");
    env_args(0, (char **)0);
    p = env_prog();
    if ((&p)->count() != 0 || !(&p)->is_empty())
        return err(129, "没有 argv 时 env_prog 不是空串");
}

test "env_tmpdir 的默认值就是 /tmp" {
    char saved[256] = { 0 };
    Str hv = env_get((char *)"TMPDIR");
    int had = env_has((char *)"TMPDIR");
    int n = 0;
    Str d = { (char[:]){ 0, 0 } };

    if (had)
        n = (&hv)->copy_to(saved, (int)sizeof saved);
    if (!had || n >= 0) {
        /* TMPDIR 存在时先拿掉，好确定「没有变量」时的默认值真的是 /tmp */
        if (had)
            env_unset((char *)"TMPDIR") catch e {
                return err(130, "清 TMPDIR 失败");
            };
        d = env_tmpdir();
        if ((&d)->count() <= 0)
            return err(131, "TMPDIR 不存在时 env_tmpdir 给了空串");
        if (!(&d)->eq(S("/tmp")))
            return err(132, "TMPDIR 不存在时 env_tmpdir 不是 /tmp");
        if (had)
            env_set((char *)"TMPDIR", saved) catch e {
                return err(133, "还原 TMPDIR 失败");
            };
        if (had && !env_has((char *)"TMPDIR"))
            return err(134, "TMPDIR 没有还原");
    }
    /* 有 TMPDIR 时它必须和变量一致（不能自己编一个） */
    d = env_tmpdir();
    hv = env_get((char *)"TMPDIR");
    if (env_has((char *)"TMPDIR") && (&d)->cmp(hv.s) != 0)
        return err(135, "env_tmpdir 和 TMPDIR 的当前值不一致");
}

test "env_home/env_path/env_user 与 env_get_or 的默认视图" {
    Str hv = env_get((char *)"HOME");
    Str pv = env_get((char *)"PATH");
    Str uv = env_get((char *)"USER");
    Str h = env_home();
    Str p = env_path();
    Str u = env_user();
    Str d = { (char[:]){ 0, 0 } };

    if (env_has((char *)"HOME") && (&h)->cmp(hv.s) != 0)
        return err(136, "env_home 和 HOME 不一致");
    if (!env_has((char *)"HOME") && (&h)->count() != 0)
        return err(137, "HOME 不存在时 env_home 不是空串");
    if (env_has((char *)"USER") && (&u)->cmp(uv.s) != 0)
        return err(138, "env_user 和 USER 不一致");
    if (env_has((char *)"PATH")) {
        if ((&p)->cmp(pv.s) != 0)
            return err(139, "env_path 和 PATH 不一致");
    } else {
        if (!(&p)->eq(S("/usr/bin:/bin")))
            return err(140, "PATH 不存在时 env_path 不是 /usr/bin:/bin");
    }

    /* 默认视图不依赖宿主：变量不存在时给 dflt 的视图 */
    env_unset((char *)"C6_TEST_ENV_ABSENT") catch e {
        return err(141, "env_unset 失败");
    };
    d = env_get_or((char *)"C6_TEST_ENV_ABSENT", (char *)"/tmp");
    if (!(&d)->eq(S("/tmp")))
        return err(142, "env_get_or 没有给默认视图");
    env_set((char *)"C6_TEST_ENV_D", (char *)"v") catch e {
        return err(143, "env_set 失败");
    };
    d = env_get_or((char *)"C6_TEST_ENV_D", (char *)"fallback");
    if (!(&d)->eq(S("v")))
        return err(144, "变量存在时 env_get_or 没有给变量值");
    env_unset((char *)"C6_TEST_ENV_D") catch e {
        return err(145, "清理失败");
    };
    d = env_get_or((char *)"C6_TEST_ENV_D", (char *)0);
    if ((&d)->count() != 0)
        return err(146, "dflt == 0 时应当给空视图");
    d = env_get((char *)0);
    if ((&d)->count() != 0 || env_has((char *)0) != 0)
        return err(147, "name 为 0 时 env_get/env_has 不安全");
}
