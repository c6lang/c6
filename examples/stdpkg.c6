/* examples/stdpkg.c6 —— 第五十七批（目标文件与包）的集成示例。
 *
 *     cmake --build build --target std-pkg
 *
 * 四节：`ar` 归档、COFF 目标文件、Java `.class`、RPM 包头。
 * 全部用**结构体方法**（`doc.open` / `doc.next` / `doc.section` / `doc.get`）。
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.text.str;
import std.data.ar;
import std.data.coff;
import std.data.class;
import std.data.rpm;

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int checks = 0;
static int fails = 0;

static void check(int cond, const char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("   ✗ %s\n", what);
    }
}

static void put16le(u8 *p, int v)
{
    p[0] = (u8)(v & 0xFF);
    p[1] = (u8)((v >> 8) & 0xFF);
}

static void put32le(u8 *p, u32 v)
{
    p[0] = (u8)(v & 0xFF);
    p[1] = (u8)((v >> 8) & 0xFF);
    p[2] = (u8)((v >> 16) & 0xFF);
    p[3] = (u8)((v >> 24) & 0xFF);
}

static void put16be(u8 *p, int v)
{
    p[0] = (u8)((v >> 8) & 0xFF);
    p[1] = (u8)(v & 0xFF);
}

static void put32be(u8 *p, u32 v)
{
    p[0] = (u8)((v >> 24) & 0xFF);
    p[1] = (u8)((v >> 16) & 0xFF);
    p[2] = (u8)((v >> 8) & 0xFF);
    p[3] = (u8)(v & 0xFF);
}

/* 60 字节 ar 成员头 */
static void ar_head(char *p, const char *name, i64 size)
{
    char tmp[16] = { 0 };
    int i = 0, k = 0;
    i64 v = size;

    memset(p, ' ', 60);
    for (i = 0; name[i] && i < 16; i++)
        p[i] = name[i];
    if (v == 0) {
        tmp[k++] = '0';
    }
    while (v > 0) {
        tmp[k++] = (char)('0' + v % 10);
        v /= 10;
    }
    for (i = 0; i < k; i++)
        p[48 + i] = tmp[k - 1 - i];
    p[58] = '`';
    p[59] = '\n';
}

static void do_ar(void)
{
    static char buf[256] = { 0 };
    ArDoc doc = { 0 };
    ArMember m = { 0 };
    int o = 0, n = 0;

    printf("== ar\n");
    memcpy(buf, "!<arch>\n", 8);
    o = 8;
    ar_head(buf + o, "main.o/", 4);
    o += 60;
    memcpy(buf + o, "OBJ1", 4);
    o += 4;
    ar_head(buf + o, "util.o/", 3);
    o += 60;
    memcpy(buf + o, "OBJ", 3);
    o += 3;
    if (o % 2)
        o++;
    n = o;
    check(doc.open(buf, n) == 2, "open 计数");
    check(doc.count() == 2, "count() 方法");
    while (doc.next(&m) == 1) {
        printf("   %.*s（%lld 字节，%d 权限）\n", m.name.s.len, m.name.s.data,
               (long long)m.size, m.mode);
        check(m.size == 4 || m.size == 3, "成员大小");
    }
    doc.rewind();
    check(doc.find(S("util.o"), &m) == 1 && m.size == 3, "find 按名查找");
    check(doc.find(S("nope.o"), &m) == 0, "找不到返回 0");
}

static void do_coff(void)
{
    static u8 buf[512] = { 0 };
    CoffDoc doc = { 0 };
    CoffSection s = { 0 };
    int n = 0;

    printf("== coff\n");
    put16le(buf, 0x8664);
    put16le(buf + 2, 1);
    {
        int o = 20;

        memcpy(buf + o, ".text", 5);
        put32le(buf + o + 16, 32);
        put32le(buf + o + 20, 260);
        put32le(buf + o + 36, 0x60000020);
        n = 20 + 40;
    }
    check(doc.open(buf, n) == 1, "open 计数");
    check(doc.section_count() == 1, "section_count()");
    check(doc.section(0, &s) == 1, "section(0)");
    printf("   节 %.*s：raw %u 字节，特征 0x%08X\n", s.name.s.len, s.name.s.data,
           s.raw_size, s.characteristics);
    check(memcmp(s.name.s.data, ".text", 5) == 0, "节名");
    check(s.raw_size == 32 && s.characteristics == 0x60000020, "节字段");
    check(doc.section(1, &s) == -1, "越界节号");
}

static void do_class(void)
{
    static u8 buf[256] = { 0 };
    ClassDoc doc = { 0 };
    CpEntry cp = { 0 };
    ClassMethod m = { 0 };
    int o = 0, n = 0, k = 0;

    printf("== class\n");
    put32be(buf, 0xCAFEBABEu);
    put16be(buf + 4, 0);
    put16be(buf + 6, 52);
    put16be(buf + 8, 4);                /* cp_count = 4 */
    o = 10;
    buf[o++] = 1;                       /* #1 Utf8 "Main" */
    put16be(buf + o, 4);
    o += 2;
    memcpy(buf + o, "Main", 4);
    o += 4;
    buf[o++] = 1;                       /* #2 Utf8 "run" */
    put16be(buf + o, 3);
    o += 2;
    memcpy(buf + o, "run", 3);
    o += 3;
    buf[o++] = 1;                       /* #3 Utf8 "()V" */
    put16be(buf + o, 3);
    o += 2;
    memcpy(buf + o, "()V", 3);
    o += 3;
    put16be(buf + o, 0x0021);           /* access */
    put16be(buf + o + 2, 1);            /* this */
    put16be(buf + o + 4, 1);            /* super */
    put16be(buf + o + 6, 0);            /* ifaces */
    o += 8;
    put16be(buf + o, 0);                /* fields */
    o += 2;
    put16be(buf + o, 1);                /* methods = 1 */
    put16be(buf + o + 2, 0x0009);
    put16be(buf + o + 4, 2);
    put16be(buf + o + 6, 3);
    put16be(buf + o + 8, 0);
    o += 10;
    n = o;
    check(doc.open(buf, n) == 1, "open 计数");
    while (doc.next(&cp) == 1) {
        if (cp.tag == 1)
            k++;
    }
    check(k == 3, "3 个 Utf8 项");
    doc.rewind();
    check(doc.method(0, &m) == 1, "method(0)");
    printf("   方法 %.*s%.*s（access 0x%04X）\n", m.name.s.len, m.name.s.data,
           m.desc.s.len, m.desc.s.data, m.access);
    check(memcmp(m.name.s.data, "run", 3) == 0, "方法名");
    check(memcmp(m.desc.s.data, "()V", 3) == 0, "方法描述符");
}

static void do_rpm(void)
{
    static u8 buf[512] = { 0 };
    RpmDoc doc = { 0 };
    RpmEntry e = { 0 };
    Str v = { 0 };
    int data = 0, o = 0, n = 0;

    printf("== rpm\n");
    buf[0] = 0xED;
    buf[1] = 0xAB;
    buf[2] = 0xEE;
    buf[3] = 0xDB;
    buf[4] = 3;
    memcpy(buf + 10, "demo", 4);
    buf[96] = 0x8E;
    buf[97] = 0xAD;
    buf[98] = 0xE8;
    buf[99] = 1;
    put32be(buf + 104, 2);
    data = 96 + 16 + 2 * 16;
    memcpy(buf + data, "demo", 5);
    memcpy(buf + data + 5, "noarch", 7);
    put32be(buf + 108, 12);
    o = 112;
    put32be(buf + o, RPMTAG_NAME);
    put32be(buf + o + 4, RPM_TYPE_STRING);
    put32be(buf + o + 8, 0);
    put32be(buf + o + 12, 1);
    put32be(buf + o + 16, RPMTAG_ARCH);
    put32be(buf + o + 20, RPM_TYPE_STRING);
    put32be(buf + o + 24, 5);
    put32be(buf + o + 28, 1);
    n = data + 12;
    check(doc.open(buf, n) == 2, "open 计数");
    check(doc.count() == 2, "count() 方法");
    while (doc.next(&e) == 1) {
        if (doc.value(&e, &v) == 1)
            printf("   %s = %.*s\n", tag_name(e.tag), v.s.len, v.s.data);
    }
    check(doc.get(RPMTAG_NAME, &e) == 1 && doc.value(&e, &v) == 1
          && memcmp(v.s.data, "demo", 4) == 0, "NAME 取值");
    check(doc.get(RPMTAG_ARCH, &e) == 1 && doc.value(&e, &v) == 1
          && memcmp(v.s.data, "noarch", 6) == 0, "ARCH 取值");
    check(doc.get(RPMTAG_URL, &e) == 0, "不存在的 tag");
}

int main(void)
{
    do_ar();
    do_coff();
    do_class();
    do_rpm();
    printf("\n%d check(s), %d failure(s)\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
