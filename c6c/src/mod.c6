/* c6 模块登记表（docs/modules.md 的 M1 步）
 *
 * 这一层**只记账，不改名**：
 *   - 哪个源文件带 `module a.b;`  → FILE_MOD[file_id]（1-based 下标记模块）
 *   - 当前翻译单元 `import` 了哪些模块 → MOD_IMP[]（按出现顺序、去重）
 * 名字改写（`tu__module__` 前缀）是 M2 的事，所以这一步对现有全部用例必须
 * 是零行为变化 —— 唯一能看出来的是 `-v` 多打一行。
 */
#define MOD_MAX 512
#define MOD_NAME_MAX 128
#define MOD_IMP_MAX 128
#define MOD_FILE_MAX 8192

typedef struct ModEnt {
    char path[MOD_NAME_MAX];            /* "tu.module"（点分，原样） */
    char prefix[MOD_NAME_MAX + 8];      /* "tu__module__"（点换成 __，末尾带 __） */
    u32 slot;                           /* 错误号段里的 slot，M5 才用 */
} ModEnt;

static ModEnt MODS[MOD_MAX];
static u32 NMOD;
static u32 FILE_MOD[MOD_FILE_MAX];
static u32 MOD_IMP[MOD_IMP_MAX];
static u32 NMODIMP;

/* 登记一个模块名，返回 1-based 下标（0 = 无效） */
static u32 mod_intern(const char *dotted)
{
    u32 i = 0;
    ModEnt *m = NULL;
    u32 o = 0;

    if (!dotted || !dotted[0])
        return 0;
    for (i = 0; i < NMOD; i++)
        if (strcmp(MODS[i].path, dotted) == 0)
            return i + 1;
    if (NMOD >= MOD_MAX)
        return 0;
    m = &MODS[NMOD];
    strncpy(m->path, dotted, MOD_NAME_MAX - 1);
    m->path[MOD_NAME_MAX - 1] = 0;
    /* 前缀：点换成 `__`，末尾再补一个 `__`（`tu.module` → `tu__module__`） */
    o = 0;
    {
        u32 j = 0;

        for (j = 0; m->path[j] && o + 3 < sizeof(m->prefix); j++) {
            if (m->path[j] == '.') {
                m->prefix[o++] = '_';
                m->prefix[o++] = '_';
            } else {
                m->prefix[o++] = m->path[j];
            }
        }
        m->prefix[o++] = '_';
        m->prefix[o++] = '_';
        m->prefix[o] = 0;
    }
    m->slot = NMOD + 1;
    NMOD++;
    return NMOD;
}

static void mod_set_file(u32 file_id, u32 mod1)
{
    if (file_id < MOD_FILE_MAX)
        FILE_MOD[file_id] = mod1;
}

static u32 mod_of_file(u32 file_id)
{
    return file_id < MOD_FILE_MAX ? FILE_MOD[file_id] : 0;
}

/* 模块名的改写前缀；没有模块的文件是空串 */
static const char *mod_prefix(u32 mod1)
{
    if (mod1 >= 1 && mod1 <= NMOD)
        return MODS[mod1 - 1].prefix;
    return "";
}

static const char *mod_path(u32 mod1)
{
    if (mod1 >= 1 && mod1 <= NMOD)
        return MODS[mod1 - 1].path;
    return "";
}

static void mod_add_import(u32 mod1)
{
    u32 i = 0;

    if (!mod1 || NMODIMP >= MOD_IMP_MAX)
        return;
    for (i = 0; i < NMODIMP; i++)
        if (MOD_IMP[i] == mod1)
            return;
    MOD_IMP[NMODIMP++] = mod1;
}

/* `-v`：把这轮看到的模块与导入打出来（M1 唯一的可观察变化） */
static void mod_report(void)
{
    u32 i = 0;

    if (!NMOD)
        return;
    fprintf(stderr, "c6c: 模块 %u 个：", (unsigned)NMOD);
    for (i = 0; i < NMOD; i++)
        fprintf(stderr, " %s(→%s)", MODS[i].path, MODS[i].prefix);
    fprintf(stderr, "\n");
    if (NMODIMP) {
        fprintf(stderr, "c6c: 本 TU 导入 %u 个：", (unsigned)NMODIMP);
        for (i = 0; i < NMODIMP; i++)
            fprintf(stderr, " %s", mod_path(MOD_IMP[i]));
        fprintf(stderr, "\n");
    }
}

/* ---- 错误号段（docs/modules.md M5 / 仓库根的 errbase.def）----
 *
 *    id = (area << 27) | (slot << 12) | code
 *
 *   area 0 = 应用模块，1 = std（内置）；slot 0 = 不属于模块的文件；
 *   自动池 1..0x5FFF（1 + fnv1a32(模块名) % 0x5FFF）；std 内置池
 *   0x6000..0x60FF；钉号池 0x6100..0x7FFF（errbase.def 里的条目）。
 */
#define MOD_PIN_MAX 256

typedef struct ModPin {
    char path[MOD_NAME_MAX];
    u32 slot;
} ModPin;

static ModPin MOD_PIN[MOD_PIN_MAX];
static u32 NMODPIN;
static int MOD_PIN_LOADED;

static u32 mod_fnv1a(const char *p)
{
    u32 h = 2166136261u;

    while (*p) {
        h ^= (u32)(u8)*p++;
        h *= 16777619u;
    }
    return h;
}

static int mod_is_std(const char *path)
{
    return path[0] == 's' && path[1] == 't' && path[2] == 'd' && path[3] == '.';
}

/* 读仓库根的 `errbase.def`（`<模块名> <slot>` 一行一条，`#` 注释）。
 * 谁都没找到就当没有——自动号仍然可用。 */
static void mod_load_errbase(void)
{
    static const char *const CAND[] = {
        "errbase.def", "../errbase.def", "../../errbase.def", NULL
    };
    FILE *f = NULL;
    char line[512] = {0};
    int i = 0;

    if (MOD_PIN_LOADED)
        return;
    MOD_PIN_LOADED = 1;
    for (i = 0; CAND[i] && !f; i++)
        f = fopen(CAND[i], "r");
    if (!f)
        return;
    while (fgets(line, sizeof(line), f)) {
        char nm[MOD_NAME_MAX] = {0};
        char *p2 = line;
        int k = 0;
        unsigned long slot = 0;

        while (*p2 == ' ' || *p2 == '\t')
            p2++;
        if (*p2 == '#' || *p2 == '\n' || *p2 == 0)
            continue;
        while (*p2 && *p2 != ' ' && *p2 != '\t' && *p2 != '\n' && k < MOD_NAME_MAX - 1)
            nm[k++] = *p2++;
        nm[k] = 0;
        while (*p2 == ' ' || *p2 == '\t')
            p2++;
        if (!*p2)
            continue;
        slot = strtoul(p2, NULL, 0);
        if (!nm[0] || !slot || NMODPIN >= MOD_PIN_MAX)
            continue;
        strncpy(MOD_PIN[NMODPIN].path, nm, MOD_NAME_MAX - 1);
        MOD_PIN[NMODPIN].slot = (u32)slot;
        NMODPIN++;
    }
    fclose(f);
}

/* 模块的号段 slot（0 = 没有模块） */
static u32 mod_slot(u32 mod1)
{
    const char *path = NULL;
    u32 i = 0;

    if (!mod1)
        return 0;
    path = mod_path(mod1);
    mod_load_errbase();
    for (i = 0; i < NMODPIN; i++)
        if (strcmp(MOD_PIN[i].path, path) == 0)
            return MOD_PIN[i].slot;
    /* std 内置池：目前只有错误模块钉在 0x6000，其余 std 模块按名散列到
     * 0x6001..0x60FF，保证同一个 std 模块恒定、不同模块基本不撞。 */
    if (mod_is_std(path)) {
        if (strcmp(path, "std.core.err") == 0)
            return 0x6000;
        return 0x6001u + (mod_fnv1a(path) % 0xFFu);
    }
    return 1u + (mod_fnv1a(path) % 0x5FFFu);
}

/* `enum Error` 成员的号段基址：`(area << 27) | (slot << 12)`，没有模块就是 0 */
static u32 mod_err_base(u32 mod1)
{
    u32 slot = 0;
    u32 area = 0;

    if (!mod1)
        return 0;
    slot = mod_slot(mod1);
    if (!slot)
        return 0;
    area = mod_is_std(mod_path(mod1)) ? 1u : 0u;
    return (area << 27) | (slot << 12);
}
