/* main.c6 —— 驱动
 *
 * P1 能做到哪儿就说到哪儿：
 *   --scan / -fsyntax-only   预处理 + 词法 + 诊断（语法分析与 codegen 在 P3/P2）
 *   -E                       预处理输出到 stdout（带 # 行标记）
 *   -c                       目标文件（P2）
 * 参数形状（-I/-D/-U/-B/-o）按最终版收，避免以后改 CLI。
 */

#define MAX_INC 32
#define MAX_DEF 64
#define MAX_SRC 256

enum {
    M_SCAN = 0,
    M_CHECK,
    M_E,
    M_OBJ,      /* -c：单文件、freestanding、_start 直接调 main */
    M_EXE,      /* 默认：单文件 + 自带运行时 → 可执行文件 */
    M_RUN,      /* -run：编到临时 ELF，exec 它（不落盘、不留输出） */
    M_LINK,     /* 输入是 .o：调自己的静态链接器（ld.c6）链成可执行文件 */
    M_ASM,      /* -S：只出汇编文本（asmout.c6），不写 ELF */
    M_CTU       /* --emit-ctu：per-TU C 文本（ctu.c6），一个输入一个 .c */
};

typedef struct Opts {
    const char *incs[MAX_INC];
    int nincs;
    const char *defs[MAX_DEF];
    int ndefs;
    const char *undefs[MAX_DEF];
    int nundefs;
    const char *files[MAX_SRC];
    int nfiles;
    /* 每个源文件出现的那一刻，命令行上已经攒了多少个 -D / -U（见
     * push_defines_at：`-D` 只作用于它后面的文件） */
    int fdefs[MAX_SRC];
    int fundefs[MAX_SRC];
    int nostdlib;
    /* -nostdinc：不要系统 include 目录（/usr/local、/usr/include[/x86_64-linux-gnu]）。
     * 编内核必须用它——内核树 uapi 头与发行版装到 /usr/include/linux 的那份同名，
     * 后者是给用户态裁剪过的（见 setup_incdirs 里的注释）。 */
    int nostdinc;
    /* `-include <file>`：在编译任何源文件之前先把它当强行包进来。kbuild
     * 用它注入 include/generated/autoconf.h 之类的配置头——内核的
     * IS_ENABLED()/CONFIG_* 全靠它，缺了整片代码按"未声明标识符"报错。 */
    const char *forceincs[MAX_INC];
    int nforceincs;
    const char *out;
    const char *depfile;        /* -Wp,-MMD,path：gcc 风格依赖文件输出 */
    const char *bdir;
    int verbose;
    int mode;
    /* `-std=`：0 = 默认/c99（`__STDC_VERSION__` 199901L）、1 = c89（不定义）、
     * 2 = c11（201112L）。c6c 的语法一直是"C99 加一些扩展"，所以这个选项
     * 不改语法，只管那条宏——但构建系统传的 `-std=c99` / `-std=gnu99` 必须
     * 能接住，不能当未知选项打死。 */
    int std;
    /* -run：run_argi 是「程序自己的 argv[0]」在编译器 argv 里的下标；
     * 从那儿往后的所有参数原样交给程序（tcc 同款语义）。 */
    int run;
    int run_argi;
    /* -test：跑 test 块、不跑用户 main；默认编到临时 ELF 再 exec（tcc 的
     * -test 就是"跑起来"），给了 -o 就只写文件不跑。 */
    int test;
    const char *test_filter;
    /* -Wl,--allow-undefined：链接时未定义符号按 0 处理（只打一条汇总警告）。
     * 过渡手段——把带 libc 名字的 .o（比如 rt.o）先链成静态程序；真正的解法
     * 是动态链接（DT_NEEDED + PLT/GOT），见 c6c/docs/todo.md。 */
    int allow_undef;
    /* -Wl,--dynamic：链接出动态可执行文件（DT_NEEDED libc.so.6 + PLT/GOT），
     * 未定义的**函数**从 libc 解析，不再按 0 处理。 */
    int dyn_link;
    /* -shared：链接出 ET_DYN 共享库（ld.c6 的 LD_SHARED）。native 后端出来的
     * 代码本来就是位置无关的（全局地址走 lea rip+rel32 + 重定位），数据里的
     * 绝对地址由 .rela.dyn 的 RELATIVE 兜住，所以这里不需要"PIC 代码生成"
     * 那一套；-fPIC 只是接住 GCC/clang 风格的命令行。 */
    int so_out;     /* 叫 so_out 不叫 shared：shared 是 c6 的关键字（@shared） */
    /* -b：数组下标边界检查（越界就打印一行并退出码 2） */
    int bcheck;
    /* -O0..-O3：分级优化。默认 0 — 编译器的字节级 fixpoint 与三后端差分
     * 全部在 -O0 口径上断言；级别只决定"函数 IR 交给后端前跑哪些 pass"。 */
    int olevel;
    /* -g：调试信息（行号表 + DWARF 段，-c 出的 .o 里带上） */
    int debug;
    /* --target=aarch64：第二套 native 后端（只出汇编文本，配 -S 用） */
    int target_a64;
    /* `-ffreestanding-kernel`：按"编 Linux 内核"的形态给编译器身份宏。
     *
     * 为什么要单开一个开关，而不是直接在内建宏里加 __GNUC__：c6c 现在不定义
     * __GNUC__ 是**故意的**（见 BUILTIN_DEFS 上面那段注释）——glibc 的头文件
     * 按 __GNUC__ 分支选路，tcc 不定义，我们跟着 tcc 走，才能与 tcc 的 -E
     * 逐 token 同构（P1-3b 的对齐口径）。全局改了会动摇 G2c 与整个 tests2。
     *
     * 但内核那边正好相反：include/linux/compiler_types.h 只认
     * `__clang__` / `__GNUC__` 两条路，都没有就 `#error "Unknown compiler"`，
     * 整棵头链在第一个文件就断。所以把"我是 GNU 兼容编译器"这件事做成显式
     * 开关：谁要编内核谁打开，默认行为一字不变。 */
    int kernel_mode;
} Opts;

static Opts O;
static const char *progname = "c6c";

static void usage(FILE *fp)
{
    fprintf(fp,
        "用法：%s [选项] 文件...\n"
        "\n"
        "工程管理子命令：c6c init|scan|build|test|run|help（详见 `c6c help`）\n"
        "\n"
        "  -I 目录              头文件搜索路径（可多次）\n"
        "  -D 名字[=值]         预定义宏（可多次）\n"
        "  -U 名字              取消预定义\n"
        "  -B 目录              libtcc1.a / crt 所在目录（同时用它下面的 include）\n"
        "  -o 文件              输出文件\n"
        "  -std=c89|c99|c11     `__STDC_VERSION__` 按这个给（语法不变；gnu 变体也认）\n"
        "  --scan               只做预处理+词法并打印统计\n"
        "  --hello 文件          直接发一个 _start+main(42) 的 ELF（P2-2 骨架）\n"
        "  --type-selftest      类型表 hash-consing/布局自测（P3-1）\n"
        "  --ir-selftest        IR v1 编解码/指纹自测（P2-1）\n"
        "  --ir-demo            打印 hello 形态的 IR dump\n"
        "  -fsyntax-only        只查错不出码（语法在 P3）\n"
        "  -E                   预处理输出到 stdout\n"
        "  --emit-ctu           per-TU C：一个输入出一个 .c（真 C ABI、不要 main、\n"
        "                       不带运行时；交叉编译用，见 ctu.c6）\n"
        "  -c                   只编不链：输出可重定位目标文件（ET_REL，.o），\n"
        "                       不带运行时、不查 main；一个输入出一个 .o\n"
        "  -run 文件 [参数...]   编成临时 ELF 后立刻执行（参数原样传给 main；\n"
        "                       退出码照抄；不写输出文件，仅 native 后端）\n"
        "  -test                跑所有 `test \"…\" { }` 块（用户 main 不执行）：\n"
        "                       PASS/FAIL 行 + \"N test(s), M failure(s)\" 收尾，\n"
        "                       失败数当退出码；给 -o 就只写文件不跑\n"
        "  -test-filter=子串     只跑描述里含这个子串的 test 块（-test 用）\n"
        "  --target=aarch64     第二套 native 后端：出 aarch64 汇编文本（要配 -S）\n"
        "  -S                   只出汇编文本（x86-64 / GNU as 语法，交给 as 或 cc 汇编）\n"
        "  -g                   调试信息：行号表 + DWARF 段（-c 出的 .o 里带上，\n"
        "                       用系统 cc/gcc 链接后可 gdb/addr2line）\n"
        "  -b                   数组下标边界检查（越界打印一行、退出码 2；\n"
        "                       只查编译期知道长度的数组）\n"
        "  -O0|-O1|-O2|-O3      IR 分级优化（默认 -O0；-O 等价于 -O1）\n"
        "  -nostdlib            不自动带上 c6c 自带运行时（lib/rt.c6）\n"
        "  -Wl,--dynamic        链接出动态可执行文件（DT_NEEDED libc.so.6 + PLT/GOT）\n"
        "  -shared              链接出共享库 .so（ET_DYN：没有入口与 PT_INTERP，\n"
        "                       定义的全局符号进 .dynsym，数据里的绝对地址交给\n"
        "                       .rela.dyn 的 RELATIVE；输入得是 .o）\n"
        "  -fPIC                位置无关代码（native 后端本来就位置无关，收下不用改）\n"
        "  -v                   详细输出\n"
        "  --version            版本\n"
        "  -h                   这份帮助\n",
        progname);
}

/* ctu.c6 排在 main.c6 后面 include（它要用这里的 OUTBUF / emit_one /
 * obj_default_out），这里先给三个入口一个前置声明：正常路径只有模式分派点
 * 上一个 `ctu_mode()` 分支，别的什么都不碰。 */
static void ctu_set_mode(void);
static int ctu_mode(void);
static int ctu_emit(const char *src, const char *out, int nfiles);

static double now_ms(void)
{
    struct timespec ts = {0};
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
}

/* ---- 输出缓冲：满 1 MB 就 write(2)，绝不把整份输出拼在内存里 ---- */
typedef struct Out {
    char *buf;
    size_t cap;
    size_t n;
} Out;

static Out OUTBUF;

static void out_flush(Out *o)
{
    size_t off = 0;
    while (off < o->n) {
        ssize_t w = write(1, o->buf + off, o->n - off);
        if (w <= 0)
            break;
        off += (size_t)w;
    }
    o->n = 0;
}

static void out_putn(Out *o, const char *p, size_t n)
{
    if (o->n + n > o->cap) {
        out_flush(o);
        if (n > o->cap) {
            size_t off = 0;
            while (off < n) {
                ssize_t w = write(1, p + off, n - off);
                if (w <= 0)
                    break;
                off += (size_t)w;
            }
            return;
        }
    }
    memcpy(o->buf + o->n, p, n);
    o->n += n;
}

static void out_putc(Out *o, char c)
{
    if (o->n + 1 > o->cap)
        out_flush(o);
    o->buf[o->n++] = c;
}

/* ---- 统计（P1 的验收口径：行/秒、µs/行、MB/s）---- */
static u64 ST_tok;
static u64 ST_kind[8];
static u64 ST_lines;
static u64 ST_bytes;

static void push_defines(void);
/* -include 的处理（定义在 setup_incdirs 之后，这里先声明：scan_one/emit_one
 * 在它前面就要用）。 */
static int push_forceincs(void);

static void scan_one(const char *path)
{
    SrcFile *f = src_load(path);
    Tok t = {0};
    u64 ntok = 0;

    if (!f) {
        diag_error_plain("打不开源文件 '%s'", path);
        return;
    }
    pp_reset();
    pp_push_file(f, -1);
    /* 后进先出：源文件压完再压 -include，它们才排在源文件前面展开 */
    (void)push_forceincs();
    push_defines();
    for (;;) {
        int k = pp_next(&t);
        if (k == TK_EOF)
            break;
        ntok++;
        if (k >= 0 && k < 8)
            ST_kind[k]++;
        if (DG.errors > 200) {
            diag_error_plain("错误太多，停止（%d）", DG.errors);
            break;
        }
    }
    ST_tok += ntok;
}

static void stat_totals(void)
{
    SrcFile *f = FILES.head;
    ST_lines = 0;
    ST_bytes = 0;
    for (; f; f = f->next) {
        if (f->owned)
            continue;
        ST_lines += f->nlines;
        ST_bytes += f->size;
    }
}

/* -Wp,-MMD,path：gcc 风格的依赖文件。kbuild 编 host tools 时靠它生成 .d，
 * 再喂给 fixdep。格式和 gcc -MMD 一样：`<basename>.o: file.c header.h ...`。
 * FILES 里 owned=1 的是 -D 合成内容/模块改写产物，不是磁盘上的真实头文件，
 * 不能列进去（fixdep 会 stat 每个依赖，列了会报找不到）。 */
static void emit_depfile(const char *path)
{
    FILE *f = NULL;
    SrcFile *sf = NULL;
    char target[512] = {0};
    const char *base = O.files[0];
    const char *slash = NULL;
    size_t n = 0;

    if (!path || !path[0] || O.nfiles < 1)
        return;
    f = fopen(path, "w");
    if (!f)
        return;
    slash = strrchr(base, '/');
    if (slash)
        base = slash + 1;
    n = strlen(base);
    if (n > 2 && base[n - 2] == '.' && (base[n - 1] == 'c' || base[n - 1] == 'S'))
        n -= 2;
    if (n > sizeof(target) - 3)
        n = sizeof(target) - 3;
    memcpy(target, base, n);
    memcpy(target + n, ".o", 2);
    fprintf(f, "%s:", target);
    for (sf = FILES.head; sf; sf = sf->next)
        if (!sf->owned && sf->path && sf->path[0])
            fprintf(f, " %s", sf->path);
    fprintf(f, "\n");
    fclose(f);
}

static void print_stats(double ms)
{
    double per_line = ST_lines ? ms * 1000.0 / (double)ST_lines : 0.0;
    double lines_per_s = ms > 0.0 ? (double)ST_lines * 1000.0 / ms : 0.0;
    double mb_per_s = ms > 0.0 ? (double)ST_bytes / 1024.0 / 1024.0 * 1000.0 / ms : 0.0;
    double per_tok = ST_tok ? ms * 1000.0 / (double)ST_tok : 0.0;

    printf("c6c: %d 个文件 / %lu 行 / %.2f MB / %lu token / arena %.2f MB\n",
           O.nfiles, (unsigned long)ST_lines, (double)ST_bytes / 1048576.0,
           (unsigned long)ST_tok, (double)A_main.total / 1048576.0);
    printf("c6c: %.1f ms → %.1f 万行/s（%.2f µs/行，%.2f µs/token），%.1f MB/s\n",
           ms, lines_per_s / 10000.0, per_line, per_tok, mb_per_s);
    printf("c6c: token 分布 ident %lu / num %lu / str %lu / char %lu / punct %lu / nl %lu\n",
           (unsigned long)ST_kind[TK_IDENT], (unsigned long)ST_kind[TK_NUM],
           (unsigned long)ST_kind[TK_STR], (unsigned long)ST_kind[TK_CHAR],
           (unsigned long)ST_kind[TK_PUNCT], (unsigned long)ST_kind[TK_NL]);
}

/* ---- -E ----
 *
 * 目标：**行号保真**。源文件里的 token（不是宏展开出来的）按它自己的行号输出，
 * 行号跳跃小于 8 行就补空行，否则打 `# 行 "文件"` 标记。这样 tcc 收下这份输出时
 * 报错位置就是原始文件的行号 —— G2c 调 tcc 的 C 代码时，这就是唯一的定位手段。
 * 宏展开出来的 token（hs != NULL）不参与行号推进，也不打标记。
 */
static void emit_marker(SrcFile *sf, u32 line)
{
    char hdr[512] = {0};
    int hn = snprintf(hdr, sizeof(hdr), "\n# %u \"%s\"\n", line, sf->path);
    if (hn > 0)
        out_putn(&OUTBUF, hdr, (size_t)hn);
}

/* 空格规则：源里的空白（TF_SPACE）之外，还要防“粘成一个 token”：
 *   extern int   → 两个标识符必须隔开（吃过这个亏：输出成了 externint）
 *   - -          → 两个标点可能拼成 -- 之类
 */
static int emit_needs_space(int prev_kind, int kind)
{
    int prev_word = (prev_kind == TK_IDENT || prev_kind == TK_NUM
                     || prev_kind == TK_STR || prev_kind == TK_CHAR);
    int cur_word = (kind == TK_IDENT || kind == TK_NUM
                    || kind == TK_STR || kind == TK_CHAR);
    if (prev_word && cur_word)
        return 1;
    if (prev_kind == TK_PUNCT && kind == TK_PUNCT)
        return 1;
    return 0;
}

/* `-include <file>`：把强制包含的头压进预处理栈，**先于**源文件展开。
 *
 * kbuild 靠它给每个 TU 注入 include/generated/autoconf.h——内核的
 * IS_ENABLED() / CONFIG_* 全在那儿，缺了就是成片的"未声明的标识符
 * 'IS_ENABLED'"。命令行上多个 -include 按给出的顺序依次压栈，源文件最后压，
 * 于是展开顺序正好是"各 -include → 源文件"。
 *
 * 打不开就直接报错，不静默跳过：内核编译里缺一个配置头，后面会炸出几百条
 * 连锁诊断，早报比晚报好。 */
static int push_forceincs(void)
{
    int i = 0;

    for (i = 0; i < O.nforceincs; i++) {
        SrcFile *f = src_load(O.forceincs[i]);

        if (!f) {
            diag_error_plain("打不开 -include 的头文件 '%s'", O.forceincs[i]);
            return 1;
        }
        pp_push_file(f, -1);
    }
    return 0;
}

static void emit_one(const char *path)
{
    SrcFile *f = src_load(path);
    Tok t = {0};
    SrcFile *lastf = NULL;
    u32 lastline = 1;
    int prev_kind = 0;

    if (!f) {
        diag_error_plain("打不开源文件 '%s'", path);
        return;
    }
    pp_push_file(f, -1);
    /* 后进先出：源文件压完再压 -include，它们才排在源文件前面展开 */
    (void)push_forceincs();
    push_defines();
    for (;;) {
        int k = pp_next(&t);
        /* 合成 token（__LINE__/__FILE__/__DATE__ 的结果）没有可信的源位置，不参与行号推进 */
    int expanded = (t.hs != NULL) || (t.flags & TF_SYN);

        if (k == TK_EOF)
            break;
        if (t.kind == TK_NL) {
            out_putc(&OUTBUF, '\n');
            lastline++;          /* 换行本身也让物理行号 +1，别再重复垫 */
            continue;
        }
        if (!expanded) {
            SrcFile *sf = file_by_id(t.file);

            if (!sf && FILES.head)
                sf = FILES.head;
            u32 line = src_line_of(sf, t.off);
            if (sf != lastf) {
                emit_marker(sf, line);
                lastf = sf;
                lastline = line;
            } else if (line != lastline) {
                if (line > lastline && line - lastline <= 8) {
                    while (lastline < line) {
                        out_putc(&OUTBUF, '\n');
                        lastline++;
                    }
                } else {
                    out_putc(&OUTBUF, '\n');
                    emit_marker(sf, line);
                    lastline = line;
                }
            }
        }
        if ((t.flags & TF_SPACE) || emit_needs_space(prev_kind, t.kind))
            out_putc(&OUTBUF, ' ');
        out_putn(&OUTBUF, tok_data(&t), t.len);
        prev_kind = t.kind;
    }
    out_putc(&OUTBUF, '\n');
}

/* 内建宏：没有它们，glibc 的头文件会走错分支（例如 stubs-32.h） */
/* 内建宏：**对着 tcc 的预定义集抄**（tcc -E -dM 的实测结果）。
 *
 * 为什么不照 gcc 的抄：G2c 要求 c6c 编出来的东西 tcc 也能编，而 glibc 的
 * 头文件按 __GNUC__ 分支选路。tcc 不定义 __GNUC__，于是走“非 GNU 编译器”
 * 那条路（比如 dlfcn.h 里 Dl_serinfo 用老式数组而不是零长数组 + 匿名 union）。
 * 我们跟着 tcc 走，风险最小；多出来的 GNU 拼写用等价的 C 关键字映射掉，
 * 使输出与 tcc 的 -E 逐 token 同构（这是 P1-3b 的对齐口径）。
 */
static const char *const BUILTIN_DEFS =
    /* GCC 内建函数：按同名 libc 函数/普通写法展开。真实代码（尤其 tcc 自己的
     * 测试）到处用 __builtin_*，逐个在 IR 里实现不划算，语义上它们就是这些。
     *
     * `__builtin_memcpy/memmove/memset` **不在这张表里**：它们是真正的内建
     * （parse.c6 的 gen 里现造一个 extern 符号再发调用），不需要 TU 里先有
     * 声明。写成文本宏就会抢在那条内建路径前面，把"没有 memcpy 声明"的 TU
     * （内核 lib/zstd/common/zstd_deps.h 就是这么用 __builtin_memset 的）
     * 变成"未声明的标识符"。tcc 的 -E 也把这三个名字原样留着。 */
    "#define __builtin_memcmp(a,b,c) memcmp(a,b,c)\n"
    "#define __builtin_strcpy(a,b) strcpy(a,b)\n"
    "#define __builtin_strncpy(a,b,c) strncpy(a,b,c)\n"
    "#define __builtin_strcmp(a,b) strcmp(a,b)\n"
    "#define __builtin_strncmp(a,b,c) strncmp(a,b,c)\n"
    "#define __builtin_strcat(a,b) strcat(a,b)\n"
    "#define __builtin_strncat(a,b,c) strncat(a,b,c)\n"
    "#define __builtin_strchr(a,b) strchr(a,b)\n"
    "#define __builtin_strrchr(a,b) strrchr(a,b)\n"
    "#define __builtin_abort() abort()\n"
    "#define __builtin_exit(a) exit(a)\n"
    "#define __builtin_alloca(a) alloca(a)\n"
    "#define __builtin_malloc(a) malloc(a)\n"
    "#define __builtin_calloc(a,b) calloc(a,b)\n"
    "#define __builtin_realloc(a,b) realloc(a,b)\n"
    "#define __builtin_free(a) free(a)\n"
    "#define __builtin_strdup(a) strdup(a)\n"
    /* C99 的 `_Complex`：表示成两个分量的结构体（parse.c6 的 cplx_*）。
     * 三个宽度各一个，`_Complex` 说明符在类型层映射过来。 */
    "struct __c6_cplx_f { float __re, __im; };\n"
    "struct __c6_cplx_d { double __re, __im; };\n"
    "struct __c6_cplx_l { long double __re, __im; };\n"
    /* 和 tcc 一样默认开 `_GNU_SOURCE`。glibc 的头把 `pthread_setname_np`、
     * `cfmakeraw`、`strsignal`、`getopt_long`……一大片都藏在 `__USE_GNU` /
     * `__USE_MISC` 后面，不开就是「未声明的标识符」；c6 的 std 与 examples 是
     * 按 tcc 那个口径写的（tcc 一直无条件开它），所以默认值必须对齐。 */
    "#define _GNU_SOURCE 1\n"
    "#define __STDC__ 1\n"
    "#define __STDC_HOSTED__ 1\n"
    "#define __x86_64 1\n"
    "#define __x86_64__ 1\n"
    "#define __amd64__ 1\n"
    "#define __linux 1\n"
    "#define __linux__ 1\n"
    "#define __unix 1\n"
    "#define __unix__ 1\n"
    "#define __LP64__ 1\n"
    "#define __CHAR_BIT__ 8\n"
    "#define __SIZEOF_INT__ 4\n"
    "#define __SIZEOF_LONG__ 8\n"
    "#define __SIZEOF_LONG_LONG__ 8\n"
    "#define __SIZEOF_POINTER__ 8\n"
    /* `__int128` 已在类型层成立（16 字节，见 type.c6 的 TY_I128），所以这个
     * 标准宏可以如实给。内核 include/linux/types.h 用它把
     * `typedef __u128 u128;` 圈在 #ifdef 里，而 arch/x86/include/asm/
     * cmpxchg_64.h 的 `union __u128_halves { u128 full; … };` 无条件用 u128——
     * 不给这个宏，整条 include/linux/types.h 之后的头链在那一行全断。 */
    "#define __SIZEOF_INT128__ 16\n"
    "#define __SIZE_TYPE__ unsigned long\n"
    "#define __PTRDIFF_TYPE__ long\n"
    "#define __WCHAR_TYPE__ int\n"
    "#define __WINT_TYPE__ unsigned int\n"
    "#define __INT32_TYPE__ int\n"
    "#define __INT64_TYPE__ long\n"
    "#define __INTPTR_TYPE__ __PTRDIFF_TYPE__\n"
    "#define __UINTPTR_TYPE__ unsigned __PTRDIFF_TYPE__\n"
    "#define __INT_MAX__ 0x7fffffff\n"
    "#define __LONG_MAX__ 0x7fffffffffffffffL\n"
    "#define __LONG_LONG_MAX__ 0x7fffffffffffffffLL\n"
    "#define __ORDER_LITTLE_ENDIAN__ 1234\n"
    "#define __ORDER_BIG_ENDIAN__ 4321\n"
    "#define __BYTE_ORDER__ __ORDER_LITTLE_ENDIAN__\n"
    "#define __TINYC__ 928\n"
    "#define __c6c__ 1\n"
    "#define __VERSION__ \"c6c\"\n"
    /* glibc 的 __has_* 探测：tcc 一律给 0 */
    "#define __has_attribute(x) 0\n"
    "#define __has_builtin(x) 0\n"
    "#define __has_feature(x) 0\n"
    "#define _Nonnull\n"
    "#define _Nullable\n"
    "#define _Nullable_result\n"
    "#define _Null_unspecified\n"
    /* GNU 拼写 → C 关键字（tcc 是当关键字处理的，我们是标识符，所以要映射） */
    "#define __inline inline\n"
    "#define __inline__ inline\n"
    "#define __restrict restrict\n"
    "#define __restrict__ restrict\n"
    "#define __signed signed\n"
    "#define __signed__ signed\n"
    "#define __const const\n"
    "#define __const__ const\n"
    "#define __volatile volatile\n"
    "#define __volatile__ volatile\n"
    "#define __typeof__ typeof\n"
    "#define __extension__\n"
    "#define __USER_LABEL_PREFIX__\n"
    "#define __REGISTER_PREFIX__\n"
    ;

/* 内建宏 + -D + -U 拼成一个合成文件，走同一条预处理路径。
 *
 * `-D`/`-U` **按位置生效**：只作用于它**后面**出现的源文件。单文件调用和
 * 以前的语义完全一样（只有一个文件，选项在文件前后都一样）；多 TU 时才分得
 * 出差别 —— 每个 TU 有一份自己的宏状态，`c6c a.c -DDEFS b.c` 就是"a.c 不带、
 * b.c 带"。上游 tests2/146_tls_extern 那条用例正好要这个形状（同一个文件编
 * 两遍、一遍给定义一遍引用），而它没有办法用别的写法表达。 */
static void push_defines_at(int ndefs, int nundefs)
{
    size_t cap = 2048 + strlen(BUILTIN_DEFS), n = 0;
    char *buf = NULL;
    int i = 0;
    SrcFile *f = NULL;

    for (i = 0; i < ndefs; i++)
        cap += strlen(O.defs[i]) + 16;
    for (i = 0; i < nundefs; i++)
        cap += strlen(O.undefs[i]) + 16;
    buf = arena_alloc(&A_main, cap);
    n = (size_t)snprintf(buf, cap, "%s", BUILTIN_DEFS);
    /* `__STDC_VERSION__` 跟着 `-std=` 走（c89 里根本没有这条宏） */
    if (O.std == 2)
        n += (size_t)snprintf(buf + n, cap - n, "#define __STDC_VERSION__ 201112L\n");
    else if (O.std == 0)
        n += (size_t)snprintf(buf + n, cap - n, "#define __STDC_VERSION__ 199901L\n");
    /* `-ffreestanding-kernel`：只在这一条路径上给编译器身份宏。
     *
     * 内核 include/linux/compiler_types.h 的分派是
     *   #ifdef __clang__ → compiler-clang.h
     *   #elif defined(__GNUC__) → compiler-gcc.h
     *   #else → #error "Unknown compiler"
     * 没有 __GNUC__ 就没有第三条路可走。而 compiler-gcc.h 的第一件事是
     *   #define GCC_VERSION (__GNUC__*10000 + __GNUC_MINOR__*100 + __GNUC_PATCHLEVEL__)
     * 所以三个都要给，缺一个就是隐式声明 + 算错版本。
     *
     * 取值按"能过内核里那些 __GNUC__ >= N 的判据、但不要假装成太新的版本"
     * 来定：内核只用到 `__GNUC__ >= 14`（CC_HAS_TYPEOF_UNQUAL）这一条硬比较。
     * 报 12/3/0 让那条判据走向"没有 typeof_unqual"，这是 c6c 的真实状态
     * （typeof_unqual 确实不支持），不虚报能力。 */
    if (O.kernel_mode)
        n += (size_t)snprintf(buf + n, cap - n,
                              "#define __GNUC__ 12\n"
                              "#define __GNUC_MINOR__ 3\n"
                              "#define __GNUC_PATCHLEVEL__ 0\n"
                              "#define __GNUC_STDC_INLINE__ 1\n"
                              "#define __NO_INLINE__ 1\n");
    for (i = 0; i < ndefs; i++) {
        const char *d = O.defs[i];
        const char *eq = strchr(d, '=');
        int r = 0;
        if (eq)
            r = snprintf(buf + n, cap - n, "#define %.*s %s\n", (int)(eq - d), d, eq + 1);
        else
            r = snprintf(buf + n, cap - n, "#define %s 1\n", d);
        if (r > 0)
            n += (size_t)r;
    }
    for (i = 0; i < nundefs; i++) {
        int r = snprintf(buf + n, cap - n, "#undef %s\n", O.undefs[i]);
        if (r > 0)
            n += (size_t)r;
    }
    f = src_new("<命令行 -D>", buf, n, 1);
    pp_push_file(f, -1);
}

static void push_defines(void)
{
    push_defines_at(O.ndefs, O.nundefs);
}

static int parse_args(int argc, char **argv)
{
    int i = 0;

    O.bdir = ".";
    O.mode = M_EXE;
    O.run_argi = 0;
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        if (strcmp(a, "-h") == 0 || strcmp(a, "--help") == 0) {
            usage(stdout);
            exit(0);
        } else if (strcmp(a, "--version") == 0) {
            printf("c6c %s（c6 的自举编译器；native / C99 / LLVM IR 三后端）\n", C6C_VERSION);
            exit(0);
        } else if (strcmp(a, "-v") == 0) {
            O.verbose = 1;
        } else if (strcmp(a, "--hello") == 0) {
            if (i + 1 >= argc) {
                fprintf(stderr, "c6c: --hello 需要输出文件名\n");
                return 2;
            }
            exit(x64_hello(argv[++i]));
        } else if (strcmp(a, "--type-selftest") == 0) {
            exit(type_selftest());
        } else if (strcmp(a, "--ir-selftest") == 0) {
            exit(ir_selftest());
        } else if (strcmp(a, "--ir-demo") == 0) {
            ir_demo(stdout);
            exit(0);
        } else if (strcmp(a, "--scan") == 0) {
            O.mode = M_SCAN;
        } else if (strcmp(a, "-fsyntax-only") == 0 || strcmp(a, "--check") == 0) {
            O.mode = M_CHECK;
        } else if (strcmp(a, "-E") == 0) {
            O.mode = M_E;
        } else if (strcmp(a, "--emit-ctu") == 0) {
            /* per-TU C 后端（ctu.c6）：模式一旦定下来，后面的 -c 不再把它改回去 */
            O.mode = M_CTU;
            ctu_set_mode();
        } else if (strcmp(a, "-c") == 0) {
            if (!ctu_mode())
                O.mode = M_OBJ;
        } else if (strcmp(a, "--target=aarch64") == 0) {
            /* 第二套 native 后端：出 aarch64 汇编文本（必须配 -S） */
            O.target_a64 = 1;
        } else if (strncmp(a, "--target=", 9) == 0) {
            diag_error_plain("不认识的 --target=%s（只支持 x86-64 默认与 aarch64）", a + 9);
            return -1;
        } else if (strcmp(a, "-S") == 0) {
            /* 出汇编文本（x86-64，GNU as 语法），不写 ELF */
            O.mode = M_ASM;
        } else if (strcmp(a, "-g") == 0) {
            /* 调试信息：行号表 + DWARF 段（-c 出 .o 时带上，见 dw.c6） */
            O.debug = 1;
        } else if (strcmp(a, "-b") == 0) {
            /* 数组下标的边界检查（见 parse.c6 的 pa_bound_check） */
            O.bcheck = 1;
        } else if (strcmp(a, "-O") == 0) {
            O.olevel = 1;
        } else if (strncmp(a, "-O", 2) == 0 && a[2] >= '0' && a[2] <= '3'
                   && a[3] == 0) {
            O.olevel = a[2] - '0';
        } else if (strcmp(a, "-test") == 0 || strcmp(a, "--test") == 0) {
            /* 和 tcc 的 -test 同一件事：跑 test 块、不跑用户 main。
             * 不给 -o 就编到临时 ELF 再 exec（c6c 没有"进程内执行"那条路）。 */
            O.test = 1;
        } else if (strncmp(a, "-test-filter", 12) == 0
                   && (a[12] == 0 || a[12] == '=')) {
            const char *val = a + 12;

            if (*val == '=') {
                val++;
            } else if (*val == 0) {
                if (i + 1 >= argc) {
                    diag_error_plain("-test-filter 需要参数");
                    return -1;
                }
                i++;
                val = argv[i];
            }
            O.test_filter = val;
        } else if (strcmp(a, "-run") == 0 || strcmp(a, "--run") == 0) {
            /* -run 后面的选项照常解析（"c6c -run -DDEBUG x.c6" 合法），
             * 第一个非选项是程序本体，它后面的参数全归程序。 */
            if (O.mode != M_EXE && O.mode != M_RUN) {
                diag_error_plain("-run 不能和别的输出模式一起用");
                return -1;
            }
            O.run = 1;
            O.mode = M_RUN;
        } else if (strcmp(a, "--emit-c") == 0) {
            c99_set_mode();      /* C99 后端：-o 写的是 .c 源文件 */
        } else if (strcmp(a, "--emit-llvm") == 0) {
            llvm_set_mode();     /* LLVM IR 后端：-o 写的是 .ll */
        } else if (strcmp(a, "--llvm-no-prefix") == 0) {
            llvm_set_noprefix(); /* 符号不加 c6_ 前缀（对接 tcc 风格的 C 侧 ABI） */
        } else if (strcmp(a, "-nostdlib") == 0) {
            O.nostdlib = 1;
        } else if (strcmp(a, "-nostdinc") == 0 || strcmp(a, "-nostdinc++") == 0) {
            /* 不要系统 include 目录。编内核必须用它：内核树的 uapi 头
             * （include/uapi/linux/types.h 等）与发行版装到 /usr/include 里的
             * 那份**同名**，而 setup_incdirs() 把 /usr/include 排在 -I 后面，
             * `#include <linux/posix_types.h>` 就从系统那份走了——于是内核
             * 里的 __kernel_uoff_t 根本不存在（系统 posix_types.h 是给用户态
             * 裁剪过的）。实测内核头链在 types.h:52 断在这里。 */
            O.nostdinc = 1;
        } else if (strcmp(a, "-include") == 0) {
            /* 必须是独立的 `-include file`（kbuild 就长这样）。**这一条要排在
             * 下面那个 '-I/-D/-U/-B/-o' 分支前面**：`-include` 的第二个字符是
             * 'i'，会被 `a[1] == 'I'` 那个大小写不敏感的粘连带分支先吃掉，
             * 于是文件被当成 include 目录加进去，强制包含静默失效
             * （实测：`-include autoconf.h` 收下了但宏根本没进来）。 */
            if (i + 1 >= argc) {
                diag_error_plain("-include 需要参数");
                return -1;
            }
            i++;
            if (O.nforceincs < MAX_INC)
                O.forceincs[O.nforceincs++] = argv[i];
        } else if (strncmp(a, "-include=", 9) == 0) {
            if (O.nforceincs < MAX_INC)
                O.forceincs[O.nforceincs++] = a + 9;
        } else if (a[0] == '-' && (a[1] == 'I' || a[1] == 'D' || a[1] == 'U'
                                   || a[1] == 'B' || a[1] == 'o')) {
            const char *val = a + 2;
            if (*val == 0) {
                if (i + 1 >= argc) {
                    diag_error_plain("%s 需要参数", a);
                    return -1;
                }
                i++;
                val = argv[i];
            }
            if (a[1] == 'I') {
                if (O.nincs < MAX_INC)
                    O.incs[O.nincs++] = val;
            } else if (a[1] == 'D') {
                if (O.ndefs < MAX_DEF)
                    O.defs[O.ndefs++] = val;
            } else if (a[1] == 'U') {
                if (O.nundefs < MAX_DEF)
                    O.undefs[O.nundefs++] = val;
            } else if (a[1] == 'o') {
                O.out = val;
            } else if (a[1] == 'B') {
                O.bdir = val;
            }
        } else if (a[0] == '-' && strncmp(a, "-std=", 5) == 0) {
            /* 只认标准里那几个拼法（gcc/clang 都收这些别名）；语法不变，
             * 只决定 `__STDC_VERSION__`。 */
            const char *sv = a + 5;

            if (strncmp(sv, "c89", 3) == 0 || strncmp(sv, "c90", 3) == 0
                || strncmp(sv, "gnu89", 5) == 0 || strncmp(sv, "iso9899:1990", 12) == 0)
                O.std = 1;
            else if (strncmp(sv, "c99", 3) == 0 || strncmp(sv, "gnu99", 5) == 0
                     || strncmp(sv, "iso9899:1999", 12) == 0)
                O.std = 0;
            else if (strncmp(sv, "c11", 3) == 0 || strncmp(sv, "gnu11", 5) == 0
                     || strncmp(sv, "c17", 3) == 0 || strncmp(sv, "gnu17", 5) == 0
                     || strncmp(sv, "c18", 3) == 0 || strncmp(sv, "gnu18", 5) == 0
                     || strncmp(sv, "iso9899:2011", 12) == 0)
                O.std = 2;
            else {
                diag_error_plain("不认识的 -std=%s（支持 c89/c99/c11 及其 gnu 变体）", sv);
                return -1;
            }
        } else if (strcmp(a, "-Wl,--allow-undefined") == 0) {
            /* 必须在下面那条"吞掉所有 -W*"之前，否则会被静默忽略 */
            O.allow_undef = 1;
        } else if (strcmp(a, "-Wl,--dynamic") == 0) {
            O.dyn_link = 1;
        } else if (strcmp(a, "-shared") == 0) {
            O.so_out = 1;
            O.dyn_link = 1;         /* 共享库必然是动态的（PT_DYNAMIC） */
        } else if (strcmp(a, "-ffreestanding-kernel") == 0) {
            /* 编 Linux 内核用的形态：给 __GNUC__ 那条身份宏（见 Opts 里的
             * 注释）。默认不开——开了会让 glibc 头走 GNU 分支，偏离与 tcc
             * 的 -E 对齐口径。 */
            O.kernel_mode = 1;
            PA_KERNEL_MODE = 1; /* 内核头的 C89 隐式 int 不诊断（parse.c6 前端标志） */
            /* 编内核时自带运行时（lib/rt.c6）一个字节都不能进来：它 include
             * 的是用户态那套头（stdio.h/stdlib.h/string.h…），而 -ffreestanding-
             * kernel 下只从内核树找头，于是立刻报一串"找不到头文件"。
             * 内核自己就是运行时，用不上 c6c 的。 */
            O.nostdlib = 1;
            continue;
        } else if (strcmp(a, "-fPIC") == 0 || strcmp(a, "-fpic") == 0) {
            /* 位置无关代码：native 后端一直是位置无关的（见上面 shared 那条
             * 注释），所以这里收下就够——别让 `-fPIC` 落进未知选项把构建打死。 */
            continue;
        } else if (strncmp(a, "-l", 2) == 0 && a[2] != 0) {
            /* `-l<name>`（`-lm` 最常见）：c6c 的产物是静态的，没有动态库可依赖，
             * 所以这一项**收下但不生效**——libc/libm 的常用面由 c6c/lib/rt.c6
             * 自带（数学函数那一节从 sqrt 到 hypot 都有，std 的用例就是按
             * "静态链接也有 libm"这个前提写的）。真的少了某个符号，链接期会
             * 如实报「未定义的符号」，不会因为收下 `-lm` 而变成运行时炸。 */
            continue;
        } else if (strcmp(a, "-fomit-frame-pointer") == 0 ||
                   strcmp(a, "-fno-omit-frame-pointer") == 0) {
            /* 帧指针省略：c6c 的 x64 后端自己决定帧布局，这个开关不改变
             * 生成代码。内核 kbuild 的 KBUILD_HOSTCFLAGS 固定带它，收下
             * 但不生效，好让 HOSTCC=c6c 直接编 host tools 不被陌生 flag 打死。 */
            continue;
        } else if (strncmp(a, "-Wp,-MMD,", 9) == 0) {
            /* gcc/clang 风格依赖文件：-Wp,-MMD,path。kbuild 编 host tools
             * 固定带它，且靠生成的 .d 驱动 fixdep。真正写出在编译完成后。 */
            O.depfile = a + 9;
            continue;
        } else if (strncmp(a, "-Wl,", 4) == 0) {
            /* -Wl, 开头的是**链接器**选项：不认识的必须报错，不能落进下面
             * 那条"吞掉所有 -W*"的兜底里——否则 `-Wl,--dynamic` 拼错一个字母
             * 会被静默忽略，链接还是静态的，症状是"我明明开了动态链接"却
             * 报未定义符号。kbuild 的 KBUILD_HOSTLDFLAGS 固定带
             * -Wl,--fatal-warnings（把链接告警转错误）；c6c 没有链接告警
             * 子系统，收下不生效。 */
            if (strcmp(a, "-Wl,--fatal-warnings") == 0)
                continue;
            diag_error_plain("不认识的链接器选项 '%s'（支持 -Wl,--allow-undefined"
                             " / -Wl,--dynamic）", a);
            return -1;
        } else if (a[0] == '-' && (a[1] == 'W' || a[1] == 'w')) {
            /* 告警开关：接受并记下来，目前没有告警子系统，静默忽略。
             * tests/errors/*.c6 的 `// FLAGS -Wgeneric-depth` 靠它才不吃错。 */
            continue;
        } else if (a[0] == '-' && a[1] != 0) {
            diag_error_plain("未知选项 '%s'（用 -h 看用法）", a);
            return -1;
        } else {
            if (O.nfiles >= MAX_SRC) {
                diag_error_plain("源文件太多（上限 %d）", MAX_SRC);
                return -1;
            }
            O.fdefs[O.nfiles] = O.ndefs;
            O.fundefs[O.nfiles] = O.nundefs;
            O.files[O.nfiles++] = a;
            if (O.run && !O.test) {
                /* 它就是程序，argv[0] 用源文件名（和 tcc -run 一致）；
                 * 从这里往后的 argv 不再属于编译器。 */
                O.run_argi = i;
                break;
            }
        }
    }
    /* 输入里有 .o：那是"链接"，不是"编译"。混着给不接——c6c 自己的多 TU
     * 编译走单镜像那条路（几个源文件一次压成一份 ELF），而"边编边链"这一版
     * 故意不做：先让 .o → 可执行这一步独立立起来，边界才清楚。 */
    if (O.nfiles > 0) {
        int nobj = 0;
        int k = 0;

        for (k = 0; k < O.nfiles; k++) {
            const char *nm = O.files[k];
            size_t len = strlen(nm);

            if (len > 2 && nm[len - 2] == '.' && nm[len - 1] == 'o')
                nobj++;
        }
        if (nobj) {
            if (nobj != O.nfiles) {
                diag_error_plain("把 .o 和源文件混在一起给不行：先分别 -c，再一次链接");
                return -1;
            }
            if (O.mode != M_EXE) {
                diag_error_plain("链接 .o 时不能用 -c/-E/-fsyntax-only/-run");
                return -1;
            }
            O.mode = M_LINK;
        }
    }
    if (O.so_out && O.mode != M_LINK) {
        diag_error_plain("-shared 的输入得是 .o：先 -c 编出目标文件，再 -shared 链成 .so");
        return -1;
    }
    if (O.run && !O.test) {
        if (O.mode != M_RUN) {
            diag_error_plain("-run 不能和 --scan/-fsyntax-only/-E/-c 一起用");
            return -1;
        }
        if (c99_mode() || llvm_mode()) {
            diag_error_plain("-run 只支持 native 后端（--emit-c / --emit-llvm 要先落盘）");
            return -1;
        }
        if (O.out) {
            diag_error_plain("-run 不写输出文件（去掉 -o）");
            return -1;
        }
        if (O.run_argi == 0) {
            diag_error_plain("-run 需要一个源文件");
            return -1;
        }
    }
    if (O.test) {
        if (O.mode == M_SCAN || O.mode == M_CHECK || O.mode == M_E || O.mode == M_OBJ) {
            diag_error_plain("-test 不能和 --scan/-fsyntax-only/-E/-c 一起用");
            return -1;
        }
        if (c99_mode() || llvm_mode()) {
            diag_error_plain("-test 只支持 native 后端（--emit-c / --emit-llvm 要先落盘）");
            return -1;
        }
        /* 报告的 PASS/FAIL 行走的是自带运行时的 __c6c_test_run()，没有它就没法
         * 按 tcc 的口径报；与其静默跑成"没有输出"，不如直接说清楚。 */
        if (O.nostdlib) {
            diag_error_plain("-test 需要自带运行时的测试报告助手（去掉 -nostdlib）");
            return -1;
        }
        if (O.nfiles == 0) {
            diag_error_plain("-test 需要一个源文件");
            return -1;
        }
        /* -test 自己就是"编完就跑"：清掉 -run 的痕迹（后面本来都是程序参数，
         * 而测试入口不收参数），输出到临时 ELF 还是 -o 由 main() 决定。 */
        O.run = 0;
        O.run_argi = 0;
        if (O.mode == M_RUN)
            O.mode = M_EXE;
    }
    return 0;
}

static char C6C_SELF_DIR[512];

/* c6c **自带**的 include 目录（stddef.h / string.h … 所在的那几个）。
 * 数组本体声明在 parse.c6（它比本文件先被 #include，那边要用），这里只负责填。 */
static void c6_self_incdir_add(const char *dir)
{
    if (dir && N_C6_SELF_INCDIR < C6_SELF_INCDIRS_MAX)
        C6_SELF_INCDIR[N_C6_SELF_INCDIR++] = dir;
}

/* -c 没给 -o 时的默认输出名：`src/foo.c6` → `foo.o`（和 gcc 同一个习惯：
 * 只留下文件名、去掉 .c6 / .c 后缀）。 */
static const char *obj_default_out(const char *src, char *buf, size_t n)
{
    const char *base = src ? src : "a.c6";
    const char *slash = base ? strrchr(base, '/') : NULL;
    size_t len = 0;

    if (slash)
        base = slash + 1;
    len = base ? strlen(base) : 0;
    if (len > 3 && strcmp(base + len - 3, ".c6") == 0)
        len -= 3;
    else if (len > 2 && strcmp(base + len - 2, ".c") == 0)
        len -= 2;
    if (len + 3 > n)
        len = n > 3 ? n - 3 : 0;
    memcpy(buf, base, len);
    memcpy(buf + len, ".o", 3);
    return buf;
}

/* 从 argv[0] 推出编译器自己的目录，供自带 include/ 使用 */
static void setup_self_dir(const char *argv0)
{
    const char *slash = argv0 ? strrchr(argv0, '/') : NULL;
    size_t n = 0;

    if (!slash)
        return;
    n = (size_t)(slash - argv0);
    if (n == 0 || n >= sizeof(C6C_SELF_DIR))
        return;
    memcpy(C6C_SELF_DIR, argv0, n);
    C6C_SELF_DIR[n] = 0;
}

static void setup_incdirs(void)
{
    int i = 0;
    char bd[512] = {0};

    for (i = 0; i < O.nincs && NINCDIR < MAX_INCDIRS; i++)
        INCDIR[NINCDIR++] = O.incs[i];
    /* c6c 自带的 include/（stddef.h / stdarg.h / stdbool.h …）排最前：
     * 优先按 -B 给的目录，其次按 argv[0] 所在目录，最后按源码树相对路径。 */
    if (C6C_SELF_DIR[0]) {
        snprintf(bd, sizeof(bd), "%s/include", C6C_SELF_DIR);
        if (NINCDIR < MAX_INCDIRS) {
            INCDIR[NINCDIR] = arena_strdup(&A_main, bd);
            c6_self_incdir_add(INCDIR[NINCDIR++]);
        }
        snprintf(bd, sizeof(bd), "%s/../include", C6C_SELF_DIR);
        if (NINCDIR < MAX_INCDIRS) {
            INCDIR[NINCDIR] = arena_strdup(&A_main, bd);
            c6_self_incdir_add(INCDIR[NINCDIR++]);
        }
        /* 装出来的布局：<prefix>/bin/c6 + <prefix>/lib/c6/include（和 tcc 的
         * <prefix>/lib/tcc 一个意思——自带头文件不跟 C 库的 include 抢地方）。 */
        snprintf(bd, sizeof(bd), "%s/../lib/c6/include", C6C_SELF_DIR);
        if (NINCDIR < MAX_INCDIRS) {
            INCDIR[NINCDIR] = arena_strdup(&A_main, bd);
            c6_self_incdir_add(INCDIR[NINCDIR++]);
        }
    }
    snprintf(bd, sizeof(bd), "%s/include", O.bdir);
    if (NINCDIR < MAX_INCDIRS) {
        INCDIR[NINCDIR] = arena_strdup(&A_main, bd);
        c6_self_incdir_add(INCDIR[NINCDIR++]);
    }
    /* `-nostdinc`：系统 include 目录一个都不要。自带 include/ 与 -I 仍在
     * （它们不是"系统"目录）——编内核就是这样：头只从内核树里找，
     * /usr/include 里同名的 linux/*、asm/* 必须让开，否则 uapi 头会拿到
     * 发行版裁剪过的那份（types.h:52 那个 __kernel_uoff_t 就是这么丢的）。 */
    if (!O.nostdinc) {
        if (NINCDIR < MAX_INCDIRS)
            INCDIR[NINCDIR++] = "/usr/local/include";
        if (NINCDIR < MAX_INCDIRS)
            INCDIR[NINCDIR++] = "/usr/include/x86_64-linux-gnu";
        if (NINCDIR < MAX_INCDIRS)
            INCDIR[NINCDIR++] = "/usr/include";
    }
    if (O.verbose) {
        int k = 0;

        fprintf(stderr, "c6c: include 目录 %d 个：", NINCDIR);
        for (k = 0; k < NINCDIR; k++)
            fprintf(stderr, " %s", INCDIR[k]);
        fprintf(stderr, "\n");
    }
}

/* ---- -run ----
 *
 * 不走 tcc 那种 mmap + 重定位的 JIT：c6c 只产静态 ELF，而 exec 一份静态映像
 * 本来就是内核最便宜的路径（没有 ld.so、没有 PLT 要解析）。所以 -run 就是
 * "编到临时文件 → fork/exec → 删掉"：产出与 -o 完全同构，不引入第二套装载器，
 * 也不要求 c6c 先学会动态链接（它不会，见 docs/todo.md 第 35 轮）。
 */
static char RUN_PATH[1024];
static int RUN_FD = -1;

/* stage0 用系统 <unistd.h> 时 waitpid 不在里面（它在 <sys/wait.h>），
 * 这里补一条；c6c 自带的 <unistd.h> 里本来就有，同型重复声明合法。 */
int waitpid(int pid, int *status, int options);

static int run_make_tmp(void)
{
    const char *dir = getenv("TMPDIR");
    size_t dn = 0;

    if (!dir || !*dir)
        dir = "/tmp";
    dn = strlen(dir);
    while (dn > 1 && dir[dn - 1] == '/')
        dn--;
    if (dn + sizeof("/c6c-run-XXXXXX") > sizeof(RUN_PATH)) {
        diag_error_plain("TMPDIR 太长，放不下临时文件名");
        return -1;
    }
    memcpy(RUN_PATH, dir, dn);
    memcpy(RUN_PATH + dn, "/c6c-run-XXXXXX", sizeof("/c6c-run-XXXXXX"));
    RUN_FD = mkstemp(RUN_PATH);
    if (RUN_FD < 0) {
        diag_error_plain("建不了临时文件 '%s'", RUN_PATH);
        return -1;
    }
    close(RUN_FD);
    RUN_FD = -1;
    return 0;
}

/* 退出码照抄程序：正常退出取退出码；被信号杀按 shell 惯例给 128+sig。
 * 编译器自己的失败（fork/waitpid）返回 2，和用法错误同一个码。 */
static int run_elf(char **pargv)
{
    int pid = 0;
    int st = 0;

    fflush(stdout);
    pid = fork();
    if (pid < 0) {
        diag_error_plain("fork 失败，执行不了 %s", RUN_PATH);
        return 2;
    }
    if (pid == 0) {
        execvp(RUN_PATH, pargv);
        fprintf(stderr, "c6c: 执行不了 '%s'\n", RUN_PATH);
        _exit(127);
    }
    if (waitpid(pid, &st, 0) < 0) {
        diag_error_plain("等待子进程失败");
        return 2;
    }
    if ((st & 0x7f) == 0)
        return (st >> 8) & 0xff;
    return 128 + (st & 0x7f);
}

/* 库形态（libc6c）不要 main：宿主程序自己有。见 src/c6c-lib.c6。 */
#ifndef C6C_NO_MAIN
int main(int argc, char **argv)
{
    pp_init_time();
    double t0 = 0.0, ms = 0.0;
    int i = 0;

    if (argc > 0 && argv[0] && argv[0][0])
        progname = argv[0];
    {
        int pmrc = (argc >= 2) ? pm_dispatch(argc, argv) : PM_NOT_SUB;
        if (pmrc != PM_NOT_SUB)
            return pmrc;
    }
    if (parse_args(argc, argv) < 0)
        return 2;
    if (O.nfiles == 0) {
        usage(stderr);
        return 2;
    }
    setup_self_dir(argv[0]);
    setup_incdirs();

    switch (O.mode) {
    case M_LINK: {
        /* 只做链接：所有输入都是 ET_REL 目标文件，产出静态可执行文件。
         * 退出码 0 = 成功，2 = 链接失败（ld.c6 里已经把原因写到 stderr 了）。
         * `-shared` 时改成 ET_DYN 共享库。 */
        ld_set_allow_undef(O.allow_undef);
        ld_set_dynamic(O.dyn_link);
        ld_set_shared(O.so_out);
        return ld_link(O.files, O.nfiles, O.out ? O.out : (O.so_out ? "a.so" : "a.out"));
    }
    case M_OBJ:
    case M_EXE:
    case M_RUN:
    case M_ASM: {
        /* M_OBJ 出 ET_REL（真正的 .o，可重定位，见 obj.c6）；M_EXE / M_RUN 出
         * 可直接执行的静态 ELF。 */
        SrcFile *sf = NULL;
        char objname[512] = {0};
        const char *out = O.out ? O.out : "a.out";
        /* -run 和"没给 -o 的 -test"都走临时 ELF：编完就地 exec，退出码照抄 */
        int tmp_out = (O.mode == M_RUN) || (O.test && !O.out);
        int rc = 0;

        if (O.mode == M_OBJ && !O.out)
            out = obj_default_out(O.files[0], objname, sizeof(objname));
        if (O.mode == M_ASM && !O.out)
            out = obj_default_out(O.files[0], objname, sizeof(objname));
        aso_set_mode(O.mode == M_ASM);
        aout_set_target(O.target_a64);
        if (O.target_a64 && O.mode != M_ASM) {
            diag_error_plain("--target=aarch64 现在只支持 -S（出汇编文本）");
            return 2;
        }
        if (O.mode == M_OBJ && O.nfiles > 1) {
            /* 一个 .o 对应一个 TU。多个输入要分别出 .o，那得把编译拆成多次
             * 跑（符号表 / 数据段 / 代码段都是整份镜像一份）。先如实拒绝，
             * 别把两个 TU 悄悄并进一个 .o —— 那样链接期符号会重复。 */
            diag_error_plain("-c 一次只编一个源文件（多个输入请分别出 .o）");
            return 2;
        }
        pa_set_reloc(O.mode == M_OBJ);
        pa_set_bcheck(O.bcheck);
        ir_set_opt(O.olevel);
        if (O.debug) {
            ir_set_lines(1);        /* 每条 IR 记源码行 */
            x64_set_debug(1);       /* 代码偏移 → 行 */
            obj_set_debug(1);       /* -c 出 .o 时写 .debug_* 段 */
            if (O.nfiles > 0)
                obj_set_debug_src(O.files[0]);
        }
        if (tmp_out) {
            if (run_make_tmp() < 0)
                return 2;
            out = RUN_PATH;
            PA_QUIET_OUT = 1;   /* 临时文件名不值得刷屏 */
        }
        if (O.test)
            pa_set_test_mode(O.test_filter ? O.test_filter : "");
        /* 告诉前端"这次编了几个输入文件"：单文件走快路（static 符号不改名），
         * 多文件才需要按 TU 分家。放在分支之前，两种模式都覆盖到。 */
        pa_set_nfiles((u32)(O.nfiles > 0 ? O.nfiles : 1));
        if (O.nfiles > 1) {
            /* 多 TU：一个源文件 = 一个翻译单元。符号表 / 数据段 / 代码段
             * 整份镜像一份（外部符号按名字互认），文件作用域的 static 按
             * TU 分家（见 parse.c6 的 tu_static_name、sym.c6 的 sym_tu_begin）。
             * 自带运行时是 TU 0。 */
            int fi = 0;

            rc = pa_begin_multi(out, argv[0],
                                (O.mode == M_EXE || O.mode == M_RUN || O.mode == M_ASM
                                 || tmp_out) && !O.nostdlib);
            for (fi = 0; rc == 0 && fi < O.nfiles; fi++) {
                pp_reset();
                sf = src_load(O.files[fi]);
                if (!sf) {
                    diag_error_plain("打不开源文件 '%s'", O.files[fi]);
                    rc = 2;
                    break;
                }
                pp_push_file(sf, -1);
                if (push_forceincs() != 0) {
                    rc = 2;
                    break;
                }
                push_defines_at(O.fdefs[fi], O.fundefs[fi]);
                pa_parse_new_tu();
                if (DG.errors > 200) {
                    diag_error_plain("错误太多，停止（%d）", DG.errors);
                    rc = 1;
                }
            }
            if (rc == 0)
                rc = pa_finish(out);
        } else {
            /* 单个源文件：和以前完全一样（一个 TU，自带运行时接在后面）。
             * 这条路的字节级行为不能变——自举 fixpoint 就是它编出来的。 */
            pp_reset();
            sf = src_load(O.files[0]);
            if (!sf) {
                diag_error_plain("打不开源文件 '%s'", O.files[0]);
                PA_QUIET_OUT = 0;
                if (tmp_out)
                    unlink(RUN_PATH);
                return 2;
            }
            pp_push_file(sf, -1);
            /* 压栈是后进先出：源文件压完之后再压 -include，它们才会排在
             * 源文件**前面**展开（见 push_forceincs 的注释）。 */
            if (push_forceincs() != 0) {
                PA_QUIET_OUT = 0;
                if (tmp_out)
                    unlink(RUN_PATH);
                return 2;
            }
            push_defines();
            rc = pa_compile_ex(out, argv[0],
                               (O.mode == M_EXE || O.mode == M_RUN || O.mode == M_ASM
                                || tmp_out) && !O.nostdlib);
        }
        PA_QUIET_OUT = 0;
        if (O.verbose)
            mod_report();
        if (tmp_out) {
            if (rc == 0) {
                if (O.test) {
                    /* 测试入口不收参数（tcc 的 -test 也一样） */
                    char *targv[2] = {0};

                    targv[0] = RUN_PATH;
                    rc = run_elf(targv);
                } else {
                    rc = run_elf(argv + O.run_argi);
                }
            }
            unlink(RUN_PATH);
        }
        if (rc == 0 && O.depfile)
            emit_depfile(O.depfile);
        return rc;
    }
    case M_SCAN: {
        /* 只做预处理 + 词法：不出码、不做语法分析，只数 token 报速度 */
        SrcFile *sf = NULL;
        double ms = 0.0;

        if (O.nfiles > 1) {
            diag_error_plain("--scan 一次一个文件");
            return 2;
        }
        sf = src_load(O.files[0]);
        if (!sf) {
            diag_error_plain("打不开源文件 '%s'", O.files[0]);
            return 2;
        }
        pp_reset();
        pp_push_file(sf, -1);
        push_defines();
        t0 = now_ms();
        for (;;) {
            Tok t = {0};

            if (pp_next(&t) == TK_EOF)
                break;
            ST_tok++;
            if (t.kind >= 0 && t.kind < 8)
                ST_kind[t.kind]++;
        }
        ms = now_ms() - t0;
        stat_totals();
        print_stats(ms);
        return DG.errors ? 1 : 0;
    }
    case M_CHECK: {
        SrcFile *sf = NULL;

        if (O.nfiles < 1) {
            diag_error_plain("没有输入文件");
            return 2;
        }
        /* 和 M_EXE/M_OBJ 一样：命令行上有几个源文件就压几个。跨翻译单元的
         * 检查（引用环这类要整个程序的）只有把第二个单元也解析出来才看得见
         * —— 以前这里只读 O.files[0]，`-fsyntax-only a.c6 b.c6` 静默丢掉
         * b.c6（tests/errors/gc_cycle_cross_tu.c6 + tests/tu/ 那两个文件）。 */
        pp_reset();
        {
            int fi = O.nfiles - 1;

            for (; fi >= 0; fi--) {
                sf = src_load(O.files[fi]);
                if (!sf) {
                    diag_error_plain("打不开源文件 '%s'", O.files[fi]);
                    return 2;
                }
                pp_push_file(sf, -1);
            }
        }
        /* -include 压在所有源文件之后（后进先出 → 它们先展开）。这个循环是
         * **倒序**压的（`O.files[0]` 最后压 = 最先处理），-include 放在循环
         * 之后才排在每个源文件前面，和 gcc 的顺序一致。 */
        if (push_forceincs() != 0)
            return 2;
        push_defines();
        /* 真做语法检查：完整跑一遍前端（不写输出、不要求 main）。
         * 自带运行时**要照样带**：不带的话 printf/setenv/fork 这些声明就看不见，
         * `-fsyntax-only` 会把一堆本来没问题的模块判死（std 的 153 个模块全靠
         * 这条路径量，口径错了数就是假的）。 */
        PA_SYNTAX_ONLY = 1;
        pa_set_nfiles((u32)(O.nfiles > 0 ? O.nfiles : 1));
        return pa_compile_ex(0, argv[0], !O.nostdlib);
    }
    default:
        break;
    }

    OUTBUF.cap = 1024 * 1024;
    OUTBUF.buf = malloc(OUTBUF.cap);
    OUTBUF.n = 0;
    if (!OUTBUF.buf) {
        diag_error_plain("分配输出缓冲失败");
        return 2;
    }

    t0 = now_ms();
    if (O.mode == M_CTU) {
        /* per-TU C（ctu.c6）：一个输入一个 .c，写失败必须非 0 退出 */
        if (O.nfiles < 1) {
            diag_error_plain("没有输入文件");
            return 2;
        }
        for (i = 0; i < O.nfiles; i++) {
            pp_reset();
            if (ctu_emit(O.files[i], O.out, O.nfiles) != 0)
                return 1;
        }
        if (DG.errors) {
            fprintf(stderr, "c6c: %d 个错误\n", DG.errors);
            return 1;
        }
        return 0;
    }
    if (O.mode == M_E) {
        for (i = 0; i < O.nfiles; i++) {
            pp_reset();
            emit_one(O.files[i]);
        }
        out_flush(&OUTBUF);
    } else {
        for (i = 0; i < O.nfiles; i++) {
            pp_reset();
            scan_one(O.files[i]);
        }
    }
    ms = now_ms() - t0;

    stat_totals();
    if (O.mode != M_E)
        print_stats(ms);
    if (O.verbose)
        arena_report();
    if (DG.errors) {
        fprintf(stderr, "c6c: %d 个错误\n", DG.errors);
        return 1;
    }
    return 0;
}
#endif /* C6C_NO_MAIN */
