/* c6 编译期诊断：'foreach ((size_t i, int v) = a) { ... }'
 *
 * 每个片段单独用 -D<片段名> 编译（tests/run-tests.sh 驱动），
 * `// EXPECT <片段名>: <诊断文本>` 行声明该片段必须产生的诊断。
 * 不带任何 -D 时是本文件的“正常路径”，必须编译通过并运行成功。
 */
#include <stddef.h>

struct S;
extern int unknown[];

// EXPECT test_two_binders_range: error: a range yields only an index: write 'foreach (size_t i = lo:hi) { ... }'
// EXPECT test_both_discard: error: 'foreach' discards both binders
// EXPECT test_pointer: error: cannot iterate over 'int *' (no 'has'/'next' iterator: use a slice parameter 'T[:]', or '(T[:]){p, n}')
// EXPECT test_int: error: cannot iterate over 'int' (write a range: 'foreach (size_t i = lo:hi) { ... }')
// EXPECT test_struct: error: cannot iterate over 'struct S' (no 'has'/'next' iterator: expose a slice member 'T[:] items', or define 'int has(T *); E next(T *);')
// EXPECT test_struct_pointer: error: cannot iterate over 'struct S *' (no 'has'/'next' iterator: use a slice parameter 'T[:]', or '(T[:]){p, n}')
// EXPECT test_vla: error: cannot iterate over a variable length array
// EXPECT-C99 test_vla: error: c99 output: variable length arrays are not supported
// EXPECT test_unknown_length: error: cannot iterate over an array of unknown length
// EXPECT test_float_range: error: range bounds must be integers
// EXPECT test_no_block: error: '{' expected
// EXPECT test_no_block_range: error: '{' expected
// EXPECT test_array_element: error: a 'foreach' binding cannot be an array
// EXPECT test_file_scope: error: 'foreach' can only be used inside a function

#if defined test_two_binders_range
int main(void)
{
    int total = 0;
    foreach ((size_t i, int v) = 0:2) {
        total += i + v;
    }
    return total;
}
#elif defined test_both_discard
int main(void)
{
    int a[2] = { 1, 2 };
    foreach ((size_t _, int _) = a) {
        a[0] = 0;
    }
    return a[0];
}
#elif defined test_pointer
int main(void)
{
    int a[2] = { 1, 2 };
    int *p = a;
    foreach ((size_t i, int v) = p) {
        a[0] = i + v;
    }
    return a[0];
}
#elif defined test_int
int main(void)
{
    int n = 2;
    foreach ((size_t i, int v) = n) {
        n += i + v;
    }
    return n;
}
#elif defined test_struct
int main(void)
{
    struct S *ps = 0;
    foreach ((size_t i, int v) = *ps) {
        ps = (struct S *)(long)(i + v);
    }
    return ps != 0;
}
#elif defined test_struct_pointer
int main(void)
{
    struct S *ps = 0;
    foreach ((size_t i, int v) = ps) {
        ps = (struct S *)(long)(i + v);
    }
    return ps != 0;
}
#elif defined test_vla
int main()
{
    int n = 2;
    int a[n];
    foreach ((size_t i, int v) = a) {
        a[0] = i + v;
    }
    return a[0];
}
#elif defined test_unknown_length
int main(void)
{
    foreach ((size_t i, int v) = unknown) {
        return i + v;
    }
    return 0;
}
#elif defined test_float_range
int main(void)
{
    foreach (int i = 0.0:2.0) {
        return i;
    }
    return 0;
}
#elif defined test_no_block
int main(void)
{
    int a[2] = { 1, 2 };
    foreach ((size_t i, int v) = a)
        a[0] = i + v;
    return a[0];
}
#elif defined test_no_block_range
int main(void)
{
    /* 区间分支也要走同一条 '{' 检查（C50）：单绑定头走的是区间路径，
       所以它和数组/切片形态是两条独立的解析路径。 */
    foreach (int i = 0:2)
        return i;
    return 0;
}
#elif defined test_array_element
int main(void)
{
    int a[2][2] = { { 1, 2 }, { 3, 4 } };
    foreach ((size_t i, int v[2]) = a) {
        a[0][0] = i + v[0];
    }
    return a[0][0];
}
#elif defined test_file_scope
int a[2] = { 1, 2 };
foreach ((size_t i, int v) = a) {
    a[0] = i + v;
}
#else
/* 正常路径：数组、切片、区间各走一遍 */
struct P { int x, y; };

static int sum(int[:] s)
{
    int total = 0;
    foreach ((size_t i, int v) = s) {
        total += (int)i + v;
    }
    return total;
}

int main(void)
{
    int a[3] = { 1, 2, 3 };
    struct P ps[2] = { { 1, 2 }, { 3, 4 } };
    int total = 0;

    foreach ((size_t i, int v) = a) {
        total += v;
    }
    foreach (int i = 1:3) {
        total += i;
    }
    foreach ((size_t i, struct P p) = ps) {
        total += (int)i + p.y;
    }
    if (total != 6 + 1 + 2 + 0 + 2 + 1 + 4)
        return 1;
    if (sum(a) != (0 + 1) + (1 + 2) + (2 + 3))
        return 2;
    return 0;
}
#endif
