+
+static int *superc_hygiene_body(const int *body)
+{
+    static int seq;
+    TokenString out;
+    CValue cval;
+    const int *p;
+    int hl, id, t, i, prev, nb = 0, *locals = NULL;
+
+    hl = tok_alloc("__local", 7)->tok;
+    id = ++seq;
+    p = body;
+    prev = 0;
+    for (;;) {
+        TOK_GET(&t, &p, &cval);
+        if (t == 0)
+            break;
+        if (t == hl) {
+            do {
+                TOK_GET(&t, &p, &cval);
+            } while (t && (is_space(t) || t == TOK_LINEFEED));
+            if (t < TOK_IDENT || TOK_HAS_VALUE(t))
+                tcc_error("'__local' must be followed by an identifier");
+            if (prev == '#' || prev == TOK_PPJOIN || prev == TOK_TWOSHARPS)
+                tcc_error("cannot apply '#' or '##' to a '__local' name");
+            locals = tcc_realloc(locals, (nb + 1) * sizeof(int));
+            locals[nb++] = t;
+            prev = t;
+            continue;
+        }
+        if (!is_space(t) && t != TOK_LINEFEED)
+            prev = t;
+    }
+    tok_str_new(&out);
+    p = body;
+    prev = 0;
+    for (;;) {
+        TOK_GET(&t, &p, &cval);
+        if (t == 0)
+            break;
+        if (t == hl) {
+            do {
+                TOK_GET(&t, &p, &cval);
+            } while (t && (is_space(t) || t == TOK_LINEFEED));
+            tok_str_add2(&out, superc_local_name(t, id), &cval);
+            continue;
+        }
+        if (t >= TOK_IDENT) {
+            for (i = 0; i < nb; i++)
+                if (locals[i] == t) {
+                    t = superc_local_name(t, id);
+                    break;
+                }
+        }
+        tok_str_add2(&out, t, &cval);
+    }
+    tok_str_add(&out, 0);
+    tcc_free(locals);
+    return out.str;
+}
