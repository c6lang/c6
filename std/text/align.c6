/* std/text/align：Needleman-Wunsch 全局序列比对（含回溯出的带空位序列）。
 *
 *     import std.text.align;
 *
 *     int dp[64] = { 0 };
 *     char ra[16] = { 0 }, rb[16] = { 0 };
 *     Aligner al = { 0 };
 *     AlignResult r = { 0 };
 *     al.setup(dp, 64, ra, rb, 16);       // 方法：setup / run
 *     al.run(S("GATTACA"), S("GCATGCU"), 1, -1, -1, &r);
 *     // r.score / r.matches / r.gaps，ra/rb 是对齐后的序列（含 '-'）
 *
 * DP 表由调用方给（`int` 数组，容量至少 `(a.len+1) * (b.len+1)`），比对结果是两条
 * **等长**的字符串（空位用 `-` 表示），长度不超过 `cap - 1`。
 *
 * 约定：
 *
 * - `al.setup(dp, dpcap, abuf, bbuf, cap)` 绑定缓冲区，返回 1；
 * - `al.run(a, b, match, mismatch, gap, &res)` 做比对，成功返回对齐长度，失败 -1；
 *   打分参数：相同 +match、不同 +mismatch、空位 +gap（通常 mismatch/gap 给负数）；
 * - `res.score` 是总分，`res.matches`/`res.mismatches`/`res.gaps` 是列统计；
 * - 同样的分数有多条最优路径时优先「对角（匹配/替换）→ 上（b 插空位）→ 左」；
 * - 缓冲不够时返回 -1（不会写越界）。
 */
#include <string.h>

module std.text.align;
import std.core.types;
import std.text.str;

struct AlignResult {
    int score;
    int matches;
    int mismatches;
    int gaps;
    int len;
};

struct Aligner {
    int *dp;
    int dpcap;
    char *abuf;
    char *bbuf;
    int cap;
};

int setup(Aligner *al, void *dp, int dpcap, char *abuf, char *bbuf, int cap)
{
    if (!al || !dp || dpcap <= 0 || !abuf || !bbuf || cap <= 1)
        return -1;
    memset(al, 0, sizeof *al);
    al->dp = (int *)dp;
    al->dpcap = dpcap;
    al->abuf = abuf;
    al->bbuf = bbuf;
    al->cap = cap;
    memset(dp, 0, sizeof(int) * (size_t)dpcap);
    memset(abuf, 0, (size_t)cap);
    memset(bbuf, 0, (size_t)cap);
    return 1;
}

static int al_idx(Aligner *al, int i, int j, int cols)
{
    (void)al;
    return i * cols + j;
}

int run(Aligner *al, char[:] a, char[:] b, int match, int mismatch, int gap,
        AlignResult *res)
{
    int rows = 0, cols = 0, i = 0, j = 0;
    int need = 0;

    if (!al || !al->dp || !al->abuf || !al->bbuf || !res)
        return -1;
    if ((!a.data && a.len > 0) || (!b.data && b.len > 0))
        return -1;
    rows = a.len + 1;
    cols = b.len + 1;
    need = rows * cols;
    if (need > al->dpcap)
        return -1;
    if (a.len + 1 > al->cap || b.len + 1 > al->cap)
        return -1;
    memset(res, 0, sizeof *res);
    for (i = 0; i < rows; i++)
        al->dp[al_idx(al, i, 0, cols)] = i * gap;
    for (j = 0; j < cols; j++)
        al->dp[al_idx(al, 0, j, cols)] = j * gap;
    for (i = 1; i < rows; i++) {
        for (j = 1; j < cols; j++) {
            int s = (a.data[i - 1] == b.data[j - 1]) ? match : mismatch;
            int diag = al->dp[al_idx(al, i - 1, j - 1, cols)] + s;
            int up = al->dp[al_idx(al, i - 1, j, cols)] + gap;
            int left = al->dp[al_idx(al, i, j - 1, cols)] + gap;
            int best = diag;

            if (up > best)
                best = up;
            if (left > best)
                best = left;
            al->dp[al_idx(al, i, j, cols)] = best;
        }
    }
    res->score = al->dp[al_idx(al, rows - 1, cols - 1, cols)];
    /* 回溯（先写反序的临时数组再翻转） */
    {
        char tmpa[512] = { 0 };
        char tmpb[512] = { 0 };
        int n = 0;

        i = rows - 1;
        j = cols - 1;
        while (i > 0 || j > 0) {
            if (n >= 511)
                return -1;
            if (i > 0 && j > 0) {
                int s = (a.data[i - 1] == b.data[j - 1]) ? match : mismatch;

                if (al->dp[al_idx(al, i, j, cols)]
                    == al->dp[al_idx(al, i - 1, j - 1, cols)] + s) {
                    tmpa[n] = a.data[i - 1];
                    tmpb[n] = b.data[j - 1];
                    n++;
                    i--;
                    j--;
                    continue;
                }
            }
            if (i > 0
                && al->dp[al_idx(al, i, j, cols)]
                       == al->dp[al_idx(al, i - 1, j, cols)] + gap) {
                tmpa[n] = a.data[i - 1];
                tmpb[n] = '-';
                n++;
                i--;
                continue;
            }
            tmpa[n] = '-';
            tmpb[n] = b.data[j - 1];
            n++;
            j--;
        }
        if (n + 1 > al->cap)
            return -1;
        for (i = 0; i < n; i++) {
            al->abuf[i] = tmpa[n - 1 - i];
            al->bbuf[i] = tmpb[n - 1 - i];
        }
        al->abuf[n] = 0;
        al->bbuf[n] = 0;
        res->len = n;
        /* 列统计 */
        for (i = 0; i < n; i++) {
            if (al->abuf[i] == '-' || al->bbuf[i] == '-')
                res->gaps++;
            else if (al->abuf[i] == al->bbuf[i])
                res->matches++;
            else
                res->mismatches++;
        }
    }
    return res->len;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "align：完全相同与替换" {
    int dp[64] = { 0 };
    char ra[16] = { 0 }, rb[16] = { 0 };
    Aligner al = { 0 };
    AlignResult r = { 0 };

    if (al.setup(dp, 64, ra, rb, 16) != 1)
        return err(1, "setup 失败");
    if (al.run(S("abc"), S("abc"), 1, -1, -1, &r) != 3)
        return err(2, "相同序列的对齐长度应该是 3");
    if (r.score != 3 || r.matches != 3 || r.gaps != 0)
        return err(3, "相同序列的分数/统计不对");
    if (memcmp(ra, "abc", 3) != 0 || memcmp(rb, "abc", 3) != 0)
        return err(4, "相同序列的对齐结果不对");
    /* 一个替换 */
    if (al.run(S("abc"), S("abd"), 1, -1, -1, &r) != 3)
        return err(5, "替换的长度不对");
    if (r.score != 1 || r.mismatches != 1 || r.matches != 2)
        return err(6, "替换的分数不对");
    if (ra[2] != 'c' || rb[2] != 'd')
        return err(7, "替换位置不对");
}

test "align：空位与空格序列" {
    int dp[64] = { 0 };
    char ra[16] = { 0 }, rb[16] = { 0 };
    Aligner al = { 0 };
    AlignResult r = { 0 };

    al.setup(dp, 64, ra, rb, 16);
    /* 少一个字符 → 一个空位 */
    if (al.run(S("abc"), S("ac"), 1, -1, -1, &r) != 3)
        return err(8, "带空位的长度应该是 3");
    if (r.score != 1 || r.gaps != 1)
        return err(9, "a+空位+c 的分数应该是 2-1=1");
    if (ra[1] != 'b' || rb[1] != '-')
        return err(10, "空位应该出现在 b 的一侧");
    /* 空序列 */
    if (al.run(S(""), S("ab"), 1, -1, -1, &r) != 2)
        return err(11, "空与 ab 的对齐长度应该是 2");
    if (r.score != -2 || r.gaps != 2)
        return err(12, "两个空位的分数应该是 -2");
    if (memcmp(ra, "--", 2) != 0 || memcmp(rb, "ab", 2) != 0)
        return err(13, "空序列对齐结果不对");
    if (al.run(S("abc"), S(""), 1, -1, -1, &r) != 3 || r.score != -3)
        return err(14, "abc 与空序列的分数应该是 -3");
    /* 经典例子：GATTACA vs GCATGCU */
    if (al.run(S("GATTACA"), S("GCATGCU"), 1, -1, -1, &r) != 8)
        return err(15, "GATTACA/GCATGCU 的对齐长度应该是 8");
    if (r.score != 0)
        return err(16, "GATTACA/GCATGCU 的最优分数应该是 0");
    if (r.matches + r.mismatches + r.gaps != r.len)
        return err(17, "列统计应该加起来等于长度");
    /* 缓冲区不够 */
    {
        int small[4] = { 0 };
        char xa[2] = { 0 }, xb[2] = { 0 };

        al.setup(small, 4, xa, xb, 2);
        if (al.run(S("abc"), S("abd"), 1, -1, -1, &r) != -1)
            return err(18, "DP 表太小应该返回 -1");
    }
}
