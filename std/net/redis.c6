/* std/net/redis：Redis 的 RESP 协议（简单串 / 错误 / 整数 / 批量串 / 数组）编解码。
 *
 *     import std.net.redis;
 *
 *     Resp r = { 0 };
 *     char out[256] = { 0 };
 *     if (resp_parse(buf, n, 0, &r) == 1)
 *         // r.type / r.integer / r.len / r.data_off / r.total
 *     resp_encode_cmd(argv, argc, out, (int)sizeof out);   // *n + 各 $len 块
 *
 * 五种类型前缀：`+` 简单串、`-` 错误、`:` 整数、`$` 批量串、`*` 数组。行尾都是
 * CRLF；批量串在长度行之后跟数据与 CRLF；长度/个数为 `-1` 表示 null。
 *
 * 约定：
 *
 * - `resp_parse` 从 `off` 解**一个**值：`type` 是前缀字符，`data_off` 指向内容
 *   起点（简单串/错误/批量串的数据），`len` 是内容长度或数组元素个数，`total`
 *   是整段字节数；null 时 `null` 置 1 且 `len` 为 -1；
 * - 数组只解头（元素要调用方按 `total` 递进继续解）；
 * - `resp_parse` 不认行内联命令（inline command），也不做管道批处理；
 * - `resp_encode_bulk` 写 `$len\r\n…\r\n`，`resp_encode_int` 写 `:v\r\n`，
 *   `resp_encode_array_hdr` 写 `*n\r\n`，`resp_encode_cmd` 把 `argv` 编成数组 +
 *   批量串（Redis 客户端发命令的标准形态）；
 * - 容量不够一律返回 -1。
 */
#include <string.h>

module std.net.redis;
import std.core.types;
import std.text.str;

struct Resp {
    int type;
    i64 integer;
    int len;
    int null;
    int data_off;
    int total;
};

static int resp_line_end(const u8 *p, int n, int off)
{
    int i = 0;

    for (i = off; i + 1 < n; i++) {
        if (p[i] == '\r' && p[i + 1] == '\n')
            return i;
    }
    return -1;
}

static int resp_int(const u8 *p, int off, int end, i64 *out)
{
    int i = off, sign = 1;
    i64 v = 0;
    int digits = 0;

    if (i < end && p[i] == '-') {
        sign = -1;
        i++;
    }
    for (; i < end; i++) {
        if (p[i] < '0' || p[i] > '9')
            return -1;
        v = v * 10 + (i64)(p[i] - '0');
        digits++;
        if (v > 1000000000000LL)
            return -1;
    }
    if (!digits)
        return -1;
    *out = v * sign;
    return 1;
}

int resp_parse(const void *src, int n, int off, Resp *out)
{
    const u8 *p = (const u8 *)src;
    int end = 0;

    if (!src || !out || off < 0 || off + 3 > n)
        return -1;
    memset(out, 0, sizeof *out);
    out->type = (int)p[off];
    switch (p[off]) {
    case '+':
    case '-': {
        int start = off + 1;

        end = resp_line_end(p, n, start);
        if (end < 0)
            return -1;
        out->data_off = start;
        out->len = end - start;
        out->total = end + 2 - off;
        return 1;
    }
    case ':': {
        i64 v = 0;

        end = resp_line_end(p, n, off + 1);
        if (end < 0)
            return -1;
        if (resp_int(p, off + 1, end, &v) != 1)
            return -1;
        out->integer = v;
        out->data_off = off + 1;
        out->len = end - off - 1;
        out->total = end + 2 - off;
        return 1;
    }
    case '$': {
        i64 v = 0;

        end = resp_line_end(p, n, off + 1);
        if (end < 0)
            return -1;
        if (resp_int(p, off + 1, end, &v) != 1)
            return -1;
        out->len = (int)v;
        if (v == -1) {
            out->null = 1;
            out->total = end + 2 - off;
            return 1;
        }
        if (v < 0 || end + 2 + (int)v + 2 > n)
            return -1;
        out->data_off = end + 2;
        out->total = end + 2 + (int)v + 2 - off;
        if (p[end + 2 + (int)v] != '\r'
            || p[end + 2 + (int)v + 1] != '\n')
            return -1;
        return 1;
    }
    case '*': {
        i64 v = 0;

        end = resp_line_end(p, n, off + 1);
        if (end < 0)
            return -1;
        if (resp_int(p, off + 1, end, &v) != 1)
            return -1;
        out->len = (int)v;
        if (v == -1) {
            out->null = 1;
            out->total = end + 2 - off;
            return 1;
        }
        if (v < 0)
            return -1;
        out->data_off = end + 2;
        out->total = end + 2 - off;
        return 1;
    }
    default:
        return -1;
    }
}

int resp_encode_bulk(char[:] src, char *dst, int cap)
{
    if (!dst || cap < 0 || src.len < 0)
        return -1;
    {
        int need = 0, o = 0;
        char num[32] = { 0 };
        int k = 0, v = src.len;

        if (v == 0) {
            num[0] = '0';
            k = 1;
        }
        while (v > 0 && k < 30) {
            num[k++] = (char)('0' + v % 10);
            v /= 10;
        }
        need = 1 + k + 2 + src.len + 2;
        if (need > cap)
            return -1;
        dst[o++] = '$';
        {
            int i = 0;

            for (i = k - 1; i >= 0; i--)
                dst[o++] = num[i];
        }
        dst[o++] = '\r';
        dst[o++] = '\n';
        {
            int i = 0;

            for (i = 0; i < src.len; i++)
                dst[o++] = src.data[i];
        }
        dst[o++] = '\r';
        dst[o++] = '\n';
        if (o < cap)
            dst[o] = 0;
        return o;
    }
}

int resp_encode_int(i64 v, char *dst, int cap)
{
    char num[32] = { 0 };
    int k = 0, o = 0;
    u64 uv = 0;
    int neg = v < 0;

    if (!dst || cap < 0)
        return -1;
    uv = neg ? (u64)(-(v + 1)) + 1 : (u64)v;
    if (uv == 0) {
        num[0] = '0';
        k = 1;
    }
    while (uv > 0 && k < 30) {
        num[k++] = (char)('0' + (int)(uv % 10));
        uv /= 10;
    }
    o = 1 + (neg ? 1 : 0) + k + 2;
    if (o > cap)
        return -1;
    {
        int i = 0, w = 0;

        dst[w++] = ':';
        if (neg)
            dst[w++] = '-';
        for (i = k - 1; i >= 0; i--)
            dst[w++] = num[i];
        dst[w++] = '\r';
        dst[w++] = '\n';
        if (w < cap)
            dst[w] = 0;
        return w;
    }
}

int resp_encode_array_hdr(int n, char *dst, int cap)
{
    char num[32] = { 0 };
    int k = 0, o = 0;

    if (!dst || cap < 0 || n < 0)
        return -1;
    if (n == 0) {
        num[0] = '0';
        k = 1;
    }
    while (n > 0 && k < 30) {
        num[k++] = (char)('0' + n % 10);
        n /= 10;
    }
    o = 1 + k + 2;
    if (o > cap)
        return -1;
    {
        int i = 0, w = 0;

        dst[w++] = '*';
        for (i = k - 1; i >= 0; i--)
            dst[w++] = num[i];
        dst[w++] = '\r';
        dst[w++] = '\n';
        if (w < cap)
            dst[w] = 0;
        return w;
    }
}

int resp_encode_cmd(const char **argv, int argc, char *dst, int cap)
{
    int o = 0, i = 0, r = 0;

    if (!argv || !dst || argc <= 0 || cap < 0)
        return -1;
    r = resp_encode_array_hdr(argc, dst, cap);
    if (r < 0)
        return -1;
    o = r;
    for (i = 0; i < argc; i++) {
        int len = (int)strlen(argv[i]);

        r = resp_encode_bulk((char[:]){ (char *)argv[i], len }, dst + o, cap - o);
        if (r < 0)
            return -1;
        o += r;
    }
    return o;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "RESP：解析五种类型" {
    Resp r = { 0 };
    static u8 buf[64] = { 0 };

    memcpy(buf, "+OK\r\n", 5);
    if (resp_parse(buf, 5, 0, &r) != 1)
        return err(1, "简单串解析失败");
    if (r.type != '+' || r.len != 2 || r.data_off != 1 || r.total != 5)
        return err(2, "简单串字段不对");
    memcpy(buf, "-ERR unknown\r\n", 14);
    if (resp_parse(buf, 14, 0, &r) != 1 || r.type != '-'
        || memcmp(buf + r.data_off, "ERR unknown", 11) != 0)
        return err(3, "错误串不对");
    memcpy(buf, ":1000\r\n", 7);
    if (resp_parse(buf, 7, 0, &r) != 1 || r.type != ':' || r.integer != 1000)
        return err(4, "整数不对");
    memcpy(buf, ":-42\r\n", 6);
    if (resp_parse(buf, 6, 0, &r) != 1 || r.integer != -42)
        return err(5, "负整数不对");
    memcpy(buf, "$5\r\nhello\r\n", 11);
    if (resp_parse(buf, 11, 0, &r) != 1)
        return err(6, "批量串解析失败");
    if (r.type != '$' || r.len != 5 || r.data_off != 4 || r.total != 11)
        return err(7, "批量串字段不对");
    if (memcmp(buf + r.data_off, "hello", 5) != 0)
        return err(8, "批量串内容不对");
    memcpy(buf, "$-1\r\n", 5);
    if (resp_parse(buf, 5, 0, &r) != 1 || r.null != 1 || r.len != -1)
        return err(9, "null 批量串不对");
    memcpy(buf, "*3\r\n", 4);
    if (resp_parse(buf, 4, 0, &r) != 1 || r.type != '*' || r.len != 3
        || r.total != 4)
        return err(10, "数组头不对");
}

test "RESP：编码与坏数据" {
    char out[256] = { 0 };
    Resp r = { 0 };
    static const char *argv[3] = { "SET", "key", "value" };

    if (resp_encode_bulk(S("hello"), out, (int)sizeof out) != 11
        || memcmp(out, "$5\r\nhello\r\n", 11) != 0)
        return err(11, "批量串编码不对");
    if (resp_encode_int(1000, out, (int)sizeof out) != 7
        || memcmp(out, ":1000\r\n", 7) != 0)
        return err(12, "整数编码不对");
    if (resp_encode_int(-42, out, (int)sizeof out) != 6
        || memcmp(out, ":-42\r\n", 6) != 0)
        return err(13, "负整数编码不对");
    if (resp_encode_array_hdr(3, out, (int)sizeof out) != 4
        || memcmp(out, "*3\r\n", 4) != 0)
        return err(14, "数组头编码不对");
    {
        int n = resp_encode_cmd(argv, 3, out, (int)sizeof out);

        if (n != 33)
            return err(15, "命令编码长度不对");
        if (memcmp(out, "*3\r\n$3\r\nSET\r\n$3\r\nkey\r\n$5\r\nvalue\r\n", 33)
            != 0)
            return err(16, "命令编码内容不对");
    }
    if (resp_encode_bulk(S("hello"), out, 5) != -1)
        return err(17, "容量不够应该 -1");
    if (resp_parse((u8 *)"?x\r\n", 4, 0, &r) != -1)
        return err(18, "未知类型应该 -1");
    if (resp_parse((u8 *)"$5\r\nhell\r\n", 10, 0, &r) != -1)
        return err(19, "数据不足应该 -1");
    if (resp_parse((u8 *)":abc\r\n", 6, 0, &r) != -1)
        return err(20, "非数字整数应该 -1");
}
