+/* ------------------------------------------------------------------ */
+/* struct methods: 'ret f(struct T *self, ...)' called as 'p->f(...)'  */
+/*                                                                     */
+/* A method is an ordinary global function whose first parameter is a  */
+/* pointer to a struct (or union).  The receiver is that pointer, so   */
+/* the symbol name and the calling convention stay untouched; only the */
+/* call syntax 'p->f(a)' is rewritten into 'f(p, a)'.                  */
+
+/* the struct/union tag a pointer type points at, or 0 */
+static int superc_ptr_tag(CType *type)
+{
+    CType *pt;
+
+    if ((type->t & VT_BTYPE) != VT_PTR || !type->ref)
+        return 0;
+    pt = pointed_type(type);
+    if ((pt->t & VT_BTYPE) != VT_STRUCT || !pt->ref)
+        return 0;
+    return pt->ref->v & ~SYM_STRUCT;
+}
+
+/* the receiver type name, for diagnostics */
+static const char *superc_tag_name(int tag)
+{
+    static char buf[64];
+
+    if (tag >= SYM_FIRST_ANOM) {
+        snprintf(buf, sizeof buf, "<anonymous>");
+        return buf;
+    }
+    return get_tok_str(tag, NULL);
+}
+
+/* register 'ret NAME(struct T *self, ...)'; NAME is the spelling used in
+   the source, SYM_TOK the (possibly package-mangled) symbol */
+static void superc_method_register(int name, int sym_tok, CType *type)
+{
+    SupercMethod *m, **pm;
+    int tag;
+
+    if (!tcc_state->superc_ext || !type->ref)
+        return;
+    if ((type->t & VT_BTYPE) != VT_FUNC)
+        return;
+    if (type->ref->f.func_type == FUNC_OLD)
+        return;
+    /* the first parameter is the receiver */
+    if (!type->ref->next)
+        return;
+    tag = superc_ptr_tag(&type->ref->next->type);
+    if (!tag)
+        return;
+    for (m = superc_methods; m; m = m->next) {
+        if (m->type_tag == tag && m->name == name) {
+            if (m->sym_tok == sym_tok)
+                return;         /* prototype plus definition */
+            tcc_error("duplicate method '%s' for '%s'",
+                      get_tok_str(name, NULL), superc_tag_name(tag));
+        }
+    }
+    m = tcc_mallocz(sizeof *m);
+    m->type_tag = tag;
+    m->name = name;
+    m->sym_tok = sym_tok;
+    for (pm = &superc_methods; *pm; pm = &(*pm)->next)
+        ;
+    *pm = m;
+    superc_nb_methods++;
+}
+
+/* is there a method NAME taking a pointer to the type TYPE points at? */
+static SupercMethod *superc_method_lookup(CType *type, int name)
+{
+    SupercMethod *m;
+    int tag;
+
+    if (!tcc_state->superc_ext || !superc_nb_methods)
+        return NULL;
+    tag = superc_ptr_tag(type);
+    if (!tag)
+        return NULL;
+    /* an interface value dispatches through its vtable instead */
+    if (superc_iface_of_type(pointed_type(type)))
+        return NULL;
+    for (m = superc_methods; m; m = m->next)
+        if (m->type_tag == tag && m->name == name)
+            return m;
+    return NULL;
+}
+
+/* find_field() without the diagnostic: used to give a real field
+   precedence over a method of the same name */
+static Sym *superc_find_field_quiet(CType *type, int v)
+{
+    Sym *s = type->ref;
+
+    if (!s || (type->t & VT_BTYPE) != VT_STRUCT || s->c < 0)
+        return NULL;
+    while ((s = s->next) != NULL) {
+        if (s->v == v)
+            return s;
+        if ((s->type.t & VT_BTYPE) == VT_STRUCT
+            && s->v >= (SYM_FIRST_ANOM | SYM_FIELD)) {
+            if (superc_find_field_quiet(&s->type, v | SYM_FIELD))
+                return s;
+        }
+    }
+    return NULL;
+}
+
+static int superc_has_field(CType *type, int v)
+{
+    if (!superc_ptr_tag(type))
+        return 0;
+    return superc_find_field_quiet(pointed_type(type), v | SYM_FIELD) != 0;
+}
+
+/* leave the receiver in a temporary slot and push the method symbol, so
+   that the '(' case can treat the call like any other, with the hidden
+   receiver as the first argument */
+static void superc_method_call_prep(SupercMethod *m)
+{
+    Sym *fs = sym_find_raw(m->sym_tok);
+    int r;
+
+    if (!fs)
+        tcc_error("method '%s' is not a function",
+                  get_tok_str(m->name, NULL));
+    superc_self_loc = (loc - PTR_SIZE) & -PTR_SIZE;
+    loc = superc_self_loc;
+    superc_self_type = vtop->type;
+    vset(&superc_self_type, VT_LOCAL | VT_LVAL, superc_self_loc);
+    vswap();
+    vstore();
+    vpop();
+    r = fs->r;
+    if ((r & VT_VALMASK) < VT_CONST)
+        r = (r & ~VT_VALMASK) | VT_LOCAL;
+    vset(&fs->type, r, fs->c);
+    vtop->sym = fs;
+    if (r & VT_SYM)
+        vtop->c.i = 0;
+    superc_self_pending = 1;
+}
+
