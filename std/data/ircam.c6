/* std/data/ircam：IRCAM/Berkeley `SF` 音频文件头（`.sf`/`.ircam`）。
 *
 *     import std.data.ircam;
 *
 *     IrcamInfo m = { 0 };
 *     m.parse(buf, n);               // 方法：parse / encoding_name / bytes_per_sample
 *     // m.rate / m.channels / m.encoding
 *
 * 头部 12 字节（大端）：魔数 `0x0001A364`、采样率（32 位浮点）、声道数、编码。
 * 之后是可选的 `info` 文本块（4 字节长度 + 内容），录音数据从 `data_off` 开始。
 *
 * 编码码（1..8）：1 μ-law、2 线性 8 位、3 线性 16 位、4 线性 24 位、5 线性 32 位、
 * 6 浮点 32 位、7 浮点 64 位、8 A-law。
 *
 * 约定：
 *
 * - `m.parse(src, n)` 校验魔数、编码与采样率，成功返回 1，否则 -1；
 * - `data_off` 在有 `info` 块时是 12 + 4 + 内容长度，否则 12；
 * - `encoding_name()`/`bytes_per_sample()` 与 `std.data.au` 同一套编码号；
 * - 浮点采样率按 IEEE 754 单精度大端解；
 * - 不做解码。
 */
#include <string.h>

module std.data.ircam;
import std.core.types;
import std.text.str;

struct IrcamInfo {
    double rate;
    int channels;
    int encoding;
    int data_off;
    int has_info;
};

static u32 irc_be32(const u8 *p)
{
    return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8)
           | (u32)p[3];
}

static double irc_float32(const u8 *p)
{
    u32 bits = irc_be32(p);
    int sign = (bits >> 31) ? -1 : 1;
    int exp = (int)((bits >> 23) & 0xFF);
    u32 mant = bits & 0x7FFFFF;
    double v = 0;
    int i = 0;

    if (exp == 0)
        return 0;
    if (exp == 255)
        return 0;                       /* inf/NaN：当作 0，parse 会拒绝 */
    v = 1.0 + (double)mant / 8388608.0; /* 2^23 */
    exp -= 127;
    if (exp >= 0) {
        for (i = 0; i < exp; i++)
            v *= 2.0;
    } else {
        for (i = 0; i < -exp; i++)
            v *= 0.5;
    }
    return sign * v;
}

int parse(IrcamInfo *m, const void *src, int n)
{
    const u8 *p = (const u8 *)src;
    int off = 12;

    if (!m || !src || n < 12)
        return -1;
    if (irc_be32(p) != 0x0001A364u)
        return -1;
    memset(m, 0, sizeof *m);
    m->rate = irc_float32(p + 4);
    m->channels = (int)irc_be32(p + 8);
    m->encoding = 0;
    /* 头部第 12 字节起是编码（在 12 字节头之后），实际布局是：
     * magic(4) + rate(4) + channels(4) + encoding(4) = 16 字节 */
    if (n < 16)
        return -1;
    m->encoding = (int)irc_be32(p + 12);
    off = 16;
    if (m->encoding < 1 || m->encoding > 8)
        return -1;
    if (m->rate <= 0 || m->channels <= 0)
        return -1;
    /* 可选 info 块：4 字节长度 + 内容 */
    if (off + 4 <= n) {
        u32 len = irc_be32(p + off);

        if (len > 0 && off + 4 + (int)len <= n) {
            m->has_info = 1;
            off += 4 + (int)len;
        }
    }
    m->data_off = off;
    return 1;
}

const char *encoding_name(IrcamInfo *m)
{
    if (!m)
        return "?";
    switch (m->encoding) {
    case 1: return "ulaw";
    case 2: return "pcm8";
    case 3: return "pcm16";
    case 4: return "pcm24";
    case 5: return "pcm32";
    case 6: return "float32";
    case 7: return "float64";
    case 8: return "alaw";
    default: return "?";
    }
}

int bytes_per_sample(IrcamInfo *m)
{
    if (!m)
        return 0;
    switch (m->encoding) {
    case 1:
    case 2:
    case 8:
        return 1;
    case 3:
        return 2;
    case 4:
        return 3;
    case 5:
    case 6:
        return 4;
    case 7:
        return 8;
    default:
        return 0;
    }
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static void irc_put32(u8 *p, u32 v)
{
    p[0] = (u8)((v >> 24) & 0xFF);
    p[1] = (u8)((v >> 16) & 0xFF);
    p[2] = (u8)((v >> 8) & 0xFF);
    p[3] = (u8)(v & 0xFF);
}

/* 把整数采样率写成 IEEE 754 单精度（只支持 2 的幂乘整数的常见值） */
static u32 irc_float_bits(double v)
{
    int exp = 127;
    double m = v;
    u32 mant = 0;
    int i = 0;

    if (m <= 0)
        return 0;
    while (m >= 2.0) {
        m /= 2.0;
        exp++;
    }
    while (m < 1.0) {
        m *= 2.0;
        exp--;
    }
    m -= 1.0;
    for (i = 0; i < 23; i++) {
        m *= 2.0;
        mant <<= 1;
        if (m >= 1.0) {
            mant |= 1;
            m -= 1.0;
        }
    }
    return ((u32)exp << 23) | mant;
}

static int mk_ircam(u8 *buf)
{
    memset(buf, 0, 64);
    irc_put32(buf, 0x0001A364u);
    irc_put32(buf + 4, irc_float_bits(44100.0));
    irc_put32(buf + 8, 2);
    irc_put32(buf + 12, 3);
    irc_put32(buf + 16, 4);             /* info 长度 4 */
    memcpy(buf + 20, "note", 4);
    return 24;
}

test "ircam：头部与编码" {
    static u8 buf[64] = { 0 };
    IrcamInfo m = { 0 };
    int n = mk_ircam(buf);

    if (m.parse(buf, n) != 1)
        return err(1, "解析失败");
    if (m.rate < 44099.0 || m.rate > 44101.0)
        return err(2, "采样率应该约 44100");
    if (m.channels != 2 || m.encoding != 3)
        return err(3, "声道或编码不对");
    if (m.has_info != 1 || m.data_off != 24)
        return err(4, "info 块或数据偏移不对");
    if (strcmp(m.encoding_name(), "pcm16") != 0 || m.bytes_per_sample() != 2)
        return err(5, "编码名或每样本字节数不对");
    /* 没有 info 块时 data_off 应该是 16 */
    irc_put32(buf + 16, 0);
    if (m.parse(buf, n) != 1 || m.data_off != 16 || m.has_info != 0)
        return err(6, "没有 info 块时数据偏移应该是 16");
    irc_put32(buf, 0x12345678u);
    if (m.parse(buf, n) != -1)
        return err(7, "魔数不对应该 -1");
    mk_ircam(buf);
    irc_put32(buf + 12, 99);
    if (m.parse(buf, n) != -1)
        return err(8, "未知编码应该 -1");
    mk_ircam(buf);
    irc_put32(buf + 8, 0);
    if (m.parse(buf, n) != -1)
        return err(9, "声道 0 应该 -1");
    if (m.parse(buf, 8) != -1)
        return err(10, "太短应该 -1");
}
