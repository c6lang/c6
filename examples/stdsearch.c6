/* examples/stdsearch.c6 —— 第六十五批（字符串算法）的集成示例。
 *
 *     make std-search
 *
 * 四节：KMP 查找、BMH 查找、后缀数组（查找 + LCP）、回文与异位词。
 * 全部用**方法**（`k.find`、`h.count`、`x.search`、`a.same`）。
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.text.str;
import std.text.kmp;
import std.text.bmh;
import std.text.suffix;
import std.text.wordplay;

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int checks = 0;
static int fails = 0;

static void check(int cond, const char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("   ✗ %s\n", what);
    }
}

static void do_kmp(void)
{
    int fail[16] = { 0 };
    Kmp k = { 0 };
    static const char *text = "the quick brown fox jumps over the lazy dog";

    printf("== kmp\n");
    check(k.init(S("the"), fail, 16) == 3, "init 模式 the");
    printf("   \"the\" 首次出现 %d，出现 %d 次\n",
           k.find((char[:]){ (char *)text, (int)strlen(text) }),
           k.count((char[:]){ (char *)text, (int)strlen(text) }));
    check(k.find((char[:]){ (char *)text, (int)strlen(text) }) == 0,
          "the 出现在 0");
    check(k.count((char[:]){ (char *)text, (int)strlen(text) }) == 2,
          "the 出现 2 次");
    k.init(S("o"), fail, 16);
    check(k.count((char[:]){ (char *)text, (int)strlen(text) }) == 4,
          "字母 o 出现 4 次");
    check(k.find(S("zzz")) == -1, "找不到返回 -1");
}

static void do_bmh(void)
{
    Bh h = { 0 };
    static const char *text = "a needle in a haystack with another needle";

    printf("== bmh\n");
    check(h.init(S("needle")) == 6, "init 模式 needle");
    printf("   首次出现 %d，出现 %d 次\n",
           h.find((char[:]){ (char *)text, (int)strlen(text) }),
           h.count((char[:]){ (char *)text, (int)strlen(text) }));
    check(h.find((char[:]){ (char *)text, (int)strlen(text) }) == 2,
          "needle 出现在 2");
    check(h.count((char[:]){ (char *)text, (int)strlen(text) }) == 2,
          "needle 出现 2 次");
    check(h.skip_of('n') == 5 && h.skip_of('z') == 6, "坏字符表");
}

static void do_suffix(void)
{
    int sa[16] = { 0 }, rank[16] = { 0 }, tmp[16] = { 0 }, lcpv[16] = { 0 };
    Suffix x = { 0 };
    static const char *s = "banana";

    printf("== suffix\n");
    check(x.build((char[:]){ (char *)s, 6 }, sa, rank, tmp, 16) == 6,
          "build banana");
    printf("   后缀数组：%d %d %d %d %d %d\n", x.at(0), x.at(1), x.at(2),
           x.at(3), x.at(4), x.at(5));
    check(x.at(0) == 5 && x.at(1) == 3 && x.at(5) == 2, "后缀数组内容");
    check(x.search(S("ana")) == 1, "ana 最早出现在 1");
    check(x.search(S("na")) == 2, "na 最早出现在 2");
    check(x.search(S("zz")) == -1, "找不到返回 -1");
    x.lcp(lcpv);
    printf("   LCP：%d %d %d %d %d %d\n", lcpv[0], lcpv[1], lcpv[2], lcpv[3],
           lcpv[4], lcpv[5]);
    check(lcpv[1] == 1 && lcpv[2] == 3, "相邻后缀的 LCP");
}

static void do_wordplay(void)
{
    Ana a = { { 0 }, 0 };
    Ana b = { { 0 }, 0 };
    char out[64] = { 0 };
    int start = 0;

    printf("== wordplay\n");
    check(is_palindrome(S("A man, a plan, a canal: Panama")) == 1,
          "经典回文句");
    check(is_palindrome(S("hello")) == 0, "hello 不是回文");
    check(longest_palindrome(S("cbbd"), &start) == 2 && start == 1,
          "cbbd 的最长回文是 bb");
    check(reverse_words(S("the quick brown fox"), out, (int)sizeof out) == 19
          && memcmp(out, "fox brown quick the", 19) == 0, "倒序单词");
    a.build(S("listen"));
    b.build(S("silent"));
    printf("   listen 与 silent 异位？%d，最小回文指纹 %d 个\n", a.same(&b),
           count_palindromes(S("abba")));
    check(a.same(&b) == 1, "异位词判定");
    check(count_palindromes(S("abba")) == 6, "abba 的回文子串个数");
    b.canonical(out, (int)sizeof out);
    check(memcmp(out, "e1i1l1n1s1t1", 12) == 0, "异位词指纹");
}

int main(void)
{
    do_kmp();
    do_bmh();
    do_suffix();
    do_wordplay();
    printf("\n%d check(s), %d failure(s)\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
