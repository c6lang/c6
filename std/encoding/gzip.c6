/* std/encoding/gzip：gzip 容器格式（RFC 1952）与 CRC-32。
 *
 *     import std.encoding.gzip;
 *
 *     char packed[256] = { 0 };
 *     int n = gzip_compress(text, tlen, packed, (int)sizeof packed, 0);
 *     char back[1024] = { 0 };
 *     int m = gzip_decompress(packed, n, back, (int)sizeof back);
 *
 * gzip 是「10 字节头 + 可选字段 + DEFLATE 流 + 8 字节尾（CRC-32 + ISIZE）」。
 * 这一层在 `std.encoding.deflate` 外面套壳，并在解压时校验页脚；压缩侧用
 * `deflate_fixed`，头里只写最小的 10 字节（无文件名/注释/额外字段），OS 写 3
 * （Unix），XFL 写 2（最大压缩）。
 *
 * 约定：
 *
 * - `gzip_compress(..., mtime)`：mtime 是 Unix 秒（0 表示「没有时间戳」，
 *   想要可复现的输出就传 0）；头里 magic 是 `1f 8b`、CM=8、FLG=0；
 * - `gzip_decompress` 能跳过 FEXTRA/FNAME/FCOMMENT/FHCRC（按 RFC 解析），
 *   校验 CRC-32 与 ISIZE（原长度模 2^32）；CRC 用 IEEE 多项式
 *   `0x04c11db7`（反射），和 `std.core.crc` 的 `crc32_update` 一致；
 * - 返回字节数，坏数据/校验失败/截断/放不下返回 -1；
 * - 只处理**单成员**（多成员 gzip 只读第一个），零分配。
 */
#include <string.h>

module std.encoding.gzip;
import std.core.types;
import std.core.crc;
import std.encoding.deflate;

#define GZIP_CRC_POLY 0x04c11db7u

/* gzip 的 CRC-32（IEEE，反射）：初值全 1，末尾取反 */
u32 gzip_crc32(const void *p, usize n)
{
    return crc32_update(0xffffffffu, p, n, GZIP_CRC_POLY, 1) ^ 0xffffffffu;
}

int gzip_bound(int n)
{
    if (n < 0)
        return -1;
    return deflate_bound(n) + 18;
}

int gzip_compress(const void *in, int n, void *out, int cap, i64 mtime)
{
    u8 *dst = (u8 *)out;
    u32 crc = 0, isize = 0;
    int got = 0;
    u32 t = (u32)(mtime < 0 ? 0 : mtime);

    if ((!in && n > 0) || n < 0 || !out || cap < 18)
        return -1;
    dst[0] = 0x1f;
    dst[1] = 0x8b;
    dst[2] = 0x08;              /* CM = DEFLATE */
    dst[3] = 0x00;              /* FLG = 0 */
    dst[4] = (u8)t;             /* MTIME（小端） */
    dst[5] = (u8)(t >> 8);
    dst[6] = (u8)(t >> 16);
    dst[7] = (u8)(t >> 24);
    dst[8] = 0x02;              /* XFL = 2（最大压缩） */
    dst[9] = 0x03;              /* OS = Unix */
    got = deflate_fixed(in, n, dst + 10, cap - 18);
    if (got < 0)
        return -1;
    crc = gzip_crc32(in, (usize)n);
    isize = (u32)n;
    dst[10 + got] = (u8)crc;
    dst[11 + got] = (u8)(crc >> 8);
    dst[12 + got] = (u8)(crc >> 16);
    dst[13 + got] = (u8)(crc >> 24);
    dst[14 + got] = (u8)isize;
    dst[15 + got] = (u8)(isize >> 8);
    dst[16 + got] = (u8)(isize >> 16);
    dst[17 + got] = (u8)(isize >> 24);
    return got + 18;
}

/* 小端读 2 字节 */
static int gz_le16(const u8 *p) { return (int)p[0] | ((int)p[1] << 8); }

int gzip_decompress(const void *in, int n, void *out, int cap)
{
    const u8 *src = (const u8 *)in;
    int flg = 0, pos = 10;
    u32 crc = 0, isize = 0, want_crc = 0, want_size = 0;
    int m = 0;

    if (!in || n < 18 || !out || cap < 0)
        return -1;
    if (src[0] != 0x1f || src[1] != 0x8b || src[2] != 0x08)
        return -1;
    flg = src[3];
    if (flg & 0xe0)
        return -1;                      /* 保留位必须为 0 */
    if (flg & 0x04) {                   /* FEXTRA */
        int xlen = 0;

        if (pos + 2 > n)
            return -1;
        xlen = gz_le16(src + pos);
        pos += 2;
        if (pos + xlen > n)
            return -1;
        pos += xlen;
    }
    if (flg & 0x08) {                   /* FNAME */
        while (pos < n && src[pos] != 0)
            pos++;
        if (pos >= n)
            return -1;
        pos++;
    }
    if (flg & 0x10) {                   /* FCOMMENT */
        while (pos < n && src[pos] != 0)
            pos++;
        if (pos >= n)
            return -1;
        pos++;
    }
    if (flg & 0x02) {                   /* FHCRC */
        if (pos + 2 > n)
            return -1;
        pos += 2;
    }
    if (pos + 8 > n)
        return -1;
    m = inflate(src + pos, n - pos - 8, out, cap);
    if (m < 0)
        return -1;
    {
        int fp = n - 8;

        want_crc = (u32)src[fp] | ((u32)src[fp + 1] << 8)
                   | ((u32)src[fp + 2] << 16) | ((u32)src[fp + 3] << 24);
        want_size = (u32)src[fp + 4] | ((u32)src[fp + 5] << 8)
                    | ((u32)src[fp + 6] << 16) | ((u32)src[fp + 7] << 24);
    }
    crc = gzip_crc32(out, (usize)m);
    isize = (u32)m;
    if (crc != want_crc || isize != want_size)
        return -1;
    return m;
}

/* ---- 自测 ---- */

static int unhex(const char *s, u8 *dst, int cap)
{
    int n = 0, i = 0;

    while (s[0] && s[1] && n < cap) {
        int hi = -1, lo = -1;

        for (i = 0; i < 16; i++) {
            if ("0123456789abcdef"[i] == s[0])
                hi = i;
            if ("0123456789abcdef"[i] == s[1])
                lo = i;
        }
        if (hi < 0 || lo < 0)
            return -1;
        dst[n++] = (u8)(hi * 16 + lo);
        s += 2;
    }
    return n;
}

test "CRC-32 的已知值" {
    if (gzip_crc32("", 0) != 0u)
        return err(1, "空输入的 CRC-32 应该是 0");
    if (gzip_crc32("123456789", 9) != 0xcbf43926u)
        return err(2, "123456789 的 CRC-32 不对");
    if (gzip_crc32("hello world", 11) != 0x0d4a1185u)
        return err(3, "hello world 的 CRC-32 不对");
}

test "gzip 往返与外部向量" {
    char text[300] = { 0 };
    u8 packed[1024] = { 0 };
    u8 back[1024] = { 0 };
    u8 vec[128] = { 0 };
    int i = 0, n = 0, m = 0;

    for (i = 0; i < 300; i++)
        text[i] = (char)('0' + i % 10);
    n = gzip_compress(text, 300, packed, (int)sizeof packed, 0);
    if (n <= 0)
        return err(4, "gzip_compress 失败");
    if (packed[0] != 0x1f || packed[1] != 0x8b || packed[2] != 0x08)
        return err(5, "gzip 头不对");
    m = gzip_decompress(packed, n, back, (int)sizeof back);
    if (m != 300 || memcmp(back, text, 300) != 0)
        return err(6, "gzip 往返失败");
    /* Python gzip.compress(text, mtime=0) 的 200 字节向量 */
    n = unhex("1f8b0800000000000203cb48cdc9c957c8402775145252d372124b5215"
              "caf38b72521431550c327500ccdb6858c8000000",
              vec, (int)sizeof vec);
    m = gzip_decompress(vec, n, back, (int)sizeof back);
    if (m != 200
        || memcmp(back, "hello hello hello hello, deflate world! ", 40) != 0)
        return err(7, "外部 gzip 向量解压不对");
    /* mtime 写进头里 */
    n = gzip_compress("x", 1, packed, (int)sizeof packed, 1700000000ll);
    if (packed[4] != (u8)1700000000ll || packed[5] != (u8)(1700000000ll >> 8))
        return err(8, "mtime 没写进头里");
    /* 空输入 */
    n = gzip_compress(0, 0, packed, (int)sizeof packed, 0);
    if (n <= 0 || gzip_decompress(packed, n, back, (int)sizeof back) != 0)
        return err(9, "空输入往返失败");
    /* 页脚/头坏 */
    {
        u8 copy[128] = { 0 };

        n = gzip_compress("abcdef", 6, packed, (int)sizeof packed, 0);
        memcpy(copy, packed, (size_t)n);
        copy[n - 8] ^= 0x01;        /* CRC 坏 */
        if (gzip_decompress(copy, n, back, (int)sizeof back) != -1)
            return err(10, "CRC 不对应该 -1");
        memcpy(copy, packed, (size_t)n);
        copy[n - 4] ^= 0x01;        /* ISIZE 坏 */
        if (gzip_decompress(copy, n, back, (int)sizeof back) != -1)
            return err(11, "ISIZE 不对应该 -1");
        memcpy(copy, packed, (size_t)n);
        copy[0] = 0x1e;             /* magic 坏 */
        if (gzip_decompress(copy, n, back, (int)sizeof back) != -1)
            return err(12, "magic 不对应该 -1");
        memcpy(copy, packed, (size_t)n);
        copy[3] = 0x20;             /* 保留位 */
        if (gzip_decompress(copy, n, back, (int)sizeof back) != -1)
            return err(13, "保留位应该 -1");
    }
    /* 截断与容量 */
    n = gzip_compress(text, 100, packed, (int)sizeof packed, 0);
    if (gzip_decompress(packed, n - 1, back, (int)sizeof back) != -1)
        return err(14, "截断应该 -1");
    if (gzip_decompress(packed, n, back, 4) != -1)
        return err(15, "输出放不下应该 -1");
    if (gzip_compress(text, 100, packed, 8, 0) != -1
        || gzip_compress(0, 4, packed, 64, 0) != -1
        || gzip_decompress(0, 32, back, 8) != -1)
        return err(16, "坏参数应该 -1");
    if (gzip_bound(100) <= 100)
        return err(17, "bound 应该大于输入");
}
