/* std/encoding/mtf：Move-To-Front 变换（bzip2 的第二步，把 BWT 的连续重复变成 0）。
 *
 *     import std.encoding.mtf;
 *
 *     char enc[64] = { 0 };
 *     char back[64] = { 0 };
 *     mtf_encode(S("banana"), enc, (int)sizeof enc);   // 输出索引序列
 *     mtf_decode((char[:]){ enc, 6 }, back, (int)sizeof back);
 *
 * 做法：维护一个 0..255 的符号表（初始按字节值排），每读一个字节就输出它在表里的
 * **位置**，然后把它移到表头。BWT 之后同一个符号常连续出现，于是输出里大量是 0，
 * 后面的熵编码就省力气。
 *
 * 约定：
 *
 * - `mtf_encode`/`mtf_decode` 都返回写出的字节数，容量不足返回 -1；
 * - 输入与输出长度总是相等；
 * - 表是 256 项的定长数组，放在模块静态区（**不可重入**、不能并发）；
 * - 没有「分块重置」：整段共用一个表（要分块请自己切开多次调用）。
 */
#include <string.h>

module std.encoding.mtf;
import std.core.types;
import std.text.str;

static unsigned char mtf_list[256];

static void mtf_reset(void)
{
    int i = 0;

    for (i = 0; i < 256; i++)
        mtf_list[i] = (unsigned char)i;
}

int mtf_encode(char[:] src, char *dst, int cap)
{
    int i = 0;

    if (!src.data || !dst || cap < src.len || src.len < 0)
        return -1;
    mtf_reset();
    for (i = 0; i < src.len; i++) {
        unsigned char c = (unsigned char)src.data[i];
        int pos = 0, k = 0;

        while (pos < 256 && mtf_list[pos] != c)
            pos++;
        if (pos >= 256)
            return -1;                  /* 不可能发生：表里一定有 0..255 */
        dst[i] = (char)pos;
        for (k = pos; k > 0; k--)
            mtf_list[k] = mtf_list[k - 1];
        mtf_list[0] = c;
    }
    return src.len;
}

int mtf_decode(char[:] src, char *dst, int cap)
{
    int i = 0;

    if (!src.data || !dst || cap < src.len || src.len < 0)
        return -1;
    mtf_reset();
    for (i = 0; i < src.len; i++) {
        int pos = (int)(unsigned char)src.data[i];
        unsigned char c = 0;
        int k = 0;

        if (pos >= 256)
            return -1;
        c = mtf_list[pos];
        dst[i] = (char)c;
        for (k = pos; k > 0; k--)
            mtf_list[k] = mtf_list[k - 1];
        mtf_list[0] = c;
    }
    return src.len;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "mtf：编码与解码" {
    char enc[64] = { 0 };
    char back[64] = { 0 };
    int n = 0;

    /* 'a' 在表里的初值是 97，之后连续 'a' 都是 0 */
    n = mtf_encode(S("aaa"), enc, (int)sizeof enc);
    if (n != 3 || enc[0] != 97 || enc[1] != 0 || enc[2] != 0)
        return err(1, "连续相同字符应该先给初值再给 0");
    if (mtf_decode((char[:]){ enc, n }, back, (int)sizeof back) != 3
        || memcmp(back, "aaa", 3) != 0)
        return err(2, "aaa 往返不对");
    /* "banana"：b 在初值 98，a 是 97，n 是 110 */
    n = mtf_encode(S("banana"), enc, (int)sizeof enc);
    if (n != 6)
        return err(3, "banana 长度不对");
    if ((int)(unsigned char)enc[0] != 98)
        return err(4, "第一个字符的索引应该是它的字节值");
    if ((int)(unsigned char)enc[1] != 98)
        return err(5, "第二个字符的索引不对（b 被移到表头后 a 变成 98）");
    /* 第二个 n 变成 1（因为上一个 n 被移到表头，a 在它前面） */
    if ((int)(unsigned char)enc[3] != 1)
        return err(6, "重复出现的 n 索引应该很小");
    if (mtf_decode((char[:]){ enc, n }, back, (int)sizeof back) != 6
        || memcmp(back, "banana", 6) != 0)
        return err(7, "banana 往返不对");
    if (mtf_encode(S(""), enc, (int)sizeof enc) != 0)
        return err(8, "空输入应该 0");
    if (mtf_encode(S("abc"), enc, 2) != -1)
        return err(9, "容量不够应该 -1");
}

test "mtf：全字节与低熵" {
    char enc[512] = { 0 };
    char back[512] = { 0 };
    unsigned char all[256] = { 0 };
    int i = 0;

    for (i = 0; i < 256; i++)
        all[i] = (unsigned char)i;
    if (mtf_encode((char[:]){ (char *)all, 256 }, enc, (int)sizeof enc) != 256)
        return err(10, "256 个字节的编码失败");
    /* 按升序走一遍，每个符号都在表里往后挪，索引先是 0 然后递增 */
    if ((int)(unsigned char)enc[0] != 0)
        return err(11, "第一个字节的索引应该是 0");
    if ((int)(unsigned char)enc[1] != 1)
        return err(12, "第二个字节的索引应该是 1");
    if (mtf_decode((char[:]){ enc, 256 }, back, (int)sizeof back) != 256
        || memcmp(back, all, 256) != 0)
        return err(13, "全字节往返不一致");
    /* 低熵串：两个符号交替时索引只在 0/1 之间跳，绝大多数 <= 1 */
    {
        char small[128] = { 0 };
        int low = 0;

        for (i = 0; i < 128; i++)
            small[i] = (char)('A' + (i % 2));
        mtf_encode((char[:]){ small, 128 }, enc, (int)sizeof enc);
        for (i = 0; i < 128; i++) {
            if ((int)(unsigned char)enc[i] <= 1)
                low++;
        }
        if (low < 126)
            return err(14, "两个符号交替时索引应该都 <= 1");
    }
    if (mtf_decode(S("\x01\x02"), back, (int)sizeof back) != 2)
        return err(15, "任意索引都应该是合法输入");
}
