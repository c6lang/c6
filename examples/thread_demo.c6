/* spawn 用法演示：OS 线程
 *
 * 编译运行（在仓库根目录）：
 *   make build
 *   ./tcc/tcc -B tcc -run examples/thread_demo.c6
 *
 * 'spawn f(a);' 是一句普通语句：参数在这里求值、复制到堆上的参数块，然后
 * pthread_create 起一个线程，语句立刻往下走。线程里跑的是普通函数，所以
 * 阻塞调用（sleep、read、计算）都不会挡住调用方。
 *
 *   async 函数 -> 'co f(a);'   无栈协程，跑到第一个真正要等的地方就返回
 *   普通函数   -> 'spawn f(a);'   真线程，立刻返回，和调用方并行跑
 *
 * 线程由启动它的线程回收：main 结束时编译器会插入 __c6_th_join_all()，
 * 所以在 main 里 spawn 出去的线程都会在程序退出前跑完（下面的 "全部完成"
 * 一行就是靠这一点打印出来的）。
 */
#include <stdio.h>
#include <string.h>
#include <unistd.h>

struct pair {
    int x, y;
};

/* ---- 1. 一个会阻塞的普通函数 ---- */

/* 每个线程有自己的局部变量和 defer 栈，互不影响 */
static int download(int id, int ms)
{
    defer printf("  worker %d 结束（defer）\n", id);
    printf("  worker %d 开始\n", id);
    sleep(ms / 1000 ? ms / 1000 : 1);
    return id;
}

/* ---- 2. 参数按值传：线程拿到的是 spawn 那一刻的副本 ---- */

static int show(int a, const char *msg, struct pair p)
{
    printf("  线程看到 a=%d msg=%s pair=(%d,%d)\n", a, msg, p.x, p.y);
    return 0;
}

/* ---- 3. 线程之间用管道通信 ---- */

static int producer(int wfd, int n)
{
    char buf[32] = {0};
    int i = 0;

    for (i = 0; i < n; i++)
        write(wfd, "ping", 4);
    return 0;
}

static int consumer(int rfd, int want)
{
    char buf[64] = {0};
    int got = 0;

    /* 读满为止：一次 read() 可能把管道里的数据全拿走 */
    while (got < want)
        got += read(rfd, buf + got, want - got);
    printf("  consumer 收到 %d 字节\n", got);
    return 0;
}

/* ---- 4. 要等某一个线程：留住句柄 ---- */

/* 'spawn f(a);' 是起了就不管；'thread h = spawn f(a);' 同时拿到这次调用的记录：
   h->join() 等它结束（重复调用幂等），h->done() 不阻塞，h->value() 取
   被调函数的返回值。线程本身仍旧由启动它的线程回收，句柄只多持有一份。 */

int main(void)
{
    struct pair p = { 3, 4 };
    int fds[2] = { 0, 0 };
    int a = 1;

    printf("main: 起三个线程\n");
    spawn download(1, 1);
    spawn download(2, 1);
    spawn show(a, "hello", p);
    a = 99;                     /* 线程已经拿到副本，看不到这次修改 */

    /* 管道两头各跑一个线程：读的一头阻塞也不影响 main */
    pipe(fds);
    spawn producer(fds[1], 3);
    spawn consumer(fds[0], 12);

    printf("main: spawn 之后立刻继续（上面三行输出可能还没出现）\n");

    /* 只等其中一个：句柄方式的等待 */
    thread h = spawn download(7, 1);
    printf("main: 只等 worker 7\n");
    h->join();
    printf("main: worker 7 的值 = %d\n", (int)h->value());

    sleep(2);
    printf("main: 全部完成\n");
    return 0;
}
