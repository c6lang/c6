static Str hp_s(const char *p, int n)
{
    Str s = { (char[:]){ (char *)p, n } };

    return s;
}

static Str hp_empty(void)
{
    return hp_s((const char *)0, 0);
}

static int hp_eq(Str a, Str b)
{
    if (a.s.len != b.s.len)
        return 0;
    if (a.s.len <= 0)
        return 1;
    return memcmp(a.s.data, b.s.data, (size_t)a.s.len) == 0;
}

static int hp_upper(int c) { return c >= 'A' && c <= 'Z'; }

/* 头名转小写；有变化时写进调用方的临时缓冲 */
static Str hp_lower(Str s, char *tmp, int cap)
{
    int i = 0;
    int need = 0;

    if (s.s.len > cap)
        return hp_empty();
    for (i = 0; i < s.s.len; i++)
        if (hp_upper((u8)s.s.data[i]))
            need = 1;
    if (!need)
        return s;
    for (i = 0; i < s.s.len; i++) {
        int c = (u8)s.s.data[i];
        tmp[i] = (char)(hp_upper(c) ? c + 32 : c);
    }
    return hp_s(tmp, s.s.len);
}

/* 名字/值是不是落在动态表字节区里（这种视图在插入时会被搬走） */
static int hp_in_table(Hpack *h, Str s)
{
    const char *p = s.s.data;

    if (!h || !p || h->cap <= 0)
        return 0;
    return p >= h->buf && p < h->buf + h->cap;
}

int hpack_init(Hpack *h, char *buf, int cap, int max_size, char *arena, int acap)
{
    if (!h)
        return -1;
    memset(h, 0, sizeof *h);
    if (cap < 0 || max_size < 0 || acap < 0)
        return -1;
    if (max_size > cap)
        max_size = cap;
    h->buf = buf;
    h->cap = cap;
    h->max_size = max_size;
    h->arena = arena;
    h->acap = acap;
    h->err = OK;
    h->why = (const char *)"ok";
    return 1;
}

int hpack_err(Hpack *self) { return self ? self->err : INVAL; }

const char *hpack_why(Hpack *self)
{
    return self ? self->why : (const char *)"no handle";
}

int hpack_size(Hpack *self) { return self ? self->size : 0; }

int hpack_count(Hpack *self) { return self ? self->nent : 0; }

int hpack_max(Hpack *self) { return self ? self->max_size : 0; }

/* 表项尺寸（RFC 7541 §4.1） */
int hpack_field_size(Str name, Str value)
{
    if (name.s.len < 0 || value.s.len < 0)
        return 0;
    return name.s.len + value.s.len + 32;
}

/* 静态表项（1..61）；越界返回 0 */
int hpack_static(int idx, Str *name, Str *value)
{
    if (idx < 1 || idx > HPACK_STATIC_N)
        return 0;
    if (name)
        *name = hp_s(HPACK_S_NAME[idx - 1], HPACK_S_NLEN[idx - 1]);
    if (value)
        *value = hp_s(HPACK_S_VALUE[idx - 1], HPACK_S_VLEN[idx - 1]);
    return 1;
}

/* 第 k 个动态表项（k = 0 是最新插进来的） */
static int hp_ent_at(Hpack *h, int k, Str *name, Str *value)
{
    int slot = 0;
    HpackEnt *e = 0;

    if (!h || k < 0 || k >= h->nent)
        return 0;
    slot = (h->head + h->nent - 1 - k) % HPACK_ENT_MAX;
    if (slot < 0)
        slot += HPACK_ENT_MAX;
    e = &h->ent[slot];
    if (name)
        *name = hp_s(h->buf + e->off, e->nl);
    if (value)
        *value = hp_s(h->buf + e->off + e->nl, e->vl);
    return 1;
}

/* 头字段索引（1..61 静态，62 起动态）-> 名字/值；越界返回 0 */
int hpack_index(Hpack *h, int idx, Str *name, Str *value)
{
    if (idx < 1)
        return 0;
    if (idx <= HPACK_STATIC_N)
        return hpack_static(idx, name, value);
    return hp_ent_at(h, idx - HPACK_STATIC_N - 1, name, value);
}

/* 找全匹配（with_value 非 0）或只匹配名字的索引；找不到返回 0 */
static int hp_match(Hpack *h, Str name, Str value, int with_value)
{
    int i = 0;

    for (i = 0; i < HPACK_STATIC_N; i++) {
        if (!hp_eq(hp_s(HPACK_S_NAME[i], HPACK_S_NLEN[i]), name))
            continue;
        if (!with_value
            || hp_eq(hp_s(HPACK_S_VALUE[i], HPACK_S_VLEN[i]), value))
            return i + 1;
    }
    for (i = 0; i < h->nent; i++) {
        Str n = hp_empty();
        Str v = hp_empty();

        if (!hp_ent_at(h, i, &n, &v))
            break;
        if (!hp_eq(n, name))
            continue;
        if (!with_value || hp_eq(v, value))
            return HPACK_STATIC_N + 1 + i;
    }
    return 0;
}

static void hp_drop_oldest(Hpack *h)
{
    if (h->nent <= 0)
        return;
    h->size -= h->ent[h->head].size;
    h->head = (h->head + 1) % HPACK_ENT_MAX;
    h->nent--;
}

/* 把存活条目搬到字节区开头、元数据环归零；代价 O(表大小)，插入时才调 */
static void hp_compact(Hpack *h)
{
    HpackEnt tmp[HPACK_ENT_MAX] = { 0 };
    int base = 0;
    int i = 0;

    if (h->nent <= 0) {
        h->used = 0;
        h->head = 0;
        return;
    }
    base = h->ent[h->head].off;
    if (base > 0) {
        memmove(h->buf, h->buf + base, (size_t)(h->used - base));
        for (i = 0; i < h->nent; i++)
            h->ent[(h->head + i) % HPACK_ENT_MAX].off -= base;
        h->used -= base;
    }
    if (h->head != 0) {
        for (i = 0; i < h->nent; i++)
            tmp[i] = h->ent[(h->head + i) % HPACK_ENT_MAX];
        for (i = 0; i < h->nent; i++)
            h->ent[i] = tmp[i];
        h->head = 0;
    }
}

/* 插一条动态表项（解码侧用）；name 不能指向表字节区（调用方先钉到 arena） */
static int hp_insert(Hpack *h, Str name, Str value)
{
    int need = 0;
    int slot = 0;
    HpackEnt *e = 0;

    if (!h || name.s.len < 0 || value.s.len < 0)
        return -1;
    need = name.s.len + value.s.len + 32;
    if (need > h->max_size) {
        /* RFC 7541 §4.4：比整张表还大的条目会让表清空 */
        h->nent = 0;
        h->head = 0;
        h->used = 0;
        h->size = 0;
        return 1;
    }
    while (h->nent > 0 && h->size + need > h->max_size)
        hp_drop_oldest(h);
    while (h->nent >= HPACK_ENT_MAX)
        hp_drop_oldest(h);
    hp_compact(h);
    if (h->used + need > h->cap) {
        h->err = SPACE;
        h->why = (const char *)"动态表字节区不够";
        return -1;
    }
    if (name.s.len > 0)
        memcpy(h->buf + h->used, name.s.data, (size_t)name.s.len);
    if (value.s.len > 0)
        memcpy(h->buf + h->used + name.s.len, value.s.data,
               (size_t)value.s.len);
    slot = (h->head + h->nent) % HPACK_ENT_MAX;
    e = &h->ent[slot];
    e->off = h->used;
    e->nl = name.s.len;
    e->vl = value.s.len;
    e->size = need;
    h->used += need;
    h->size += need;
    h->nent++;
    return 1;
}

/* 把视图拷进 arena（表里的视图在插入/淘汰后会失效）；容量不够返回 0 */
static int hp_pin(Hpack *h, Str in, Str *out)
{
    if (!h || !out)
        return 0;
    *out = in;
    if (!hp_in_table(h, in) || in.s.len <= 0)
        return 1;
    if (h->aused + in.s.len > h->acap) {
        h->err = SPACE;
        h->why = (const char *)"字符串落地缓冲不够";
        return 0;
    }
    memcpy(h->arena + h->aused, in.s.data, (size_t)in.s.len);
    *out = hp_s(h->arena + h->aused, in.s.len);
    h->aused += in.s.len;
    return 1;
}

/* 整数（RFC 7541 §5.1）：前缀 prefix 位，高位放 flags */
int hpack_int_put(char *dst, int cap, int prefix, int flags, u32 v)
{
    int mask = 0;
    int n = 0;

    if (!dst || prefix < 1 || prefix > 8 || cap < 1)
        return -1;
    mask = (1 << prefix) - 1;
    if (v < (u32)mask) {
        dst[0] = (char)(flags | (int)v);
        return 1;
    }
    dst[0] = (char)(flags | mask);
    v -= (u32)mask;
    n = 1;
    while (v >= 128u) {
        if (n >= cap)
            return -1;
        dst[n++] = (char)((int)(v & 0x7fu) | 0x80);
        v >>= 7;
    }
    if (n >= cap)
        return -1;
    dst[n++] = (char)(int)v;
    return n;
}

/* 读整数：1 完成 / 0 字节还不够 / -1 格式错 */
int hpack_int_get(const void *p, int n, int prefix, u32 *out, int *used)
{
    const u8 *b = (const u8 *)p;
    int mask = 0;
    u32 v = 0;
    int shift = 0;
    int i = 1;
    int byte = 0;

    if (!p || !out || !used || prefix < 1 || prefix > 8 || n < 1)
        return -1;
    mask = (1 << prefix) - 1;
    v = (u32)b[0] & (u32)mask;
    if (v < (u32)mask) {
        *out = v;
        *used = 1;
        return 1;
    }
    for (;;) {
        if (i >= n)
            return 0;
        byte = (int)b[i++];
        if (shift > 28)
            return -1;
        if (shift == 28 && (byte & 0x7f) > 0x0f)
            return -1;
        v += (u32)(byte & 0x7f) << shift;
        shift += 7;
        if (!(byte & 0x80))
            break;
    }
    *out = v;
    *used = i;
    return 1;
}

/* Huffman 编码后的字节数（不写） */
int hpack_huff_len(Str s)
{
    int i = 0;
    int bits = 0;

    for (i = 0; i < s.s.len; i++)
        bits += HPACK_H_LEN[(u8)s.s.data[i]];
    return (bits + 7) / 8;
}

/* Huffman 编码（MSB-first，末尾补 1）；返回字节数或 -1 */
int hpack_huff_encode(Str s, char *dst, int cap)
{
    u64 cur = 0;
    int nbits = 0;
    int di = 0;
    int i = 0;

    if (!dst || cap < 0 || s.s.len < 0)
        return -1;
    for (i = 0; i < s.s.len; i++) {
        int c = (u8)s.s.data[i];
        int L = HPACK_H_LEN[c];

        cur = (cur << L) | (u64)HPACK_H_CODE[c];
        nbits += L;
        while (nbits >= 8) {
            if (di >= cap)
                return -1;
            dst[di++] = (char)(int)((cur >> (nbits - 8)) & 0xffu);
            nbits -= 8;
        }
        if (nbits > 0)
            cur &= ((u64)1 << nbits) - 1u;
        else
            cur = 0;
    }
    if (nbits > 0) {
        int pad = 8 - nbits;

        cur = (cur << pad) | (((u64)1 << pad) - 1u);
        if (di >= cap)
            return -1;
        dst[di++] = (char)(int)(cur & 0xffu);
    }
    return di;
}

/* Huffman 解码：返回字节数或 -1 */
int hpack_huff_decode(const void *src, int n, char *dst, int cap, int *out_n)
{
    const u8 *b = (const u8 *)src;
    u32 code = 0;
    int len = 0;
    int di = 0;
    int i = 0;
    int k = 0;

    if (!src || !dst || !out_n || n < 0 || cap < 0)
        return -1;
    for (i = 0; i < n; i++) {
        for (k = 7; k >= 0; k--) {
            code = (code << 1) | ((u32)(b[i] >> k) & 1u);
            len++;
            if (len > HPACK_HUFF_MAXLEN)
                return -1;
            if ((int)code >= HPACK_H_FIRST[len]) {
                u32 off = code - (u32)HPACK_H_FIRST[len];

                if ((int)off < HPACK_H_CNT[len]) {
                    int sym = (int)HPACK_H_SYM[HPACK_H_OFF[len] + (int)off];

                    if (sym > 255)
                        return -1;      /* EOS 不允许出现在数据里 */
                    if (di >= cap)
                        return -1;
                    dst[di++] = (char)sym;
                    code = 0;
                    len = 0;
                }
            }
        }
    }
    if (len > 7)
        return -1;
    if (len > 0 && code != (((u32)1 << len) - 1u))
        return -1;                      /* 填充必须全 1 */
    *out_n = di;
    return di;
}

/* 字符串（RFC 7541 §5.2）：Huffman 位 + 7 位长度前缀 */
int hpack_str_put(char *dst, int cap, Str s, int use_huff)
{
    int hlen = 0;
    int pn = 0;
    int n = 0;

    if (!dst || cap < 1 || s.s.len < 0 || (s.s.len > 0 && !s.s.data))
        return -1;
    if (use_huff && s.s.len > 0) {
        hlen = hpack_huff_len(s);
        if (hlen < s.s.len) {
            pn = hpack_int_put(dst, cap, 7, 0x80, (u32)hlen);
            if (pn < 0 || pn + hlen > cap)
                return -1;
            n = hpack_huff_encode(s, dst + pn, cap - pn);
            if (n != hlen)
                return -1;
            return pn + n;
        }
    }
    pn = hpack_int_put(dst, cap, 7, 0, (u32)s.s.len);
    if (pn < 0 || pn + s.s.len > cap)
        return -1;
    if (s.s.len > 0)
        memcpy(dst + pn, s.s.data, (size_t)s.s.len);
    return pn + s.s.len;
}

/* 读字符串：1 完成 / 0 字节还不够 / -1 格式错 */
static int hp_str_get(Hpack *h, const u8 *p, int n, Str *out, int *used)
{
    u32 len = 0;
    int pn = 0;
    int rc = 0;
    int huff = 0;
    int dn = 0;

    if (!h || !p || !out || !used || n < 1)
        return -1;
    huff = (p[0] & 0x80u) != 0;
    rc = hpack_int_get(p, n, 7, &len, &pn);
    if (rc <= 0)
        return rc;
    if ((i64)pn + (i64)len > (i64)n)
        return 0;
    if (!huff) {
        *out = hp_s((const char *)p + pn, (int)len);
        *used = pn + (int)len;
        return 1;
    }
    if (h->aused + (int)len > h->acap) {
        h->err = SPACE;
        h->why = (const char *)"字符串落地缓冲不够";
        return -1;
    }
    rc = hpack_huff_decode(p + pn, (int)len, h->arena + h->aused,
                           h->acap - h->aused, &dn);
    if (rc < 0) {
        h->err = HUFF;
        h->why = (const char *)"Huffman 数据非法";
        return -1;
    }
    *out = hp_s(h->arena + h->aused, dn);
    h->aused += dn;
    *used = pn + (int)len;
    return 1;
}

static int hp_sensitive(Str name)
{
    return hp_eq(name, hp_s("authorization", 13))
        || hp_eq(name, hp_s("cookie", 6))
        || hp_eq(name, hp_s("set-cookie", 10))
        || hp_eq(name, hp_s("proxy-authorization", 19));
}

/* 压一个头字段；返回写入字节数或 -1 */
int hpack_put_field(Hpack *h, Str name, Str value, int policy, char *dst, int cap)
{
    char low[HPACK_NAME_MAX] = { 0 };
    Str nm = name;
    int idx = 0;
    int n = 0;
    int pn = 0;

    if (!h || !dst || cap < 1 || policy < HPACK_AUTO || policy > HPACK_NEVER)
        return -1;
    if (name.s.len <= 0 || name.s.len > HPACK_NAME_MAX || value.s.len < 0)
        return -1;
    /* 线上头名必须小写：顺手规范化，省得调用方每处都记得 */
    nm = hp_lower(name, low, (int)sizeof low);
    if (nm.s.len <= 0)
        return -1;
    idx = hp_match(h, nm, value, 1);
    if (idx > 0 && policy == HPACK_AUTO)
        return hpack_int_put(dst, cap, 7, 0x80, (u32)idx);
    idx = hp_match(h, nm, value, 0);
    if (policy == HPACK_NEVER)
        n = hpack_int_put(dst, cap, 4, 0x10, (u32)idx);
    else
        n = hpack_int_put(dst, cap, 4, 0x00, (u32)idx);
    if (n < 0 || n > cap)
        return -1;
    if (idx == 0) {
        pn = hpack_str_put(dst + n, cap - n, nm, 1);
        if (pn < 0)
            return -1;
        n += pn;
    }
    pn = hpack_str_put(dst + n, cap - n, value, 1);
    if (pn < 0)
        return -1;
    return n + pn;
}

/* 压整个头块；返回字节数或 -1 */
int hpack_put_block(Hpack *h, HpackField *fs, int n, char *dst, int cap)
{
    int i = 0;
    int off = 0;

    if (!h || cap < 0 || n < 0 || (n > 0 && !fs) || (cap > 0 && !dst))
        return -1;
    for (i = 0; i < n; i++) {
        int policy = hp_sensitive(fs[i].name) ? HPACK_NEVER : HPACK_AUTO;
        int k = hpack_put_field(h, fs[i].name, fs[i].value, policy,
                                dst + off, cap - off);

        if (k < 0) {
            h->err = SPACE;
            h->why = (const char *)"头块缓冲不够";
            return -1;
        }
        off += k;
    }
    return off;
}

/* 解一个完整头块（CONTINUATION 拼好之后再交进来）；返回 1 / -1 */
int hpack_decode_block(Hpack *h, const void *blk, int n, HpackField *out,
                       int max, int *count)
{
    const u8 *p = (const u8 *)blk;
    int pos = 0;
    int cnt = 0;
    int saw_field = 0;

    if (!h || !blk || n < 0 || max < 0 || (max > 0 && !out))
        return -1;
    h->aused = 0;
    h->err = OK;
    h->why = (const char *)"ok";
    if (count)
        *count = 0;
    while (pos < n) {
        int b = (int)p[pos];

        if (b & 0x80) {
            /* 索引字段 */
            u32 idx = 0;
            int pn = 0;
            int rc = hpack_int_get(p + pos, n - pos, 7, &idx, &pn);
            Str nm = hp_empty();
            Str vl = hp_empty();

            if (rc < 0)
                goto bad_block;
            if (rc == 0) {
                h->err = BLOCK;
                h->why = (const char *)"头块被截断";
                return -1;
            }
            if (idx == 0 || !hpack_index(h, (int)idx, &nm, &vl)) {
                h->err = INDEX;
                h->why = (const char *)"索引越界或 0 号索引";
                return -1;
            }
            if (cnt >= max) {
                h->err = SPACE;
                h->why = (const char *)"头字段数组不够";
                return -1;
            }
            if (!hp_pin(h, nm, &nm) || !hp_pin(h, vl, &vl))
                return -1;
            out[cnt].name = nm;
            out[cnt].value = vl;
            cnt++;
            pos += pn;
            saw_field = 1;
            continue;
        }
        if ((b & 0xe0) == 0x20) {
            /* 动态表上限更新：只能在块开头 */
            u32 v = 0;
            int pn = 0;
            int rc = hpack_int_get(p + pos, n - pos, 5, &v, &pn);

            if (rc < 0)
                goto bad_block;
            if (rc == 0) {
                h->err = BLOCK;
                h->why = (const char *)"头块被截断";
                return -1;
            }
            if (saw_field) {
                h->err = BLOCK;
                h->why = (const char *)"table size update 只能出现在块开头";
                return -1;
            }
            if ((i64)v > (i64)h->cap) {
                h->err = SPACE;
                h->why = (const char *)"对端给的动态表上限超过字节区";
                return -1;
            }
            h->max_size = (int)v;
            while (h->nent > 0 && h->size > h->max_size)
                hp_drop_oldest(h);
            pos += pn;
            continue;
        }
        {
            /* 字面量字段 */
            int inc = (b & 0x40) != 0;
            int pfx = inc ? 6 : 4;
            u32 nidx = 0;
            int pn = 0;
            int rc = hpack_int_get(p + pos, n - pos, pfx, &nidx, &pn);
            Str nm = hp_empty();
            Str vl = hp_empty();

            if (rc < 0)
                goto bad_block;
            if (rc == 0) {
                h->err = BLOCK;
                h->why = (const char *)"头块被截断";
                return -1;
            }
            pos += pn;
            if (nidx == 0) {
                rc = hp_str_get(h, p + pos, n - pos, &nm, &pn);
                if (rc <= 0)
                    goto bad_str;
                pos += pn;
            } else if (!hpack_index(h, (int)nidx, &nm, (Str *)0)) {
                h->err = INDEX;
                h->why = (const char *)"名字索引越界";
                return -1;
            }
            rc = hp_str_get(h, p + pos, n - pos, &vl, &pn);
            if (rc <= 0)
                goto bad_str;
            pos += pn;
            if (cnt >= max) {
                h->err = SPACE;
                h->why = (const char *)"头字段数组不够";
                return -1;
            }
            if (inc) {
                /* 表里的名字在插入时会被搬走：先钉到 arena 再插入 */
                if (!hp_pin(h, nm, &nm) || !hp_pin(h, vl, &vl))
                    return -1;
                if (hp_insert(h, nm, vl) < 0)
                    return -1;
            }
            out[cnt].name = nm;
            out[cnt].value = vl;
            cnt++;
            saw_field = 1;
            continue;
        }
bad_str:
        if (h->err == OK) {
            h->err = BLOCK;
            h->why = (const char *)"字符串被截断";
        }
        return -1;
bad_block:
        h->err = BLOCK;
        h->why = (const char *)"头块格式错";
        return -1;
    }
    if (count)
        *count = cnt;
    return 1;
}

/* 改动态表上限（本端解码侧用）；超容量按容量收窄 */
int hpack_set_max(Hpack *h, int max_size)
{
    if (!h || max_size < 0)
        return -1;
    if (max_size > h->cap)
        max_size = h->cap;
    h->max_size = max_size;
    while (h->nent > 0 && h->size > h->max_size)
        hp_drop_oldest(h);
    return 1;
}

/* ---- 自测 ---- */

static Str hx(const char *z) { return (Str){ (char[:]){ (char *)z, (int)strlen(z) } }; }

static int field_is(HpackField *f, const char *name, const char *value)
{
    Str n = hx(name);
    Str v = hx(value);

    return hp_eq(f->name, n) && hp_eq(f->value, v);
}

static Hpack test_hpack(char *tbuf, int tcap, char *arena, int acap)
{
    Hpack h = { 0 };

    hpack_init(&h, tbuf, tcap, tcap, arena, acap);
    return h;
}

test "整数、字符串与 Huffman 的往返" {
    char tbuf[4096] = { 0 };
    char arena[1024] = { 0 };
    char buf[256] = { 0 };
    Hpack h = test_hpack(tbuf, (int)sizeof tbuf, arena, (int)sizeof arena);
    Str s = { 0 };
    u32 v = 0;
    int n = 0, used = 0, i = 0;
    /* RFC 7541 附录 C 的 Huffman 字节串 */
    u32 vals[4] = { 0, 10, 1337, 1234567 };

    for (i = 0; i < 4; i++) {
        n = hpack_int_put(buf, (int)sizeof buf, 7, 0, vals[i]);
        if (n <= 0 || hpack_int_get(buf, n, 7, &v, &used) != 1
            || used != n || v != vals[i])
            return err(1, "整数往返不一致");
    }
    if (hpack_int_put(buf, 1, 7, 0, 1337) != -1)
        return err(2, "容量不够应该 -1");
    if (hpack_int_get(buf, 0, 7, &v, &used) != -1)
        return err(3, "空输入应该 -1");
    /* 前缀 5 位、0x20 标志 */
    n = hpack_int_put(buf, (int)sizeof buf, 5, 0x20, 4096);
    if (n <= 0 || ((u8)buf[0] & 0xe0) != 0x20)
        return err(4, "前缀与标志字节不对");
    if (hpack_int_get(buf, n, 5, &v, &used) != 1 || v != 4096)
        return err(5, "前缀 5 位往返不一致");

    /* Huffman：RFC 7541 C.4.1 的 www.example.com */
    s = hx("www.example.com");
    n = hpack_huff_encode(s, buf, (int)sizeof buf);
    if (n != 12)
        return err(6, "www.example.com 应该压成 12 字节");
    if ((u8)buf[0] != 0xf1 || (u8)buf[1] != 0xe3 || (u8)buf[11] != 0xff)
        return err(7, "Huffman 字节与 RFC 不一致");
    {
        char dec[64] = { 0 };
        int dn = 0;

        if (hpack_huff_decode(buf, n, dec, (int)sizeof dec, &dn) != 15
            || memcmp(dec, "www.example.com", 15) != 0)
            return err(8, "Huffman 解码不一致");
    }
    /* 更长、含控制字节的混合数据往返 */
    {
        char raw[128] = { 0 };
        char enc[512] = { 0 };
        char dec[128] = { 0 };
        int k = 0, m = 0, dn = 0;

        for (k = 0; k < 128; k++)
            raw[k] = (char)(k * 7 + 3);
        m = hpack_huff_encode((Str){ (char[:]){ raw, 128 } }, enc, (int)sizeof enc);
        if (m <= 0)
            return err(9, "混合数据编码失败");
        dn = hpack_huff_decode(enc, m, dec, (int)sizeof dec, &dn);
        if (dn != 128 || memcmp(dec, raw, 128) != 0)
            return err(10, "混合数据往返不一致");
    }
    /* 结尾填充不是全 1：0xff 的编码是 8 个 1，再加一个全 0 的尾字节应该 -1 */
    {
        char bad[2] = { (char)0xff, 0 };

        if (hpack_huff_decode(bad, 2, buf, (int)sizeof buf, &n) != -1)
            return err(11, "填充非全 1 应该 -1");
    }
    /* 字符串：短串走 Huffman，长度前缀 7 位 */
    s = hx("no-cache");
    n = hpack_str_put(buf, (int)sizeof buf, s, 1);
    if (n != 7 || ((u8)buf[0] & 0x80) == 0)
        return err(12, "no-cache 应该 7 字节且带 Huffman 位");
    if (n <= 0 || hp_str_get(&h, (u8 *)buf, n, &s, &used) != 1
        || !hp_eq(s, hx("no-cache")) || used != n)
        return err(13, "字符串往返不一致");
    /* 明文串（不用 Huffman）*/
    s = hx("x");
    n = hpack_str_put(buf, (int)sizeof buf, s, 0);
    if (n != 2 || (u8)buf[0] != 1 || buf[1] != 'x')
        return err(14, "明文串格式不对");
    if (n <= 0 || hp_str_get(&h, (u8 *)buf, n, &s, &used) != 1 || !hp_eq(s, hx("x")))
        return err(15, "明文串往返不一致");
    /* 半截串 */
    if (hp_str_get(&h, (u8 *)buf, 1, &s, &used) != 0)
        return err(16, "半截串应该 0");
}

test "静态表、动态表与 RFC 7541 的请求样例" {
    char tb0[4096] = { 0 };
    char tb1[4096] = { 0 };
    char ar0[1024] = { 0 };
    char ar1[1024] = { 0 };
    Hpack h0 = test_hpack(tb0, (int)sizeof tb0, ar0, (int)sizeof ar0);
    Hpack h1 = test_hpack(tb1, (int)sizeof tb1, ar1, (int)sizeof ar1);
    HpackField f[16] = { 0 };
    Str n = { 0 };
    Str v = { 0 };
    int cnt = 0;

    /* C.3.1：不带 Huffman 的四个头 */
    {
        u8 blk[32] = { 0x82, 0x86, 0x84, 0x41, 0x0f, 'w', 'w', 'w', '.', 'e',
                       'x', 'a', 'm', 'p', 'l', 'e', '.', 'c', 'o', 'm' };

        if (hpack_decode_block(&h0, blk, 20, f, 16, &cnt) != 1 || cnt != 4)
            return err(17, "C.3.1 解不出来");
        if (!field_is(&f[0], ":method", "GET")
            || !field_is(&f[1], ":scheme", "http")
            || !field_is(&f[2], ":path", "/")
            || !field_is(&f[3], ":authority", "www.example.com"))
            return err(18, "C.3.1 字段不对");
        if (hpack_count(&h0) != 1 || hpack_size(&h0) != 57)
            return err(19, "C.3.1 之后动态表应该是 1 条 / 57 字节");
    }
    /* C.4.1：同样的头，authority 走 Huffman（新连接，空表） */
    {
        u8 blk[32] = { 0x82, 0x86, 0x84, 0x41, 0x8c, 0xf1, 0xe3, 0xc2, 0xe5,
                       0xf2, 0x3a, 0x6b, 0xa0, 0xab, 0x90, 0xf4, 0xff };

        if (hpack_decode_block(&h1, blk, 17, f, 16, &cnt) != 1 || cnt != 4)
            return err(20, "C.4.1 解不出来");
        if (!field_is(&f[3], ":authority", "www.example.com"))
            return err(21, "C.4.1 的 authority 不对");
        if (hpack_count(&h1) != 1 || hpack_size(&h1) != 57)
            return err(22, "C.4.1 之后动态表应该是 1 条 / 57 字节");
    }
    /* C.4.2：第二次请求用上动态表（be = 索引 62） */
    {
        u8 blk[16] = { 0x82, 0x86, 0x84, 0xbe, 0x58, 0x86,
                       0xa8, 0xeb, 0x10, 0x64, 0x9c, 0xbf };

        if (hpack_decode_block(&h1, blk, 12, f, 16, &cnt) != 1 || cnt != 5)
            return err(23, "C.4.2 解不出来");
        if (!field_is(&f[3], ":authority", "www.example.com")
            || !field_is(&f[4], "cache-control", "no-cache"))
            return err(24, "C.4.2 字段不对");
        if (hpack_count(&h1) != 2 || hpack_size(&h1) != 110)
            return err(25, "C.4.2 之后动态表应该是 2 条 / 110 字节");
    }
    /* C.4.3：第三次请求，custom-key/custom-value 把表撑到 3 条 */
    {
        u8 blk[40] = { 0x82, 0x87, 0x85, 0xbf, 0x40, 0x88, 0x25, 0xa8, 0x49,
                       0xe9, 0x5b, 0xa9, 0x7d, 0x7f, 0x89, 0x25, 0xa8, 0x49,
                       0xe9, 0x5b, 0xb8, 0xe8, 0xb4, 0xbf };

        if (hpack_decode_block(&h1, blk, 24, f, 16, &cnt) != 1 || cnt != 5)
            return err(26, "C.4.3 解不出来");
        if (!field_is(&f[4], "custom-key", "custom-value"))
            return err(27, "C.4.3 的 custom-key 不对");
        if (hpack_count(&h1) != 3 || hpack_size(&h1) != 164)
            return err(28, "C.4.3 之后动态表应该是 3 条 / 164 字节");
        /* 表里的条目仍然取得出来：索引 62 是最新的 custom-key */
        if (!hpack_index(&h1, 62, &n, &v) || !hp_eq(n, hx("custom-key")))
            return err(29, "动态表索引 62 不对");
        if (!hpack_index(&h1, 63, &n, &v) || !hp_eq(n, hx("cache-control")))
            return err(30, "动态表索引 63 不对");
        if (hpack_index(&h1, 99, &n, &v))
            return err(31, "越界索引应该 0");
    }
}

test "编码侧：索引、字面量与小写规范化" {
    char tbuf[4096] = { 0 };
    char arena[1024] = { 0 };
    char blk[256] = { 0 };
    Hpack h = test_hpack(tbuf, (int)sizeof tbuf, arena, (int)sizeof arena);
    HpackField f[4] = { 0 };
    Str nm = { 0 };
    Str vl = { 0 };
    int n = 0, k = 0;

    /* 全匹配走索引：:method GET = 0x82 */
    if (hpack_put_field(&h, hx(":method"), hx("GET"), HPACK_AUTO, blk,
                        (int)sizeof blk) != 1 || (u8)blk[0] != 0x82)
        return err(31, ":method GET 应该压成 1 字节 0x82");
    /* 名字大写自动转小写，且 :authority 用静态表名字索引 */
    n = hpack_put_field(&h, hx("Content-Type"), hx("text/plain"), HPACK_AUTO,
                        blk, (int)sizeof blk);
    if (n <= 0)
        return err(32, "content-type 压不出来");
    if (hpack_decode_block(&h, blk, n, f, 4, &k) != 1 || k != 1
        || !field_is(&f[0], "content-type", "text/plain"))
        return err(33, "编码往返不一致");
    /* 敏感头用 never-indexed：低 4 位是名字索引，且没有插表 */
    n = hpack_put_field(&h, hx("authorization"), hx("Bearer x"), HPACK_NEVER,
                        blk, (int)sizeof blk);
    if (n <= 0 || ((u8)blk[0] & 0xf0) != 0x10)
        return err(34, "authorization 应该是 never-indexed");
    /* 整个头块 */
    f[0].name = hx(":method");
    f[0].value = hx("GET");
    f[1].name = hx(":path");
    f[1].value = hx("/");
    f[2].name = hx("authorization");
    f[2].value = hx("Bearer x");
    n = hpack_put_block(&h, f, 3, blk, (int)sizeof blk);
    if (n <= 0)
        return err(35, "头块压不出来");
    if (hpack_decode_block(&h, blk, n, f, 4, &k) != 1 || k != 3)
        return err(36, "头块往返不一致");
    if (!field_is(&f[0], ":method", "GET") || !field_is(&f[1], ":path", "/")
        || !field_is(&f[2], "authorization", "Bearer x"))
        return err(37, "头块字段不对");
    /* 容量不够 */
    if (hpack_put_block(&h, f, 3, blk, 2) != -1)
        return err(38, "容量不够应该 -1");
    /* 空名字 */
    if (hpack_put_field(&h, hx(""), hx("x"), HPACK_AUTO, blk,
                        (int)sizeof blk) != -1)
        return err(39, "空名字应该 -1");
}

test "坏块、尺寸更新与淘汰" {
    char tbuf[128] = { 0 };     /* 故意给小：验证淘汰与上限 */
    char arena[256] = { 0 };
    Hpack h = test_hpack(tbuf, (int)sizeof tbuf, arena, (int)sizeof arena);
    HpackField f[8] = { 0 };
    u8 blk[64] = { 0 };
    int cnt = 0;

    /* 0 号索引 */
    blk[0] = 0x80;
    if (hpack_decode_block(&h, blk, 1, f, 8, &cnt) != -1)
        return err(40, "索引 0 应该 -1");
    /* 截断 */
    blk[0] = 0x82;
    blk[1] = 0x0c;              /* 0x0c 是明文串长度 12，但后面没有字节 */
    if (hpack_decode_block(&h, blk, 2, f, 8, &cnt) != -1)
        return err(41, "截断应该 -1");
    /* table size update 放在字段之后 */
    {
        u8 bad[4] = { 0x82, 0x20, 0x00, 0x00 };

        if (hpack_decode_block(&h, bad, 3, f, 8, &cnt) != -1)
            return err(42, "字段之后的 size update 应该 -1");
    }
    /* 正常的 size update：0x20 = 上限 0，表被清空 */
    {
        u8 ok[3] = { 0x20, 0x82, 0x86 };

        if (hpack_decode_block(&h, ok, 3, f, 8, &cnt) != 1 || cnt != 2)
            return err(43, "size update 之后应该还能解字段");
        if (hpack_max(&h) != 0 || hpack_count(&h) != 0)
            return err(44, "上限 0 之后表该清空");
    }
    /* 把上限调回 128：插 3 条（每条 > 32 字节）必然淘汰老的 */
    {
        int i = 0;

        if (hpack_set_max(&h, 128) != 1)
            return err(45, "set_max 失败");
        for (i = 0; i < 3; i++) {
            /* 用解码路径插表：0x40 是增量索引，名字 x-k，值 1 字节 */
            u8 lit[8] = { 0x40, 0x03, 'x', '-', 'k', 0x01, 0 };

            lit[6] = (u8)('0' + i);
            if (hpack_decode_block(&h, lit, 7, f, 8, &cnt) != 1)
                return err(46, "增量索引字段解不出来");
            if (hpack_count(&h) != i + 1 || hpack_size(&h) != (i + 1) * 36)
                return err(47, "x-k 每条应该是 36 字节");
        }
        /* 表字节区只有 128 字节，再插一条必须淘汰老条目而不是溢出 */
        {
            u8 big[8] = { 0x40, 0x01, 'y', 0x02, 'z', 'z', 0 };

            if (hpack_decode_block(&h, big, 6, f, 8, &cnt) != 1)
                return err(48, "大条目解不出来");
            if (hpack_count(&h) != 3 || hpack_size(&h) != 107)
                return err(49, "淘汰之后表尺寸不对");
        }
    }
    /* 条目比整张表还大：表清空（RFC 7541 §4.4） */
    {
        u8 huge[128] = { 0 };
        int j = 0;

        huge[0] = 0x40;             /* 增量索引，名字索引 0 */
        huge[1] = 0x03;             /* 名字长 3 */
        memcpy(huge + 2, "x-k", 3);
        huge[5] = 100;              /* 值长 100 */
        for (j = 0; j < 100; j++)
            huge[6 + j] = 'a';
        if (hpack_decode_block(&h, huge, 106, f, 8, &cnt) != 1)
            return err(50, "大条目解不出来");
        if (hpack_count(&h) != 0 || hpack_size(&h) != 0)
            return err(51, "比表还大的条目应该清空动态表");
    }
}
