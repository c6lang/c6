/* c6 自测：源文件后缀 '.c6' 自己开启扩展（命令行没有任何开关）
 *
 * 运行（仓库根目录）：
 *   ./tcc/tcc -B tcc -test tests/c6ext/basic.c6
 * tests/run-tests.sh 用同一条命令跑这一组；只要这里能编译并运行，
 * 就说明后缀确实开着扩展。
 */

/* 只有 c6 认 'T!error' 和 err()。 */
static int!error half(int n)
{
    if ((n & 1) != 0)
        err(1, "odd");
    return n / 2;
}

/* catch 处理块必须自己离开（return/goto），所以放在普通函数里。 */
static int half_or_id(int n)
{
    int v = half(n) catch e {
        return -e.id;
    };
    return v;
}

test "后缀开启 defer" {
    int x = 0;
    {
        defer { x = 2; }
        x = 1;
        if (x != 1)
            err(1, "defer ran early");
    }
    if (x != 2)
        err(2, "defer did not run");
}

test "后缀开启切片语法" {
    int a[4] = { 1, 2, 3, 4 };
    int[:] s = a;
    if (s.len != 4)
        err(3, "slice len");
    if (s[2] != 3)
        err(4, "slice index");
}

test "后缀开启 try/catch" {
    if (half_or_id(8) != 4)
        err(5, "half(8)");
    if (half_or_id(9) != -1)
        err(6, "half(9)");
}
