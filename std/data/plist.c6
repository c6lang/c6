/* std/data/plist：Apple 二进制属性列表（`bplist00`）解析（零分配）。
 *
 *     import std.data.plist;
 *
 *     PlistInfo info = { 0 };
 *     PlistObj root = { 0 };
 *     if (plist_open(buf, n, &info) == 1 && plist_root(&info, &root) == 1) {
 *         int cnt = plist_count(buf, n, &info, &root);
 *         PlistObj v = { 0 };
 *         if (plist_get(buf, n, &info, &root, "name", &v) == 1) ...
 *     }
 *
 * 二进制 plist = 8 字节 `bplist00` + 对象表 + 偏移表 + 32 字节尾部（`offset_size`、
 * `ref_size`、对象数、根对象号、偏移表位置）。对象表里的对象要么内联标量，要么
 * 用「引用号」指向别的对象——所以访问器都带 `(buf, n, info)`。
 *
 * 约定：
 *
 * - 只认二进制格式；文本（XML）属性列表请用 `std.data.xml`；
 * - `PlistInfo` 记录 `offset_size`/`ref_size`/`nobj`/`top`/`off_tab`；
 * - `plist_root` 取根对象；`plist_count` 给数组元素数或字典键值对数；
 * - `plist_at` 取数组第 i 个元素，`plist_key` 取字典第 i 个键，`plist_get`
 *   按名字查字典；`plist_at` 对字典给第 i 个值；
 * - 标量访问器：`plist_string` / `plist_int` / `plist_double` / `plist_bool` /
 *   `plist_data` / `plist_date`（秒，相对 2001-01-01 UTC）/ `plist_uid`；
 * - 支持 null / bool / int / real / date / data / ASCII 串 / UTF-16BE 串 /
 *   array / dict / uid；`0x0F` fill 与未知类型返回 -1；UTF-16BE 里的非 ASCII
 *   字符**不转码**（`plist_string` 只给 ASCII 串，UTF-16 串用
 *   `plist_utf16` 拿原始字节）。
 */
#include <string.h>

module std.data.plist;
import std.core.types;
import std.text.str;

enum PlistType {
    PLIST_NULL,
    PLIST_BOOL,
    PLIST_INT,
    PLIST_REAL,
    PLIST_DATE,
    PLIST_DATA,
    PLIST_STRING,
    PLIST_UTF16,
    PLIST_ARRAY,
    PLIST_DICT,
    PLIST_UID,
};

struct PlistInfo {
    int offset_size;
    int ref_size;
    long long nobj;
    long long top;
    long long off_tab;
    int n;                  /* 缓冲区大小，供内部越界检查 */
};

struct PlistObj {
    int type;
    long long ref;          /* 对象号（定位用） */
    Str raw;                /* 标量载荷视图（string/data/utf16/uid） */
    long long i;
    double d;
};

static u64 plist_be(const u8 *p, int n)
{
    u64 v = 0;
    int i = 0;

    for (i = 0; i < n; i++)
        v = (v << 8) | (u64)p[i];
    return v;
}

int plist_open(const void *src, int n, PlistInfo *out)
{
    const u8 *p = (const u8 *)src;
    const u8 *t = 0;

    if (!src || !out || n < 40)
        return -1;
    if (memcmp(p, "bplist0", 7) != 0)
        return -1;
    t = p + n - 32;
    memset(out, 0, sizeof *out);
    out->n = n;
    out->offset_size = t[6];
    out->ref_size = t[7];
    out->nobj = (long long)plist_be(t + 8, 8);
    out->top = (long long)plist_be(t + 16, 8);
    out->off_tab = (long long)plist_be(t + 24, 8);
    if (out->offset_size < 0 || out->offset_size > 8)
        return -1;
    if (out->ref_size < 0 || out->ref_size > 8)
        return -1;
    if (out->nobj <= 0 || out->nobj > 1000000)
        return -1;
    if (out->top < 0 || out->top >= out->nobj)
        return -1;
    if (out->off_tab < 8 || out->off_tab + out->nobj * out->offset_size > n)
        return -1;
    return 1;
}

/* 第 ref 个对象的字节偏移 */
static long long plist_offset(const void *src, const PlistInfo *info,
                              long long ref)
{
    const u8 *p = (const u8 *)src;

    if (ref < 0 || ref >= info->nobj)
        return -1;
    return (long long)plist_be(p + info->off_tab + ref * info->offset_size,
                               info->offset_size);
}

/* 读「长度/计数」：marker 低半字节 0xF 时后面跟一个整数对象 */
static int plist_count_field(const u8 *p, long long n, long long *pos,
                             int nib, long long *count)
{
    int i = 0, sz = 0;

    if (nib != 0xF) {
        *count = nib;
        return 1;
    }
    if (*pos >= n)
        return -1;
    if ((p[*pos] & 0xF0) != 0x10)
        return -1;
    sz = 1 << (p[*pos] & 0xF);
    (*pos)++;
    if (sz > 8 || *pos + sz > n)
        return -1;
    *count = (long long)plist_be(p + *pos, sz);
    *pos += sz;
    (void)i;
    return 1;
}

/* 解一个对象（不跟随数组/字典的元素，只解自身） */
int plist_obj(const void *src, int n, const PlistInfo *info, long long ref,
              PlistObj *out)
{
    const u8 *p = (const u8 *)src;
    long long pos = plist_offset(src, info, ref);
    int marker = 0, hi = 0, nib = 0;
    long long count = 0, need = 0;

    if (pos < 0 || pos >= n || !out)
        return -1;
    memset(out, 0, sizeof *out);
    out->ref = ref;
    marker = p[pos];
    hi = marker & 0xF0;
    nib = marker & 0x0F;
    pos++;
    switch (hi) {
    case 0x00:
        if (marker == 0x00) {
            out->type = PLIST_NULL;
            return 1;
        }
        if (marker == 0x08 || marker == 0x09) {
            out->type = PLIST_BOOL;
            out->i = marker == 0x09;
            return 1;
        }
        return -1;
    case 0x10: {
        int sz = 1 << nib;

        if (sz > 8 || pos + sz > n)
            return -1;
        out->type = PLIST_INT;
        out->i = (long long)plist_be(p + pos, sz);
        return 1;
    }
    case 0x20: {
        int sz = 1 << nib;

        out->type = PLIST_REAL;
        if (sz == 4 && pos + 4 <= n) {
            u32 bits = (u32)plist_be(p + pos, 4);
            float f = 0;

            memcpy(&f, &bits, 4);
            out->d = (double)f;
            return 1;
        }
        if (sz == 8 && pos + 8 <= n) {
            u64 bits = plist_be(p + pos, 8);
            double d = 0;

            memcpy(&d, &bits, 8);
            out->d = d;
            return 1;
        }
        return -1;
    }
    case 0x30: {
        u64 bits = 0;
        double d = 0;

        if (pos + 8 > n)
            return -1;
        bits = plist_be(p + pos, 8);
        memcpy(&d, &bits, 8);
        out->type = PLIST_DATE;
        out->d = d;
        return 1;
    }
    case 0x40:
    case 0x50:
    case 0x60:
    case 0x80: {
        int sz = 0;

        if (plist_count_field(p, n, &pos, nib, &count) != 1)
            return -1;
        if (hi == 0x80) {
            sz = nib + 1;
            if (pos + sz > n)
                return -1;
            out->type = PLIST_UID;
            out->i = (long long)plist_be(p + pos, sz);
            return 1;
        }
        need = hi == 0x60 ? count * 2 : count;
        if (count < 0 || need < 0 || pos + need > n)
            return -1;
        out->type = hi == 0x40 ? PLIST_DATA
                    : hi == 0x50 ? PLIST_STRING
                                 : PLIST_UTF16;
        out->raw.s = (char[:]){ (char *)p + pos, (int)need };
        return 1;
    }
    case 0xA0:
        if (plist_count_field(p, n, &pos, nib, &count) != 1)
            return -1;
        if (count < 0 || pos + count * info->ref_size > n)
            return -1;
        out->type = PLIST_ARRAY;
        out->i = count;
        return 1;
    case 0xD0:
        if (plist_count_field(p, n, &pos, nib, &count) != 1)
            return -1;
        if (count < 0 || pos + count * 2 * info->ref_size > n)
            return -1;
        out->type = PLIST_DICT;
        out->i = count;
        return 1;
    default:
        return -1;
    }
}

int plist_root(const void *src, int n, const PlistInfo *info, PlistObj *out)
{
    if (!info || !out)
        return -1;
    return plist_obj(src, n, info, info->top, out);
}

int plist_count(const PlistObj *o)
{
    if (!o)
        return -1;
    if (o->type != PLIST_ARRAY && o->type != PLIST_DICT)
        return -1;
    return (int)o->i;
}

/* 数组/字典里第 idx 个引用号 */
static long long plist_ref_at(const void *src, int n, const PlistInfo *info,
                             const PlistObj *o, int idx, int want_key)
{
    const u8 *p = (const u8 *)src;
    long long pos = plist_offset(src, info, o->ref);
    long long count = 0, base = 0;
    int marker = 0, nib = 0;

    if (pos < 0 || pos >= n)
        return -1;
    marker = p[pos];
    nib = marker & 0x0F;
    pos++;
    if (plist_count_field(p, n, &pos, nib, &count) != 1)
        return -1;
    if (idx < 0 || idx >= count)
        return -1;
    if (o->type == PLIST_DICT) {
        if (want_key)
            base = pos + idx * info->ref_size;
        else
            base = pos + count * info->ref_size + idx * info->ref_size;
        if (base + info->ref_size > n)
            return -1;
        return (long long)plist_be(p + base, info->ref_size);
    }
    if (o->type != PLIST_ARRAY)
        return -1;
    base = pos + idx * info->ref_size;
    if (base + info->ref_size > n)
        return -1;
    return (long long)plist_be(p + base, info->ref_size);
}

int plist_at(const void *src, int n, const PlistInfo *info, const PlistObj *o,
             int idx, PlistObj *out)
{
    long long ref = plist_ref_at(src, n, info, o, idx, 0);

    if (ref < 0)
        return -1;
    return plist_obj(src, n, info, ref, out);
}

int plist_key(const void *src, int n, const PlistInfo *info, const PlistObj *o,
              int idx, PlistObj *out)
{
    long long ref = plist_ref_at(src, n, info, o, idx, 1);

    if (ref < 0)
        return -1;
    return plist_obj(src, n, info, ref, out);
}

/* 字典按名字查（只比 ASCII/UTF-16 的原字节，不做大小写折叠） */
int plist_get(const void *src, int n, const PlistInfo *info, const PlistObj *o,
              const char *name, PlistObj *out)
{
    PlistObj k = { 0 };
    int count = 0, i = 0, want = name ? (int)strlen(name) : 0;

    if (!name || o->type != PLIST_DICT)
        return -1;
    count = plist_count(o);
    if (count < 0)
        return -1;
    for (i = 0; i < count; i++) {
        if (plist_key(src, n, info, o, i, &k) != 1)
            return -1;
        if (k.type == PLIST_STRING && k.raw.s.len == want
            && memcmp(k.raw.s.data, name, (size_t)want) == 0)
            return plist_at(src, n, info, o, i, out);
    }
    return 0;
}

int plist_string(const PlistObj *o, Str *out)
{
    if (!o || !out || o->type != PLIST_STRING)
        return -1;
    *out = o->raw;
    return 1;
}

int plist_utf16(const PlistObj *o, Str *out)
{
    if (!o || !out || o->type != PLIST_UTF16)
        return -1;
    *out = o->raw;
    return 1;
}

int plist_data(const PlistObj *o, Str *out)
{
    if (!o || !out || o->type != PLIST_DATA)
        return -1;
    *out = o->raw;
    return 1;
}

int plist_int(const PlistObj *o, long long *out)
{
    if (!o || !out || (o->type != PLIST_INT && o->type != PLIST_UID
                       && o->type != PLIST_BOOL))
        return -1;
    *out = o->i;
    return 1;
}

int plist_double(const PlistObj *o, double *out)
{
    if (!o || !out || (o->type != PLIST_REAL && o->type != PLIST_DATE))
        return -1;
    *out = o->d;
    return 1;
}

int plist_bool(const PlistObj *o, int *out)
{
    if (!o || !out || o->type != PLIST_BOOL)
        return -1;
    *out = o->i != 0;
    return 1;
}

/* ---- 自测：plistlib 生成的二进制 plist ---- */

static const unsigned char plist_vec[188] = {
    0x62, 0x70, 0x6c, 0x69, 0x73, 0x74, 0x30, 0x30, 0xd9, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
    0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x11, 0x12, 0x13, 0x16, 0x17, 0x18, 0x53, 0x62, 0x69, 0x67, 0x54,
    0x64, 0x61, 0x74, 0x61, 0x54, 0x6c, 0x69, 0x73, 0x74, 0x54, 0x6e, 0x61, 0x6d, 0x65, 0x53, 0x6e,
    0x65, 0x67, 0x54, 0x6e, 0x65, 0x73, 0x74, 0x53, 0x6e, 0x75, 0x6d, 0x53, 0x75, 0x6e, 0x69, 0x54,
    0x77, 0x68, 0x65, 0x6e, 0x12, 0x00, 0x01, 0x11, 0x70, 0x43, 0x01, 0x02, 0x03, 0xa4, 0x0d, 0x0e,
    0x0f, 0x10, 0x10, 0x01, 0x23, 0x40, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x09, 0x51, 0x78,
    0x52, 0x68, 0x69, 0x13, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xf9, 0xd1, 0x14, 0x15, 0x51,
    0x6b, 0x51, 0x76, 0x10, 0x2a, 0x62, 0x4e, 0x2d, 0x65, 0x87, 0x33, 0x41, 0xc1, 0xde, 0xca, 0x92,
    0x80, 0x00, 0x00, 0x08, 0x1b, 0x1f, 0x24, 0x29, 0x2e, 0x32, 0x37, 0x3b, 0x3f, 0x44, 0x49, 0x4d,
    0x52, 0x54, 0x5d, 0x5e, 0x60, 0x63, 0x6c, 0x6f, 0x71, 0x73, 0x75, 0x7a, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x01, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x19, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x83,
};

test "plist：二进制字典的标量、数组与嵌套" {
    PlistInfo info = { 0 };
    PlistObj root = { 0 }, v = { 0 };
    Str s = { 0 };
    long long iv = 0;
    double dv = 0;
    int b = 0;

    if (plist_open(plist_vec, 188, &info) != 1)
        return err(1, "应该能打开");
    if (info.offset_size != 1 || info.ref_size != 1 || info.nobj != 25
        || info.top != 0)
        return err(2, "尾部字段不对");
    if (plist_root(plist_vec, 188, &info, &root) != 1
        || root.type != PLIST_DICT || plist_count(&root) != 9)
        return err(3, "根应该是有 9 个键的字典");
    /* 字符串 */
    if (plist_get(plist_vec, 188, &info, &root, "name", &v) != 1
        || plist_string(&v, &s) != 1 || s.s.len != 2
        || memcmp(s.s.data, "hi", 2) != 0)
        return err(4, "name 不对");
    /* 整数（0x10 1 字节 与 0x12 4 字节 与 0x13 8 字节负数） */
    if (plist_get(plist_vec, 188, &info, &root, "num", &v) != 1
        || plist_int(&v, &iv) != 1 || iv != 42)
        return err(5, "num 不对");
    if (plist_get(plist_vec, 188, &info, &root, "big", &v) != 1
        || plist_int(&v, &iv) != 1 || iv != 70000)
        return err(6, "big 不对");
    if (plist_get(plist_vec, 188, &info, &root, "neg", &v) != 1
        || plist_int(&v, &iv) != 1 || iv != -7)
        return err(7, "neg 不对");
    /* data */
    if (plist_get(plist_vec, 188, &info, &root, "data", &v) != 1
        || plist_data(&v, &s) != 1 || s.s.len != 3
        || memcmp(s.s.data, "\x01\x02\x03", 3) != 0)
        return err(8, "data 不对");
    /* UTF-16 串「中文」 */
    if (plist_get(plist_vec, 188, &info, &root, "uni", &v) != 1
        || plist_utf16(&v, &s) != 1 || s.s.len != 4
        || (u8)s.s.data[0] != 0x4E || (u8)s.s.data[1] != 0x2D)
        return err(9, "uni 不对");
    /* 日期：2020-01-02T03:04:05Z 相对 2001-01-01 */
    if (plist_get(plist_vec, 188, &info, &root, "when", &v) != 1
        || plist_double(&v, &dv) != 1)
        return err(10, "when 不对");
    if (dv < 599627045.0 || dv > 599627046.0)
        return err(11, "日期秒数不对");
    /* 数组：1 / 2.5 / true / "x" */
    if (plist_get(plist_vec, 188, &info, &root, "list", &v) != 1
        || plist_count(&v) != 4)
        return err(12, "list 不对");
    if (plist_at(plist_vec, 188, &info, &v, 0, &root) != 1
        || plist_int(&root, &iv) != 1 || iv != 1)
        return err(13, "list[0] 不对");
    if (plist_at(plist_vec, 188, &info, &v, 1, &root) != 1
        || plist_double(&root, &dv) != 1 || dv != 2.5)
        return err(14, "list[1] 不对");
    if (plist_at(plist_vec, 188, &info, &v, 2, &root) != 1
        || plist_bool(&root, &b) != 1 || b != 1)
        return err(15, "list[2] 不对");
    if (plist_at(plist_vec, 188, &info, &v, 3, &root) != 1
        || plist_string(&root, &s) != 1 || s.s.data[0] != 'x')
        return err(16, "list[3] 不对");
    if (plist_at(plist_vec, 188, &info, &v, 4, &root) != -1)
        return err(17, "越界应该 -1");
}

test "plist：嵌套字典、键名与坏数据" {
    PlistInfo info = { 0 };
    PlistObj root = { 0 }, v = { 0 }, k = { 0 };
    Str s = { 0 };

    if (plist_open(plist_vec, 188, &info) != 1)
        return err(18, "应该能打开");
    if (plist_root(plist_vec, 188, &info, &root) != 1)
        return err(19, "根取不到");
    if (plist_get(plist_vec, 188, &info, &root, "nest", &v) != 1
        || v.type != PLIST_DICT || plist_count(&v) != 1)
        return err(20, "nest 不对");
    if (plist_get(plist_vec, 188, &info, &v, "k", &root) != 1
        || plist_string(&root, &s) != 1 || s.s.data[0] != 'v')
        return err(21, "nest.k 不对");
    /* 字典的键按序号取 */
    if (plist_key(plist_vec, 188, &info, &v, 0, &k) != 1
        || plist_string(&k, &s) != 1 || s.s.data[0] != 'k')
        return err(22, "第 0 个键不对");
    /* 不存在的键返回 0 */
    if (plist_get(plist_vec, 188, &info, &v, "nope", &root) != 0)
        return err(23, "不存在的键应该 0");
    /* 类型不符的访问器 */
    {
        long long dummy = 0;

        if (plist_get(plist_vec, 188, &info, &v, "k", &root) != 1
            || plist_int(&root, &dummy) != -1)
            return err(24, "类型不符应该 -1");
    }
    /* 坏数据 */
    {
        static unsigned char bad[188] = { 0 };

        memcpy(bad, plist_vec, 188);
        if (plist_open("bplist0", 20, &info) != -1)
            return err(25, "太短应该 -1");
        memcpy(bad, "bplist", 7);
        if (plist_open(bad, 188, &info) != -1)
            return err(26, "魔数不对应该 -1");
        memcpy(bad, plist_vec, 188);
        bad[187] = 0xFF;                /* 偏移表位置越界 */
        if (plist_open(bad, 188, &info) != -1)
            return err(27, "偏移表越界应该 -1");
        memcpy(bad, plist_vec, 188);
        bad[8] = 0xF1;                  /* 根对象类型非法（fill 区） */
        if (plist_open(bad, 188, &info) != 1)
            return err(28, "打开本身应该成功");
        if (plist_root(bad, 188, &info, &root) != -1)
            return err(29, "非法根对象应该 -1");
    }
    if (plist_open(0, 188, &info) != -1)
        return err(30, "空指针应该 -1");
}
