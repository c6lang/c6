/* examples/stdstruct.c6 —— 第四十五批（基础数据结构）的集成示例。
 *
 *     make std-ds
 *
 * 四节：树状数组（前缀和 + 按前缀和定位）、线段树（区间求和与最值）、并查集
 * （合并/同集合/集合大小）、布隆过滤器（加入与查询）。全部用调用方给的缓冲区。
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.text.str;
import std.container.fenwick;
import std.container.segtree;
import std.container.dsu;
import std.container.bloom;

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int checks = 0;
static int fails = 0;

static void check(int cond, const char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("   ✗ %s\n", what);
    }
}

static void do_fenwick(void)
{
    i64 buf[16] = { 0 };
    Fenwick f = { 0 };
    int i = 0;

    printf("== fenwick\n");
    f.init(buf, 8);
    for (i = 0; i < 8; i++)
        f.add(i, (i64)(1 << i));      /* 1,2,4,8,16,32,64,128 */
    printf("   前缀和 [0..3] = %lld，总和 = %lld\n",
           (long long)f.sum(3), (long long)f.all());
    check(f.sum(3) == 15, "前缀和 1+2+4+8");
    check(f.all() == 255, "总和 255");
    check(f.range(4, 6) == 112, "区间 [4..6] = 16+32+64");
    check(f.lower(100) == 6, "前缀和首次 >=100 的位置是 6");
    check(f.lower(256) == 8, "超过总和返回 n");
    f.add(0, -1);
    check(f.sum(0) == 0, "单点减回去");
}

static void do_segtree(void)
{
    i64 sbuf[32] = { 0 };
    i64 mbuf[32] = { 0 };
    SegTree sum = { 0 };
    SegTree mn = { 0 };
    static const i64 vals[8] = { 4, 9, 2, 7, 5, 1, 8, 3 };
    int i = 0;

    printf("== segtree\n");
    if (sum.init(sbuf, 32, 8, SEG_SUM) != 1
        || mn.init(mbuf, 32, 8, SEG_MIN) != 1) {
        check(0, "线段树初始化");
        return;
    }
    for (i = 0; i < 8; i++) {
        sum.set(i, vals[i]);
        mn.set(i, vals[i]);
    }
    printf("   总和 = %lld，最小值 = %lld，[0..3] 和 = %lld\n",
           (long long)sum.all(), (long long)mn.all(),
           (long long)sum.range(0, 3));
    check(sum.all() == 39, "总和 39");
    check(sum.range(0, 3) == 22, "[0..3] = 4+9+2+7");
    check(mn.all() == 1, "最小值 1");
    check(mn.range(1, 3) == 2, "[1..3] 最小值 2");
    sum.set(5, 100);
    mn.set(5, 100);
    check(sum.range(4, 7) == 116, "改点后 [4..7] = 5+100+8+3");
    check(mn.range(0, 5) == 2, "改点后 [0..5] 最小值仍是 2");
    check(sum.range(6, 5) == 0, "空区间求和是 0");
}

static void do_dsu(void)
{
    int parent[8] = { 0 };
    int size[8] = { 0 };
    Dsu d = { 0 };
    int i = 0;

    printf("== dsu\n");
    d.init(parent, size, 8);
    check(d.count() == 8, "初始 8 个集合");
    for (i = 0; i < 7; i++)
        d.merge(i, i + 1);
    printf("   合并后集合数 = %d，0 所在集合大小 = %d\n", d.count(),
           d.set_size(0));
    check(d.same(0, 7) == 1, "0 与 7 同集合");
    check(d.same(0, 4) == 1 && d.same(2, 6) == 1,
          "链上的点都同集合");
    check(d.count() == 1, "全部合并后只剩 1 个集合");
    check(d.set_size(3) == 8, "集合大小 8");
    check(d.merge(0, 7) == -1, "重复合并返回 -1");
    check(d.find(99) == -1, "越界返回 -1");
}

static void do_bloom(void)
{
    static u8 buf[512] = { 0 };
    Bloom b = { 0 };
    int misses = 0, i = 0;

    printf("== bloom\n");
    check(b.init(buf, 2048, 4) == 1, "初始化");
    b.add(S("alpha"));
    b.add(S("beta"));
    b.add(S("gamma"));
    check(b.has(S("alpha")) == 1 && b.has(S("gamma")) == 1,
          "已加入的键查得到");
    check(b.has(S("delta")) == 0, "未加入的键查不到");
    printf("   置位 %d / %d（千分数 %d）\n", b.set_bits(),
           b.capacity(), b.fill_ratio());
    check(b.set_bits() >= 1 && b.set_bits() <= 12, "置位数");
    for (i = 0; i < 50; i++) {
        char key[8] = { 0 };

        key[0] = 'k';
        key[1] = (char)('0' + i % 10);
        key[2] = (char)('a' + i % 26);
        if (b.has((char[:]){ key, 3 }) == 0)
            misses++;
    }
    check(misses >= 40, "未加入的键绝大多数查不到");
    check(b.fill_ratio() < 1000, "填充率小于 1");
}

int main(void)
{
    do_fenwick();
    do_segtree();
    do_dsu();
    do_bloom();
    printf("\n%d check(s), %d failure(s)\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
