                tmp = frame_slots_for(16);
                ta = irfn_vreg(&FN);
                irfn_push(&FN, IR_ADDR, IRT_PTR, ta, 0, 0, 0, X64_SLOT(tmp));
                pv = irfn_vreg(&FN);
                if (se == 1 || se == 2 || se == 4 || se == 8) {
