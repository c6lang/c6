             * 段"的模块限定名逻辑：`cur` 是接收者的成员、没有全局符号，
             * 一跳就把 `.key` 也吃掉了，报"未声明的标识符 'key'"。 */
            if (!s && METHOD_SELF_TY) {
                u32 st4 = 0;
                u32 so4 = 0;

                if (agg_find_promoted(METHOD_SELF_TY, tok_data(t), t->len, &st4, &so4))
                    break_qualified = 0;
            }
            /* 逐段吃，取"能查到符号的最长前缀"：`tu.module.origin.x` 里有
             * 全局变量 `tu__module__origin`，必须停在 `origin`，把 `.x` 留给
             * 成员访问；`tu.module.add` 则一路吃到 `add`。两种拼法都试
             * （点分的 `Tag.member` 那一族、前缀化的 `tu__module__origin`）。 */
            if (!s && break_qualified) {
                char qd[256] = {0};
                char qm[256] = {0};
                u32 dn = t->len;
                u32 mn = t->len;
                u32 best_segs = 0;
                Sym *best_sym = NULL;
                u32 k2 = 0;

                if (dn < sizeof(qd) && mn + 3 < sizeof(qm)) {
                    memcpy(qd, tok_data(t), dn);
                    memcpy(qm, tok_data(t), mn);
                    for (k2 = 0; k2 < 4; k2++) {
                        Tok *d1 = pa_peek((int)(k2 * 2 + 1));
                        Tok *d2 = pa_peek((int)(k2 * 2 + 2));
                        Sym *hit = NULL;

                        if (!(d1 && d1->kind == TK_PUNCT && TOK_EQ(d1, ".")
                              && d2 && d2->kind == TK_IDENT))
                            break;
                        if (dn + d2->len + 2 >= sizeof(qd) || mn + d2->len + 3 >= sizeof(qm))
                            break;
                        qd[dn++] = '.';
                        memcpy(qd + dn, tok_data(d2), d2->len);
                        dn += d2->len;
                        qm[mn++] = '_';
                        qm[mn++] = '_';
                        memcpy(qm + mn, tok_data(d2), d2->len);
                        mn += d2->len;
                        qd[dn] = 0;
                        qm[mn] = 0;
                        hit = sym_find(qd, dn);
                        if (!hit)
                            hit = sym_find(qm, mn);
                        if (hit) {
                            best_sym = hit;
                            best_segs = k2 + 1;
                        }
                    }
                }
                if (best_sym) {
                    for (k2 = 0; k2 < best_segs * 2; k2++)
                        pa_advance();
                    s = best_sym;
                    t = pa_cur();
                }
            }
            while (!s && break_qualified && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
                   && TOK_EQ(pa_peek(1), ".")
                   && pa_peek(2) && pa_peek(2)->kind == TK_IDENT) {
                pa_advance();
                pa_advance();
                t = pa_cur();
            }
            /* 最长前缀那边已经命中了就别再拿裸名盖掉（第 271 轮：
             * `std.data.json.PARSE` 命中 `std__data__json__PARSE` 之后，这一句
             * 会换成裸名 `PARSE`，而裸名是各模块共享的一格，谁先登记谁留下）。 */
            if (!s)
                s = sym_find(tok_data(t), t->len);
        }
        /* 方法体里的裸名字先看接收者的成员：别的模块可能导出同名全局
         * （`std/core/fixed.c6` 的 `int cmp(Fix *self, Fix b)` 就让
         * std/container/pqueue.c6 的 `cmp` 成员在方法体里失效了）。
         * 形参/局部变量在更内层的作用域里，sym_find 会先找到，不受影响。 */
        /* 裸名字：全局、没查到，或者查到的是**外层函数**的局部量/形参
         * （实例化点上看得见它们，方法体里不该看见）——都按接收者的成员走。 */
        if (METHOD_SELF_TY && (!s || s->kind == SC_GLOBAL
                               || ((s->kind == SC_LOCAL || s->kind == SC_PARAM)
                                   && !sym_in_method_scope(s)))) {
            u32 mty4 = 0;
            u32 moff4 = 0;

            if (agg_find_promoted(METHOD_SELF_TY, tok_data(t), t->len, &mty4, &moff4)) {
                Sym *pself = sym_find("self", 4);

                if (getenv("C6C_DBG_SELF"))
                    fprintf(stderr, "[self] %.*s self_ty=%u mty=%u off=%u size=%u\n",
                            (int)t->len, tok_data(t), (unsigned)METHOD_SELF_TY,
                            (unsigned)mty4, (unsigned)moff4, (unsigned)ty_size(mty4));

                if (pself) {
                    u32 sa = irfn_vreg(&FN);
                    u32 sv = irfn_vreg(&FN);
                    u32 ma = irfn_vreg(&FN);
                    u32 rv = 0;
                    int assign_ctx = 0;

                    pa_advance();       /* 吃掉标识符，否则解析器原地打转 */
                    irfn_push(&FN, IR_ADDR, IRT_PTR, sa, 0, 0, 0, X64_SLOT(pself->slot));
                    irfn_push(&FN, IR_LOAD, IRT_PTR, sv, sa, 0, 0, 0);
                    if (moff4) {
                        irfn_push(&FN, IR_LEA, IRT_PTR, ma, sv, 0, 0, moff4);
                    } else {
                        irfn_push(&FN, IR_MOV, IRT_PTR, ma, sv, 0, 0, 0);
                    }
                    GEN_TY = mty4;
                    PEND_LVAL = 1;
                    PEND_ADDR = ma;
                    /* PEND_TY 也要给：赋值路径先把 addr/ty 存进局部再去算右边，
                     * 少了它 store 的宽度/类型就是陈旧的（踩过：方法里写成员
                     * 把 v.x/v.y 写成一堆垃圾）。 */
                    PEND_TY = mty4;
                    PEND_BITS = 0;
                    PEND_BITOFF = 0;
                    PEND_BF_ENUM = 0;
                    /* PEND_MGD 是"上一个表达式"留下的：不清掉的话，前面刚用过
                     * 托管引用的方法体里读个 char 成员也会被当成托管读
                     * （现象：`return data[i]` 变成 ld8 + retain，运行时炸）。 */
                    PEND_MGD = mgd_at_off(METHOD_SELF_TY, moff4) ? 1 : 0;
                    PEND_MGD_SYM = NULL;
                    rv = gen_postfix_ops(ma);
                    /* 紧跟赋值/自增就是左值；否则当场取值（把"地址 + PEND_LVAL"
                     * 原样交回去，这条回落路径上后面没人帮我 load，读出来是 0）。 */
                    if (PEND_LVAL && pa_cur()->kind == TK_PUNCT) {
                        const char *pp = tok_data(pa_cur());
                        u32 L2 = pa_cur()->len;

                        if (L2 == 1 && pp[0] == '=')
                            assign_ctx = 1;
                        else if (L2 == 2
                                 && ((pp[0] == '+' && pp[1] == '+')
                                     || (pp[0] == '-' && pp[1] == '-')
                                     || pp[1] == '='))
                            assign_ctx = 1;
                        else if (L2 == 3 && pp[2] == '=')
                            assign_ctx = 1;
                        else if (L2 == 1 && pp[0] == '[')
                            assign_ctx = 1;   /* `&keys[i]` / `keys[i] = …` */
                    }
                    if (PA_AMP)
                        assign_ctx = 1;
                    if (PEND_LVAL && assign_ctx)
                        return rv;
                    if (PEND_LVAL) {
                        /* 后缀链可能已经把类型走远了：裸 `d` 再接 `->head`
                         * 之后该是 int，不是 `Deque@int *`。按链上留下的类型
                         * 取值/回填，否则 `d->head + i` 会被当成指针加法算步长
                         * （24 = sizeof(Deque@int)），下标永远是 0；元素宽度也
                         * 跟着从 4 变 8（std-tour 的 deque 迭代永远吐第一个元素
                         * 就是这么来的）。 */
                        u32 cty5 = PEND_TY;

                        /* 数组类型的成员不能取值，要**退化**成首元素地址
                         * （`char *p() { return d; }` 里 d 是 char[N]：
                         * load 出来的是 d[0] 那一个字节当指针，调用方拿到
                         * 0x7a 这种数，std-demo 的 Buf 就是这么炸的）。 */
                        if (ty_is_array(cty5)) {
                            PEND_LVAL = 0;
                            GEN_TY = ty_ptr(ty_target(cty5));
                            return rv;
                        }
                        rv = load_lval(rv, cty5);
                        PEND_LVAL = 0;
                        GEN_TY = cty5;
                        return rv;
                    }
                    return rv;
                }
            }
        }
        /* 方法体里直接调同类方法，不带接收者：`probe(&ok[i])` 就是
         * `self->probe(&ok[i])`——第一个形参是接收者，这里补上。 */
        if (METHOD_SELF_TY && (!s || s->kind == SC_GLOBAL)
            && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
            && tok_eq(pa_peek(1), "(")) {
            Sym *fs = meth_find(METHOD_SELF_TY, tok_data(t), t->len);

            if (!fs)
                fs = sym_find(tok_data(t), t->len);
            if (fs && fs->is_func && ty_func_nparams(fs->type) > 0
                && ty_func_param(fs->type, 0) == ty_ptr(METHOD_SELF_TY)) {
                Sym *pself2 = sym_find("self", 4);

                if (pself2) {
                    u32 sa2 = irfn_vreg(&FN);
                    u32 sv2 = irfn_vreg(&FN);
                    u32 avs[16] = {0};
                    u32 narg = 0;
                    u32 k2 = 0;
                    u32 dst2 = 0;

                    irfn_push(&FN, IR_ADDR, IRT_PTR, sa2, 0, 0, 0,
                              X64_SLOT(pself2->slot));
                    irfn_push(&FN, IR_LOAD, IRT_PTR, sv2, sa2, 0, 0, 0);
                    avs[narg++] = sv2;
                    pa_advance();       /* 名字 */
                    if (pa_accept_ch('(')) {
                        if (!pa_accept_ch(')')) {
                            for (;;) {
                                if (narg < 16)
                                    avs[narg++] = value_of(gen_assign());
                                if (!pa_accept_ch(','))
                                    break;
                            }
                            pa_expect_ch(')');
                        }
                    }
                    (void)sret_pass(avs, &narg, fs->type);
                    for (k2 = 0; k2 < narg; k2++)
                        irfn_push(&FN, IR_ARG, IRT_U64, 0, avs[k2], 0, 0, k2);
                    dst2 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CALL, ir_ty_of(ty_target(fs->type)), dst2,
                              0, 0, 0, (u32)fs->val);
                    FN.ops[FN.n - 1].narg = (u8)narg;
                    GEN_TY = ty_target(fs->type);
                    E_WAS_CALL = 1;
                    PEND_LVAL = 0;
                    return gen_postfix_ops(dst2);
                }
            }
        }
        /* 函数模板调用：`f@int(…)` / 模板体内的 `f@T(…)`。
         * 名字**已经声明过**（同文件里还有普通函数同名、或者前面实例化过一次
         * 登记了符号）时也得走这条路——判据是"有同名函数模板"，不是"名字未声明"。 */
        if (pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), "@")) {
            Tmpl *t0 = tmpl_find(tok_data(t), t->len);

            if (t0 && t0->is_func) {
                u32 args[TMPL_NPARAM] = {0};
                u32 na = 0;
                u32 fsym = 0;

                pa_advance();           /* 名字 */
                pa_advance();           /* @ */
                na = tmpl_parse_args(t0, args, pa_is_ch('('));
                fsym = tmpl_func_sig(t0, args, na);
                /* 函数体排进 worklist，等这条顶层声明做完再发射 */
                if (NFW < FW_MAX) {
                    u32 k2 = 0;
                    u32 j2 = 0;
                    int dup = 0;

                    /* 去重要按 (模板, 实参)，同一个模板的不同实例都要发 */
                    for (k2 = 0; k2 < NFW; k2++) {
                        int same = (FW_T[k2] == t0);

                        if (same) {
                            for (j2 = 0; j2 < TMPL_NPARAM; j2++)
                                if (FW_A[k2][j2] != args[j2])
                                    same = 0;
                        }
                        if (same)
                            dup = 1;
                    }
                    if (!dup) {
                        for (k2 = 0; k2 < TMPL_NPARAM; k2++)
                            FW_A[NFW][k2] = args[k2];
                        FW_T[NFW] = t0;
                        NFW++;
                    }
                }
                {
                    char nm[320] = {0};
                    Sym *s2 = NULL;

                    tmpl_mangle_name(t0, args, na, nm, sizeof(nm));
                    s2 = sym_find(nm, (u32)strlen(nm));
                    if (s2 && s2->is_func) {
                        if (pa_is_ch('('))
                            return gen_postfix_ops(gen_call(s2));
                        GEN_TY = ty_ptr(s2->type);
                        return gen_postfix_ops(ident_addr(s2));
                    }
                }
                pa_error("函数模板实例化失败 '%.*s'", (int)t->len, tok_data(t));
                GEN_TY = ty_int();
                return 0;
            }
        }
        if (!s) {
            pa_error("未声明的标识符 '%.*s'", (int)t->len, tok_data(t));
            pa_advance();
            GEN_TY = ty_int();
            return 0;
        }
        if (s->is_func) {
            if (pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")) {
                pa_advance();
                return gen_postfix_ops(gen_call(s));
            }
            /* 函数名出现在值的位置：它的值就是地址（配合函数指针）。
             *
             * typeof 例外（NO_DECAY）：`typeof(f)` 要的是**函数类型本身**，
             * GNU C 里 `sizeof(typeof(f))` 是 1 而不是 8（gcc 对函数类型给
             * 1 字节）。这里以前无条件退化成指针，于是
             *     extern typeof(__WARN_trap) __SCT__WARN_trap;
             * 把 __SCT__WARN_trap 登记成"函数指针变量"，而内核
             * arch/x86/include/asm/bug.h 要的是函数本身——`(&__SCT__…)(args)`
             * 于是成了"对指针取址再调用"，报"这里要 ';'（当前是 '('）"。 */
            pa_advance();
            {
                u32 a2 = ident_addr(s);

                GEN_TY = NO_DECAY ? s->type : ty_ptr(s->type);
                return gen_postfix_ops(a2);
            }
        }
        if (s->kind == SC_ENUMC) {
            u32 d = 0;

            /* 两个枚举都有这个成员名：裸名有歧义，提示写限定名。 */
            if (poison_find(tok_data(t), t->len))
                pa_error("'%.*s' is the member of more than one enum: write "
                         "'<enum>.%.*s'", (int)t->len, tok_data(t),
                         (int)t->len, tok_data(t));
            pa_advance();
            /* 走 gen_int_lit：值可能超出 IR_CONST 的 32 位立即数（负数枚举常量
             * 符号扩展后就是这样），那条路会改用 CONSTK。 */
            d = gen_int_lit((u64)s->val, ty_int());
            GEN_TY = ty_int();
            return gen_postfix_ops(d);
        }
        if (s->kind == SC_LOCAL || s->kind == SC_PARAM || s->kind == SC_GLOBAL) {
            u32 a = 0;
            /* `move(a)` 之后槽是空的：读它（解引用、比较、传参、再 move）
             * 拿到的是空值，编译期就报。赋值目标（`a = …`）不算读。 */
            int is_store = pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(1), "=");

            if (s->is_mgd == 1 && !is_store && !PA_MOVE_OPERAND && !PA_UNEVAL
                && mv_has(s->slot))
                pa_error("'%.*s' was moved: assign a new reference before using it",
                         (int)t->len, tok_data(t));

            pa_advance();
            a = ident_addr(s);
            mark_lval(a, s->type);
            PEND_SYM = s;
            /* 多维 VLA 对象：接下来的 `[i]` 要按行 stride 缩放（见
             * gen_postfix_ops 的下标那段）。一维 VLA 不走这条：它的
             * 元素大小就是 sizeof(元素)，老路是对的。 */
            if (s->vla_nd > 1) {
                PEND_VSYM = s;
                PEND_VDIM = 0;
            }
            if (s->is_mgd) {
                PEND_MGD = s->is_mgd == 2 ? 3 : 1;   /* 1/2 = 托管引用，3 = 弱 */
                E_WEAK = s->is_mgd == 2;
                if (s->is_mgd == 1)
                    PEND_MGD_SYM = s;
            }
            return gen_postfix_ops(a);
        }
        pa_error("'%.*s' 不能出现在表达式里", (int)t->len, tok_data(t));
        pa_advance();
        GEN_TY = ty_int();
        return 0;
    }
    if (pa_is_ch('(') && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), "{")) {
        /* GNU 语句表达式 ({ ... })：值取块里最后一条表达式语句的值 */
        u32 v = 0;
        u32 vt = 0;

        pa_advance();                  /* ( */
        BLOCK_HAS = 0;
        gen_block();
        pa_expect_ch(')');
        v = BLOCK_HAS ? BLOCK_VAL : 0;
        vt = BLOCK_HAS ? BLOCK_TY : ty_int();
        PEND_LVAL = 0;
        GEN_TY = vt;
        return gen_postfix_ops(v);
    }
    if (pa_accept_ch('(')) {
        u32 r = gen_expr();

        pa_expect_ch(')');
        return gen_postfix_ops(r);
    }
    pa_error("这里要一个表达式（当前是 '%.*s'）", (int)t->len, tok_data(t));
    pa_advance();
    GEN_TY = ty_int();
    return 0;
}

/* 类型名（无声明符名字），供 sizeof / 强制转换用 */
static u32 parse_typename(void)
{
    Declarator d = {0};
    u32 base = parse_typespec();

    /* `__seg_gs` / `__seg_fs` 是 x86 的地址空间限定符（gcc 内置关键字，
     * 不是宏——内核只在 sparse 下才把它们定义成 address_space 属性）。
     * 内核 percpu_types.h 拼出 `typeof(var) __seg_gs *` 这种形态，而
     * `typeof(...)` 一旦返回就离开了说明符循环，这之后跟的限定符没有地方
     * 吃。c6c 没有分段模型，看见就当"普通指针"跳过。
     *
     * 放在这里（而不是 parse_typespec 的循环里）是因为它可能出现在
     * 类型名的**任意**位置：`(typeof(g)__seg_gs *)`、`(int __seg_gs *)`、
     * `__seg_gs int` 都得过。 */
    while (pa_cur()->kind == TK_IDENT
           && (TOK_EQ(pa_cur(), "__seg_gs") || TOK_EQ(pa_cur(), "__seg_fs")))
        pa_advance();
    return parse_declarator(base, &d);
}

static void defer_run(int from_scope, int on_error);

/* f-string 洞里是个表达式时：把洞的文本重新词法一遍，压进 token 源栈再
 * 当表达式求值。以前只认 `{标识符}`，`{(int)c}`、`{'A'}`、`{a.b}` 全被当成
 * 空串悄悄跳过。 */
static int fstr_hole_expr(const char *raw, u32 hfile, u32 hs, u32 hlen,
                          u32 *outv, u32 *outty)
{
    SrcFile sf = {0};
    Lex L = {0};
    Tok *toks = NULL;
    char *buf = NULL;
    u32 n = 0;
    u32 k = 0;
    u32 q = 0;
    u32 save_n = 0;
    static u32 sf_line0 = 0;

    if (hlen == 0 || hlen > 200)
        return 0;
    buf = arena_alloc(&A_main, (size_t)hlen + 1);
    /* 洞里的 `\"` 属于外层字符串字面量的转义，重新词法时要把反斜杠去掉
     * （`f"{a ? \"x\" : \"y\"}"`）；其它转义原样留着，嵌套字面量自己会解。 */
    for (q = 0; q < hlen; q++) {
        char hc = raw[hs + q];

        /* 只解**一层**：`\\` → `\`、`\"` → `"`。嵌套字面量自己再解下一层。 */
        if (hc == '\\' && q + 1 < hlen
            && (raw[hs + q + 1] == '\\' || raw[hs + q + 1] == '"'
                || raw[hs + q + 1] == '\'')) {
            buf[k++] = raw[hs + q + 1];
            q++;
            continue;
        }
        buf[k++] = hc;
    }
    buf[k] = 0;
    sf.path = "-";
    sf.data = buf;
    sf.size = k;
    sf.id = hfile;
    sf.lines = &sf_line0;
    sf.nlines = 1;
    lex_init(&L, &sf);
    toks = arena_alloc(&A_main, 64 * sizeof(Tok));
    while (L.pos < k && n < 63) {
        Tok t = {0};
        int kk = lex_next(&L, &t);

        if (kk == TK_EOF || L.pos > k)
            break;
        if (kk == TK_NL)
            continue;
        t.syn = buf + t.off;
        t.flags |= TF_SYN;
        toks[n++] = t;
    }
    if (n == 0)
        return 0;
    /* 已经被预读进窗口的 token 先抄走再压回去，否则洞里那段会把它们冲掉 */
    save_n = (u32)PA_HAVE;
    if (save_n > 0) {
        Tok *sv = arena_alloc(&A_main, (size_t)save_n * sizeof(Tok));
        u32 q2 = 0;

        for (q2 = 0; q2 < save_n; q2++)
            sv[q2] = *pa_peek((int)q2);
        pa_win_clear();
        pa_src_push(sv, save_n);
    }
    pa_src_push(toks, n);
    *outv = value_of(gen_assign());
    *outty = cur_op_ty();
    return 1;
}

/* 合成一个字符串字面量 token 并求它的地址（f-string 里 `_Bool` 要输出
 * "true"/"false"，那两个常量得进数据段）。 */
static u32 fstr_str_addr(const char *lit)
{
    Tok *t = arena_alloc(&A_main, sizeof(Tok));
    u32 save_n = (u32)PA_HAVE;

    memset(t, 0, sizeof(Tok));
    t->kind = TK_STR;
    t->len = (u32)strlen(lit);
    t->flags = TF_SYN;
    t->syn = lit;
    if (save_n > 0) {
        Tok *sv = arena_alloc(&A_main, (size_t)save_n * sizeof(Tok));
        u32 q = 0;

        for (q = 0; q < save_n; q++)
            sv[q] = *pa_peek((int)q);
        pa_win_clear();
        pa_src_push(sv, save_n);
    }
    pa_src_push(t, 1);
    return gen_string();
}

/* `_Bool` 要输出 true / false：按值挑一个常量字符串的地址 */
static u32 fstr_bool_str(u32 hv)
{
    u32 z = irfn_vreg(&FN);
    u32 cc = irfn_vreg(&FN);
    u32 rt = irfn_vreg(&FN);
    u32 l1 = irfn_label(&FN);
    u32 l2 = irfn_label(&FN);
    u32 l3 = irfn_label(&FN);

    irfn_push(&FN, IR_CONST, IRT_U64, z, 0, 0, 0, 0);
    irfn_push(&FN, IR_CMP, IRT_I64, cc, hv, z, 0, 0);
    FN.ops[FN.n - 1].flags = (u8)IRCC_NE;
    irfn_push(&FN, IR_BR, IRT_VOID, 0, cc, l1, l2, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, l1, 0, 0, 0);
    irfn_push(&FN, IR_MOV, IRT_PTR, rt, fstr_str_addr("\"true\""), 0, 0, 0);
    irfn_push(&FN, IR_JMP, IRT_VOID, 0, l3, 0, 0, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, l2, 0, 0, 0);
    irfn_push(&FN, IR_MOV, IRT_PTR, rt, fstr_str_addr("\"false\""), 0, 0, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, l3, 0, 0, 0);
    return rt;
}

/* 按值的类型挑 printf 的转换说明；返回真正要传的那个实参 */
/* 切片/聚合的两个机器字：从地址取一个字段 */
static u32 fstr_load(u32 sadd, u32 ty, u32 off)
{
    u32 a = irfn_vreg(&FN);
    u32 v = irfn_vreg(&FN);

    irfn_push(&FN, IR_LEA, IRT_PTR, a, sadd, 0, 0, off);
    irfn_push(&FN, IR_LOAD, ir_ty_of(ty), v, a, 0, 0, 0);
    return v;
}

static u32 FSTR_SLOT[8];     /* 按嵌套深度复用的 f-string 临时缓冲 */
static int FSTR_DEPTH;

static u32 fstr_skip_space(u32 sadd)
{
    u32 a = irfn_vreg(&FN);
    u32 p = irfn_vreg(&FN);
    u32 i = irfn_vreg(&FN);
    u32 c = irfn_vreg(&FN);
    u32 one = irfn_vreg(&FN);
    u32 cc = irfn_vreg(&FN);
    u32 l1 = irfn_label(&FN);
    u32 l2 = irfn_label(&FN);

    irfn_push(&FN, IR_MOV, IRT_PTR, p, sadd, 0, 0, 0);
    irfn_push(&FN, IR_CONST, IRT_U64, i, 0, 0, 0, 0);
    irfn_push(&FN, IR_CONST, IRT_U64, one, 0, 0, 0, 1);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, l1, 0, 0, 0);
    irfn_push(&FN, IR_LOAD, IRT_U8, c, p, 0, 0, 0);
    irfn_push(&FN, IR_CMP, IRT_I64, cc, c, one, 0, 0);
    FN.ops[FN.n - 1].flags = (u8)IRCC_LT;
    irfn_push(&FN, IR_BR, IRT_VOID, 0, cc, l2, l1, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, l2, 0, 0, 0);
    irfn_push(&FN, IR_MOV, IRT_PTR, a, p, 0, 0, 0);
    return a;
}

/* f-string 洞的格式：`{expr}` / `{expr;spec}`。`spec` 是
 * `#[+- 0]宽度[.精度]转换`，转换可以是 d u x X o b c s f e E g。
 * 返回要传的实参；切片/`%.*s` 会先往 av[] 里追加一个长度。 */
static u32 fstr_fmt_arg(char *fmt, u32 *fl, u32 ty, u32 hv,
                        const char *sp, u32 sl, u32 *av, u32 *na)
{
    char flg[8] = {0};
    u32 nf = 0;
    char wid[8] = {0};
    u32 nw = 0;
    char pre[8] = {0};
    u32 np2 = 0;
    int has_pre = 0;
    char conv = 0;
    u32 i = 0;
    u32 arg = hv;
    int uns = 0;
    int kind = 0;               /* 0=int 1=str 2=float 3=char 4=bin 5=ptr */
    char lm[8] = {0};
    u32 nl = 0;
    char tail = 0;
    int pre_0x = 0;
    int prec_star = 0;

    for (i = 0; i < sl; i++) {
        char c = sp[i];

        if (c == '#' || c == '+' || c == '-' || c == ' ') {
            if (nf < 8)
                flg[nf++] = c;
        } else if (c == '0' && nw == 0) {
            if (nf < 8)
                flg[nf++] = c;
        } else if (c >= '0' && c <= '9') {
            if (nw < 8)
                wid[nw++] = c;
        } else if (c == '.') {
            has_pre = 1;
            i++;
            while (i < sl && sp[i] >= '0' && sp[i] <= '9' && np2 < 8)
                pre[np2++] = sp[i++];
            i--;
        } else {
            conv = c;
            break;
        }
    }
    if (ty == ty_bool()) {
        kind = 1;
    } else if (ty_is_slice(ty)) {
        kind = 1;
    } else if (ty_is_ptr(ty) || ty_is_array(ty)) {
        u32 tg = ty_is_array(ty) ? ty_target(ty) : ty_target(ty);

        if (tg == ty_char() || tg == ty_schar() || tg == ty_uchar())
            kind = 1;
        else
            kind = 5;
    } else if (ty_is_float(ty)) {
        kind = 2;
    } else if (ty == ty_char() || ty == ty_schar() || ty == ty_uchar()) {
        kind = 3;
    } else {
        kind = 0;
        uns = !ty_is_signed(ty);
    }
    /* 格式说明先自己查一遍：未知转换、类型对不上、宽度/精度越界，都在
     * 编译期报出来，别拖到 printf 里变成乱码。`kind` 到这里还是"值本身的
     * 自然类别"，下面才被 conv 改掉。 */
    {
        int nat = kind;
        int is_text = (kind == 1 && ty != ty_bool());
        int intconv = 0;
        int fltconv = 0;
        u32 wv = 0;
        u32 pv = 0;
        u32 z = 0;

        for (z = 0; z < nw; z++)
            wv = wv * 10 + (u32)(wid[z] - '0');
        for (z = 0; z < np2; z++)
            pv = pv * 10 + (u32)(pre[z] - '0');
        if (wv > 1024)
            pa_error("f-string: 格式宽度 %u 太大", wv);
        if (pv > 1024)
            pa_error("f-string: 格式精度 %u 太大", pv);
        if (conv) {
            intconv = (conv == 'd' || conv == 'i' || conv == 'u' || conv == 'x'
                       || conv == 'X' || conv == 'o' || conv == 'b'
                       || conv == 'c');
            fltconv = (conv == 'f' || conv == 'F' || conv == 'e'
                       || conv == 'E' || conv == 'g' || conv == 'G');
            if (!intconv && !fltconv && conv != 's')
                pa_error("f-string: 未知的格式转换 '%c'", conv);
            else if (nat == 2 && !fltconv)
                pa_error("f-string: 浮点值不能用 '%c' 格式", conv);
            else if (nat == 0 && fltconv)
                pa_error("f-string: 整数值不能用 '%c' 格式", conv);
            else if (is_text && intconv)
                pa_error("f-string: 文本不能用 '%c' 格式", conv);
        }
    }
    if (conv) {
        if (conv == 'd' || conv == 'i') {
            kind = 0;
            uns = 0;
        } else if (conv == 'u') {
            kind = 0;
            uns = 1;
        } else if (conv == 'x' || conv == 'X' || conv == 'o') {
            kind = 0;
            uns = 1;
        } else if (conv == 'b') {
            kind = 4;
            uns = 1;
        } else if (conv == 'c') {
            kind = 3;
        } else if (conv == 's') {
            kind = 1;
        } else if (conv == 'f' || conv == 'F' || conv == 'e' || conv == 'E'
                   || conv == 'g' || conv == 'G') {
            kind = 2;
        }
    }
    if (kind == 4) {
        /* 二进制：printf 没有这个转换，交给运行时写进一个临时缓冲 */
        u32 buf = frame_slots_for(80);
        u32 ba = irfn_vreg(&FN);
        u32 alt = irfn_vreg(&FN);
        u32 r = irfn_vreg(&FN);

        irfn_push(&FN, IR_ADDR, IRT_PTR, ba, 0, 0, 0, X64_SLOT(buf));
        irfn_push(&FN, IR_CONST, IRT_U64, alt, 0, 0, 0, 0);
        for (i = 0; i < nf; i++)
            if (flg[i] == '#')
                FN.ops[FN.n - 1].imm = 1;
        irfn_push(&FN, IR_ARG, IRT_U64, 0, ba, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, arg, 0, 0, 1);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, alt, 0, 0, 2);
        irfn_push(&FN, IR_CALL, IRT_PTR, r, 0, 0, 0,
                  x64_sym(&X64, "__c6_fmt_bin"));
        FN.ops[FN.n - 1].narg = 3;
        kind = 1;
        arg = r;
        /* `#` 由运行时负责，printf 这边不许再看到 */
        {
            u32 q = 0;
            u32 k2 = 0;

            for (q = 0; q < nf; q++)
                if (flg[q] != '#')
                    flg[k2++] = flg[q];
            nf = k2;
        }
    }
    if (kind == 2 && ty_size(ty) > 0 && ty_size(ty) < 8)
        arg = gen_convert(arg, ty, ty_double());   /* float → double 的提升 */
    if (kind == 1 && ty == ty_bool())
        arg = fstr_bool_str(hv);
    if (kind == 0) {
        if (!uns && ty_size(ty) > 0 && ty_size(ty) < 8 && ty_is_signed(ty)) {
            u32 d = irfn_vreg(&FN);

            irfn_push(&FN, IR_SEXT, IRT_I64, d, arg, 0, 0, 0);
            arg = d;
        }
        lm[nl++] = 'l';
        lm[nl++] = 'l';
        if (!conv)
            tail = uns ? 'u' : 'd';
        else if (conv == 'o')
            tail = 'o';
        else if (conv == 'X')
            tail = 'X';
        else if (conv == 'x')
            tail = 'x';
        else if (conv == 'u')
            tail = 'u';
        else
            tail = 'd';
    } else if (kind == 1) {
        tail = 's';
        if (ty_is_slice(ty)) {
            u32 ptr = fstr_load(hv, ty_ptr(ty_char()), 0);
            u32 len = fstr_load(hv, ty_long(), 8);

            if (has_pre) {
                arg = ptr;
            } else {
                arg = ptr;
                prec_star = 1;
            }
            if (prec_star && *na < 8)
                av[(*na)++] = len;
        }
    } else if (kind == 2) {
        tail = conv ? conv : 'g';
    } else if (kind == 3) {
        tail = 'c';
    } else if (kind == 5) {
        if (!conv) {
            pre_0x = 1;
            lm[nl++] = 'l';
            tail = 'x';
        } else if (conv == 's') {
            tail = 's';
        } else if (conv == 'c') {
            tail = 'c';
        } else {
            lm[nl++] = 'l';
            lm[nl++] = 'l';
            tail = (conv == 'X') ? 'X' : (conv == 'o') ? 'o'
                   : (conv == 'u') ? 'u' : (conv == 'd') ? 'd' : 'x';
        }
    }
    if (pre_0x) {
        fmt[(*fl)++] = '0';
        fmt[(*fl)++] = 'x';
    }
    fmt[(*fl)++] = '%';
    for (i = 0; i < nf; i++)
        fmt[(*fl)++] = flg[i];
    for (i = 0; i < nw; i++)
        fmt[(*fl)++] = wid[i];
    if (prec_star) {
        fmt[(*fl)++] = '.';
        fmt[(*fl)++] = '*';
    } else if (has_pre) {
        fmt[(*fl)++] = '.';
        for (i = 0; i < np2; i++)
            fmt[(*fl)++] = pre[i];
    }
    for (i = 0; i < nl; i++)
        fmt[(*fl)++] = lm[i];
    fmt[(*fl)++] = tail;
    return arg;
}

static u32 gen_bin2(u32 a, u32 aty, u8 op, u32 b, u32 bty);

/* `sizeof` 的操作数是不是一个 VLA 对象：`名字` 或 `(名字)`。
 * 返回 1 = 带括号、2 = 不带括号（调用方据此吃 token），0 = 不是。
 * 长度和元素大小从符号上取（声明时算好的）。 */
/* `return <聚合>` 的两步：先把对象拷进调用者给的槽（**要在跑 cleanup 之前**，
 * C 的语义是"先把返回值定下来再清场"），再发那条 IR_RET。 */
static u32 ret_agg_copy(u32 v)
{
    u32 ty = CUR_RET_TY;


    if (CUR_SRET_ON && ty_is_agg(ty) && ty_size(ty)) {
        irfn_push(&FN, IR_COPY, IRT_U8, CUR_SRET, v, 0, 0, ty_size(ty));
        return CUR_SRET;
    }
    return v;
}

static void ret_emit(u32 v)
{
    u32 ty = CUR_RET_TY;

    if (CUR_SRET_ON && ty_is_agg(ty) && ty_size(ty))
        irfn_push(&FN, IR_RET, IRT_PTR, 0, v, 0, 0, 0);
    else
        irfn_push(&FN, IR_RET, ir_ty_of(ty), 0, v, 0, 0, 0);
}

/* `sizeof` 的操作数 VLA 对象：返回 1 = 带括号、2 = 不带括号、0 = 不是。
 * `esz_out` 对一维 VLA 是**编译期**的元素大小，对多维 VLA 是运行期的行
 * stride（一个 vreg）——`esz_run` 说明是哪种，调用方别再把 vreg 号当立即数。 */
static int pa_vla_sizeof(u32 *cnt_out, u32 *esz_out, int *esz_run)
{
    Tok *t = pa_cur();
    Sym *sy = NULL;
    int paren = 0;

    if (t->kind == TK_PUNCT && TOK_EQ(t, "(")) {
        Tok *n1 = pa_peek(1);
        Tok *n2 = pa_peek(2);

        if (!(n1 && n1->kind == TK_IDENT && n2 && n2->kind == TK_PUNCT
              && TOK_EQ(n2, ")")))
            return 0;
        t = n1;
        paren = 1;
    } else if (t->kind != TK_IDENT) {
        return 0;
    }
    sy = sym_find(tok_data(t), t->len);
    if (!sy || !sy->vla_cnt)
        return 0;
    *cnt_out = sy->vla_cnt;
    *esz_out = sy->vla_esz ? sy->vla_esz : 1;
    *esz_run = sy->vla_nd > 1 ? 1 : 0;
    /* 1 = 源码写成 `sizeof(v)`；2 = 写成 `sizeof v`（不带括号） */
    return paren ? 1 : 2;
}


static u32 gen_unary(void)
{
    /* GNU 的 `__real__ z` / `__imag__ z`：取复数的实部/虚部。C99 里没有直接
     * 取分量的语法（那是 <complex.h> 的 creal/cimag，属于库），但这两个是
     * gcc 扩展，几乎所有复数代码都在用，实现起来就是一次分量 load。 */
    if (PA_IS_IDENT("__real__") || PA_IS_IDENT("__imag__")) {
        int imag = PA_IS_IDENT("__imag__");
        u32 cv = 0;
        u32 cty = 0;
        u32 ct = 0;

        pa_advance();
        cv = value_of(gen_unary());
        cty = GEN_TY;
        if (!ty_is_cplx(cty)) {
            /* 操作数不是复数：`__real__ 3.0` 就是 3.0，`__imag__ 3.0` 是 0 */
            if (!imag) {
                GEN_TY = cty;
                return cv;
            }
            GEN_TY = cty;
            return cplx_zero(cty);
        }
        ct = cplx_comp(cty);
        GEN_TY = ct;
        /* 分量本身是个左值（`__imag__ z = 4.0;` 要能赋值）：给地址而不是值，
         * 读的时候由 value_of 走一次 load。 */
        {
            u32 caddr = gen_addr_off(cv, imag ? ty_size(ct) : 0);

            mark_lval(caddr, ct);
            return caddr;
        }
    }
    /* 表达式位置上的 c6 角色宏：`imax(a + 1, b * 2)`。展开成 `( 体 )` 之后
     * 直接重进 gen_unary 解析它。 */
    if (NCM > 0 && CM_EXPR_DEPTH < 64 && cm_at_call(CM_ROLE_EXPR)) {
        CM_EXPR_DEPTH++;
        (void)cm_expand(CM_ROLE_EXPR);
        {
            u32 r = gen_unary();

            CM_EXPR_DEPTH--;
            return r;
        }
    }
    /* c6 的 f-string：`f"text {x} text"` / `@f"…"`（托管版本）。c6c 的 `@char`
     * 就是 `char *`，所以两者一样：把字面量拼成 printf 格式串、把 `{名字}`
     * 换成实参，调一次 snprintf 进栈上缓冲。**只支持 `{标识符}` 形式的洞**
     * （表达式要能重入词法器，那是另一件事），够 tests/ 里的用法了。 */
    if ((PA_IS_IDENT("f") && pa_peek(1) && pa_peek(1)->kind == TK_STR)
        || (pa_is_ch('@') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
            && TOK_EQ(pa_peek(1), "f") && pa_peek(2) && pa_peek(2)->kind == TK_STR)) {
        char fmt[512] = {0};
        u32 fl = 0;
        u32 av[8] = {0};
        u32 na = 0;
        Tok *stk = NULL;
        const char *raw = NULL;
        u32 rl = 0;
        u32 i2 = 0;
        u32 slot = 0;
        u32 aptr = 0;
        u32 cfmt = 0;
        u32 ccap = 0;
        u32 dst = 0;
        u32 foff = 0;
        u32 stk_off = 0;
        u32 stk_file = 0;
        u32 fdt = 0;
        int fdm = 0;

        fdt = FSTR_DEPTH;
        if (FSTR_DEPTH < 8)
            FSTR_DEPTH++;
        {
            /* `@char p = f"…"`（借来的文本给自己发引用）和
             * `const char *p = @f"…"`（把新引用交给普通指针）都得报。 */
            u8 dm = PA_DECL_INIT_MGD;

            if (dm == 2 && !(pa_is_ch('@') ? 1 : 0))
                pa_error("f-string: 普通文本是借来的，不能存进托管引用（写 @f\"…\"）");
            else if (dm == 1 && pa_is_ch('@'))
                pa_error("f-string: 新建的引用不能存进普通指针（目标要写成 @char）");
        }
        if (pa_is_ch('@')) {
            pa_advance();
            fdm = 1;             /* `@f".."` 是托管文本，不能跟普通的共用缓冲 */
        }
        pa_advance();                    /* f */
        stk = pa_cur();
        raw = tok_data(stk);
        rl = stk->len;
        stk_off = stk->off;
        stk_file = stk->file;
        pa_advance();
        /* 去掉首尾引号 */
        if (rl >= 2) {
            raw++;
            rl -= 2;
        }
        while (i2 < rl && fl < sizeof(fmt) - 8) {
            if (raw[i2] == '{') {
                u32 hs = 0;
                u32 hlen = 0;
                u32 depth = 0;
                const char *spec = NULL;
                u32 sl = 0;

                if (i2 + 1 < rl && raw[i2 + 1] == '{') {
                    fmt[fl++] = '{';     /* `{{` 不是洞 */
                    i2 += 2;
                    continue;
                }
                hs = ++i2;
                /* 洞的结束位置：配平嵌套的 `{}`，并跳过洞里的字符串字面量。
                 * 嵌套字面量的引号每深一层就多一层反斜杠（外层写 `\"`，
                 * 再深一层写 `\\\"`），所以定界符是"2^层数 - 1 个反斜杠 +
                 * 引号"。 */
                {
                    int lvl = 1;
                    int instr = 0;

                    while (i2 < rl) {
                        char ch = raw[i2];

                        if (ch == '\\') {
                            u32 k2 = 0;
                            u32 q2 = i2;
                            u32 need = 0;

                            while (q2 < rl && raw[q2] == '\\') {
                                k2++;
                                q2++;
                            }
                            if (q2 < rl && (raw[q2] == '"' || raw[q2] == '\'')) {
                                need = instr ? ((1u << (lvl - 1)) - 1)
                                             : ((1u << lvl) - 1);
                                if (k2 == need) {
                                    instr = !instr;
                                    if (instr)
                                        lvl++;
                                    else
                                        lvl--;
                                    i2 = q2 + 1;
                                    continue;
                                }
                                i2 = q2 + 1;   /* 转义掉的引号，跳过 */
                                continue;
                            }
                            i2 = q2;
                            continue;
                        }
                        if (ch == '"' || ch == '\'') {
                            char qc = ch;

                            i2++;
                            while (i2 < rl && raw[i2] != qc) {
                                if (raw[i2] == '\\' && i2 + 1 < rl)
                                    i2++;
                                i2++;
                            }
                            if (i2 < rl)
                                i2++;
                            continue;
                        }
                        if (!instr) {
                            if (ch == '{') {
                                depth++;
                                i2++;
                                continue;
                            }
                            if (ch == '}') {
                                if (depth == 0)
                                    break;
                                depth--;
                                i2++;
                                continue;
                            }
                        }
                        i2++;
                    }
                }
                hlen = i2 - hs;
                /* 洞必须真的包着东西，也必须真的闭合 */
                if (hlen == 0)
                    pa_error("f-string: '{}' 里要一个表达式");
                else if (i2 >= rl)
                    pa_error("f-string: 洞没闭合，缺 '}'");
                else {
                    u32 tq = 0;

                    /* 插值里不许出现 `try`：错误路径会从函数直接返回，
                     * 构造到一半的缓冲就留在栈上了。 */
                    while (tq + 3 <= hlen) {
                        if ((tq == 0 || !is_ident_cont((u8)raw[hs + tq - 1]))
                            && raw[hs + tq] == 't' && raw[hs + tq + 1] == 'r'
                            && raw[hs + tq + 2] == 'y'
                            && (tq + 3 >= hlen
                                || !is_ident_cont((u8)raw[hs + tq + 3]))) {
                            pa_error("f-string: 插值里不能用 'try'");
                            break;
                        }
                        tq++;
                    }
                }
                {
                    /* `{expr;spec}`：`;` 之后是格式说明；洞里带嵌套字符串
                     * 字面量的（`f"{f\"...\"}"`）先不做，避免把反斜杠层数
                     * 搞错。 */
                    u32 hq = 0;
                    u32 hd = 0;

                    /* 找 `;` 要跳过嵌套的 `{}` 和字符串字面量：嵌套 f-string
                     * `f"{f\"{n;x}\"}"` 里那个 `;` 属于内层的格式说明。 */
                    while (hq < hlen) {
                        char hc = raw[hs + hq];

                        if (hc == '{') {
                            hd++;
                        } else if (hc == '}') {
                            if (hd == 0)
                                break;
                            hd--;
                        } else if (hc == '"' || hc == '\'') {
                            char qc = hc;

                            hq++;
                            while (hq < hlen && raw[hs + hq] != qc) {
                                if (raw[hs + hq] == '\\')
                                    hq++;
                                hq++;
                            }
                        } else if (hc == '\\' && hq + 1 < hlen
                                   && (raw[hs + hq + 1] == '"'
                                       || raw[hs + hq + 1] == '\'')) {
                            char qc = raw[hs + hq + 1];

                            hq += 2;
                            while (hq + 1 < hlen
                                   && !(raw[hs + hq] == '\\'
                                        && raw[hs + hq + 1] == qc))
                                hq++;
                            hq++;
                        } else if (hc == ';' && hd == 0) {
                            spec = raw + hs + hq + 1;
                            sl = hlen - hq - 1;
                            hlen = hq;
                            if (sl == 0)
                                pa_error("f-string: '{expr;spec}' 里的格式说明是空的");
                            break;
                        }
                        hq++;
                    }

                }
                if (hlen > 0) {
                    Sym *hs2 = NULL;
                    u32 hv = 0;
                    u32 hty = 0;
                    int got = 0;
                    u32 q = 0;
                    int plain = 1;

                    for (q = 0; q < hlen; q++) {
                        int ch = (u8)raw[hs + q];

                        if (q == 0 ? !is_ident_start(ch) : !is_ident_cont(ch)) {
                            plain = 0;
                            break;
                        }
                    }
                    if (plain)
                        hs2 = sym_find(raw + hs, hlen);
                    if (hs2 && hs2->is_func) {
                        /* 函数不是值，函数指针才是（按地址输出） */
                        pa_error("f-string: 函数 '%.*s' 不是值，函数指针才是",
                                 (int)hlen, raw + hs);
                        hs2 = NULL;
                    }
                    if (hs2
                        && (hs2->kind == SC_LOCAL || hs2->kind == SC_PARAM
                            || hs2->kind == SC_GLOBAL)) {
                        /* 聚合/切片在我们的约定里就是"用地址代表值"，
                         * 不能走 load_lval（那会把它第一个机器字当成值）。 */
                        if (ty_is_agg(hs2->type) || ty_is_slice(hs2->type)
                            || ty_is_array(hs2->type))
                            hv = ident_addr(hs2);
                        else
                            hv = load_lval(ident_addr(hs2), hs2->type);
                        hty = hs2->type;
                        got = 1;
                    } else if (fstr_hole_expr(raw, stk_file, hs, hlen,
                                              &hv, &hty)) {
                        got = 1;
                    }
                    if (got) {
                        u32 stg = ty_is_slice(hty) ? ty_slice_elem(hty) : 0;

                        if (hty == ty_void())
                            pa_error("f-string: void 值不能插值");
                        else if (stg && !ty_charish(stg) && !ty_is_slice(stg)
                                 && !ty_is_agg(stg) && !ty_is_ptr(stg))
                            pa_error("f-string: 只有字符切片能插值（%d 元素不行）",
                                     (int)stg);
                        else if (ty_is_agg(hty) && !ty_is_slice(hty))
                            pa_error("f-string: 结构体/联合体的值不能插值");
                        /* 别写成 `av[na++] = fstr_fmt_arg(..., &na)`：那个
                         * `na++` 和函数里对 na 的自增没有先后序，切片要占
                         * 两格时正好踩到（实参顺序一乱就段错误）。 */
                        u32 rv = fstr_fmt_arg(fmt, &fl, hty, hv, spec, sl,
                                              av, &na);

                        if (na < 8) {
                            av[na] = rv;
                            na++;
                        }
                    }
                }
                if (i2 < rl)
                    i2++;
                continue;
            }
            if (raw[i2] == '{' && i2 + 1 < rl && raw[i2 + 1] == '{') {
                fmt[fl++] = '{';         /* `{{` 是字面量花括号 */
                i2 += 2;
                continue;
            }
            if (raw[i2] == '}' && i2 + 1 < rl && raw[i2 + 1] == '}') {
                fmt[fl++] = '}';         /* `}}` 同上 */
                i2 += 2;
                continue;
            }
            /* 字面量里的转义要在写数据段之前解掉：`fmt` 是 snprintf 直接读
             * 的字节，`\n`、`\"`、`\x41` 得变成真正的字符（以前原样抄
             * 进去，`f"\t{n}"` 输出的是反斜杠 t）。 */
            if (raw[i2] == '\\' && i2 + 1 < rl) {
                char e = raw[i2 + 1];
                int ch = 0;

                i2 += 2;
                switch (e) {
                case 'n': ch = '\n'; break;
                case 't': ch = '\t'; break;
                case 'r': ch = '\r'; break;
                case 'a': ch = 7; break;
                case 'b': ch = 8; break;
                case 'f': ch = 12; break;
                case 'v': ch = 11; break;
                case 'e': ch = 27; break;
                case 'x': {
                    u32 h = 0;

                    while (i2 < rl && h < 2
                           && ((raw[i2] >= '0' && raw[i2] <= '9')
                               || (raw[i2] >= 'a' && raw[i2] <= 'f')
                               || (raw[i2] >= 'A' && raw[i2] <= 'F'))) {
                        int dv = raw[i2] <= '9' ? raw[i2] - '0'
                                 : (raw[i2] | 32) - 'a' + 10;

                        ch = ch * 16 + dv;
                        h++;
                        i2++;
                    }
                    break;
                }
                default:
                    if (e >= '0' && e <= '7') {
                        u32 h = 0;

                        ch = e - '0';
                        while (i2 < rl && h < 2 && raw[i2] >= '0'
                               && raw[i2] <= '7') {
                            ch = ch * 8 + (raw[i2] - '0');
                            h++;
                            i2++;
                        }
                    } else {
                        ch = (u8)e;
                    }
                    break;
                }
                if (ch == '%')
                    fmt[fl++] = '%';
                fmt[fl++] = (char)ch;
                continue;
            }
            if (raw[i2] == '%')
                fmt[fl++] = '%';         /* 字面量里的 % 要转义 */
            fmt[fl++] = raw[i2];
            i2++;
        }
        fmt[fl] = 0;
        foff = data_alloc(fl + 1, 1);
        for (i2 = 0; i2 <= fl; i2++)
            DATA_IMG.p[foff + i2] = (u8)fmt[i2];
        /* 同一次求值深度上复用同一块临时缓冲（c6 的约定：`f".."` 借用的
         * 缓冲只保证到"下一次同深度求值"之前，见 tests/fstr.c6）；更深的
         * 嵌套用自己的那一格，不会盖掉外层的。 */
        if (fdt < 8 && !fdm) {
            if (FSTR_SLOT[fdt] == 0)
                FSTR_SLOT[fdt] = frame_slots_for(1024);
            slot = FSTR_SLOT[fdt];
        } else {
            slot = frame_slots_for(1024);
        }
        aptr = irfn_vreg(&FN);
        irfn_push(&FN, IR_ADDR, IRT_PTR, aptr, 0, 0, 0, X64_SLOT(slot));
        cfmt = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONSTK, IRT_PTR, cfmt, 0, 0, 0,
                  irfn_kconst(&FN, (u64)DATA_VA(foff)));
        ccap = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, ccap, 0, 0, 0, 1024);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, aptr, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, ccap, 0, 0, 1);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, cfmt, 0, 0, 2);
        {
            u32 k2 = 0;

            for (k2 = 0; k2 < na; k2++)
                irfn_push(&FN, IR_ARG, IRT_U64, 0, av[k2], 0, 0, 3 + k2);
        }
        dst = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_I64, dst, 0, 0, 0, x64_sym(&X64, "snprintf"));
        FN.ops[FN.n - 1].narg = (u8)(3 + na);
        GEN_TY = ty_ptr(ty_char());
        E_WAS_CALL = 1;            /* `@f"…"` 也是新引用（帧内缓冲，够用就行） */
        FSTR_DEPTH = (int)fdt;
        return gen_postfix_ops(aptr);
    }
    /* `await expr`：任务都同步跑完了，await 就是取它的值（和 __c6_co_wait
     * 那组桩一致）。软关键字：后面跟 `=`/`;`/`)` 之类时是普通标识符。 */
    if (PA_IS_IDENT("await") && c6_kw() && pa_peek(1)
        && !(pa_peek(1)->kind == TK_PUNCT
             && (TOK_EQ(pa_peek(1), "=") || TOK_EQ(pa_peek(1), ";")
                 || tok_eq(pa_peek(1), ")") || tok_eq(pa_peek(1), ",")
                 || TOK_EQ(pa_peek(1), ".") || TOK_EQ(pa_peek(1), "[")))) {
        u32 av = 0;
        u32 aty = 0;

        int was_io = 0;

        pa_advance();
        /* await 只能在 async 函数里；defer 体里不行（defer 必须同步跑完）、
         * sizeof/typeof 这种不求值上下文里也不行。 */
        if (!CUR_TASK_TY)
            pa_error("'await' 只能出现在 async 函数里");
        else if (PA_IN_DEFER)
            pa_error("'await' 不能出现在 defer 体里");
        else if (PA_UNEVAL)
            pa_error("'await' 不能出现在 sizeof/typeof 这种不求值上下文里");
        /* `await c6_io(fd, ev)` 是合法形态；c6_io 单独调用见标识符那边。 */
        was_io = (pa_cur()->kind == TK_IDENT && TOK_EQ(pa_cur(), "c6_io")) ? 1 : 0;
        {
            int io_save = PA_AWAIT_IO;

            PA_AWAIT_IO = was_io;
            av = gen_unary();
            /* 按值返回聚合体的调用给出的是**地址**，别再取值（元组/struct
             * 结果被 `await` 时多 load 一次就是一堆垃圾，踩过）。 */
            if (!ty_is_agg(GEN_TY) && !ty_is_array(GEN_TY))
                av = value_of(av);
            PA_AWAIT_IO = io_save;
        }
        if (was_io)
            async_unwind_gate();          /* `await c6_io(…)` 的挂起点 */
        aty = GEN_TY;
        /* 任务结构指针：值在 `t->val` */
        if (ty_is_ptr(aty)) {
            u32 mty2 = 0;
            u32 moff2 = 0;

            if (agg_find_promoted(ty_target(aty), "val", 3, &mty2, &moff2)) {
                u32 lv = irfn_vreg(&FN);
                u32 la = irfn_vreg(&FN);
                u32 aw = irfn_vreg(&FN);

                /* 任务还没结束就在这里挂起（`await` 的语义），结束时返回 */
                if (!was_io) {
                    irfn_push(&FN, IR_ARG, IRT_U64, 0, av, 0, 0, 0);
                    irfn_push(&FN, IR_CALL, IRT_I64, aw, 0, 0, 0,
                              x64_sym(&X64, "__c6_co_await"));
                    FN.ops[FN.n - 1].narg = 1;
                    async_unwind_gate();
                }

                irfn_push(&FN, IR_LEA, IRT_PTR, la, av, 0, 0, (u32)moff2);
                if (ty_is_agg(mty2) || ty_is_array(mty2)) {
                    /* `t->val` 本身是聚合体：按地址约定，地址就是那个 LEA */
                    GEN_TY = mty2;
                    PEND_LVAL = 0;
                    return gen_postfix_ops(la);
                }
                irfn_push(&FN, IR_LOAD, ir_ty_of(mty2), lv, la, 0, 0, 0);
                GEN_TY = mty2;
                PEND_LVAL = 0;
                return gen_postfix_ops(lv);
            }
        }
        if (!was_io)
            pa_error("'await' 的操作数必须是一次 async 调用（或 await c6_io(fd, ev)）");
        GEN_TY = aty;
        return gen_postfix_ops(av);
    }
    /* c6 的 `try expr`：出错就当场从当前函数返回那个错误码（错误槽保持置位，
     * 由调用方的 catch 接手），成功则原样给出表达式的值。软关键字——后面跟
     * `=` / `;` / `)` / `,` / `.` / `[` 的时候它是普通标识符。 */
    if (c6_kw() && PA_IS_IDENT("try") && pa_peek(1)
        && !(pa_peek(1)->kind == TK_PUNCT
             && (TOK_EQ(pa_peek(1), "=") || TOK_EQ(pa_peek(1), ";")
                 || tok_eq(pa_peek(1), ")") || tok_eq(pa_peek(1), ",")
                 || TOK_EQ(pa_peek(1), ".") || TOK_EQ(pa_peek(1), "[")))) {
        u32 tv = 0;
        u32 tty = 0;
        u32 tfl = 0;
        u32 lret = 0;
        u32 lend = 0;

        pa_advance();
        if (!CUR_FALLIBLE)
            pa_error("'try' 要求当前函数返回 'T!error'");
        if (PA_IN_DEFER)
            pa_error("'try' 不能出现在 defer 体里");
        if (PA_IN_DROP)
            pa_error("'drop' 不能失败：它在对象释放时跑，错误没处去");
        {
            int shaped = 1;    /* 1 = 标识符调用，2 = 说不准，0 = 明显不是调用 */

            if (!(pa_cur()->kind == TK_IDENT && pa_peek(1)
                  && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "("))) {
                shaped = 0;
                if (pa_cur()->kind == TK_IDENT && pa_peek(1)
                    && pa_peek(1)->kind == TK_PUNCT
                    && (TOK_EQ(pa_peek(1), "->") || TOK_EQ(pa_peek(1), ".")
                        || TOK_EQ(pa_peek(1), "[")))
                    shaped = 2;    /* 方法/下标调用：可失败性查不出来 */
                else if (pa_cur()->kind == TK_PUNCT
                         && (tok_eq(pa_cur(), "(") || TOK_EQ(pa_cur(), "*")))
                    shaped = 2;
            }
            if (shaped == 0) {
                pa_error("'try' 要跟一次返回 'T!error' 的调用");
            } else if (shaped == 1) {
                Sym *tfs = sym_find(tok_data(pa_cur()), pa_cur()->len);

                if (tfs && tfs->is_func && !tfs->fallible)
                    pa_error("'try' 要跟一次返回 'T!error' 的调用");
            }
        }
        tv = value_of(gen_unary());
        tty = GEN_TY;
        tfl = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_I32, tfl, 0, 0, 0,
                  x64_sym(&X64, "__tcc_err_flag_get"));
        FN.ops[FN.n - 1].narg = 0;
        lret = irfn_label(&FN);
        lend = irfn_label(&FN);
        irfn_push(&FN, IR_BR, IRT_VOID, 0, tfl, lret, lend, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lret, 0, 0, 0);
        defer_run(1, 1);                 /* 错误路径：errdefer 也要跑 */
        irfn_push(&FN, IR_RET, ir_ty_of(CUR_RET_TY), 0, tv, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
        GEN_TY = tty;
        return gen_postfix_ops(tv);
    }
    /* GNU 计算 goto 的取标号地址：`&&label`（一元位置）。注意别和逻辑与
     * 混淆——`&&` 出现在**一元**位置时后面一定跟标识符。 */
    if (pa_is_punct("&&") && pa_peek(1)->kind == TK_IDENT) {
        u32 l = goto_label(tok_data(pa_peek(1)), pa_peek(1)->len);
        u32 d = irfn_vreg(&FN);

        pa_advance();
        pa_advance();
        irfn_push(&FN, IR_LABELADDR, IRT_PTR, d, l, 0, 0, 0);
        GEN_TY = ty_ptr(ty_void());
        return gen_postfix_ops(d);
    }
    /* `spawn f(a, b)`：软关键字——后面是 标识符 + `(` 才算 */
    if (PA_IS_IDENT("spawn") && c6_kw() && pa_peek(1)->kind == TK_IDENT
        && pa_peek(2)->kind == TK_PUNCT
        && (tok_eq(pa_peek(2), "(") || TOK_EQ(pa_peek(2), "@"))) {
        if (PA_IN_DROP)
            pa_error("'drop' 不能挂起：它在对象释放时跑");
        Sym *ss = NULL;
        u32 sargs[16] = {0};
        u32 sargty[16] = {0};
        u8 sargmgd[PA_ARG_MAX] = {0};
        u32 mgdmask = 0;
        u32 sn = 0;
        u32 i2 = 0;
        u32 env = 0;
        u32 tgtv = 0;
        u32 th = 0;
        u32 thsz = 0;
        u32 startv = 0;
        u32 zv = 0;
        u32 pc = x64_sym(&X64, "pthread_create");
        u32 thr = x64_sym(&X64, "__c6_thr_start");
        u32 msym = x64_sym(&X64, "malloc");
        u32 thunk = 0;

        pa_advance();                        /* spawn */
        /* `spawn vsum@int(&v)`：函数模板的实例也是普通函数，先实例化再取符号 */
        if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(1), "@")) {
            Tmpl *st = tmpl_find(tok_data(pa_cur()), pa_cur()->len);

            if (st && st->is_func) {
                u32 targs[TMPL_NPARAM] = {0};
                u32 tna = 0;
                char tnm2[320] = {0};

                pa_advance();
                pa_advance();               /* @ */
                tna = tmpl_parse_args(st, targs, pa_is_ch('('));
                (void)tmpl_func_sig(st, targs, tna);
                tmpl_mangle_name(st, targs, tna, tnm2, sizeof(tnm2));
                ss = sym_find(tnm2, (u32)strlen(tnm2));
            }
        } else {
            ss = sym_find(tok_data(pa_cur()), pa_cur()->len);
        }
        if (!ss || !ss->is_func) {
            pa_error("spawn 后面要一个函数名");
            GEN_TY = ty_thread();
            return 0;
        }
        /* `spawn` 起的是普通线程：async 函数有自己的任务结构、可失败函数
         * 的错误没处送、变参和函数指针参数的约定也搬不过去
         * （tests/errors/spawn.c6）。 */
        if (ty_is_task_ptr(ty_func_ret(ss->type))) {
            pa_error("'spawn' requires a plain function: '%.*s' is 'async'",
                     (int)ss->len, ss->name);
        } else if (ss->fallible) {
            pa_error("'spawn' does not support fallible functions: '%.*s'",
                     (int)ss->len, ss->name);
        } else if (ty_func_variadic(ss->type)) {
            pa_error("'spawn' does not support variadic functions: '%.*s'",
                     (int)ss->len, ss->name);
        } else {
            u32 pi = 0;

            for (pi = 0; pi < ty_func_nparams(ss->type); pi++) {
                u32 pt = ty_func_param(ss->type, pi);

                if (ty_is_func(pt)
                    || (ty_is_ptr(pt) && ty_is_func(ty_target(pt)))) {
                    pa_error("'spawn' does not support this signature: '%.*s'",
                             (int)ss->len, ss->name);
                    break;
                }
            }
        }
        pa_advance();
        pa_advance();                        /* ( */
        if (!pa_accept_ch(')')) {
            for (;;) {
                if (sn >= PA_ARG_MAX) {
                    pa_error("spawn 实参太多（上限 16）");
                    break;
                }
                {
                    /* 托管引用（`shared @T`）要记下来：实参块自己持一份计数 */
                    u32 av0 = gen_assign();
                    int amgd = PEND_MGD;
                    Sym *asym = PEND_MGD_SYM;

                    /* 跨线程传引用必须写 `shared @T`：普通 `@T` 的计数不是原子的
                     * （tests/errors/gc_borrow.c6 的 test_spawn_plain）。 */
                    if (asym && asym->is_mgd == 1 && !asym->is_shared && in_c6_tu())
                        pa_error("passing a reference to 'spawn' requires 'shared'");
                    if (ty_is_closure(GEN_TY, NULL))
                        pa_error("a closure cannot cross a thread or a task: V2 "
                                 "closures are confined to the thread that creates "
                                 "them");
                    sargs[sn] = value_of(av0);
                    if (mgd_tmp_has(sargs[sn]))
                        amgd = 1;
                    sargmgd[sn] = (u8)(amgd ? 1 : 0);
                    sargty[sn] = GEN_TY;
                    if (amgd)
                        mgdmask |= 1u << sn;
                    sn++;
                }
                if (!pa_accept_ch(','))
                    break;
            }
            pa_expect_ch(')');
        }
        thunk = spawn_thunk((int)sn, mgdmask);
        /* 聚合实参按值传到线程里：参数块后面留一块副本区，spawn 处就把结构体
         * 拷过去，线程拿到的是副本（`spawn f(v); v.a = 100;` 不影响它）。
         * 非聚合的参数本来就是值，直接存 8 字节。 */
        {
            u32 aggsz = 0;

            for (i2 = 0; i2 < sn; i2++)
                if (sargty[i2] && ty_is_agg(sargty[i2]))
                    aggsz += (ty_size(sargty[i2]) + 7) / 8 * 8;
            env = clos_alloc(thunk, 16 + 8 * sn + aggsz);
        }
        tgtv = irfn_vreg(&FN);
        irfn_push(&FN, IR_ADDR, IRT_PTR, tgtv, 0, 0, 0, (u32)ss->val);
        FN.ops[FN.n - 1].flags = 2;
        irfn_push(&FN, IR_STORE, IRT_U64, gen_addr_off(env, 8), tgtv, 0, 0, 0);
        {
            u32 aggoff = 16 + 8 * sn;

            for (i2 = 0; i2 < sn; i2++) {
                if (sargty[i2] && ty_is_agg(sargty[i2])) {
                    u32 asz = ty_size(sargty[i2]);
                    u32 dstv = gen_addr_off(env, aggoff);

                    irfn_push(&FN, IR_COPY, IRT_U64, dstv, sargs[i2], 0, 0, asz);
                    irfn_push(&FN, IR_STORE, IRT_U64,
                              gen_addr_off(env, 16 + 8 * i2), dstv, 0, 0, 0);
                    aggoff += (asz + 7) / 8 * 8;
                } else {
                    irfn_push(&FN, IR_STORE, IRT_U64,
                              gen_addr_off(env, 16 + 8 * i2), sargs[i2], 0, 0, 0);
                }
                /* 实参块持有自己那一份（线程退出时由中转函数还回来） */
                if (sargmgd[i2])
                    mgd_retain(sargs[i2]);
            }
        }
        thsz = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, thsz, 0, 0, 0, 16);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, thsz, 0, 0, 0);
        th = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_PTR, th, 0, 0, 0, msym);
        FN.ops[FN.n - 1].narg = 1;
        zv = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, zv, 0, 0, 0, 0);
        startv = irfn_vreg(&FN);
        irfn_push(&FN, IR_ADDR, IRT_PTR, startv, 0, 0, 0, thr);
        FN.ops[FN.n - 1].flags = 2;
        irfn_push(&FN, IR_ARG, IRT_U64, 0, th, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, zv, 0, 0, 1);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, startv, 0, 0, 2);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, env, 0, 0, 3);
        {
            u32 d2 = irfn_vreg(&FN);

            irfn_push(&FN, IR_CALL, IRT_I64, d2, 0, 0, 0, pc);
            FN.ops[FN.n - 1].narg = 4;
        }
        GEN_TY = ty_thread();
        return gen_postfix_ops(th);
    }
    /* 函数字面量 `int(int n) { return n * 3; }`（不捕获） */
    /* 一元位置上出现类型名只可能是字面量（强转要以 `(` 开头、sizeof 走前面），
     * 所以不要求紧跟 `(`——`struct Point(int v){…}` 这种多 token 的返回类型
     * 也要能认出来。形状还是要扫一遍确认。 */
    if (pa_at_typename() && !(pa_peek(1)->kind == TK_PUNCT
                               && TOK_EQ(pa_peek(1), "."))) {
        int depth = 0;
        int q = 0;
        int is_lit = 0;

        for (q = 1; q < PA_LOOK; q++) {
            Tok *t2 = pa_peek(q);

            if (t2->kind != TK_PUNCT)
                continue;
            if (tok_eq(t2, "(")) {
                depth++;
            } else if (tok_eq(t2, ")")) {
                depth--;
                if (depth == 0) {
                    Tok *nx = pa_peek(q + 1);

                    is_lit = (nx->kind == TK_PUNCT && TOK_EQ(nx, "{"));
                    break;
                }
            }
        }
        if (is_lit) {
            Sym *fs = NULL;

            fs = fnlit_parse_sym();
            u32 addr = 0;
            int fi = FL_LAST;

            if (!fs) {
                GEN_TY = ty_int();
                return 0;
            }
            /* 捕获的闭包：现开一个环境对象，把外层变量的值拷进去 */
            if (fi >= 0 && fi < (int)NFL && FL[fi].ncap > 0) {
                u32 env = clos_alloc((u32)fs->val, FL[fi].envbytes);
                int k = 0;

                for (k = 0; k < FL[fi].ncap; k++) {
                    Sym *os = sym_find(FL[fi].cname[k], FL[fi].clen[k]);
                    u32 sz = 0;
                    u32 dst = 0;

                    if (!os)
                        continue;
                    sz = ty_size(os->type);
                    if (sz == 0)
                        sz = 8;
                    dst = gen_addr_off(env, FL[fi].coff[k]);
                    if (sz == 1 || sz == 2 || sz == 4 || sz == 8) {
                        u32 lv = irfn_vreg(&FN);

                        irfn_push(&FN, IR_LOAD, ir_ty_of(os->type), lv,
                                  ident_addr(os), 0, 0, 0);
                        irfn_push(&FN, IR_STORE, ir_ty_of(os->type), dst,
                                  lv, 0, 0, 0);
                    } else {
                        irfn_push(&FN, IR_COPY, IRT_U8, dst,
                                  ident_addr(os), 0, 0, sz);
                    }
                }
                GEN_TY = ty_closure(FL[fi].fty);
                return gen_postfix_ops(env);
            }
            /* 关键：走 ident_addr（内部会置 flags=2，发射成 rip 相对 + 重定位），
             * 手工 push 一条 IR_ADDR 会走成"栈槽偏移"那条分支。 */
            addr = ident_addr(fs);
            GEN_TY = ty_ptr(fs->type);
            return gen_postfix_ops(addr);
        }
    }
    /* `new T`：分配一块零初始化的 T（`@T` 的表示就是 `T *`，对象头与引用
     * 计数还没做，所以现在是"只分配不回收"，见 docs/manual/gc.md）。
     *
     * 只在 c6 TU 里认：纯 C 的 `.c` / 外部头里 `new` 是**普通标识符**。
     * 内核 include/linux/list.h 的参数就叫 `new`（`__list_add(struct
     * list_head *new, ...)` 里有 `new->next = next`），少了这道门 c6c 会把
     * `new` 当关键字去解析类型，报出"结构体没有成员 'next'"这种完全跑偏的
     * 诊断，还会一路污染 list.h 后面所有内容的类型。
     *
     * 排除表里必须有 `->` 和 `[`：它们是"这是个变量、后面跟成员访问/下标"
     * 的铁证。少了 `->`，`new->next = next;` 会被当成 `new` 表达式去解析
     * 类型——正是内核报的那条错的来源。 */
    if (in_c6_tu() && PA_IS_IDENT("new") && !(pa_peek(1)->kind == TK_PUNCT
        && (TOK_EQ(pa_peek(1), "=") || tok_eq(pa_peek(1), "(")
            || TOK_EQ(pa_peek(1), ";") || TOK_EQ(pa_peek(1), ".")
            || TOK_EQ(pa_peek(1), "->") || TOK_EQ(pa_peek(1), "[")))) {
        u32 ty = 0;
        u32 esz = 0;
        u32 d = 0;
        u32 ncnt = 0;
        int is_arr = 0;
        Sym *ms = NULL;

        pa_advance();
        ty = parse_typespec();
        if (ty_is_closure(ty, NULL))
            pa_error("a closure cannot be created with 'new': use a function "
                     "literal or a function pointer");
        /* `new shared T` 和 `new T` 的区别：前者带原子计数，能进 shared 槽
         * （tests/errors/gc_borrow.c6 的 test_shared_new_plain）。 */
        E_NEW_SEEN = 1;
        E_NEW_SHARED = PA_MGD_SHARED ? 1 : 0;
        PA_MGD_SHARED = 0;
        while (pa_accept_ch('*'))
            ty = ty_ptr(ty);
        esz = ty_size(ty) ? ty_size(ty) : 8;
        if (pa_accept_ch('[')) {
            /* `new T[n]`：元素个数是运行期值，运行时要靠它逐个析构 */
            ncnt = value_of(gen_expr());

            pa_expect_ch(']');
            is_arr = 1;
        }
        ms = sym_find(is_arr ? "__c6_gc_new_arr" : "__c6_gc_new",
                      is_arr ? 15 : 11);
        if (!ms || !ms->is_func) {
            pa_error("`new` 需要运行时提供 __c6_gc_new");
            GEN_TY = ty_ptr(ty);
            return 0;
        }
        {
            u32 nv = irfn_vreg(&FN);
            u32 ev = irfn_vreg(&FN);
            u32 dv = irfn_vreg(&FN);
            u32 dsym = mgd_desc(ty);

            /* 描述符：让运行时知道怎么析构、哪些字段是托管引用 */
            irfn_push(&FN, IR_ADDR, IRT_PTR, dv, 0, 0, 0, dsym);
            FN.ops[FN.n - 1].flags = 2;
            if (is_arr) {
                irfn_push(&FN, IR_MOV, IRT_U64, nv, ncnt, 0, 0, 0);
                irfn_push(&FN, IR_CONST, IRT_U64, ev, 0, 0, 0, esz);
                irfn_push(&FN, IR_ARG, IRT_U64, 0, nv, 0, 0, 0);
                irfn_push(&FN, IR_ARG, IRT_U64, 0, ev, 0, 0, 1);
                irfn_push(&FN, IR_ARG, IRT_U64, 0, dv, 0, 0, 2);
            } else {
                irfn_push(&FN, IR_CONST, IRT_U64, nv, 0, 0, 0, esz);
                irfn_push(&FN, IR_ARG, IRT_U64, 0, nv, 0, 0, 0);
                irfn_push(&FN, IR_ARG, IRT_U64, 0, dv, 0, 0, 1);
            }
            d = irfn_vreg(&FN);
            irfn_push(&FN, IR_CALL, IRT_PTR, d, 0, 0, 0, (u32)ms->val);
            FN.ops[FN.n - 1].narg = (u32)(is_arr ? 3 : 2);
        }
        GEN_TY = ty_ptr(ty);
        mgd_tmp_add(d);
        return gen_postfix_ops(d);
    }
    /* c6 的 `try f(...)`：在 `T!error` 函数里转发错误。错误 id 就是返回值
     * （0 = 成功），所以非 0 时直接 `return 那个 id`，成功时值就是 0。
     * 语句形式 `try reserve(n + 1);` 是丢弃这个值，同一条路径。 */
    if (c6_kw() && PA_IS_IDENT("try")) {
        u32 l_bad = irfn_label(&FN);
        u32 l_ok = irfn_label(&FN);
        u32 v = 0;

        pa_advance();
        v = value_of(gen_unary());
        irfn_push(&FN, IR_BR, IRT_VOID, 0, v, l_bad, l_ok, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, l_bad, 0, 0, 0);
        irfn_push(&FN, IR_RET, ir_ty_of(CUR_RET_TY), 0, v, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, l_ok, 0, 0, 0);
        GEN_TY = ty_int();
        return v;
    }
    if (pa_accept_ch('&')) {
        u32 a = 0;
        int sav_amp = PA_AMP;

        E_WAS_ADDR = 1;
        PA_AMP = 1;
        a = gen_unary();
        PA_AMP = sav_amp;

        if (!PEND_LVAL && (ty_is_func(GEN_TY)
                           || (ty_is_ptr(GEN_TY) && ty_is_func(ty_target(GEN_TY))))) {
            /* &函数名：函数名在值位置上已经是"函数指针"，取地址还是它 */
            if (ty_is_func(GEN_TY))
                GEN_TY = ty_ptr(GEN_TY);
            return a;
        }
        /* `&call()`：按值返回聚合体本来就走"返回地址"这条约定，取地址还是它。 */
        if (!PEND_LVAL && ty_is_agg(GEN_TY))
            return a;
        if (!PEND_LVAL) {
            pa_error("'&' 需要一个左值");
            GEN_TY = ty_ptr(ty_int());
            return a;
        }
        PEND_LVAL = 0;
        GEN_TY = ty_ptr(PEND_TY);
        return PEND_ADDR;
    }
    if (pa_accept_ch('*')) {
        u32 p = 0;
        u32 ty = 0;

        if (ty_is_closure(GEN_TY, NULL))
            pa_error("'closure' is opaque: it can only be called, compared with "
                     "NULL, copied, moved or released");
        p = value_of(gen_unary());
        ty = GEN_TY;
        if (!ty_is_ptr(ty) && !ty_is_array(ty)) {
            pa_error("'*' 的对象不是指针");
            ty = ty_ptr(ty_int());
        }
        mark_lval(p, ty_target(ty));
        return p;
    }
    if (pa_accept_ch('-')) {
        u32 a = value_of(gen_unary());
        u32 cty = GEN_TY;

        if (ty_is_cplx(cty))
            return cplx_neg(a, cty);
        {
        u32 ty = ty_promote(GEN_TY);
        u32 z = irfn_vreg(&FN);
        u32 d = irfn_vreg(&FN);

        if (ty_is_float(ty)) {
            irfn_push(&FN, IR_FNEG, ir_ty_of(ty), d, a, 0, 0, 0);
            GEN_TY = ty;
            return d;
        }
        irfn_push(&FN, IR_CONST, IRT_U64, z, 0, 0, 0, 0);
        irfn_push(&FN, IR_SUB, ir_ty_of(ty), d, z, a, 0, 0);
        /* 一元负号也要按类型宽度回绕：`-(unsigned)0x80000002` 在 32 位里是
         * 0x7FFFFFFE，用 64 位中间值下去除就会算错（踩过 61_integers）。 */
        if (ty_is_int(ty) && ty_size(ty) < 8) {
            u32 t2 = irfn_vreg(&FN);

            irfn_push(&FN, IR_TRUNC, ir_ty_of(ty), t2, d, 0, 0, 0);
            d = t2;
        }
        /* 一元负号结果同样进 CV_* 表：`__is_constexpr(-1 + 8)` 里 `-1` 得是
         * 编译期常量，后面 `+8` 才折得出 0，否则又是 void* 那条岔路。 */
        {
            u64 ca = 0, cr = 0;

            if (cv_get(a, &ca) && cv_fold(IR_SUB, 0, ca, ty, &cr))
                cv_set(d, cv_fit(cr, ty));
        }
        GEN_TY = ty;
        return d;
        }
    }
    if (pa_accept_ch('+')) {
        u32 v = gen_unary();
        u32 ty = GEN_TY;

        /* C99 6.5.3.3p2：一元 `+` 的结果是**整型提升**后的操作数。少了这一步，
         * `sizeof(+c)`（c 是 signed char）给 1 而不是 4，`_Generic` 也会挑错
         * 分支；`sizeof(-c)`、`c + 0` 两条路本来就有提升，只有这里漏了。 */
        if ((ty_is_int(ty) || ty_kind(ty) == TY_BOOL) && ty_size(ty) < 4) {
            /* `_Bool` 也参与整型提升（C99 6.3.1.1p2），`ty_is_int` 不含它，
             * 所以单独判一下——`sizeof(+b)` 是 4 不是 1。 */
            v = value_of(v);
            v = gen_convert(v, ty, ty_int());
            ty = ty_int();
        }
        GEN_TY = ty;
        return v;
    }
    if (pa_accept_ch('!')) {
        u32 a = value_of(gen_unary());
        u32 z = irfn_vreg(&FN);
        u32 d = irfn_vreg(&FN);
        u64 cva = 0;
        int ka = cv_get(a, &cva);

        irfn_push(&FN, IR_CONST, IRT_U64, z, 0, 0, 0, 0);
        irfn_push(&FN, IR_CMP, IRT_U64, d, a, z, 0, IRCC_EQ);
        irfn_setcc(&FN, IRCC_EQ);
        /* `!常量` 进 CV_* 表：IS_POWER_OF_2 / __is_constexpr 都用 `!` 把
         * 常量判断折到空指针常量那条路上。 */
        if (ka)
            cv_set(d, cva == 0);
        GEN_TY = ty_int();
        return d;
    }
    if (pa_accept_ch('~')) {
        u32 a = value_of(gen_unary());
        u32 ty = GEN_TY;
        u32 d = irfn_vreg(&FN);

        /* `~` 按 C 的**整型提升**来：先把操作数提升到 int（位域、char、
         * short 都是），再在提升后的宽度上取反。结果类型就是提升后的类型。
         *
         * 两条都必须照这个来：
         *   - `~0U` 是 unsigned int 的 0xFFFFFFFF，不是 64 位的 0xFFFF…FF。
         *     截错的话内核 include/linux/mm_types.h:2038 的
         *         static_assert((u64)MMF_INIT_LEGACY_MASK <= (u64)UINT_MAX);
         *     会假失败（右端正是 `(u64)(~0U)`）。
         *   - 位域 `~s.u3`（无符号 3 位）提升成 int 后是 `~0` = -1，而不是
         *     按 1 字节截出来的 255。tcc tests2/93_integer_promotion 就是这条。 */
        if (ty_is_int(ty) && ty_size(ty) < 4) {
            a = gen_convert(a, ty, ty_int());
            ty = ty_int();
        }
        irfn_push(&FN, IR_NOT, ir_ty_of(ty), d, a, 0, 0, 0);
        /* x86-64 后端的 not 是 64 位一条指令；比 64 位窄的类型要截回去，
         * 否则高 32 位全是 1。 */
        if (ty_size(ty) < 8) {
            u32 d2 = irfn_vreg(&FN);

            irfn_push(&FN, IR_TRUNC, ir_ty_of(ty), d2, d, 0, 0, 0);
            d = d2;
        }
        GEN_TY = ty;
        return d;
    }
    if (pa_is_punct("++") || pa_is_punct("--")) {
        int inc = pa_is_punct("++");
        u32 a = 0;
        u32 addr = 0;
        u32 ty = 0;
        u32 old_v = 0;
        u32 one = 0;
        u32 nv = 0;

        pa_advance();        /* 先吃掉 ++/--，不然递归会原地打转 */
        a = gen_unary();
        if (!PEND_LVAL) {
            pa_error("前缀 ++/-- 需要一个左值");
            GEN_TY = ty_int();
            return a;
        }
        {
            u32 bb = PEND_BITS;
            u32 bb_off = PEND_BITOFF;

            addr = PEND_ADDR;
            ty = PEND_TY;
            PEND_LVAL = 0;
            old_v = bb ? load_bf(addr, ty, bb, bb_off, ty_is_signed(ty), PEND_BF_ENUM)
                       : load_lval(addr, ty);
            one = irfn_vreg(&FN);
            irfn_push(&FN, IR_CONST, IRT_U64, one, 0, 0, 0,
                      ty_is_ptr(ty) ? (ty_size(ty_target(ty)) ? ty_size(ty_target(ty)) : 1) : 1);
            nv = irfn_vreg(&FN);
            irfn_push(&FN, inc ? IR_ADD : IR_SUB, ir_ty_of(ty), nv, old_v, one,
                      0, 0);
            /* `++e` 的值是 e 的值（类型就是 e 的类型），所以窄于 8 字节的整数要
             * 按宽度截断一次：否则 `u8 b = 255; ++b != 0` 会拿 256 去比（写回
             * 时 store_lval 已经截过，这里漏的是**表达式值**）。AES-CTR 的
             * counter 递增就靠 `++ctr[i] != 0` 判进位（std-cipher 红的就是它）。 */
            if (ty_is_int(ty) && ty_size(ty) > 0 && ty_size(ty) < 8) {
                u32 nt = irfn_vreg(&FN);

                irfn_push(&FN, IR_TRUNC, ir_ty_of(ty), nt, nv, 0, 0, 0);
                nv = nt;
            }
            if (bb)
                store_lval_bits(addr, ty, bb, bb_off, nv);
            else
                store_lval(addr, ty, nv);
        }
        GEN_TY = ty;
        return nv;
    }
    if (PA_IS_IDENT("sizeof") || PA_IS_IDENT("__alignof__")
        || PA_IS_IDENT("_Alignof") || PA_IS_IDENT("alignof")) {
        u32 ty = 0;
        u32 d = 0;
        int is_align = 0;

        if (PA_ACCEPT_IDENT("sizeof")) {
            u32 vcnt = 0;
            u32 vesz = 0;
            int eszrun = 0;
            int paren = 0;

            is_align = 0;
            /* `sizeof vla_obj` / `sizeof(vla_obj)`：C99 6.5.3.4p2 要求变长
             * 数组的大小是**运行期**算的。长度在声明那里已经算成一个 vreg，
             * 这里现乘元素大小。 */
            paren = pa_vla_sizeof(&vcnt, &vesz, &eszrun);
            if (paren != 0) {
                u32 kk = 0;
                u32 vv = 0;

                /* 返回值 1 = 源码里带括号（`sizeof(v)`），2 = 不带（`sizeof v`）。
                 * 别写成 `paren > 0`：2 也大于 0，会多啃一个 token 再要 `)`，
                 * `sizeof v` 就直接编不过（踩过）。 */
                if (paren == 1)
                    pa_advance();               /* `(` */
                pa_advance();                   /* 数组名 */
                if (paren == 1)
                    pa_expect_ch(')');
                if (eszrun) {
                    /* 多维 VLA：一层的字节数本身就是运行期 vreg，直接乘 */
                    vv = gen_bin2(vcnt, ty_ulong(), IR_MUL, vesz, ty_ulong());
                    GEN_TY = ty_ulong();
                    return vv;
                }
                kk = irfn_vreg(&FN);
                irfn_push(&FN, IR_CONST, IRT_U64, kk, 0, 0, 0, vesz);
                vv = gen_bin2(vcnt, ty_ulong(), IR_MUL, kk, ty_ulong());
                GEN_TY = ty_ulong();
                return vv;
            }
        } else {
            (void)PA_ACCEPT_IDENT("__alignof__");
            (void)PA_ACCEPT_IDENT("_Alignof");
            (void)PA_ACCEPT_IDENT("alignof");
            is_align = 1;
        }
        if (pa_is_ch('(') && (is_typename_tok(pa_peek(1))
            || (pa_peek(1)->kind == TK_IDENT && pa_peek(2)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(2), "@"))
            /* `sizeof(@Node)` / `sizeof(weak @Node)`：托管类型的写法 */
            || (pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), "@"))
            || (pa_peek(1)->kind == TK_IDENT
                && (TOK_EQ(pa_peek(1), "weak") || TOK_EQ(pa_peek(1), "shared")
                    || TOK_EQ(pa_peek(1), "own"))
                && (pa_peek(2)->kind == TK_IDENT || pa_peek(2)->kind == TK_PUNCT))
            /* `sizeof((int, int))`：内层括号是类型，而且它的闭括号后面
             * 紧跟 sizeof 自己的 `)`——否则就是复合字面量 `(t){…}` */
            || (pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")
                && is_typename_tok(pa_peek(2))
                && pa_peek(3)->kind == TK_PUNCT
                && (tok_eq(pa_peek(3), ",") || tok_eq(pa_peek(3), ")"))
                && sizeof_inner_type_end()))) {
            pa_advance();
            ty = parse_typename();
            if (pa_is_ch(',')) {
                /* `sizeof((int, int))`：元组类型 */
                u32 tys[TUPLE_MAXN] = {0};
                u32 tn = 0;

                tys[tn++] = ty;
                while (tn < TUPLE_MAXN && pa_accept_ch(','))
                    tys[tn++] = parse_typename();
                ty = ty_tuple_chk(tys, tn);
            }
            pa_expect_ch(')');
        } else if (!is_align && sizeof_lit_run()) {
            /* sizeof("abc") 同 sizeof "abc"：括号里就一个字符串字面量 */
            pa_advance();
            (void)str_lit_data();
            /* 宽字面量（`L"…"`/`U"…"`）的元素是 4 字节的 wchar_t：sizeof 要
             * 按元素宽度算（`sizeof(L"abc")` 是 16 不是 4）。c6c 里宽字面量
             * 的退化类型就是 `ty_ptr(ty_int())`（见 str_lit_data 之后那行），
             * 这里跟着用 int 当元素类型。 */
            ty = ty_array(WIDE_LIT ? ty_int() : ty_char(), STR_LIT_N + 1);
            pa_expect_ch(')');
        } else if (!is_align && pa_cur()->kind == TK_STR) {
            /* sizeof "abc" 是 4 不是 8：字符串字面量的类型是 char[N]（含结尾 0），
             * 按表达式求值只会拿到退化后的 char *。tcc 的
             * `file_offset = sizeof ARMAG - 1` 就靠这个，错了整份 .a 都读歪。 */
            (void)str_lit_data();
            ty = ty_array(WIDE_LIT ? ty_int() : ty_char(), STR_LIT_N + 1);
        } else {
            u32 save = FN.n;
            u32 v2 = 0;
            int un_save = PA_UNEVAL;

            PA_UNEVAL = 1;
            v2 = gen_unary();
            PA_UNEVAL = un_save;
            ty = cur_op_ty();
            (void)v2;
            FN.n = save;     /* sizeof 的操作数不求值 */
            /* 操作数留下的左值态必须清掉，否则外层 `(int)sizeof x` 会把
             * “x 的地址”当成 sizeof 的结果传上去 */
            PEND_LVAL = 0;
        }
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0,
                  is_align ? (u32)ty_align_of(ty) : ty_size(ty));
        /* sizeof/alignof 是编译期整型常量，要进 CV_* 表。否则 `__is_constexpr`
         * 里的 `sizeof(struct{...})` 被当运行期值，GENMASK 常量断言挂掉。 */
        cv_set(d, is_align ? (u64)ty_align_of(ty) : (u64)ty_size(ty));
        GEN_TY = ty_ulong();
        return d;
    }
    if (pa_is_ch('(')
        && (is_typename_tok(pa_peek(1)) || TOK_EQ(pa_peek(1), "typeof")
            || (NIFACE > 0 && pa_peek(1)->kind == TK_IDENT
                && iface_find(tok_data(pa_peek(1)), pa_peek(1)->len) < IFACE_MAX)
            || (pa_peek(1)->kind == TK_IDENT && pa_peek(2)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(2), "@"))
            || TOK_EQ(pa_peek(1), "__typeof") || TOK_EQ(pa_peek(1), "__typeof__"))) {
        u32 ty = 0;
        u32 v = 0;

        pa_advance();
        SAW_TYPE_QUAL = 0;
        ty = parse_typename();
        CAST_QUAL = SAW_TYPE_QUAL;
        if (pa_is_ch(',')) {
            /* `(int, int){…}`：元组类型 */
            u32 tys[TUPLE_MAXN] = {0};
            u32 tn = 0;

            tys[tn++] = ty;
            while (tn < TUPLE_MAXN && pa_accept_ch(','))
                tys[tn++] = parse_typename();
            ty = ty_tuple_chk(tys, tn);
        }
        pa_expect_ch(')');
        {
            u32 ifx3 = 0;

            if (NIFACE > 0 && ty_is_iface(ty, &ifx3) && !pa_is_ch('{')) {
                u32 av3 = gen_unary();
                u32 aty3 = cur_op_ty();

                av3 = value_of(av3);       /* 聚合左值的"值"就是它的地址 */

                if (ty_is_agg(aty3) && !ty_is_iface(aty3, NULL)) {
                    u32 sty3 = ty_is_ptr(aty3) ? ty_target(aty3) : aty3;
                    u32 ts3 = frame_slots_for(16);
                    u32 ta3 = irfn_vreg(&FN);
                    u32 vv3 = irfn_vreg(&FN);
                    u32 sym3 = 0;

                    iface_check_impl(sty3, ifx3);
                    sym3 = iface_vtbl(ifx3, sty3);

                    irfn_push(&FN, IR_ADDR, IRT_PTR, ta3, 0, 0, 0, X64_SLOT(ts3));
                    store_conv(gen_addr_off(ta3, 0), ty_ptr(ty_void()), av3,
                               ty_ptr(ty_void()));
                    irfn_push(&FN, IR_ADDR, IRT_PTR, vv3, 0, 0, 0, sym3);
                    FN.ops[FN.n - 1].flags = 2;
                    store_conv(gen_addr_off(ta3, 8), ty_ptr(ty_void()), vv3,
                               ty_ptr(ty_void()));
                    GEN_TY = ty;
                    PEND_LVAL = 1;
                    PEND_ADDR = ta3;
                    PEND_TY = ty;
                    return gen_postfix_ops(ta3);
                }
                /* 接口 → 接口：普通拷贝（胖指针） */
                GEN_TY = ty;
                PEND_LVAL = 1;
                PEND_ADDR = av3;
                PEND_TY = ty;
                return gen_postfix_ops(av3);
            }
        }
typedef struct InitSave InitSave;

        if (pa_is_ch('{')) {
            /* 复合字面量 (T){...}：在栈上开个临时对象，就地初始化，值是它的地址 */
            u32 slot = 0;
            u32 addr = irfn_vreg(&FN);
            InitSave isv = { 0 };

            init_save(&isv);

            if (ty_is_array(ty) && ty_size(ty) == 0) {
                /* (int[]){...}：元素个数由初始化器决定，先按 1 KB 开，
                 * 建完从 INIT_COUNT 得知真实长度（和局部 `int a[] = {...}` 同一招） */
                u32 et = ty_target(ty);
                u32 esz = ty_size(et) ? ty_size(et) : 1;
                u32 capn = (1024u / esz) ? (1024u / esz) : 1;

                slot = frame_slots_for(capn * esz);
                irfn_push(&FN, IR_ADDR, IRT_PTR, addr, 0, 0, 0, X64_SLOT(slot));
                /* 复合字面量未显式初始化的元素必须是 0（C99 6.5.2.5p7）：
                 * 先整块清零，再铺初始化器。否则栈上残留垃圾，例如内核
                 * &(struct kmem_cache_args){ .align = 256 } 的 .ctor 拿到 8。 */
                gen_zero_obj(addr, capn * esz);
                gen_init_obj(addr, ty_array(et, capn), 0);
                /* 复合字面量是左值（`&(int[]){…}` 要能取地址） */
                PEND_LVAL = 1;
                PEND_TY = ty_array(et, INIT_CNT_OK ? INIT_COUNT : 1);
                PEND_ADDR = addr;
                /* typeof 要复合字面量的数组类型本身，不退化（NO_DECAY） */
                GEN_TY = NO_DECAY ? PEND_TY : ty_ptr(et);
                /* 复合字面量是后缀表达式的一部分：`(int[]){7,8}[1]`、
                 * `(struct P){1,2}.y` 都要接着走后缀链（C99 6.5.2）。 */
                init_restore(&isv);
                return gen_postfix_ops(addr);
            }
            slot = frame_slots_for(ty_size(ty));
            irfn_push(&FN, IR_ADDR, IRT_PTR, addr, 0, 0, 0, X64_SLOT(slot));
            /* 同上：结构体复合字面量先把未提及的成员清零（.ctor 拿到 8 的修复）。 */
            gen_zero_obj(addr, ty_size(ty));
            gen_init_obj(addr, ty, 0);
            PEND_LVAL = 1;
            PEND_TY = ty;
            PEND_ADDR = addr;
            GEN_TY = ty_is_array(ty) ? (NO_DECAY ? ty : ty_ptr(ty_target(ty))) : ty;
            /* 同上：复合字面量后面可以直接跟 `.成员`/`[下标]` */
            init_restore(&isv);
            return gen_postfix_ops(addr);
        }
        v = gen_unary();
        {
            u32 src = cur_op_ty();

            v = value_of(v);
            /* 复数（C99 6.3.1.7）：显式 cast 时复数↔实数才合法；实数 → 复数
             * 是 `(double _Complex)3` 这种写法，复数 → 实数取实部。 */
            if (ty_is_cplx(ty) || ty_is_cplx(src)) {
                if (ty_is_cplx(ty)) {
                    u32 out = 0;

                    if (ty_is_cplx(src)) {
                        u32 dct = cplx_comp(ty);
                        u32 sct = cplx_comp(src);

                        out = (ty == src) ? v : cplx_temp(ty);
                        if (ty != src) {
                            cplx_store(out, dct, 0,
                                       gen_convert(cplx_load(v, sct, 0), sct, dct));
                            cplx_store(out, dct, ty_size(dct),
                                       gen_convert(cplx_load(v, sct, ty_size(sct)),
                                                   sct, dct));
                        }
                    } else {
                        out = cplx_from_real(v, src, ty);
                    }
                    GEN_TY = ty;
                    PEND_LVAL = 1;
                    PEND_ADDR = out;
                    PEND_TY = ty;
                    return gen_postfix_ops(out);
                }
                /* 复数 → 实数：取实部，再走普通的算术转换 */
                {
                    u32 sct = cplx_comp(src);

                    v = cplx_load(v, sct, 0);
                    src = sct;
                }
            }
            /* 空指针常量再转一道指针：类型名里带限定符就不再是 NPC */
            if (E_NPC && (!ty_is_ptr(ty) || CAST_QUAL))
                E_NPC = 0;
            if (ty_is_ptr(ty) || ty_is_array(ty)) {
                GEN_TY = ty_is_array(ty) ? ty_ptr(ty_target(ty)) : ty;
                if (ty_is_float(src))
                    return gen_convert(v, src, ty_ulong());
                return v;
            }
            GEN_TY = ty;
            /* 显式 cast：只有这里的"切片转标量"要报（隐式转换那条路上
             * 还有 `.len` 这类历史遗留，见 todo）。 */
            PA_CAST_CONV = 1;
            {
                u32 rv9 = gen_convert(v, src, ty);

                PA_CAST_CONV = 0;
                return rv9;
            }
        }
    }
    return gen_postfix();
}

/* 整型提升：比 int 小的整型一律提升成 int。槽里的值本来就是按类型规范化过的
 * 8 字节值（char 已经符号/零扩展），所以这里只改"类型标签"——它决定除法、
 * 取模、移位、比较走有符号还是无符号那条路。`(short)1 << 4` 因此按 int 算。 */
static u32 ty_promote(u32 ty)
{
    if (ty_is_int(ty) && ty_size(ty) < 4)
        return ty_int();
    return ty;
}

/* 整数 → 整数的转换要把编译期值一起带过去（CV_* 那张表，见 E_NPC 的注释）；
 * 涉及浮点的转换一律当"不是整型常量"，别去猜位模式。 */
static u32 gen_convert_impl(u32 v, u32 from, u32 to);

static u32 gen_convert(u32 v, u32 from, u32 to)
{
    u64 c0 = 0;
    u32 r = gen_convert_impl(v, from, to);

    if (ty_is_int(from) && ty_is_int(to) && r != v && cv_get(v, &c0))
        cv_set(r, cv_fit(c0, to));
    return r;
}

/* C 的算术转换：把值 v（类型 from）转成类型 to。只处理标量。
 * 整数 → 整数 时按目标宽度回绕（和 gen_cast_to 一样），浮点走 SSE。 */
static u32 gen_convert_impl(u32 v, u32 from, u32 to)
{
    int ff = ty_is_float(from);
    int ft = ty_is_float(to);
    u32 d = 0;

    /* bf16：值在 IR 里是 f32，内存里是 16 位。
     *   bf16 → 别的类型：值本来就是 f32，按 float 源继续转（double/int 都走
     *   现成通路）。
     *   别的类型 → bf16：先转 f32 再 RNE 舍入；结果仍是 f32（舍入后的值），
     *   这样 `(float)(bf16)x` 能看到舍入效果，存回内存时再舍一次是幂等的。 */
    if (ty_kind(from) == TY_BF16)
        return ty_kind(to) == TY_BF16 ? v : gen_convert_impl(v, ty_float(), to);
    if (ty_kind(to) == TY_BF16)
        return bf16_round_val(ty_kind(from) == TY_FLOAT ? v
                                                       : gen_convert_impl(v, from, ty_float()));

    /* 显式 cast 里切片转标量没有意义（`(int)s`）：切片是个 16 字节的对象，
     * 转成整数只会拿到它的地址（tests/errors/slice.c6 的 test_slice_to_int）。 */
    if (PA_CAST_CONV && ty_is_slice(from) && !ty_is_slice(to) && in_c6_tu())
        pa_error("cannot convert '%s' to '%s'", ty_disp(from), ty_disp(to));

    /* 闭包不是函数指针：它带着环境对象，转成裸指针之后调用会缺一个隐藏实参
     * （tests/errors/closure_convert.c6）。 */
    /* 变参函数指针包不成闭包：跳板没法转发一个长度未知的实参表。 */
    if (ty_is_closure(to, NULL)
        && ((ty_is_ptr(from) && ty_is_func(ty_target(from))) || ty_is_func(from))
        && ty_func_variadic(ty_is_ptr(from) ? ty_target(from) : from) && in_c6_tu())
        pa_error("a variadic function pointer cannot be wrapped into a closure: a "
                 "trampoline cannot forward an unknown argument list (make it a "
                 "capturing literal instead)");
    if (ty_is_closure(from, NULL) && in_c6_tu()) {
        if (ty_is_ptr(to) && ty_is_func(ty_target(to)))
            pa_error("a closure cannot become a plain function pointer: it carries "
                     "an environment (call it, or keep it as 'closure RET "
                     "(parameters)')");
        else if (ty_is_ptr(to) && ty_target(to) == ty_void())
            pa_error("a closure cannot be converted to 'void *': closures are opaque");
    }

    /* C99 6.3.1.2：任何标量转 `_Bool` 都是"跟 0 比"，结果是 0 或 1。
     * 少了这条就按"窄化成 1 字节"处理：`_Bool b = 5;` 存的是 5、
     * `_Bool c = 300;` 存 44（踩过，gcc 两边都是 1）。浮点源同理
     * （`_Bool t = 0.5;` 是 1，不是 0）。 */
    /* 只管纯 C 的 TU（`.c`）。c6 的 `.c6` 世界里 `bool` 的转换和托管引用
     * （`@T` 的 retain/release）缠在一起，套上"和 0 比"会把生命周期算乱
     * ——tests/fstr.c6 的 `@f".."` 循环用例当场漏引用、整个程序段错误。
     * C99 的转换规则是给 C 用的，`.c6` 保持原样。 */
    if (!in_c6_tu() && ty_kind(to) == TY_BOOL && ty_kind(from) != TY_BOOL
        && ty_is_scalar(from)) {
        u32 z = gen_convert(gen_int_lit(0, ty_int()), ty_int(), from);
        /* 浮点源要按**浮点**比：gen_cmp3 只有在 cty 是浮点类型时才吐浮点
         * 比较，给 ty_int() 会把 double 的位模式当整数看（`_Bool t = 0.5`
         * 于是得到 0）。 */
        u32 ct = ty_is_float(from) ? from : ty_int();

        return gen_cmp3(v, from, z, from, IRCC_NE, ct);
    }
    if (ff && ft) {
        if (ty_size(from) == ty_size(to))
            return v;
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_FCVT, ir_ty_of(to), d, v, 0, 0, 0);
        return d;
    }
    if (!ff && ft) {
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_I2F, ir_ty_of(to), d, v, 0, 0, 0);
        /* 64 位无符号源：cvtsi2sd 按有符号读会算出负数，后端要走移位套路 */
        if (ty_size(from) >= 8 && !ty_is_signed(from))
            FN.ops[FN.n - 1].flags |= 1;
        return d;
    }
    if (ff && !ft) {
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_F2I, ir_ty_of(from), d, v, 0, 0, 0);
        if (ty_is_int(to) && ty_size(to) >= 8 && !ty_is_signed(to))
            FN.ops[FN.n - 1].flags |= 1;
        if (ty_is_int(to) && ty_size(to) < 8) {
            u32 t2 = irfn_vreg(&FN);

            irfn_push(&FN, IR_TRUNC, ir_ty_of(to), t2, d, 0, 0, 0);
            d = t2;
        }
        return d;
    }
    if (ty_is_int(to) && ty_size(to) < 8) {
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_TRUNC, ir_ty_of(to), d, v, 0, 0, 0);
        return d;
    }
    return v;
}

/* 二元运算：a op b。先各做整型提升，再取宽者（同宽时无符号胜出） */
static u32 gen_bin2(u32 a, u32 aty, u8 op, u32 b, u32 bty)
{
    u32 d = irfn_vreg(&FN);
    u32 ty = 0;

    /* 二元运算的结果不是空指针常量（`i * 0` 也不是） */
    E_NPC = 0;

    if (ty_is_float(aty) || ty_is_float(bty)) {
        /* 浮点：任一操作数是 double 就按 double；两边先转成公共类型再算 */
        ty = (ty_size(aty) >= 8 || ty_size(bty) >= 8) ? ty_double() : ty_float();
        if (op == IR_ADD)
            op = IR_FADD;
        else if (op == IR_SUB)
            op = IR_FSUB;
        else if (op == IR_MUL)
            op = IR_FMUL;
        else if (op == IR_DIV)
            op = IR_FDIV;
        a = gen_convert(a, aty, ty);
        b = gen_convert(b, bty, ty);
        irfn_push(&FN, op, ir_ty_of(ty), d, a, b, 0, 0);
        GEN_TY = ty;
        return d;
    }
    aty = ty_promote(aty);
    bty = ty_promote(bty);
    ty = ty_size(aty) >= ty_size(bty) ? aty : bty;
    if (ty_size(aty) == ty_size(bty)) {
        /* 同宽时无符号吸收有符号（`0 - 0x80000002u` 是 unsigned，不是 int） */
        if (!ty_is_signed(aty))
            ty = aty;
        else if (!ty_is_signed(bty))
            ty = bty;
    }
    irfn_push(&FN, op, ir_ty_of(ty), d, a, b, 0, 0);
    /* 窄于 8 字节的整数运算要按类型宽度回绕（unsigned 取模 2^n 的语义）。
     * 少了它，`-(UINT_MAX/2+3)/2` 会拿 64 位中间值去除，结果高 32 位是垃圾。 */
    if (ty_is_int(ty) && ty_size(ty) < 8) {
        u32 t2 = irfn_vreg(&FN);

        irfn_push(&FN, IR_TRUNC, ir_ty_of(ty), t2, d, 0, 0, 0);
        d = t2;
    }
    /* 两边都是编译期整型常量就折一下值，并据此定"是不是空指针常量"。
     * 只影响 CV_* 那张表和 E_NPC，IR 照常发（后端怎么算都不亏）。 */
    {
        u64 ca = 0;
        u64 cb = 0;
        u64 cr = 0;

        if (cv_get(a, &ca) && cv_get(b, &cb) && cv_fold(op, ca, cb, ty, &cr)) {
            cr = cv_fit(cr, ty);
            cv_set(d, cr);
            E_NPC = (cr == 0);
        }
    }
    GEN_TY = ty;
    return d;
}

/* 按运算类型归一化一个操作数：窄于 8 字节要重扩一次高低位。
 * 少了这一步，(int)-1 == 0xFFFFFFFFu 会变成 0xFFFFFFFFFFFFFFFF vs
 * 0x00000000FFFFFFFF —— 两个槽里的值不等，比较结果就错（踩过）。 */
static u32 gen_cast_to(u32 v, u32 ty)
{
    u32 d = 0;

    if (ty_size(ty) >= 8)
        return v;
    d = irfn_vreg(&FN);
    irfn_push(&FN, IR_TRUNC, ir_ty_of(ty), d, v, 0, 0, 0);
    return d;
}

/* 比较用"同级无符号吸收有符号"的规则挑公共类型 */
static u32 cmp_common_ty(u32 aty, u32 bty)
{
    if (ty_is_float(aty) || ty_is_float(bty))
        return (ty_size(aty) >= 8 || ty_size(bty) >= 8) ? ty_double() : ty_float();
    aty = ty_promote(aty);
    bty = ty_promote(bty);
    if (ty_size(aty) > ty_size(bty))
        return aty;
    if (ty_size(bty) > ty_size(aty))
        return bty;
    return ty_is_signed(aty) ? bty : aty;
}

static u32 gen_cmp3(u32 a, u32 aty, u32 b, u32 bty, u8 cc, u32 cty)
{
    u32 d = 0;
    u64 cva = 0, cvb = 0;
    int ka = cv_get(a, &cva), kb = cv_get(b, &cvb);

    if (ty_is_float(cty)) {
        /* 浮点比较：**浮点**操作数要先转成公共宽度，不能只截位。以前这里和
         * 整数一样走 gen_cast_to（只砍整数高位的），于是
         * `float f = 46.0f; f != 46.0` 拿 f32 的位模式（0x42380000）当 f64
         * 去和 46.0 比，恒为真——tests2/144_tls 的 `errors: 1` 就是它。
         * 整数那边**不动**：c6c 自己有个约定，通用 `task` 句柄的 `t->val`
         * 是按 long 读出来的裸位模式，和浮点字面量比时正好按位对上；改成
         * 整数转浮点会把它算成 4.6e18（tests/async.c6 会挂）。 */
        /* 整数那侧以前走 gen_cast_to（只砍整数高位），是给"通用 task 句柄的
         * `t->val` 按位和浮点字面量比"留的偏门；副作用是 `double h; h > 1`
         * 把 h 的**位模式**当整数和 1 比，恒为真——std-geo 的距离、包围盒判断
         * 全错（`if (h > 1) h = 1` 把 haversine 结果夹成 1，距离恒为 20015 km）。
         * 按标准语义把整数转成浮点再比。 */
        a = gen_convert(a, aty, cty);
        b = gen_convert(b, bty, cty);
    } else {
        a = gen_cast_to(a, cty);
        b = gen_cast_to(b, cty);
    }
    d = irfn_vreg(&FN);
    /* 浮点比较要知道宽度，才能选 ucomiss 还是 ucomisd */
    if (ty_is_float(cty))
        irfn_push(&FN, IR_CMP, ir_ty_of(cty), d, a, b, 0, cc);
    else
        irfn_push(&FN, IR_CMP, IRT_U64, d, a, b, 0, cc);
    irfn_setcc(&FN, cc);
    /* 常量比较也要进 CV_* 表：`__is_constexpr()` 里 `((typeof(u32))(-1)) < 1`
     * 这类比较是编译期常量，折不出来就整条认成运行期值、三元式落 void*，
     * 内核 reg_bits.h 的 GENMASK 断言全挂（和 ir.c6 的 IR_CMP 折叠同口径）。 */
    if (ka && kb && !ty_is_float(cty)) {
        i64 sa = (i64)cva, sb = (i64)cvb;
        u64 r = 0;

        switch (cc) {
        case IRCC_EQ: r = cva == cvb; break;
        case IRCC_NE: r = cva != cvb; break;
        case IRCC_LT: r = sa < sb; break;
        case IRCC_LE: r = sa <= sb; break;
        case IRCC_GT: r = sa > sb; break;
        case IRCC_GE: r = sa >= sb; break;
        case IRCC_ULT: r = cva < cvb; break;
        case IRCC_ULE: r = cva <= cvb; break;
        case IRCC_UGT: r = cva > cvb; break;
        case IRCC_UGE: r = cva >= cvb; break;
        default: break;
        }
        cv_set(d, r);
        E_NPC = (r == 0);
    }
    GEN_TY = ty_int();
    return d;
}

static u32 gen_cmp2(u32 a, u32 b, u8 cc)
{
    u32 d = irfn_vreg(&FN);

    irfn_push(&FN, IR_CMP, IRT_U64, d, a, b, 0, cc);
    irfn_setcc(&FN, cc);
    GEN_TY = ty_int();
    return d;
}

/* --- 复数的值运算 ---------------------------------------------------------
 * 聚合的约定是"值 = 地址"，所以每次运算开一块帧槽当临时对象，两个分量分别
 * 算好再存回去。分量运算是普通的 f32/f64 加减乘除和转换，走 gen_bin2 /
 * gen_convert —— 三个后端本来就处理这些，不需要任何新 IR。
 *
 * 分量布局就是 `__c6_cplx_*` 的 `{__re, __im}`：实部在 0，虚部在 sizeof(分量)。 */
static u32 cplx_temp(u32 cty)
{
    u32 sz = ty_size(cty) ? ty_size(cty) : 16;
    u32 slot = frame_slots_for(sz);
    u32 addr = irfn_vreg(&FN);

    irfn_push(&FN, IR_ADDR, IRT_PTR, addr, 0, 0, 0, X64_SLOT(slot));
    return addr;
}

static u32 cplx_load(u32 addr, u32 ct, u32 off)
{
    return load_lval(gen_addr_off(addr, off), ct);
}

static void cplx_store(u32 addr, u32 ct, u32 off, u32 v)
{
    store_lval(gen_addr_off(addr, off), ct, v);
}

static u32 cplx_zero(u32 ct)
{
    return gen_convert(gen_int_lit(0, ty_int()), ty_int(), ct);
}

/* 实数 → 复数：`{v, 0}` */
static u32 cplx_from_real(u32 v, u32 vty, u32 cty)
{
    u32 ct = cplx_comp(cty);
    u32 addr = cplx_temp(cty);

    if (vty != ct)
        v = gen_convert(v, vty, ct);
    cplx_store(addr, ct, 0, v);
    cplx_store(addr, ct, ty_size(ct), cplx_zero(ct));
    GEN_TY = cty;
    return addr;
}

/* `a op b`（op = IR_ADD / IR_SUB / IR_MUL / IR_DIV）。一边是实数就先提升成
 * 复数（C99 6.3.1.8 的常用算术转换）。返回临时对象的地址。 */
static u32 cplx_bin(u8 op, u32 a, u32 aty, u32 b, u32 bty)
{
    u32 cty = ty_is_cplx(aty) ? aty : bty;
    u32 ct = cplx_comp(cty);
    u32 csz = ty_size(ct);
    u32 out = 0;
    u32 ar = 0;
    u32 ai = 0;
    u32 br = 0;
    u32 bi = 0;

    if (!ty_is_cplx(aty))
        a = cplx_from_real(a, aty, cty);
    if (!ty_is_cplx(bty))
        b = cplx_from_real(b, bty, cty);
    ar = cplx_load(a, ct, 0);
    ai = cplx_load(a, ct, csz);
    br = cplx_load(b, ct, 0);
    bi = cplx_load(b, ct, csz);
    out = cplx_temp(cty);
    if (op == IR_ADD || op == IR_SUB) {
        cplx_store(out, ct, 0, gen_bin2(ar, ct, op, br, ct));
        cplx_store(out, ct, csz, gen_bin2(ai, ct, op, bi, ct));
    } else if (op == IR_MUL) {
        /* (ar+ai i)(br+bi i) = (ar*br - ai*bi) + (ar*bi + ai*br) i */
        u32 t1 = gen_bin2(ar, ct, IR_MUL, br, ct);
        u32 t2 = gen_bin2(ai, ct, IR_MUL, bi, ct);
        u32 t3 = gen_bin2(ar, ct, IR_MUL, bi, ct);
        u32 t4 = gen_bin2(ai, ct, IR_MUL, br, ct);

        cplx_store(out, ct, 0, gen_bin2(t1, ct, IR_SUB, t2, ct));
        cplx_store(out, ct, csz, gen_bin2(t3, ct, IR_ADD, t4, ct));
    } else {
        /* 除法按 C99 6.5.5p5 的公式：分母 br²+bi² */
        u32 den = 0;
        u32 nr = 0;
        u32 ni = 0;

        den = gen_bin2(gen_bin2(br, ct, IR_MUL, br, ct), ct, IR_ADD,
                       gen_bin2(bi, ct, IR_MUL, bi, ct), ct);
        nr = gen_bin2(gen_bin2(ar, ct, IR_MUL, br, ct), ct, IR_ADD,
                      gen_bin2(ai, ct, IR_MUL, bi, ct), ct);
        ni = gen_bin2(gen_bin2(ai, ct, IR_MUL, br, ct), ct, IR_SUB,
                      gen_bin2(ar, ct, IR_MUL, bi, ct), ct);
        cplx_store(out, ct, 0, gen_bin2(nr, ct, IR_DIV, den, ct));
        cplx_store(out, ct, csz, gen_bin2(ni, ct, IR_DIV, den, ct));
    }
    GEN_TY = cty;
    return out;
}

/* 复数比较（只允许 == / !=）：两个分量都比，再与起来。 */
static u32 cplx_cmp(u8 cc, u32 a, u32 aty, u32 b, u32 bty)
{
    u32 cty = ty_is_cplx(aty) ? aty : bty;
    u32 ct = cplx_comp(cty);
    u32 csz = ty_size(ct);
    u32 r1 = 0;
    u32 r2 = 0;

    if (!ty_is_cplx(aty))
        a = cplx_from_real(a, aty, cty);
    if (!ty_is_cplx(bty))
        b = cplx_from_real(b, bty, cty);
    r1 = gen_cmp3(cplx_load(a, ct, 0), ct, cplx_load(b, ct, 0), ct, cc, ct);
    r2 = gen_cmp3(cplx_load(a, ct, csz), ct, cplx_load(b, ct, csz), ct, cc, ct);
    GEN_TY = ty_int();
    /* `==` 要两个分量都相等（与）；`!=` 只要有一个不等（或）。
     * 两边都用"与"的话 `w != z` 只在两个分量的不等同时成立时才真（踩过）。 */
    return gen_bin2(r1, ty_int(), cc == IRCC_NE ? IR_OR : IR_AND, r2, ty_int());
}

/* 一元负号：两个分量都取反 */
static u32 cplx_neg(u32 a, u32 cty)
{
    u32 ct = cplx_comp(cty);
    u32 csz = ty_size(ct);
    u32 out = cplx_temp(cty);

    {
        u32 d = irfn_vreg(&FN);

        irfn_push(&FN, IR_FNEG, ir_ty_of(ct), d, cplx_load(a, ct, 0), 0, 0, 0);
        cplx_store(out, ct, 0, d);
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_FNEG, ir_ty_of(ct), d, cplx_load(a, ct, csz), 0, 0, 0);
        cplx_store(out, ct, csz, d);
    }
    GEN_TY = cty;
    return out;
}

static u32 gen_mul(void)
{
    u32 a = gen_unary();
    u32 aty = cur_op_ty();

    for (;;) {
        if (pa_accept_ch('*')) {
            u32 av = value_of(a);
            u32 b = value_of(gen_unary());
            u32 bty = GEN_TY;

            if (ty_is_cplx(aty) || ty_is_cplx(bty))
                a = cplx_bin(IR_MUL, av, aty, b, bty);
            else
                a = gen_bin2(av, aty, IR_MUL, b, bty);
            aty = GEN_TY;
        } else if (pa_accept_ch('/')) {
            u32 av = value_of(a);
            u32 aty2 = ty_promote(aty);
            u32 b = value_of(gen_unary());
            u32 bty = GEN_TY;
            u32 bty2 = ty_promote(GEN_TY);
            /* 走 idiv 还是 div，要看**转换之后**的公共类型有没有符号：
             * C99 6.3.1.8 规定"unsigned int 能装进 long 就转成 long"，
             * 所以 `long / unsigned int` 是有符号除法。以前按"任一操作数无
             * 符号就无符号"判，`long l = -2; unsigned u = 2; l / u` 算成
             * 9223372036854775807（`%` 同理）。 */
            u32 cty2 = cmp_common_ty(aty2, bty2);
            u8 op = (ty_is_float(cty2) || ty_is_signed(cty2)) ? IR_DIV : IR_UDIV;

            if (ty_is_cplx(aty2) || ty_is_cplx(bty2))
                a = cplx_bin(IR_DIV, av, aty2, b, bty2);
            else
                a = gen_bin2(av, aty2, op, b, bty2);
            aty = GEN_TY;
        } else if (pa_accept_ch('%')) {
            u32 av = value_of(a);
            u32 aty2 = ty_promote(aty);
            u32 b = value_of(gen_unary());
            u32 bty2 = ty_promote(GEN_TY);
            u32 cty2 = cmp_common_ty(aty2, bty2);
            /* 同上：`%` 的有符号性也看转换后的公共类型 */
            u8 op = (ty_is_float(cty2) || ty_is_signed(cty2)) ? IR_MOD : IR_UMOD;

            a = gen_bin2(av, aty2, op, b, bty2);
            aty = GEN_TY;
        } else {
            return a;
        }
    }
}

static u32 gen_add(void)
{
    u32 a = gen_mul();
    u32 aty = cur_op_ty();

    for (;;) {
        int is_sub = 0;
        u32 av = 0;
        u32 b = 0;
        u32 bty = 0;

        if (pa_accept_ch('+')) {
            is_sub = 0;
        } else if (pa_accept_ch('-')) {
            is_sub = 1;
        } else {
            return a;
        }
        av = value_of(a);
        b = value_of(gen_mul());
        bty = GEN_TY;
        {
            u32 d = irfn_vreg(&FN);
            int aptr = ty_is_ptr(aty) || ty_is_array(aty);
            int bptr = ty_is_ptr(bty) || ty_is_array(bty);

            if (ty_is_cplx(aty) || ty_is_cplx(bty)) {
                /* 复数加减：分量各自加减（一边是实数就先提升） */
                a = cplx_bin(is_sub ? IR_SUB : IR_ADD, av, aty, b, bty);
                aty = GEN_TY;
            } else if (aptr && !bptr) {
                /* 指针 + 整数：按元素大小缩放 */
                u32 elem = ty_target(aty);
                u32 esz = ty_size(elem);
                u32 bv = b;

                if (esz > 1) {
                    u32 k = irfn_vreg(&FN);
                    u32 s = irfn_vreg(&FN);

                    irfn_push(&FN, IR_CONST, IRT_U64, k, 0, 0, 0, esz);
                    irfn_push(&FN, IR_MUL, IRT_U64, s, b, k, 0, 0);
                    bv = s;
                }
                irfn_push(&FN, is_sub ? IR_SUB : IR_ADD, IRT_PTR, d, av, bv,
                          0, 0);
                aty = ty_ptr(elem);
                GEN_TY = aty;
                a = d;
            } else if (aptr && bptr && is_sub) {
                /* 指针差：字节差 / 元素大小 */
                u32 esz = ty_size(ty_target(aty));

                irfn_push(&FN, IR_SUB, IRT_U64, d, av, b, 0, 0);
                if (esz > 1) {
                    u32 k = irfn_vreg(&FN);

                    irfn_push(&FN, IR_CONST, IRT_U64, k, 0, 0, 0, esz);
                    irfn_push(&FN, IR_DIV, IRT_I64, d, d, k, 0, 0);
                }
                aty = ty_long();
                GEN_TY = aty;
                a = d;
            } else {
                a = gen_bin2(av, aty, is_sub ? IR_SUB : IR_ADD, b, bty);
                aty = GEN_TY;
            }
        }
    }
}

/* 移位的特例：**结果类型只由左操作数的提升决定**，移位次数不参与"取宽"
 * （C99 6.5.7#3）。以前走 gen_bin2 的公共类型规则，`(short)1 << (unsigned)1`
 * 会被判成 unsigned，`(short)1 << (long)1` 会变成 long（踩过 55_lshift_type）。 */
static u32 gen_shift_one(u32 a, u32 aty, u8 op, u32 b)
{
    u32 d = irfn_vreg(&FN);

    irfn_push(&FN, op, ir_ty_of(aty), d, a, b, 0, 0);
    if (ty_is_int(aty) && ty_size(aty) < 8) {
        u32 t2 = irfn_vreg(&FN);

        irfn_push(&FN, IR_TRUNC, ir_ty_of(aty), t2, d, 0, 0, 0);
        d = t2;
    }
    /* 移位结果也要进 CV_* 编译期常量表。否则 `1u << 7` 这类常量被当成
     * 运行期值：`__is_constexpr()` 里 `(long)(x) * 0l` 折不出 0，空指针常量
     * 判不出来，三元式类型落到 void*，内核 reg_bits.h 的 GENMASK 常量断言
     * 一律失败（i915 display 十几个 TU 编不过）。和 gen_bin2 同口径。 */
    {
        u64 ca = 0, cb = 0, cr = 0;

        if (cv_get(a, &ca) && cv_get(b, &cb) && cv_fold(op, ca, cb, aty, &cr))
            cv_set(d, cv_fit(cr, aty));
    }
    GEN_TY = aty;
    return d;
}

static u32 gen_shift(void)
{
    u32 a = gen_add();
    u32 aty = cur_op_ty();

    for (;;) {
        if (pa_accept_punct("<<")) {
            u32 aty2 = ty_promote(aty);
            u32 av = value_of(a);
            u32 b = value_of(gen_add());

            a = gen_shift_one(av, aty2, IR_SHL, b);
            aty = GEN_TY;
        } else if (pa_accept_punct(">>")) {
            /* 无符号用逻辑右移，有符号用算术右移；左操作数先做整型提升 */
            u32 aty2 = ty_promote(aty);
            u8 op = ty_is_signed(aty2) ? IR_SAR : IR_SHR;
            u32 av = value_of(a);
            u32 b = value_of(gen_add());

            a = gen_shift_one(av, aty2, op, b);
            aty = GEN_TY;
        } else {
            return a;
        }
    }
}

static u32 gen_rel(void)
{
    u32 a = gen_shift();
    u32 aty = cur_op_ty();

    for (;;) {
        u8 cc = 0;
        u8 ucc = 0;

        if (pa_accept_punct("<=")) {
            cc = IRCC_LE;
            ucc = IRCC_ULE;
        } else if (pa_accept_punct(">=")) {
            cc = IRCC_GE;
            ucc = IRCC_UGE;
        } else if (pa_accept_ch('<')) {
            cc = IRCC_LT;
            ucc = IRCC_ULT;
        } else if (pa_accept_ch('>')) {
            cc = IRCC_GT;
            ucc = IRCC_UGT;
        } else {
            return a;
        }
        {
            u32 av = value_of(a);
            u32 b = value_of(gen_shift());
            u32 cty = cmp_common_ty(aty, GEN_TY);

            /* 无符号操作数必须用无符号条件码。用有符号的 jle/jl 会把
             * 0xcbf2... 当负数（u64 <= 0xFFFFFFFF 恒真，踩过这个坑）。 */
            if (!ty_is_float(cty) && !ty_is_signed(cty))
                cc = ucc;
            a = gen_cmp3(av, aty, b, GEN_TY, cc, cty);
            aty = GEN_TY;
        }
    }
}

static u32 gen_eq(void)
{
    u32 a = gen_rel();
    u32 aty = cur_op_ty();

    for (;;) {
        u8 cc = 0;

        if (pa_accept_punct("=="))
            cc = IRCC_EQ;
        else if (pa_accept_punct("!="))
            cc = IRCC_NE;
        else
            return a;
        {
            u32 aty2 = aty;
            u32 av = value_of(a);
            u32 b = value_of(gen_rel());
            u32 bty2 = GEN_TY;

            if (ty_is_cplx(aty2) || ty_is_cplx(bty2)) {
                /* C99 6.5.9p2：复数只有 == 和 !=，两个分量都得相等 */
                a = cplx_cmp(cc, av, aty2, b, bty2);
            } else {
                u32 cty = cmp_common_ty(aty2, bty2);

                a = gen_cmp3(av, aty2, b, bty2, cc, cty);
            }
            aty = GEN_TY;
        }
    }
}

static u32 gen_bitand(void)
{
    u32 a = gen_eq();
    u32 aty = cur_op_ty();

    while (pa_accept_ch('&')) {
        u32 av = value_of(a);
        u32 b = value_of(gen_eq());

        a = gen_bin2(av, aty, IR_AND, b, GEN_TY);
        aty = GEN_TY;
    }
    return a;
}

static u32 gen_bitxor(void)
{
    u32 a = gen_bitand();
    u32 aty = cur_op_ty();

    while (pa_accept_ch('^')) {
        u32 av = value_of(a);
        u32 b = value_of(gen_bitand());

        a = gen_bin2(av, aty, IR_XOR, b, GEN_TY);
        aty = GEN_TY;
    }
    return a;
}

static u32 gen_bitor(void)
{
    u32 a = gen_bitxor();
    u32 aty = cur_op_ty();

    while (pa_accept_ch('|')) {
        u32 av = value_of(a);
        u32 b = value_of(gen_bitxor());

        a = gen_bin2(av, aty, IR_OR, b, GEN_TY);
        aty = GEN_TY;
    }
    return a;
}

/* && / || 必须短路：用分支产生 0/1，不能改成位运算（右侧副作用会被多算一遍） */
static u32 gen_land(void)
{
    u32 a = gen_bitor();

    while (pa_accept_punct("&&")) {
        u32 ltest = irfn_label(&FN);
        u32 lfalse = irfn_label(&FN);
        u32 ltrue = irfn_label(&FN);
        u32 ldone = irfn_label(&FN);
        u32 d = irfn_vreg(&FN);
        u32 av = value_of(a);
        u32 b = 0;

        irfn_push(&FN, IR_BR, IRT_VOID, 0, av, ltest, lfalse, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ltest, 0, 0, 0);
        b = value_of(gen_bitor());
        irfn_push(&FN, IR_BR, IRT_VOID, 0, b, ltrue, lfalse, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ltrue, 0, 0, 0);
        irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, 1);
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, ldone, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lfalse, 0, 0, 0);
        irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ldone, 0, 0, 0);
        a = d;
        GEN_TY = ty_int();
    }
    return a;
}

static u32 gen_lor(void)
{
    u32 a = gen_land();

    while (pa_accept_punct("||")) {
        u32 ltest = irfn_label(&FN);
        u32 lfalse = irfn_label(&FN);
        u32 ltrue = irfn_label(&FN);
        u32 ldone = irfn_label(&FN);
        u32 d = irfn_vreg(&FN);
        u32 av = value_of(a);
        u32 b = 0;

        irfn_push(&FN, IR_BR, IRT_VOID, 0, av, ltrue, ltest, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ltest, 0, 0, 0);
        b = value_of(gen_land());
        irfn_push(&FN, IR_BR, IRT_VOID, 0, b, ltrue, lfalse, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ltrue, 0, 0, 0);
        irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, 1);
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, ldone, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lfalse, 0, 0, 0);
        irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ldone, 0, 0, 0);
        a = d;
        GEN_TY = ty_int();
    }
    return a;
}

/* 三元表达式的**结果类型**（C11 6.5.15 的简化版）：两支同类型、指针/指针、
 * 指针/空指针常量、浮点、整数提升各来一条。c6c 以前直接用"then 支"的类型，
 * 于是 `fp ? 0L : (void)0` 的类型被算成 long，`_Generic(…, void*: …)` 匹配不上
 * （tcc tests2 的 33_ternary_op / 94_generic）。 */
static u32 ty_ternary(u32 a, u32 b, int anpc, int bnpc)
{
    if (a == b)
        return a;
    /* tcc 口径诊断：一支是指针、另一支是普通整数（且不是空指针常量）时
     * 告警但照常合并类型（tests2/33_ternary_op.expect 第一行逐字要它）。
     * void 表达式（`fp?0L:(void)0`）不算；c6 TU 自有诊断口径，不打这条。 */
    if (!in_c6_tu()) {
        /* 函数设计ator（`f`）在 ?: 里算指针侧，和 `&f` 一样。 */
        int ap = ty_is_ptr(a) || ty_is_func(a);
        int bp = ty_is_ptr(b) || ty_is_func(b);

        if (ap && !bp && b != ty_void() && !bnpc)
            pa_warn_tcc("pointer/integer mismatch in conditional expression");
        else if (bp && !ap && a != ty_void() && !anpc)
            pa_warn_tcc("pointer/integer mismatch in conditional expression");
    }
    if (ty_is_ptr(a) && ty_is_ptr(b)) {
        u32 ta = ty_target(a);
        u32 tb = ty_target(b);
        int va = (ta == ty_void());
        int vb = (tb == ty_void());
        u8 q = (u8)(TY_AT(ta)->qual | TY_AT(tb)->qual);

        /* 一边是 `void*`：那半是**空指针常量**时结果取另一边，否则按 C11
         * 6.5.15p6 取 `void*`——限定符要**并起来**（`(int volatile*)0` 和
         * `(void const*)1` 合出来是 `void const volatile*`）。 */
        if (va != vb) {
            if (va && anpc)
                return b;
            if (vb && bnpc)
                return a;
            return ty_ptr(ty_qual(ty_void(), q));
        }
        /* 指向**数组**的指针：一边不完整（`int (*)[]`）另一边完整时，结果取
         * 补全的那一边（C11 6.2.7 的组合类型规则，tcc tests2 的 94_generic
         * 有两条专门查这个）。 */
        if (ty_is_array(ta) && ty_is_array(tb) && ty_target(ta) == ty_target(tb)) {
            u32 na = ty_array_n(ta);
            u32 nb = ty_array_n(tb);

            if (na == 0 && nb != 0)
                return b;
            if (nb == 0 && na != 0)
                return a;
        }
        /* 两边都指向同一族对象类型：限定符取并集 */
        if (q) {
            u32 base = (va && vb) ? ty_void()
                                  : (ty_size(ta) >= ty_size(tb) ? ta : tb);
            u32 u = ty_unqual(base);

            return ty_ptr(ty_qual(u, (u8)(q | TY_AT(u)->qual)));
        }
        return a;
    }
    if (ty_is_ptr(a))
        return a;
    if (ty_is_ptr(b))
        return b;
    /* 一支是 void 表达式（`(void)0`）时结果就是 void（C11 6.5.15 最后一条） */
    if (a == ty_void() || b == ty_void())
        return ty_void();
    if (ty_is_float(a) || ty_is_float(b)) {
        if (ty_is_float(a) && ty_is_float(b))
            return ty_size(a) >= ty_size(b) ? a : b;
        return ty_is_float(a) ? a : b;
    }
    if (ty_size(a) != ty_size(b))
        return ty_size(a) > ty_size(b) ? a : b;
    if (!ty_is_signed(a))
        return a;
    return b;
}

/* 切片的 len 在切片对象 +8 处（`IR_LOAD` 的发射器不看 imm，所以先 LEA 再 LOAD）。 */
static u32 slice_len_load(u32 sadd)
{
    u32 la = irfn_vreg(&FN);
    u32 lv = irfn_vreg(&FN);

    irfn_push(&FN, IR_LEA, IRT_PTR, la, sadd, 0, 0, 8);
    irfn_push(&FN, IR_LOAD, IRT_U64, lv, la, 0, 0, 0);
    return lv;
}

static u32 gen_cond(void)
{
    u32 c = 0;

    E_CALL_FALLIBLE = 0;
    c = gen_lor();

    /* c6 的错误处理后缀：`expr catch [e] { … }`。expr 给的是错误 id（0 = 成功）；
     * 非 0 时把 id 绑到 `e.id` 再跑块。块的语义是"就地处理"，整体值仍是 id。 */
    if (PA_IN_DROP && PA_IS_IDENT("catch") && pa_peek(1))
        pa_error("'drop' 不能失败：它在对象释放时跑，错误没处去");
    if (PA_IN_DEFER && PA_IS_IDENT("catch") && pa_peek(1))
        pa_error("'catch' 不能出现在 defer 体里");
    if (PA_IS_IDENT("catch") && c6_kw() && pa_peek(1) && E_CALL_FALLIBLE == 2)
        pa_error("'catch' requires a call to a function returning 'T!error'");
    while (PA_IS_IDENT("catch") && c6_kw() && pa_peek(1)
           && (pa_peek(1)->kind == TK_IDENT || TOK_EQ(pa_peek(1), "{")
               || tok_eq(pa_peek(1), "("))
           && (pa_peek(1)->kind != TK_IDENT || pa_peek(2))
           && (pa_peek(1)->kind != TK_IDENT || TOK_EQ(pa_peek(2), "{"))) {
        u32 v0 = value_of(c);
        u32 vty = GEN_TY;              /* catch 不影响表达式的类型（可能是 double） */
        u32 lbody = irfn_label(&FN);
        u32 lend = irfn_label(&FN);

        pa_advance();                          /* catch */
        /* 判据是运行时的**错误标志**，不是表达式的值：`half(8)` 这种正常返回
         * 一个非 0 值的调用以前会被当成"出错"，catch 体就跑起来了。 */
        {
            u32 fl = irfn_vreg(&FN);

            irfn_push(&FN, IR_CALL, IRT_I32, fl, 0, 0, 0,
                      x64_sym(&X64, "__tcc_err_flag_get"));
            FN.ops[FN.n - 1].narg = 0;
            irfn_push(&FN, IR_BR, IRT_VOID, 0, fl, lbody, lend, 0);
        }
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lbody, 0, 0, 0);
        scope_enter();
        if (pa_is_ch('(')) {
            /* `catch (e) { … }`：括号包着的绑定 */
            pa_advance();
            if (pa_cur()->kind == TK_IDENT) {
                Sym *e = sym_add(tok_data(pa_cur()), pa_cur()->len, ty_errpay(), SC_LOCAL);
                u32 slot = frame_slots_for(16);
                u32 addr = irfn_vreg(&FN);
                Sym *gm = sym_find("c6c_err_msg", 11);

                u32 idv = irfn_vreg(&FN);

                pa_advance();
                e->slot = slot;
                irfn_push(&FN, IR_CALL, IRT_I32, idv, 0, 0, 0,
                          x64_sym(&X64, "__tcc_err_id_get"));
                FN.ops[FN.n - 1].narg = 0;
                irfn_push(&FN, IR_ADDR, IRT_PTR, addr, 0, 0, 0, X64_SLOT(slot));
                irfn_push(&FN, IR_STORE, IRT_I32, addr, idv, 0, 0, 0);
                if (gm) {
                    u32 mv = irfn_vreg(&FN);
                    u32 a8 = gen_addr_off(addr, 8);

                    irfn_push(&FN, IR_LOAD, IRT_PTR, mv, ident_addr(gm), 0, 0, 0);
                    store_conv(a8, ty_ptr(ty_char()), mv, ty_ptr(ty_char()));
                }
            }
            pa_expect_ch(')');
        }
        if (pa_cur()->kind == TK_IDENT) {
            Sym *e = sym_add(tok_data(pa_cur()), pa_cur()->len, ty_errpay(), SC_LOCAL);
            u32 slot = frame_slots_for(16);
            u32 addr = irfn_vreg(&FN);
            u32 idv = irfn_vreg(&FN);

            pa_advance();
            e->slot = slot;
            irfn_push(&FN, IR_CALL, IRT_I32, idv, 0, 0, 0,
                      x64_sym(&X64, "__tcc_err_id_get"));
            FN.ops[FN.n - 1].narg = 0;
            irfn_push(&FN, IR_ADDR, IRT_PTR, addr, 0, 0, 0, X64_SLOT(slot));
            irfn_push(&FN, IR_STORE, IRT_I32, addr, idv, 0, 0, 0);
            {
                /* 消息从运行时的错误槽取（`c6c_err_msg` 是运行时 TU 里的
                 * static，主 TU 的符号表里根本没有，以前这里永远取不到）。 */
                u32 mv = irfn_vreg(&FN);
                u32 a8 = gen_addr_off(addr, 8);

                irfn_push(&FN, IR_CALL, IRT_PTR, mv, 0, 0, 0,
                          x64_sym(&X64, "__tcc_err_msg_get"));
                FN.ops[FN.n - 1].narg = 0;
                store_conv(a8, ty_ptr(ty_char()), mv, ty_ptr(ty_char()));
            }
        }
        {
            /* 错误值已经抄进 e.id / e.msg 了，标志要**在跑块之前**清掉：
             * 块里可能 `return`，那之后就不会再回来清了（tests/err.c6 的
             * "调用方处理错误后可以继续"就是被这个挂住的）。 */
            u32 cl = irfn_vreg(&FN);

            irfn_push(&FN, IR_CALL, IRT_VOID, cl, 0, 0, 0,
                      x64_sym(&X64, "__tcc_err_clear"));
            FN.ops[FN.n - 1].narg = 0;
        }
        if (pa_is_ch('{'))
            gen_block();
        else
            pa_error("catch 后面要一个 { … } 块");
        /* catch 体的语义是"就地处理掉错误"：必须以 return / err() / goto
         * 收尾，否则错误被吞掉接着往下跑（tests/errors/try.c6）。 */
        if (!PA_LAST_TERM)
            pa_error("'catch' body must end with 'return', 'err()' or 'goto'");
        scope_leave();
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
        GEN_TY = vty;
        c = v0;
        E_CALL_FALLIBLE = 4;    /* 这一次已经被处理掉了 */
    }

    if (pa_accept_ch('?')) {
        u32 lelse = irfn_label(&FN);
        u32 lthen = irfn_label(&FN);
        u32 lend = irfn_label(&FN);
        u32 d = irfn_vreg(&FN);
        u32 cty = cur_op_ty();
        u32 cv = value_of(c);

        /* 三元的操作数**不是** typeof 的直接操作数了：里的数组/函数指示符
         * 照常退化。`typeof(1?f:f)` 拿到的必须是 `void (*)(void)`——
         * tcc tests2/33_ternary_op.c:20 就靠这一点（外面再套一层 `*` 得到
         * `void (**)(void)`）。NO_DECAY 是 parse_typeof 为**整个**表达式
         * 设的，进到三元里就得关掉。 */
        NO_DECAY = 0;
        u32 t = 0;
        u32 e = 0;
        u32 ty = 0;
        int tnpc = 0;      /* 两支各自是不是空指针常量（决定 void* 那半让不让位） */
        int enpc = 0;

        irfn_push(&FN, IR_BR, IRT_VOID, 0, cv, lthen, lelse, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lthen, 0, 0, 0);
        if (pa_is_ch(':')) {
            /* GNU `a ?: b`：中间项省略，值就是条件表达式的值（只求值一次） */
            t = cv;
            ty = cty;
            pa_advance();
        } else {
            t = value_of(gen_expr());
            ty = GEN_TY;
            tnpc = E_NPC;
            pa_expect_ch(':');
        }
        irfn_push(&FN, IR_MOV, ir_ty_of(ty), d, t, 0, 0, 0);
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, lend, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lelse, 0, 0, 0);
        e = value_of(gen_cond());
        enpc = E_NPC;
        irfn_push(&FN, IR_MOV, ir_ty_of(ty), d, e, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
        /* 结果类型按两支合并（IR 里 d 是 8 字节槽，写进去的位不变） */
        ty = ty_ternary(ty, GEN_TY, tnpc, enpc);
        GEN_TY = ty;
        return d;
    }
    return c;
}
static u32 gen_assign(void)
{
    u32 v = 0;

    E_WAS_CALL = 0;
    E_WAS_ADDR = 0;
    E_WEAK = 0;
    v = gen_cond();

    if (PEND_LVAL && pa_cur()->kind == TK_PUNCT) {
        Tok *t = pa_cur();
        int op = -1;
        u32 addr = PEND_ADDR;
        u32 ty = PEND_TY;
        u32 lv_bits = PEND_BITS;
        u32 lv_bo = PEND_BITOFF;

        if (TOK_EQ(t, "="))
            op = 0;
        else if (TOK_EQ(t, "+="))
            op = IR_ADD;
        else if (TOK_EQ(t, "-="))
            op = IR_SUB;
        else if (TOK_EQ(t, "*="))
            op = IR_MUL;
        else if (TOK_EQ(t, "/="))
            op = IR_DIV;
        else if (TOK_EQ(t, "%="))
            op = IR_MOD;
        else if (TOK_EQ(t, "&="))
            op = IR_AND;
        else if (TOK_EQ(t, "|="))
            op = IR_OR;
        else if (TOK_EQ(t, "^="))
            op = IR_XOR;
        else if (TOK_EQ(t, "<<="))
            op = IR_SHL;
        else if (TOK_EQ(t, ">>="))
            op = IR_SAR;
        if (op >= 0) {
            u32 r = 0;
            int lmgd = PEND_MGD;
            int rmgd = 0;
            Sym *lsym = PEND_MGD_SYM;   /* 左值那个槽（清"已移走"标记要用） */
            char opbuf[8] = {0};

            /* 给只读对象赋值（`int *const p; p = 0;`）：tcc 给一条 warning 后
             * 照常编下去，tests2/149_parameter_qualifier_errors.c 的 .expect
             * 就是那一行。C 里这是约束违背，但上游要的是"警告 + 继续"。 */
            if (PEND_SYM && PEND_SYM->is_const)
                pa_warn_tcc("assignment of read-only location");

            if (t->len < sizeof(opbuf)) {
                memcpy(opbuf, tok_data(t), t->len);
                opbuf[t->len] = 0;
            }
            if (op != 0 && lmgd)
                pa_error("'%s' is not supported for a managed reference", opbuf);
            pa_advance();
            PEND_LVAL = 0;
            PEND_MGD = 0;
            r = gen_assign();
            rmgd = (PEND_LVAL && PEND_MGD);
            /* 按值赋值：两边是同一个"带托管字段的结构体"就是整块拷贝，
             * 拷贝出来的引用不加计数——禁止。（`root->left = move(l)` 这种
             * 左值是托管字段、右值是 `@T` 的，类型不同，不算。） */
            /* 两个不同的聚合体类型之间不能赋值（`Vect@int a = b;` 里 b 是
             * `Vect@char`）——尺寸/布局都不一样
             * （tests/errors/generic.c6 的 test_two_instances）。 */
            if (op == 0 && !lmgd && ty_is_agg(ty) && ty_is_agg(GEN_TY) && ty != GEN_TY
                && !ty_is_iface(ty, NULL) && !ty_is_iface(GEN_TY, NULL)
                && in_c6_tu())
                pa_error("cannot convert '%s' to '%s'", ty_disp(GEN_TY), ty_disp(ty));
            if (op == 0 && !lmgd && GEN_TY == ty && ty_has_mgd(ty)) {
                char dnm[160] = {0};

                agg_disp_name(ty, dnm, sizeof(dnm));
                pa_error("'%s' holds managed references: an assignment is not possible. "
                         "Allocate it with 'new' and hold it in '@%s'", dnm, dnm);
            }
            r = value_of(r);
            /* `>>=` 在无符号左值上要逻辑右移。这里图省事一律记成 IR_SAR，
             * 于是 `u64 v = ~0ull; v >>= 7;` 移完还是全 1（std 的
             * `uvarint_encoded_len` 因此死循环，std-next 整个卡住）。 */
            if (op == IR_SAR && !ty_is_signed(ty))
                op = IR_SHR;
            if (op == 0) {
                /* 托管引用赋值：先给新值加计数，再存，最后放掉旧值。
                 * 这个顺序让 `p = p` 净变化为 0（先 +1 后 -1）。 */
                if (lmgd == 3) {
                    /* 弱槽赋值：只登记，不加计数也不释放旧值 */
                    store_conv(addr, ty, r, GEN_TY);
                    mgd_weak(addr, r);
                } else if (lmgd) {
                    u32 old = load_lval(addr, ty);

                    /* 重新赋值 = 槽里又有了新引用。分支体里的赋值不能保证
                     * 执行到，所以只有直落语句才清标记（tests/errors/gc_move.c6
                     * 的 branch/loop/switch_case 三条）。 */
                    if (lmgd == 1 && lsym && lsym->kind == SC_LOCAL)
                        mv_clear(lsym->slot);
                    /* 托管形参是**借**来的：它不拥有对象，改写它等于让调用方
                     * 的那份引用无处安放（tests/errors/gc_borrow.c6）。 */
                    if (lmgd == 1 && lsym && lsym->kind == SC_PARAM && in_c6_tu())
                        pa_error("'%s@%s' is a borrow: it owns nothing, so it cannot "
                                 "be reassigned", lsym->is_shared ? "shared " : "",
                                 ty_disp(lsym->type));

                    if (rmgd) {
                        if (!mgd_tmp_take(r))
                            mgd_retain(r);
                    } else {
                        (void)mgd_tmp_take(r);
                    }
                    store_conv(addr, ty, r, GEN_TY);
                    mgd_release(old);
                } else if (lv_bits)
                    store_lval_bits(addr, ty, lv_bits, lv_bo, r);
                else
                    store_conv(addr, ty, r, GEN_TY);
            } else {
                u32 old_v = lv_bits ? load_bf(addr, ty, lv_bits, lv_bo,
                                              ty_is_signed(ty), 0)
                                    : load_lval(addr, ty);
                u32 d = 0;

                /* 指针的 `p += n` / `p -= n`：n 要按元素大小缩放（和 p++ 一样） */
                if (ty_is_ptr(ty) && (op == IR_ADD || op == IR_SUB)) {
                    u32 esz = ty_size(ty_target(ty));
                    u32 k = 0;
                    u32 m = 0;

                    if (esz > 1) {
                        k = irfn_vreg(&FN);
                        irfn_push(&FN, IR_CONST, IRT_U64, k, 0, 0, 0, esz);
                        m = irfn_vreg(&FN);
                        irfn_push(&FN, IR_MUL, IRT_U64, m, r, k, 0, 0);
                        r = m;
                    }
                }
                /* 复数复合赋值（`z *= w`）：等价于 `z = z * w`，走 cplx_bin。
                 * gen_bin2 只会按标量算，拿聚合类型下去就是垃圾。
                 * 左操作数是**地址**（聚合的"值"就是它的地址）。 */
                if (ty_is_cplx(ty) || ty_is_cplx(GEN_TY)) {
                    u32 res = 0;

                    if (op != IR_ADD && op != IR_SUB && op != IR_MUL && op != IR_DIV) {
                        pa_error("'%s' is not allowed on complex values", opbuf);
                        return r;
                    }
                    res = cplx_bin((u8)op, addr, ty, r, GEN_TY);
                    store_conv(addr, ty, res, GEN_TY);
                    GEN_TY = ty;
                    return res;
                }
                d = gen_bin2(old_v, ty, (u8)op, r, GEN_TY);

                if (lv_bits)
                    store_lval_bits(addr, ty, lv_bits, lv_bo, d);
                else
                    store_conv(addr, ty, d, GEN_TY);
                r = d;
            }
            GEN_TY = ty;
            return r;
        }
    }
    /* 左值性要**留给上层**：`(*p)++`、`*p = x`、`&*p` 都靠它。
     * 以前在这里无条件 value_of()，把括号里的左值性吃掉了（踩过一次）。 */
    if (PEND_LVAL)
        return v;
    return value_of(v);
}

static u32 gen_expr(void)
{
    u32 v = gen_assign();

    /* 逗号运算符：值取最右操作数（左边只求值） */
    while (pa_accept_ch(',')) {
        v = value_of(gen_assign());
        if (PEND_LVAL) {
            /* 保留左值性：最右操作数是左值时整体也是左值 */
            mark_lval(PEND_ADDR, PEND_TY);
        }
    }
    return v;
}

/* --- 语句 --- */

/* switch：case 值在语体里才出现，分发链却必须放在语体**之前**。
 * 做法是先把语体照常发出去，解析完再往 IR 里"插入"一段比较链。 */
#define SW_MAX 8
/* 内核 arch/x86/entry/syscall_64.c 的 x64_sys_call() 一个 switch 里就有
 * 470+ 个 case（syscalls_64.h），160 装不下、多出来的报"case 只能出现在
 * switch 里"（误导性错误）。给到 1024，并把超限诊断改准确。 */
#define SW_MAXCASE 1024
typedef struct SwCase {
    i64 lo;
    i64 hi;
    u32 lbl;
    u8 is_range;
    u8 is_default;
} SwCase;

typedef struct SwState {
    u32 cv;
    u32 ins_at;
    u32 ncase;
    u32 def_lbl;
    u32 end_lbl;
    u8 has_def;
    SwCase cs[SW_MAXCASE];
} SwState;

static SwState SW[SW_MAX];
static int NSW;
#define PA_MAXLOOP 32
static u32 LOOP_BRK[PA_MAXLOOP];
/* 进每个循环时"最近的 VLA 保存点"：break/continue 要回到这里，
 * 不是回到最内层 if 块——循环体里的 b[f()] 才会每轮复用同一块栈。 */
static u32 LOOP_VLA[PA_MAXLOOP];
static struct Scope *LOOP_BODY[PA_MAXLOOP];   /* 循环体那个块（下一个进来的块） */
static u32 LOOP_CNT[PA_MAXLOOP];
/* 1：这个循环（`for`）自己带一层 init 作用域（深度 LOOP_DFB + 1），break 要
 * 连它一起清理；continue 只清理循环体。其它循环/switch 都是 0。 */
static int LOOP_OWN[PA_MAXLOOP];
/* 1：这一层是 switch（不是循环）。`continue` 在 switch 里要落到**外层循环**
 * 的头上，清理边界也得用外层循环的，不能拿 switch 自己的深度算。 */
static int LOOP_SW[PA_MAXLOOP];
static int NLOOP;

static void gen_stmt(void);
static void gen_block(void);

/* 聚合（数组/结构体）局部对象占多槽：分配 ceil(size/16) 个连续槽，
 * 对象基址取**最后一个**槽（X64_SLOT 是负偏移，最后一个槽地址最低，
 * size ≤ 16k 保证对象整个落在这一段里）。 */
static u32 frame_slots_for(u32 size)
{
    u32 k = (size + 15) / 16;
    u32 first = 0;
    u32 i = 0;

    if (k == 0)
        k = 1;
    first = irfn_vreg(&FN);
    for (i = 1; i < k; i++)
        (void)irfn_vreg(&FN);
    return first + k - 1;
}

/* 跳过聚合初始化器：`{ [designator] expr, ... }`，嵌套按括号配平 */

/* ---------- 聚合初始化器（P3-3b）----------
 * 局部：先把整个对象清零，再按 {…} 里的元素逐个写；
 * 全局：同样的遍历，但值必须是编译期常量，直接写数据段字节。
 * 字符串特例：char a[N] = "abc" 直接搬字面量。 */

static u32 gen_addr_off(u32 addr, u32 off)
{
    u32 c = 0;
    u32 d = 0;

    if (off == 0)
        return addr;
    c = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_U64, c, 0, 0, 0, off);
    d = irfn_vreg(&FN);
    irfn_push(&FN, IR_ADD, IRT_U64, d, addr, c, 0, 0);
    return d;
}

static void gen_zero_obj(u32 addr, u32 sz)
{
    u32 z = 0;

    if (sz == 0)
        return;
    /* IR_MEMSET：dst = 目标地址，a = 填充字节，imm = 字节数 */
    z = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_U64, z, 0, 0, 0, 0);
    irfn_push(&FN, IR_MEMSET, IRT_U8, addr, z, 0, 0, sz);
}


/* ---------- 全局聚合初始化器：纯编译期填字节 ---------- */
/* 全局初始化器里的位域：0 = 不是位域。全局初始化是编译期写数据段，
 * 和运行期的左值状态（PEND_*）无关，所以另开一组全局量。 */
static u32 GLOB_BF_BITS;
static u32 GLOB_BF_BITOFF;

static void data_fixup_drop_range(u32 lo, u32 hi);

static void glob_store(u32 goff, u32 off, u32 ty, u64 v)
{
    u32 sz = ty_size(ty);
    u32 i = 0;

    if (sz > 8)
        sz = 8;
    /* 这个位置后面被直接写了值，前面排队的重定位就作废了。重定位是最后统一
     * 打的补丁，不取消的话会反过来盖掉这里写的值：
     * `{[0 ... 3] = &f, [1] = 0}` 里那个 0 就白写了。两张表都要清：DFIX 是
     * 符号重定位，C99_RLOFF 是数据段内部地址（`[0 ... 3] = "wide"` 再被
     * `[2] = "narrow"` 覆盖时，就会在槽 2 留下一条多余的 C99 重定位）。LLVM
     * 后端把每条重定位排成一个 i64 字段，同偏移留两条会让后面的数据整体错位。 */
    data_fixup_drop_range(goff + off, goff + off + (sz ? sz : 1));
    c99_reloc_drop_range(goff + off, goff + off + (sz ? sz : 1));
    for (i = 0; i < sz; i++)
        DATA_IMG.p[goff + off + i] = (u8)(v >> (8 * i));
    /* 指向数据段内部的绝对地址：C99 后端要按自己的基址重打一遍 */
    if (sz == 8 && v >= (u64)DATA_VA(0) && v < (u64)DATA_VA(DATA_IMG.n))
        c99_reloc_add(goff + off, (u32)(v - (u64)DATA_VA(0)));
}

/* 全局初始化器里的标量常量：走完整的常量表达式链（`A | B`、`sizeof(T)`、
 * 三目都算），而不是只认单个字面量——tcc 的 DWARF 表就是 `VT_LONG | VT_INT`。 */
/* 上一次 parse_const_u64 求出来的值是"符号下标 + 偏移"吗？
 * 整型字段里装地址常量时（`(kernel_ulong_t)(&sym)`）不能把下标当整数落地。 */
static int CONST_LAST_SYM;
static i64 CONST_LAST_ADD;
static int parse_const_u64(u64 *out)
{
    u32 save = PA_ERRS;
    u32 save_sym = CONST_SYM;
    i64 v = 0;

    /* 自己重置再还原：以前不重置，前一次 `&符号` 留下的 CONST_SYM 会一直粘着，
     * 把后面普通的整数初始化器误判成地址常量。 */
    CONST_SYM = 0;
    CONST_SYM_ADD = 0;
    v = const_expr();
    CONST_LAST_SYM = (int)CONST_SYM;
    CONST_LAST_ADD = CONST_SYM_ADD;
    CONST_SYM = save_sym;
    if (PA_ERRS != save)
        return 0;
    *out = (u64)v;
    return 1;
}

static void gen_glob_obj(u32 goff, u32 ty, u32 off);
static void gen_init_obj(u32 addr, u32 ty, u32 off);
static void init_skip_value(void);
static void gen_glob_braced_new(u32 goff, u32 ty, u32 off);
static void gen_local_braced_new(u32 addr, u32 ty, u32 off);
static int pa_is_compound_lit(void);
static u32 gen_addr_off(u32 addr, u32 off);
static void mark_lval(u32 addr, u32 ty);
static int pa_at_typename(void);
static u32 pa_take_paren_type(void);
static int pa_skip_empty_compound(void);
static void data_fixup_add(u32 data_off, u32 sym);
static void data_fixup_add_ex(u32 data_off, u32 sym, i64 add);
static void code_lbl_fixup_add(u32 data_off, u32 fnseq, u32 lbl);
static void data_fixup_drop_range(u32 lo, u32 hi);


/* 编译期把 f32 位模式按 RNE 舍成 bf16 位模式：口径和运行期的
 * bf16_round_bits 完全一致（NaN 保持 quiet、不进位越过指数）。
 * 静态初始化器必须在编译期就落成 2 字节，不能把 f32/double 的低半截写进去。 */
static u32 bf16_bits_of_f32(u32 u)
{
    u32 r = (u32)(((u64)u + 0x7FFFu + ((u >> 16) & 1u)) >> 16);

    if ((u & 0x7F800000u) == 0x7F800000u && (u & 0x007FFFFFu) != 0)
        r = (u >> 16) | 0x40u;
    return r;
}


static void gen_glob_desig_fill(u32 goff, u32 ty, u32 off)
{
    for (;;) {
        if (pa_accept_ch('[')) {
            u32 i = (u32)const_expr();
            u32 et = 0;

            pa_expect_ch(']');
            if (!ty_is_array(ty))
                return;
            et = ty_target(ty);
            if (i >= ty_array_n(ty))
                return;
            ty = et;
            off += i * ty_size(et);
            continue;
        }
        if (pa_accept_ch('.')) {
            const char *nm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
            u32 nl = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
            int idx = 0;

            if (!nm)
                return;
            pa_advance();
            if (!ty_is_agg(ty))
                return;
            {
                u32 mo = 0;

                if (!agg_find_promoted(ty, nm, nl, &ty, &mo)) {
                    pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                    return;
                }
                off += mo;
            }
            continue;
        }
        break;
    }
    pa_expect_ch('=');
    gen_glob_obj(goff, ty, off);
}

static void gen_glob_braced(u32 goff, u32 ty, u32 off)
{
    u32 cur = 0;
    int first = 1;

    if (ty_is_array(ty)) {
        u32 et = ty_target(ty);
        u32 esz = ty_size(et);
        u32 n = ty_array_n(ty);

        for (;;) {
            if (pa_is_ch('}') || pa_cur()->kind == TK_EOF)
                break;
            if (!first && !pa_accept_ch(','))
                break;
            first = 0;
            if (pa_is_ch('}'))
                break;
            if (pa_accept_ch('[')) {
                u32 lo = (u32)const_expr();
                u32 hi = lo;
                u32 k = 0;

                if (pa_accept_punct("..."))
                    hi = (u32)const_expr();
                pa_expect_ch(']');
                if (pa_is_ch('.') || pa_is_ch('[')) {
                    gen_glob_desig_fill(goff, et, off + lo * esz);
                } else {
                    pa_expect_ch('=');
                    for (k = lo; k <= hi && k < n; k++)
                        gen_glob_obj(goff, et, off + k * esz);
                }
                cur = hi + 1;
                continue;
            }
            if (pa_is_ch('.') && ty_is_agg(ty))
                break;
            if (cur >= n) {
                skip_init_list();
                break;
            }
            gen_glob_obj(goff, et, off + cur * esz);
            cur++;
        }
        if (off == 0)
            INIT_COUNT = cur;
        return;
    }
    {
        u32 n = ty_member_n(ty);

        if (n == 0) {
            if (!pa_is_ch('}'))
                gen_glob_obj(goff, ty, off);
            return;
        }
        for (;;) {
            if (pa_is_ch('}') || pa_cur()->kind == TK_EOF)
                break;
            if (!first && !pa_accept_ch(','))
                break;
            first = 0;
            if (pa_is_ch('}'))
                break;
            if (pa_accept_ch('.')) {
                const char *nm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
                u32 nl = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
                int idx = 0;
                u32 mty = 0;
                u32 moff = 0;

                if (!nm) {
                    pa_error("'.' 后面要成员名");
                    break;
                }
                pa_advance();
                if (!agg_find_promoted(ty, nm, nl, &mty, &moff)) {
                    pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                    break;
                }
                idx = agg_find_member(ty, nm, nl);
                if (pa_is_ch('.') || pa_is_ch('[')) {
                    gen_glob_desig_fill(goff, mty, off + moff);
                } else {
                    pa_expect_ch('=');
                    GLOB_BF_BITS = idx >= 0 ? ty_member_bits(ty, (u32)idx) : 0;
                    GLOB_BF_BITOFF = idx >= 0 ? ty_member_bitoff(ty, (u32)idx) : 0;
                    gen_glob_obj(goff, mty, off + moff);
                    GLOB_BF_BITS = 0;
                    GLOB_BF_BITOFF = 0;
                }
                cur = idx >= 0 ? (u32)idx + 1 : 0;
                continue;
            }
            if (cur >= n) {
                skip_init_list();
                break;
            }
            GLOB_BF_BITS = ty_member_bits(ty, cur);
            GLOB_BF_BITOFF = ty_member_bitoff(ty, cur);
            gen_glob_obj(goff, ty_member(ty, cur), off + ty_member_off(ty, cur));
            GLOB_BF_BITS = 0;
            GLOB_BF_BITOFF = 0;
            cur++;
        }
    }
}

/* 初始化器位置上的复合字面量 `(T){ … }` / `((T){ … })`。
 *
 * 前瞻窗口里有 8 个 token，够把「任意层括号 + 限定符 + 类型名 + * 序列 + )」
 * 扫完再看后面是不是 `{`——所以 `(u8)45`（cast）、`((const struct W *)w)->t.t`
 * 都不会被误判成复合字面量。 */
static int tykw_is_qual(Tok *t)
{
    return t->kind == TK_IDENT
        && (TOK_EQ(t, "const") || TOK_EQ(t, "volatile") || TOK_EQ(t, "restrict")
            || TOK_EQ(t, "__const") || TOK_EQ(t, "__volatile__") || TOK_EQ(t, "__restrict")
            || TOK_EQ(t, "__seg_gs") || TOK_EQ(t, "__seg_fs"));
}

/* 当前位置是不是一个类型名（关键字 / typedef / **模板实例** `Vect@int`） */
static int pa_at_typename(void)
{
    if (is_typename_tok(pa_cur()))
        return 1;
    if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
        && TOK_EQ(pa_peek(1), "@")) {
        /* `Vect@int v;` 是声明，但**函数模板**的 `vget@int(v, i)` 是调用——
         * 中间那个 `@` 只是显式实参。 */
        Tmpl *tq = tmpl_find(tok_data(pa_cur()), pa_cur()->len);

        return !(tq && tq->is_func);
    }
    /* `async (int, int) f()` / `async T f()`：async 是说明符，后面跟类型 */
    if (pa_cur()->kind == TK_IDENT && TOK_EQ(pa_cur(), "async") && pa_peek(1)
        && (pa_peek(1)->kind == TK_IDENT
            || (pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "("))))
        return 1;
    /* 模块限定的类型名 `tu.module.Point p;`：单 TU 文本导入下前缀只是命名空间
     * 装饰，看最后一段是不是类型即可。 */
    if (pa_cur()->kind == TK_IDENT && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
        && TOK_EQ(pa_peek(1), ".")) {
        u32 kq = 1;

        /* 但 `obj.member = …` 是**表达式**，不是限定的类型名。判据：前缀在
         * 符号表里已经是变量/函数（不是 typedef），它就不可能同时是模块名。
         *
         * 内核里"成员名和它自己的类型同名"极常见——`key.folio = folio;`
         * （struct folio）、`owner.pid = …`（struct pid）、
         * `root_task_group.cfs_rq = …`（struct cfs_rq）。少了这一条它们全被
         * 判成声明，报"这里要 ';'（当前是 '='）"，实测 20 个文件卡在这条。
         *
         * 只放行非 typedef 的情况：真正的限定名 `tu.module.Point p;` 里
         * `tu` 只是个命名空间装饰，不在符号表里，照旧走下面的判定。 */
        {
            Sym *pq = sym_find(tok_data(pa_cur()), pa_cur()->len);

            if (pq && pq->kind != SC_TYPEDEF)
                return 0;
        }

        while (pa_peek(kq) && pa_peek(kq)->kind == TK_PUNCT && TOK_EQ(pa_peek(kq), ".")
               && pa_peek(kq + 1) && pa_peek(kq + 1)->kind == TK_IDENT)
            kq += 2;
        if (kq > 1) {
            Tok *lt = pa_peek(kq - 1);
            Sym *ls = sym_find(tok_data(lt), lt->len);

            if ((ls && ls->kind == SC_TYPEDEF)
                || sym_find_tag(tok_data(lt), lt->len))
                return 1;
        }
    }
    /* 托管类型开头的类型位置：`@int` / `weak @Node` / `shared @T` / `own @T`。
     * 函数字面量的返回类型就可能是 `@int`（`tests/fn_lit.c6`）。 */
    if (pa_is_ch('@'))
        return 1;
    if (c6_kw() && pa_cur()->kind == TK_IDENT
        && (PA_IS_IDENT("weak") || PA_IS_IDENT("shared") || PA_IS_IDENT("own"))
        && (pa_peek(1)->kind == TK_IDENT || pa_peek(1)->kind == TK_PUNCT))
        return 1;
    return 0;
}

/* `sizeof(` 的后面是不是"括号里的类型"：从 peek(1) 的 `(` 扫到配对的 `)`，
 * 要求它的下一个 token 正好是 sizeof 自己的 `)`。 */
static int sizeof_inner_type_end(void)
{
    int depth = 0;
    int q = 0;

    for (q = 1; q < PA_LOOK; q++) {
        Tok *t = pa_peek(q);

        if (t->kind != TK_PUNCT)
            continue;
        if (tok_eq(t, "(")) {
            depth++;
        } else if (tok_eq(t, ")")) {
            depth--;
            if (depth == 0) {
                Tok *nx = pa_peek(q + 1);

                return nx->kind == TK_PUNCT && tok_eq(nx, ")");
            }
        }
    }
    return 0;
}

/* 复合字面量的类型里带 `[`（`(int[]){…}`、`(char[SIZE]){…}`）。只看不吃。
 * 这类字面量的**值是指针**，和 `(struct s){…}`（值就是那个对象）不一样，
 * 初始化器里要区别对待。 */
static int pa_compound_lit_array_type(void)
{
    int depth = 1;
    int q = 0;

    if (!pa_is_ch('('))
        return 0;
    for (q = 1; q < PA_LOOK; q++) {
        Tok *t = pa_peek(q);

        if (t->kind != TK_PUNCT)
            continue;
        if (tok_eq(t, "(")) {
            depth++;
        } else if (tok_eq(t, "[")) {
            if (depth == 1)
                return 1;
        } else if (tok_eq(t, ")")) {
            depth--;
            if (depth == 0)
                return 0;
        }
    }
    return 0;
}

/* `(char[]){"ab"}`：括号里是类型、花括号体只有一个字符串字面量。
 * 只看不吃（gen_glob_compound_addr 用它决定要不要接这个初始化器）。 */
static int pa_compound_lit_str_body(void)
{
    int depth = 1;
    int q = 0;

    if (!pa_is_ch('('))
        return 0;
    for (q = 1; q < PA_LOOK; q++) {
        Tok *t = pa_peek(q);

        if (t->kind != TK_PUNCT)
            continue;
        if (tok_eq(t, "(")) {
            depth++;
        } else if (tok_eq(t, ")")) {
            depth--;
            if (depth == 0) {
                Tok *a = pa_peek(q + 2);

                if (!(pa_peek(q + 1)->kind == TK_PUNCT
                      && TOK_EQ(pa_peek(q + 1), "{")))
                    return 0;
                if (a->kind != TK_STR)
                    return 0;
                a = pa_peek(q + 3);
                if (a->kind == TK_PUNCT && TOK_EQ(a, ","))
                    a = pa_peek(q + 4);
                return a->kind == TK_PUNCT && TOK_EQ(a, "}");
            }
        }
    }
    return 0;
}

static int pa_is_compound_lit(void)
{
    int i = 0;
    int base = 0;

    if (!pa_is_ch('('))
        return 0;
    /* 宏常把整个复合字面量多括一层：内核 intel_display_power_map.c 的
     * `__LIST_INLINE_ELEMS(t, …)` 展开成 `((t[]){ … })`。先**非破坏性**地
     * 跳过连续的 `((`，从真正带类型名的那层开始认；`pa_take_paren_type_ex`
     * 本来就会把这些 `(` 一并吃掉、返回多出来的个数让调用方补回 `)`。 */
    while (pa_peek(base) && pa_peek(base)->kind == TK_PUNCT
           && tok_eq(pa_peek(base), "(") && pa_peek(base + 1)
           && pa_peek(base + 1)->kind == TK_PUNCT
           && tok_eq(pa_peek(base + 1), "("))
        base++;
    /* 元组/单类型都能这么认：`(int, int){…}`、`(struct S){…}`、`(int){…}`
     * ——括号里是类型、闭括号后面紧跟 `{`。 */
    if (is_typename_tok(pa_peek(base + 1))) {
        /* depth 从 1 起：下标 base 的那个 `(` 已经站在里面了。以前从 0 起，
         * 闭括号一到就把 depth 数成 -1，于是 `(struct s){ ((0)) }` 里
         * 花括号体中的括号对把 depth 拉回 0、提前 return 一个 false——
         * 复合字面量认不出来，值被当成标量送进 const_expr，在 `{` 上
         * 报"这里要一个常量表达式"（内核 mm/backing-dev.c 等 10 个文件
         * 的 RB_ROOT：(struct rb_root){ ((void *)0) , }）。 */
        int depth = 1;
        int q = 0;
        int comma = 0;

        for (q = base + 1; q < PA_LOOK; q++) {
            Tok *t = pa_peek(q);

            if (t->kind != TK_PUNCT)
                continue;
            if (tok_eq(t, "(")) {
                depth++;
            } else if (tok_eq(t, ")")) {
                depth--;
                if (depth == 0) {
                    Tok *nx = pa_peek(q + 1);

                    /* 元组类型 `(int, int){…}` 不归这里管：括号里有顶层逗号
                     * 时交回下面那段（最终返回 0），让表达式那条路去建元组
                     * 字面量——这里只会 parse 一个类型名，碰到逗号就散架。 */
                    if (comma)
                        return 0;
                    return nx->kind == TK_PUNCT && TOK_EQ(nx, "{");
                }
            } else if (tok_eq(t, ",") && depth == 1) {
                comma = 1;
            }
        }
    }
    while (i < 3 && pa_peek(i)->kind == TK_PUNCT && tok_eq(pa_peek(i), "("))
        i++;
    while (i < 5 && tykw_is_qual(pa_peek(i)))
        i++;
    /* `(__typeof(expr)*){0}`：typeof 自己带一层括号，先把它整段跳过去 */
    if (TOK_EQ(pa_peek(i), "typeof") || TOK_EQ(pa_peek(i), "__typeof")
        || TOK_EQ(pa_peek(i), "__typeof__")) {
        int depth = 0;

        i++;
        while (i < 40 && pa_peek(i)->kind != TK_EOF) {
            if (pa_peek(i)->kind == TK_PUNCT && tok_eq(pa_peek(i), "("))
                depth++;
            else if (pa_peek(i)->kind == TK_PUNCT && tok_eq(pa_peek(i), ")")) {
                depth--;
                if (depth == 0) {
                    i++;
                    break;
                }
            }
            i++;
        }
    } else if (!is_typename_tok(pa_peek(i))) {
        return 0;
    } else {
        if (TOK_EQ(pa_peek(i), "struct") || TOK_EQ(pa_peek(i), "union")
            || TOK_EQ(pa_peek(i), "enum"))
            i += 2;
        else
            i += 1;
    }
    while (i < 12 && pa_peek(i)->kind == TK_PUNCT && TOK_EQ(pa_peek(i), "*"))
        i++;
    if (!(pa_peek(i)->kind == TK_PUNCT && tok_eq(pa_peek(i), ")")))
        return 0;
    i++;
    while (i < 14 && pa_peek(i)->kind == TK_PUNCT && tok_eq(pa_peek(i), ")"))
        i++;
    return pa_peek(i)->kind == TK_PUNCT && TOK_EQ(pa_peek(i), "{");
}

/* 吃掉 `(T)` 前缀，停在 `{` 上；返回多出来的左括号个数（收尾要补上 `)`）。
 * `ty_out` 非空时把 `(T)` 里的类型（含 `*` / `[N]` 这类声明符）一起带出来。 */
static u32 pa_take_paren_type_ex(u32 *ty_out)
{
    u32 extra = 0;

    while (pa_is_ch('(')) {
        pa_advance();
        extra++;
    }
    while (tykw_is_qual(pa_cur()))
        pa_advance();
    {
        Declarator ad = {0};
        u32 t = parse_typespec();

        /* 无条件走一遍声明符：`(char[4]){…}`、`(const u8[]){…}` 的 `[4]` / `[]`
         * 就在这一段里被吃掉。以前只在调用方要类型时才 parse_declarator，
         * 于是 `(char[4]){ 0 }` 的类型停在 `char`、游标停在 `[`，紧跟的 `{`
         * 就报"这里要 '{'（当前是 '['）"——内核 include/linux/seq_buf.h:29 的
         * DECLARE_SEQ_BUF、lib/packing_test.c:28、kernel/crash_core_test.c:133
         * 都是数组类型的复合字面量。 */
        t = parse_declarator(t, &ad);
        if (ty_out)
            *ty_out = t;
    }
    while (pa_accept_ch(')'))
        ;
    return extra ? extra - 1 : 0;
}

static u32 pa_take_paren_type(void)
{
    return pa_take_paren_type_ex(NULL);
}

/* 零字节对象的复合字面量（`empty_s x = (empty_s){}`）：没有字节要写，跳过 */
static int pa_skip_empty_compound(void)
{
    u32 ex = 0;

    if (!pa_is_compound_lit())
        return 0;
    ex = pa_take_paren_type();
    pa_advance();                    /* { */
    skip_init_list();
    pa_expect_ch('}');
    while (ex--)
        pa_expect_ch(')');
    return 1;
}

/* 匿名的静态存储期复合字面量（`&(T){…}`）一处一个名字 */
static u32 NCL_LIT;

/* `&(T){ … }`：文件作用域里取复合字面量的地址。
 *
 * C99 6.5.2.5p5：文件作用域的复合字面量是**静态存储期**对象，所以它的存储
 * 直接落在数据段里（语义上就是 `static T cl;` 加一次静态初始化），指针指过去
 * 是一个常量地址。以前这里只认 `&全局` / `&函数`，见到复合字面量就报
 * "全局地址初始化器只支持 &全局/函数"（c-testsuite single-exec/00149、00150）。
 *
 * 进来时游标停在 `&` 后面；返回 1 表示已经把这个初始化器整段吃干净。 */
static int gen_glob_compound_addr(u32 data_off)
{
    u32 cty = 0;
    u32 ex = 0;
    u32 clsym = 0;
    int have_sym = 0;
    i64 add = 0;

    if (!pa_is_compound_lit())
        return 0;
    /* `(char[]){"ab"}`：花括号体只有一个字符串字面量。数组长度得从字面量
     * 长度推，数顶层逗号只会给 1（短了会写坏后面的数据）。这种形状不接，
     * 让调用方按"指针 + 花括号"处理——它取的地址就是字面量本身，内容
     * 与长度完全一致。 */
    if (pa_compound_lit_str_body())
        return 0;
    ex = pa_take_paren_type_ex(&cty);
    if (ty_is_array(cty)) {
        /* 数组类型的复合字面量一律先"抓下来再放回去"：`&(int[]){1,2}` 的长度
         * 得数一遍初始化器才知道（同 gen_one_global 里 `T x[] = {…}` 那条路）。
         * 显式带界的 `(char[4]){ 0 }` 也走同一条——不走的话匿名对象填出来的
         * 字节会落到外层指针槽上（实测 `static char *g = (char[4]){1,2,3,4};`
         * 编出来 g == 0x1）。 */
        Tok *body = NULL;
        u32 bodycap = 0;
        u32 ncap = body_capture(&body, &bodycap);
        u32 n = ty_array_n(cty);

        if (n == 0)
            n = CAP_BOUND > 0 ? CAP_BOUND : 1;
        cty = ty_array(ty_target(cty), n);
        pa_src_push_back(body, ncap);
    }
    if (ty_size(cty) > 0) {
        u32 soff = data_alloc(ty_size(cty), ty_align_of(cty));
        char nm[40] = {0};
        u32 n = (u32)snprintf(nm, sizeof(nm), "__c6_cl_%u", (unsigned)NCL_LIT++);
        /* 复合字面量是 TU 内部对象：多 TU 下若都叫 __c6_cl_0 会在链接时
         * 撞成 multiple definition（内核里 include/linux/seq_buf.h 的
         * DECLARE_SEQ_BUF 等大量头文件宏都会生成它）。按 static 规则给
         * 发射名加 $TU 后缀并标记为 STB_LOCAL。 */
        const char *clnm = tu_static_name(nm);
        u32 sym = x64_data_sym(&X64, arena_strndup(&A_main, clnm, strlen(clnm)), ELF_HDR + soff);
        X64.sym[sym].is_static = 1;

        /* 复合字面量经常嵌在别的花括号初始化器里（内核 include/linux/seq_buf.h:29
         * 的 `DECLARE_SEQ_BUF` 就是顶层 `struct seq_buf s = { .buffer =
         * (char[SIZE]){0}, .size = SIZE }`）。这一趟会重建叶子表 LF_*，而外层
         * 正在遍历同一张表——所以 gen_glob_braced_new 自己进来先快照、出去还原。 */
        gen_glob_braced_new(soff, cty, 0);
        clsym = sym;
        have_sym = 1;
    } else {
        /* 零字节对象（`&(empty_s){}`）：没有字节要写 */
        pa_advance();                    /* { */
        skip_init_list();
        pa_expect_ch('}');
    }
    while (ex--)
        pa_expect_ch(')');

    /* 复合字面量后面常跟下标/成员链：`&((struct T[]){…})[0].m` ——内核
     * i915_pmu.c 的 `I915_PMU_FORMAT_ATTR` 就是 `&((struct i915_str_attribute[]){
     * …})[0].attr.attr`。地址是匿名对象基址加常量偏移（C99 6.6p9）。以前这里
     * 只吃复合字面量本体，留下 `[0].attr.attr`，调用方看到悬空 token 报
     * "这里要 '}' / 顶层声明缺名字"。偏移与 glob_addr_parse 的成员链同口径。 */
    if (have_sym) {
        u32 cur = cty;
        int saved = CONST_NOREF;

        CONST_NOREF = 1;
        while (pa_is_ch('[') || pa_is_ch('.')) {
            if (pa_accept_ch('[')) {
                i64 idx = const_expr();
                u32 et = ty_is_array(cur) ? ty_target(cur) : 0;

                pa_expect_ch(']');
                if (!et)
                    break;
                add += idx * (i64)ty_size(et);
                cur = et;
            } else if (pa_accept_ch('.')) {
                Tok *mt = pa_cur();
                u32 mty = 0, moff = 0;

                if (mt->kind != TK_IDENT || !ty_is_agg(cur)
                    || !agg_find_promoted(cur, tok_data(mt), mt->len, &mty, &moff))
                    break;
                pa_advance();
                add += (i64)moff;
                cur = mty;
            } else {
                break;
            }
        }
        CONST_NOREF = saved;
        data_fixup_add_ex(data_off, clsym, add);
    }
    return 1;
}

/* ---------- 全局初始化器里的地址常量（C99 6.6p7 / 6.6p9）----------
 * 静态初始化的指针只允许两种东西：空指针常量，和**地址常量**——一个全局
 * 对象或函数的地址加一个整数常量偏移。以前这里只认 `&g` / `&f` / `g` 三种
 * 裸形式，`A + 2`、`&g.m`、`&g[i]`、`&g.a.b[2].c` 全掉进"全局地址初始化器只
 * 支持 &全局/函数"那条诊断（标准要求支持，gcc/clang 也都支持）。
 *
 * 读出来的东西化成 (符号, 字节加数) 一对，落成一条**带加数**的数据段重定位
 * （data_fixup_add_ex）：native / C99 / LLVM 三个后端都按这一份记录回填地址，
 * 所以这段逻辑只写一遍，后端只在"算最终地址"那一行加个加数。
 *
 * "看"和"吃"故意分成两步：这个判断挂在"指针类型的全局初始化器"那条通用路上，
 * 凡是不长成地址常量的（`0`、字符串、复合字面量、`&&label`…）都得原样退回去
 * 让别的分支处理。glob_addr_start() 只看不吃，返回 0 时游标必须原地不动。 */
typedef struct GlobAddr {
    u32 sym;      /* ELF 符号下标 */
    i64 add;      /* 字节加数：成员偏移 + 常量下标 × 元素大小 */
    u32 pty;      /* 结果指针指向的类型（指针算术按它缩放） */
    int has_pty;  /* 0 = 函数指针/普通全局变量：不能再做指针算术 */
} GlobAddr;

/* 前瞻：当前位置是不是"地址常量"的开头？**不吃 token**。
 * `amp` = 前面的 `&` 已经被吃掉了。
 * 返回 0 = 不是（调用点必须按别的东西解释这个初始化器）；
 *      1 = 名字开头；2 = 整数在左的 `2 + A`。 */
static int glob_addr_start(int amp)
{
    Tok *t = pa_cur();
    Sym *s = NULL;

    if (!amp && t && t->kind == TK_NUM) {
        /* `2 + A`：整数在左。标准 6.6p9 的字面是"地址常量 + 整数常量"，
         * 但加法交换律下 gcc/clang 都收这个顺序，我们照收——以前它会掉进
         * 常量表达式求值，把数组名当符号下标算，静默编出一个野指针。
         * 左边只认**单个整数字面量**：`(2*3) + A` 这种要真求值，留给常量
         * 表达式那条路。 */
        Tok *op = pa_peek(1);
        Tok *id = pa_peek(2);
        Sym *is = NULL;

        if (!(op->kind == TK_PUNCT && tok_eq(op, "+")))
            return 0;
        if (id->kind != TK_IDENT)
            return 0;
        is = sym_find(tok_data(id), id->len);
        if (!is || is->kind != SC_GLOBAL || is->is_tls || !ty_is_array(is->type))
            return 0;
        return 2;
    }
    /* `&(name)` / `&(name).entry` / `&(name[2])`：名字外面套了成组的括号。
     * 这里只做前瞻（游标不动），真正跳过左括号、关掉右括号的是
     * glob_addr_parse() 里那个 grp 计数。内核里这几种写法很常见——
     *     ASSERT_STATIC_STORAGE(name) → static typeof(name) * const … = &(name)
     *     __WORK_INITIALIZER(n, f)    → { .entry = { &(n).entry, &(n).entry }, … }
     * 不认就报"全局地址初始化器只支持 &全局/函数"（15 个文件）。 */
    if (amp && t && t->kind == TK_PUNCT && TOK_EQ(t, "(")) {
        u32 q = 1;

        /* 括号可以连着套：`&((n).work).entry`（workqueue.h 的
         * __DELAYED_WORK_INITIALIZER 把 n 换成 `(n).work` 就是这个形状），
         * 所以把开头这一串 `(` 全数过去，看后面是不是名字。 */
        while (pa_peek(q) && pa_peek(q)->kind == TK_PUNCT && TOK_EQ(pa_peek(q), "("))
            q++;
        if (pa_peek(q) && pa_peek(q)->kind == TK_IDENT)
            return 1;
    }
    if (!(t && t->kind == TK_IDENT))
        return 0;
    s = sym_find(tok_data(t), t->len);
    if (!s || !(s->kind == SC_GLOBAL || s->is_func))
        /* `&局部变量` / `&this.that`：交给 glob_addr_parse 报准确诊断 */
        return amp;
    if (amp)
        return 1;
    /* 没有 `&`：只有数组名和函数名会**退化**成地址常量。后面跟着 `[`/`.`/
     * `->`/`(` 时那是取值或调用（`A[2]` 是元素的值，不是地址），不是地址
     * 常量。必须在这里就拦住：常量求值对全局变量的名字是宽容的（见
     * CONST_NOREF 那段注释），放它过去会变成"静默拿 &A 当地址"的错码。 */
    if (pa_is_ch('[') || pa_is_ch('.') || pa_is_punct("->") || pa_is_ch('('))
        return 3;
    if (pa_is_ch('+') || pa_is_ch('-'))
        /* `A + 2` 是数组退化后的指针算术；`q + 2`（q 是普通全局变量）不是
         * 常量，函数名加偏移更是无意义——都留给下面报错。 */
        return s->is_func || ty_is_array(s->type);
    return 1;
}

/* 报完错把这个初始化器剩下的 token 吃掉。不清理的话，`&q->x;` 里的 `->x`
 * 会漏到声明解析器手上，一条真错后面跟着二十条"顶层声明缺名字"的假错。 */
static void glob_addr_skip_rest(void)
{
    int depth = 0;

    for (;;) {
        Tok *t = pa_cur();

        if (t->kind == TK_EOF)
            return;
        if (t->kind == TK_PUNCT) {
            if (TOK_EQ(t, "(") || TOK_EQ(t, "[") || TOK_EQ(t, "{")) {
                depth++;
            } else if (TOK_EQ(t, ")") || TOK_EQ(t, "]") || TOK_EQ(t, "}")) {
                if (depth == 0)
                    return;                /* 收尾的括号留给外层 */
                depth--;
            } else if (depth == 0 && (TOK_EQ(t, ",") || TOK_EQ(t, ";"))) {
                return;                    /* 到下一个初始化器/声明结尾了 */
            }
        }
        pa_advance();
    }
}

/* 真读一遍：吃掉整段地址常量，记一条带加数的重定位。
 * 读不动的（非常量下标、`->`、`&局部变量`）就地报准确诊断、丢掉尾巴后返回，
 * 调用点直接结束这个初始化器——不再往下掉到"常量表达式"那条路上二次报错。 */
static void glob_addr_parse(u32 data_off, int amp, int num_first, int pclose)
{
    Tok *t = pa_cur();
    Sym *s = NULL;
    GlobAddr ga = {0, 0, 0, 0};
    u32 ty = 0;
    i64 lead = 0;      /* `2 + A` 里左边那个整数 */
    int grp = 0;       /* 名字外面套了几层成组的括号（`&(name).entry`） */

    /* 偏移必须是整数常量表达式：这一段里 const_primary 见到全局变量就报错 */
    CONST_NOREF = 1;
    if (num_first && t && t->kind == TK_NUM) {
        lead = (i64)int_lit_val(tok_data(t), t->len);
        pa_advance();                    /* 整数 */
        pa_advance();                    /* `+`（glob_addr_start 已经验过） */
        t = pa_cur();
    }
    /* 名字外面可以套成组的括号：`&(name)`、`&(name).entry`、`&(name[2])`。
     * 内核里这两种写法到处都是——
     *     LIST_HEAD_INIT(name)        → { &(name), &(name) }
     *     __WORK_INITIALIZER(n, f)    → { .entry = { &(n).entry, &(n).entry }, … }
     *     ASSERT_STATIC_STORAGE(name) → static typeof(name) * const … = &(name)
     * 不认括号就报"全局地址初始化器只支持 &全局/函数"（15 个文件）或者
     * "这里要 '}'（当前是 '.'）"（括号被当成一个完整初始化器吃掉，后面的
     * `.entry` 没人接）。先记下开了几层，名字消费掉以后再逐个关掉。 */
    while (pa_is_ch('(')) {
        pa_advance();
        grp++;
    }
    t = pa_cur();
    if (!(t && t->kind == TK_IDENT)) {
        pa_error("全局地址初始化器只支持 &全局/函数");
        goto bad;
    }
    s = sym_find(tok_data(t), t->len);
    if (!s || !(s->kind == SC_GLOBAL || s->is_func)) {
        pa_error("'&%.*s' 不是地址常量：只有全局对象、函数的地址（可以带常量"
                 "下标/成员偏移）能用在静态初始化里",
                 (int)t->len, tok_data(t));
        goto bad;
    }
    if (s->is_tls) {
        pa_error("'%.*s' 是 __thread 变量：线程局部量的地址要运行期才算",
                 (int)t->len, tok_data(t));
        goto bad;
    }
    ga.sym = addr_sym_of(s);
    ty = s->type;
    pa_advance();
    /* 关掉包住名字的成组括号。两处来源：这里自己跳过的左括号（grp），
     * 以及调用方为了绕开"强转 vs 成组括号"的判别先剥掉的那几层（pclose，
     * 见 gen_glob_obj / 标量初始化器那两处）。不关掉的话后面的 `.成员`
     * 链会被 `)` 挡住——`&(n).entry` 就成了"只取到 n"，报
     * "这里要 '}'（当前是 '.'）"。 */
    while (grp > 0 && pa_accept_ch(')'))
        grp--;
    while (pclose > 0 && pa_accept_ch(')'))
        pclose--;
    if (amp) {
        /* `&obj` 指向对象本身，然后可以逐段走 `.成员` / `[常量]` */
        ga.pty = ty;
        ga.has_pty = 1;
        for (;;) {
            if (pa_accept_ch('[')) {
                i64 k = const_expr();
                i64 esz = 0;

                pa_expect_ch(']');
                if (!ty_is_array(ga.pty)) {
                    pa_error("地址常量里的下标只能用在数组上；指针变量的值是运行期"
                             "的，不是地址常量");
                    goto bad;
                }
                esz = (i64)ty_size(ty_target(ga.pty));
                ga.add += k * esz;
                ga.pty = ty_target(ga.pty);
            } else if (pa_accept_ch('.')) {
                Tok *mt = pa_cur();
                u32 mty = 0;
                u32 moff = 0;

                if (mt->kind != TK_IDENT || !ty_is_agg(ga.pty)
                    || !agg_find_promoted(ga.pty, tok_data(mt), mt->len, &mty, &moff)) {
                    pa_error("'%.*s' 不是这个结构体/联合体的成员", (int)mt->len,
                             tok_data(mt));
                    goto bad;
                }
                if (AGG_FOUND_BITS != 0) {
                    pa_error("位域没有地址（C99 6.5.3.2p1）");
                    goto bad;
                }
                pa_advance();
                ga.add += (i64)moff;
                ga.pty = mty;
            } else if (pa_is_punct("->")) {
                pa_error("'->' 要先读出运行期的指针值，不是地址常量；静态初始化里"
                         "请写成 '&对象.成员'");
                goto bad;
            } else if (pa_is_ch(')') && (grp > 0 || pclose > 0)) {
                /* 成组括号的右半边，且**还没关完**：括号和成员是交错嵌套的。
                 * 内核 include/linux/workqueue.h:249 的
                 *     __DELAYED_WORK_INITIALIZER(n, f, t) → .work = __WORK_INITIALIZER((n).work, (f))
                 * 展开出来就是 `&((n).work).entry`：关一层 `)`、走一格
                 * `.work`、再关一层 `)`、再走 `.entry`。以前这里是 break，
                 * 剩下的 `)` 留在流里，后面一路"这里要 ')' / '}'"。 */
                pa_advance();
                if (grp > 0)
                    grp--;
                else
                    pclose--;
            } else {
                break;
            }
        }
    } else if (pa_is_ch('.') && ty_is_agg(ty)) {
        /* 基对象是全局量、后面跟着**成员链**、最后一段是数组：数组退化成指向
         * 首元素的指针，那是合法的地址常量（C99 6.6p9）。内核里到处都是——
         *     .fdt          = &init_files.fdtab,
         *     .close_on_exec= init_files.close_on_exec_init,   （自引用）
         *     .data         = fontdata_8x16.data
         * 以前这里一律报"取的是运行期的值"，fs/file.c、kernel/utsname_sysctl.c、
         * lib/fonts/font_8x16.c 都栽在这上面。不是数组就还是运行期的值。 */
        ga.pty = ty;
        ga.has_pty = 1;
        for (;;) {
            if (pa_accept_ch('.')) {
                Tok *mt = pa_cur();
                u32 mty = 0;
                u32 moff = 0;

                if (mt->kind != TK_IDENT || !ty_is_agg(ga.pty)
                    || !agg_find_promoted(ga.pty, tok_data(mt), mt->len, &mty, &moff)) {
                    pa_error("'%.*s' 不是这个结构体/联合体的成员", (int)mt->len,
                             tok_data(mt));
                    goto bad;
                }
                if (AGG_FOUND_BITS != 0) {
                    pa_error("位域没有地址（C99 6.5.3.2p1）");
                    goto bad;
                }
                pa_advance();
                ga.add += (i64)moff;
                ga.pty = mty;
            } else {
                break;
            }
        }
        if (!ty_is_array(ga.pty)) {
            pa_error("'%.*s' 取的是运行期的值，不是地址常量：静态初始化的指针只能"
                     "是全局对象/函数的地址加常量偏移（要地址请写 '&…'）",
                     (int)t->len, tok_data(t));
            goto bad;
        }
        ga.pty = ty_target(ga.pty);
        ga.has_pty = 1;
    } else if (pa_is_ch('[') || pa_is_ch('.') || pa_is_punct("->") || pa_is_ch('(')) {
        /* `int *p = A[2];` / `s.m` / `f()`：取到的是运行期的值 */
        pa_error("'%.*s' 取的是运行期的值，不是地址常量：静态初始化的指针只能"
                 "是全局对象/函数的地址加常量偏移（要地址请写 '&…'）",
                 (int)t->len, tok_data(t));
        goto bad;
    } else if (s->is_func) {
        ga.has_pty = 0;                    /* 函数指针：谈不上缩放 */
    } else if (ty_is_array(ty)) {
        ga.pty = ty_target(ty);            /* 数组名退化：指向元素 */
        ga.has_pty = 1;
    } else {
        /* 普通全局变量：历史上就当"这个符号的地址"落地（加数只能是 0，
         * glob_addr_start 已经保证后面没有 `+`/`-`）。 */
        ga.has_pty = 0;
    }
    /* 指针算术：`A + 2`、`&A[4] - 1`，只认整数常量（标准口径） */
    if (num_first && ga.has_pty)
        ga.add += lead * (i64)ty_size(ga.pty);   /* `2 + A` 里前置的那个整数 */
    while (pa_is_ch('+') || pa_is_ch('-')) {
        int neg = pa_is_ch('-');
        i64 k = 0;
        i64 esz = 0;

        if (!ga.has_pty) {
            pa_error("全局初始化器里的指针算术只支持数组名/对象地址加减常量");
            goto bad;
        }
        pa_advance();
        k = const_expr();
        esz = (i64)ty_size(ga.pty);
        ga.add += neg ? -(k * esz) : (k * esz);
    }
    CONST_NOREF = 0;
    data_fixup_add_ex(data_off, ga.sym, ga.add);
    return;
bad:
    CONST_NOREF = 0;
    glob_addr_skip_rest();
}

/* 当前游标在 `&`（或前面的成组括号）：判断后面是不是 `((T *)0)->member`
 * 这种 offsetof 形状，而不是 `((T[]){…})` 复合字面量。纯前瞻、不吃 token。
 * 两者前缀都是 `& ( ( typename`，区别在类型闭括号之后：offsetof 是
 * `0 ) -> | .`，复合字面量是 `{`；前瞻窗口里谁先出现就判谁。 */
static int pa_is_offsetof_ahead(int start)
{
    int q = 0;

    for (q = start; q < PA_LOOK - 1 && pa_peek(q); q++) {
        Tok *t = pa_peek(q);

        if (t->kind == TK_PUNCT && TOK_EQ(t, "{"))
            return 0;                       /* 复合字面量 */
        if (t->kind == TK_PUNCT && (TOK_EQ(t, "->") || tok_eq(t, ".")))
            return 1;                       /* 成员链 = offsetof */
    }
    return 0;
}

/* `("n")` / `(("n"))`：括号里只包着一个字符串字面量。返回括号层数（不是这种
 * 形状就是 0），纯前瞻、只读。
 * `const char *p = ("n");` 以前 `(` 直接落到常量表达式求值里，报"这里要一个
 * 常量表达式"——内核 arch/x86/kernel/smp.c、cpu/mce/amd.c、fs/proc/*.c 等
 * 8 个文件栽在这上面（register_nmi_handler 之类把字符串当宏实参传，展开出来
 * 就是 `.name = ("smp_stop")`）。 */
static u32 pa_str_paren_depth(void)
{
    u32 k = 0;
    u32 depth = 0;

    while (pa_peek(k)->kind == TK_PUNCT && TOK_EQ(pa_peek(k), "(")) {
        k++;
        depth++;
    }
    if (depth == 0 || pa_peek(k)->kind != TK_STR)
        return 0;
    /* 相邻字符串字面量在翻译阶段拼成一个：`("system." "sockprotoname")`
     * （内核 net/socket.c 的 XATTR_NAME_SOCKPROTONAME）。老实现只跳过一个
     * TK_STR 就去找 `)`，第二个串让它返回 0，值掉进常量表达式报
     * "这里要一个常量表达式"。把紧挨着的 TK_STR 全跳过去。 */
    while (pa_peek(k)->kind == TK_STR)
        k++;
    {
        u32 d = depth;

        while (d-- > 0) {
            if (!(pa_peek(k)->kind == TK_PUNCT && TOK_EQ(pa_peek(k), ")")))
                return 0;
            k++;
        }
    }
    return depth;
}

static void gen_glob_obj(u32 goff, u32 ty, u32 off)
{
    if (ty_size(ty) == 0 && pa_skip_empty_compound())
        return;
    /* 文件作用域的切片不能拿数组/指针直接初始化：`{ data, len }` 里那个 len
     * 得是编译期常量，而从数组推不出来（`extern int ext[]` 更是没有长度）——
     * 写 `int[:] g = a;` 只会静默变成两个 0
     * （tests/errors/slice.c6 的 test_file_scope_array / test_unknown_length）。 */
    /* 静态存储期的闭包只能用 NULL 起步：闭包对象是运行期现开的
     * （tests/errors/closure_convert.c6 的 test_static / test_static_local）。 */
    if (ty_is_closure(ty, NULL) && !pa_is_ch('{') && in_c6_tu()) {
        Tok *t0 = pa_cur();

        if (!(t0 && ((t0->kind == TK_NUM && tok_data(t0)[0] == '0')
                     || (t0->kind == TK_IDENT
                         && (TOK_EQ(t0, "NULL") || TOK_EQ(t0, "nullptr"))))))
            pa_error("a closure is not a constant expression: initialize it at run "
                     "time ('NULL' is fine at file scope)");
    }
    if (ty_is_slice(ty) && !pa_is_ch('{') && in_c6_tu()) {
        pa_error("a slice cannot be initialized from an array in a static "
                 "initializer; use '{ data, len }'");
    }
    /* `void *p = &&label`：计算 goto 的标号地址，布局后回填 */
    if (ty_is_ptr(ty) && pa_is_punct("&&") && pa_peek(1)->kind == TK_IDENT) {
        u32 l = goto_label(tok_data(pa_peek(1)), pa_peek(1)->len);

        pa_advance();
        pa_advance();
        code_lbl_fixup_add(goff + off, x64_cur_fnseq(&X64), l);
        return;
    }
    /* `int *p = (int[]){1,2,3};`：文件作用域的复合字面量是静态存储期对象，
     * 指针初始化器要的是它的**地址**，不是把花括号体按目标类型摊进指针槽。
     * 以前这里不看复合字面量自己的类型，直接 `gen_glob_braced_new(goff, ty)`
     * 摊平，于是 `static int *p = (int[]){ 1, 2, 3 };` 编出来 p == 1（读 p[0]
     * 段错误）。内核 include/linux/seq_buf.h:29 的 DECLARE_SEQ_BUF 就是
     * `.buffer = (char[SIZE]){ 0 }`。 */
    if (ty_is_ptr(ty) && gen_glob_compound_addr(goff + off))
        return;
    if (pa_is_compound_lit()) {
        u32 ex = pa_take_paren_type();

        gen_glob_braced_new(goff, ty, off);
        while (ex--)
            pa_expect_ch(')');
        return;
    }
    /* 标量上的花括号（`(int){5}` / `{ {5} }`）：剥一层再走标量那条路 */
    if (!ty_is_agg(ty) && !ty_is_array(ty) && pa_is_ch('{')) {
        pa_advance();
        gen_glob_obj(goff, ty, off);
        while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF) {
            if (!pa_accept_ch(','))
                break;
            if (pa_is_ch('}'))
                break;
            init_skip_value();
        }
        pa_expect_ch('}');
        return;
    }
    /* 复数：`static double _Complex g = 2.0;`（C99 6.7.8p13 允许拿实数初始化
     * 复数对象）。实部按分量类型落到数据段，虚部是数据段本来就有的 0。
     * 不能走下面"聚合只填第一个成员"那条通用路：它按标量常量的**整数字面量**
     * 落盘，`2.0` 会变成 9.88e-324。 */
    if (ty_is_cplx(ty) && !pa_is_ch('{')) {
        gen_glob_obj(goff, cplx_comp(ty), off);
        return;
    }
    if (ty_is_agg(ty) || ty_is_array(ty)) {
        if (pa_is_ch('{')) {
            gen_glob_braced_new(goff, ty, off);
            return;
        }
        if (ty_is_array(ty) && pa_cur()->kind == TK_STR) {
            u32 n = (u32)(pa_cur()->len > 1 ? pa_cur()->len - 1 : 1);
            u32 so = str_lit_data();
            u32 k = 0;
            u32 room = ty_size(ty);

            /* 注意这里 `n` 是源 token 的字符数，对宽字面量（`L"…"`）不等于
             * 字节数，所以**不能**照着 room 清零再拷 n 字节（97_utf8 就是这么
             * 被弄坏的）。数据段本身是零，保持原来的行为。 */
            for (k = 0; k < n && k < room; k++)
                DATA_IMG.p[goff + off + k] = DATA_IMG.p[so + k];
            return;      /* str_lit_data 已经把 token 吃掉了 */
        }
        {
            u32 et = ty_is_array(ty) ? ty_target(ty) : 0;
            u32 eo = 0;

            if (!ty_is_array(ty)) {
                if (ty_member_n(ty) == 0) {
                    /* 零字节的聚合当初始化目标：有些结构体在某些配置下就是
                     * 空的（内核 include/linux/userfaultfd_k.h 的
                     * `struct vm_userfaultfd_ctx {}`），拿它初始化没有字节要
                     * 写，把初始化器跳过就行（gcc 一直接受
                     * `struct empty x = {};` 和 `= 另一个 empty 对象`）。 */
                    init_skip_expr();
                    return;
                }
                et = ty_member(ty, 0);
                eo = ty_member_off(ty, 0);
            }

            gen_glob_obj(goff, et, off + eo);
            return;
        }
    }
    if (ty_is_ptr(ty) && pa_is_ch('(')) {
        u32 d = pa_str_paren_depth();

        if (d > 0) {
            u32 so = 0;
            u32 j = 0;

            for (j = 0; j < d; j++)
                pa_advance();          /* 左边的分组括号 */
            so = str_lit_data();
            glob_store(goff, off, ty, (u64)DATA_VA(so));
            for (j = 0; j < d; j++)
                pa_expect_ch(')');
            return;
        }
    }
    if (ty_is_ptr(ty) && pa_cur()->kind == TK_STR) {
        u32 so = str_lit_data();
        u64 va = (u64)DATA_VA(so);

        glob_store(goff, off, ty, va);
        return;      /* str_lit_data 已经把 token 吃掉了 */
    }
    /* 浮点成员：字面量或整型常量都要转成 IEEE-754 的位模式再落地，
     * `struct { double a; } g = { 1 };` 以前把整数 1 的字节直接写进去，
     * 读出来是 5e-324 这种鬼值（131_return_struct_in_reg 就是这样）。 */
    /* 全局聚合里的**地址常量**：`{ sys_one, &g, tab }`。
     * 以前这条路只认数字/浮点，函数名和全局符号名落进去就是 0——静态函数
     * 指针表整张都是空的（tcc 的 90_struct-init 正是这么崩的）。
     * `&g.m` / `&g[i]` / `A + 2` 这类带偏移的形式由 glob_addr_parse 统一处理。 */
    if (ty_is_ptr(ty)) {
        int amp = 0;
        int ak = 0;
        u32 amp_paren = 0;



        /* 剥掉外面那层**标量强制转换**再认地址常量：`(void *)(uintptr_t)&sym`
         * 是内核 EXPORT_SYMBOL 的标准写法（include/linux/compiler.h 的
         * __ADDRESSABLE），值的含义和裸 `&sym` 完全一样。不剥的话它落到
         * 下面的常量表达式求值里，撞"常量表达式里只支持 &((T *)0)->member
         * 形式的取地址"——lib/string.c 每个 EXPORT_SYMBOL 一条，实测 21 条。
         *
         * 只剥 `(` 类型名 `)` 这一种形态，且要求后面**不是** `(`：
         * `(int(*)(void))f` 这种是复合字面量/调用，不归这里管。
         *
         * 另外还要剥**纯粹的括号分组**：`((void *)&sysctl_vals[0])` 这种
         * 多套一层括号的写法。判定用纯前瞻——见 gen_glob_obj 开头的
         * glob_wrapped_whole()。 */
        for (;;) {
            u32 k = 1;
            u32 skip = 0;

            if (!pa_is_ch('(') || !is_typename_tok(pa_peek(k)))
                break;
            k++;
            /* 吃到类型说明符结束：`void`、`unsigned long`、`void const`、
             * `struct foo`、`void *` 都得整段过掉。这里只做形状判断，
             * 类型本身不影响结果（cast 到指针/整数都一样）。 */
            while (pa_peek(k)->kind == TK_IDENT
                   && is_typename_tok(pa_peek(k)))
                k++;
            if (pa_peek(k - 1)->kind == TK_IDENT
                && (TOK_EQ(pa_peek(k - 1), "struct")
                    || TOK_EQ(pa_peek(k - 1), "union")
                    || TOK_EQ(pa_peek(k - 1), "enum"))
                && pa_peek(k)->kind == TK_IDENT)
                k++;
            while ((pa_peek(k)->kind == TK_IDENT && tykw_is_qual(pa_peek(k)))
                   || (pa_peek(k)->kind == TK_PUNCT
                       && TOK_EQ(pa_peek(k), "*")))
                k++;
            if (!(pa_peek(k)->kind == TK_PUNCT && TOK_EQ(pa_peek(k), ")")))
                break;
            /* 后面紧跟 `(`：可能是**又一层** cast（`(void *)(unsigned long)&x`，
             * 内核 EXPORT_SYMBOL 正是两层），也可能是调用/复合字面量。看那个
             * `(` 里面是不是类型名来分辨。`{` 一定是复合字面量，直接放行。 */
            if (pa_peek(k + 1)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(k + 1), "{"))
                break;
            if (pa_peek(k + 1)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(k + 1), "(")
                && !is_typename_tok(pa_peek(k + 2))
                /* `(unsigned long)(&a[1])`：强转后面跟着**成组括号里的取值
                 * 表达式**，不是调用/复合字面量（`&` 不可能是类型名）。 */
                && !(pa_peek(k + 2)->kind == TK_PUNCT && TOK_EQ(pa_peek(k + 2), "&")))
                break;
            /* 只按**前瞻算好的个数**跳过，不调 parse_typename()：
             * 那个函数会把后面的表达式一起吞掉（实测：
             * `(void *)&target` 里的 `&target` 被吃掉，于是 amp=0，
             * 初始化器整段消失）。 */
            skip = k + 1;
            while (skip-- > 0)
                pa_advance();
        }
        /* `(&name… )`：整条地址常量外面套了成组括号（`void *x = (&a[1]);`）。
         * 上面那个 `&(name)` 的括号在 `&` **后面**，这里反过来在前。不剥的话
         * `pa_accept_ch('&')` 看不见 `&`（游标还停在 `(` 上），整条掉进常量
         * 表达式求值，报"这里要 ')'（当前是 '['"。
         *
         * 只认"括号里紧接着 `&` 一个名字"的形状，别的（`(x) + 1`、
         * `((void *)&x)` 之类）原样放过去。 */
        for (;;) {
            u32 k0 = 0;

            while (pa_peek(k0)->kind == TK_PUNCT && TOK_EQ(pa_peek(k0), "("))
                k0++;
            if (k0 == 0 || !(pa_peek(k0)->kind == TK_PUNCT && TOK_EQ(pa_peek(k0), "&")))
                break;
            /* `&` 后面要么是名字（`(&name)`），要么是复合字面量
             * `(&(const struct T){…})`（内核 HWMON_CHANNEL_INFO 宏展开后
             * 正是这种：外层括号里 & 后跟 `(`，老判断只认 TK_IDENT，
             * 外括号不剥、amp 看不到 &，3 个 hwmon TU 编不过）。两者都剥。 */
            if (pa_peek(k0 + 1)->kind != TK_IDENT
                && !(pa_peek(k0 + 1)->kind == TK_PUNCT && TOK_EQ(pa_peek(k0 + 1), "(")))
                break;
            pa_advance();          /* 一层 `(` */
            amp_paren++;
        }
        /* `&((T *)0)->m` / `&((T *)0)->a[i]`：经典 offsetof 写法，值就是成员
         * 偏移（整数常量）。内核 net/core/neighbour.c 的
         * NEIGH_PARMS_DATA_OFFSET(index) = &((struct neigh_parms *)0)->data[index]
         * 正是这种。const_unary 的 `&` 分支本来就完整支持这个形状（含常量下标），
         * 但下面 glob_addr_start 会把第二层 `(` 后的 `struct`（关键字词法上是
         * TK_IDENT）当成全局符号名，落进 glob_addr_parse 报 "'&struct' 不是地址
         * 常量"。在 `&` 被吃掉之前就把整条交给常量求值器。 */
        if (pa_is_ch('&') && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(1), "(") && pa_peek(2) && pa_peek(2)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(2), "(") && pa_peek(3) && is_typename_tok(pa_peek(3))
            && pa_is_offsetof_ahead(3)) {
            i64 offv = const_expr();

            glob_store(goff, off, ty, (u64)offv);
            /* 宏可能把整条地址括起来 `( &((T *)0)->m[i] )`：上面那段
             * `(&name…)`  stripping 已经记在 amp_paren，这里补吃右括号。 */
            while (amp_paren > 0 && pa_is_ch(')')) {
                pa_advance();
                amp_paren--;
            }
            amp_paren = 0;
            return;
        }
        amp = pa_accept_ch('&');
        /* `&(name)`：取的是**自己**。内核 include/linux/list.h:27 的
         *     #define LIST_HEAD_INIT(name) { &(name), &(name) }
         * 展开后是 `static struct list_head x = { &(x), &(x) };`——
         * 完全合法的自引用静态初始化（gcc 一直支持）。多出来的那对括号
         * 让 glob_addr_start 只看见 `(`，直接落到"只支持 &全局/函数"。
         *
         * 这里把 `(` 剥掉，数量记在 amp_paren，值解析完再补右括号。 */
        {
            u32 pd = 0;

            for (; amp; ) {
                u32 k = 1;

                if (!pa_is_ch('(') || pa_peek(k)->kind != TK_IDENT
                    || is_typename_tok(pa_peek(k)))
                    break;
                /* 括号里是 `名字 (.成员 | [常量])*`，且整体只有一层括号。`const`
                 * 等类型关键字词法上也是 TK_IDENT，不能当成 `&(name)` 的名字——
                 * 否则 `&(const struct T){…}` 会被错剥成 `&const`（复合字面量）。 */
                while (pa_peek(k)->kind == TK_IDENT
                       || (pa_peek(k)->kind == TK_PUNCT
                           && (TOK_EQ(pa_peek(k), ".") || TOK_EQ(pa_peek(k), "[")))) {
                    if (pa_peek(k)->kind == TK_IDENT) {
                        k++;
                        continue;
                    }
                    if (TOK_EQ(pa_peek(k), ".")) {
                        k++;
                        if (pa_peek(k)->kind != TK_IDENT)
                            break;
                        continue;
                    }
                    /* `[`：跳到配对 `]` */
                    {
                        int d2 = 0;

                        while (pa_peek(k)->kind != TK_EOF) {
                            if (TOK_EQ(pa_peek(k), "["))
                                d2++;
                            else if (TOK_EQ(pa_peek(k), "]")) {
                                d2--;
                                if (d2 == 0) {
                                    k++;
                                    break;
                                }
                            }
                            k++;
                        }
                    }
                }
                if (!(pa_peek(k)->kind == TK_PUNCT && TOK_EQ(pa_peek(k), ")")))
                    break;
                pa_advance();
                amp_paren++;
                (void)pd;
            }
        }
        if (amp && gen_glob_compound_addr(goff + off)) {
            /* `(&(T){…})`：外层成组括号在前面剥掉了（amp_paren 记着数），
             * 复合字面量本体吃完还得把那几个 `)` 补回去，否则下一条声明
             * 从悬空的 `)` 开始，报"顶层声明缺名字"。普通的 `&(T){…}`
             * amp_paren=0，这里自然空转。 */
            while (amp_paren > 0 && pa_is_ch(')')) {
                pa_advance();
                amp_paren--;
            }
            amp_paren = 0;
            return;
        }
        /* `&(*(T *)0)`：`&*` 抵消，值就是 `(T *)0` = 空指针常量。内核
         * drivers/tty/sysrq.c 的 `sysrq_showlocks_op (*(const struct sysrq_key_op *)NULL)`
         * 被 `&sysrq_showlocks_op` 取地址时 gcc 折叠成 NULL；老实现只认
         * `&全局/函数`，这里报"全局地址初始化器只支持 &全局/函数"、
         * sysrq.c 编不过。把 `& ( * (T *)0 )` 整段吃掉、存 0 即可。 */
        if (amp && pa_is_ch('(') && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(1), "*")) {
            i64 nullv = 0;

            pa_advance();              /* ( */
            pa_advance();              /* * */
            nullv = const_expr();      /* (T *)0 → 0 */
            pa_expect_ch(')');
            glob_store(goff, off, ty, (u64)nullv);
            return;
        }
        ak = glob_addr_start(amp);
        if (ak) {
            glob_addr_parse(goff + off, amp, ak == 2, (int)amp_paren);
            while (amp_paren > 0 && pa_is_ch(')')) {
                pa_advance();
                amp_paren--;
            }
            amp_paren = 0;
            return;
        }
        amp_paren = 0;
        if (amp)
            pa_error("全局地址初始化器只支持 &全局/函数");
        /* 三元 `cond ? f1 : f2` 挑函数指针：整条是个常量表达式
         * （内核 include/linux/debugfs.h:59 的
         *  `.write = (__is_signed) ? debugfs_attr_write_signed : debugfs_attr_write`）。
         * 上面那套地址常量只认单个符号，落到这里就交给通用常量求值。
         *
         * 注意判据用 `pa_is_ch('(')` 而**不是** `pa_is_ch('?')`：走到这里时
         * 游标还在 `(` 上，`?` 在括号后面看不见。 */
        if (pa_cur()->kind != TK_EOF
            && (pa_is_ch('(') || pa_is_ch('?') || pa_is_ch('!')
                || (pa_cur()->kind == TK_NUM)
                /* `_Generic(…, T: 全局对象名, …)`：常量层选中分支以后值是个
                 * **符号下标**（CONST_SYM=1），得按地址常量补重定位，不能把
                 * 下标当整数写进数据段。内核 include/linux/sysfs.h:297 的
                 * ATTRIBUTE_GROUPS 就是这个形状——`.attrs = _Generic(_name##_attrs,
                 * struct attribute **: _name##_attrs, …)`，落在全局初始化器里。 */
                || PA_IS_IDENT("_Generic"))) {
            u32 save = FN.n;
            u32 save_sym = CONST_SYM;
            i64 cv = 0;
            i64 sym_add = 0;
            int is_sym = 0;

            CONST_SYM = 0;
            CONST_SYM_ADD = 0;
            cv = const_expr();
            is_sym = (int)CONST_SYM;
            sym_add = CONST_SYM_ADD;
            CONST_SYM = save_sym;
            FN.n = save;
            PEND_LVAL = 0;
            if (is_sym) {
                /* 值是个**符号下标**（三元挑出来的函数名/全局对象），
                 * 要像地址常量那样补一条重定位，不能把下标当整数写进去——
                 * 内核 include/linux/debugfs.h:59 的 `.write = cond ? a : b`
                 * 以前会编成 0x194 这种"下标"。 */
                glob_store(goff, off, ty, 0);
                data_fixup_add_ex(goff + off, (u32)cv, sym_add);
                return;
            }
            glob_store(goff, off, ty, (u64)cv);
            return;
        }
    }
    if (ty_is_float(ty)) {
        u64 bits = 0;
        int neg = 0;

        (void)neg;
        {
            double dv = 0;

            if (pa_cur()->kind == TK_NUM || pa_is_ch('-') || pa_is_ch('+')
                || pa_is_ch('(')) {
                int ok = 1;

                dv = const_fexpr(&ok);
                if (!ok)
                    dv = 0;
            } else {
                u64 iv = 0;

                if (parse_const_u64(&iv))
                    dv = (double)(i64)iv;
            }
            if (ty_kind(ty) == TY_BF16) {
                u32 b32 = 0;

                *(float *)&b32 = (float)dv;
                bits = (u64)bf16_bits_of_f32(b32);
            } else if (ty_size(ty) == 4) {
                u32 b32 = 0;
                float fv = (float)dv;

                *(float *)&b32 = fv;
                bits = (u64)b32;
            } else {
                *(double *)&bits = dv;
            }
        }
        glob_store(goff, off, ty, bits);
        return;
    }
    {
        u64 v = 0;

        if (parse_const_u64(&v)) {
            if (CONST_LAST_SYM && !GLOB_BF_BITS) {
                /* 整型字段里装的是**地址常量**：`.driver_data =
                 * (kernel_ulong_t)(&i830_early_ops)`、
                 * `cpumask_bits(&mask)` → `&mask.bits[0]`。往常量求值拿到的是
                 * 符号下标，直接当整数写进数据段就变成 0xC2 这种"下标"
                 * （内核 arch/x86/kernel/early-quirks.c 的 intel_early_ids、
                 * kernel/watchdog.c 的 watchdog_cpumask_bits）。和指针那条路
                 * 一样补一条重定位。 */
                glob_store(goff, off, ty, 0);
                data_fixup_add_ex(goff + off, (u32)v, CONST_LAST_ADD);
                return;
            }
            if (GLOB_BF_BITS) {
                /* 位域初始化：在数据段上做读-改-写 */
                u64 unit = 0;
                u64 fmask = (GLOB_BF_BITS >= 64)
                            ? ~0ULL : ((1ULL << GLOB_BF_BITS) - 1);
                u32 sz = ty_size(ty);
                u32 i = 0;

                if (sz > 8)
                    sz = 8;
                for (i = 0; i < sz; i++)
                    unit |= (u64)DATA_IMG.p[goff + off + i] << (8 * i);
                unit = (unit & ~(fmask << GLOB_BF_BITOFF))
                       | ((v & fmask) << GLOB_BF_BITOFF);
                glob_store(goff, off, ty, unit);
            } else {
                glob_store(goff, off, ty, v);
            }
        }
    }
}

static void gen_init_obj(u32 addr, u32 ty, u32 off);

/* 一组 {…} 里的元素：把每个元素写到它该在的偏移上 */

/* 指示符导航（`.name` / `[idx]`，可以链起来：`[1].x = 3`），
 * 走完最后一段再吃掉 '=' 填值。 */
static void gen_desig_fill(u32 addr, u32 ty, u32 off)
{
    for (;;) {
        if (pa_accept_ch('[')) {
            u32 i = 0;
            u32 et = 0;

            i = (u32)const_expr();
            pa_expect_ch(']');
            if (!ty_is_array(ty)) {
                pa_error("下标指示符用在了非数组上");
                return;
            }
            et = ty_target(ty);
            if (i >= ty_array_n(ty))
                return;                    /* 越界：整段忽略 */
            ty = et;
            off += i * ty_size(et);
            continue;
        }
        if (pa_accept_ch('.')) {
            const char *nm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
            u32 nl = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
            int idx = 0;

            if (!nm) {
                pa_error("'.' 后面要成员名");
                return;
            }
            pa_advance();
            if (!ty_is_agg(ty)) {
                pa_error("成员指示符用在了非聚合类型上");
                return;
            }
            {
                u32 mo = 0;

                if (!agg_find_promoted(ty, nm, nl, &ty, &mo)) {
                    pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                    return;
                }
                off += mo;
            }
            continue;
        }
        break;
    }
    pa_expect_ch('=');
    gen_init_obj(addr, ty, off);
}

static void gen_init_braced(u32 addr, u32 ty, u32 off)
{
    u32 cur = 0;
    int first = 1;

    if (ty_is_array(ty)) {
        u32 et = ty_target(ty);
        u32 esz = ty_size(et);
        u32 n = ty_array_n(ty);

        for (;;) {
            if (pa_is_ch('}') || pa_cur()->kind == TK_EOF)
                break;
            if (!first && !pa_accept_ch(','))
                break;
            first = 0;
            if (pa_is_ch('}'))
                break;
            if (pa_accept_ch('[')) {
                u32 lo = (u32)const_expr();
                u32 hi = lo;
                u32 k = 0;

                if (pa_accept_punct("..."))
                    hi = (u32)const_expr();
                pa_expect_ch(']');
                if (pa_is_ch('.') || pa_is_ch('[')) {
                    gen_desig_fill(addr, et, off + lo * esz);   /* 链式：只填首元素 */
                } else {
                    pa_expect_ch('=');
                    for (k = lo; k <= hi && k < n; k++)
                        gen_init_obj(addr, et, off + k * esz);
                }
                cur = hi + 1;
                continue;
            }
            if (pa_is_ch('.') && ty_is_agg(ty))
                break;                       /* 走到下面的聚合分支 */
            if (cur >= n) {
                skip_init_list();
                break;
            }
            gen_init_obj(addr, et, off + cur * esz);
            cur++;
        }
        if (off == 0)
            INIT_COUNT = cur;
        return;
    }
    if (!ty_is_agg(ty)) {
        /* 标量套了一层花括号：{5} */
        if (ty_member_n(ty) == 0 && !pa_is_ch('}')) {
            gen_init_obj(addr, ty, off);
            return;
        }
    }
    {
        u32 n = ty_member_n(ty);

        for (;;) {
            if (pa_is_ch('}') || pa_cur()->kind == TK_EOF)
                break;
            if (!first && !pa_accept_ch(','))
                break;
            first = 0;
            if (pa_is_ch('}'))
                break;
            if (pa_accept_ch('.')) {
                const char *nm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
                u32 nl = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
                int idx = 0;
                u32 mty = 0;
                u32 moff = 0;

                if (!nm) {
                    pa_error("'.' 后面要成员名");
                    break;
                }
                pa_advance();
                if (!agg_find_promoted(ty, nm, nl, &mty, &moff)) {
                    pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                    break;
                }
                idx = agg_find_member(ty, nm, nl);
                if (pa_is_ch('.') || pa_is_ch('[')) {
                    gen_desig_fill(addr, mty, off + moff);
                } else {
                    pa_expect_ch('=');
                    gen_init_obj(addr, mty, off + moff);
                }
                cur = idx >= 0 ? (u32)idx + 1 : 0;
                continue;
            }
            if (cur >= n) {
                skip_init_list();      /* 元素用完：多余的吞掉，别报错 */
                break;
            }
            gen_init_obj(addr, ty_member(ty, cur), off + ty_member_off(ty, cur));
            cur++;
        }
    }
}


/* --- 初始化器的叶子游标引擎 --------------------------------------------
 *
 * 旧实现是“一层花括号推进一层子对象”：一个聚合元素没有花括号（brace elision）
 * 时只填它的**第一个**子对象，父层就把这个元素当成填完了。真实代码里省略
 * 花括号到处都是：
 *
 *     PT cases[] = { a, b, c, d, e, f, g };      // PT 里有 I c[4]
 *     struct S g[] = { [1].x[0].b = 5, 6, 7 };   // 6、7 接着填 x[1]
 *
 * 两条都会被填错位置（75_array_in_struct_init / 152_designator_chain）。
 *
 * 新做法：先把整个对象摊平成一串**叶子**（标量成员，按声明顺序、带绝对字节
 * 偏移），用一个游标 INIT_CUR 线性推进。花括号只用来定位目标：从最内层往上找
 * 第一个“首叶正好是游标”的聚合，就是这次 `{…}` 要初始化的子对象；找不到就是
 * 标量套花括号 `{5}`。层栈随游标位置重建，所以 `{` 出现在任何深度都对得上。
 *
 * 叶子表放不下（超大对象）时整个引擎退回旧实现，保证不会因此编错。
 */
#define INIT_LF_MAX 65536
static u32 LF_OFF[INIT_LF_MAX];
static u32 LF_TY[INIT_LF_MAX];
static u32 LF_BITS[INIT_LF_MAX];
static u32 LF_BOFF[INIT_LF_MAX];
static u32 LF_N;
static int LF_TRUNC;
static u32 INIT_CUR;       /* 下一个要填的叶子 */
static u32 INIT_MAX;       /* 填过的最大叶子下标 + 1（顶层数组长度靠它） */

#define INIT_LV_MAX 32
static u32 LV_TY[INIT_LV_MAX];
static u32 LV_OFF[INIT_LV_MAX];
static u32 LV_DEPTH;

static void init_save(InitSave *st)
{
    memset(st, 0, sizeof *st);
    st->n = LF_N;
    st->trunc = LF_TRUNC;
    st->cur = INIT_CUR;
    st->max = INIT_MAX;
    st->lvd = LV_DEPTH;
    st->count = INIT_COUNT;
    st->cntok = INIT_CNT_OK;
    if (LF_N > 0) {
        st->off = arena_alloc(&A_main, sizeof(u32) * (size_t)LF_N);
        st->ty = arena_alloc(&A_main, sizeof(u32) * (size_t)LF_N);
        st->bits = arena_alloc(&A_main, sizeof(u32) * (size_t)LF_N);
        st->boff = arena_alloc(&A_main, sizeof(u32) * (size_t)LF_N);
        memcpy(st->off, LF_OFF, sizeof(u32) * (size_t)LF_N);
        memcpy(st->ty, LF_TY, sizeof(u32) * (size_t)LF_N);
        memcpy(st->bits, LF_BITS, sizeof(u32) * (size_t)LF_N);
        memcpy(st->boff, LF_BOFF, sizeof(u32) * (size_t)LF_N);
    }
    if (LV_DEPTH > 0) {
        st->lvty = arena_alloc(&A_main, sizeof(u32) * (size_t)LV_DEPTH);
        st->lvoff = arena_alloc(&A_main, sizeof(u32) * (size_t)LV_DEPTH);
        memcpy(st->lvty, LV_TY, sizeof(u32) * (size_t)LV_DEPTH);
        memcpy(st->lvoff, LV_OFF, sizeof(u32) * (size_t)LV_DEPTH);
    }
}

static void init_restore(InitSave *st)
{
    u32 k = 0;

    for (k = 0; k < st->n; k++) {
        LF_OFF[k] = st->off[k];
        LF_TY[k] = st->ty[k];
        LF_BITS[k] = st->bits[k];
        LF_BOFF[k] = st->boff[k];
    }
    for (k = 0; k < st->lvd; k++) {
        LV_TY[k] = st->lvty[k];
        LV_OFF[k] = st->lvoff[k];
    }
    LF_N = st->n;
    LF_TRUNC = st->trunc;
    INIT_CUR = st->cur;
    INIT_MAX = st->max;
    LV_DEPTH = st->lvd;
    INIT_COUNT = st->count;
    INIT_CNT_OK = st->cntok;
}

static int INIT_IS_GLOB;     /* 1 = 数据段初始化（goff），0 = 局部（addr vreg） */
static u32 INIT_GOFF;
static u32 INIT_ADDR;

/* `T a[] = { … }` 的元素个数只能从初始化器推。前瞻窗口只有 16 个 token
 * （`PA_LOOK`），边解析边看是看不到头的，所以调用方先把整个花括号体用
 * `body_capture()` 抓下来交给这里数一遍：
 *   - 顶层逗号数 + 1 = 顺序初始化的元素个数；
 *   - 设计符 `[N]`、`[a ... b]` 取 b + 1。
 * 算出来的是**上界**（顺序值和设计符混着写时会偏大），调用方解析完用
 * `INIT_COUNT` 收缩到真实长度——全局收数据段尾巴，局部改类型。
 * 以前这里按 `1024 / sizeof(元素)` 估，超过就静默截断：tcc 里那张 354 条的
 * 静态指令表被 c6c 编成只有 122 条，它的汇编器就这么坏的。 */
static u32 init_bound_count(Tok *t, u32 n)
{
    u32 i = 0;
    int depth = 0;
    u32 cur = 0;
    u32 bound = 0;
    int at_item = 1;          /* 刚过完一个顶层逗号，正看着一个新条目的开头 */

    for (i = 0; i < n; i++) {
        Tok *q = &t[i];

        if (q->kind != TK_PUNCT) {
            /* 普通条目可能是数字/字符串/标识符——它们不是标点，别在
             * at_item 判断之前就 continue 掉（`{ {1}, 2 }` 里的 2 就是这种）。 */
            if (depth == 1 && at_item) {
                at_item = 0;
                cur++;
                if (cur > bound)
                    bound = cur;
            }
            continue;
        }
        if (TOK_EQ(q, "{")) {
            if (depth == 1 && at_item) {
                /* `{…}` 也是条目：`{{1,2},{3,4}}` 里每个内层花括号一个元素 */
                at_item = 0;
                cur++;
                if (cur > bound)
                    bound = cur;
            }
            depth++;
            continue;
        }
        if (TOK_EQ(q, "}")) {
            depth--;
            continue;
        }
        if (depth != 1)
            continue;
        if (tok_eq(q, ",")) {
            at_item = 1;
            continue;
        }
        if (!at_item)
            continue;
        at_item = 0;
        if (TOK_EQ(q, "[")) {
            /* 设计符：`[N]` / `[a ... b]`，游标移到 b + 1 */
            u32 k = i + 1;
            u32 mx = 0;
            int seen = 0;

            for (; k < n; k++) {
                Tok *d = &t[k];
                u32 j = 0;
                u64 v = 0;
                int ok = 1;

                if (d->kind == TK_PUNCT && TOK_EQ(d, "]"))
                    break;
                if (d->kind != TK_NUM)
                    continue;
                for (j = 0; j < d->len; j++) {
                    char ch = d->syn[j];

                    if (ch < '0' || ch > '9') {
                        ok = 0;
                        break;
                    }
                    v = v * 10 + (u64)(ch - '0');
                }
                if (ok && v < 0x7fffffffu) {
                    mx = (u32)v;      /* `[a ... b]` 取最后一个数 */
                    seen = 1;
                }
            }
            cur = seen ? mx + 1 : cur + 1;
            i = k;
        } else if (TOK_EQ(q, ".")) {
            /* 成员设计符 `.m = …`：不推进数组游标 */
            continue;
        } else {
            /* 普通条目：游标 + 1（嵌套花括号里的逗号在 depth ≥ 2，不算条目） */
            cur++;
        }
        if (cur > bound)
            bound = cur;
    }
    if (bound == 0)
        bound = 1;
    return bound;
}

static u32 init_leaf_walk(u32 ty, u32 off, u32 bits, u32 boff, int collect)
{
    u32 cnt = 0;
    u32 n = 0;
    u32 i = 0;

    if (ty_is_array(ty)) {
        u32 et = ty_target(ty);
        u32 esz = ty_size(et);

        n = ty_array_n(ty);
        for (i = 0; i < n; i++)
            cnt += init_leaf_walk(et, off + i * esz, 0, 0, collect);
        return cnt;
    }
    if (ty_is_agg(ty)) {
        n = ty_member_n(ty);
        if (ty_is_union(ty) && n > 1)
            n = 1;              /* 联合体只初始化第一个成员 */
        for (i = 0; i < n; i++) {
            u32 mw = ty_member_bits(ty, i);

            /* 无名的位域（`unsigned :32;`、对齐用的 `:0`）不占初始化器的位置 */
            if (ty_member_anon(ty, i))
                continue;
            cnt += init_leaf_walk(ty_member(ty, i), off + ty_member_off(ty, i),
                                  mw, ty_member_bitoff(ty, i), collect);
        }
        return cnt;
    }
    if (collect) {
        if (LF_N >= INIT_LF_MAX) {
            LF_TRUNC = 1;
            return 1;
        }
        LF_OFF[LF_N] = off;
        LF_TY[LF_N] = ty;
        LF_BITS[LF_N] = bits;
        LF_BOFF[LF_N] = boff;
        LF_N++;
    }
    return 1;
}

/* 第一个 offset >= off 的叶子下标（LF_OFF 单调不减）。
 *
 * 原来一律二分：tcc.c 上 init_leaf_at 被调了 28 万次、走了 273 万步二分
 * （平均 9.7 步/次，每步一条带随机下标的 load）。但调用方的访问模式极有规律
 * ——初始化器是一次性扫过去的，查询的 off 基本单调前进，答案下标也跟着走。
 * 所以从**上一次的答案**出发线性探路，8 步内命中就直接返回（绝大多数 1 步），
 * 探不到再把二分区间收窄到剩下那一半。 */
static u32 LF_HINT;

/* 叶子表的快照栈。
 *
 * 复合字面量落在别人的花括号初始化器里时，它会**再进一次**花括号引擎，而
 * 那一次一进来就 `LF_N = 0` 重建叶子表。外层这时正拿着同一张表往下走，
 * 被冲掉以后接着找下一个成员就报"结构体没有成员"（内核
 * include/linux/seq_buf.h:29 的 DECLARE_SEQ_BUF 正是这个形状）。所以进嵌套
 * 之前把外层那一段抄下来，出来再贴回去。 */
#define LF_SAVE_MAX 8
typedef struct LfSave {
    u32 n;
    u32 hint;
    int trunc;
    u32 *off;
    u32 *ty;
    u32 *bits;
    u32 *boff;
    u32 lv_ty[INIT_LV_MAX];      /* 层级栈也要抄：外层还原了 LV_DEPTH 之后
                                  * 还要按 LV_TY[LV_DEPTH-1] 找成员，内容被
                                  * 嵌套那一趟盖掉就会找错类型 */
    u32 lv_off[INIT_LV_MAX];
} LfSave;
static LfSave LF_SAVE[LF_SAVE_MAX];
static u32 LF_SAVE_DEPTH;

static void init_lf_save(void)
{
    LfSave *sv = NULL;
    u32 i = 0;

    if (LF_SAVE_DEPTH >= LF_SAVE_MAX)
        return;
    sv = &LF_SAVE[LF_SAVE_DEPTH++];
    sv->n = LF_N;
    sv->hint = LF_HINT;
    sv->trunc = LF_TRUNC;
    sv->off = NULL;
    sv->ty = NULL;
    sv->bits = NULL;
    sv->boff = NULL;
    for (i = 0; i < INIT_LV_MAX; i++) {
        sv->lv_ty[i] = LV_TY[i];
        sv->lv_off[i] = LV_OFF[i];
    }
    if (!LF_N)
        return;
    sv->off = arena_alloc(&A_main, (size_t)LF_N * sizeof(u32));
    sv->ty = arena_alloc(&A_main, (size_t)LF_N * sizeof(u32));
    sv->bits = arena_alloc(&A_main, (size_t)LF_N * sizeof(u32));
    sv->boff = arena_alloc(&A_main, (size_t)LF_N * sizeof(u32));
    for (i = 0; i < LF_N; i++) {
        sv->off[i] = LF_OFF[i];
        sv->ty[i] = LF_TY[i];
        sv->bits[i] = LF_BITS[i];
        sv->boff[i] = LF_BOFF[i];
    }
}

static void init_lf_restore(void)
{
    LfSave *sv = NULL;
    u32 i = 0;

    if (!LF_SAVE_DEPTH)
        return;
    sv = &LF_SAVE[--LF_SAVE_DEPTH];
    LF_N = sv->n;
    LF_HINT = sv->hint;
    LF_TRUNC = sv->trunc;
    for (i = 0; i < INIT_LV_MAX; i++) {
        LV_TY[i] = sv->lv_ty[i];
        LV_OFF[i] = sv->lv_off[i];
    }
    for (i = 0; i < sv->n; i++) {
        LF_OFF[i] = sv->off[i];
        LF_TY[i] = sv->ty[i];
        LF_BITS[i] = sv->bits[i];
        LF_BOFF[i] = sv->boff[i];
    }
}

static u32 init_leaf_at(u32 off)
{
    u32 lo = 0;
    u32 hi = LF_N;
    u32 h = LF_HINT;
    u32 q = 0;
    u32 k = 0;

    if (h > LF_N)
        h = LF_N;
    if (h < LF_N && LF_OFF[h] >= off) {
        /* 答案在 h 或更靠前 */
        q = h;
        while (k < 8 && q > 0 && LF_OFF[q - 1] >= off) {
            q--;
            k++;
        }
        if (q == 0 || LF_OFF[q - 1] < off) {
            LF_HINT = q;
            return q;
        }
        hi = q + 1;
    } else if (h < LF_N) {
        /* LF_OFF[h] < off：答案在 h 之后 */
        q = h;
        while (k < 8 && q < LF_N && LF_OFF[q] < off) {
            q++;
            k++;
        }
        if (q >= LF_N) {
            LF_HINT = LF_N;
            return LF_N;
        }
        if (LF_OFF[q] >= off) {
            LF_HINT = q;
            return q;
        }
        lo = q + 1;
    } else {
        /* 上次答案就是表尾：先往回收几步（常见的是 off 走出了表尾） */
        q = LF_N;
        while (k < 8 && q > 0 && LF_OFF[q - 1] >= off) {
            q--;
            k++;
        }
        if (q == 0 || LF_OFF[q - 1] < off) {
            LF_HINT = q;
            return q;
        }
        hi = q + 1;
    }
    while (lo < hi) {
        u32 m = (lo + hi) / 2;

        if (LF_OFF[m] < off)
            lo = m + 1;
        else
            hi = m;
    }
    LF_HINT = lo;
    return lo;
}

static u32 init_sub_n(u32 ty)
{
    if (ty_is_array(ty))
        return ty_array_n(ty);
    if (ty_is_agg(ty)) {
        u32 n = ty_member_n(ty);

        return (ty_is_union(ty) && n > 1) ? 1 : n;
    }
    return 0;
}

static u32 init_sub_ty(u32 ty, u32 i)
{
    return ty_is_array(ty) ? ty_target(ty) : ty_member(ty, i);
}

static u32 init_sub_off(u32 ty, u32 i)
{
    return ty_is_array(ty) ? i * ty_size(ty_target(ty)) : ty_member_off(ty, i);
}

static void init_mark(void)
{
    if (INIT_CUR + 1 > INIT_MAX)
        INIT_MAX = INIT_CUR + 1;
}

/* 写一个叶子。全局走数据段（带位域信息），局部走运行时地址。 */
static void init_store(u32 off, u32 ty, u32 bits, u32 boff)
{
    init_mark();
    if (INIT_IS_GLOB) {
        GLOB_BF_BITS = bits;
        GLOB_BF_BITOFF = boff;
        gen_glob_obj(INIT_GOFF, ty, off);
        GLOB_BF_BITS = 0;
        GLOB_BF_BITOFF = 0;
    } else if (bits) {
        /* 位域成员的初始化器不能"按字节写整个字"：`struct {unsigned a:3, b:5;}
         * x = {5, 17};` 两个成员落在同一个 4 字节字里，后写的会把先写的整个
         * 盖掉——读出来是 a=1 b=2（踩过）。按位宽/位偏移塞进去才和赋值一致
         * （赋值那条路走的就是 store_lval_bits）。 */
        u32 v = value_of(gen_assign());
        u32 vty = GEN_TY;

        if (vty != ty)
            v = gen_convert(v, vty, ty);
        store_lval_bits(gen_addr_off(INIT_ADDR, off), ty, bits, boff, v);
    } else {
        gen_init_obj(INIT_ADDR, ty, off);
    }
}

/* 把层栈重建到“游标位置的祖先链”：第 top 层是本次花括号自己的对象，
 * 往下每一层都是包含游标的那个子聚合，最深一层是游标叶子的直接父聚合。 */
static void init_sync(u32 top)
{
    u32 d = top + 1;

    while (d < INIT_LV_MAX && INIT_CUR < LF_N) {
        u32 pty = LV_TY[d - 1];
        u32 poff = LV_OFF[d - 1];
        u32 n = init_sub_n(pty);
        u32 i = 0;
        u32 sub = 0;
        int found = 0;

        for (i = 0; i < n; i++) {
            u32 st = init_sub_ty(pty, i);
            u32 so = poff + init_sub_off(pty, i);
            u32 sz = 0;
            u32 lo = init_leaf_at(so);

            /* 子对象的偏移是**递增**的（数组按元素、结构体按声明序），叶表也
             * 按偏移递增，所以 lo 一旦越过游标，后面的兄弟只会更靠后——
             * 直接停。tcc.c 里那些上千元素的静态表原来每个兄弟都要两次二分，
             * profiler 上 init_brace 的四成时间花在这两条 cmp 上。 */
            if (lo > INIT_CUR)
                break;
            sz = ty_size(st) ? ty_size(st) : 1;
            if (INIT_CUR < init_leaf_at(so + sz)) {
                sub = st;
                LV_TY[d] = st;
                LV_OFF[d] = so;
                found = 1;
                break;
            }
        }
        if (!found || ty_is_scalar(sub))
            break;
        d++;
    }
    LV_DEPTH = d;
}

/* 设计符链：`[i]` / `.name` 任意串联，返回最终目标的类型与绝对偏移 */
static int INIT_COLON;     /* 上一次设计符用的是上古 `name:` 写法（不需要 '='） */

/* `bits`/`boff`：设计符指到的是位域成员时带出位宽和位偏移——同字节里的几个
 * 位域 LF_OFF 一样，光按字节偏移找叶子会永远落到第一个（`.b = 3` 写进 `.a`）。 */
static int init_desig(u32 *ty, u32 *off, u32 *bits, u32 *boff)
{
    *bits = 0;
    *boff = 0;
    INIT_COLON = 0;
    for (;;) {
        /* 上古 GNU 写法：`{ a: 1, b: 2 }`（成员名 + 冒号） */
        if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(1), ":")) {
            const char *nm = tok_data(pa_cur());
            u32 nl = pa_cur()->len;
            u32 mty = 0;
            u32 moff = 0;

            pa_advance();
            pa_advance();                /* : */
            if (!ty_is_agg(*ty) || !agg_find_promoted(*ty, nm, nl, &mty, &moff)) {
                pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                return 0;
            }
            *ty = mty;
            *off += moff;
            *bits = AGG_FOUND_BITS;
            *boff = AGG_FOUND_BITOFF;
            INIT_COLON = 1;
            continue;
        }
        if (pa_accept_ch('[')) {
            u32 i = 0;
            u32 et = 0;

            i = (u32)const_expr();
            pa_expect_ch(']');
            if (!ty_is_array(*ty)) {
                pa_error("设计符 '[...]' 用在了非数组上");
                return 0;
            }
            et = ty_target(*ty);
            if (i >= ty_array_n(*ty))
                return 0;
            *ty = et;
            *off += i * ty_size(et);
            *bits = 0;
            *boff = 0;
            continue;
        }
        if (pa_accept_ch('.')) {
            const char *nm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
            u32 nl = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
            u32 mty = 0;
            u32 moff = 0;

            if (!nm) {
                pa_error("'.' 后面要成员名");
                return 0;
            }
            pa_advance();
            if (!ty_is_agg(*ty) || !agg_find_promoted(*ty, nm, nl, &mty, &moff)) {
                pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                return 0;
            }
            *ty = mty;
            *off += moff;
            *bits = AGG_FOUND_BITS;
            *boff = AGG_FOUND_BITOFF;
            continue;
        }
        break;
    }
    return 1;
}

static void init_body(u32 top);

static void init_brace(u32 ty, u32 off)
{
    u32 my = 0;

    pa_expect_ch('{');
    if (LV_DEPTH >= INIT_LV_MAX - 1) {
        skip_init_list();
        pa_expect_ch('}');
        return;
    }
    my = LV_DEPTH;
    LV_TY[my] = ty;
    LV_OFF[my] = off;
    LV_DEPTH = my + 1;
    init_body(my);
    /* 嵌套的 `{…}`（结构体元素）只把游标推到末尾、**不走** `init_store`，
     * 于是 `init_mark()` 没记账、`INIT_MAX` 一直是 0。不完整数组
     * （`static struct E t[] = {…}`）的长度就是按 `INIT_MAX` 算的，
     * 结果 `sizeof t` 是 0（std 的 mime 表靠 sizeof 数条目，一条都查不到）。
     * 这里按本层写到的最后位置补一次记账。 */
    if (INIT_CUR > INIT_MAX)
        INIT_MAX = INIT_CUR;
    LV_DEPTH = my;
    pa_expect_ch('}');
    /* 零字节的聚合成员（`struct {} empty;`）不占叶子，游标要**停在原地**：
     * 加 1 会把它推过下一个成员，`{ 1, (empty_s){}, 022 }` 里的 022 就被
     * 「游标走完了」那条早退吞掉了。 */
    INIT_CUR = init_leaf_at(off + (ty_size(ty) ? ty_size(ty) : (ty_is_agg(ty) ? 0 : 1)));
}

/* 跳过当前**表达式**的值：停在 ','、';' 或 '}' 前。
 * init_skip_value 只认花括号列表里的项（停在 ',' / '}'），用在声明级的
 * 初始化器上会把分号乃至下一条语句一起吞掉。 */
static void init_skip_expr(void)
{
    int depth = 0;
    int n = 0;

    while (pa_cur()->kind != TK_EOF && n < 100000) {
        Tok *t = pa_cur();

        if (depth == 0 && t->kind == TK_PUNCT
            && (tok_eq(t, ",") || TOK_EQ(t, "}") || tok_eq(t, ";")))
            return;
        if (t->kind == TK_PUNCT) {
            if (TOK_EQ(t, "{") || tok_eq(t, "(") || TOK_EQ(t, "["))
                depth++;
            else if (TOK_EQ(t, "}") || tok_eq(t, ")") || TOK_EQ(t, "]"))
                depth--;
        }
        pa_advance();
        n++;
    }
}

/* 跳过当前项的值（指示符出错后用），停在 ',' 或 '}' 前 */
static void init_skip_value(void)
{
    int depth = 0;
    int n = 0;

    while (pa_cur()->kind != TK_EOF && n < 100000) {
        Tok *t = pa_cur();

        if (depth == 0 && t->kind == TK_PUNCT && (tok_eq(t, ",") || TOK_EQ(t, "}")))
            return;
        if (t->kind == TK_PUNCT) {
            if (TOK_EQ(t, "{") || tok_eq(t, "(") || TOK_EQ(t, "["))
                depth++;
            else if (TOK_EQ(t, "}") || tok_eq(t, ")") || TOK_EQ(t, "]"))
                depth--;
        }
        pa_advance();
        n++;
    }
}

/* 当前停在 `[` 上：这一对方括号里有没有顶层的 `...`？（纯前瞻、只读）
 * 只在 `[` 到配对的 `]` 之间找，超出前瞻窗口（PA_LOOK 个 token）就当"不是
 * 区间设计符"——那种写法已经不是设计符的正常形状了。 */
static int pa_range_desig(void)
{
    int depth = 0;
    int i = 0;

    for (i = 0; i < PA_LOOK; i++) {
        Tok *t = pa_peek(i);

        if (t->kind == TK_EOF)
            return 0;
        if (t->kind != TK_PUNCT)
            continue;
        if (TOK_EQ(t, "["))
            depth++;
        else if (TOK_EQ(t, "]")) {
            depth--;
            if (depth == 0)
                return 0;      /* 方括号关上了，里面没有 `...` */
        } else if (depth == 1 && TOK_EQ(t, "...")) {
            return 1;
        }
    }
    return 0;
}

static void init_body(u32 top)
{
    int first = 1;

    for (;;) {
        if (pa_is_ch('}') || pa_cur()->kind == TK_EOF)
            break;
        if (!first && !pa_accept_ch(','))
            break;
        first = 0;
        if (pa_is_ch('}'))
            break;
        /* 游标走完了：多余的值吞掉别报错。但**设计符不算多余**——它会把
         * 游标拽回去（`{.b = 8, .a = 7}` 里第二个设计符是往回走的），
         * 早退会把它静默丢掉。 */
        if (INIT_CUR >= LF_N
            && !(pa_is_ch('[') || pa_is_ch('.')
                 || (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
                     && TOK_EQ(pa_peek(1), ":")))) {
            skip_init_list();
            break;
        }
        /* 区间设计符 `[lo ... hi] = v`。判据要**扫到配对的 `]`**，不能只看
         * 第 3 个 token：`[0 ... 3]` 能靠 `pa_peek(2) == "..."` 认出来，可
         * `[EP_OFFS(st) ... EP_OFFS(st) + EP_SIZE(st) - 1]`（内核
         * arch/x86/kernel/dumpstack_64.c 的 EPAGERANGE）下标是表达式，`...`
         * 在好几个 token 之后。 */
        if (pa_is_ch('[') && pa_range_desig()) {
            u32 bty = LV_TY[top];
            u32 boff = LV_OFF[top];
            u32 lo = 0;
            u32 hi = 0;
            u32 k = 0;

            pa_advance();
            lo = (u32)const_expr();
            pa_expect_punct("...");
            hi = (u32)const_expr();
            pa_expect_ch(']');
            pa_expect_ch('=');
            if (!ty_is_array(bty)) {
                pa_error("区间设计符只能用在数组上");
                init_skip_value();
                continue;
            }
            {
                u32 et = ty_target(bty);
                u32 esz = ty_size(et);
                u32 n = ty_array_n(bty);

                /* 值只求一次，然后抄给区间里的每个元素（C 就是这么规定的；
                 * `[6 ... 10] = elt` 里 elt 是个变量，重复解析根本做不到）。 */
                if (pa_is_ch('{')) {
                    /* `[0 ... 2] = {{3,4,5},{6,7,8}}`：花括号只能解析一次，
                     * 所以先填第一个元素，再把它的字节抄给区间里其余元素
                     * （数据段直接 memcpy；局部变量用 IR_MEMCPY）。 */
                    u32 blob = 0;

                    init_brace(et, boff + lo * esz);
                    blob = boff + lo * esz;
                    if (INIT_IS_GLOB) {
                        for (k = lo + 1; k <= hi && k < n; k++)
                            memcpy(DATA_IMG.p + INIT_GOFF + boff + k * esz,
                                   DATA_IMG.p + INIT_GOFF + blob, (size_t)esz);
                    } else {
                        for (k = lo + 1; k <= hi && k < n; k++) {
                            /* IR_MEMCPY 的 dst 是第一个操作数：写成 0 会把槽位 0
                             * 的内容当地址读，直接段错误。 */
                            u32 dv = gen_addr_off(INIT_ADDR, boff + k * esz);
                            u32 sv = gen_addr_off(INIT_ADDR, blob);

                            irfn_push(&FN, IR_MEMCPY, IRT_VOID, dv, sv,
                                      0, 0, esz);
                        }
                    }
                } else if (pa_cur()->kind == TK_STR && ty_is_ptr(et)) {
                    /* `[SMCA_CS ... SMCA_CS_V2] = "coherent_station"`：元素是
                     * 指针时字符串字面量给的是它的**地址**，区间里每个元素
                     * 都指向同一份数据（内核 arch/x86/kernel/cpu/mce/amd.c 的
                     * smca_names[] 就是这么写的）。 */
                    if (INIT_IS_GLOB) {
                        u32 so = str_lit_data();
                        u64 va = (u64)DATA_VA(so);

                        for (k = lo; k <= hi && k < n; k++)
                            glob_store(INIT_GOFF, boff + k * esz, et, va);
                    } else {
                        /* 局部数组：地址只能运行期算，先落到一个临时再逐元素存
                         * （字符串字面量本身在数据段里，取的是它的符号地址）。 */
                        u32 v = gen_string();
                        u32 vty = GEN_TY;

                        for (k = lo; k <= hi && k < n; k++)
                            store_conv(gen_addr_off(INIT_ADDR, boff + k * esz), et, v, vty);
                    }
                } else if (pa_cur()->kind == TK_STR && ty_is_array(et)
                           && ty_size(ty_target(et)) == 1) {
                    /* `[0 ... 3] = "??"`：字符串填的是**整个元素子对象**，和花括号
                     * 里那个形状一样。内核 fs/proc/task_mmu.c 的
                     *     static const char mnemonics[BITS_PER_LONG][3] = {
                     *         [0 ... (BITS_PER_LONG-1)] = "??", …
                     * 就栽在这里：值走到 const_expr，报"这里要一个常量表达式"。 */
                    u32 blob = boff + lo * esz;

                    if (INIT_IS_GLOB) {
                        gen_glob_obj(INIT_GOFF, et, blob);
                        for (k = lo + 1; k <= hi && k < n; k++)
                            memcpy(DATA_IMG.p + INIT_GOFF + boff + k * esz,
                                   DATA_IMG.p + INIT_GOFF + blob, (size_t)esz);
                    } else {
                        gen_init_obj(INIT_ADDR, et, blob);
                        for (k = lo + 1; k <= hi && k < n; k++) {
                            u32 dv = gen_addr_off(INIT_ADDR, boff + k * esz);
                            u32 sv = gen_addr_off(INIT_ADDR, blob);

                            irfn_push(&FN, IR_MEMCPY, IRT_VOID, dv, sv, 0, 0, esz);
                        }
                    }
                } else if (INIT_IS_GLOB && pa_is_punct("&&") && pa_peek(1)->kind == TK_IDENT) {
                    /* `[0 ... 31] = &&l_bad`：每个元素一条「代码标号」重定位 */
                    u32 l = goto_label(tok_data(pa_peek(1)), pa_peek(1)->len);

                    pa_advance();
                    pa_advance();
                    for (k = lo; k <= hi && k < n; k++)
                        code_lbl_fixup_add(INIT_GOFF + boff + k * esz,
                                           x64_cur_fnseq(&X64), l);
                } else if (INIT_IS_GLOB) {
                    Tok *vt = pa_cur();
                    Sym *gs = NULL;

                    /* 花括号初始化器里的 `( &((T *)0)->m[i] )`：外层 `(` 包着
                     * offsetof。整条交给 const_expr（它的 & 分支支持带下标成员
                     * 偏移），否则下面 `(void)pa_accept_ch('&')` 看不见 `&`、
                     * const_expr 又只吃到外层括号，留下悬空的 `)`。 */
                    {
                        u32 lp = 0;

                        while (pa_peek(lp) && pa_peek(lp)->kind == TK_PUNCT
                               && TOK_EQ(pa_peek(lp), "("))
                            lp++;
                        if (lp > 0 && pa_peek(lp) && pa_peek(lp)->kind == TK_PUNCT
                            && TOK_EQ(pa_peek(lp), "&")
                            && pa_peek(lp + 1) && pa_peek(lp + 1)->kind == TK_PUNCT
                            && TOK_EQ(pa_peek(lp + 1), "(")
                            && pa_peek(lp + 2) && pa_peek(lp + 2)->kind == TK_PUNCT
                            && TOK_EQ(pa_peek(lp + 2), "(")
                            && pa_peek(lp + 3) && is_typename_tok(pa_peek(lp + 3))
                            && pa_is_offsetof_ahead((int)lp + 3)) {
                            i64 offv = 0;
                            u32 j = 0;

                            for (j = 0; j < lp; j++)
                                pa_advance();
                            offv = const_expr();
                            for (j = 0; j < lp; j++)
                                pa_expect_ch(')');
                            for (k = lo; k <= hi && k < n; k++)
                                glob_store(INIT_GOFF, boff + k * esz, et, (u64)offv);
                            continue;
                        }
                    }
                    (void)pa_accept_ch('&');
                    vt = pa_cur();
                    if (vt->kind == TK_IDENT)
                        gs = sym_find(tok_data(vt), vt->len);
                    if (gs && (gs->kind == SC_GLOBAL || gs->is_func)) {
                        /* `[0 ... 3] = &func`：每个元素一条重定位 */
                        u32 sym = addr_sym_of(gs);
                        pa_advance();
                        for (k = lo; k <= hi && k < n; k++)
                            data_fixup_add(INIT_GOFF + boff + k * esz, sym);
                    } else {
                        i64 cv = const_expr();

                        for (k = lo; k <= hi && k < n; k++)
                            glob_store(INIT_GOFF, boff + k * esz, et, (u64)cv);
                    }
                } else {
                    u32 v = value_of(gen_assign());
                    u32 vty = cur_op_ty();

                    for (k = lo; k <= hi && k < n; k++)
                        store_conv(gen_addr_off(INIT_ADDR, boff + k * esz), et, v, vty);
                }
                /* 区间也要推进「推进到哪儿过」的标记，否则
                 * `void *t[] = {[0 ... 255] = &&l;}` 推不出 256 个元素，
                 * 数组只有 1 个长，越界读出来的是垃圾地址（跳到野指针）。
                 * 注意标记要按**最后一个元素**算：init_mark() 是 CUR+1，
                 * 而下面的游标已经指到区间后面去了，用它会多算一个元素。 */
                {
                    u32 last = init_leaf_at(boff + hi * esz);

                    if (last + 1 > INIT_MAX)
                        INIT_MAX = last + 1;
                }
                INIT_CUR = init_leaf_at(boff + (hi + 1) * esz);
            }
            continue;
        }
        if (pa_is_ch('[') || pa_is_ch('.')
            || (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(1), ":"))) {
            u32 dty = LV_TY[top];
            u32 doff = LV_OFF[top];
            u32 dbits = 0;
            u32 dboff = 0;
            u32 li = 0;

            if (!init_desig(&dty, &doff, &dbits, &dboff)) {
                init_skip_value();
                continue;
            }
            li = init_leaf_at(doff);
            if (dbits) {
                /* 位域：同字节的叶子要按**位偏移**再挑一次（见 init_desig 注释） */
                while (li < LF_N && LF_OFF[li] == doff && LF_BOFF[li] != dboff)
                    li++;
            }
            if (li < LF_N && LF_OFF[li] != doff)
                li = LF_N;
            INIT_CUR = li;
            if (!pa_accept_ch('=') && !INIT_COLON) {
                pa_error("设计符后面要 '='");
                init_skip_value();
                continue;
            }
            if (pa_is_ch('{')) {
                init_brace(dty, doff);
                continue;
            }
            if (ty_is_agg(dty) || ty_is_array(dty)) {
                /* `[0] = 5`：值落到子对象的第一个叶子（C 就是这么规定） */
                /* gen_glob_obj/gen_init_obj 处理复合字面量时会**重写整条层栈**
                 * （LV_TY/LV_OFF），回来以后本层的类型就变成子对象的了。
                 * 不保存/恢复的话，下一个设计符会拿子对象的类型去查成员——
                 * 内核 include/linux/semaphore.h 的
                 *     .lock = __RAW_SPIN_LOCK_UNLOCKED(...), .count = n
                 * （左边展开成 `(raw_spinlock_t){ … }`）就是这样报
                 * "结构体没有成员 'count'"。 */
                {
                    u32 save_ty[INIT_LV_MAX] = {0};
                    u32 save_off[INIT_LV_MAX] = {0};
                    u32 si = 0;

                    for (si = 0; si < INIT_LV_MAX; si++) {
                        save_ty[si] = LV_TY[si];
                        save_off[si] = LV_OFF[si];
                    }
                    if (INIT_IS_GLOB)
                        gen_glob_obj(INIT_GOFF, dty, doff);
                    else
                        gen_init_obj(INIT_ADDR, dty, doff);
                    for (si = 0; si < INIT_LV_MAX; si++) {
                        LV_TY[si] = save_ty[si];
                        LV_OFF[si] = save_off[si];
                    }
                }
                INIT_CUR = init_leaf_at(doff + (ty_size(dty) ? ty_size(dty) : 1));
                continue;
            }
            /* 用**设计符指到的那个成员**的类型（`dty`）落值，不能用叶表里
             * 那个叶子的类型：联合体在叶表里只登记第一个成员（C 规定不带
             * 设计符时只初始化第一个），于是 `union U a = { .f = 1.0f };`
             * 会按 `int` 存成 1，读 `a.f` 得到 5.6e-45 这种垃圾。 */
            /* 全局的**指针**成员优先走 gen_glob_obj：地址常量那套
             * （`&g`、`&g.m`、`(void *)&g[0]`、多套一层括号的分组）
             * 全在它里面，init_store 只会把整条当整数常量求值。
             * 内核 include/linux/sysctl.h 的 SYSCTL_ZERO（展开是
             * `((void *)&sysctl_vals[0])`）填进 struct ctl_table 的 .extra1
             * 就是这么落到 gen_glob_obj 的。 */
            if (INIT_IS_GLOB && ty_is_ptr(dty)) {
                /* 全局的**指针**成员优先走 gen_glob_obj：地址常量那套
                 * （`&g`、`&g.m`、`(void *)&g[0]`）全在它里面，init_store
                 * 只会把整条当整数常量求值。内核 include/linux/sysctl.h 的
                 * SYSCTL_ZERO（展开是 `((void *)&sysctl_vals[0])`）填进
                 * struct ctl_table 的 .extra1 就是这么落到这里的。
                 *
                 * 先剥掉**包住整个值**的分组括号：宏自身已经带了一对，
                 * 用到这里又套了一层，成了 `( (void *) &arr[0] )`。
                 * gen_glob_obj 里的 cast 剥离只认 "`(` 类型名"，看见 `((`
                 * 就停。判据很严——配对的 `)` 后面必须是 `,` / `}` / `;`，
                 * 也就是它确实包住了整个值。 */
                u32 grp = 0;

                for (;;) {
                    int dep = 0;
                    u32 scan = 0;
                    u32 endpos = 0;
                    int ok = 0;
                    Tok *after = 0;

                    if (!pa_is_ch('(') || !(pa_peek(1)->kind == TK_PUNCT
                                             && TOK_EQ(pa_peek(1), "(")))
                        break;
                    for (;;) {
                        Tok *t = pa_peek(scan);

                        if (!t || t->kind == TK_EOF)
                            break;
                        if (t->kind == TK_PUNCT) {
                            if (TOK_EQ(t, "(") || TOK_EQ(t, "["))
                                dep++;
                            else if (TOK_EQ(t, ")") || TOK_EQ(t, "]")) {
                                dep--;
                                if (dep == 0) {
                                    endpos = scan + 1;
                                    break;
                                }
                            }
                        }
                        scan++;
                    }
                    if (endpos == 0)
                        break;
                    after = pa_peek(endpos);
                    if (after->kind == TK_EOF)
                        ok = 1;
                    else if (after->kind == TK_PUNCT
                             && (TOK_EQ(after, ",") || TOK_EQ(after, "}")
                                 || TOK_EQ(after, ";")))
                        ok = 1;
                    if (!ok)
                        break;
                    pa_advance();
                    grp++;
                }
                gen_glob_obj(INIT_GOFF, dty, doff);
                while (grp-- > 0 && pa_is_ch(')'))
                    pa_advance();
            } else if (li < LF_N) {
                init_store(LF_OFF[li], dty, dbits, dboff);
            } else if (INIT_IS_GLOB) {
                gen_glob_obj(INIT_GOFF, dty, doff);
            } else {
                gen_init_obj(INIT_ADDR, dty, doff);
            }
            /* 游标推进了，"填到过哪儿"也要跟着推——`T x[] = { [0] = v }`
             * 的数组长度是 init_count_of() 按 INIT_MAX 数出来的。只有
             * init_store()（走 init_mark）会推；指针成员那条路走的是
             * gen_glob_obj（地址常量），不推的话 INIT_MAX 恒为 0，
             * 长度算成 0：`static const char *const counter_names[] = {
             * [A] = "…" }` 编出来 sizeof 是 0，内核 lib/stackdepot.c 的
             * `static_assert(ARRAY_SIZE(counter_names) == …)` 当场失败。 */
            if (li + 1 > INIT_MAX)
                INIT_MAX = li + 1;
            INIT_CUR = li + 1;
            continue;
        }
        /* 普通项 */
        init_sync(top);
        if (pa_cur()->kind == TK_STR) {
            /* 字符串填的是整个字符数组子对象，不是游标指向的那个字节 */
            u32 d = top + 1;
            u32 tty = 0;
            u32 toff = 0;
            int hit = 0;

            while (d < LV_DEPTH) {
                if (init_leaf_at(LV_OFF[d]) == INIT_CUR && ty_is_array(LV_TY[d])) {
                    tty = LV_TY[d];
                    toff = LV_OFF[d];
                    hit = 1;
                    break;
                }
                d++;
            }
            /* 花括号里直接一个字符串填**本层**数组：`char m[8] = { "abc" };`。
             * init_sync 只会往**子对象**里钻（数组的元素是标量，钻不下去），
             * 层栈里比本层深的位置没有数组可找，于是落到 const_expr 报
             * "这里要一个常量表达式"。内核 fs/coredump.c 的 core_modes[]、
             * fs/proc/task_mmu.c 的 mnemonics[][3] 都是这个形状。 */
            if (!hit && ty_is_array(LV_TY[top])
                && ty_size(ty_target(LV_TY[top])) == 1
                && init_leaf_at(LV_OFF[top]) == INIT_CUR) {
                tty = LV_TY[top];
                toff = LV_OFF[top];
                hit = 1;
            }
            if (hit) {
                u32 last = 0;

                if (INIT_IS_GLOB)
                    gen_glob_obj(INIT_GOFF, tty, toff);
                else
                    gen_init_obj(INIT_ADDR, tty, toff);
                last = init_leaf_at(toff + (ty_size(tty) ? ty_size(tty) : 1));
                /* 字符串填的是整个子对象，推进的叶子也要记进 INIT_MAX，
                 * 否则 `char m[][2][3] = {…, "abc"}` 会少算一个元素。 */
                if (last > INIT_MAX)
                    INIT_MAX = last;
                INIT_CUR = last;
                continue;
            }
        }
        /* `{ (char *)"html", … }`：字符串字面量外面套一层强转。以前只有裸
         * 字面量才认，套了 `(char *)` 就走到 const_expr，报"要一个常量表达式"
         * （std/net/mime.c6 的 mime_tab）。 */
        if (INIT_IS_GLOB && !pa_is_compound_lit() && pa_is_ch('(')
            && is_typename_tok(pa_peek(1)) && INIT_CUR < LF_N
            && ty_is_ptr(LF_TY[INIT_CUR])) {
            u32 li2 = INIT_CUR;

            (void)pa_take_paren_type();
            /* pa_take_paren_type 遇到 `(char *)` 会停在 `*` 上（指针归声明符管），
             * 所以 `*` 和 `)` 都自己吃掉 */
            for (;;) {
                if (pa_is_ch('*') || pa_is_ch(')')) {
                    pa_advance();
                    continue;
                }
                break;
            }
            if (pa_cur()->kind == TK_STR) {
                u32 so = str_lit_data();

                glob_store(INIT_GOFF, LF_OFF[li2], LF_TY[li2], (u64)DATA_VA(so));
                INIT_CUR = li2 + 1;
                continue;
            }
        }
        if (pa_is_compound_lit()) {
            /* 目标子对象如果正好从游标开始，就照常按花括号填；否则它属于
             * 一个零字节成员（`empty_s` 之类），没有字节要写。
             *
             * **指针叶子**在层级栈 LV_* 里没有自己的一层——`struct s v[] =
             * { { (int[]){1,2}, 2 } }` 里栈里最深那层还是外层的 struct，直接
             * 按它 `init_brace` 会把 `(int[]){1,2}` 的花括号体摊进第一个成员
             * 的槽（实测 v[0].p == 1、v[0].n == 2）。所以先看叶子表：当前叶子
             * 正好从最深那层的起点开始时，它就是复合字面量的目标。 */
            u32 d = top + 1;
            u32 tty = 0;
            u32 toff = 0;
            int hit = 0;

            if (pa_compound_lit_array_type() && INIT_CUR < LF_N
                && ty_is_ptr(LF_TY[INIT_CUR])
                && LV_DEPTH > 0 && LF_OFF[INIT_CUR] == LV_OFF[LV_DEPTH - 1]) {
                tty = LF_TY[INIT_CUR];
                toff = LF_OFF[INIT_CUR];
                hit = 1;
            }
            while (!hit && d < LV_DEPTH) {
                if (init_leaf_at(LV_OFF[d]) == INIT_CUR) {
                    tty = LV_TY[d];
                    toff = LV_OFF[d];
                    hit = 1;
                    break;
                }
                d++;
            }
            if (hit && ty_is_ptr(tty)) {
                /* `struct s v[] = { { (int[]){1,2}, 2 }, … }`：指针子对象的值是
                 * 复合字面量的**地址**，不能把花括号体摊进指针槽。 */
                u32 last2 = 0;

                if (INIT_IS_GLOB)
                    gen_glob_obj(INIT_GOFF, tty, toff);
                else
                    gen_init_obj(INIT_ADDR, tty, toff);
                last2 = init_leaf_at(toff + (ty_size(tty) ? ty_size(tty) : 1));
                if (last2 > INIT_MAX)
                    INIT_MAX = last2;
                INIT_CUR = last2;
            } else if (hit) {
                u32 ex = pa_take_paren_type();

                init_brace(tty, toff);
                while (ex--)
                    pa_expect_ch(')');
            } else {
                (void)pa_skip_empty_compound();
            }
            continue;
        }
        if (pa_is_ch('{')) {
            u32 d = top + 1;
            u32 tgt_ty = 0;
            u32 tgt_off = 0;
            int found = 0;

            /* 花括号绑定到“正好从游标处开始”的**最外层**子对象。
             *   QueryPair p[2] = { { {0,0}, {0,0}, 7 }, … }
             * 第一个 `{` 属于 p[0] 整个元素，不是更里层的成员 k——
             * 所以从 top+1 往上找第一个匹配，而不是从最深往下找。 */
            while (d < LV_DEPTH) {
                if (init_leaf_at(LV_OFF[d]) == INIT_CUR) {
                    tgt_ty = LV_TY[d];
                    tgt_off = LV_OFF[d];
                    found = 1;
                    break;
                }
                d++;
            }
            if (found) {
                init_brace(tgt_ty, tgt_off);
                continue;
            }
            /* 标量套花括号：{5}。多出来的项按 C 的规矩算“元素过多”，
             * 只填第一个、其余跳过（gcc 给警告，tcc 直接忽略）。 */
            {
                u32 li = INIT_CUR;

                pa_advance();
                if (!pa_is_ch('}')) {
                    if (li < LF_N)
                        init_store(LF_OFF[li], LF_TY[li], LF_BITS[li], LF_BOFF[li]);
                    else
                        skip_init_list();
                    while (pa_accept_ch(',')) {
                        if (pa_is_ch('}'))
                            break;
                        init_skip_value();
                    }
                }
                INIT_CUR = li + 1;
                pa_expect_ch('}');
            }
            continue;
        }
        /* 局部初始化器里的普通项：右值可能是**同类型的聚合变量**
         * （`struct U lu = {3, ls, 4, …}` 里的 `ls`），这时要整块拷，不能当成
         * 只填第一个叶子。先求值再看类型，两条路都不难走。 */
        if (!INIT_IS_GLOB) {
            u32 d2 = top + 1;
            u32 tty = 0;
            u32 toff = 0;
            u32 li = INIT_CUR;

            while (d2 < LV_DEPTH) {
                if (init_leaf_at(LV_OFF[d2]) == li && ty_is_agg(LV_TY[d2])) {
                    tty = LV_TY[d2];
                    toff = LV_OFF[d2];
                    break;
                }
                d2++;
            }
            if (tty) {
                u32 v = value_of(gen_assign());
                u32 vty = cur_op_ty();

                if (ty_is_agg(vty)) {
                    irfn_push(&FN, IR_COPY, IRT_U8,
                              gen_addr_off(INIT_ADDR, toff), v, 0, 0,
                              ty_size(tty));
                    INIT_CUR = init_leaf_at(toff + (ty_size(tty) ? ty_size(tty) : 1));
                    init_mark();
                    continue;
                }
                if (li < LF_N) {
                    store_conv(gen_addr_off(INIT_ADDR, LF_OFF[li]), LF_TY[li], v, vty);
                    INIT_CUR = li + 1;
                    init_mark();
                    continue;
                }
            }
        }
        init_store(LF_OFF[INIT_CUR], LF_TY[INIT_CUR], LF_BITS[INIT_CUR], LF_BOFF[INIT_CUR]);
        INIT_CUR++;
    }
}

/* 顶层数组长度补全：游标推进到第几个元素。返回 1 表示这个对象确实是
 * 顶层数组、长度有据可依（空初始化器也算，长度 0）。 */
static int init_count_of(u32 ty, u32 off, u32 *out)
{
    u32 esz = 0;
    u32 lpe = 0;

    if (!ty_is_array(ty) || off != 0)
        return 0;
    esz = ty_size(ty_target(ty));
    lpe = init_leaf_at(esz ? esz : 1);
    if (lpe == 0)
        return 0;
    *out = (INIT_MAX + lpe - 1) / lpe;
    return 1;
}

static void gen_glob_braced_new(u32 goff, u32 ty, u32 off)
{
    u32 save_cur = INIT_CUR;
    u32 save_max = INIT_MAX;
    int save_glob = INIT_IS_GLOB;
    u32 save_goff = INIT_GOFF;
    u32 save_depth = LV_DEPTH;
    u32 cnt = 0;

    init_lf_save();
    LF_N = 0;
    LF_TRUNC = 0;
    LF_HINT = 0;
    (void)init_leaf_walk(ty, off, 0, 0, 1);
    if (LF_TRUNC) {
        INIT_CUR = save_cur;
        init_lf_restore();
        pa_advance();                       /* 对象太大：退回旧实现 */
        gen_glob_braced(goff, ty, off);
        pa_expect_ch('}');
        return;
    }
    INIT_IS_GLOB = 1;
    INIT_GOFF = goff;
    INIT_CUR = 0;
    INIT_MAX = 0;
    LV_DEPTH = 0;
    init_brace(ty, off);
    if (init_count_of(ty, off, &cnt)) {
        INIT_COUNT = cnt;
        INIT_CNT_OK = 1;
    }
    INIT_CUR = save_cur;
    INIT_MAX = save_max;
    INIT_IS_GLOB = save_glob;
    INIT_GOFF = save_goff;
    LV_DEPTH = save_depth;
    init_lf_restore();
}

static void gen_local_braced_new(u32 addr, u32 ty, u32 off)
{
    u32 save_cur = INIT_CUR;
    u32 save_max = INIT_MAX;
    int save_glob = INIT_IS_GLOB;
    u32 save_addr = INIT_ADDR;
    u32 save_depth = LV_DEPTH;
    u32 cnt = 0;

    init_lf_save();
    LF_N = 0;
    LF_TRUNC = 0;
    LF_HINT = 0;
    (void)init_leaf_walk(ty, off, 0, 0, 1);
    if (LF_TRUNC) {
        INIT_CUR = save_cur;
        init_lf_restore();
        pa_advance();                       /* 对象太大：退回旧实现 */
        gen_init_braced(addr, ty, off);
        pa_expect_ch('}');
        return;
    }
    INIT_IS_GLOB = 0;
    INIT_ADDR = addr;
    INIT_CUR = 0;
    INIT_MAX = 0;
    LV_DEPTH = 0;
    init_brace(ty, off);
    if (init_count_of(ty, off, &cnt)) {
        INIT_COUNT = cnt;
        INIT_CNT_OK = 1;
    }
    INIT_CUR = save_cur;
    INIT_MAX = save_max;
    INIT_IS_GLOB = save_glob;
    INIT_ADDR = save_addr;
    LV_DEPTH = save_depth;
    init_lf_restore();
}

static void gen_init_obj(u32 addr, u32 ty, u32 off)
{
    if (ty_size(ty) == 0 && pa_skip_empty_compound())
        return;
    /* `int *p = (int[]){5,6};`：块作用域的复合字面量是**自动存储期**对象，
     * 长度和内容都得在运行期铺出来——交给表达式那条路（gen_assign）算地址再存。
     * 以前这里不看复合字面量自己的类型、直接按目标类型摊平花括号体，
     * `int *p = (int[]){5,6}` 编出来 p == 5（读 p[0] 段错误）。 */
    if (ty_is_ptr(ty) && pa_is_compound_lit()) {
        u32 cv = value_of(gen_assign());

        store_conv(gen_addr_off(addr, off), ty, cv, GEN_TY);
        return;
    }
    if (pa_is_compound_lit()) {
        u32 ex = pa_take_paren_type();

        gen_local_braced_new(addr, ty, off);
        while (ex--)
            pa_expect_ch(')');
        return;
    }
    /* 标量上的花括号：`(int){5}`、`{ {5} }`。C 允许给标量套花括号，
     * 但叶子引擎只吃聚合，所以这里自己剥一层（多出来的项按 GNU 语义忽略）。 */
    if (!ty_is_agg(ty) && !ty_is_array(ty) && pa_is_ch('{')) {
        pa_advance();
        gen_init_obj(addr, ty, off);
        while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF) {
            if (!pa_accept_ch(','))
                break;
            if (pa_is_ch('}'))
                break;
            init_skip_value();
        }
        pa_expect_ch('}');
        return;
    }
    /* 复数：右值不是花括号时按 C99 6.7.8p13 处理——实数就填 `{v, 0}`，
     * 复数就整块拷。走 store_conv 是为了和赋值共用一套转换规则。 */
    if (ty_is_cplx(ty) && !pa_is_ch('{')) {
        u32 cv = value_of(gen_assign());

        store_conv(gen_addr_off(addr, off), ty, cv, GEN_TY);
        return;
    }
    if (ty_is_agg(ty) || ty_is_array(ty)) {
        if (pa_is_ch('{')) {
            gen_local_braced_new(addr, ty, off);
            return;
        }
        if (ty_is_array(ty) && pa_cur()->kind == TK_STR) {
            u32 src = gen_string();
            u32 a2 = gen_addr_off(addr, off);
            u32 n = ty_size(ty);
            /* 最内层的标量宽度：`char[2][3] = "abc"` 是按**字节**填的，
             * 用 ty_target 的宽度（char[3] = 3）会多拷两倍。 */
            u32 esc = ty;
            u32 esz = 1;
            u32 nc = 0;

            while (ty_is_array(esc))
                esc = ty_target(esc);
            esz = ty_size(esc) ? ty_size(esc) : 1;
            nc = (STR_LIT_N + 1) * esz;   /* 字面量 + 结尾的 NUL */

            /* 字符串只填前 STR_LIT_N+1 个字节，**其余的要自己清零**：
             * 数据段天然是零所以全局看着没事，局部数组不零就是上个栈帧的垃圾
             * （`char c[16] = "hello"` 的后 10 个字节全是脏的）。 */
            if (nc > n)
                nc = n;
            gen_zero_obj(a2, n);
            INIT_COUNT = STR_LIT_N + 1;   /* `char s[] = "…"` 的元素个数 */
            irfn_push(&FN, IR_COPY, IRT_U8, a2, src, 0, 0, nc);
            return;
        }
        /* 不是花括号：两种可能——同类型的聚合表达式（`struct S s = t;` /
         * `= (struct S){...}`，整块拷），或花括号省略（`{0}` 只给第一个叶子，其余
         * 已经清零了）。先求值，再看表达式自己的类型决定走哪条。 */
        {
            u32 et = ty_is_array(ty) ? ty_target(ty) : 0;
            u32 eo = 0;
            u32 v = 0;
            u32 ety = 0;
            u32 arr_len = 0;
            u32 lit_len = 0;
            int src_ptr = 0;    /* 初始化器的源是个真指针（不是数组/切片） */

            if (!ty_is_array(ty)) {
                if (ty_member_n(ty) == 0) {
                    /* 零字节的聚合当初始化目标：有些结构体在某些配置下就是
                     * 空的（内核 include/linux/userfaultfd_k.h 的
                     * `struct vm_userfaultfd_ctx {}`），拿它初始化没有字节要
                     * 写，把初始化器跳过就行（gcc 一直接受
                     * `struct empty x = {};` 和 `= 另一个 empty 对象`）。 */
                    init_skip_expr();
                    return;
                }
                et = ty_member(ty, 0);
                eo = ty_member_off(ty, 0);
            }

            /* `{0}` 落到"第一个叶子"是聚合（union/数组）时不能再走 store_conv：
             * 那会把标量当聚合指针整块 IR_COPY（从地址 0 读 16 字节）——tcc 的
             * `jmp_buf main_jb = {0}` 正是这样一进函数就段错误。局部聚合在声明时
             * 已经 gen_zero_obj 清零过，这里什么都不用生成。 */
            /* 这一支是"花括号省略"（`struct S s = 0;`，只给第一个叶子）。
             * 但右边整个就是同类型的聚合值（`struct S s = t;`、`= (struct S){…}`）
             * 时不能走这儿：那会只初始化**第一个成员**——第一个成员自己也是聚合
             * 时（`struct S { struct P p; int z; }`）就只拷了前 8 字节，z 永远是 0。 */
            {
                int whole = 0;

                if (pa_is_compound_lit())
                    whole = 1;
                else if (pa_cur()->kind == TK_IDENT) {
                    Sym *ws = sym_find(tok_data(pa_cur()), pa_cur()->len);

                    if (ws && (ty_is_agg(ws->type) || ty_is_array(ws->type)))
                        whole = 1;
                    /* `struct S s = f();`：f 按地址返回整个聚合 */
                    else if (ws && ws->is_func && ty_is_agg(ty_target(ws->type)))
                        whole = 1;
                }
                if (!whole && (ty_is_agg(et) || ty_is_array(et))) {
                    /* 往下走一层到真正的标量叶子再存：直接 store_conv 会把标量当成
                     * 聚合指针整块 IR_COPY（从地址 0 读十几字节），tcc 的
                     * `jmp_buf main_jb = {0}` 就是这样一进函数就段错误。 */
                    gen_init_obj(addr, et, off + eo);
                    return;
                }
            }
            {
                /* 数组左值在求值时会退化成指针，长度信息就没了——先看一眼
                 * 这个标识符本身是不是数组。 */
                Tok *nt = pa_cur();

                if (nt->kind == TK_IDENT) {
                    Sym *as = sym_find(tok_data(nt), nt->len);

                    if (as && ty_is_array(as->type))
                        arr_len = ty_array_n(as->type);
                    else if (as && ty_is_ptr(as->type) && !ty_is_slice(as->type))
                        src_ptr = 1;
                } else if (nt->kind == TK_STR) {
                    /* `char[:] m = "hello";`——字符串字面量的长度含结尾 NUL，
                     * 正好是 token 文本去掉开头引号后的字节数。 */
                    lit_len = nt->len - 1;
                }
            }
            v = value_of(gen_assign());
            ety = GEN_TY;
            /* 切片 ← 数组/指针：`int[:] s = arr;` 要现搭一个 `{ptr, len}`，
             * 直接 IR_COPY 16 字节只会把数组头两个元素当指针和长度。 */
            if (ty_is_slice(ty) && (ty_is_array(ety) || ty_is_ptr(ety))) {
                u32 a2 = gen_addr_off(addr, off);
                u32 dv = irfn_vreg(&FN);
                u32 lv = irfn_vreg(&FN);
                u32 a8 = 0;
                /* 切片只能从数组（或字符串字面量）来：元素类型要对得上，
                 * 长度得是已知的。数组在表达式里已经退化成了指针，所以
                 * "源是数组"靠 `arr_len`（声明处记下的长度）和 `ety` 是不是
                 * 数组类型两个线索；两个都没有、而源本身是个指针符号
                 * （`src_ptr`）就是真的在拿指针建切片，得写 `(T[:]){p, n}`。
                 * 赋值路径也会走到这里（两侧都是切片），那种情况三个线索全空，
                 * 一律不查——查了就是误报（std/container/pqueue.c6 就是）。 */
                if (ty_is_array(ety)) {
                    u32 se0 = ty_slice_elem(ty);

                    if (ty_array_n(ety) == 0)
                        pa_error("不能切一个长度未知的数组");
                    else if (ty_target(ety) != se0)
                        pa_error("切片的元素类型和数组对不上");
                } else if (arr_len) {
                    if (ty_is_ptr(ety) && ty_target(ety) != ty_slice_elem(ty))
                        pa_error("切片的元素类型和数组对不上");
                } else if (src_ptr) {
                    pa_error("不能从指针建切片，长度哪儿来？用 '(T[:]){p, n}'");
                }

                if (ty_is_array(ety)) {
                    irfn_push(&FN, IR_CONST, IRT_U64, lv, 0, 0, 0,
                              ty_array_n(ety) ? ty_array_n(ety) : 1);
                    irfn_push(&FN, IR_MOV, IRT_PTR, dv, v, 0, 0, 0);
                } else if (arr_len) {
                    /* 数组在表达式中已经退化成指针了，长度得从声明处拿 */
                    irfn_push(&FN, IR_CONST, IRT_U64, lv, 0, 0, 0, arr_len);
                    irfn_push(&FN, IR_MOV, IRT_PTR, dv, v, 0, 0, 0);
                } else {
                    irfn_push(&FN, IR_MOV, IRT_PTR, dv, v, 0, 0, 0);
                    irfn_push(&FN, IR_CONST, IRT_U64, lv, 0, 0, 0, lit_len);
                }
                store_conv(a2, ty_ptr(ty_slice_elem(ty)), dv, ty_ptr(ty_slice_elem(ty)));
                a8 = gen_addr_off(addr, off + 8);
                store_conv(a8, ty_ulong(), lv, ty_ulong());
                return;
            }
            if (ty_is_agg(ety) || ty_is_array(ety)) {
                u32 a2 = gen_addr_off(addr, off);

                irfn_push(&FN, IR_COPY, IRT_U8, a2, v, 0, 0, ty_size(ty));
                return;
            }
            store_conv(gen_addr_off(addr, off + eo), et, v, ety);
            return;
        }
    }
    {
        u32 v = gen_assign();
        u32 vty = cur_op_ty();
        u32 a2 = gen_addr_off(addr, off);

        v = value_of(v);
        store_conv(a2, ty, v, vty);
    }
}


static void gen_one_global(u32 ty, Declarator *d);

static void gen_one_local(u32 ty, Declarator *d)
{
    Sym *s = NULL;
    int decl_static = PA_STATIC;      /* 块作用域的 `static`：初始化器必须是常量 */

    char udiag_name[160] = {0};      /* 诊断里打印的类型名（`struct Node`） */
    int udiag_nlen = 0;

    if (!d->name) {
        /* 语句位置上的 `void(int x);`：看着像函数字面量却没有体
         * （tests/errors/fn_lit.c6 的 test_no_body）。 */
        if (ty_is_func(ty) && in_c6_tu())
            pa_error("'{' expected: the body of the function literal");
        return;   /* `struct S { ... };`：只有类型定义 */
    }
    /* 块作用域的 `extern T x;`（内核 init_vmlinux_build_id / WARN 等宏里大量
     * 使用）：只是引用别处定义的全局符号，**不能**在栈上开槽初始化成 0——
     * 那样 &x 拿到栈地址、*x 永远是 0，导致 `&__start_notes - &__stop_notes`
     * 算出 0、buildid 解析读空指针而崩。走和文件作用域 extern 一样的路：
     * 登记一个带重定位的全局引用。 */
    if (PA_EXTERN && !ty_is_func(ty)) {
        Sym *er = sym_find(d->name, d->nlen);

        if (er && er->kind == SC_GLOBAL && er->goff && !er->tls_ref) {
            er->is_extern = 1;
        } else if (!er || er->kind != SC_GLOBAL) {
            Sym *r2 = sym_add(d->name, d->nlen, ty, SC_GLOBAL);

            r2->is_extern = 1;
            r2->val = (i64)x64_data_ref(&X64, r2->name);
        }
        /* extern 声明不许带初始化器；即便带了（GCC 里是定义）也跳过其值，
         * 避免解析器状态错乱。 */
        if (pa_accept_ch('='))
            init_skip_value();
        return;
    }
    /* c6：变量声明就得初始化（静态局部、extern 例外——它们在数据段里，
     * 本来就是 0）。这跟 C 的"未初始化是未定义值"不是一回事：c6 认为读
     * 一个没写过初值的变量一定是 bug。 */
    if (in_c6_tu() && !PA_TMPL_BODY && !PA_SIG_ONLY && !PA_STATIC && !PA_EXTERN && !ty_is_func(ty)
        && !d->vla && !pa_is_ch('=') && !pa_is_ch('{'))
        pa_error("variable '%s' must be initialized",
                 arena_strndup(&A_main, d->name, d->nlen));
    if (in_c6_tu() && !PA_SIG_ONLY && !d->mgd && ty_has_mgd(ty)) {
        char dnm[160] = {0};

        agg_disp_name(ty, dnm, sizeof(dnm));
        pa_error("'%s' holds managed references: a declared object is not possible. "
                 "Allocate it with 'new' and hold it in '@%s'", dnm, dnm);
    }
    if (d->vla) {
        if (CUR_TASK_TY)
            pa_error("async 函数里不能用变长数组（任务结构要能整块搬）");
        /* 变长数组：在栈上现开 d->vla_cnt * d->vla_esz 字节，把指针存进槽。
         * 槽里放指针而不是数组本身，所以下标、传参、赋值全都走普通指针路径。
         * rsp 由函数尾声的 leave（mov rsp, rbp）恢复，不需要逐块回收。 */
        u32 p = irfn_vreg(&FN);

        if (SCOPE && !SCOPE->vla_save) {
            /* 记下这个块进来时的 rsp：换一块 VLA 就要能整体回收，
             * 循环体里的 VLA 才会每次拿到同一个地址。 */
            u32 z = irfn_vreg(&FN);

            SCOPE->vla_save = irfn_vreg(&FN);
            irfn_push(&FN, IR_CONST, IRT_U64, z, 0, 0, 0, 0);
            irfn_push(&FN, IR_ALLOCA, IRT_PTR, SCOPE->vla_save, z, 0, 0, 1);
        }
        /* 多维 VLA（`int b[n][m]`）的"元素大小"是运行期算出来的行 stride，
         * IR_ALLOCA 的 imm 字段装不下——总字节数已经在声明处乘好了
         * （d->vla_bytes），这里 imm 传 1，让它直接开这么多字节。 */
        if (d->vla_multi)
            irfn_push(&FN, IR_ALLOCA, IRT_PTR, p, d->vla_bytes, 0, 0, 1);
        else
            irfn_push(&FN, IR_ALLOCA, IRT_PTR, p, d->vla_cnt, 0, 0, d->vla_esz);
        s = sym_add(d->name, d->nlen, ty, SC_LOCAL);
        s->vla_cnt = d->vla_cnt;
        s->vla_esz = d->vla_esz;
        if (d->vla_multi) {
            int k = 0;

            s->vla_nd = d->vla_nd;
            for (k = 0; k + 1 < (int)d->vla_nd && k < 8; k++)
                s->vla_str[k] = d->vla_str[k];
        }
        s->slot = irfn_vreg(&FN);
        irfn_push(&FN, IR_ADDR, IRT_PTR, s->slot, 0, 0, 0, X64_SLOT(s->slot));
        irfn_push(&FN, IR_STORE, IRT_U64, s->slot, p, 0, 0, 0);
        return;
    }
    if (ty_is_func(ty)) {
        /* 块作用域的函数声明（`void f(void);` / `extern void f(void);`）：
         * 登记成全局符号，块里不分配存储。符号按名字 intern，所以文件后面
         * 真正的定义会落在同一个 ELF 符号上（tcc tests2 105_local_extern）。
         * 名字要跟**文件作用域**那条声明走：它要是 `static`，落点就是带
         * TU 后缀的发射名——129_scopes 里 `{ int f6(int); … }` 的 f6 在文件
         * 作用域是 static，按裸名字查就指向镜像里不存在的符号。 */
        const char *nm = arena_strndup(&A_main, d->name, d->nlen);
        Sym *fs = sym_find(nm, d->nlen);

        if (!fs || !fs->is_func) {
            Sym *top = sym_find_file_scope(nm, d->nlen);

            fs = sym_add(nm, d->nlen, ty, SC_GLOBAL);
            fs->is_func = 1;
            if (top && top->is_func && top->is_static) {
                fs->is_static = 1;
                fs->val = (i64)x64_sym(&X64, emit_name(tu_static_name(nm)));
                X64.sym[(u32)fs->val].is_static = 1;
            } else {
                fs->val = (i64)x64_sym(&X64, emit_name(nm));
            }
        }
        return;
    }
    if (PA_STATIC) {
        /* 静态局部：数据段一块存储，名字加后缀避免重名，再以原名登记到
         * 当前作用域（SC_GLOBAL 的寻址走 goff/数据符号，正是我们要的）。 */
        Declarator sd = *d;
        char *nm = arena_alloc(&A_main, 192);
        Sym *gs = NULL;
        Sym *ls = NULL;

        snprintf(nm, 192, "%s.%u", FN.name ? FN.name : "static", NSTATIC++);
        sd.name = nm;
        sd.nlen = (u32)strlen(nm);
        /* 初始化器里可能会**自引用**（`static struct list_head y =
         * LIST_HEAD_INIT(y);`）：这时的符号只按改名后的 `nm` 存在，先把原名
         * 挂上待定表，gen_one_global 回来再撤掉。 */
        sa_pending_push(d->name, d->nlen, nm);
        gen_one_global(ty, &sd);
        sa_pending_pop();
        gs = sym_find(nm, sd.nlen);
        if (!gs)
            return;
        /* 局部 static 改名成 `<函数>.<N>` 后走 gen_one_global，那条路的
         * `char s[]="lit"` 分支按普通全局创建数据符号、没设 STB_LOCAL。
         * 两个 TU 的同名 static 局部变量会 multiple definition（内核里
         * `task_index_to_char.4` 就是这样撞的）。这里按新名字补本地化。 */
        if ((u32)gs->val < X64.nsym)
            X64.sym[(u32)gs->val].is_static = 1;
        gs->is_static = 1;
        ls = sym_add(d->name, d->nlen, gs->type, SC_GLOBAL);
        ls->goff = gs->goff;
        ls->val = gs->val;
        return;
    }
    if (ty_is_array(ty) && ty_array_n(ty) == 0) {
        /* `char s[] = "abc"` / `int a[] = {1,2,3}`：长度由初始化器定。
         * 花括号体先整个抓下来数一遍（`init_bound_count`），按数出来的条数
         * 开帧槽；填完再按 `INIT_COUNT` 收到真实长度。早先按 1 KB 估，
         * 元素一多就静默截断。 */
        u32 et = ty_target(ty);
        u32 esz = ty_size(et) ? ty_size(et) : 1;
        u32 capn = (1024u / esz) ? (1024u / esz) : 1;
        u32 cnt = 0;
        Tok *body = NULL;
        u32 nbody = 0;

        if (pa_is_ch('=') && pa_peek(1)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(1), "{")) {
            {
                u32 bodycap = 0;

                pa_advance();              /* 吃掉 `=`，游标停到 `{` */
                nbody = body_capture(&body, &bodycap);
            }
            capn = CAP_BOUND;
            if (capn == 0)
                capn = 1;
        }
        s = sym_add(d->name, d->nlen, ty_array(et, capn), SC_LOCAL);
        s->slot = frame_slots_for(capn * esz);
        gen_zero_obj(ident_addr(s), capn * esz);
        if (body) {
            pa_src_push_back(body, nbody);
            gen_init_obj(ident_addr(s), ty_array(et, capn), 0);
            cnt = INIT_CNT_OK ? INIT_COUNT : capn;
            /* `int a[] = {};` 是 GNU 的 0 元素数组（sizeof 为 0） */
            s->type = ty_array(et, cnt);
            return;
        }
        if (pa_accept_ch('=')) {
            gen_init_obj(ident_addr(s), ty_array(et, capn), 0);
            cnt = INIT_CNT_OK ? INIT_COUNT : capn;
            s->type = ty_array(et, cnt);
            return;
        }
        s->type = ty_array(et, cnt ? cnt : 1);
        return;
    }
    /* 接口局部量：`Shape s = q;` 要走 {self, vt} 的转换，不能当聚合整块拷。
     * （聚合拷贝会把源的第一字段塞进 self、vt 留空，一调方法就跳野指针。） */
    if (NIFACE > 0 && ty_is_iface(ty, NULL)) {
        s = sym_add(d->name, d->nlen, ty, SC_LOCAL);
        s->slot = frame_slots_for(ty_size(ty));
        gen_zero_obj(ident_addr(s), ty_size(ty));
        if (pa_accept_ch('=')) {
            if (pa_is_ch('{')) {
                gen_init_obj(ident_addr(s), ty, 0);
            } else {
                u32 r0 = gen_assign();
                u32 vty = cur_op_ty();

                store_conv(ident_addr(s), ty, value_of(r0), vty);
            }
        }
        return;
    }
    /* `__auto_type x = expr;`：类型就是 expr 的类型（GNU 扩展）。
     *
     * 必须在 sym_add **之前**把占位换成真类型——符号表、帧槽大小、之后所有
     * 类型检查都读 s->type。初始化表达式在这里就解析掉，值和类型存进
     * PA_AUTO_V / PA_AUTO_VTY，下面的正常路径看到 PA_AUTO_HAVE 就直接用。
     * **不能**"先探一遍类型再把游标退回去重解析"：表达式可能有副作用
     * （函数调用、自增），解析两遍就是执行两遍。 */
    if (PA_AUTO_PENDING) {
        PA_AUTO_PENDING = 0;
        if (!pa_is_ch('=')) {
            pa_error("'__auto_type' needs an initializer to deduce the type from");
            ty = ty_int();
        } else {
            pa_advance();              /* 吃掉 '=' */
            /* 先 gen_assign 再 value_of：左值要在这里就读出来（`auto x = y;`
             * 的 y 是个槽，不 load 拿到的是地址），浮点字面量的类型也要到
             * 取值那一步才定。 */
            PA_AUTO_V = value_of(gen_assign());
            PA_AUTO_VTY = GEN_TY;
            PA_AUTO_HAVE = 1;
            ty = PA_AUTO_VTY;
            /* 数组/函数退化成指针，与 C 的 auto 一致 */
            if (ty_is_array(ty))
                ty = ty_ptr(ty_target(ty));
            else if (ty_is_func(ty))
                ty = ty_ptr(ty);
        }
    }
    s = sym_add(d->name, d->nlen, ty, SC_LOCAL);
    agg_disp_name(ty_is_ptr(ty) ? ty_target(ty) : ty, udiag_name, sizeof(udiag_name));
    udiag_nlen = (int)strlen(udiag_name);
    /* bf16 和聚合一样**只放内存**：值是 f32、对象是 2 字节，摊在 vreg 槽里
     * 之后任何一次"取地址再读"（实参、spill、三元）都会按 f32 写 4 字节、
     * 按 bf16 读 2 字节，读到的是 f32 的低半截（1.5f → 0x0000）。走帧槽以后
     * 所有读写都经过 load_lval/store_lval 的 2 字节通路，口子只有一个。 */
    if (ty_is_agg(ty) || ty_is_array(ty) || ty_kind(ty) == TY_BF16) {
        u32 sz = ty_size(ty);

        s->slot = frame_slots_for(sz);
        /* `@T a[N]` / 带托管字段的聚合局部量也是托管量：不标上的话，之后
         * `a[0] = new T` 会被当成普通指针赋值，`new` 出来的引用直接被
         * 语句末尾的临时清理放掉（踩过：托管元素数组的 foreach 测试
         * live 减到 -2）。 */
        if (d->mgd) {
            s->is_mgd = (u8)(d->mgd_kind == 1 ? 2 : 1);
            s->is_shared = d->mgd_shared;
            s->is_own = (u8)(d->mgd_kind == 2 ? 1 : 0);
        }
        gen_zero_obj(ident_addr(s), sz);
        if (pa_accept_ch('='))
            gen_init_obj(ident_addr(s), ty, 0);
    } else {
        s->slot = irfn_vreg(&FN);
        if (PA_AUTO_HAVE) {
            /* `__auto_type x = expr;`：值和类型在声明开头就算好了，这里只负责
             * 转换 + 存槽。 */
            u32 av = PA_AUTO_V;
            u32 aty = PA_AUTO_VTY;

            PA_AUTO_HAVE = 0;
            store_conv(ident_addr(s), ty, av, aty);
            return;
        }
        if (ty == ty_thread() && !pa_is_ch('='))
            pa_error("task/thread 声明要带初始化器，类型从初始化器推出来");
        if (pa_accept_ch('=')) {
            u32 r0 = 0;
            u32 vty = 0;
            int rmgd = 0;
            u32 r = 0;

            PA_DECL_INIT_MGD = (u8)(d->mgd ? 2 : 1);
            E_CLOSURE_LIT = 0;
            E_NEW_SEEN = 0;
            E_NEW_SHARED = 0;
            {
                Tok *i0 = pa_cur();
                int is_null = 0;

                r0 = gen_assign();
                /* 闭包对象要现开一块内存，不是常量表达式：`static`/文件作用域
                 * 的闭包只能用 `NULL` 起步（tests/errors/closure_convert.c6 的
                 * test_static / test_static_local）。 */
                if (i0 && i0->kind == TK_NUM && tok_data(i0)[0] == '0')
                    is_null = 1;
                if (i0 && i0->kind == TK_IDENT
                    && (TOK_EQ(i0, "NULL") || TOK_EQ(i0, "nullptr")))
                    is_null = 1;
                /* 初始化器开头就写 `static` / `async`：这是函数字面量的存储类
                 * / 协程修饰，字面量两样都不允许（tests/errors/fn_lit.c6）。 */
                if (i0 && i0->kind == TK_IDENT && in_c6_tu()) {
                    if (TOK_EQ(i0, "static") || TOK_EQ(i0, "extern"))
                        pa_error("a function literal cannot have a storage class");
                    else if (TOK_EQ(i0, "async"))
                        pa_error("a function literal cannot be 'async'");
                }
                if (decl_static && !is_null && in_c6_tu()
                    && (ty_is_closure(ty, NULL)
                        || (ty_is_ptr(ty) && ty_is_closure(ty_target(ty), NULL))))
                    pa_error("a closure is not a constant expression: initialize it at "
                             "run time ('NULL' is fine at file scope)");
            }
            PA_DECL_INIT_MGD = 0;
            /* `shared @T p = new T;`：对象不是原子的（`new shared T` 才是），
             * 放进 shared 槽就是自欺欺人。 */
            if (d->mgd_shared && E_NEW_SEEN && !E_NEW_SHARED && in_c6_tu())
                pa_error("a 'shared' slot needs an object with an atomic count");
            vty = cur_op_ty();
            rmgd = (PEND_LVAL && PEND_MGD);
            closure_lit_check(ty);
            r = value_of(r0);
            /* `task t = …` 的类型是从初始化器推出来的：不是 async 调用
             * 就没法当任务句柄用（tests/errors/async.c6 的 test_task_init）。 */
            if ((ty == ty_thread() || ty_is_taskh(ty)) && vty != ty
                && !ty_is_task_ptr(vty))
                pa_error("the initializer of a 'task' variable must be a call of "
                         "an 'async' function");

            /* 托管引用的来源就那么几种：`new`、另一个托管引用、`@f"…"`、
             * 空值。拿普通指针（`&n`、`Node *q`）去初始化 `@T` 等于凭空
             * 造一个引用，计数就乱了；`own @T` 只接管新引用。 */
            if (in_c6_tu() && d->mgd && d->mgd_kind != 1 && !mgd_tmp_has(r)
                && !E_WAS_CALL) {
                if (d->mgd_kind == 2 && rmgd)
                    pa_error("'own @%.*s' takes ownership: only a fresh reference ('new') "
                             "or the empty value can be stored in it",
                             udiag_nlen, udiag_name);
                else if (!rmgd && E_WAS_ADDR && ty_is_ptr(vty)
                         && !ty_is_ptr(ty_target(ty)) && ty_target(vty) == ty_target(ty))
                    pa_error("cannot assign a '%.*s *' to '@%.*s': a managed reference is "
                             "only made by 'new', by another managed reference, by '@f\"..\"' "
                             "or by the empty value", udiag_nlen, udiag_name,
                             udiag_nlen, udiag_name);
            }
            /* 反过来：`T *p = new T;` 把新引用塞进普通指针，没人释放它。 */
            if (in_c6_tu() && !d->mgd && mgd_tmp_has(r) && ty_is_ptr(ty) && !E_WAS_CALL)
                pa_error("a new reference cannot be stored in '%.*s *': it is not a "
                         "managed reference (declare it as '@T')",
                         udiag_nlen, udiag_name);
            /* 初始化也要做隐式转换：`float f = <double 字面量>` 必须真的转成
             * float，`char c = 300` 也必须截断（槽是 8 字节，不截就带着 300 走）。 */
            if (ty_is_closure(ty, NULL))
                r = clos_conv(r, vty);
            else if (vty != ty)
                r = gen_convert(r, vty, ty);
            /* 托管引用：`@T p = q` 要先加计数；`new T` 的结果本来就是个引用，
             * 所有权直接转给 p。weak 不加计数、也不在退出时释放。 */
            if (d->mgd && d->mgd_kind == 1) {
                /* 弱引用：只登记槽，不加计数、不拥有对象 */
                s->is_mgd = 2;
                irfn_push(&FN, IR_MOV, ir_ty_of(ty), s->slot, r, 0, 0, 0);
                mgd_weak(ident_addr(s), r);
                return;
            }
            if (d->mgd && d->mgd_kind != 1) {
                /* 右值是另一个托管左值（`@T q = p`）才加计数；`new T` 或者
                 * 返回 `@T` 的调用结果本身就是一份新引用，所有权直接过来。 */
                if (rmgd) {
                    if (!mgd_tmp_take(r))
                        mgd_retain(r);
                } else {
                    (void)mgd_tmp_take(r);
                }
                s->is_mgd = 1;
                s->is_shared = d->mgd_shared;
                s->is_own = (u8)(d->mgd_kind == 2 ? 1 : 0);
                mgd_defer_push(s->slot);
            }
            irfn_push(&FN, IR_MOV, ir_ty_of(ty), s->slot, r, 0, 0, 0);
            /* `task t = f(...)`：句柄管的是任务本身的生命周期，离开作用域要
             * `__c6_co_destroy()`——挂起着就让体回卷（defer/errdefer 都跑、
             * 帧里的托管引用放掉），跑完的顺手回收。tests/task_method.c6 和
             * tests/async_frame.c6 的"作用域退出 → 回卷"就靠这条。 */
            if (ty_is_taskh(ty))
                task_defer_push(s->slot);
        } else {
            irfn_push(&FN, IR_CONST, IRT_U64, s->slot, 0, 0, 0, 0);
            if (d->mgd && d->mgd_kind != 1) {
                s->is_mgd = 1;
                mgd_defer_push(s->slot);
            }
        }
    }
}

static void gen_cleanup_defer(Sym *vs, Sym *cs);

static void gen_local_decl(int need_semi)
{
    if (0)
        fprintf(stderr, "[dbgL] 声明起点 %.*s\n", (int)pa_cur()->len, tok_data(pa_cur()));
    u32 base = 0;

    /* `__label__ name1, name2;`：GNU 的**局部标签声明**。
     *
     * 内核 include/linux/uaccess.h:668 的 unsafe_get_user()/unsafe_put_user()
     * 宏用它把 asm goto 的目标限定在块作用域里。c6c 的标签本来就是函数
     * 作用域、名字直接可用，所以这条声明只是把名字吃干净。 */
    if (PA_ACCEPT_IDENT("__label__")) {
        while (pa_cur()->kind == TK_IDENT
               || (pa_cur()->kind == TK_PUNCT && TOK_EQ(pa_cur(), ",")))
            pa_advance();
        if (need_semi)
            pa_expect_ch(';');
        return;
    }
    if (PA_ACCEPT_IDENT("typedef")) {
        /* 块作用域的 typedef（`typedef enum { e, f } h;` 写在函数里很常见）。
         * 声明符表可以有多个，和文件作用域那条一样（C89 6.5.7）。 */
        Declarator d2 = {0};
        u32 b2 = parse_typespec();
        u32 t2 = 0;

        for (;;) {
            memset(&d2, 0, sizeof(d2));
            t2 = parse_declarator(b2, &d2);
            if (d2.name)
                sym_add(d2.name, d2.nlen, t2, SC_TYPEDEF);
            if (!pa_accept_ch(','))
                break;
        }
        if (need_semi)
            pa_expect_ch(';');
        return;
    }
    PA_STATIC = 0;
    PA_EXTERN = 0;
    base = parse_typespec();
    {
        int base_mgd_ptr = PA_MGD_PTR;      /* `@T a, b;` 的 @ 要给每个声明符 */
        int base_mgd_kind = PA_MGD_KIND;
        /* 写在**说明符**位置上的 cleanup 属性对这条声明的每个声明符都生效：
         * `__attribute__((cleanup(f))) char a = 'o', b = 'a';` 两个都要清
         * （gcc 就是这么做的，tcc tests2/101_cleanup 的 `c: a` 靠这条）。
         * 写在声明符自己身上（`int a, b __attribute__((cleanup(f)));`）的
         * 只作用于那个声明符，所以每个声明符重新扫一遍、扫到就用扫到的。 */
        const char *base_cleanup = SAW_CLEANUP;
        u32 base_cleanup_len = SAW_CLEANUP_LEN;

        SAW_CLEANUP = NULL;
    for (;;) {
        Declarator d = {0};
        u32 ty = 0;
        const char *dc = 0;
        u32 dcl = 0;

        skip_attributes();
        PA_VLA_OK = 1;
        PA_MGD_PTR = base_mgd_ptr;
        PA_MGD_KIND = base_mgd_kind;
        ty = parse_declarator(base, &d);
        /* 块作用域同理（`static n;` 这类隐式 int 声明） */
        if (PA_II_PENDING && !d.is_func)
            pa_warn_tcc("type defaults to int");
        PA_II_PENDING = 0;
        PA_VLA_OK = 0;
        gen_one_local(ty, &d);
        dc = SAW_CLEANUP ? SAW_CLEANUP : base_cleanup;
        dcl = SAW_CLEANUP ? SAW_CLEANUP_LEN : base_cleanup_len;
        SAW_CLEANUP = NULL;
        if (dc && d.name) {
            Sym *vs = sym_find(d.name, d.nlen);
            Sym *cs = sym_find(dc, dcl);

            if (vs && cs && cs->is_func)
                gen_cleanup_defer(vs, cs);
        }
        if (!pa_accept_ch(','))
            break;
    }
    if (need_semi)
        pa_expect_ch(';');
    }
}

static void gen_vla_restore(void);

static void gen_vla_loop_push(void)
{
    /* 调用点在 `NLOOP++` 之后，而循环自己的槽位是 NLOOP - 1
     * （和 break/continue 读 LOOP_BRK[NLOOP - 1] 一致）。 */
    if (NLOOP > 0 && NLOOP - 1 < PA_MAXLOOP) {
        LOOP_VLA[NLOOP - 1] = 0;
        LOOP_BODY[NLOOP - 1] = NULL;
        /* 默认：循环自己不带作用域，break 的清理边界是 LOOP_DFB + 1
         * （= 循环体的深度）。`for` 会在 init 声明外面再开一层作用域，
         * 那两处调用点随后把它改成 1。 */
        LOOP_OWN[NLOOP - 1] = 0;
        LOOP_SW[NLOOP - 1] = 0;
    }
}

/* break/continue：回到进入这个循环时的保存点 */
static void gen_vla_restore_loop(void)
{
    Scope *b = NLOOP > 0 ? LOOP_BODY[NLOOP - 1] : NULL;

    if (b && b->vla_save)
        irfn_push(&FN, IR_SETRSP, IRT_VOID, 0, b->vla_save, 0, 0, 0);
    else
        gen_vla_restore();
}

/* 跳出 VLA 作用域（break/continue/goto）前把 rsp 还原到最近的保存点。
 * 取**最内层**保存点是安全的：跳转只会往外跳，内层保存点一定在外层之内。 */
static void gen_vla_restore(void)
{
    Scope *sc = SCOPE;

    for (; sc; sc = sc->up)
        if (sc->vla_save) {
            irfn_push(&FN, IR_SETRSP, IRT_VOID, 0, sc->vla_save, 0, 0, 0);
            return;
        }
}

/* ---------- defer / errdefer ----------
 * 清理体在**注册时**就照常解析一遍（顺便算类型、分配 vreg），把这段 IR 抄进
 * 私有缓冲区再从流里撤掉；每个出口再把它们插回去。同一段体会在多条出口各出现
 * 一份，所以里面的标签 id 每次都要重新分配。 */
/* 每帧最多多少条 defer/errdefer 记录。以前是 64，`tcc tests2` 的 101_cleanup
 * 用宏展开了几万条 cleanup，直接越过上限（现象是编译不报错但跑起来崩）。
 * 4096 条 × 每条几个指针，代价是 BSS 里几十 KB。 */
#define DEFER_MAX 4096

static IrOp *DF_OPS[DEFER_MAX];
static u32 DF_CNT[DEFER_MAX];
static int DF_SCOPE[DEFER_MAX];
static int DF_ERR[DEFER_MAX];
/* 释放某个帧槽里此刻的值，然后把槽清零（每轮迭代收尾用：先清零再放，
 * 万一释放过程里又回到这条路径也不会重复放）。 */
static void mgd_release_slot(u32 slot)
{
    u32 a = irfn_vreg(&FN);
    u32 v = irfn_vreg(&FN);
    u32 z = irfn_vreg(&FN);

    irfn_push(&FN, IR_ADDR, IRT_PTR, a, 0, 0, 0, X64_SLOT(slot));
    irfn_push(&FN, IR_LOAD, IRT_PTR, v, a, 0, 0, 0);
    irfn_push(&FN, IR_CONST, IRT_U64, z, 0, 0, 0, 0);
    irfn_push(&FN, IR_STORE, IRT_PTR, a, z, 0, 0, 0);
    mgd_release(v);
}

/* 给某个帧槽里此刻的值加一次计数（数组元素绑定时用）。 */
static void mgd_retain_slot(u32 slot)
{
    u32 a = irfn_vreg(&FN);
    u32 v = irfn_vreg(&FN);

    irfn_push(&FN, IR_ADDR, IRT_PTR, a, 0, 0, 0, X64_SLOT(slot));
    irfn_push(&FN, IR_LOAD, IRT_PTR, v, a, 0, 0, 0);
    mgd_retain(v);
}

static int DF_MGD[DEFER_MAX];    /* 托管局部量的释放体 */
static u32 DF_MSLOT[DEFER_MAX];  /* 它释放的那个槽 */
#define MGD_NO_SLOT 0xFFFFFFFFu
static u32 DF_EXCEPT = MGD_NO_SLOT;   /* `return p` 交出去的那个槽：跳过释放 */
static int NDF;
static int DEF_DEPTH;          /* 块嵌套深度：函数体是 1 */
static int LOOP_DFB[PA_MAXLOOP];   /* 进循环时的 DEF_DEPTH */
/* 当前块的**祖先链**：BLK_CHAIN[d] 是现在第 d 层那个块的编号。
 * goto 要判断"跳到标号时到底退出了哪几层"，光比深度不够——标号可能和
 * goto 同一深度、但在**兄弟块**里（tcc tests2/101_cleanup 的 `goto outside;`
 * 就是这样：goto 在外层 if 的块里、标号在另一个 if 的嵌块里、深度还更深），
 * 只比深度会一条清理都不跑。所以标号定义时把当时的链抄一份，goto 时求公共
 * 前缀，分叉点以上的层就是要退出的层。 */
#define BLK_MAXDEPTH 128
static u32 BLK_CHAIN[BLK_MAXDEPTH];
static u32 BLK_SEQ;            /* 块编号发号器 */

/* 进了新的一层块：给它发一个新编号（编号只用来判"是不是同一个块"）。 */
static void blk_chain_push(void)
{
    if (DEF_DEPTH < BLK_MAXDEPTH)
        BLK_CHAIN[DEF_DEPTH] = ++BLK_SEQ;
}

/* 标号定义时把当前的块链抄一份（内存从 arena 拿，一条几十字节）。
 * 层数超过 BLK_MAXDEPTH 就不抄，goto 那边退回"按深度"的老算法。 */
static void blk_chain_save(u32 gi, int depth);

/* `__attribute__((cleanup(fn)))`：作用域退出时调 `fn(&变量)`（和 C 的语义
 * 一致：按声明的逆序）。
 *
 * 这里**不能**学 defer 那样"登记时复制一份 IR"：tcc 的 tests2/101_cleanup.c
 * 用宏把这条声明展开了六万多遍，一条一份 IR 既费内存又越上限。所以只记
 * (槽位, 函数)，到作用域出口就地发。 */
typedef struct ClRec {
    int depth;
    u32 slot;
    u32 fnval;
    u32 fnty;
} ClRec;

#define CL_MAX 262144
static ClRec *CL_RECS;
static u32 CL_N;

static void gen_cleanup_defer(Sym *vs, Sym *cs)
{
    if (!CL_RECS) {
        CL_RECS = (ClRec *)malloc(sizeof(ClRec) * CL_MAX);
        if (CL_RECS)
            memset(CL_RECS, 0, sizeof(ClRec) * CL_MAX);
    }
    if (!CL_RECS || CL_N >= CL_MAX) {
        pa_error("cleanup 太多");
        return;
    }
    CL_RECS[CL_N].depth = DEF_DEPTH;
    CL_RECS[CL_N].slot = vs->slot;
    CL_RECS[CL_N].fnval = (u32)cs->val;
    CL_RECS[CL_N].fnty = cs->type;
    CL_N++;
}

/* 作用域出口：发出 depth >= from_scope 的那些（pop=1 时一并弹掉） */
static void cleanup_run(int from_scope, int pop)
{
    u32 i = CL_N;

    u32 av = 0;
    u32 dst = 0;
    int have = 0;

    /* 虚寄存器只有 16 位（65535 个），六万多条 cleanup 一条三个就爆了——
     * 这些序列互不重叠，两条临时槽复用到底。 */
    while (i > 0 && CL_RECS[i - 1].depth >= from_scope) {
        i--;
        if (!have) {
            av = irfn_vreg(&FN);
            dst = irfn_vreg(&FN);
            have = 1;
        }
        irfn_push(&FN, IR_ADDR, IRT_PTR, av, 0, 0, 0, X64_SLOT(CL_RECS[i].slot));
        irfn_push(&FN, IR_ARG, IRT_U64, 0, av, 0, 0, 0);
        irfn_push(&FN, IR_CALL, ir_ty_of(ty_target(CL_RECS[i].fnty)), dst, 0, 0, 0,
                  CL_RECS[i].fnval);
        FN.ops[FN.n - 1].narg = 1;
    }
    if (pop)
        CL_N = i;
}

static u32 defer_map_label(u32 *oldl, u32 *newl, int *nl, u32 id)
{
    int i = 0;

    for (i = 0; i < *nl; i++)
        if (oldl[i] == id)
            return newl[i];
    if (*nl >= 64)
        return id;
    oldl[*nl] = id;
    newl[*nl] = irfn_label(&FN);
    (*nl)++;
    return newl[*nl - 1];
}

static void defer_emit(int idx)
{
    u32 oldl[64] = {0};
    u32 newl[64] = {0};
    int nl = 0;
    u32 k = 0;

    for (k = 0; k < DF_CNT[idx]; k++) {
        IrOp o = DF_OPS[idx][k];
        u8 m = o.op < IRK_N ? IR_LABELS[o.op] : 0;

        if (m & IRF_A)
            o.a = defer_map_label(oldl, newl, &nl, o.a);
        if (m & IRF_B)
            o.b = defer_map_label(oldl, newl, &nl, o.b);
        if (m & IRF_C)
            o.c = defer_map_label(oldl, newl, &nl, o.c);
        irfn_push(&FN, o.op, o.type, o.dst, o.a, o.b, o.c, o.imm);
        /* narg/flags 不在 irfn_push 的参数里（IR_CALL/IR_CALLI 的实参个数就在
         * narg 上），抄的时候必须一起带过来，否则清理体里的调用变成 0 个实参。 */
        FN.ops[FN.n - 1].narg = o.narg;
        FN.ops[FN.n - 1].flags = o.flags;
    }
}

/* 托管局部量的清理体：等价于在声明处写 `defer { __c6_gc_release(p); }`。
 * 走 defer 这套的好处是 return / break / err 传播那几条路径自动带上它。 */
static void mgd_defer_push(u32 slot_v)
{
    u32 start = 0;
    u32 nops = 0;

    if (NDF >= DEFER_MAX)
        return;
    if (getenv("C6C_DBG_DF"))
        fprintf(stderr, "[df] mgd slot=%u depth=%d\n", (unsigned)slot_v, DEF_DEPTH);
    start = FN.n;
    /* 退出时要放的是**那个槽里此刻的值**，不是声明时的快照——`@Tree l =
     * new Tree; … l = NULL;` 之后，快照里还是已经被 move 走/放掉的老对象
     * （踩过：own 树测试里 gc_live 一路减到 -2）。 */
    {
        u32 sa = irfn_vreg(&FN);
        u32 sv = irfn_vreg(&FN);

        irfn_push(&FN, IR_ADDR, IRT_PTR, sa, 0, 0, 0, X64_SLOT(slot_v));
        irfn_push(&FN, IR_LOAD, IRT_PTR, sv, sa, 0, 0, 0);
        mgd_release(sv);
    }
    nops = FN.n - start;
    DF_CNT[NDF] = nops;
    DF_OPS[NDF] = arena_alloc(&A_main, (size_t)(nops ? nops : 1) * sizeof(IrOp));
    if (nops)
        memcpy(DF_OPS[NDF], &FN.ops[start], (size_t)nops * sizeof(IrOp));
    DF_SCOPE[NDF] = DEF_DEPTH;
    DF_ERR[NDF] = 0;
    DF_MGD[NDF] = 1;
    DF_MSLOT[NDF] = slot_v;
    NDF++;
    FN.n = start;
}

/* 任务句柄的清理体：等价于 `defer { __c6_co_destroy(t); }`。
 * 和托管引用一样取**槽里此刻的值**（`t = NULL` 之后块尾就是空操作）。 */
static void task_defer_push(u32 slot_v)
{
    u32 start = 0;
    u32 nops = 0;

    if (NDF >= DEFER_MAX)
        return;
    start = FN.n;
    {
        u32 sa = irfn_vreg(&FN);
        u32 sv = irfn_vreg(&FN);
        u32 cv = irfn_vreg(&FN);

        irfn_push(&FN, IR_ADDR, IRT_PTR, sa, 0, 0, 0, X64_SLOT(slot_v));
        irfn_push(&FN, IR_LOAD, IRT_PTR, sv, sa, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, sv, 0, 0, 0);
        irfn_push(&FN, IR_CALL, IRT_VOID, cv, 0, 0, 0,
                  x64_sym(&X64, "__c6_co_destroy"));
        FN.ops[FN.n - 1].narg = 1;
    }
    nops = FN.n - start;
    DF_CNT[NDF] = nops;
    DF_OPS[NDF] = arena_alloc(&A_main, (size_t)(nops ? nops : 1) * sizeof(IrOp));
    if (nops)
        memcpy(DF_OPS[NDF], &FN.ops[start], (size_t)nops * sizeof(IrOp));
    DF_SCOPE[NDF] = DEF_DEPTH;
    DF_ERR[NDF] = 0;
    DF_MGD[NDF] = 0;
    DF_MSLOT[NDF] = slot_v;
    NDF++;
    FN.n = start;
}

/* 执行并弹出所有 scope >= from_scope 的清理体（逆序）。
 * on_error 为真时 errdefer 也跑（错误路径：errdefer 与 defer 一起逆序执行）。 */
static void defer_run(int from_scope, int on_error)
{
    int i = NDF;
    int was_defer = PA_IN_DEFER;

    cleanup_run(from_scope, 0);
    PA_IN_DEFER = 1;

    /* 只有**块正常结束**时才把登记表弹掉（pop=1）。return / break / continue /
     * goto 只是"从这条路径上也执行一遍"——代码发完就完了，登记表不能动，
     * 否则循环体里的 defer 第一轮之后就没有了（静态发射，运行时每轮都会跑到
     * 同一段代码）。 */
    while (i > 0 && DF_SCOPE[i - 1] >= from_scope) {
        i--;
        if (DF_MGD[i] && DF_MSLOT[i] == DF_EXCEPT)
            continue;
        if (on_error || !DF_ERR[i])
            defer_emit(i);
    }
    PA_IN_DEFER = was_defer;
}

/* 只给 gen_block 用：执行并弹出。块是**正常结束**的，所以 errdefer 一条都
 * 不该跑，而且跑完就丢掉——出了这个块以后再 `return err(...)` 不能回头把
 * 已经失效的 errdefer 翻出来执行（tests/defer_scope.c6 的第 2 条）。 */
static void defer_run_pop(int from_scope)
{
    int i = NDF;

    cleanup_run(from_scope, 1);
    while (i > 0 && DF_SCOPE[i - 1] >= from_scope) {
        i--;
        if (DF_MGD[i] && DF_MSLOT[i] == DF_EXCEPT)
            continue;
        if (!DF_ERR[i])
            defer_emit(i);
    }
    NDF = i;
}

/* c6 元组解构（只能写成语句）：
 *   `(int q, int r) = f();`   声明 + 赋值
 *   `(q, r) = f();`           给现成的左值赋值
 * 右边是一个元组值（在我们的约定里聚合值就是地址），按成员偏移逐个搬。 */
static void gen_destructure(void)
{
    u32 pat_ty[8] = {0};       /* 非 0：声明式，类型是这个 */
    u32 pat_addr[8] = {0};     /* 左值式：目标的地址 */
    u32 pat_lty[8] = {0};      /* 左值式：目标的类型 */
    const char *pat_nm[8] = {0};
    u32 pat_nl[8] = {0};
    int pat_drop[8] = {0};
    u32 n = 0;
    u32 v = 0;
    u32 vty = 0;
    u32 k = 0;

    pa_advance();                      /* '(' */
    for (;;) {
        if (n >= 8) {
            pa_error("元组解构最多 8 个元素");
            return;
        }
        if (is_typename_tok(pa_cur())) {
            /* `(int q, …)`：类型 + 名字 */
            u32 ty = parse_typespec();

            while (pa_accept_ch('*'))
                ty = ty_ptr(ty);
            if (pa_cur()->kind != TK_IDENT) {
                pa_error("解构模式里要一个名字");
                return;
            }
            pat_nm[n] = tok_data(pa_cur());
            pat_nl[n] = pa_cur()->len;
            pat_drop[n] = (pa_cur()->len == 1 && pat_nm[n][0] == '_');
            pat_ty[n] = ty;
            pa_advance();
        } else if (pa_cur()->kind == TK_IDENT && pa_cur()->len == 1
                   && tok_data(pa_cur())[0] == '_'
                   && pa_peek(1)->kind == TK_PUNCT
                   && (tok_eq(pa_peek(1), ",") || tok_eq(pa_peek(1), ")"))) {
            /* `(_, r) = f();`：`_` 表示丢掉这个元素 */
            pat_drop[n] = 1;
            pa_advance();
        } else {
            /* `(q, r)` / `(arr[0], arr[1])`：普通左值 */
            u32 lv = gen_assign();

            if (!PEND_LVAL && !(pat_drop[n] = 0)) {
                pa_error("解构目标不是左值");
                return;
            }
            pat_addr[n] = PEND_ADDR;
            pat_lty[n] = PEND_TY;
            PEND_LVAL = 0;
            (void)lv;
        }
        n++;
        if (pa_accept_ch(','))
            continue;
        pa_expect_ch(')');
        break;
    }
    pa_expect_ch('=');
    /* 所有元素都是 `_`：这个解构什么都不做（tests/errors/tuple.c6 的
     * test_all_discard）。 */
    {
        u32 nd = 0;
        u32 kd = 0;

        for (kd = 0; kd < n; kd++)
            if (pat_drop[kd])
                nd++;
        if (n > 0 && nd == n)
            pa_error("'tuple' discards every element");
    }
    v = value_of(gen_assign());
    vty = cur_op_ty();
    pa_expect_ch(';');
    if (!ty_is_agg(vty)) {
        pa_error("解构的右边不是元组");
        return;
    }
    if (ty_member_n(vty) != n) {
        pa_error("解构的元素个数和元组不一致（%u vs %u）", (unsigned)n,
                 (unsigned)ty_member_n(vty));
        return;
    }
    for (k = 0; k < n; k++) {
        u32 mty = ty_member(vty, k);
        u32 moff = ty_member_off(vty, k);
        u32 val = 0;

        if (pat_ty[k] == 0 && pat_addr[k] == 0)
            continue;                  /* `_`：丢掉 */
        val = load_lval(gen_addr_off(v, moff), mty);
        if (pat_ty[k]) {
            Sym *ls = sym_add(pat_nm[k], pat_nl[k], pat_ty[k], SC_LOCAL);

            ls->slot = frame_slots_for(ty_size(pat_ty[k]) ? ty_size(pat_ty[k]) : 8);
            store_conv(ident_addr(ls), pat_ty[k], val, mty);
        } else {
            store_conv(pat_addr[k], pat_lty[k], val, mty);
        }
    }
}

static void gen_block(void)
{
    pa_expect_ch('{');
    scope_enter();
    DEF_DEPTH++;
    blk_chain_push();
    if (NLOOP > 0 && NLOOP - 1 < PA_MAXLOOP && !LOOP_BODY[NLOOP - 1])
        LOOP_BODY[NLOOP - 1] = SCOPE;
    while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF)
        gen_stmt();
    defer_run_pop(DEF_DEPTH);
    DEF_DEPTH--;
    if (SCOPE && SCOPE->vla_save)
        irfn_push(&FN, IR_SETRSP, IRT_VOID, 0, SCOPE->vla_save, 0, 0, 0);
    scope_leave();
    pa_expect_ch('}');
}

static void gen_switch(void)
{
    u32 cv = 0;
    u32 ins_at = 0;
    int si = 0;
    SwState *st = NULL;
    IrOp *chain = NULL;
    u32 nchain = 0;
    u32 i = 0;
    int sw_uns = 0;

    if (NSW >= SW_MAX) {
        pa_error("switch 嵌套太深（上限 %d）", SW_MAX);
        return;
    }
    pa_expect_ch('(');
    cv = value_of(gen_expr());
    /* case 区间比较的符号性跟 switch 表达式一致：`case 10^18ULL ... 10^19ULL`
     * 用有符号的 jle 会把上界当负数，整个区间恒不匹配（踩过）。 */
    sw_uns = !ty_is_signed(GEN_TY);
    pa_expect_ch(')');
    si = NSW++;
    st = &SW[si];
    memset(st, 0, sizeof(*st));
    st->cv = cv;
    st->ins_at = FN.n;
    st->def_lbl = irfn_label(&FN);
    st->end_lbl = irfn_label(&FN);
    LOOP_BRK[NLOOP] = st->end_lbl;
    /* switch 里的 continue 要落到外层循环头上（有的话） */
    LOOP_CNT[NLOOP] = NLOOP > 0 ? LOOP_CNT[NLOOP - 1] : st->end_lbl;
    LOOP_DFB[NLOOP] = DEF_DEPTH;
    NLOOP++;
    gen_vla_loop_push();
    LOOP_SW[NLOOP - 1] = 1;       /* switch 不是循环：continue 要跳过它 */
    mv_loop_enter();
    gen_stmt();
    mv_loop_leave();
    NLOOP--;
    NSW--;
    /* 生成分发链：cmp cv, lo; br eq body / 下一条 */
    chain = arena_zalloc(&A_main, (size_t)(st->ncase * 8 + 16) * sizeof(IrOp));
    for (i = 0; i < st->ncase; i++) {
        SwCase *c = &st->cs[i];
        u32 lnext = irfn_label(&FN);
        u32 t = irfn_vreg(&FN);

        if (!c->is_range) {
            u32 cnd = irfn_vreg(&FN);
            IrOp *o = NULL;

            chain[nchain].op = IR_CONSTK;      /* case 值可能是 64 位 */
            chain[nchain].type = IRT_U64;
            chain[nchain].dst = t;
            chain[nchain].imm = irfn_kconst(&FN, c->lo);
            nchain++;
            o = &chain[nchain];
            o->op = IR_CMP;
            o->type = IRT_U64;
            o->dst = cnd;
            o->a = cv;
            o->b = t;
            o->flags = IRCC_EQ;    /* CMP 的条件码放在 flags 里（不是 imm） */
            nchain++;
            o = &chain[nchain];
            o->op = IR_BR;
            o->a = cnd;
            o->b = c->lbl;
            o->c = lnext;
            nchain++;
        } else {
            u32 lchk = irfn_label(&FN);
            u32 c1 = irfn_vreg(&FN);
            u32 t2 = irfn_vreg(&FN);
            u32 c2 = irfn_vreg(&FN);
            IrOp *o = NULL;

            chain[nchain].op = IR_CONSTK;      /* case 值可能是 64 位 */
            chain[nchain].type = IRT_U64;
            chain[nchain].dst = t;
            chain[nchain].imm = irfn_kconst(&FN, c->lo);
            nchain++;
            o = &chain[nchain];
            o->op = IR_CMP;
            o->type = IRT_U64;
            o->dst = c1;
            o->a = cv;
            o->b = t;
            o->flags = sw_uns ? IRCC_UGE : IRCC_GE;
            nchain++;
            o = &chain[nchain];
            o->op = IR_BR;
            o->a = c1;
            o->b = lchk;
            o->c = lnext;
            nchain++;
            chain[nchain].op = IR_LABEL;
            chain[nchain].a = lchk;
            nchain++;
            chain[nchain].op = IR_CONSTK;      /* case 值可能是 64 位 */
            chain[nchain].type = IRT_U64;
            chain[nchain].dst = t2;
            chain[nchain].imm = irfn_kconst(&FN, c->hi);
            nchain++;
            o = &chain[nchain];
            o->op = IR_CMP;
            o->type = IRT_U64;
            o->dst = c2;
            o->a = cv;
            o->b = t2;
            o->flags = sw_uns ? IRCC_ULE : IRCC_LE;
            nchain++;
            o = &chain[nchain];
            o->op = IR_BR;
            o->a = c2;
            o->b = c->lbl;
            o->c = lnext;
            nchain++;
        }
        chain[nchain].op = IR_LABEL;
        chain[nchain].a = lnext;
        nchain++;
    }
    /* 都不匹配 → default（没有 default 就跳到末尾） */
    chain[nchain].op = IR_JMP;
    chain[nchain].a = (st->has_def ? st->def_lbl : st->end_lbl);
    nchain++;
    irfn_insert(&FN, st->ins_at, chain, nchain);
    if (!st->has_def)
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, st->def_lbl, 0, 0, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, st->end_lbl, 0, 0, 0);
}

/* 名字标号：goto 与 label 用同一张表，先到先得（前向 goto 也成立） */
#define GOTO_MAX 192
static const char *GLBL_NAME[GOTO_MAX];
static u32 GLBL_LEN[GOTO_MAX];
static u32 GLBL_ID[GOTO_MAX];
static int GLBL_DEPTH[GOTO_MAX];   /* 标号所在块深度（goto 按它决定跑哪些清理） */
static int GLBL_DEF[GOTO_MAX];     /* 标号已经定义过了（前向 goto 还不知道深度） */
static u32 *GLBL_CHAIN[GOTO_MAX];  /* 定义时抄下来的块链（NULL = 太深，没抄） */
static u32 NGLBL;

static void blk_chain_save(u32 gi, int depth)
{
    int d = 0;

    GLBL_CHAIN[gi] = NULL;
    if (depth <= 0 || depth >= BLK_MAXDEPTH)
        return;
    GLBL_CHAIN[gi] = arena_alloc(&A_main, (size_t)(depth + 1) * sizeof(u32));
    for (d = 1; d <= depth; d++)
        GLBL_CHAIN[gi][d] = BLK_CHAIN[d];
}

static u32 goto_label(const char *nm, u32 len)
{
    u32 i = 0;

    for (i = 0; i < NGLBL; i++)
        if (GLBL_LEN[i] == len && memcmp(GLBL_NAME[i], nm, len) == 0)
            return GLBL_ID[i];
    if (NGLBL >= GOTO_MAX) {
        pa_error("标号太多（上限 %d）", GOTO_MAX);
        return 0;
    }
    GLBL_NAME[NGLBL] = nm;
    GLBL_LEN[NGLBL] = len;
    GLBL_ID[NGLBL] = irfn_label(&FN);
    GLBL_DEPTH[NGLBL] = DEF_DEPTH;
    GLBL_DEF[NGLBL] = 0;
    return GLBL_ID[NGLBL++];
}

/* ---- 内联汇编（模板在 asmx.c6 里翻，这边只负责取文本和操作数）---------- */

/* asm 模板最多这么长（含转义解码后的字节）。模板都是小片段，超了就是
 * 我们不打算支持的大块汇编，宁可整体跳过。 */
#define ASM_TPL_MAX 8192
/* 操作数（%0/%1…）最多几个：寄存器只留 r10/r11/r8/r9/rsi/rdi 六个中转，
 * 再多就得考虑压栈，不值得 */
#define ASM_OPMAX 6

static const char *const ASM_REG64[ASM_OPMAX] = {
    "%r10", "%r11", "%r8", "%r9", "%rsi", "%rdi"
};
static const char *const ASM_REG32[ASM_OPMAX] = {
    "%r10d", "%r11d", "%r8d", "%r9d", "%esi", "%edi"
};
static const int ASM_REGNUM[ASM_OPMAX] = { 10, 11, 8, 9, 6, 7 };
static const char *const ASM_REG16[ASM_OPMAX] = {
    "%r10w", "%r11w", "%r8w", "%r9w", "%si", "%di"
};
static const char *const ASM_REG8[ASM_OPMAX] = {
    "%r10b", "%r11b", "%r8b", "%r9b", "%sil", "%dil"
};
/* 每个操作数各宽度的替换文本：内核 outb/inb 模板用 %b0/%w1 显式指定宽度，
 * 而 otext[] 只存了一种宽度，需要按修饰符取对应的名字。
 * 下标 0..3 = 8/16/32/64 位。 */
static const char *ASM_OTEXT_W[ASM_OPMAX][4];

/* GCC 命名操作数 `[name] "约束"(expr)`：记下每个索引的名字，供 asm_subst
 * 把模板里的 `%[name]` 换成对应 otext（内核 __raw_try_cmpxchg 等全用命名
 * 操作数）。每次 try_stmt_asm 开头清零。 */
static const char *ASM_OPNAME[ASM_OPMAX];

/* 固定寄存器约束 a/b/c/d/S/D（内核里到处是 "=a"(x) / "c"(m) / "d"(hi)）。
 * 索引顺序就是约束字母顺序 a,b,c,d,S,D；号是 x86-64 编码号，ax_binds_in/out
 * 拿它直接用 x_ld64/x_st64 在帧槽和物理寄存器之间搬值。 */
static const char *const ASM_FIX64[] = {
    "%rax", "%rbx", "%rcx", "%rdx", "%rsi", "%rdi"
};
static const char *const ASM_FIX32[] = {
    "%eax", "%ebx", "%ecx", "%edx", "%esi", "%edi"
};
static const char *const ASM_FIX8[] = {
    "%al", "%bl", "%cl", "%dl", "%sil", "%dil"
};
static const char *const ASM_FIX16[] = {
    "%ax", "%bx", "%cx", "%dx", "%si", "%di"
};
static const int ASM_FIXNUM[] = { 0, 3, 1, 2, 6, 7 };

/* 把一串相邻的字符串字面量拼成一段**解码后**的文本（asm 模板）。
 * 必须解码：`"cmp $0, %1\n\t"` 里的 \n 是换行，不解码整段就成了一个操作数
 * 里带反斜杠的行，翻不出来。 */
static const char *asm_concat_str(u32 *outlen)
{
    char *buf = arena_alloc(&A_main, ASM_TPL_MAX);
    u32 n = 0;

    *outlen = 0;
    while (pa_cur()->kind == TK_STR) {
        Tok *t = pa_cur();
        const char *s = tok_data(t);
        u32 i = 0;

        while (i < t->len && s[i] != '"')
            i++;                        /* 跳过 L/u/U/u8 前缀 */
        i++;
        while (i + 1 < t->len) {        /* 末尾那个是收尾的引号 */
            u32 ch = 0;

            if (s[i] == '\\') {
                const char *p = s + i + 1;

                ch = esc_decode(&p, s + t->len);
                i = (u32)(p - s);
            } else {
                ch = (u32)(u8)s[i];
                i++;
            }
            if (n + 8 >= ASM_TPL_MAX)
                return NULL;
            /* 汇编模板只可能是 ASCII；非 ASCII 截成低字节（翻不动会整体跳过） */
            buf[n++] = (char)(ch & 0xFF);
        }
        pa_advance();
    }
    buf[n] = 0;
    *outlen = n;
    return buf;
}

/* 把 `%0/%1…` 换成对应的寄存器名或地址表达式，`%%` 换成一个 `%`。
 * `%l[name]` 原样留着——asmx.c6 认得出它是 asm goto 的标号。 */
static const char *asm_subst(const char *tpl, u32 tlen, char **otext, u32 nop,
                            u32 *outlen)
{
    char *buf = arena_alloc(&A_main, ASM_TPL_MAX);
    u32 n = 0;
    u32 i = 0;

    *outlen = 0;
    while (i < tlen) {
        char c = tpl[i];

        if (c == '%' && i + 1 < tlen) {
            char d = tpl[i + 1];

            if (d == '%') {
                buf[n++] = '%';
                i += 2;
                continue;
            }
            /* 宽度修饰符：%b0/%w0/%k0/%q0。内核 BUILDIO 的
             * `outb %b0, %w1` / `inb %w1, %b0` 靠它选 8/16 位寄存器名。 */
            if ((d == 'b' || d == 'w' || d == 'k' || d == 'q') &&
                i + 2 < tlen && tpl[i + 2] >= '0' && tpl[i + 2] <= '9') {
                u32 k = (u32)(tpl[i + 2] - '0');
                int wi = (d == 'b') ? 0 : (d == 'w') ? 1 : (d == 'k') ? 2 : 3;

                if (k < nop && ASM_OTEXT_W[k][wi]) {
                    const char *s = ASM_OTEXT_W[k][wi];

                    while (*s) {
                        if (n + 8 >= ASM_TPL_MAX)
                            return NULL;
                        buf[n++] = *s++;
                    }
                    i += 3;
                    continue;
                }
            }
            if (d >= '0' && d <= '9') {
                u32 k = (u32)(d - '0');

                if (k < nop && otext[k]) {
                    const char *s = otext[k];

                    while (*s) {
                        if (n + 8 >= ASM_TPL_MAX)
                            return NULL;
                        buf[n++] = *s++;
                    }
                    i += 2;
                    continue;
                }
            }
            /* `%[name]`：命名操作数。查 ASM_OPNAME 找到索引，换成对应 otext。
             * 内核的 try_cmpxchg/barrier 等模板全用这种写法。 */
            if (d == '[') {
                u32 e = i + 2;
                u32 k = 0;

                while (e < tlen && tpl[e] != ']')
                    e++;
                if (e < tlen) {
                    for (k = 0; k < nop && k < ASM_OPMAX; k++)
                        if (ASM_OPNAME[k]
                            && strlen(ASM_OPNAME[k]) == e - (i + 2)
                            && memcmp(ASM_OPNAME[k], tpl + i + 2, e - (i + 2)) == 0)
                            break;
                    if (k < nop && k < ASM_OPMAX && otext[k]) {
                        const char *s = otext[k];

                        while (*s) {
                            if (n + 8 >= ASM_TPL_MAX)
                                return NULL;
                            buf[n++] = *s++;
                        }
                        i = e + 1;
                        continue;
                    }
                }
            }
        }
        if (n + 8 >= ASM_TPL_MAX)
            return NULL;
        buf[n++] = c;
        i++;
    }
    buf[n] = 0;
    *outlen = n;
    return buf;
}

/* `(%r10)` 这种地址表达式（内存操作数的替换文本）*/
static const char *asm_mem_text(u32 k)
{
    char buf[32] = {0};

    snprintf(buf, sizeof(buf), "(%s)", ASM_REG64[k]);
    return arena_strdup(&A_main, buf);
}

/* 操作数解析中途失败时，已经吃进肚子里、还没配上对的 '(' 的个数。
 * asm_skip_group 要靠它把括号数算平（`"S"(sym)` 失败时我们已经吃掉了
 * 操作数自己的 '('，此时剩下的配对 ')' 数是 2 而不是 1）。 */
static u32 ASM_UNBAL;

/* 仅当 asm 模板里出现 %cr（读控制寄存器，如 native_read_cr2 的
 * "mov %%cr2,%0"）时才放开 `=r` 输出。其它 asm 保持老行为——
 * 全局放开会让带输入段/`"0"` 匹配约束的 asm 在解析中途失败、
 * 污染 token 流，导致大量内核 TU 编译失败。 */
static int ASM_HAS_CR;

/* asm 模板为空串（`""`）：内核 RELOC_HIDE() 的 `__asm__("" : "=r"(p) : "0"(x))`
 * 只借约束把 x 的值送进 p，没有任何指令。放行 '=r' 输出 + 数字匹配约束。 */
static int ASM_EMPTY_TPL;

/* 给输出操作数（"=a"/"+a"/"=@cc"）找左值的**真实帧槽偏移**。
 * 传入的是 gen_expr() 留下的 PEND_ADDR（一个 IR_ADDR 的 dst value）。
 * 若该 value 来自帧内 IR_ADDR（flags 没有 bit1/bit2），其 imm 就是
 * [rbp+imm] 的字节偏移——这才是变量本身存放的位置。
 * 找到返回 1 并写 *slot，否则返回 0（调用方退回 value_of 临时槽）。
 *
 * 为什么需要：value_of() 会发一条 IR_LOAD，把变量值读进新临时槽；
 * asmx 的输出写回若落到这个临时槽，后续语句重新 gen_expr 该变量时
 * 又发一条 LOAD 从变量原槽读，拿到的还是旧值。try_cmpxchg 的 __old
 * 就是这么在失败后得不到更新、导致 desc_reserve 无限自旋的。 */
static int asm_addr_slot(u32 addr_value, u32 *slot)
{
    u32 i = 0;

    if (!addr_value)
        return 0;
    for (i = FN.n; i > 0; i--) {
        IrOp *o = &FN.ops[i - 1];

        if (o->op == IR_ADDR && o->dst == addr_value
            && !(o->flags & 1) && !(o->flags & 2)) {
            *slot = o->imm;
            return 1;
        }
    }
    return 0;
}

/* 一个操作数：`"约束"(表达式)`。成功返回 1，并且把绑定/替换文本填好。
 * 只支持内存操作数（`m`）和只读寄存器操作数（`r`）：
 *   - `m`：把表达式的**地址**装进中转寄存器，模板里的 %N 换成 `(%r10)`；
 *   - `r`：把值装进中转寄存器，%N 换成 `%r10`（32 位类型换 `%r10d`，
 *     这样 `cmp $0, %1` 比的是低 32 位的符号，跟 int 语义一致）；
 *   - 输出寄存器（`=r`/`+r`）要写回左值，得再做一次"寄存器→内存"的间接
 *     存储，后端没有这条 IR，先当不支持（整条 asm 跳过，保持老行为）。 */
static int asm_one_operand(AxBind *binds, u32 *nbinds, char **otext)
{
    u32 k = 0;
    int mem = 0;
    int iso = 0;
    int isreg = 0;
    int isread = 1;
    int rw = 0;                     /* '+'/'&' 读写输出（区别于 '=' 纯输出） */
    int fix = -1;
    int iscc = 0;                   /* `=@ccz` 条件码输出 */
    int ccval = 0;                  /* 0=setz(ZF), 1=setnz(!ZF) */
    int match = -1;                 /* `"0"` 数字匹配约束：绑到输出操作数 0 的寄存器 */
    const char *cs = NULL;
    u32 cl = 0;

    /* `[name]` 命名操作数前缀（内核 inline asm 普遍使用） */
    if (pa_is_ch('[')) {
        pa_advance();
        if (pa_cur()->kind != TK_IDENT)
            return 0;
        if (*nbinds < ASM_OPMAX)
            ASM_OPNAME[*nbinds] = arena_strndup(&A_main, tok_data(pa_cur()), pa_cur()->len);
        pa_advance();
        if (!pa_accept_ch(']'))
            return 0;
    }
    if (pa_cur()->kind != TK_STR)
        return 0;
    cs = tok_data(pa_cur());
    cl = pa_cur()->len;
    /* `@cc` 条件码输出约束：`=@ccz` / `=@ccne` / `=@cce` …。这种操作数
     * 不对应模板里的寄存器/内存占位符，而是 asm 之后按标志位 setcc 写回
     * 变量（__raw_try_cmpxchg 的 success 就是 `=@ccz`）。 */
    for (k = 0; k + 3 < cl; k++) {
        if (cs[k] == '@' && cs[k + 1] == 'c' && cs[k + 2] == 'c') {
            char c0 = cs[k + 3];    /* tok_data 带引号：`"=@ccz"` → c0 是 'z' */

            if (c0 == 'z' || c0 == 'e')
                ccval = 0;          /* setz/sete：ZF=1 成功 */
            else if (c0 == 'n' && (cs[k + 4] == 'z' || cs[k + 4] == 'e'))
                ccval = 1;          /* setnz/setne：ZF=0 */
            else if (c0 == 'c')     /* setc：CF=1（variable_test_bit 的 `=@ccc`） */
                ccval = 2;
            else
                return 0;           /* 其它 cc 暂不支持，整段跳过 */
            iscc = 1;
            iso = 1;
            break;
        }
    }
    for (k = 0; k < cl && !iscc; k++) {
        if (cs[k] == '=')
            iso = 1;
        else if (cs[k] == '+' || cs[k] == '&') {
            iso = 1;
            isread = 1;
            rw = 1;
        } else if (cs[k] == 'm')
            mem = 1;
        else if (cs[k] == 'r')
            isreg = 1;
        else if (cs[k] == 'a') fix = 0;   /* a/b/c/d/S/D：固定寄存器约束 */
        else if (cs[k] == 'b') fix = 1;
        else if (cs[k] == 'c') fix = 2;
        else if (cs[k] == 'd') fix = 3;
        else if (cs[k] == 'S') fix = 4;
        else if (cs[k] == 'D') fix = 5;
        else if (cs[k] == 'i' || cs[k] == 'n' || cs[k] == 'g')
            return 0;               /* 立即数/通用约束：不支持 */
        else if (cs[k] >= '0' && cs[k] <= '9') {
            /* 数字匹配约束 `"0"`：绑到输出操作数 N 的寄存器。只在空模板
             * asm 中放行（RELOC_HIDE），内容是把输入值送进输出槽。 */
            if (!ASM_EMPTY_TPL)
                return 0;
            match = cs[k] - '0';
            isreg = 1;
        }
    }
    /* 只允许 +r/&r 读写输出走通用寄存器路径：isreg 分支已有把结果写回真实
     * 帧槽的处理（4412314）。纯 '=r' 输出仍按原样拒绝，避免 uaccess 等
     * 约束被误解析（曾导致 412 文件编译失败）。空模板 asm（RELOC_HIDE）
     * 是例外：模板无指令，输出靠数字匹配输入送值。 */
    if (iso && isreg && !ASM_HAS_CR && !rw && !ASM_EMPTY_TPL)
        return 0;
    if (iso && !mem && fix < 0 && !iscc && !(isreg && ASM_HAS_CR) && !rw
        && !ASM_EMPTY_TPL)
        return 0;
    pa_advance();
    if (!pa_is_ch('('))
        return 0;
    pa_advance();
    ASM_UNBAL++;
    if (iscc) {
        /* cc 输出：把目标左值的帧槽记进绑定，otext 留空（模板不引用它）。
         * store 编码到 reg 字段（asmx 里 ax_binds_out 解释）：
         *   reg = 100 + ccval 表示 cc 输出。 */
        u32 a = 0;
        u32 slot = 0;

        (void)gen_expr();
        if (!PEND_LVAL)
            return 0;
        a = PEND_ADDR;
        PEND_LVAL = 0;
        if (*nbinds >= ASM_OPMAX)
            return 0;
        /* setcc 结果写回变量本身：优先用真实帧槽，退回地址值槽。 */
        binds[*nbinds].disp = asm_addr_slot(a, &slot) ? slot : X64_SLOT(a);
        binds[*nbinds].reg = 100 + ccval;
        binds[*nbinds].store = 1;
        otext[*nbinds] = (char *)"";
        (*nbinds)++;
        if (!pa_accept_ch(')'))
            return 0;
        ASM_UNBAL--;
        return 1;
    }
    if (mem) {
        u32 a = 0;

        /* 内存操作数要的是**地址**：gen_expr 走完如果是左值，PEND_ADDR 就是
         * 它的地址（和一元 `&` 用同一套）。 */
        (void)gen_expr();
        if (!PEND_LVAL)
            return 0;
        a = PEND_ADDR;
        PEND_LVAL = 0;
        if (*nbinds >= ASM_OPMAX)
            return 0;
        binds[*nbinds].disp = X64_SLOT(a);
        binds[*nbinds].reg = ASM_REGNUM[*nbinds];
        binds[*nbinds].store = 0;
        otext[*nbinds] = (char *)asm_mem_text(*nbinds);
        (*nbinds)++;
    } else if (isreg) {
        u32 v = 0;
        u32 addr_val = 0;
        u32 slot = 0;

        v = gen_expr();
        if (iso && PEND_LVAL)
            addr_val = PEND_ADDR;
        v = value_of(v);
        if (*nbinds >= ASM_OPMAX)
            return 0;
        /* =r 输出写回变量真实帧槽：native_read_cr2 的 `=r`(val) 靠它
         * 把 CR2 值留给后面的 return，否则写进临时槽仍读到旧值 0。 */
        binds[*nbinds].disp = (iso && asm_addr_slot(addr_val, &slot))
                                  ? slot : X64_SLOT(v);
        /* 数字匹配约束 `"0"`：输入装进输出操作数 0 的同一个物理寄存器，
         * 这样 ax_binds_out 把该寄存器写回输出槽就等于 `out = in`。
         * 绑定按出现顺序装入（输出先、匹配输入后），最终寄存器里是输入值。 */
        binds[*nbinds].reg = ASM_REGNUM[match >= 0 ? match : *nbinds];
        binds[*nbinds].store = iso;
        if (ty_size(GEN_TY) <= 4)
            otext[*nbinds] = (char *)ASM_REG32[*nbinds];
        else
            otext[*nbinds] = (char *)ASM_REG64[*nbinds];
        ASM_OTEXT_W[*nbinds][0] = ASM_REG8[*nbinds];
        ASM_OTEXT_W[*nbinds][1] = ASM_REG16[*nbinds];
        ASM_OTEXT_W[*nbinds][2] = ASM_REG32[*nbinds];
        ASM_OTEXT_W[*nbinds][3] = ASM_REG64[*nbinds];
        (*nbinds)++;
    } else if (fix >= 0) {
        u32 v = 0;
        u32 sz = 0;
        u32 addr_val = 0;
        u32 slot = 0;
        int have_addr = 0;

        v = gen_expr();
        if (iso && PEND_LVAL) {
            addr_val = PEND_ADDR;
            have_addr = 1;
        }
        v = value_of(v);
        sz = ty_size(GEN_TY);
        if (*nbinds >= ASM_OPMAX)
            return 0;
        /* 输出约束（"=a"/"+a"）：asm 结果写回变量真实帧槽，使后续语句
         * 重新求值该变量时能读到更新值（try_cmpxchg 的 __old 就是靠这个）。
         * 纯输入操作数仍用 value_of 的临时槽。 */
        binds[*nbinds].disp = (have_addr && asm_addr_slot(addr_val, &slot))
                                  ? slot : X64_SLOT(v);
        binds[*nbinds].reg = ASM_FIXNUM[fix];
        binds[*nbinds].store = iso;
        otext[*nbinds] = (char *)(sz <= 1 ? ASM_FIX8[fix]
                                  : sz <= 4 ? ASM_FIX32[fix] : ASM_FIX64[fix]);
        ASM_OTEXT_W[*nbinds][0] = ASM_FIX8[fix];
        ASM_OTEXT_W[*nbinds][1] = ASM_FIX16[fix];
        ASM_OTEXT_W[*nbinds][2] = ASM_FIX32[fix];
        ASM_OTEXT_W[*nbinds][3] = ASM_FIX64[fix];
        (*nbinds)++;
    } else {
        return 0;
    }
    if (!pa_accept_ch(')'))
        return 0;
    ASM_UNBAL--;
    (void)isread;
    return 1;
}

/* `"=m"(a), "r"(b)` 这样的一串操作数 */
static int asm_operand_list(AxBind *binds, u32 *nbinds, char **otext)
{
    /* `[name]` 命名操作数前缀也表示一个操作数（不只是 TK_STR） */
    if (pa_cur()->kind != TK_STR && !pa_is_ch('['))
        return 1;                   /* 空段 */
    for (;;) {
        if (!asm_one_operand(binds, nbinds, otext))
            return 0;
        if (!pa_accept_ch(','))
            break;
    }
    return 1;
}

/* clobber 段（`"memory"`、`"cc"`、`"rax"`…）：后端把所有值都放帧槽，寄存器
 * 全是临时，没有需要保护的活值，整段跳过即可。 */
static void asm_skip_clobbers(void)
{
    while (pa_cur()->kind == TK_STR) {
        pa_advance();
        if (!pa_accept_ch(','))
            break;
    }
}

/* asm goto 的标号列表：`smaller, larger` */
static void asm_label_list(AxGoto *gt, u32 *ngt)
{
    while (pa_cur()->kind == TK_IDENT) {
        u32 l = goto_label(tok_data(pa_cur()), pa_cur()->len);

        if (*ngt < AX_MAXGOTO) {
            gt[*ngt].name = arena_strndup(&A_main, tok_data(pa_cur()), pa_cur()->len);
            gt[*ngt].id = l;
            (*ngt)++;
        }
        pa_advance();
        if (!pa_accept_ch(','))
            break;
    }
}

/* asm 段分隔符：词法器把 `::` 合成**一个** TK_PUNCT，而标准 C 里它是紧挨的
 * 两个冒号（中间那段操作数表为空）。返回 0=没有分隔符，1=吃了一个 ':'，
 * 2=吃了 `::`（等价两个冒号，调用方要跳过一个空段）。 */
static int pa_asm_sep(void)
{
    Tok *t = pa_cur();

    if (pa_accept_ch(':'))
        return 1;
    if (t && t->kind == TK_PUNCT && t->len == 2
        && tok_data(t)[0] == ':' && tok_data(t)[1] == ':') {
        pa_advance();
        return 2;
    }
    return 0;
}

/* 翻不动时把整组 `asm(...)` 的 token 吞干净：从外层 '(' 之后一直跳到配对的
 * ')'。不能指望 skip_paren_group —— 失败点可能停在操作数**中间**（`"S"(sym)`
 * 里的 sym、`"=r"(x)` 里的 x），那时候当前位置不是 '('，skip_paren_group 吞
 * 不到配对的 ')'，剩下的 `)` 就变成"这里要 ';'"。138/140 那批 arm64 用例
 * 本来靠"静默丢弃"过的，一露这个错就编不过了。 */
static void asm_skip_group(void)
{
    u32 depth = 1 + ASM_UNBAL;

    ASM_UNBAL = 0;

    while (pa_cur()->kind != TK_EOF) {
        if (pa_is_ch('(')) {
            depth++;
        } else if (pa_is_ch(')')) {
            depth--;
            if (!depth) {
                pa_advance();
                return;
            }
        }
        pa_advance();
    }
}

/* asm [volatile] [goto] ( 模板 : 输出 : 输入 : clobber : 标号 ) ;
 * 翻得动就发一条 IR_COMMENT 标记（出码时把预算好的机器码插进去），
 * 翻不动就只把 token 吃掉——和以前的"静默丢弃"完全一样，不会把原本能
 * 编过的用例变成编不过。 */
static int try_stmt_asm(void)
{
    const char *tpl = NULL;
    const char *txt = NULL;
    u32 tlen = 0;
    u32 xlen = 0;
    u32 idx = 0;
    AxBind binds[ASM_OPMAX] = {0};
    u32 nbinds = 0;
    AxGoto gts[AX_MAXGOTO] = {0};
    u32 ngts = 0;
    char *otext[ASM_OPMAX] = {0};
    int ok = 1;
    int isn = 0;

    memset(ASM_OPNAME, 0, sizeof(ASM_OPNAME));
    memset(ASM_OTEXT_W, 0, sizeof(ASM_OTEXT_W));
    if (!(PA_IS_IDENT("asm") || PA_IS_IDENT("__asm") || PA_IS_IDENT("__asm__")
          || PA_IS_IDENT("asm_inline")))
        return 0;
    pa_advance();
    while (PA_IS_IDENT("volatile") || PA_IS_IDENT("__volatile__")
           || PA_IS_IDENT("__volatile") || PA_IS_IDENT("inline")
           || PA_IS_IDENT("__inline") || PA_IS_IDENT("__inline__")
           || PA_IS_IDENT("__attribute__") || PA_IS_IDENT("__attribute")
           || PA_IS_IDENT("goto")) {
        /* 内核里 asm_inline 展开为 `asm inline __attribute__((...)) volatile`，
         * 属性夹在 asm 和 volatile 之间；不跳过会把整条 asm 吞到分号丢弃。 */
        if (PA_IS_IDENT("__attribute__") || PA_IS_IDENT("__attribute")) {
            skip_attributes();
            continue;
        }
        if (PA_IS_IDENT("goto"))
            isn = 1;
        pa_advance();
    }
    if (!pa_is_ch('(')) {
        while (!pa_is_ch(';') && pa_cur()->kind != TK_EOF)
            pa_advance();
        if (pa_is_ch(';'))
            pa_advance();
        return 1;
    }
    pa_advance();
    if (pa_cur()->kind == TK_STR) {
        tpl = asm_concat_str(&tlen);
        if (!tpl)
            ok = 0;
    } else {
        ok = 0;
    }
    ASM_HAS_CR = 0;
    ASM_EMPTY_TPL = (tpl && tlen == 0); /* RELOC_HIDE 的 `__asm__("")` */
    if (tpl) {
        u32 ci = 0;

        for (ci = 0; ci + 3 < tlen; ci++)
            if ((tpl[ci] == '%' && tpl[ci + 1] == '%' && tpl[ci + 2] == 'c' &&
                 tpl[ci + 3] == 'r') ||
                (tpl[ci] == '%' && tpl[ci + 1] == 'c' && tpl[ci + 2] == 'r')) {
                ASM_HAS_CR = 1;
                break;
            }
    }
    /* `static_cpu_has()` 的 asm goto 用 ALTERNATIVE_TERNARY + .altinstr_aux
     * 做运行期特性检测，里面有 `.long 771b - .` 数字标签引用、命名操作数
     * `%c[feature]` 等，迷你汇编器/操作数解析器都翻不动。以前整条 asm 被丢掉，
     * 控制顺着落到汇编后的第一个 C 标号（t_yes = 特性存在）——所有 CPU 特性
     * 都被当成支持，QEMU 上执行 SERIALIZE 直接 #UD。这里在操作段解析之前就
     * 识别这个模板，跳到 t_no（特性不存在），内核走 fallback 路径。 */
    if (isn && tpl && strstr(tpl, ".altinstr_aux")) {
        asm_skip_group();
        if (pa_is_ch(';'))
            pa_advance();
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, goto_label("t_no", 4), 0, 0, 0);
        return 1;
    }
    /* 输出段 / 输入段 / clobber 段 / 标号段（后面几段都可以没有）。
     * `::` 被词法器合成单 token，pa_asm_sep() 把它当两个冒号处理。 */
    {
        int seg = 0;
        int rc = ok ? pa_asm_sep() : 0;

        while (rc > 0) {
            if (rc == 2)
                seg++;                 /* 双冒号中间那段为空 */
            if (seg == 0 || seg == 1)
                ok = asm_operand_list(binds, &nbinds, otext);
            else if (seg == 2)
                asm_skip_clobbers();
            else if (isn)
                asm_label_list(gts, &ngts);
            if (!ok)
                break;
            seg++;
            rc = pa_asm_sep();
        }
    }
    if (!ok || !tpl) {
        asm_skip_group();
        if (pa_is_ch(';'))
            pa_advance();
        return 1;
    }
    if (pa_is_ch(')'))
        pa_advance();
    else
        asm_skip_group();
    if (pa_is_ch(';'))
        pa_advance();
    /* ALTERNATIVE("call __sw_hweightXX", "popcntq %[val], %[cnt]", ...) 的模板
     * 里混着 .pushsection/.long/数字标号等迷你汇编器翻不动的指示符，整段 asm
     * 以前被丢 → hweight 恒 0 → bitmap_weight 返回 0 → topology 除零。
     * 目标 QEMU 支持 POPCNT，直接把模板换成 replacement 里的 popcnt 那句。 */
    if (tpl && tlen && strstr(tpl, ".altinstr_replacement")) {
        const char *pc = strstr(tpl, "popcnt");
        if (pc) {
            const char *e = pc;
            u32 n = 0;
            char *nb = NULL;

            while (*e && *e != '\n' && *e != '\r')
                e++;
            n = (u32)(e - pc);
            nb = arena_alloc(&A_main, n + 2);
            memcpy(nb, pc, n);
            nb[n] = 0;
            tpl = nb;
            tlen = n;
        }
    }
    txt = asm_subst(tpl, tlen, otext, nbinds, &xlen);
    if (!txt)
        return 1;
    if (!asmx_piece(txt, xlen, binds, nbinds, gts, ngts, &idx))
        return 1;
    irfn_push(&FN, IR_COMMENT, IRT_VOID, 0, 0, 0, 0, AX_MARK | idx);
    return 1;
}

/* 文件作用域 asm：`asm(".globl vide\nvide: …")` —— 上游用例就是靠它定义
 * 符号（85/98/120）。翻译出来立刻放进代码镜像：这时候没有别的函数正在发，
 * 落点正好就是"这条声明所在的位置"，标签符号也能马上登记，后面 main 里
 * 调 vide() 时符号已经有定义了。 */
static int try_toplevel_asm(void)
{
    const char *tpl = NULL;
    u32 tlen = 0;
    u32 idx = 0;

    if (!(PA_IS_IDENT("asm") || PA_IS_IDENT("__asm") || PA_IS_IDENT("__asm__")
          || PA_IS_IDENT("asm_inline")))
        return 0;
    pa_advance();
    while (PA_IS_IDENT("volatile") || PA_IS_IDENT("__volatile__")
           || PA_IS_IDENT("__volatile") || PA_IS_IDENT("inline")
           || PA_IS_IDENT("__inline") || PA_IS_IDENT("__inline__")
           || PA_IS_IDENT("__attribute__") || PA_IS_IDENT("__attribute")) {
        if (PA_IS_IDENT("__attribute__") || PA_IS_IDENT("__attribute")) {
            skip_attributes();
            continue;
        }
        pa_advance();
    }
    if (!pa_is_ch('(')) {
        while (!pa_is_ch(';') && pa_cur()->kind != TK_EOF)
            pa_advance();
        if (pa_is_ch(';'))
            pa_advance();
        return 1;
    }
    pa_advance();
    if (pa_cur()->kind == TK_STR)
        tpl = asm_concat_str(&tlen);
    /* 文件作用域上不该有操作数；有多余的东西就整组跳掉，别乱吃 token */
    if (pa_is_ch(')'))
        pa_advance();
    else
        asm_skip_group();
    if (pa_is_ch(';'))
        pa_advance();
    if (tpl && tlen && asmx_piece(tpl, tlen, NULL, 0, NULL, 0, &idx))
        (void)asmx_flush(&X64, idx);
    return 1;
}

/* 预处理注入的 `__c6_pack(N);`：`#pragma pack` 的生效点。
 * 预处理整趟跑完才轮到语法分析，所以 pack 必须跟着 token 流走。 */
static int try_pack_directive(void)
{
    long v = 0;

    if (!PACK_SEEN || !PA_IS_IDENT("__c6_pack"))
        return 0;
    pa_advance();
    pa_expect_ch('(');
    if (pa_cur()->kind == TK_NUM) {
        char nb[24] = {0};
        u32 k = pa_cur()->len < 20 ? pa_cur()->len : 20;

        memcpy(nb, tok_data(pa_cur()), k);
        nb[k] = 0;
        v = strtol(nb, NULL, 0);
        pa_advance();
    }
    pa_expect_ch(')');
    pa_accept_ch(';');
    TY_PACK = (int)v;
    return 1;
}

/* 接口值（布局 `{self, vt}`，地址 addr）上调用第 mi 个方法：`vt[mi](self, …)`。
 * args 不含 self，返回结果的 vreg。foreach 的接口迭代器要用。 */
static u32 gen_iface_call(u32 addr, u32 mi, u32 ret_ty, u32 *args, u32 nargs)
{
    u32 selfv = irfn_vreg(&FN);
    u32 vt8 = gen_addr_off(addr, 8);
    u32 vtv = irfn_vreg(&FN);
    u32 fnv = irfn_vreg(&FN);
    u32 dst = irfn_vreg(&FN);
    u32 k = 0;
    u32 sv = sret_slot(ret_ty);

    irfn_push(&FN, IR_LOAD, IRT_PTR, selfv, addr, 0, 0, 0);
    irfn_push(&FN, IR_LOAD, IRT_PTR, vtv, vt8, 0, 0, 0);
    irfn_push(&FN, IR_LEA, IRT_PTR, fnv, vtv, 0, 0, mi * 8);
    irfn_push(&FN, IR_LOAD, IRT_PTR, fnv, fnv, 0, 0, 0);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, selfv, 0, 0, 0);
    for (k = 0; k < nargs; k++)
        irfn_push(&FN, IR_ARG, IRT_U64, 0, args[k], 0, 0, k + 1);
    if (sv)
        irfn_push(&FN, IR_ARG, IRT_U64, 0, sv, 0, 0, nargs + 1);
    irfn_push(&FN, IR_CALLI, ir_ty_of(ret_ty), dst, fnv, 0, 0, 0);
    FN.ops[FN.n - 1].narg = (u8)(nargs + 1 + (sv ? 1 : 0));
    return dst;
}

/* 接口里叫 nm 的方法排第几？没有就 0xFFFFFFFF。 */
static u32 iface_slot(u32 ifx, const char *nm, u32 nl)
{
    u32 k = 0;

    if (ifx >= IFACE_MAX)
        return 0xFFFFFFFFu;
    for (k = 0; k < IFACE_NM[ifx]; k++)
        if (IFACE_MLEN[ifx][k] == nl && memcmp(IFACE_MET[ifx][k], nm, nl) == 0)
            return k;
    return 0xFFFFFFFFu;
}

static void gen_stmt(void)
{
    /* `__label__ name1, name2;`：GNU 的**局部标签声明**，只声明标签的
     * 作用域，本身不产生代码。内核 include/linux/uaccess.h:668 的
     * unsafe_get_user()/unsafe_put_user() 宏第一条就是它
     * （`do { __label__ local_label; … } while (0)`），用来保证 asm goto 的
     * 目标落在局部作用域里。
     *
     * 放在最前面：它不参与"是不是声明"的那套前瞻判定，那些判定只看
     * 类型名/关键字，`__label__` 一个都不沾。c6c 的标签本来就是函数作用域、
     * 名字直接可用，所以吃干净就行。 */
    if (PA_IS_IDENT("__label__")) {
        pa_advance();
        while (pa_cur()->kind == TK_IDENT
               || (pa_cur()->kind == TK_PUNCT && TOK_EQ(pa_cur(), ",")))
            pa_advance();
        (void)pa_accept_ch(';');
        return;
    }
    /* -g：语句开头更新当前行，后面每条 IR 记录都会带上它（见 irfn_push）。
     * 放在这一层是因为它是"语句"的唯一入口：表达式里再怎么跨行，行号也只会
     * 前进到语句粒度——调试时按语句停就够了，不必精确到子表达式。 */
    if (ir_lines_on() && pa_cur()) {
        Tok *t0 = pa_cur();

        FN.cur_line = src_line_of(file_by_id(t0->file), t0->off);
    }
    /* 进新语句了：上一个 `return` 的操作数已经编完 */
    PA_RET_EXPR = 0;
    PA_LAST_TERM = 0;
    E_CLOSURE_LIT = 0;
    /* 上一条语句留下的临时托管引用（`int v = take(new T);` 这种没走
     * 表达式语句收尾的路径）在这里补一次释放。 */
    if (NMGD_TMP)
        mgd_tmp_flush();
    /* `PEND_MGD` 也是"上一条语句"的状态：上一条读过托管引用，这条
     * `return -1;` 就会被当成"交出一个引用"而去 retain(-1)（踩过：
     * gc_async 里 `if (__c6_gc_refcount(n) != 2) return -1;` 直接崩）。 */
    PEND_MGD = 0;
    PEND_MGD_SYM = NULL;
    /* c6 角色宏：语句位置上的 `stmt` / `type` / `expr` 宏。展开是把 token
     * 压回 SRC 栈重放，所以这里再进一次 gen_stmt 就是"解析展开结果"。 */
    if (NCM > 0 && CM_STMT_DEPTH < 64 && cm_at_call(-1)) {
        int role = cm_at_call(-1)->role;

        if (role == CM_ROLE_STMT || role == CM_ROLE_TYPE || role == CM_ROLE_EXPR) {
            CM_STMT_DEPTH++;
            (void)cm_expand(role);
            gen_stmt();
            CM_STMT_DEPTH--;
            return;
        }
    }
    /* asm 要在 skip_attributes 之前认：`asm` 也在 SA_KW 里，先跑属性扫描会把
     * 它当成属性关键字默默吃掉，后面只剩 `goto (...)`，报"goto 后面要标号名"
     * （tcc tests2 的 127_asm_goto 就是这么挂的）。 */
    if (try_stmt_asm())
        return;
    skip_attributes();
    if (try_pack_directive())
        return;
    /* `defer stmt;` / `errdefer stmt;`：先把语句体解析一遍，把这段 IR 抄走，
     * 再从流里撤掉；出口处由 defer_run() 插回去。软关键字——后面不是
     * `= ; ( . , )` 才算。 */
    {
        int is_def = (c6_kw() && (PA_IS_IDENT("defer") || PA_IS_IDENT("errdefer")));
        int bad = 0;

        if (is_def && pa_peek(1)->kind == TK_PUNCT) {
            Tok *p1 = pa_peek(1);

            if (TOK_EQ(p1, "=") || TOK_EQ(p1, ";") || TOK_EQ(p1, ".")
                || tok_eq(p1, ",") || tok_eq(p1, ")") || TOK_EQ(p1, "["))
                bad = 1;
            if (tok_eq(p1, "(")) {
                /* `defer (…);` 是调用；`defer (a, b) = f();` 是元组解构 */
                Tok *p2 = pa_peek(2);
                Tok *p3 = pa_peek(3);

                if (!(p2->kind == TK_IDENT && p3->kind == TK_PUNCT
                      && (tok_eq(p3, ",") || tok_eq(p3, ")"))))
                    bad = 1;
            }
        }
        if (is_def && !bad) {
        int is_err = PA_IS_IDENT("errdefer");
        u32 start = 0;
        u32 nops = 0;

        pa_advance();
        /* 上游口径：一个函数最多 128 个清理点（tests/errors/defer.c6）。
         * 数的是**静态**的 defer 站点，不是登记表里当下有多少条——块作用域
         * 的 defer 每出一个块就被弹掉，光看 NDF 永远超不过 1。 */
        if (PA_DEFER_SITES++ >= 128) {
            pa_error("a function cannot have more than 128 cleanup sites");
            return;
        }
        if (NDF >= DEFER_MAX) {
            pa_error("defer/errdefer 太多（上限 %d）", DEFER_MAX);
            return;
        }
        if (PA_DEFER_DEPTH >= 8) {
            /* 8 层是允许的，第 9 层报 */
            pa_error("'defer' bodies nested too deeply");
            return;
        }
        start = FN.n;
        {
            int was = PA_IN_DEFER;

            PA_IN_DEFER = 1;
            PA_DEFER_DEPTH++;
            mv_push();
            gen_stmt();
            mv_restore();       /* defer 体单独分析：里面的 move 不漏到下面 */
            mv_pop();
            PA_DEFER_DEPTH--;
            PA_IN_DEFER = was;
        }
        nops = FN.n - start;
        DF_CNT[NDF] = nops;
        DF_OPS[NDF] = arena_alloc(&A_main, (size_t)(nops ? nops : 1) * sizeof(IrOp));
        if (nops)
            memcpy(DF_OPS[NDF], &FN.ops[start], (size_t)nops * sizeof(IrOp));
        DF_SCOPE[NDF] = DEF_DEPTH;
        DF_ERR[NDF] = is_err;
        NDF++;
        FN.n = start;               /* 从主流里撤掉 */
        return;
        }
    }
    if (PA_ACCEPT_IDENT("goto")) {
        if (PA_IN_DEFER)
            pa_error("'goto' is not allowed in a defer body");
        PA_LAST_TERM = 1;
        if (pa_is_ch('*')) {
            /* GNU 计算 goto：`goto *expr;` */
            u32 v = 0;

            pa_advance();
            v = value_of(gen_expr());
            pa_expect_ch(';');
            gen_vla_restore();
            irfn_push(&FN, IR_JMPIND, IRT_VOID, 0, v, 0, 0, 0);
            return;
        }
        if (pa_cur()->kind == TK_IDENT) {
            u32 l = goto_label(tok_data(pa_cur()), pa_cur()->len);
            int gi = 0;
            int ld = 0;
            int lgi = -1;

            pa_advance();
            pa_expect_ch(';');
            /* 前向 goto 这时还不知道标号在多深（按老规矩全跑一遍）；
             * 向后 goto 标号已经定义过，深度是准的。 */
            int fwd = 1;

            for (gi = 0; gi < NGLBL; gi++)
                if (GLBL_ID[gi] == l && GLBL_DEF[gi]) {
                    ld = GLBL_DEPTH[gi];
                    lgi = gi;
                    fwd = 0;
                }
            /* 变长数组的栈空间只在**回边**上回收（向后 goto = 自己搭的循环，
             * 不回收就一圈一圈往下叠）。前向 goto 不能回收：`goto end;` 后面
             * 还要用刚才那块 VLA（`end:` 和声明在同一个块里，按 C 的规矩它
             * 还活着），一回收就会和后面调用者的栈帧重叠——tcc tests1 的
             * vla_test.c 第二个用例正是这么踩的（memset 把调用者的返回地址
             * 抹成 0，ret 直接蹦到野地址）。 */
            if (!fwd)
                gen_vla_restore();
            /* 只跑**退出掉的那些**作用域的清理：同一个作用域里 `again:` 之后
             * 注册的 defer，跳回 `again:` 时还活着，不能重复执行
             * （tests/defer_scope.c6 的"重复注册只跑一次"）。
             *
             * 判"退出了哪几层"不能只看深度：标号可能和 goto 在同一深度、但在
             * 兄弟块里（跳过去其实退出了当前这些块），也可能比 goto 更深。
             * 所以拿块链求公共前缀——第 c 层还在一起、第 c+1 层就分叉了，
             * 那么 c+1 层及更深的全退出了。 */
            {
                /* 前向 goto 还不知道标号在多深，但有一点是确定的：**不可能退出
                 * 函数体**（第 1 层）。所以起点至少是 2 —— 从 1 起会把函数体
                 * 自己的 cleanup 提前跑一遍（tcc tests2/101_cleanup 的 check()
                 * 里，`goto out` 把 `str: wololo` 打在了最前面，等函数真的返回时
                 * 又跑一遍，第二次打出来的是被改过的 "fail"）。 */
                int from = ld > 0 ? ld + 1 : 2;

                if (!fwd && lgi >= 0 && GLBL_CHAIN[lgi]) {
                    int c = 0;

                    while (c < DEF_DEPTH && c < ld && c + 1 < BLK_MAXDEPTH
                           && BLK_CHAIN[c + 1] == GLBL_CHAIN[lgi][c + 1])
                        c++;
                    from = c + 1;
                }
                defer_run(from, 0);
            }
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, l, 0, 0, 0);
        } else {
            pa_error("goto 后面要标号名或 '*' 表达式");
            while (!pa_is_ch(';') && pa_cur()->kind != TK_EOF)
                pa_advance();
            if (pa_is_ch(';'))
                pa_advance();
        }
        return;
    }
    if (PA_ACCEPT_IDENT("_Static_assert") || PA_ACCEPT_IDENT("static_assert")) {
        parse_static_assert_rest();
        return;
    }
    /* `co f(args);`：起一个游离任务（不等它）。c6c 的任务都是同步跑完的，
     * 所以这里就是"调一次、丢掉返回值"。软关键字：只有后面跟
     * `标识符 (` 时才算，`co = 1;` / `co(x)` 之类照旧。 */
    if (PA_IS_IDENT("co") && c6_kw() && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
        && pa_peek(2) && pa_peek(2)->kind == TK_PUNCT && tok_eq(pa_peek(2), "(")) {
        pa_advance();
        {
            u32 cv = 0;
            u32 dv = irfn_vreg(&FN);

            PA_CO_STMT = 1;
            cv = value_of(gen_expr());
            PA_CO_STMT = 0;
            if (GEN_TY != ty_thread() && !ty_is_task_ptr(GEN_TY))
                pa_error("'co' 的操作数必须是一次 async 调用");
            (void)cv;
            /* `co` 没有句柄：跑完由调度侧（__c6_co_run）自动回收并计失败 */
            irfn_push(&FN, IR_ARG, IRT_U64, 0, cv, 0, 0, 0);
            irfn_push(&FN, IR_CALL, IRT_VOID, dv, 0, 0, 0,
                      x64_sym(&X64, "__c6_co_detach"));
            FN.ops[FN.n - 1].narg = 1;
        }
        pa_expect_ch(';');
        return;
    }
    /* 名字标号：IDENT ':' */
    if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ":")
        && !PA_IS_IDENT("default")) {
        u32 l = goto_label(tok_data(pa_cur()), pa_cur()->len);
        int gi = 0;

        pa_advance();
        pa_advance();
        for (gi = 0; gi < NGLBL; gi++)
            if (GLBL_ID[gi] == l) {
                GLBL_DEPTH[gi] = DEF_DEPTH;
                blk_chain_save((u32)gi, DEF_DEPTH);
                GLBL_DEF[gi] = 1;
            }
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, l, 0, 0, 0);
        /* 标号后面**必须**接着生成被标号的那条语句。原来这里直接 return，
         * 于是 `if (c) lab: stmt;` 里的 stmt 会被当成 if 之后的**另一条语句**，
         * 条件为假时照样执行——tcc 里 `if (t0 == TOK_PPJOIN) bad_twosharp: …`
         * 就是靠这个把每一条 #define 都判成错的。C 里标号后面一定跟语句，
         * 只有 `lab: }`（C23）这种才没有。 */
        if (!pa_is_ch('}'))
            gen_stmt();
        return;
    }
    if (PA_ACCEPT_IDENT("case")) {
        i64 lo = 0;
        i64 hi = 0;
        int is_range = 0;
        u32 lbl = 0;

        lo = const_expr();
        hi = lo;
        if (pa_accept_punct("...")) {
            hi = const_expr();
            is_range = 1;
        }
        pa_expect_ch(':');
        lbl = irfn_label(&FN);
        if (NSW > 0 && SW[NSW - 1].ncase < SW_MAXCASE) {
            SwCase *c = &SW[NSW - 1].cs[SW[NSW - 1].ncase++];

            c->lo = lo;
            c->hi = hi;
            c->lbl = lbl;
            c->is_range = (u8)is_range;
        } else {
            pa_error("case 只能出现在 switch 里");
        }
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lbl, 0, 0, 0);
        /* 和名字标号同一条规矩：`case N:` 后面那条语句是**被标号**的语句，
         * 必须在这儿一起生成。`switch (x) case 1: return 1;` 这种不带花括号的
         * switch 以前就把 `return 1;` 漏在了 switch 外面——x 不是 1 也照跑
         * （c-testsuite single-exec/00051）。 */
        if (!pa_is_ch('}'))
            gen_stmt();
        return;
    }
    if (PA_ACCEPT_IDENT("default")) {
        pa_expect_ch(':');
        if (NSW > 0) {
            SW[NSW - 1].has_def = 1;
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, SW[NSW - 1].def_lbl, 0, 0, 0);
        } else {
            pa_error("default 只能出现在 switch 里");
        }
        if (!pa_is_ch('}'))
            gen_stmt();
        return;
    }
    if (PA_ACCEPT_IDENT("switch")) {
        gen_switch();
        return;
    }
    if (pa_is_ch('{')) {
        gen_block();
        return;
    }
    if (pa_accept_ch(';'))
        return;
    if (PA_ACCEPT_IDENT("return")) {
        if (PA_IN_DEFER)
            pa_error("'return' is not allowed in a defer body");
        PA_RET_EXPR = 1;
        PA_LAST_TERM = 1;
        u32 v = 0;
        int on_err = 0;

        /* `return err(...)` 是错误路径：errdefer 也要跑。其余正常路径只跑 defer。 */
        if (PA_IS_IDENT("err") && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "("))
            on_err = 1;
        if (pa_is_ch(';')) {
            pa_advance();
            if (CUR_TASK_TY) {
                /* `async void f()`：`return;` 也得把任务结构交出去——
                 * 否则调用方拿到 NULL，`await` 去读 t->val 就崩（踩过）。 */
                u32 tsk2 = task_get();

                task_seal(tsk2);
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, IRT_PTR, 0, tsk2, 0, 0, 0);
                return;
            }
            defer_run(1, on_err);
            irfn_push(&FN, IR_RET, IRT_VOID, 0, 0, 0, 0, 0);
            return;
        }
        /* `return {a, b};`：按返回类型就地初始化一个临时聚合，返回它的地址
         * （元组/struct 的按值返回本来就走"地址"这条约定）。 */
        if (pa_is_ch('{') && ty_is_agg(CUR_TASK_TY ? CUR_TASK_VAL : CUR_RET_TY)) {
            u32 aty = CUR_TASK_TY ? CUR_TASK_VAL : CUR_RET_TY;
            u32 sz = ty_size(aty);
            u32 slot = frame_slots_for(sz ? sz : 8);
            u32 addr = irfn_vreg(&FN);

            irfn_push(&FN, IR_ADDR, IRT_PTR, addr, 0, 0, 0, X64_SLOT(slot));
            gen_init_obj(addr, aty, 0);
            pa_expect_ch(';');
            if (CUR_TASK_TY) {
                /* async：值放进任务结构的 val（偏移 0），返回任务指针 */
                u32 tsk = task_get();
                {
                    u32 voff = task_val_off();
                    u32 dst2 = tsk;

                    if (voff) {
                        dst2 = irfn_vreg(&FN);
                        irfn_push(&FN, IR_LEA, IRT_PTR, dst2, tsk, 0, 0, voff);
                    }
                    irfn_push(&FN, IR_COPY, IRT_U8, dst2, addr, 0, 0,
                              sz ? sz : 8);
                }
                task_seal(tsk);
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, IRT_PTR, 0, tsk, 0, 0, 0);
            } else {
                u32 rvv = ret_agg_copy(addr);

                defer_run(1, on_err);
                ret_emit(rvv);
            }
            return;
        }
        v = gen_expr();
        if (E_WEAK && in_c6_tu())
            pa_error("a weak reference cannot be returned: upgrade it first "
                     "('@T q = w;')");
        {
            u32 rty = cur_op_ty();

            /* `return p`：引用交给调用者，这个局部量的释放体要跳过。
             * `return new T` 同理——所有权跟着返回值走。
             * 借来的（字段、形参）不是自己的，得先加一次计数再交出去。
             * 判据是**返回值的类型**是（托管）指针，不是 PEND_MGD——后者可能
             * 是表达式里最后一个实参留下的（`return __c6_gc_refcount(n)` 会
             * 被当成"交出引用"而去 retain 一个整数，踩过）。 */
            int ret_mgd = (PEND_MGD && ty_is_ptr(rty)) ? PEND_MGD : 0;
            int v_took = 0;   /* 返回值本来就是一份新引用（`return new T`） */

            closure_lit_check(CUR_RET_TY);

            if (ret_mgd && CUR_TASK_TY) {
                /* `async @T f() { … return n; }`：局部那份引用**转移**进任务的
                 * val 槽（不加计数、也不在出口放掉），销毁任务时由运行时放。
                 * tests/gc_async.c6 "托管返回值由任务的 val 槽持有"。 */
                u32 tsk = 0;
                /* 顺手把任务结构的 `val`（第 8 个成员，下标 7）登记成托管
                 * 字段：`t->val` 这样的读才是"借"，赋值处才会加计数。 */
                {
                    u8 vi8[1] = {7};
                    u8 vk8[1] = {0};
                    u8 vc8[1] = {0};

                    mgdst_add(CUR_TASK_TY, vi8, vk8, vc8, 1, (u32)pa_cur()->file);
                }
                u32 voff = 0;
                u32 dst2 = 0;

                if (PEND_MGD_SYM && PEND_MGD_SYM->kind == SC_LOCAL)
                    DF_EXCEPT = PEND_MGD_SYM->slot;
                v = value_of(v);
                pa_expect_ch(';');
                tsk = task_get();
                voff = task_val_off();
                dst2 = tsk;
                if (voff) {
                    dst2 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_LEA, IRT_PTR, dst2, tsk, 0, 0, voff);
                }
                irfn_push(&FN, IR_STORE, IRT_U64, dst2, v, 0, 0, 0);
                {
                    u32 ov = irfn_vreg(&FN);

                    irfn_push(&FN, IR_ARG, IRT_U64, 0, tsk, 0, 0, 0);
                    irfn_push(&FN, IR_CALL, IRT_VOID, ov, 0, 0, 0,
                              x64_sym(&X64, "__c6_co_ownval"));
                    FN.ops[FN.n - 1].narg = 1;
                }
                task_seal(tsk);
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, IRT_PTR, 0, tsk, 0, 0, 0);
                return;
            }
            if (ret_mgd && PEND_MGD_SYM && PEND_MGD_SYM->kind == SC_LOCAL) {
                DF_EXCEPT = PEND_MGD_SYM->slot;
            } else if (ret_mgd) {
                u32 rv = 0;

                pa_expect_ch(';');
                rv = value_of(v);
                mgd_retain(rv);
                v = rv;
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, ir_ty_of(CUR_RET_TY), 0, v, 0, 0, 0);
                return;
            }
            v_took = mgd_tmp_take(v);
            /* `async (int,int) f() { return await g(); }`：聚合返回值的 v
             * 已经是**地址**了（await/slice 这些聚合表达式按地址给），
             * 再 value_of 一下就变成"把地址当值"，任务里的 val 全是垃圾
             * （tests/tuple_async.c6 的嵌套 await 踩过）。 */
            if (!(CUR_TASK_TY && ty_is_agg(rty)))
                v = value_of(v);
            /* `return <实现对象>` 且返回类型是接口：struct → 接口的隐式
             * 转换平时只在赋值/初始化那条路上做（store_conv），return 漏了，
             * 于是函数直接把 4 字节的实现对象地址交出去，调用方按 16 字节
             * 的 {self, vt} 拷走——vt 读到的是相邻数据，分派就跳野指针。
             * 这里按赋值同一条路先物化出 {self, vt} 再返回。 */
            if (TY_HAS_IFACE && NIFACE > 0 && ty_is_iface(CUR_RET_TY, NULL)
                && ty_is_agg(rty) && !ty_is_iface(rty, NULL)) {
                u32 rs = ty_size(CUR_RET_TY) ? ty_size(CUR_RET_TY) : 16;
                u32 ra = irfn_vreg(&FN);

                irfn_push(&FN, IR_ADDR, IRT_PTR, ra, 0, 0, 0,
                          X64_SLOT(frame_slots_for(rs)));
                store_conv(ra, CUR_RET_TY, v, rty);
                v = ra;
                rty = CUR_RET_TY;
            }
            pa_expect_ch(';');
            /* 按**函数声明的返回类型**转换。少了这步，返回 signed char 的函数
             * 会把 0x80 原样带回去（调用方按 signed char 解释就是 +128），返回
             * float 的函数会把 double 的位模式整个带回去（踩过）。 */
            if (CUR_TASK_TY) {
                /* async 函数：返回值放进新建的任务结构，返回它的指针 */
                u32 a1 = irfn_vreg(&FN);
                u32 a2 = irfn_vreg(&FN);
                u32 tsk = 0;

                if (!on_err && CUR_TASK_VAL && ty_is_scalar(CUR_TASK_VAL)
                    && rty != CUR_TASK_VAL)
                    v = gen_convert(v, rty, CUR_TASK_VAL);
                tsk = task_get();
                /* 失败路径（`return err(...)`）**不写 val**：任务结构是 calloc
                 * 出来的，val 已经是全 0，也就是 +0.0 / 0 / NULL。把 err 的
                 * 返回码转换后写进去就成了 44.0 这种垃圾（tests/async.c6 的
                 * "double!error 失败路径写回 +0.0" 踩过）。 */
                if (!on_err) {
                    u32 voff = task_val_off();
                    u32 dst2 = tsk;

                    if (voff) {
                        dst2 = irfn_vreg(&FN);
                        irfn_push(&FN, IR_LEA, IRT_PTR, dst2, tsk, 0, 0, voff);
                    }
                    if (ty_is_agg(rty))
                        /* 聚合表达式：v 是它的地址，按字节拷进 val。
                         * 看的是**表达式**的类型：`return err(9, "…")` 在元组
                         * 返回的 async 函数里也合法，那时 v 是标量，不能当地址拷。 */
                        irfn_push(&FN, IR_COPY, IRT_U8, dst2, v, 0, 0,
                                  ty_size(rty) ? ty_size(rty) : 8);
                    else
                        irfn_push(&FN, IR_STORE, IRT_U64, dst2, v, 0, 0, 0);
                    /* `return new T;`（新引用）也是"交进 val 槽"：记上标记，
                     * 销毁任务时由运行时放掉，`t->val` 也就按托管字段处理
                     * （tests/gc_async.c6 的 t4_make_fresh 这条）。 */
                    if (v_took) {
                        u32 ov2 = irfn_vreg(&FN);
                        u8 vi9[1] = {7};
                        u8 vk9[1] = {0};
                        u8 vc9[1] = {0};

                        mgdst_add(CUR_TASK_TY, vi9, vk9, vc9, 1, (u32)pa_cur()->file);
                        irfn_push(&FN, IR_ARG, IRT_U64, 0, tsk, 0, 0, 0);
                        irfn_push(&FN, IR_CALL, IRT_VOID, ov2, 0, 0, 0,
                                  x64_sym(&X64, "__c6_co_ownval"));
                        FN.ops[FN.n - 1].narg = 1;
                    }
                }
                task_seal(tsk);
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, IRT_PTR, 0, tsk, 0, 0, 0);
            } else {
                if (ty_is_scalar(CUR_RET_TY) && rty != CUR_RET_TY)
                    v = gen_convert(v, rty, CUR_RET_TY);
                /* `return agg;` 且本函数还有没跑的 cleanup：C 的语义是**先把
                 * 返回值拷出去、再跑 cleanup**（gcc 就这么排）。不拷的话，
                 * 那种会改写原对象的 cleanup（`my_cleanup2` 把每个成员改写成
                 * 0x90…）会把调用者看到的返回值一起改掉——tcc tests2/
                 * 101_cleanup 的 test_cleanup2/3/4/6 就是这么错的。
                 * 没有 cleanup 时不拷，热路径上不多一条。 */
                if (ty_is_agg(CUR_RET_TY) && CL_N > 0 && ty_size(CUR_RET_TY)) {
                    u32 rsz = ty_size(CUR_RET_TY);
                    u32 raddr = irfn_vreg(&FN);

                    irfn_push(&FN, IR_ADDR, IRT_PTR, raddr, 0, 0, 0,
                              X64_SLOT(frame_slots_for(rsz)));
                    irfn_push(&FN, IR_COPY, IRT_U8, raddr, v, 0, 0, rsz);
                    v = raddr;
                }
                v = ret_agg_copy(v);
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                ret_emit(v);
            }
        }
        return;
    }
    if (PA_ACCEPT_IDENT("if")) {
        u32 lthen = irfn_label(&FN);
        mv_push();
        u32 lelse = irfn_label(&FN);
        u32 lend = irfn_label(&FN);
        u32 c = 0;

        pa_expect_ch('(');
        c = value_of(gen_expr());
        pa_expect_ch(')');
        irfn_push(&FN, IR_BR, IRT_VOID, 0, c, lthen, lelse, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lthen, 0, 0, 0);
        gen_stmt();
        mv_save_tmp();          /* then 分支的状态 */
        mv_restore();           /* else 从"进来时"的状态开始 */
        if (PA_ACCEPT_IDENT("else")) {
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, lend, 0, 0, 0);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lelse, 0, 0, 0);
            gen_stmt();
        } else {
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lelse, 0, 0, 0);
        }
        mv_union_tmp();         /* 汇合：任一条路移走了就算移走 */
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
        mv_pop();
        return;
    }
    /* c6 `foreach (T v = it)` / `foreach ((T i, T v) = it)`：数组与切片。
     * 语法：foreach ( ['('] T1 n1 [, T2 n2] [')'] = expr ) stmt
     * 展开成"快照 ptr/len + 普通循环"。 */
    if (c6_kw() && PA_ACCEPT_IDENT("foreach")) {
        u32 bty[2] = {0};
        u32 bsl[2] = {0};
        int bnamed[2] = {0};
        int bmgd[2] = {0};        /* 绑定是托管引用（每轮收尾要放掉） */
        int bdisc[2] = {0};       /* 绑定名是 `_`（丢弃） */
        int nb = 0;
        int two = 0;
        u32 ltop = 0;
        u32 lbody = 0;
        u32 lcont = 0;
        u32 lend = 0;
        u32 pslot = 0;
        u32 nslot = 0;
        u32 islot = 0;
        u32 vbind = 0;
        u32 itslot = 0;
        u32 iter_has = 0;
        u32 iter_next = 0;
        int is_iter = 0;
        int shadowed = 0;         /* 类型上有同名字段，字段遮蔽方法 */
        int iter_ok = 0;
        int iter_own = 0;         /* 迭代器是"临时托管引用"，出口要放掉 */
        int iter_ifx = 0;         /* >0：接口值迭代器（IFACE 下标 + 1） */
        u32 iter_mi_has = 0;
        u32 iter_mi_next = 0;
        u32 ety_el = 0;           /* 被遍历序列的**元素**类型（可能和绑定类型不同） */
        int is_range = 0;         /* `foreach (T i = lo:hi)` 半开整数区间 */
        u32 rlo = 0;
        u32 rhi = 0;

        scope_enter();
        pa_expect_ch('(');
        two = pa_accept_ch('(');
        for (;;) {
            Declarator dn = {0};
            u32 t1 = 0;

            /* 头里得先有个类型名（tests/errors/foreach_head.c6 的 test_no_type：
             * `foreach (v = a)` 里的 v 是变量，不是类型）。 */
            {
                int head_ty = is_typename_tok(pa_cur());

                if (c6_kw()
                    && (pa_is_ch('@') || PA_IS_IDENT("shared")
                        || PA_IS_IDENT("weak") || PA_IS_IDENT("own")))
                    head_ty = 1;      /* `@T` / `shared @T` 也是类型写法 */
                if (!head_ty && pa_cur()->kind == TK_IDENT) {
                    Sym *hs = sym_find(tok_data(pa_cur()), pa_cur()->len);

                    if (hs && hs->kind == SC_TYPEDEF)
                        head_ty = 1;
                    if (sym_find_tag(tok_data(pa_cur()), pa_cur()->len))
                        head_ty = 1;
                    /* 模板实例 `Vect@int` 也是类型 */
                    if (pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
                        && TOK_EQ(pa_peek(1), "@"))
                        head_ty = 1;
                }
                if (!head_ty)
                    pa_error("a type name expected in the head of 'foreach'");
            }
            t1 = parse_typespec();
            (void)parse_declarator(t1, &dn);
            /* 绑定类型要用**声明符解析出来的完整类型**：`foreach (char *s =
             * ws)` 的 `t1` 只是 `char`，用 t1 会把指针当字符读（ld1 一个
             * 指针，再当 %s 传下去，直接段错误）。 */
            if (dn.type)
                t1 = dn.type;
            /* 绑定本身的合法性（tests/errors/foreach_head.c6） */
            if (t1 == ty_void())
                pa_error("a 'foreach' binding cannot be 'void'");
            else if (ty_is_array(t1))
                pa_error("a 'foreach' binding cannot be an array");
            if (!dn.name)
                pa_error("identifier expected");
            else if (dn.nlen == 1 && dn.name[0] == '_')
                bdisc[nb] = 1;
            if (nb == 1 && bdisc[0] && bdisc[1])
                pa_error("'foreach' discards both binders");
            if (nb < 2) {
                bty[nb] = t1;
                /* 元素是聚合体时绑定是"一个对象"，得占帧里的对象槽；标量绑定
                 * 才是一个 vreg（否则 `p.a` 会从装着地址的寄存器里取字段）。 */
                if ((ty_is_agg(t1) && ty_size(t1) > 0) || (dn.mgd && dn.mgd_kind != 1))
                    bsl[nb] = frame_slots_for(ty_size(t1) ? ty_size(t1) : 8);
                else
                    bsl[nb] = irfn_vreg(&FN);
                bmgd[nb] = (dn.mgd && dn.mgd_kind != 1) ? 1 : 0;
                if (dn.name && !(dn.nlen == 1 && dn.name[0] == '_')) {
                    Sym *sb = sym_add(dn.name, dn.nlen, t1, SC_LOCAL);

                    sb->slot = bsl[nb];
                    bnamed[nb] = 1;
                }
                nb++;
            }
            if (!pa_accept_ch(','))
                break;
        }
        if (two)
            pa_expect_ch(')');
        pa_expect_ch('=');
        {
            int had_lval = PEND_LVAL;
            int iv_lval = 0;
            u32 iv = 0;
            u32 ivty = 0;
            u32 base = 0;
            int lit_n = 0;           /* 被遍历的是字符串字面量时，它的元素个数 */

            /* `foreach (char c = "abc")`：字面量在表达式里是 `char *`，长度
             * 只有解析时才知道（含结尾 NUL，所以是 token 长度 - 1 再 +1）。 */
            if (pa_cur()->kind == TK_STR && pa_cur()->len >= 2)
                lit_n = (int)pa_cur()->len - 1;
            iv = gen_assign();
            ivty = PEND_LVAL ? PEND_TY : GEN_TY;
            {
                /* `foreach (int v = make_mcount(2))`：迭代器是个临时的托管
                 * 引用，循环完得放掉（不然每跑一次漏一个） */
                int iv_call0 = E_WAS_CALL;

                iter_own = (!PEND_LVAL && iv_call0 && ty_is_ptr(ivty)) ? 1 : 0;
            }
            base = iv;

            iv_lval = PEND_LVAL;
            if (PEND_LVAL) {
                base = PEND_ADDR;
                PEND_LVAL = 0;
            }
            /* 半开整数区间 `foreach (T i = lo:hi)`。
             * `had_lval` 是**进 gen_assign 之前**的快照，和 `lo` 是不是左值没
             * 关系；下界是变量时 `iv` 拿到的是它的地址，当循环下界用就一次都
             * 不转（`foreach (int i = lo:hi)`）。 */
            if (two && pa_is_ch(':'))
                pa_error("a range yields only an index");
            if (!two && nb >= 1 && pa_is_ch(':')) {
                rlo = iv_lval ? load_lval(base, ivty) : value_of(iv);
                pa_advance();
                rhi = value_of(gen_assign());
                is_range = 1;
                islot = bsl[0];
                nslot = 0;
                pa_expect_ch(')');
                goto range_done;
            }
            pslot = irfn_vreg(&FN);
            nslot = irfn_vreg(&FN);
            if (ty_is_slice(ivty)) {
                u32 dv = irfn_vreg(&FN);
                u32 a8 = irfn_vreg(&FN);

                ety_el = ty_slice_elem(ivty);

                irfn_push(&FN, IR_LOAD, IRT_PTR, dv, base, 0, 0, 0);
                irfn_push(&FN, IR_MOV, IRT_PTR, pslot, dv, 0, 0, 0);
                irfn_push(&FN, IR_LEA, IRT_PTR, a8, base, 0, 0, 8);
                irfn_push(&FN, IR_LOAD, IRT_U64, nslot, a8, 0, 0, 0);
            } else if (ty_is_array(ivty)) {
                ety_el = ty_target(ivty);
                if (ty_array_n(ivty) == 0)
                    pa_error("cannot iterate over an array of unknown length");
                irfn_push(&FN, IR_MOV, IRT_PTR, pslot, base, 0, 0, 0);
                irfn_push(&FN, IR_CONST, IRT_U64, nslot, 0, 0, 0, ty_array_n(ivty));
            } else if (ty_is_agg(ivty)
                       || (ty_is_ptr(ivty) && ty_is_agg(ty_target(ivty)))) {
                /* 迭代器协议：可迭代值的类型提供 `has(T *)` / `next(T *)`。
                 * 也可以是**指向迭代器的指针**（`foreach (int v = &g)`），
                 * 这时那个指针本身就是迭代器地址，不用另开槽拷一份。 */
                /* 按**迭代器指针类型**挑重载：一个文件里往往给好几种类型
                 * 都写了 has()/next()，光按名字查拿到的是最后登记的那个
                 * （踩过：`foreach (char *s = ws)` 调到了 struct Pairs 的
                 * has/next，循环一次都不跑）。 */
                u32 ipty = ty_is_ptr(ivty) ? ivty : ty_ptr(ivty);
                u32 sty_it = ty_is_ptr(ivty) ? ty_target(ivty) : ivty;
                /* 参考实现（tcc 那边的 c6_iter_proto_of）找的是**这个
                 * 类型的方法表项**（`c6_method_of(tag, has)`）——首形参是
                 * `T *` 的普通函数也算方法，所以先查方法表；查不到才退回
                 * 按名字 + 首形参类型挑重载。 */
                Sym *sh = meth_find(sty_it, "has", 3);
                Sym *sn = meth_find(sty_it, "next", 4);
                u32 ifx0 = 0;

                /* 接口值迭代器：`interface IntIter { int has(); int next(); }`
                 * 按方法表分派，不能去符号表挑一个同名自由函数。 */
                if (NIFACE > 0 && ty_is_iface(ivty, &ifx0)) {
                    iter_ifx = (int)ifx0 + 1;
                    iter_mi_has = iface_slot(ifx0, "has", 3);
                    iter_mi_next = iface_slot(ifx0, "next", 4);
                    if (iter_mi_has == 0xFFFFFFFFu || iter_mi_next == 0xFFFFFFFFu)
                        pa_error("foreach：接口里没有 has()/next()，不能当迭代器");
                    ety_el = IFACE_RET[ifx0][iter_mi_next];
                    /* 接口值的 next 返回类型同样要有具体元素类型：
                     * `void *` 等于把元素类型擦掉了（foreach_iter 的
                     * test_interface_voidptr）。 */
                    if (ety_el == ty_void())
                        pa_error("iterator method 'next' must return a value (got 'void')");
                    else if (ty_is_ptr(ety_el) && ty_target(ety_el) == ty_void())
                        pa_error("iterator method 'next' cannot return 'void *': the "
                                 "element type would be erased (return 'E' or 'E *' "
                                 "with a concrete E)");
                }
                u32 itaddr = 0;

                if (!iter_ifx) {
                    /* 结构体上有**真字段**叫 has/next 时，字段遮蔽方法，这个
                     * 类型就不是迭代器（`p->has()` 是读字段）。这时候**不能**
                     * 再退回按名字挑自由函数——那会把别的类型的 has/next 认成
                     * 自己的（tests/errors/foreach_iter.c6 的 test_shadow）。 */
                    if (ty_is_agg(sty_it)
                        && (agg_has_member(sty_it, "has", 3)
                            || agg_has_member(sty_it, "next", 4))) {
                        sh = NULL;
                        sn = NULL;
                        shadowed = 1;
                    }
                    if (!shadowed && !sh)
                        sh = sym_find_fn("has", 3, 1, ipty);
                    if (!shadowed && !sn)
                        sn = sym_find_fn("next", 4, 1, ipty);
                    /* 签名口径和参考实现一致：两个都只收接收者，has 返回整数 */
                    if (sh && ty_func_nparams(sh->type) != 1)
                        pa_error("iterator method 'has' must take only the receiver");
                    if (sh && sh->is_func && !ty_is_int(ty_func_ret(sh->type)))
                        pa_error("iterator method 'has' must return an integer type (got '%s')",
                                 ty_disp(ty_func_ret(sh->type)));
                    if (sn && ty_func_nparams(sn->type) != 1)
                        pa_error("iterator method 'next' must take only the receiver");
                    /* next 的返回类型决定元素类型，限制不少 */
                    if (sn && sn->is_func) {
                        u32 nret = ty_func_ret(sn->type);

                        if (nret == ty_void())
                            pa_error("iterator method 'next' must return a value (got 'void')");
                        else if (ty_is_ptr(nret) && ty_target(nret) == ty_void())
                            pa_error("iterator method 'next' cannot return 'void *': "
                                     "the element type would be erased (return 'E' or "
                                     "'E *' with a concrete E)");
                        else if (ty_is_array(ty_is_ptr(nret) ? ty_target(nret) : nret))
                            pa_error("'foreach' cannot copy an element of type '%s'",
                                     ty_disp(nret));
                        else if (ty_is_agg(ty_is_ptr(nret) ? ty_target(nret) : nret)
                                 && ty_size(ty_is_ptr(nret) ? ty_target(nret) : nret) == 0)
                            pa_error("cannot iterate over incomplete element type '%s'",
                                     ty_disp(ty_is_ptr(nret) ? ty_target(nret) : nret));
                        else if (ty_has_mgd(nret))
                            pa_error("'%s' holds managed references: a foreach binding "
                                     "is not possible. Allocate it with 'new' and hold "
                                     "it in '@%s'", ty_disp(nret), ty_disp(nret));
                    }
                }
                if (!iter_ifx && (!sh || !sh->is_func || !sn || !sn->is_func))
                    pa_error("cannot iterate over '%s' (no 'has'/'next' iterator: use a "
                             "slice parameter 'T[:]', or '(T[:]){p, n}')", ty_disp(ivty));
                if (ty_is_ptr(ivty)) {
                    /* 已经是指针：迭代器地址就是它的**值**。注意别用 base
                     * ——`foreach (int v = p)` 的 p 是左值，base 是它的地址，
                     * has() 会去读指针自己的字节（踩过：托管迭代器的测试
                     * 死循环）。 */
                    /* 迭代器是左值时 iv 是它的**地址**（左值约定），要取
                     * 值：和半开区间那里一样用 load_lval。 */
                    itaddr = iv_lval ? load_lval(base, ivty) : value_of(iv);
                } else {
                    itslot = frame_slots_for(ty_size(ivty) ? ty_size(ivty) : 8);
                    itaddr = irfn_vreg(&FN);
                    irfn_push(&FN, IR_ADDR, IRT_PTR, itaddr, 0, 0, 0, X64_SLOT(itslot));
                    irfn_push(&FN, IR_COPY, IRT_U8, itaddr, base, 0, 0,
                              ty_size(ivty) ? ty_size(ivty) : 8);
                }
                iter_has = sh ? (u32)sh->val : 0;
                if (iter_ifx) {
                    iter_has = 0;
                    iter_next = 0;
                    iter_ok = 1;
                } else {
                    iter_next = sn ? (u32)sn->val : 0;
                    iter_ok = (sh && sh->is_func && sn && sn->is_func) ? 1 : 0;
                }
                is_iter = 1;
                /* 迭代器每步只产出一个值：两个绑定是"键 + 值"的写法，只有
                 * 区间和数组/切片支持（tests/errors/foreach_head.c6 的
                 * pair_iterator、foreach_iter.c6 的 two_binders）。 */
                if (two)
                    pa_error("an iterator yields only a value: write "
                             "'foreach (T v = it) { ... }'");
                islot = itaddr;         /* 迭代器地址，下面按迭代器发循环 */
                (void)pslot;
                (void)nslot;
            } else if (lit_n > 0 && ty_is_ptr(ivty)
                       && ty_target(ivty) == ty_char()) {
                /* 字符串字面量：当成 `char[lit_n]` 走数组那条路 */
                u32 cnt = irfn_vreg(&FN);

                ety_el = ty_char();
                irfn_push(&FN, IR_MOV, IRT_PTR, pslot, base, 0, 0, 0);
                irfn_push(&FN, IR_CONST, IRT_U64, cnt, 0, 0, 0, (u32)lit_n);
                irfn_push(&FN, IR_MOV, IRT_U64, nslot, cnt, 0, 0, 0);
            } else {
                pa_error("foreach 只能遍历数组或切片");
                irfn_push(&FN, IR_MOV, IRT_PTR, pslot, base, 0, 0, 0);
                irfn_push(&FN, IR_CONST, IRT_U64, nslot, 0, 0, 0, 0);
            }
        }
        pa_expect_ch(')');
        vbind = two ? (nb >= 2 ? bsl[1] : 0) : bsl[0];
        if (is_iter) {
            /* while (has(&it)) { v = next(&it); body } */
            u32 iaddr = islot;

            ltop = irfn_label(&FN);
            lbody = irfn_label(&FN);
            lcont = irfn_label(&FN);
            lend = irfn_label(&FN);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ltop, 0, 0, 0);
            {
                u32 hv = 0;

                if (iter_ifx)
                    hv = gen_iface_call(iaddr, iter_mi_has, ty_int(), NULL, 0);
                else {
                    hv = irfn_vreg(&FN);
                    irfn_push(&FN, IR_ARG, IRT_U64, 0, iaddr, 0, 0, 0);
                    irfn_push(&FN, IR_CALL, IRT_I32, hv, 0, 0, 0, iter_has);
                    FN.ops[FN.n - 1].narg = 1;
                }
                irfn_push(&FN, IR_BR, IRT_VOID, 0, hv, lbody, lend, 0);
            }
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lbody, 0, 0, 0);
            if (vbind) {
                u32 elty0 = two ? bty[1] : bty[0];
                u32 nv = 0;

                if (iter_ifx)
                    nv = gen_iface_call(iaddr, iter_mi_next, elty0, NULL, 0);
                else {
                    nv = irfn_vreg(&FN);
                    irfn_push(&FN, IR_ARG, IRT_U64, 0, iaddr, 0, 0, 0);
                    irfn_push(&FN, IR_CALL, ir_ty_of(elty0), nv, 0, 0, 0, iter_next);
                    FN.ops[FN.n - 1].narg = 1;
                }
                if (bmgd[two ? (nb >= 2 ? 1 : 0) : 0] && !bnamed[two ? (nb >= 2 ? 1 : 0) : 0]) {
                    /* `foreach (@T _ = it)`：next() 交回来的引用没人接手，
                     * 当场放掉（不然每轮漏一个） */
                    mgd_release(nv);
                } else if (ty_is_agg(elty0) && ty_size(elty0) > 0) {
                    /* 聚合体元素按地址约定交回来：拷进绑定自己的对象槽，
                     * 不能把地址本身当值（踩过：`foreach (struct Pair p =
                     * ps)` 里 p.a 读到的是栈地址）。 */
                    u32 bdst = irfn_vreg(&FN);

                    irfn_push(&FN, IR_ADDR, IRT_PTR, bdst, 0, 0, 0, X64_SLOT(vbind));
                    irfn_push(&FN, IR_COPY, IRT_U8, bdst, nv, 0, 0,
                              ty_size(elty0));
                } else {
                    irfn_push(&FN, IR_MOV, ir_ty_of(elty0), vbind, nv, 0, 0, 0);
                }
            }
            LOOP_BRK[NLOOP] = lend;
            LOOP_CNT[NLOOP] = lcont;
            LOOP_DFB[NLOOP] = DEF_DEPTH;
            LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
            gen_vla_loop_push();
            mv_loop_enter();
            if (pa_is_ch('{'))
                gen_block();
            else
                pa_error("foreach 后面要一个 { … } 块");
            mv_loop_leave();
            NLOOP--;
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lcont, 0, 0, 0);
            /* 托管绑定：每轮收尾把这一轮拿到的引用放掉（`lcont` 之后才放，
             * 这样 `continue` 也走得到；出口再放一次，兜住 `break`）。 */
            if (bmgd[0] && bnamed[0])
                mgd_release_slot(vbind);
            if (two && bmgd[1] && bnamed[1])
                mgd_release_slot(vbind);
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, ltop, 0, 0, 0);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
            if (iter_own)
                mgd_release(islot);
            if (bmgd[0] && bnamed[0])
                mgd_release_slot(vbind);
            if (two && bmgd[1] && bnamed[1])
                mgd_release_slot(vbind);
            scope_leave();
            (void)iter_ok;
            return;
        }
    range_done:
        /* 绑定声明成托管引用（`@T v`）时，元素本身必须是引用：`@int v` 绑到
         * 一个 int 元素上等于凭空造引用（tests/errors/foreach_head.c6 的
         * test_ownership）。 */
        if (!is_range && ety_el) {
            int bi = 0;

            for (bi = 0; bi < nb; bi++)
                if (bmgd[bi] && !ty_is_ptr(ety_el))
                    pa_error("a 'foreach' binding cannot change ownership");
        }
        if (is_range) {
            u32 lb = islot;

            /* vreg 0 是合法槽位（irfn_vreg 从 0 开始发号）。以前这里写
             * `if (lb)`，于是「foreach 绑定恰好是该函数的第一个 vreg」时整段
             * 循环体都不被解析，body 里的标识符掉到函数作用域报未声明。
             * 区间形式必然有一个绑定（双绑定在前面已经报错），直接展开。 */
            {
                /* 计数器放**隐藏槽**里，绑定每轮拿一份副本：`foreach (size_t i =
                 * 0:3) { i = 99; }` 里改绑定不能影响迭代次数。 */
                u32 rcnt = irfn_vreg(&FN);

                irfn_push(&FN, IR_MOV, ir_ty_of(bty[0]), rcnt, rlo, 0, 0, 0);
                ltop = irfn_label(&FN);
                lbody = irfn_label(&FN);
                lcont = irfn_label(&FN);
                lend = irfn_label(&FN);
                irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ltop, 0, 0, 0);
                {
                    u32 c2 = irfn_vreg(&FN);
                    u8 cc = ty_is_signed(bty[0]) ? IRCC_LT : IRCC_ULT;

                    irfn_push(&FN, IR_CMP, IRT_U64, c2, rcnt, rhi, 0, cc);
                    FN.ops[FN.n - 1].flags = cc;
                    irfn_push(&FN, IR_BR, IRT_VOID, 0, c2, lbody, lend, 0);
                    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lbody, 0, 0, 0);
                    irfn_push(&FN, IR_MOV, ir_ty_of(bty[0]), lb, rcnt, 0, 0, 0);
                }
                LOOP_BRK[NLOOP] = lend;
                LOOP_CNT[NLOOP] = lcont;
                LOOP_DFB[NLOOP] = DEF_DEPTH;
                NLOOP++;
                gen_vla_loop_push();
                mv_loop_enter();
                if (pa_is_ch('{'))
                    gen_block();
                else
                    pa_error("foreach 后面要一个 { … } 块");
                mv_loop_leave();
                NLOOP--;
                irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lcont, 0, 0, 0);
                {
                    u32 one = irfn_vreg(&FN);
                    u32 nx = irfn_vreg(&FN);

                    irfn_push(&FN, IR_CONST, IRT_U64, one, 0, 0, 0, 1);
                    irfn_push(&FN, IR_ADD, IRT_U64, nx, rcnt, one, 0, 0);
                    irfn_push(&FN, IR_MOV, ir_ty_of(bty[0]), rcnt, nx, 0, 0, 0);
                }
                irfn_push(&FN, IR_JMP, IRT_VOID, 0, ltop, 0, 0, 0);
                irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
            }
            scope_leave();
            return;
        }
        /* 单绑定形式 `(T v = …)` 里那个绑定是**值**，下标是隐藏临时量；
         * 两绑定形式 `((T i, T v) = …)` 才是 下标 + 值。 */
        /* 下标也放隐藏槽：`foreach ((size_t i, int v) = a) { i = 99; }` 里改
         * 绑定不能影响迭代（绑定每轮拿一份副本）。 */
        islot = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, islot, 0, 0, 0, 0);
        ltop = irfn_label(&FN);
        lbody = irfn_label(&FN);
        lcont = irfn_label(&FN);
        lend = irfn_label(&FN);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ltop, 0, 0, 0);
        {
            u32 c2 = irfn_vreg(&FN);

            irfn_push(&FN, IR_CMP, IRT_U64, c2, islot, nslot, 0, IRCC_ULT);
            irfn_setcc(&FN, IRCC_ULT);
            irfn_push(&FN, IR_BR, IRT_VOID, 0, c2, lbody, lend, 0);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lbody, 0, 0, 0);
            if (two && bsl[0])
                irfn_push(&FN, IR_MOV, ir_ty_of(bty[0]), bsl[0], islot, 0, 0, 0);
        }
        if (vbind) {
            u32 vt = two ? bty[1] : bty[0];
            /* 步长按**元素**大小算：`foreach (long v = s)`（s 是 char[]）以前
             * 按绑定类型的 8 字节步进，读出来全是垃圾。 */
            u32 et2 = ety_el ? ety_el : vt;
            u32 esz = ty_size(et2) ? ty_size(et2) : 1;
            u32 off = irfn_vreg(&FN);
            u32 m = irfn_vreg(&FN);
            u32 a = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, off, 0, 0, 0, esz);
            irfn_push(&FN, IR_MUL, IRT_U64, m, islot, off, 0, 0);
            irfn_push(&FN, IR_LEA, IRT_PTR, a, pslot, m, 0, 0);
            irfn_push(&FN, IR_LOAD, ir_ty_of(et2), vbind, a, 0, 0, 0);
            /* 元素类型和绑定类型不同时按赋值规则转换（char -> long 之类） */
            if (et2 != vt) {
                u32 cv = gen_convert(vbind, et2, vt);

                irfn_push(&FN, IR_MOV, ir_ty_of(vt), vbind, cv, 0, 0, 0);
            }
            /* 托管元素是**借**的（数组还持有它）：绑定加一次计数，每轮收尾
             * 放掉（不然后面 a[0] = 0 一放，活计数就对不上了）。 */
            if (bmgd[two ? 1 : 0] && bnamed[two ? 1 : 0])
                mgd_retain_slot(vbind);
        }
        LOOP_BRK[NLOOP] = lend;
        LOOP_CNT[NLOOP] = lcont;
        LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
        gen_vla_loop_push();
        mv_loop_enter();
        if (pa_is_ch('{'))
            gen_block();
        else
            pa_error("foreach 后面要一个 { … } 块");
        mv_loop_leave();
        NLOOP--;
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lcont, 0, 0, 0);
        if (vbind && bmgd[two ? 1 : 0] && bnamed[two ? 1 : 0])
            mgd_release_slot(vbind);
        {
            u32 one = irfn_vreg(&FN);
            u32 nx = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, one, 0, 0, 0, 1);
            irfn_push(&FN, IR_ADD, IRT_U64, nx, islot, one, 0, 0);
            irfn_push(&FN, IR_MOV, IRT_U64, islot, nx, 0, 0, 0);
        }
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, ltop, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
        if (vbind && bmgd[two ? 1 : 0] && bnamed[two ? 1 : 0])
            mgd_release_slot(vbind);
        scope_leave();
        (void)bnamed;
        (void)two;
        return;
    }
    if (PA_ACCEPT_IDENT("while")) {
        u32 ltop = irfn_label(&FN);
        u32 lbodY = irfn_label(&FN);
        u32 lend = irfn_label(&FN);
        u32 c = 0;

        /* 标签必须在条件**之前**发出：条件本身会产生算 cmp 的指令，
         * 标签放在后面会让回边跳过条件求值（死循环）。 */
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ltop, 0, 0, 0);
        pa_expect_ch('(');
        c = value_of(gen_expr());
        pa_expect_ch(')');
        irfn_push(&FN, IR_BR, IRT_VOID, 0, c, lbodY, lend, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lbodY, 0, 0, 0);
        LOOP_BRK[NLOOP] = lend;
        LOOP_CNT[NLOOP] = ltop;
        LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
        gen_vla_loop_push();
        mv_loop_enter();
        gen_stmt();
        mv_loop_leave();
        NLOOP--;
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, ltop, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
        return;
    }
    if (PA_ACCEPT_IDENT("for")) {
        u32 ltop = irfn_label(&FN);
        u32 lcont = irfn_label(&FN);
        u32 lbody = irfn_label(&FN);
        u32 lend = irfn_label(&FN);
        /* 条件不成立时的落点：先跑 init 作用域的清理，再到 lend。break 直接跳
         * lend（它已经就地跑过清理了），所以两条出口不会重复。 */
        u32 lclean = irfn_label(&FN);

        pa_expect_ch('(');
        scope_enter();
        /* `for (T v = …; …)`：init 里声明的变量属于 for 自己的作用域（循环结束
         * 就销毁），所以这里单独开一层深度。continue 不清理它，break 和循环正常
         * 结束要清理它（C 标准：离开作用域就跑 cleanup 函数）。 */
        DEF_DEPTH++;
        blk_chain_push();
        if (!pa_accept_ch(';')) {
            if (is_typename_tok(pa_cur()))
                gen_local_decl(1);
            else {
                (void)value_of(gen_expr());
                pa_expect_ch(';');
            }
        }
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ltop, 0, 0, 0);
        if (!pa_accept_ch(';')) {
            u32 c = value_of(gen_expr());

            pa_expect_ch(';');
            irfn_push(&FN, IR_BR, IRT_VOID, 0, c, lbody, lclean, 0);
        } else {
            /* 空条件 `for (init; ; incr)`：没有条件分支，就得有**无条件**跳进
             * 循环体。少了这一条，控制流从 ltop 直接落到 lcont（先跑 incr）再
             * 跳回 ltop，循环体永远进不去——编译出来的程序死循环且一行 print
             * 都不出。tcc 的 `for (popt = tcc_options; ; ++popt)` 正好踩这个。 */
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, lbody, 0, 0, 0);
        }
        /* 源码顺序是 init; cond; incr; body，而 IR 里 body 要在 incr 之后执行，
         * 所以先跳过 incr 把 body 接在后面（token 只读一遍，不回头）。 */
        if (pa_accept_ch(')')) {
            LOOP_BRK[NLOOP] = lend;
            LOOP_CNT[NLOOP] = lcont;
            LOOP_DFB[NLOOP] = DEF_DEPTH;
            LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
            gen_vla_loop_push();
            LOOP_OWN[NLOOP - 1] = 1;      /* for 自己那层 init 作用域 */
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lbody, 0, 0, 0);
            mv_loop_enter();
            gen_stmt();
            mv_loop_leave();
            NLOOP--;
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lcont, 0, 0, 0);
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, ltop, 0, 0, 0);
            /* 循环正常结束（条件不成立落到 lclean）也要跑 init 作用域的清理。
             * 放在 lend 之前：break 跳过去时不能重复跑。 */
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lclean, 0, 0, 0);
            defer_run_pop(DEF_DEPTH);
            DEF_DEPTH--;
            if (SCOPE && SCOPE->vla_save)
                irfn_push(&FN, IR_SETRSP, IRT_VOID, 0, SCOPE->vla_save, 0, 0, 0);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
            scope_leave();
            return;
        }
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, lcont, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lcont, 0, 0, 0);
        (void)value_of(gen_expr());
        pa_expect_ch(')');
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, ltop, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lbody, 0, 0, 0);
        LOOP_BRK[NLOOP] = lend;
        LOOP_CNT[NLOOP] = lcont;
        LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
        gen_vla_loop_push();
        LOOP_OWN[NLOOP - 1] = 1;          /* for 自己那层 init 作用域 */
        mv_loop_enter();
        gen_stmt();
        mv_loop_leave();
        NLOOP--;
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, lcont, 0, 0, 0);
        /* 循环正常结束：init 作用域的清理（和上面那条分支同理） */
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lclean, 0, 0, 0);
        defer_run_pop(DEF_DEPTH);
        DEF_DEPTH--;
        if (SCOPE && SCOPE->vla_save)
            irfn_push(&FN, IR_SETRSP, IRT_VOID, 0, SCOPE->vla_save, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
        scope_leave();
        return;
    }
    if (PA_ACCEPT_IDENT("do")) {
        u32 ltop = irfn_label(&FN);
        u32 lcont = irfn_label(&FN);
        u32 lend = irfn_label(&FN);
        u32 c = 0;

        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, ltop, 0, 0, 0);
        LOOP_BRK[NLOOP] = lend;
        LOOP_CNT[NLOOP] = lcont;
        LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
        gen_vla_loop_push();
        mv_loop_enter();
        gen_stmt();
        mv_loop_leave();
        NLOOP--;
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lcont, 0, 0, 0);
        if (!PA_ACCEPT_IDENT("while")) {
            pa_error("do 后面要 while");
            return;
        }
        pa_expect_ch('(');
        c = value_of(gen_expr());
        pa_expect_ch(')');
        pa_expect_ch(';');
        irfn_push(&FN, IR_BR, IRT_VOID, 0, c, ltop, lend, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lend, 0, 0, 0);
        return;
    }
    if (PA_ACCEPT_IDENT("break")) {
        if (PA_IN_DEFER)
            pa_error("'break' is not allowed in a defer body");
        pa_expect_ch(';');
        if (NLOOP > 0) {
            /* `for` 的 init 声明在自己的那一层作用域里：break 跳出整个循环，
             * 那层也要清理（LOOP_DFB + 0）。其它循环没有这一层，照旧 +1。 */
            defer_run(LOOP_DFB[NLOOP - 1] + (LOOP_OWN[NLOOP - 1] ? 0 : 1), 0);
            gen_vla_restore_loop();
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, LOOP_BRK[NLOOP - 1], 0, 0, 0);
        } else {
            pa_error("break 不在循环里");
        }
        return;
    }
    if (PA_ACCEPT_IDENT("continue")) {
        if (PA_IN_DEFER)
            pa_error("'continue' is not allowed in a defer body");
        pa_expect_ch(';');
        if (NLOOP > 0) {
            /* switch 不是 continue 的目标：跳过它，落到外层真正的循环上
             * （`for (…) { switch (i) { case 0: continue; } }` 里循环体那个块
             * 的 cleanup 也得跑，tcc tests2/101_cleanup 的 `-- loop 3 --`）。 */
            int cn = NLOOP - 1;

            while (cn > 0 && LOOP_SW[cn])
                cn--;
            defer_run(LOOP_DFB[cn] + 1, 0);
            gen_vla_restore_loop();
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, LOOP_CNT[NLOOP - 1], 0, 0, 0);
        }
        else
            pa_error("continue 不在循环里");
        return;
    }
    /* 元组解构语句：`(int q, int r) = f();` / `(q, r) = f();` /
     * `(arr[0], arr[1]) = f();`。判据只有一条：括号里 depth 1 上有逗号，
     * 且闭括号后面紧跟 `=`——逗号表达式不能做赋值目标，所以不会误判。
     * 另外还有"元组类型的局部声明"：闭括号后面跟的是标识符。 */
    if (pa_is_ch('(')) {
        int depth = 0;
        int has_comma = 0;
        int q = 0;
        int is_des = 0;
        int is_decl = 0;

        for (q = 0; q < PA_LOOK; q++) {
            Tok *t2 = pa_peek(q);

            if (t2->kind != TK_PUNCT)
                continue;
            if (tok_eq(t2, "(")) {
                depth++;
            } else if (tok_eq(t2, ",") && depth == 1) {
                has_comma = 1;
            } else if (tok_eq(t2, ")")) {
                depth--;
                if (depth == 0) {
                    Tok *nx = pa_peek(q + 1);

                    if (has_comma && nx->kind == TK_PUNCT && TOK_EQ(nx, "="))
                        is_des = 1;
                    else if (has_comma && nx->kind == TK_IDENT)
                        is_decl = 1;
                    break;
                }
            }
        }
        if (is_des) {
            gen_destructure();
            return;
        }
        if (is_decl) {
            gen_local_decl(1);
            return;
        }
    }
    /* `thread h = spawn f();` / `task t = twice(5);`：软关键字，后面跟标识符
     * 才是声明 */
    if ((PA_IS_IDENT("thread") || PA_IS_IDENT("task"))
        && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
        && pa_peek(2) && (pa_peek(2)->kind == TK_PUNCT)) {
        gen_local_decl(1);
        return;
    }
    /* 接口类型开头的局部声明：`Shape t = s;`——接口名不是关键字。 */
    if (NIFACE > 0 && pa_cur()->kind == TK_IDENT
        && iface_find(tok_data(pa_cur()), pa_cur()->len) < IFACE_MAX) {
        gen_local_decl(1);
        return;
    }
    /* 模板实例开头的局部声明：`Vect@int v;`——`Vect` 是标识符不是类型关键字，
     * 但后面跟 `@` 就说明这是类型位置。 */
    if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
        && TOK_EQ(pa_peek(1), "@")) {
        Tmpl *tp = tmpl_find(tok_data(pa_cur()), pa_cur()->len);

        if (tp && !tp->is_func) {
            gen_local_decl(1);
            return;
        }
    }
    /* 托管引用/所有权修饰符开头的局部声明：`@T p = new T;`、
     * `shared @T q = …;` */
    if (c6_kw()
        && (pa_is_ch('@')
            || ((PA_IS_IDENT("shared") || PA_IS_IDENT("weak") || PA_IS_IDENT("own"))
                && (pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), "@"))))) {
        gen_local_decl(1);
        return;
    }
    /* 语句位置上的函数字面量：`int(int x) { … }(4);` / `f = int(int x){…};`
     * ——`类型 ( 参数表 ) {` 这个形状是字面量，不是声明。 */
    if (is_typename_tok(pa_cur()) && pa_peek(1)->kind == TK_PUNCT
        && tok_eq(pa_peek(1), "(")) {
        int ld = 0;
        int lq = 0;
        int lit = 0;

        for (lq = 1; lq < PA_LOOK; lq++) {
            Tok *t2 = pa_peek(lq);

            if (t2->kind != TK_PUNCT)
                continue;
            if (tok_eq(t2, "(")) {
                ld++;
            } else if (tok_eq(t2, ")")) {
                ld--;
                if (ld == 0) {
                    Tok *nx = pa_peek(lq + 1);

                    lit = (nx->kind == TK_PUNCT && TOK_EQ(nx, "{"));
                    break;
                }
            }
        }
        if (lit) {
            u32 v = gen_expr();

            (void)v;
            pa_expect_ch(';');
            return;
        }
    }
    if (pa_at_typename()) {
        gen_local_decl(1);
        return;
    }
    /* c6 的推断声明：`f = <表达式>;` —— f 还没声明过，就按右值的类型就地声明 */
    if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
        && TOK_EQ(pa_peek(1), "=")
        && !sym_find(tok_data(pa_cur()), pa_cur()->len)
        && !sym_find_tag(tok_data(pa_cur()), pa_cur()->len)
        /* 方法体里的 `x = …` 是给接收者的成员赋值，不是"推断声明"——
         * 成员不是符号，`sym_find` 当然找不到它（踩过：方法里写成员
         * 悄悄声明出一个同名局部变量，赋值全丢）。 */
        && !(METHOD_SELF_TY
             && agg_has_member(METHOD_SELF_TY, tok_data(pa_cur()), pa_cur()->len))) {
        char inm[256] = {0};
        u32 inl = pa_cur()->len < 200 ? pa_cur()->len : 200;
        u32 r0 = 0;
        u32 vty = 0;
        u32 r = 0;
        Sym *is = NULL;

        memcpy(inm, tok_data(pa_cur()), inl);
        pa_advance();
        pa_advance();
        r0 = gen_assign();
        vty = cur_op_ty();
        r = value_of(r0);
        is = sym_add(inm, inl, vty, SC_LOCAL);
        if (ty_is_agg(vty) || ty_is_array(vty)) {
            u32 sz = ty_size(vty);
            u32 a = 0;

            if (sz == 0)
                sz = 8;
            is->slot = frame_slots_for(sz);
            a = ident_addr(is);
            irfn_push(&FN, IR_COPY, IRT_U8, a, r, 0, 0, sz);
        } else {
            is->slot = irfn_vreg(&FN);
            irfn_push(&FN, IR_MOV, ir_ty_of(vty), is->slot, r, 0, 0, 0);
        }
        pa_expect_ch(';');
        return;
    }
    E_CALL_FALLIBLE = 0;
    {
        u32 v = value_of(gen_expr());

        BLOCK_VAL = v;
        BLOCK_TY = GEN_TY;
        BLOCK_HAS = 1;
    }
    /* 可失败函数的返回值必须被处理掉：丢掉就等于把错误吞了。
     * tests/errors/try.c6 的 test_result_unused。 */
    if (E_CALL_FALLIBLE == 1 && in_c6_tu())
        pa_error("the result of a 'T!error' function must be used with 'try' or "
                 "'catch'");
    E_CALL_FALLIBLE = 0;
    /* 语句结束：没落到托管量上的 `new T`（`new T;`、`f(new T)` 之类）在这里
     * 释放。 */
    mgd_tmp_flush();
    pa_expect_ch(';');
    return;
}

/* --- 顶层：函数定义 / 原型 / typedef --- */

static Sym *PA_MAIN;

/* 同一个文件里同一个函数定义了两次 → 重定义。模块文件是文本内联的（同一个
 * 文件被 import 两次就解析两遍），那种情况位置完全相同，不算重定义。 */
#define FNDEF_MAX 512
static const char *FNDEF_NM[FNDEF_MAX];
static u32 FNDEF_LEN[FNDEF_MAX];
static u16 FNDEF_FILE[FNDEF_MAX];
static u32 FNDEF_OFF[FNDEF_MAX];
static u32 FNDEF_TY[FNDEF_MAX];      /* 同名的不同签名是重载（c6 的方法） */
static int NFNDEF;

static void fndef_check(Sym *fn)
{
    int i = 0;

    if (!fn || !fn->is_func || !pa_cur())
        return;
    for (i = 0; i < NFNDEF; i++)
        if (FNDEF_LEN[i] == fn->len && FNDEF_TY[i] == fn->type
            && memcmp(FNDEF_NM[i], fn->name, fn->len) == 0) {
            if (FNDEF_FILE[i] == pa_cur()->file && FNDEF_OFF[i] != pa_cur()->off)
                pa_error("redefinition of '%.*s'", (int)fn->len, fn->name);
            return;
        }
    if (NFNDEF < FNDEF_MAX) {
        FNDEF_NM[NFNDEF] = fn->name;
        FNDEF_LEN[NFNDEF] = fn->len;
        FNDEF_FILE[NFNDEF] = pa_cur()->file;
        FNDEF_OFF[NFNDEF] = pa_cur()->off;
        FNDEF_TY[NFNDEF] = fn->type;
        NFNDEF++;
    }
}

/* --- 多层 VLA 形参的行 stride ---------------------------------------------
 *
 * `void f(int n, int m, int a[n][m])`：形参 a 在 C 里退化成 `int (*)[m]`，
 * c6c 内部表示成 k 层指针 + 每一维的运行期行 stride（和块作用域的
 * `int b[n][m]` 一模一样，见 dims_apply）。声明处算不出来，是因为那时形参
 * n/m 还没有槽；现在绑完帧了，照同一个公式在函数入口补上：
 *     stride[nd-2] = len[nd-1] * sizeof(T)
 *     stride[i]    = len[i+1] * stride[i+1]
 * len[k] 要么是常量（`int a[n][5]`），要么是某个形参名 —— 从它的槽里 load。
 * 算完挂到 Sym 上，`a[i][j]` 就走 gen_postfix_ops 里现成的多维 VLA 下标
 * 逻辑，native / C99 / LLVM 三个后端一行都不用改。
 *
 * 注意这里**不**设 Sym.vla_cnt：形参的 `sizeof a` 是"指针大小"（8），不是
 * 整块数组的字节数；pa_vla_sizeof 看到 vla_cnt == 0 就走普通 sizeof。 */

/* 第 k 维长度 → vreg（常量发 CONST，名字就从槽里 load） */
static u32 pa_pvla_len(PVla *pv, int k)
{
    Sym *s = NULL;
    u32 v = 0;

    if (pv->k[k] == 0) {
        v = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, v, 0, 0, 0, pv->c[k]);
        return v;
    }
    s = sym_find(pv->nm[k], pv->nl[k]);
    /* 解析形参表时 pa_bracket_is_vla() 已经确认过它是个运行期名字（不是枚举
     * 常量）；走到这里还查不到对象，只可能是名字指向了函数之类。与其按 0
     * 静默算错、让下标跑到别的行上去，不如报清楚。 */
    if (!s || (s->kind != SC_PARAM && s->kind != SC_LOCAL && s->kind != SC_GLOBAL)) {
        pa_error("多层 VLA 形参的内维只支持常量或形参名：'%.*s' 不是可用的对象",
                 (int)pv->nl[k], pv->nm[k]);
        v = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, v, 0, 0, 0, 1);
        return v;
    }
    return load_lval(ident_addr(s), s->type);
}

static void pa_vla_param_prep(Sym *p, PVla *pv)
{
    u32 str[8] = {0};
    u32 esz = 0;
    u32 acc = 0;
    int nd = 0;
    int i = 0;

    if (!pv || pv->nd < 2)
        return;
    nd = pv->nd > 8 ? 8 : (int)pv->nd;
    esz = pv->esz ? pv->esz : 1;
    for (i = nd - 2; i >= 0; i--) {
        u32 kk = acc;

        if (!kk) {
            kk = irfn_vreg(&FN);
            irfn_push(&FN, IR_CONST, IRT_U64, kk, 0, 0, 0, esz);
        }
        acc = gen_bin2(pa_pvla_len(pv, i + 1), ty_ulong(), IR_MUL, kk, ty_ulong());
        str[i] = acc;
    }
    p->vla_nd = (u8)nd;
    for (i = 0; i + 1 < nd && i < 8; i++)
        p->vla_str[i] = str[i];
}

static void pa_func_def(Sym *fn, Declarator *d)
{
    u32 i = 0;

    fndef_check(fn);
    irfn_reset(&FN, fn->name);
    cv_next();      /* 换一代：CV_* 那张表按 vreg 编号索引 */
    memset(FSTR_SLOT, 0, sizeof(FSTR_SLOT));
    FSTR_DEPTH = 0;
    NDF = 0;
    DEF_DEPTH = 0;
    PA_DEFER_DEPTH = 0;
    PA_DEFER_SITES = 0;
    PA_IN_COND = 0;
    MV_N = 0;
    MV_SP = 0;
    PA_IN_DEFER = 0;
    CUR_ASYNC_DEF = PA_ASYNC;
    /* 析构函数：源码名就叫 `drop`，第一个参数是某个 tag 的指针。这种函数在
     * 对象释放时跑，不能挂起、不能失败、不能有返回值。 */
    /* 析构函数正好一个参数（接收者）；同名的普通方法（`std/text/str.c6`
     * 里那个 `Str drop(Str *self, int k)`）不是析构函数。 */
    if (fn->len == 4 && memcmp(fn->name, "main", 4) == 0 && CUR_FILE
        && mod_of_file((u32)CUR_FILE->id))
        pa_error("'main' cannot be declared in a module");
    PA_IN_DROP = (d->nlen == 4 && memcmp(d->name, "drop", 4) == 0
                  && d->nparams == 1 && ty_is_ptr(d->ptype[0]));
    fn->fallible = (u8)(fn->fallible || PA_FALLIBLE);
    CUR_FALLIBLE = fn->fallible;
    /* 可失败函数的返回值必须能装下"错误载荷"：不完整类型连大小都不知道，
     * 错误没地方放（tests/errors/try.c6 的 test_incomplete_return）。 */
    if (fn->fallible && fn->is_func) {
        u32 rty0 = ty_func_ret(fn->type);

        if (ty_is_agg(rty0) && ty_size(rty0) == 0)
            pa_error("cannot propagate an error from a function with an "
                     "incomplete return type");
    }
    PA_FALLIBLE = 0;
    {
        int was_inline = PA_INLINE_SEEN;

        PA_INLINE_SEEN = 0;
        if (PA_ASYNC) {
            if (fn->len == 4 && memcmp(fn->name, "main", 4) == 0)
                pa_error("'main' 不能是 async");
            if (METHOD_SELF_TY)
                pa_error("'async' 函数不能是方法");
            /* 首形参是"结构体指针"时，这个函数按显式接收者登记成方法
             * （`int port(Tcp *self)` 那种写法），方法调用会被改写成普通
             * 调用 —— 而 async 函数的体必须留在任务里，两者不能混
             * （tests/errors/async.c6 的 test_async_method）。 */
            if (ty_func_nparams(fn->type) > 0) {
                u32 p0 = ty_func_param(fn->type, 0);

                if (ty_is_ptr(p0) && ty_is_agg(ty_target(p0)) && !ty_is_task_ptr(p0))
                    pa_error("'async' functions cannot be methods");
            }
            /* 托管形参会在任务前缀里跨线程共享，必须写 `shared @T`
             * （tests/errors/gc_borrow.c6 的 test_async_plain）。 */
            {
                u32 pi4 = 0;

                for (pi4 = 0; pi4 < d->nparams && pi4 < 16; pi4++) {
                    if (d->pmgd[pi4] == 1 && !d->pshared[pi4] && in_c6_tu())
                        pa_error("passing a reference to 'async' requires 'shared'");
                    if (d->ptype[pi4] && ty_is_closure(d->ptype[pi4], NULL))
                        pa_error("a closure cannot cross a thread or a task: V2 "
                                 "closures are confined to the thread that creates "
                                 "them");
                }
            }
            if (was_inline)
                pa_error("'async' 不能和 'inline' 一起用");
        }
    }
    CUR_RET_TY = ty_target(fn->type);
    CUR_TASK_TY = 0;
    CUR_TASK_VAL = 0;
    CUR_UNWIND_LBL = 0;
    if (PA_ASYNC) {
        /* `async T f(…)`：建 `struct f_task { T val; }` 并登记成普通 tag，
         * 函数的返回类型改成指向它的指针。调用方拿到任务结构地址，
         * `await t` 就是 `t->val`。 */
        char tnm[256] = {0};
        u32 tty = 0;
        u32 tag = 0;
        const char *fnm[8] = {0};
        u32 flen[8] = {0};
        u32 ftys[8] = {0};
        u32 rty0 = CUR_RET_TY;
        u32 ps[TY_PARAM_MAX] = {0};
        u32 np = 0;
        u32 pi = 0;
        Sym *tsym = NULL;

        snprintf(tnm, sizeof(tnm), "%.*s_task", (int)fn->len, fn->name);
        tag = 1u + (u32)(sym_hash_str(tnm, (u32)strlen(tnm)) & 0x7FFFFFFFu);
        ftys[0] = ty_ptr(ty_void());    /* m0..m3：托管形参的引用前缀 */
        ftys[1] = ftys[0];
        ftys[2] = ftys[0];
        ftys[3] = ftys[0];
        ftys[4] = ty_long();            /* kind：0 = 成功，1 = 出错 */
        ftys[5] = ty_long();            /* state：0 = NEW，-1 = DONE */
        ftys[6] = ty_long();            /* nmgd：前缀里填了几个 */
        ftys[7] = rty0;
        tty = ty_agg(ftys, NULL, 8, 0, tag);
        fnm[0] = "m0";
        flen[0] = 2;
        fnm[1] = "m1";
        flen[1] = 2;
        fnm[2] = "m2";
        flen[2] = 2;
        fnm[3] = "m3";
        flen[3] = 2;
        fnm[4] = "kind";
        flen[4] = 4;
        fnm[5] = "state";
        flen[5] = 5;
        fnm[6] = "nmgd";
        flen[6] = 4;
        fnm[7] = "val";
        flen[7] = 3;
        agg_names_set(tty, fnm, flen, 8);
        /* 和 `struct X` 一样：标签符号的 val 才是类型 id（漏了这步查不到） */
        tsym = sym_add_tag(tnm, (u32)strlen(tnm), tty);
        tsym->val = (i64)tty;
        np = ty_func_nparams(fn->type);
        if (np > TY_PARAM_MAX)
            np = TY_PARAM_MAX;
        for (pi = 0; pi < np; pi++) {
            ps[pi] = ty_func_param(fn->type, pi);
            if (ty_is_func(ps[pi])
                || (ty_is_ptr(ps[pi]) && ty_is_func(ty_target(ps[pi]))))
                pa_error("'async' 不支持函数指针参数（任务结构写不回去）");
        }
        fn->type = ty_func(ty_ptr(tty), ps, np, ty_func_variadic(fn->type));
        CUR_RET_TY = ty_ptr(tty);
        if (NTASKTY < TASK_TY_MAX)
            TASK_TY[NTASKTY++] = tty;
        if (getenv("C6C_DBG_TASK"))
            fprintf(stderr, "[reg] tty=%u n=%d\n", tty, (int)NTASKTY);
        if (CUR_FALLIBLE) {
            u32 e1 = irfn_vreg(&FN);
            u32 e3 = irfn_vreg(&FN);

            TASK_ERR_SLOT = frame_slots_for(8);
            irfn_push(&FN, IR_CALL, IRT_I64, e1, 0, 0, 0,
                      x64_sym(&X64, "__tcc_err_flag_get"));
            FN.ops[FN.n - 1].narg = 0;
            irfn_push(&FN, IR_ADDR, IRT_PTR, e3, 0, 0, 0,
                      X64_SLOT(TASK_ERR_SLOT));
            irfn_push(&FN, IR_STORE, IRT_U64, e3, e1, 0, 0, 0);
        } else {
            TASK_ERR_SLOT = 0;
        }
        CUR_TASK_TY = tty;
        task_new();
        CUR_TASK_VAL = rty0;
        PA_ASYNC = 0;
    }
    /* 函数字面量的 `...` 只在声明符里记着（它的符号类型是先造出来的），
     * 两处都看，别让闭包体把自己当成定参函数——那样 rdi..r9 不进 va 区，
     * 体里的 va_arg 全读到 0。 */
    FN.is_variadic = (int)(ty_func_variadic(fn->type) || d->variadic);
    NLOOP = 0;
    NSW = 0;
    NGLBL = 0;
    scope_enter();
    /* 方法体（`METHOD_SELF_TY` 非 0）靠这个判断"裸名字是不是自己的" */
    METHOD_SCOPE_BASE = SCOPE;
    /* 闭包体：捕获变量登记成"在环境对象里"的形参（slot 带标记位） */
    for (i = 0; i < FLCAP_N && i < FL_CAP_MAX; i++) {
        Sym *cp = sym_add(FLCAP_NAME[i], FLCAP_LEN[i], FLCAP_TY[i], SC_PARAM);

        cp->slot = CAP_SLOT_BIT | i;
    }
    if (METHOD_SELF_TY) {
        u32 s0 = irfn_vreg(&FN);
        Sym *ps = sym_add("self", 4, ty_ptr(METHOD_SELF_TY), SC_PARAM);

        FN.params[FN.nparams++] = s0;
        ps->slot = s0;
    }
    for (i = 0; i < d->nparams; i++) {
        u32 slot = irfn_vreg(&FN);
        Sym *p = NULL;

        FN.params[FN.nparams++] = slot;
        /* 形参声明成数组（典型：va_list ap）时，C 语义是"退化成指针"，
         * 槽里存的是指针本身——不退化的话 ap 会变成"槽的地址"（踩过一次）。 */
        {
            u32 pty = d->ptype[i];

            if (!pty)
                pty = ty_int();          /* K&R 参数默认 int */
            if (d->knr_conv && d->pknr[i]) {
                /* 旧式定义：实参是按**默认提升**传进来的（float→double、
                 * char/short→int），入口处要按赋值转换回来 */
                u32 from = 0;

                if (ty_is_float(pty) && ty_size(pty) < 8)
                    from = ty_double();
                else if (ty_is_int(pty) && ty_size(pty) < 4)
                    from = ty_int();
                if (from) {
                    u32 cv = gen_convert(slot, from, pty);

                    irfn_push(&FN, IR_MOV, ir_ty_of(pty), slot, cv, 0, 0, 0);
                }
            }
            if (ty_is_array(pty))
                pty = ty_ptr(ty_target(pty));
            if (d->pname[i])
                p = sym_add(d->pname[i], d->plen[i], pty, SC_PARAM);
            else
                p = sym_add("", 0, pty, SC_PARAM);
            if (d->pmgd[i])
                p->is_mgd = (u8)(d->pmgd[i] == 2 ? 2 : 1);
            if (d->pshared[i] && d->pmgd[i])
                p->is_shared = 1;
            /* `int *const p`：形参对象本身只读，赋值要报"只读位置" */
            if (d->pconst[i])
                p->is_const = 1;
                /* 托管形参是借来的：返回时才加计数；weak 形参要先升级 */
            if (ty_kind(pty) == TY_BF16) {
                /* bf16 形参：对象必须真的落在内存里（2 字节）。槽里是 f32 值，
                 * 直接按 bf16 去读会读到低半截（1.5f 的低 16 位是 0）。 */
                u32 obj = frame_slots_for(2);
                u32 addr = irfn_vreg(&FN);

                irfn_push(&FN, IR_ADDR, IRT_PTR, addr, 0, 0, 0, X64_SLOT(obj));
                store_lval(addr, ty_bf16(), slot);
                slot = obj;
            }
            if (ty_is_agg(pty) && ty_size(pty) > 0) {
                /* 聚合形参：收到的其实是个地址。给它一个真正的局部对象槽，
                 * 函数入口处把对象整块拷进来（和调用方的约定配套，见 gen_call）。 */
                u32 osz = ty_size(pty);
                u32 obj = frame_slots_for(osz);
                u32 addr = irfn_vreg(&FN);

                irfn_push(&FN, IR_ADDR, IRT_PTR, addr, 0, 0, 0, X64_SLOT(obj));
                irfn_push(&FN, IR_COPY, IRT_U8, addr, slot, 0, 0, osz);
                slot = obj;
            }
        }
        p->slot = slot;
        /* 多层 VLA 形参（`int a[n][m]`）：槽都建好了，按声明处记下的形状
         * 现算行 stride（见 pa_vla_param_prep）。前面那些形参的符号已经进
         * 表了，所以这里 sym_find 能拿到 n/m 的槽。 */
        {
            PVla *pv = d->pvla_head;

            while (pv && pv->idx != (u8)i)
                pv = pv->next;
            if (pv)
                pa_vla_param_prep(p, pv);
        }
        /* 托管形参：任务自己持有一份引用（形参本身照旧是借来的）。
         * 这样创建者随后放手，任务也不会立刻断掉（tests/gc_async.c6）。 */
        if (CUR_TASK_TY && p->is_mgd && TASK_MG_N < TASK_MG_CAP) {
            u32 pa = irfn_vreg(&FN);
            u32 pv = irfn_vreg(&FN);
            u32 tk = task_get();
            u32 ma = irfn_vreg(&FN);

            irfn_push(&FN, IR_ADDR, IRT_PTR, pa, 0, 0, 0, X64_SLOT(slot));
            irfn_push(&FN, IR_LOAD, IRT_PTR, pv, pa, 0, 0, 0);
            mgd_retain(pv);
            irfn_push(&FN, IR_LEA, IRT_PTR, ma, tk, 0, 0,
                      task_off("m0", 2) + 8 * TASK_MG_N);
            irfn_push(&FN, IR_STORE, IRT_U64, ma, pv, 0, 0, 0);
            TASK_MG_N++;
        }
    }
    /* 聚合按值返回（只有 C99 后端）：多接一个隐藏指针形参，`return <聚合>`
     * 往里写、再把它原样返回。见 CUR_SRET。 */
    CUR_SRET = 0;
    CUR_SRET_ON = 0;
    if (agg_ret_abi(fn->type, CUR_RET_TY)) {
        if (FN.nparams >= 16) {
            pa_error("形参太多：聚合按值返回还要多接一个隐藏形参（上限 16 个）");
        } else {
            u32 rs = irfn_vreg(&FN);

            FN.params[FN.nparams++] = rs;
            CUR_SRET = rs;
            CUR_SRET_ON = 1;
        }
    }
    if (CUR_TASK_TY && TASK_MG_N) {
        u32 nv = irfn_vreg(&FN);
        u32 na = irfn_vreg(&FN);
        u32 tk = task_get();

        irfn_push(&FN, IR_CONST, IRT_U64, nv, 0, 0, 0, TASK_MG_N);
        irfn_push(&FN, IR_LEA, IRT_PTR, na, tk, 0, 0, task_off("nmgd", 4));
        irfn_push(&FN, IR_STORE, IRT_U64, na, nv, 0, 0, 0);
    }
    if (CUR_TASK_TY) {
        /* 起点闸门：任务结构和托管实参前缀都备好了，先把句柄交回创建者 */
        u32 gv = irfn_vreg(&FN);

        irfn_push(&FN, IR_CALL, IRT_VOID, gv, 0, 0, 0,
                  x64_sym(&X64, "__c6_co_gate"));
        FN.ops[FN.n - 1].narg = 0;
    }
    gen_block();
    /* 函数末尾没有 return 也要有出口（C 里 main 隐式 return 0，其它是 UB） */
    if (CUR_TASK_TY) {
        /* `async void f() { … }` 掉到末尾：也得交出一个任务结构，不然调用方
         * 拿到 NULL（`await fire()` 直接崩）。 */
        u32 dt = task_get();

        task_seal(dt);
        irfn_push(&FN, IR_RET, IRT_PTR, 0, dt, 0, 0, 0);
    } else {
        u32 zero = irfn_vreg(&FN);

        irfn_push(&FN, IR_CONST, IRT_I64, zero, 0, 0, 0, 0);
        irfn_push(&FN, IR_RET, IRT_I64, 0, zero, 0, 0, 0);
    }
    scope_leave();
    if (C99_MODE || llvm_mode()) {
        pa_emit_fn(&FN, (u32)fn->val);
        return;
    }
    if (NFL > 0) {
        TmplSaved sv = {0};
        u32 n0 = FN.n;
        IrOp *bak = arena_alloc(&A_main, (size_t)(n0 ? n0 : 1) * sizeof(IrOp));

        if (n0)
            memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
        tmpl_save_state(&sv);
        fnlit_drain();
        tmpl_restore_state(&sv);
        if (n0)
            memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
    }
    /* fnlit_drain 已经把 FN.ops 恢复成当前函数本体，这里才是 native 的
     * "函数 IR 完稿"时刻；C99/LLVM 路在上面 pa_emit_fn 里做同一件事。 */
    ir_optimize(&FN);
    if (pa_defer_enabled()) {
        /* 两遍发射：缓存 IR，等 TU 解析完、可达集算出来再决定是否发射。 */
        u32 asym = 0;

        if (fn->alias)
            asym = x64_sym(&X64, emit_name(fn->alias));
        def_fn_add(&FN, (u32)fn->val, asym);
        fn->alias = NULL;
        return;
    }
    x64_compile(&X64, &FN, (u32)fn->val);
    if (fn->alias) {
        /* 别名就是另一个名字指向同一份代码（PA 用的镜像里没有符号表，
         * 所以这只是"名字 → 偏移"表里再加一条）。 */
        u32 to = x64_sym(&X64, emit_name(fn->alias));

        if (!X64.sym[to].defined)
            x64_alias_idx(&X64, to, (u32)fn->val);
        fn->alias = NULL;
    }
}


/* -test 的过滤：描述里含这个子串的块才跑（tcc 的 tcc_run_tests 用 strstr，
 * 语义一样；没有 -test-filter 时全跑）。 */
static int test_wanted(u32 i)
{
    if (!PA_TEST_FILTER || !PA_TEST_FILTER[0])
        return 1;
    if (!TEST_DESCS[i])
        return 0;
    return strstr(TEST_DESCS[i], PA_TEST_FILTER) != NULL;
}

/* 合成测试入口：
 *
 *   - 普通编译（源文件只有 `test "…" { }` 块、没有 main，tests/ 下大多数就是
 *     这种）：把每个 c6test_N() 跑一遍，**失败数当返回值**。这样
 *     `c6c x.c6 -o x && ./x` 就能直接跑那些 test 块，不用等外部驱动。
 *   - -test：用户的 main 不算数（入口换成这里合成的），按 tcc 的输出协议报告
 *     —— 每块 PASS/FAIL 行 + 收尾统计都由运行期助手 __c6c_test_run /
 *     __c6c_test_summary 打，失败数当退出码。一个块都没有（或被过滤空了）时
 *     静默返回 0，和 tcc 一致。
 *
 * 入口符号在 -test 下叫 c6c_test_main：用户的 main 还在符号表里（名字不能
 * 撞车），但 _start 调的是这个 —— tcc 的 C99 后端也是改名后换自己的入口。 */
static void synth_test_main(void)
{
    u32 i = 0;
    u32 acc = 0;
    u32 nrun = 0;
    u32 zero = 0;
    u32 one = 0;
    int nsel = 0;
    Sym *s = NULL;
    Sym *hf = NULL;
    Sym *hs = NULL;

    if (PA_SYNTAX_ONLY || PA_ERRS || DG.errors)
        return;
    /* 普通编译里用户 main 优先；-test 下它不参与 */
    if (!PA_TEST_MODE && (PA_MAIN || NTESTS == 0))
        return;
    for (i = 0; i < NTESTS; i++)
        if (test_wanted(i))
            nsel++;
    if (PA_TEST_MODE) {
        hf = sym_find("__c6c_test_run", 14);
        hs = sym_find("__c6c_test_summary", 18);
    }
    irfn_reset(&FN, PA_TEST_MODE ? "c6c_test_main" : "main");
    cv_next();      /* 换一代：CV_* 那张表按 vreg 编号索引 */
    memset(FSTR_SLOT, 0, sizeof(FSTR_SLOT));
    FSTR_DEPTH = 0;
    CUR_RET_TY = ty_int();
    FN.is_variadic = 0;
    zero = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_I64, zero, 0, 0, 0, 0);
    one = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_I64, one, 0, 0, 0, 1);
    acc = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_I64, acc, 0, 0, 0, 0);
    nrun = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_I64, nrun, 0, 0, 0, 0);
    if (PA_TEST_MODE && hf && hs) {
        for (i = 0; i < NTESTS; i++) {
            u32 fa = 0;
            u32 dv = 0;
            u32 r = 0;
            const char *desc = TEST_DESCS[i];

            if (!test_wanted(i))
                continue;
            if (!desc)
                desc = "?";
            if (getenv("C6C_DBG_TESTS"))
                fprintf(stderr, "[test] %s\n", desc);
            /* acc += __c6c_test_run(&c6test_i, "描述"); nrun++; */
            fa = irfn_vreg(&FN);
            /* 函数地址：flags=2 才是"符号地址 + rip 相对重定位"（flags=0 是
             * [rbp+imm] 的栈槽，拿它当函数指针会跳到栈上） */
            irfn_push(&FN, IR_ADDR, IRT_PTR, fa, 0, 0, 0, TESTS[i]);
            FN.ops[FN.n - 1].flags = 2;
            irfn_push(&FN, IR_ARG, IRT_U64, 0, fa, 0, 0, 0);
            dv = gen_str_from(desc, (u32)strlen(desc));
            irfn_push(&FN, IR_ARG, IRT_U64, 0, dv, 0, 0, 1);
            r = irfn_vreg(&FN);
            irfn_push(&FN, IR_CALL, IRT_I64, r, 0, 0, 0, (u32)hf->val);
            FN.ops[FN.n - 1].narg = 2;
            irfn_push(&FN, IR_ADD, IRT_I64, acc, acc, r, 0, 0);
            irfn_push(&FN, IR_ADD, IRT_I64, nrun, nrun, one, 0, 0);
        }
        /* 一个块都没跑到：静默（tcc 的 -test 也是这样，不打印 0 test(s)） */
        if (nsel > 0) {
            u32 sv = irfn_vreg(&FN);

            irfn_push(&FN, IR_ARG, IRT_U64, 0, nrun, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, acc, 0, 0, 1);
            irfn_push(&FN, IR_CALL, IRT_I64, sv, 0, 0, 0, (u32)hs->val);
            FN.ops[FN.n - 1].narg = 2;
        }
    } else {
        for (i = 0; i < NTESTS; i++) {
            u32 r = irfn_vreg(&FN);
            u32 pf = 0;
            u32 msg = 0;
            u32 arg = 0;
            char line[160] = {0};
            u32 ln = 0;
            Sym *ps = sym_find("printf", 6);

            irfn_push(&FN, IR_CALL, IRT_I64, r, 0, 0, 0, TESTS[i]);
            /* 失败计数按"非 0 记 1"，不把返回值加起来（err() 的返回值大小没意义） */
            {
                u32 cc0 = irfn_vreg(&FN);

                /* 条件码放在 flags 域（irfn_push 的最后一个参数是 imm，不是 cc） */
                irfn_push(&FN, IR_CMP, IRT_I64, cc0, r, zero, 0, 0);
                FN.ops[FN.n - 1].flags = (u8)IRCC_NE;
                irfn_push(&FN, IR_ADD, IRT_I64, acc, acc, cc0, 0, 0);
            }
            if (!ps)
                continue;
            /* 哪条挂了要看得见：if (r) printf("FAIL %s\n", "test:…") */
            {
                u32 cc = irfn_vreg(&FN);
                u32 lp = irfn_label(&FN);
                u32 le = irfn_label(&FN);

                irfn_push(&FN, IR_CMP, IRT_I64, cc, r, zero, 0, 0);
                FN.ops[FN.n - 1].flags = (u8)IRCC_NE;
                irfn_push(&FN, IR_BR, IRT_VOID, 0, cc, lp, le, 0);
                irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lp, 0, 0, 0);
                ln = (u32)snprintf(line, sizeof(line), "FAIL %s\n",
                                   TEST_NAMES[i] ? TEST_NAMES[i] : "?");
                if (getenv("C6C_DBG_TESTS"))
                    fprintf(stderr, "[test] %s\n", TEST_NAMES[i] ? TEST_NAMES[i] : "?");
                msg = gen_str_from(line, ln);
                arg = irfn_vreg(&FN);
                irfn_push(&FN, IR_ARG, IRT_VOID, 0, msg, 0, 0, 0);
                pf = irfn_vreg(&FN);
                irfn_push(&FN, IR_CALL, IRT_I64, pf, 0, 0, 0, (u32)ps->val);
                irfn_push(&FN, IR_LABEL, IRT_VOID, 0, le, 0, 0, 0);
            }
        }
    }
    irfn_push(&FN, IR_RET, IRT_I64, 0, acc, 0, 0, 0);
    s = sym_add(PA_TEST_MODE ? "c6c_test_main" : "main",
                PA_TEST_MODE ? 13 : 4, ty_func(ty_int(), NULL, 0, 0), SC_GLOBAL);
    s->is_func = 1;
    s->val = (i64)x64_sym(&X64, PA_TEST_MODE ? "c6c_test_main" : "main");
    PA_MAIN = s;
    if (C99_MODE || llvm_mode()) {
        be_emit_fn(&FN, (u32)s->val);
        return;
    }
    x64_compile(&X64, &FN, (u32)s->val);
}

/* ---------- 数据段重定位 ----------
 * 全局指针初始化器可能是"某个函数/全局的地址"，解析到这里时它的 VA 还没定
 * （函数甚至还没编译），所以先记 (数据偏移, 符号, 加数) 的三元组，等布局完成
 * 再回填。
 *
 * 加数是 C99 6.6p9 里那个"整数常量偏移"：`int *p = A + 2;`、`&s.m`、
 * `&a[3].x` 都是"符号地址 + 常量"，落地时只有一条重定位——三个后端
 * （native / C99 / LLVM）都按这一份记录算地址，不必各写一遍。 */
#define DFIX_MAX 4096
static u32 DFIX_OFF[DFIX_MAX];
static u32 DFIX_SYM[DFIX_MAX];
static i64 DFIX_ADD[DFIX_MAX];
static u32 NDFIX;

/* 数据段里 `&&label` 的重定位：地址要等代码段起点定下来才能算，所以先记
 * （数据段偏移，函数序号，标签 id），最后统一补。 */
#define CODE_LBL_MAX 4096
static u32 CLBL_OFF[CODE_LBL_MAX];
static u32 CLBL_FN[CODE_LBL_MAX];
static u32 CLBL_LBL[CODE_LBL_MAX];
static u32 NCLBL;

static void code_lbl_fixup_add(u32 data_off, u32 fnseq, u32 lbl)
{
    if (NCLBL >= CODE_LBL_MAX) {
        pa_error("数据段里的 &&标号 太多（上限 %d）", CODE_LBL_MAX);
        return;
    }
    CLBL_OFF[NCLBL] = data_off;
    CLBL_FN[NCLBL] = fnseq;
    CLBL_LBL[NCLBL] = lbl;
    NCLBL++;
}

/* 两遍发射的第二节：TU 解析完、IR 全缓存好后，从全局根沿 IR_CALL 引用图
 * 算可达集，只发射 live 函数。死函数根本不生成字节——.text 从根上只有
 * 可达代码，不需要出 .o 后搬字节（那会因为拍死的 rel32 分支而错位）。 */
static void pa_emit_deferred(void)
{
    u32 *sym2def = NULL;
    u32 *work = NULL;
    u32 nwork = 0;
    u32 wi = 0;
    u32 i = 0;
    u32 k = 0;
    u32 nemit = 0;

    if (!NDEF)
        return;
    sym2def = (u32 *)calloc(X64.nsym ? X64.nsym : 1, sizeof(u32));
    work = (u32 *)calloc(NDEF ? NDEF : 1, sizeof(u32));
    if (!sym2def || !work) {
        free(sym2def);
        free(work);
        return;
    }
    for (i = 0; i < NDEF; i++)
        sym2def[DEF_FNS[i].sym] = i + 1;    /* 0 = 不在缓存里 */

    /* 根集：全局函数（外部可能调用）+ ctor/dtor + 数据里引用的函数符号。
     * 带别名（`__attribute__((alias))` 或方法别名）的函数也要算：
     * `SYSCALL_DEFINE` 生成的 do_sys_* 是 static，但它有全局别名 __x64_sys_*
     * （system call table 通过它引用）。别名存在即意味着外部可见入口，
     * 目标函数必须发射，否则 alias_apply 接不上、链接期 undefined。 */
    for (i = 0; i < NDEF; i++) {
        DefFn *d = &DEF_FNS[i];

        if (!d->is_static)
            d->emitted = 1;
    }
    for (i = 0; i < NCTOR; i++)
        if (CTORS[i] < X64.nsym && sym2def[CTORS[i]])
            DEF_FNS[sym2def[CTORS[i]] - 1].emitted = 1;
    for (i = 0; i < NDTOR; i++)
        if (DTORS[i] < X64.nsym && sym2def[DTORS[i]])
            DEF_FNS[sym2def[DTORS[i]] - 1].emitted = 1;
    for (i = 0; i < NDFIX; i++) {
        u32 ds = DFIX_SYM[i];

        if (ds >= X64.nsym)
            continue;
        if (sym2def[ds]) {
            DEF_FNS[sym2def[ds] - 1].emitted = 1;
        } else if (!X64.sym[ds].defined && X64.sym[ds].name && X64.sym[ds].name[0]) {
            /* 数据段函数指针（如 thermal_genl_cmd[] 中的 static 函数）可能
             * 指向前向声明的符号 id，与定义的符号 id 不同 → sym2def 落空
             * → 定义被 DCE 剔除 → 链接期 undefined。同 TU 内 static 函数名
             * 唯一，按名字/后缀兜底标记（与 IR_CALL 的兜底一致）。 */
            u32 di = 0;
            const char *dn = NULL;

            for (di = 0; di < NDEF; di++) {
                DefFn *dd = &DEF_FNS[di];

                if (!dd->is_static || !dd->sym || dd->sym >= X64.nsym)
                    continue;
                dn = X64.sym[dd->sym].name;
                if (dn && !dd->emitted
                    && (strcmp(dn, X64.sym[ds].name) == 0
                        || (strlen(dn) > strlen(X64.sym[ds].name)
                            && strcmp(dn + strlen(dn) - strlen(X64.sym[ds].name),
                                      X64.sym[ds].name) == 0)))
                    dd->emitted = 1;
            }
        }
    }
    for (i = 0; i < NCLBL; i++)
        if (CLBL_FN[i] < NDEF)
            DEF_FNS[CLBL_FN[i]].emitted = 1;
    /* 全局 alias 的目标必须发射：SYSCALL_DEFINE0 的 __x64_sys_gettid 是
     * __do_sys_gettid 的 alias（纯声明无函数体），system call table 跨 TU
     * 引用。只有 ALIAS_FROM 登记的 __attribute__((alias)) 才算外部入口；
     * 普通方法别名（首形参指针自动生成的 pt_regs___*）不是外部入口，
     * 不能当根——否则几千个死函数被误留。 */
    for (k = 0; k < NALIAS; k++) {
        u32 as = x64_sym(&X64, ALIAS_FROM[k]);

        if (as >= X64.nsym || X64.sym[as].is_static)
            continue;
        for (i = 0; i < NDEF; i++) {
            DefFn *d = &DEF_FNS[i];
            const char *an = NULL;

            if (d->alias_sym && d->alias_sym < X64.nsym) {
                an = X64.sym[d->alias_sym].name;
                if (an && strcmp(an, ALIAS_TO[k]) == 0)
                    d->emitted = 1;
            }
            /* 纯 alias 声明（`int f() __attribute__((alias("g")));`）没有函数体，
             * 目标 g 是普通 static 定义、自身没有 alias_sym，上面的匹配接不住。
             * g 只经别名在数据数组里被引用、无直接 call 边 → 两遍 DCE 把它剔除
             * → alias_apply 报「未定义的符号 g」→ 链接期 undefined（内核
             * drivers/thermal/thermal_netlink.c 的 thermal_genl_event_tz_* 即此形）。
             * 按目标自身名字（含 TU 名前缀后缀）兜底标记。 */
            if (d->sym < X64.nsym) {
                const char *dn = X64.sym[d->sym].name;
                u32 tl = strlen(ALIAS_TO[k]);

                if (dn && ((strcmp(dn, ALIAS_TO[k]) == 0)
                           || (strlen(dn) > tl
                               && strcmp(dn + strlen(dn) - tl, ALIAS_TO[k]) == 0)))
                    d->emitted = 1;
            }
        }
    }
    for (i = 0; i < NDEF; i++)
        if (DEF_FNS[i].emitted)
            work[nwork++] = i;

    /* 传递闭包：live 函数体里的 IR_CALL 目标也 live。 */
    while (wi < nwork) {
        DefFn *d = &DEF_FNS[work[wi++]];
        IrFn *f = &d->ir;

        for (i = 0; i < f->n; i++) {
            u32 t = 0;

            if (f->ops[i].op == IR_CALL) {
                t = f->ops[i].imm;
            } else if (f->ops[i].op == IR_ADDR && (f->ops[i].flags & 2)) {
                /* 函数指针：cmp_ex_search 作为 bsearch(..., cmp) 的参数被
                 * `addr [f2] #sym` 取地址，并非 IR_CALL。只看 IR_CALL 会把
                 * 这类函数当死代码不发射 → 链接后符号为 0 → 间接调用跳 0
                 * 崩溃（early_fixup_exception → search_extable → bsearch）。
                 * flags&2 表示 imm 是符号 id；sym2def 只对函数 def 非 0，
                 * 数据/字符串符号自动跳过。 */
                t = f->ops[i].imm;
            } else {
                continue;
            }
            if (t < X64.nsym && sym2def[t] && !DEF_FNS[sym2def[t] - 1].emitted) {
                DEF_FNS[sym2def[t] - 1].emitted = 1;
                if (nwork < NDEF)
                    work[nwork++] = sym2def[t] - 1;
            } else if (t < X64.nsym && !sym2def[t] && !X64.sym[t].defined
                       && X64.sym[t].name && X64.sym[t].name[0]) {
                /* 前向声明（`static bool f();`）与后面的定义可能落成不同的
                 * 符号 id：调用点指向前者（UND），sym2def 只登记后者，直接
                 * 映射落空 → 定义被当死函数剔除 → 链接后符号为 UND、调用
                 * 解析成 0 #PF（内核 mm/page_alloc.c 的 page_contains_unaccepted
                 * 即此形）。同一 TU 里 static 函数名唯一，按名字兜底标记。 */
                u32 di = 0;

                for (di = 0; di < NDEF; di++) {
                    DefFn *dd = &DEF_FNS[di];
                    const char *dn = NULL;

                    if (!dd->is_static || !dd->sym || dd->sym >= X64.nsym)
                        continue;
                    dn = X64.sym[dd->sym].name;
                    /* static 函数可能被冠以 TU 名前缀（page_page_contains_unaccepted
                     * 与引用点 page_contains_unaccepted 同址），故用后缀匹配。 */
                    if (dn && !dd->emitted
                        && (strcmp(dn, X64.sym[t].name) == 0
                            || (strlen(dn) > strlen(X64.sym[t].name)
                                && strcmp(dn + strlen(dn) - strlen(X64.sym[t].name),
                                          X64.sym[t].name) == 0))) {
                        dd->emitted = 1;
                        if (nwork < NDEF)
                            work[nwork++] = di;
                    }
                }
            }
        }
    }

    /* 按缓存顺序发射 live 函数（保持 clabel fnseq 语义稳定）。 */
    for (i = 0; i < NDEF; i++) {
        DefFn *d = &DEF_FNS[i];

        if (!d->emitted)
            continue;
        x64_compile(&X64, &d->ir, d->sym);
        if (d->alias_sym && !X64.sym[d->alias_sym].defined)
            x64_alias_idx(&X64, d->alias_sym, d->sym);
        nemit++;
    }
    fprintf(stderr, "c6c: 两遍发射：缓存 %u 函数，发射 %u（剔除 %u 死函数）\n",
            NDEF, nemit, NDEF - nemit);
    free(sym2def);
    free(work);
}

static void data_fixup_drop_range(u32 lo, u32 hi)
{
    u32 i = 0;
    u32 k = 0;

    for (i = 0; i < NDFIX; i++) {
        if (DFIX_OFF[i] >= lo && DFIX_OFF[i] < hi)
            continue;
        DFIX_OFF[k] = DFIX_OFF[i];
        DFIX_SYM[k] = DFIX_SYM[i];
        DFIX_ADD[k] = DFIX_ADD[i];
        k++;
    }
    NDFIX = k;
}

static void data_fixup_add_ex(u32 data_off, u32 sym, i64 add)
{
    if (NDFIX >= DFIX_MAX) {
        pa_error("数据段重定位太多（上限 %d）", DFIX_MAX);
        return;
    }
    DFIX_OFF[NDFIX] = data_off;
    DFIX_SYM[NDFIX] = sym;
    DFIX_ADD[NDFIX] = add;
    NDFIX++;
}

static void data_fixup_add(u32 data_off, u32 sym)
{
    data_fixup_add_ex(data_off, sym, 0);
}

/* C99 后端的数据段：一块字节数组 + 初始化函数里补重定位 */
static void c99_emit_data(void)
{
    FILE *f = C99_OUT;
    u32 i = 0;
    u32 last = 0;
    u32 part = 0;
    u32 cnt = 0;

    for (i = 0; i < DATA_IMG.n; i++)
        if (DATA_IMG.p[i])
            last = i + 1;
    /* 单个函数里塞几万条 D[i]=v 会让 wasm 编译器报
     * `local count too large`（LLVM 把每条语句的临时值算成局部变量）。
     * 按每 500 个非零字节拆一个函数；主函数依次调用。 */
    for (i = 0; i < last; i++) {
        if (!DATA_IMG.p[i])
            continue;
        if (cnt == 0) {
            if (part)
                fprintf(f, "}\n\n");
            fprintf(f, "static void c6c_init_data_%u(void)\n{\n", part);
            part++;
        }
        fprintf(f, "  D[%u] = %u;\n", i, (unsigned)DATA_IMG.p[i]);
        cnt++;
        if (cnt == 500)
            cnt = 0;
    }
    if (part)
        fprintf(f, "}\n\n");
    fprintf(f, "static void c6c_init_data(void)\n{\n");
    for (i = 0; i < part; i++)
        fprintf(f, "  c6c_init_data_%u();\n", i);
    for (i = 0; i < NDFIX; i++) {
        char sn[256] = {0};

        c99_sym(DFIX_SYM[i], sn, sizeof(sn));
        /* 加数是解析期算好的字节偏移（`A + 2` / `&s.m`），直接折进地址里 */
        if (X64.sym[DFIX_SYM[i]].is_data)
            fprintf(f, "  c6_st8(D + %u, (uint64_t)(uintptr_t)(D + %d));\n",
                    DFIX_OFF[i],
                    (int)((i64)(X64.sym[DFIX_SYM[i]].off - (u32)ELF_HDR) + DFIX_ADD[i]));
        else
            fprintf(f, "  c6_st8(D + %u, (uint64_t)(uintptr_t)((char *)&%s + %d));\n",
                    DFIX_OFF[i], sn, (int)DFIX_ADD[i]);
    }
    for (i = 0; i < C99_NRL; i++)
        fprintf(f, "  c6_st8(D + %u, (uint64_t)(uintptr_t)(D + %u));\n", C99_RLOFF[i],
                C99_RLTGT[i]);
    fprintf(f, "}\n\n");
}

static void data_fixups_apply(void)
{
    u32 i = 0;

    for (i = 0; i < NDFIX; i++) {
        u64 va = (u64)X64.sym[DFIX_SYM[i]].va + (u64)DFIX_ADD[i];
        u32 k = 0;

        for (k = 0; k < 8; k++)
            DATA_IMG.p[DFIX_OFF[i] + k] = (u8)(va >> (8 * k));
    }
}

/* 一个全局变量（声明已解析完类型和名字） */
static void gen_one_global(u32 ty, Declarator *d)
{
    Sym *s = NULL;
    u32 sz = 0;
    int was_inc = 0;
    int was_big = 0;
    int ate_eq = 0;      /* `[] = {…}` 那条路已经把 `=` 吃掉、把体重新压回源栈了 */
    u32 was_min = 0;     /* 收缩时不许低于这个长度（前面那条声明写死了长度时用） */
    u32 goff = 0;        /* 分配好的数据段偏移；初始化器解析期间符号表可能搬家 */

    if (!d->name)
        return;
    /* 文件作用域的**函数类型**声明：`typeof(fn) v;`、`typedef typeof(fn) fnt;
     * fnt other;` 里那个 `other`。
     *
     * C 里函数类型的对象根本不存在，这种声明只能按函数声明处理（GCC 也是
     * 这么做的）。不认的话它会被当成普通变量登记，于是后面
     * `(&other)(args)` 就报"这里要 ';'"——内核 arch/x86/include/asm/bug.h
     * 的 static_call_mod() 展开成
     *     ( { ( &__SCT__WARN_trap) ; } ) ( args )
     * 而 extern typeof(__WARN_trap) __SCT__WARN_trap; 正是这个形态
     * （实测：panic.c / fork.c / slub.c 等每一个 TU 都卡在这一行）。 */
    if (ty_is_func(ty)) {
        const char *fm = arena_strndup(&A_main, d->name, d->nlen);
        Sym *ffs = sym_find(fm, d->nlen);

        if (!ffs) {
            ffs = sym_add(fm, d->nlen, ty, SC_GLOBAL);
            ffs->is_func = 1;
            ffs->val = (i64)x64_sym(&X64, emit_name(fm));
        }
        if (pa_accept_ch('=')) {
            if (pa_is_ch('{'))
                skip_init_list();
            else
                init_skip_value();
        }
        return;
    }
    /* c6：文件作用域的对象也是"定义"，一样要写初始化器。`static`/`extern`
     * 例外：前者本来就落在数据段里（0），后者只是引用。 */
    if (in_c6_tu() && !PA_TMPL_BODY && !PA_SIG_ONLY && !PA_STATIC && !PA_EXTERN && !ty_is_func(ty)
        && !pa_is_ch('=') && !pa_is_ch('{'))
        pa_error("variable '%s' must be initialized",
                 arena_strndup(&A_main, d->name, d->nlen));
    if (ty_is_array(ty) && ty_array_n(ty) == 0 && pa_is_ch('=')
        && pa_peek(1)->kind == TK_STR) {
        /* `char s[] = "…"`（可能带相邻字面量拼接）：先把数据段写出来才知道
         * 元素个数，所以顺序反过来——先取字符串，再定类型、再登记符号。 */
        u32 off = 0;
        u32 n = 0;

        pa_advance();                  /* 吃掉 '=' */
        off = str_lit_data();
        n = STR_LIT_N + 1;
        ty = ty_array(ty_target(ty), n);
        s = sym_add(d->name, d->nlen, ty, SC_GLOBAL);
        s->goff = data_alloc(ty_size(ty), ty_align_of(ty));
        s->val = (i64)x64_data_sym(&X64, s->name, ELF_HDR + s->goff);
        /* `static const char x[] = "lit"`（内核里极常见）走这条字符串专用路，
         * 提前 return 不会经过下面 22887 的文件作用域 static 分支——漏设
         * STB_LOCAL，两个 TU 的同名 static 表就 multiple definition。 */
        if (SCOPE && !SCOPE->up && PA_STATIC) {
            s->is_static = 1;
            X64.sym[(u32)s->val].is_static = 1;
        }
        memcpy(DATA_IMG.p + s->goff, DATA_IMG.p + off,
               (size_t)ty_size(ty) < (size_t)(WIDE_LIT ? n * 4 : n)
               ? (size_t)ty_size(ty) : (size_t)(WIDE_LIT ? n * 4 : n));
        return;
    }
    if (ty_is_array(ty) && ty_array_n(ty) == 0 && pa_is_ch('=')
        && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), "{")
        && pa_peek(2)->kind == TK_STR
        && !ty_is_ptr(ty_target(ty)) && ty_size(ty_target(ty)) == 1) {
        /* `char s[] = { "abc" };`：长度按字面量定（C99 6.7.8p22），不是按
         * 花括号体里的**条数**。body_capture 数出来是 1 条，于是数组被开成
         * 1 个字符，`static char joined[] = { "file\npipe" "\nsocket" };`
         * 只剩首字节（内核 fs/coredump.c 的 core_modes[] 正是这个形状）。 */
        u32 k2 = 2;
        u32 off = 0;
        u32 n = 0;

        while (pa_peek(k2)->kind == TK_STR)
            k2++;
        if (pa_peek(k2)->kind == TK_PUNCT && TOK_EQ(pa_peek(k2), "}")) {
            pa_advance();              /* 吃掉 '=' */
            pa_advance();              /* 吃掉 '{' */
            off = str_lit_data();
            n = STR_LIT_N + 1;
            ty = ty_array(ty_target(ty), n);
            s = sym_add(d->name, d->nlen, ty, SC_GLOBAL);
            s->goff = data_alloc(ty_size(ty), ty_align_of(ty));
            s->val = (i64)x64_data_sym(&X64, s->name, ELF_HDR + s->goff);
            if (SCOPE && !SCOPE->up && PA_STATIC) {
                s->is_static = 1;
                X64.sym[(u32)s->val].is_static = 1;
            }
            memcpy(DATA_IMG.p + s->goff, DATA_IMG.p + off,
                   (size_t)ty_size(ty) < (size_t)(STR_LIT_ESZ * n)
                   ? (size_t)ty_size(ty) : (size_t)(STR_LIT_ESZ * n));
            pa_expect_ch('}');
            return;
        }
    }
    if (ty_is_array(ty) && ty_array_n(ty) == 0 && pa_is_ch('=')) {
        was_inc = 1;
        Tok *nx = pa_peek(1);

        if (nx->kind == TK_STR)
            ty = ty_array(ty_target(ty), (u32)(nx->len > 1 ? nx->len - 1 : 1));
        else if (nx->kind == TK_PUNCT && TOK_EQ(nx, "{")) {
            u32 esz = ty_size(ty_target(ty)) ? ty_size(ty_target(ty)) : 1;
            /* 以设计符开头的初始化器可能直接用很大的下标（`{[127] = …}`、
             * `{[0 ... 255] = …}`），按 1 KB 留地方会不够——够不着元素就只能
             * 把游标卡在末尾，数组长度和内容全错。这种给 64 KB 的余量，
             * 填完再把尾巴收回去（见下面 was_inc 那段）。 */
            Tok *a2 = pa_peek(2);

            if (a2 && a2->kind == TK_PUNCT && (TOK_EQ(a2, "[") || TOK_EQ(a2, "."))) {
                /* 8 KB 的余量：够 `{[0 ... 255] = …}` 这种（指针 2 KB、char 256 B），
                 * 又不至于把叶子数顶过 INIT_LF_MAX（16384）——顶过去会整块退回旧
                 * 实现，那边不认设计符，长度会算成 0。 */
                ty = ty_array(ty_target(ty), 8192u / esz);
                was_big = 1;
            } else {
                /* 顺序初始化：先把整个花括号体抓下来数顶层逗号，按数出来的
                 * 条数开数组，再放回去正常解析。前瞻窗口只有 16 个 token，
                 * 边解析边看是看不到头的；早先按 1 KB 估，元素一多就静默
                 * 截断（`struct S a[] = {…}` 只要 28 字节一条，36 条就满）。 */
                u32 ncap = 0;
                u32 bound = 0;
                Tok *body = NULL;
                u32 bodycap = 0;

                pa_advance();              /* 吃掉 `=`，游标停到 `{` */
                ncap = body_capture(&body, &bodycap);
                bound = CAP_BOUND;
                /* `extern int a[10]; int a[] = {1, 2};`：长度按**前面那条
                 * 声明**走（C11 6.7.6.2p5），不能按初始化器的条数缩成 2。 */
                {
                    Sym *prev = sym_find(d->name, d->nlen);

                    if (prev && prev->kind == SC_GLOBAL && ty_is_array(prev->type)
                        && ty_array_n(prev->type) > bound) {
                        bound = ty_array_n(prev->type);
                        was_min = bound;
                    }
                }
                ty = ty_array(ty_target(ty), bound > 0 ? bound : 1);
                /* 预留按数出来的上界开（不再截断），最终长度仍按 INIT_COUNT
                 * 收——用实际写进去的元素数，才不会出现"声明得比写得多、
                 * 尾巴是垃圾"的情况。 */
                was_big = 1;
                ate_eq = 1;
                pa_src_push_back(body, ncap);
            }
        }
    }
    /* `extern int math__counter;`（纯 C 一侧引用模块全局）：符号已经有了，
     * 绑定过去就行，别再给它另开一段存储——另开的话读到的是 0（tests/abi/
     * module.c6 的 `math__counter != 7` 就是这么来的）。`sym_find` 里带着
     * "剥模块前缀再查一遍"的回退，所以 `math__counter` 会落到 `counter` 上。 */
    if (PA_EXTERN) {
        Sym *ex = sym_find(d->name, d->nlen);

        if (ex && ex->kind == SC_GLOBAL && ex->goff && !ex->tls_ref) {
            ex->is_extern = 1;
            return;
        }
        /* `extern __thread T x;`：值在**别的 TU** 里定义，编译这一刻还看不到
         * 它的数据段偏移。所以这里不分配存储，只登记一个"引用"符号，偏移装
         * 在一格数据里，等所有 TU 解析完由 tls_finish() 回填（寻址见
         * ident_addr 的 TLS 分支）。单 TU 里也走这条路：`extern __thread`
         * 后面才定义是合法的。 */
        if (PA_TLS) {
            Sym *r = sym_add(d->name, d->nlen, ty, SC_GLOBAL);
            char sn[256] = {0};

            r->is_tls = 1;
            r->is_extern = 1;
            r->tls_ref = 1;
            r->tls_slot = data_alloc(8, 8);
            snprintf(sn, sizeof(sn), "__c6_tlsoff.%s", r->name);
            r->val = (i64)x64_data_sym(&X64, sn, ELF_HDR + r->tls_slot);
            if (NTLS_REF < TLS_REF_MAX)
                TLS_REF[NTLS_REF++] = r;
            return;
        }
        /* 纯 C 的 `extern T x;`（本 TU 没声明过这个对象，定义在别处）：
         * **出 .o 时**只登记一个"引用"符号，不分配存储——C99 6.9.2p2 里带
         * extern 的文件作用域声明不是定义，给了空间就会在两个 .o 里各定义
         * 一次、链接期重复定义。地址走 X64 符号表（此时未定义），由 -c 落成
         * 一条重定位，链接器去别的 .o 里找。
         *
         * 单镜像（-c 之外）这条路上历史行为是"给一格零初始化的存储"：
         * rt.c6 的 `extern char **environ;` 就靠这格（只有调 execve 时才读），
         * 改成纯引用会让每个程序都报"未定义的符号 environ"。所以这里按模式
         * 分叉，而不是一刀切——等运行时有自己的 environ 定义再统一。 */
        if (PA_RELOC) {
            Sym *r2 = sym_add(d->name, d->nlen, ty, SC_GLOBAL);

            r2->is_extern = 1;
            r2->val = (i64)x64_data_ref(&X64, r2->name);
            return;
        }
    }
    s = sym_add(d->name, d->nlen, ty, SC_GLOBAL);
    sz = ty_size(ty) ? ty_size(ty) : 8;
    {
        u32 al = ty_align_of(ty);
        /* 声明符尾部的 `__aligned(N)` 提高对齐要求（内核 __page_aligned_bss）。 */
        if ((u32)DECL_ALIGN_REQ > al)
            al = (u32)DECL_ALIGN_REQ;
        if (al > GLOB_MAX_ALIGN)
            GLOB_MAX_ALIGN = al;
        s->goff = data_alloc(sz, al);
    }
    DECL_ALIGN_REQ = 0;
    /* 文件作用域的 static：发射名带 TU 后缀，两个 TU 的同名 static 是
     * 两段互不相干的数据（符号表里仍是短名，见 tu_static_name） */
    if (SCOPE && !SCOPE->up && PA_STATIC) {
        s->is_static = 1;
        s->val = (i64)x64_data_sym(&X64, tu_static_name(s->name), ELF_HDR + s->goff);
        X64.sym[(u32)s->val].is_static = 1;
    } else {
        s->val = (i64)x64_data_sym(&X64, s->name, ELF_HDR + s->goff);
        /* 块作用域的 static 局部（发射名 `<函数>.<N>`）也是本 TU 私有 */
        if (PA_STATIC)
            X64.sym[(u32)s->val].is_static = 1;
    }
    /* `s` 指向符号表里的槽：解析初始化器的过程中只要再 `sym_add` 一次
     * （字符串字面量、枚举、匿名聚合……），符号表就可能扩容搬家，`s` 就成了
     * 悬垂指针。之前就是这样把 `static int g = 42` 的 42 写到了别的偏移上，
     * 于是代码读 `D+83` 拿到 0（LLVM 后端上一整类"静态初值读出来是 0"的
     * 现象都出自这里）。分配到的 goff 先抄进局部量，后面只用它。 */
    goff = s->goff;
    /* `void __weak (*pm_power_off)(void);`：weak 修饰的是函数指针**变量**，
     * 走数据符号路径。不设 STB_WEAK 就和 arch/x86 的强定义 multiple definition。
     * 函数定义的 weak 在 24037 附近单独处理，这里覆盖数据/变量定义。 */
    if (SAW_WEAK && (u32)s->val < X64.nsym)
        X64.sym[(u32)s->val].is_weak = 1;
    /* `__thread`：存储照旧在数据段里（初始化器一条都不用改），只是访问换成
     * `%fs + goff`，并把 [goff, goff+sz) 记进 TLS 影像范围。 */
    if (PA_TLS) {
        s->is_tls = 1;
        tls_note(s->goff, sz);
    }
    if (d->mgd)
        s->is_mgd = (u8)(d->mgd_kind == 1 ? 2 : 1);
    if (ty == ty_thread() && PA_TASK_KW == 1)
        pa_error("task 只能在函数里声明");   /* 全局托管量：2 = 弱 */
    if (!ate_eq && !pa_accept_ch('='))
        return;
    if (pa_is_ch('{')) {
        u32 et = ty_is_array(ty) ? ty_target(ty) : 0;
        u32 end_alloc = DATA_IMG.n;

        gen_glob_braced_new(goff, ty, 0);
        if (was_inc && et && ty_is_array(s->type)) {
            u32 real = INIT_CNT_OK ? INIT_COUNT : 1;

            if (real < was_min)
                real = was_min;
            s = sym_find(d->name, d->nlen);
            if (s)
                s->type = ty_array(et, real);
            /* 预留的尾巴收回来。只有当它仍是数据段末尾时才安全（初始化器里
             * 要是有字符串字面量，字面量已经排在后面了，那就留着这块空地）。 */
            if (was_big && DATA_IMG.n == end_alloc) {
                u32 real = goff + ty_size(s->type);

                if (real < DATA_IMG.n)
                    DATA_IMG.n = real;
            }
        }
        return;
    }
    if ((ty_is_agg(ty) || ty_is_array(ty)) && pa_is_compound_lit()) {
        /* `struct P g = (struct P){ 1, 2 };` —— 数据段也吃复合字面量 */
        u32 ex = pa_take_paren_type();

        gen_glob_braced_new(goff, ty, 0);
        while (ex--)
            pa_expect_ch(')');
        return;
    }
    if (pa_cur()->kind == TK_STR) {
        u32 off = str_lit_data();
        u32 n = 0;

        while (DATA_IMG.p[off + n] && n < sz)
            n++;
        if (ty_is_array(ty)) {
            u32 k = n + 1 < sz ? n + 1 : sz;

            memcpy(DATA_IMG.p + goff, DATA_IMG.p + off, k);
        } else if (ty_is_ptr(ty)) {
            u64 va = (u64)DATA_VA(off);
            u32 i2 = 0;

            for (i2 = 0; i2 < 8; i2++)
                DATA_IMG.p[goff + i2] = (u8)(va >> (8 * i2));
            c99_reloc_add(goff, off);
        } else {
            pa_error("字符串初始化器只能给数组或指针");
        }
        return;
    }
    /* 文件作用域的函数字面量：`static int (*f)(int) = int(int v) { … };`
     * 数据段里存的就是那个隐藏函数的地址（和 `&func` 同一套重定位）。 */
    if (ty_is_ptr(ty) && pa_at_typename() && pa_peek(1)->kind == TK_PUNCT
        && tok_eq(pa_peek(1), "(")) {
        int ldep = 0;
        int lq = 0;
        int lhit = 0;

        for (lq = 1; lq < PA_LOOK; lq++) {
            Tok *t2 = pa_peek(lq);

            if (t2->kind != TK_PUNCT)
                continue;
            if (tok_eq(t2, "(")) {
                ldep++;
            } else if (tok_eq(t2, ")")) {
                ldep--;
                if (ldep == 0) {
                    Tok *nx = pa_peek(lq + 1);

                    lhit = (nx->kind == TK_PUNCT && TOK_EQ(nx, "{"));
                    break;
                }
            }
        }
        if (lhit) {
            Sym *fs = fnlit_parse_sym();

            if (fs)
                data_fixup_add(s->goff, (u32)fs->val);
            return;
        }
    }
    /* `&&label`：计算 goto 的标号地址（数据段里也照样支持） */
    if (ty_is_ptr(ty) && pa_is_punct("&&") && pa_peek(1)->kind == TK_IDENT) {
        u32 l = goto_label(tok_data(pa_peek(1)), pa_peek(1)->len);

        pa_advance();
        pa_advance();
        code_lbl_fixup_add(s->goff, x64_cur_fnseq(&X64), l);
        return;
    }
    /* `&x` / 函数名 / `&arr[0]` / `A + 2` / `&s.m` 这类地址常量：留给布局后回填。
     * 加数（成员偏移、常量下标）在 glob_addr_parse 里就算好，三个后端共用。 */
    if (ty_is_ptr(ty)) {
        int amp = 0;
        int ak = 0;

        /* `&((T *)0)->m[i]`（offsetof，内核 net/core/neighbour.c 的
         * NEIGH_PARMS_DATA_OFFSET）：在 `&` 被吃掉之前整条交给 const_expr，
         * 它的 `&` 分支本来就支持带常量下标的成员偏移。否则下面的
         * glob_addr_start 把 `struct` 当符号名，报"'&struct' 不是地址常量"。 */
        {
            u32 lp = 0;

            /* 宏里常把整条地址括起来：`( &((T *)0)->m[i] )`。先数前导 `(`。 */
            while (pa_peek(lp) && pa_peek(lp)->kind == TK_PUNCT
                   && TOK_EQ(pa_peek(lp), "("))
                lp++;
            if (pa_peek(lp) && pa_peek(lp)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(lp), "&")
                && pa_peek(lp + 1) && pa_peek(lp + 1)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(lp + 1), "(")
                && pa_peek(lp + 2) && pa_peek(lp + 2)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(lp + 2), "(")
                && pa_peek(lp + 3) && is_typename_tok(pa_peek(lp + 3))
                && pa_is_offsetof_ahead((int)lp + 3)) {
                i64 offv = 0;
                u32 j = 0;

                for (j = 0; j < lp; j++)
                    pa_advance();              /* 前导 `(` */
                offv = const_expr();           /* &((T *)0)->m[i] */
                for (j = 0; j < lp; j++)
                    pa_expect_ch(')');
                glob_store(s->goff, 0, ty, (u64)offv);
                return;
            }
        }
        amp = pa_accept_ch('&');

        if (amp && gen_glob_compound_addr(s->goff))
            return;
        ak = glob_addr_start(amp);
        if (ak) {
            glob_addr_parse(s->goff, amp, ak == 2, 0);
            return;
        }
        if (!amp) {
            /* 没有 `&` 的数组名/函数名：它们**退化**成指向首元素的指针，
             * 本身就是地址常量。glob_addr_start() 返回 0 表示"后面没有
             * `[`/`.`/`->`/`(`/`+`/`-`"，那就是裸名字，照地址常量收。
             *
             * 内核 include/linux/sysfs.h:297 的 ATTRIBUTE_GROUPS 展开成
             *     .attrs = _Generic(_name##_attrs,
             *                        struct attribute **: _name##_attrs, …)
             * 常量层选中那个分支以后，值就是数组名本身。不认它就掉到下面
             * 的 const_expr，把数组当"整数"求出来写进数据段（静默错值）。 */
            Tok *t0 = pa_cur();
            Sym *as = NULL;

            if (t0 && t0->kind == TK_IDENT)
                as = sym_find(tok_data(t0), t0->len);
            if (as && (as->kind == SC_GLOBAL || as->is_func)
                && (ty_is_array(as->type) || as->is_func)) {
                glob_addr_parse(s->goff, 0, 0, 0);
                return;
            }
        }
        if (amp)
            pa_error("全局地址初始化器只支持 &全局/函数");
    }
    /* 文件作用域切片的初始化器：`{ data, len }` 才对，拿数组/指针直接初始化
     * 只会把符号索引当 data、len 留 0（静默错）。两条诊断分开报：
     * 长度未知的数组根本切不了，其他情况是"静态初始化器要写成两个字"。
     * （tests/errors/slice.c6 的 test_file_scope_array / test_unknown_length） */
    /* 静态存储期的闭包（文件作用域或块作用域的 `static`）：闭包对象是运行期
     * 现开的，不是常量表达式，只能用 NULL 起步
     * （tests/errors/closure_convert.c6 的 test_static / test_static_local）。 */
    if (ty_is_closure(ty, NULL) && in_c6_tu()) {
        Tok *c0 = pa_cur();
        int cnull = 0;

        if (c0 && c0->kind == TK_NUM && tok_data(c0)[0] == '0')
            cnull = 1;
        if (c0 && c0->kind == TK_IDENT
            && (TOK_EQ(c0, "NULL") || TOK_EQ(c0, "nullptr")))
            cnull = 1;
        /* `((void *)0)` 这种（NULL 的展开）也算空值 */
        if (c0 && c0->kind == TK_PUNCT && tok_eq(c0, "("))
            cnull = 1;
        if (!cnull)
            pa_error("a closure is not a constant expression: initialize it at run "
                     "time ('NULL' is fine at file scope)");
    }
    if (ty_is_slice(ty) && in_c6_tu()) {
        Tok *t0 = pa_cur();
        int unknown_len = 0;

        if (t0 && t0->kind == TK_IDENT) {
            Sym *is = sym_find(tok_data(t0), t0->len);

            if (is && ty_is_array(is->type) && ty_array_n(is->type) == 0)
                unknown_len = 1;
        }
        if (unknown_len)
            pa_error("cannot slice an array of unknown length");
        else
            pa_error("a slice cannot be initialized from an array in a static "
                     "initializer; use '{ data, len }'");
    }
    if (ty_is_cplx(ty)) {
        /* 复数全局：`static double _Complex g = 2.0;`（C99 6.7.8p13 允许拿实数
         * 初始化复数对象）。交给 gen_glob_obj 的复数分支：实部按分量类型落盘，
         * 虚部保持数据段本来就有的 0。不走下面那些标量分支——它们按整数的
         * const_expr 取值，`2.0` 会以位模式 2 落地（读出来 9.88e-324）。 */
        gen_glob_obj(goff, ty, 0);
        return;
    }
    if (ty_is_float(ty)) {
        /* 全局浮点初始化器：字面量（或整型常量）→ IEEE-754 位模式。
         * 以前这里走整型的 const_expr，`double x = 0.1;` 直接变成 0。 */
        u64 bits = 0;
        int neg = 0;

        (void)neg;
        {
            double dv = 0;

            if (pa_cur()->kind == TK_NUM || pa_is_ch('-') || pa_is_ch('+')
                || pa_is_ch('(')) {
                int ok = 1;

                dv = const_fexpr(&ok);
                if (!ok)
                    dv = 0;
            } else {
                dv = (double)const_expr();
            }
            if (ty_kind(ty) == TY_BF16) {
                u32 b32 = 0;

                *(float *)&b32 = (float)dv;
                bits = (u64)bf16_bits_of_f32(b32);
            } else if (ty_size(ty) == 4) {
                u32 b32 = 0;
                float fv = (float)dv;

                *(float *)&b32 = fv;
                bits = (u64)b32;
            } else {
                *(double *)&bits = dv;
            }
        }
        glob_store(goff, 0, ty, bits);
        return;
    }
    if (ty_is_ptr(ty)) {
        /* 全局指针的初始化器交给 gen_glob_obj：那里有完整的"地址常量"处理
         * （`&sym`、函数名、`A + 2`、`&g.m`），还有"剥掉外层标量强制转换再认"
         * 的那一段。这条路径以前没有指针分支，`static void *p = (void *)&f;`
         * 直接掉进下面的 const_expr —— 而常量求值只认
         * `&((T *)0)->member`，于是内核 EXPORT_SYMBOL 的每一个
         * `(void *)(uintptr_t)&sym` 都成了一条"常量表达式里只支持…"
         * （实测 lib/string.c 21 条）。
         *
         * 交给 gen_glob_obj 不会递归回来：它认不出地址时自己走
         * parse_const_u64，和这里原来的行为一致。 */
        gen_glob_obj(goff, ty, 0);
        return;
    }
    {
        i64 v = 0;
        u32 save_sym2 = CONST_SYM;
        int is_sym2 = 0;
        i64 sym_add2 = 0;

        CONST_SYM = 0;
        CONST_SYM_ADD = 0;
        v = const_expr();
        is_sym2 = (int)CONST_SYM;
        sym_add2 = CONST_SYM_ADD;
        CONST_SYM = save_sym2;
        if (is_sym2) {
            /* 整型字段里装的是**地址常量**：`(kernel_ulong_t)(&i830_early_ops)`、
             * `(unsigned long)&g`。往常量求值拿到的是符号下标，直接当整数存进去
             * 就编成了 0xC2 这种"下标"（内核 arch/x86/kernel/early-quirks.c 的
             * intel_early_ids、kernel/watchdog.c 的 watchdog_cpumask_bits 都是
             * 这个形状）。和指针那条路一样补一条重定位。 */
            glob_store(goff, 0, ty, 0);
            data_fixup_add_ex(goff, (u32)v, sym_add2);
            return;
        }
        glob_store(goff, 0, ty, (u64)v);
    }
}

/* 引用环：托管字段（`@T` / `@T[]`，不含 `own`/`weak`）连起来的图里如果有环，
 * 对象永远退不到 0，等于泄漏。从每个类型出发做一遍 DFS，回到自己就报
 * （tests/errors/gc_cycle.c6）。
 *
 * 检查在**所有翻译单元都解析完之后**跑一次（pa_compile_ex 里 pa_parse_tu()
 * 之后）：命令行上的多个源文件是接连压进预处理器文件栈、当成一个 TU 解析的
 * （main.c6），所以第二个单元定义的结构体也在同一张类型/MGDST 表里。环上
 * 的节点定义在不同文件时报「跨翻译单元」的形状
 * （tests/errors/gc_cycle_cross_tu.c6 + tests/tu/gc_cycle_cross_tu.c6）。 */
#define CYC_STACK 16
static u32 CYC_PATH[CYC_STACK];
static int CYC_N;
static int CYC_ERR_SEEN;

static int cyc_edges(u32 ty, u32 *out, int cap)
{
    u32 k = mgdst_find(ty);
    int n = 0;
    u32 j = 0;

    if (k == 0xFFFFFFFFu)
        return 0;
    for (j = 0; j < MGDST_N[k] && n < cap; j++) {
        u32 idx = (u32)MGDST_IDX[k][j];
        u8 kind = MGDST_KIND[k][j];
        u32 mty = 0;

        if (kind == 2 || kind == 4)
            continue;                   /* 弱引用 / own 都不是强边 */
        if (idx >= ty_member_n(ty))
            continue;
        mty = ty_member(ty, idx);
        /* `@T[]` 字段：先看元素类型 */
        if (ty_is_array(mty))
            mty = ty_target(mty);
        if (ty_is_ptr(mty))
            mty = ty_target(mty);
        if (ty_is_agg(mty))
            out[n++] = mty;
    }
    return n;
}

/* 往诊断文案里拼一节：snprintf 返回的是"本该写多长"，缓冲区满了还按它
 * 累加偏移就越界了（16 层的环配上 "struct XXX" 比 512 字节长）。 */
static u32 cyc_put(char *buf, u32 cap, u32 o, const char *fmt, const char *s)
{
    if (o + 1 < cap)
        o += (u32)snprintf(buf + o, (size_t)(cap - o), fmt, s);
    return o < cap ? o : cap - 1;
}

static void cyc_dfs(u32 start, u32 ty, int depth)
{
    u32 nxt[16] = {0};
    int n = 0;
    int i = 0;

    if (depth > CYC_STACK - 2 || CYC_ERR_SEEN)
        return;
    n = cyc_edges(ty, nxt, 16);
    for (i = 0; i < n; i++) {
        if (nxt[i] == start) {
            char chain[512] = {0};
            u32 q = 0;
            u32 o = 0;
            int cross = 0;
            u32 f0 = mgd_file(start);

            /* 环上的节点是不是都定义在同一个翻译单元里？不是就是跨 TU 的
             * 环：这次编译把命令行上的所有 TU 接连编在一起（main.c6），
             * 所以类型表里看得见第二个 TU 定义的结构体
             * （tests/errors/gc_cycle_cross_tu.c6）。 */
            for (q = 0; q < (u32)CYC_N; q++)
                if (mgd_file(CYC_PATH[q]) != f0)
                    cross = 1;
            if (cross) {
                const char *tn = sym_tag_name(start);

                /* 跨 TU 的文案跟上游一致：不带字段名，节点用裸标签名。 */
                o = cyc_put(chain, (u32)sizeof(chain), o, "%s",
                            tn ? tn : ty_disp(start));
                for (q = 0; q < (u32)CYC_N; q++) {
                    const char *tq = sym_tag_name(CYC_PATH[q]);

                    o = cyc_put(chain, (u32)sizeof(chain), o, " -> %s",
                                tq ? tq : ty_disp(CYC_PATH[q]));
                }
                o = cyc_put(chain, (u32)sizeof(chain), o, " -> %s",
                            tn ? tn : ty_disp(start));
                pa_error("reference cycle across translation units: %s; "
                         "break it with 'weak' or 'own'", chain);
                CYC_ERR_SEEN = 1;
                return;
            }
            o = cyc_put(chain, (u32)sizeof(chain), o, "%s", ty_disp(start));
            for (q = 0; q < (u32)CYC_N; q++)
                o = cyc_put(chain, (u32)sizeof(chain), o, " -> %s",
                            ty_disp(CYC_PATH[q]));
            o = cyc_put(chain, (u32)sizeof(chain), o, " -> %s", ty_disp(start));
            pa_error("reference cycle: %s; break it with 'weak' or 'own'", chain);
            CYC_ERR_SEEN = 1;
            return;
        }
        {
            int seen = 0;
            u32 q2 = 0;
            int d2 = depth;

            for (q2 = 0; q2 < (u32)CYC_N; q2++)
                if (CYC_PATH[q2] == nxt[i])
                    seen = 1;
            if (seen || nxt[i] == start)
                continue;
            CYC_PATH[CYC_N++] = nxt[i];
            cyc_dfs(start, nxt[i], d2 + 1);
            CYC_N--;
        }
    }
}

static void gc_cycle_check(void)
{
    u32 k = 0;

    CYC_ERR_SEEN = 0;
    for (k = 0; k < NMGDST; k++) {
        u32 ty = MGDST_TY[k];

        CYC_N = 0;
        cyc_dfs(ty, ty, 0);
        if (CYC_ERR_SEEN)
            return;
    }
}

static void pa_parse_tu(void)
{
    u16 decl_file = 0xFFFF;      /* 上一个顶层声明在哪个文件里（MODFIRST 用） */
    int any_decl = 0;

    while (pa_cur()->kind != TK_EOF) {
        u32 base = 0;
        Declarator d = {0};
        u32 ty = 0;
        Sym *s = NULL;

        if (pa_accept_ch(';'))
            continue;
        /* 文件作用域 asm（定义符号用）：必须在 parse_typespec 之前认——
         * 那边 skip_attributes 会把 `asm` 当属性关键字默默吃掉。 */
        if (try_toplevel_asm())
            continue;
        if (PA_IS_IDENT("foreach") && c6_kw())
            pa_error("'foreach' can only be used inside a function");
        /* 模块声明（改写阶段把 `module a.b;` 换成了这条）：
         *   - 必须是本文件里的第一个声明；
         *   - 同一个文件不许写两次；
         *   - 模块里不许有 `main`（见下面定义处）。
         * 判定放在这儿才看得见 `#if` 之后剩下的那份文本
         * （tests/errors/module.c6）。 */
        if (PA_IS_IDENT("__c6_module_decl") && pa_peek(1)
            && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")) {
            char mnm[200] = {0};
            u32 ml = 0;
            u16 mfile = pa_cur()->file;   /* CUR_FILE 在解析期是 NULL，用 token 的 */

            pa_advance();
            pa_advance();
            if (pa_cur()->kind == TK_STR) {
                const char *sd = tok_data(pa_cur());
                u32 sl = pa_cur()->len;

                /* 字符串 token 的文本带引号，去掉 */
                if (sl >= 2 && sd[0] == '"') {
                    sd++;
                    sl -= 2;
                }
                ml = sl < sizeof(mnm) - 1 ? sl : sizeof(mnm) - 1;
                memcpy(mnm, sd, ml);
                mnm[ml] = 0;
                pa_advance();
            }
            pa_expect_ch(')');
            (void)pa_accept_ch(';');
            if (ml) {
                if (mod_of_file((u32)mfile))
                    pa_error("module '%s' already declared in this file", mnm);
                else if (any_decl && decl_file == mfile)
                    pa_error("'module' must be the first declaration in the file");
                else
                    mod_set_file((u32)mfile, mod_intern(mnm));
            }
            continue;
        }
        decl_file = pa_cur()->file;
        any_decl = 1;
        /* `co f();` 是语句，文件作用域上没有意义（软关键字：后面跟
         * `标识符 (` 才算，`co` 自己也还能是普通名字）。 */
        if (PA_IS_IDENT("co") && c6_kw() && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
            && pa_peek(2) && pa_peek(2)->kind == TK_PUNCT && tok_eq(pa_peek(2), "(")
            && !sym_find(tok_data(pa_cur()), pa_cur()->len))
            pa_error("'co' 只能在函数里用");
        /* c6 角色宏定义：`stmt swap(expr a, expr b) { … }` */
        if (cm_try_define())
            continue;
        /* 文件作用域上也能用宏展开出声明：展开了就重来一轮 */
        if (cm_expand(-1))
            continue;
        /* c6 的 `test "名字" { … }` 块：当函数编，失败返回非 0 */
        if (PA_IS_IDENT("test") && c6_kw()
            && (pa_peek(1)->kind == TK_STR || TOK_EQ(pa_peek(1), "{"))) {
            char nm[128] = {0};
            char desc[128] = {0};
            Declarator td = {0};

            pa_advance();
            if (pa_cur()->kind == TK_STR) {
                /* 名字太长就截断，但别把 UTF-8 多字节字符从中间切开——
                 * 中文名 3 字节一个字，卡在中间就输出半个字符（报告里全是
                 * "失败样例：…任务前缀持有"这种断尾巴）。 */
                u32 nl0 = pa_cur()->len > 100 ? 100 : pa_cur()->len;
                const char *nd0 = tok_data(pa_cur());

                while (nl0 > 0 && nl0 < pa_cur()->len && ((u8)nd0[nl0] & 0xC0) == 0x80)
                    nl0--;
                snprintf(nm, sizeof(nm), "test:%.*s", (int)nl0, nd0);
                /* 字符串 token 的文本带引号，报告行只写描述本身（和 tcc 的
                 * C6TestEntry.desc 一样），否则 PASS/FAIL 行会多一对引号。 */
                if (nl0 >= 2 && nd0[0] == '"' && nd0[nl0 - 1] == '"')
                    snprintf(desc, sizeof(desc), "%.*s", (int)(nl0 - 2), nd0 + 1);
                else
                    snprintf(desc, sizeof(desc), "%.*s", (int)nl0, nd0);
                pa_advance();
            } else {
                snprintf(nm, sizeof(nm), "test#%u", NTESTS);
                snprintf(desc, sizeof(desc), "#%u", NTESTS);
            }
            {
                char fn[64] = {0};

                snprintf(fn, sizeof(fn), "c6test_%u", NTESTS);
                td.name = arena_strdup(&A_main, fn);
                td.nlen = (u32)strlen(fn);
                td.is_func = 1;
                td.type = ty_func(ty_int(), NULL, 0, 0);
                PA_FALLIBLE = 1;    /* test 块可以把错误往上报（try/catch） */
                s = sym_add(td.name, td.nlen, td.type, SC_GLOBAL);
                s->is_func = 1;
                s->val = (i64)x64_sym(&X64, emit_name(td.name));
                if (NTESTS < 512) {
                    TESTS[NTESTS] = (u32)s->val;
                    TEST_NAMES[NTESTS] = arena_strdup(&A_main, nm);
                    /* 报告行/过滤用描述本身（"test:" 前缀和引号已经去掉） */
                    TEST_DESCS[NTESTS] = arena_strdup(&A_main, desc);
                    NTESTS++;
                }
                pa_func_def(s, &td);
            }
            continue;
        }
        /* c6 的模块头：`module a.b.c;` / `import a.b.c;`（可能带 `as x`）。
         * c6c 是 C 前端，模块/导入暂不作语义处理——先把它们当"声明"吃掉，
         * 这样一个模块文件本身就能按 C 编译（c6 的扩展语法另算）。 */
        if (c6_kw() && (PA_IS_IDENT("module") || PA_IS_IDENT("import"))) {
            int is_mod = PA_IS_IDENT("module");
            char path[256] = {0};
            int pn = 0;

            pa_advance();
            /* `import a.b.c;` → 模块文件 a/b/c.c6。单 TU 口径：把模块源码
             * 文本内联进来（模块系统真正的导出改名/pic 还没做，见 todo）。 */
            while (pa_cur()->kind != TK_EOF && !pa_is_ch(';')) {
                if (pa_cur()->kind == TK_IDENT && pn < 240) {
                    u32 k = 0;

                    for (k = 0; k < pa_cur()->len && pn < 240; k++)
                        path[pn++] = tok_data(pa_cur())[k];
                } else if (pa_is_ch('.') && pn < 240) {
                    path[pn++] = '/';
                } else if (pa_is_ch('{')) {
                    skip_paren_group();
                    continue;
                }
                pa_advance();
            }
            if (pa_is_ch(';'))
                pa_advance();
            if (pn + 4 < 250) {
                path[pn] = 0;
                path[pn] = '.';
                path[pn + 1] = 'c';
                path[pn + 2] = '6';
                path[pn + 3] = 0;
                /* TODO(modules)：这里应该把模块源码内联进来。先把语法吃掉，
                 * 真导入等 pp 栈与解析器当前 token 的同步理清（见 todo P6-1b）。 */
                (void)is_mod;
            }
            continue;
        }
        if (try_pack_directive())
            continue;
        if (PA_ACCEPT_IDENT("_Static_assert") || PA_ACCEPT_IDENT("static_assert")) {
            parse_static_assert_rest();
            continue;
        }
        if (c6_kw() && PA_ACCEPT_IDENT("interface")) {
            const char *inm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : "";
            u32 iln = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
            u32 idx = NIFACE;

            if (pa_cur()->kind == TK_IDENT)
                pa_advance();
            if (NIFACE < IFACE_MAX && iln) {
                IFACE_NAME[NIFACE] = arena_strndup(&A_main, inm, iln);
                IFACE_NLEN[NIFACE] = iln;
                IFACE_NM[NIFACE] = 0;
                IFACE_TY[NIFACE] = 0;
                NIFACE++;
            } else {
                idx = IFACE_MAX;
            }
            pa_expect_ch('{');
            PA_IN_PROTO = 1;
            while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF) {
                u32 rty = parse_typespec();

                while (pa_accept_ch('*'))
                    rty = ty_ptr(rty);
                if (pa_cur()->kind == TK_IDENT) {
                    if (idx < IFACE_MAX && IFACE_NM[idx] < IFACE_NMET) {
                        u32 k = IFACE_NM[idx];

                        IFACE_RET[idx][k] = rty;

                        IFACE_MET[idx][k] = arena_strndup(&A_main, tok_data(pa_cur()),
                                                          pa_cur()->len);
                        IFACE_MLEN[idx][k] = pa_cur()->len;
                        IFACE_NM[idx] = k + 1;
                    }
                    pa_advance();
                }
                /* 形参类型要记下来：判断"某个类型实现了这个接口"时要逐个比 */
                if (pa_is_ch('(') && idx < IFACE_MAX && IFACE_NM[idx] > 0) {
                    u32 kk = IFACE_NM[idx] - 1;
                    u32 npf = 0;

                    pa_advance();
                    if (!pa_accept_ch(')')) {
                        for (;;) {
                            Declarator pd2 = {0};
                            int new_tag = 0;
                            u32 pt2 = 0;

                            if ((PA_IS_IDENT("struct") || PA_IS_IDENT("union")
                                 || PA_IS_IDENT("enum"))
                                && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
                                && !sym_find_tag(tok_data(pa_peek(1)), pa_peek(1)->len))
                                new_tag = 1;
                            pt2 = parse_typespec();
                            if (new_tag && ty_is_agg(pt2))
                                proto_tag_mark(pt2);

                            (void)parse_declarator(pt2, &pd2);
                            if (pd2.type)
                                pt2 = pd2.type;
                            if (npf < IFACE_NPARAM)
                                IFACE_PTY[idx][kk][npf] = pt2;
                            npf++;
                            if (!pa_accept_ch(','))
                                break;
                        }
                        pa_expect_ch(')');
                    }
                    IFACE_NP[idx][kk] = npf;
                }
                if (!pa_accept_ch(';'))
                    break;
            }
            PA_IN_PROTO = 0;
            pa_expect_ch('}');
            (void)pa_accept_ch(';');
            if (idx < IFACE_MAX) {
                (void)ty_iface(idx);
            }
            continue;
        }
        if (PA_ACCEPT_IDENT("typedef")) {
            Declarator d2 = {0};
            u32 b2 = parse_typespec();
            u32 t2 = 0;

            /* typedef 的声明符表可以有**多个**（C89 6.5.7：`typedef struct
             * { … } Rec_Type, *Rec_Pointer;`）。以前只认第一个，遇到逗号就报
             * "这里要 ';'（当前是 ','）"，而且这名字没登记上，后面整段 TU 的
             * 声明全被连锁带错（内核 lib/dhry.h:344 就是这个形状，
             * lib/dhry_1.c / dhry_2.c / dhry_run.c 三个文件都挂在这）。 */
            for (;;) {
                memset(&d2, 0, sizeof(d2));
                t2 = parse_declarator(b2, &d2);
                if (d2.name)
                    sym_add(d2.name, d2.nlen, t2, SC_TYPEDEF);
                if (!pa_accept_ch(','))
                    break;
            }
            pa_expect_ch(';');
            continue;
        }
        SAW_CTOR = 0;
        SAW_DTOR = 0;
        SAW_WEAK = 0;
        SAW_ALIAS = NULL;
        SAW_ASMNAME = NULL;
        PA_STATIC = 0;
        PA_EXTERN = 0;
        /* 函数模板定义：`|T| T f(…) { … }`——只捕获 token，调用点再重放 */
        if (pa_is_ch('|')) {
            const char *pn[4] = {0};
            u32 pl[4] = {0};
            int pk[4] = {0};
            u32 pvty[4] = {0};
            u32 np = 0;
            u32 ntok = 0;
            u32 i2 = 0;
            u32 name_i = 0;
            u32 body_i = 0;
            int found_name = 0;
            int found_body = 0;

            pa_advance();
            while (np < 4 && pa_cur()->kind == TK_IDENT) {
                /* `|T|` 类型形参；`|int N|` 值形参（按常量绑定） */
                if (pa_peek(1)->kind == TK_IDENT) {
                    u32 vpty = parse_typespec();

                    /* 值形参按常量绑定，比 int 宽的整型搬不动
                     * （tests/errors/generic.c6 的 test_value_param_type）。 */
                    if (vpty && ty_size(vpty) > 4)
                        pa_error("a value parameter must be an integer type no wider "
                                 "than 'int'");
                    if (pa_cur()->kind != TK_IDENT)
                        break;
                    pn[np] = tok_data(pa_cur());
                    pl[np] = pa_cur()->len;
                    pk[np] = 1;
                } else if (is_typename_tok(pa_cur())) {
                    /* `|int| void f(void);`：值形参得写 `<类型> 名字>` */
                    pa_error("a value parameter is written '<type> NAME'");
                    pn[np] = tok_data(pa_cur());
                    pl[np] = pa_cur()->len;
                    pk[np] = 0;
                } else {
                    u32 dj = 0;

                    for (dj = 0; dj < np; dj++)
                        if (pl[dj] == pa_cur()->len
                            && memcmp(pn[dj], tok_data(pa_cur()), pl[dj]) == 0)
                            pa_error("duplicate type parameter '%.*s'",
                                     (int)pl[dj], pn[dj]);
                    /* 形参名和已有模板同名：`|Vect| … Vect@…` 里那个 Vect 到底
                     * 是形参还是模板看不出来（tests/errors/generic.c6 的
                     * test_same_name）。 */
                    if (tmpl_find(tok_data(pa_cur()), pa_cur()->len))
                        pa_error("a type parameter cannot have the same name as its "
                                 "template");
                    pn[np] = tok_data(pa_cur());
                    pl[np] = pa_cur()->len;
                    pk[np] = 0;
                }
                np++;
                pa_advance();
                if (!pa_accept_ch(','))
                    break;
            }
            pa_expect_ch('|');
            ntok = tmpl_capture_body();
            /* `|T| typedef <spec> <名字>;`：typedef 模板。体里没有 `{`，
             * 实例化时按 `typedef` 后面那段重新解析一遍。 */
            if (ntok >= 3 && CAP_TOK[0].kind == TK_IDENT
                && TOK_EQ(&CAP_TOK[0], "typedef")) {
                u32 lastid = ntok;
                u32 q3 = 0;
                int has_brace = 0;

                for (q3 = 0; q3 < ntok; q3++)
                    if (CAP_TOK[q3].kind == TK_PUNCT && TOK_EQ(&CAP_TOK[q3], "{"))
                        has_brace = 1;
                if (!has_brace) {
                    /* `|T| typedef T *Ptr;`：体里没有花括号，`tmpl_capture_body`
                     * 一直吃到了文件尾，这里截到第一个 `;`。 */
                    for (q3 = 0; q3 < ntok; q3++)
                        if (CAP_TOK[q3].kind == TK_PUNCT && TOK_EQ(&CAP_TOK[q3], ";")) {
                            ntok = q3 + 1;
                            break;
                        }
                } else {
                    /* 有花括号时捕捉停在 `}`，后面的 `<名字> ;` 还没吃到——
                     * 解析器正好停在那里，接着收。 */
                    while (ntok < CAP_MAX && pa_cur()->kind != TK_EOF) {
                        int done = pa_is_ch(';');

                        CAP_TOK[ntok++] = *pa_cur();
                        pa_advance();
                        if (done)
                            break;
                    }
                }
                for (q3 = ntok; q3 > 0; q3--)
                    if (CAP_TOK[q3 - 1].kind == TK_IDENT
                        && !TOK_EQ(&CAP_TOK[q3 - 1], "typedef")) {
                        lastid = q3 - 1;
                        break;
                    }
                if (lastid < ntok && NTMPL < TMPL_MAX) {
                    Tmpl *t2 = &TMPL[NTMPL++];

                    memset(t2, 0, sizeof(*t2));
                    t2->name = arena_strndup(&A_main, tok_data(&CAP_TOK[lastid]),
                                             CAP_TOK[lastid].len);
                    t2->nlen = CAP_TOK[lastid].len;
                    t2->nparam = np;
                    for (q3 = 0; q3 < np; q3++) {
                        t2->param[q3] = arena_strndup(&A_main, pn[q3], pl[q3]);
                        t2->plen[q3] = pl[q3];
                        t2->pkind[q3] = pk[q3];
                    }
                    t2->is_typedef = 1;
                    t2->n = ntok - 1;
                    t2->toks = arena_alloc(&A_main,
                                           (size_t)(t2->n ? t2->n : 1) * sizeof(Tok));
                    if (t2->n)
                        memcpy(t2->toks, &CAP_TOK[1], (size_t)t2->n * sizeof(Tok));
                    continue;
                }
            }
            for (i2 = 0; i2 < ntok; i2++) {
                Tok *q = &CAP_TOK[i2];

                if (!found_body && q->kind == TK_PUNCT && TOK_EQ(q, "{")) {
                    body_i = i2;
                    found_body = 1;
                }
            }
            /* 没有体（前置声明）时名字仍要找到，所以扫到 `ntok` 为止。 */
            for (i2 = 0; i2 < (found_body ? body_i : ntok); i2++) {
                Tok *q = &CAP_TOK[i2];

                /* 函数名 = 紧挨在 `(` 前面的**标识符**。`Map@(K, V)` 里的
                 * `@` 也是紧挨着 `(` 的，那不是名字。 */
                if (q->kind == TK_PUNCT && tok_eq(q, "(") && i2 > 0
                    && CAP_TOK[i2 - 1].kind == TK_IDENT) {
                    name_i = i2 - 1;
                    found_name = 1;
                    break;
                }
            }
            /* 只有名字、没有体：那是**前置声明**（`|K, V| V second(Map@… *m);`），
             * 登记一个 `n == 0` 的模板，实例化时按"没有体"处理即可。 */
            if (!found_name) {
                pa_error("函数模板：找不到函数名");
                continue;
            }
            /* 前置声明：同名的模板已经有**带体**的登记就直接跳过——后面那个
             * 才是能实例化出函数体的那个（`tmpl_find` 只返回第一个）。 */
            if (!found_body) {
                Tmpl *ex = tmpl_find(tok_data(&CAP_TOK[name_i]), CAP_TOK[name_i].len);

                if (ex)
                    continue;
            }
            if (NTMPL < TMPL_MAX) {
                Tmpl *t = &TMPL[NTMPL++];
                u32 q2 = 0;

                /* 带体的定义来了：如果同名模板只有**前置声明**（n == 0），
                 * 就地替换掉它——`tmpl_find` 只返回第一个，留着声明就永远
                 * 实例化不出函数体。 */
                if (found_body && t > TMPL) {
                    Tmpl *old_t = tmpl_find(tok_data(&CAP_TOK[name_i]),
                                            CAP_TOK[name_i].len);

                    if (old_t && old_t->n == 0) {
                        t = old_t;
                        NTMPL--;
                    }
                }
                memset(t, 0, sizeof(*t));
                t->name = arena_strndup(&A_main, tok_data(&CAP_TOK[name_i]),
                                        CAP_TOK[name_i].len);
                t->nlen = CAP_TOK[name_i].len;
                t->nparam = np;
                for (q2 = 0; q2 < np; q2++) {
                    t->param[q2] = arena_strndup(&A_main, pn[q2], pl[q2]);
                    t->plen[q2] = pl[q2];
                    t->pkind[q2] = pk[q2];
                }
                t->is_func = 1;
                t->name_i = name_i;
                t->body_i = body_i;
                t->n = found_body ? ntok : 0;
                t->toks = arena_alloc(&A_main, (size_t)(ntok ? ntok : 1) * sizeof(Tok));
                if (ntok)
                    memcpy(t->toks, CAP_TOK, (size_t)ntok * sizeof(Tok));
            }
            continue;
        }
        /* 每条顶层声明独立判断 inline：PA_INLINE_SEEN 是 parse_typespec 里
         * 见到 inline 关键字时置位的，上一条纯声明（无函数体，走不到 pa_func_def
         * 的清零）的残留会污染下一条，使 rb_next 这类非 inline 全局函数被误
         * 本地化成 STB_LOCAL，链接期 undefined。 */
        PA_INLINE_SEEN = 0;
        PA_AT_DECL = 1;             /* 这条声明里认 alias / asm 标签 */
        base = parse_typespec();
        if (ty_is_taskh(base))
            pa_error("'task' can only be used inside a function");
        gen_decl_from_spec(base);
        PA_AT_DECL = 0;
        tmpl_drain();
    }
    /* 最后一次顶层声明里登记的模板实例化（以及函数字面量）还要再排空一次，
     * 否则它们只在符号表里有个名字、没有函数体，链接时才报"未定义的符号"。 */
    tmpl_drain();
}
static void tmpl_save_state(TmplSaved *sv)
{
    sv->fn = FN;
    sv->ret = CUR_RET_TY;
    sv->sret = CUR_SRET;
    sv->sret_on = CUR_SRET_ON;
    sv->self_ty = METHOD_SELF_TY;
    sv->loop = NLOOP;
    sv->sw = NSW;
    sv->nglbl = NGLBL;
    sv->dd = DEF_DEPTH;
    sv->ndf = NDF;
}

static void tmpl_restore_state(TmplSaved *sv)
{
    FN = sv->fn;
    CUR_RET_TY = sv->ret;
    CUR_SRET = sv->sret;
    CUR_SRET_ON = sv->sret_on;
    METHOD_SELF_TY = sv->self_ty;
    NLOOP = sv->loop;
    NSW = sv->sw;
    NGLBL = sv->nglbl;
    DEF_DEPTH = sv->dd;
    NDF = sv->ndf;
}

/* 一条普通的外部声明（从类型说明符之后开始）：函数定义走 pa_func_def，其它是
 * 全局变量。顶层循环和**函数模板实例化**共用这一段。 */
static void gen_decl_from_spec(u32 base)
{
    Declarator d = {0};
    Sym *s = NULL;
    const char *al = NULL;
    u32 ty = 0;
    int base_mgd_ptr = PA_MGD_PTR;      /* `@T a, b;` 的 @ 要给每个声明符 */
    int base_mgd_kind = PA_MGD_KIND;
    int base_tls = PA_TLS;              /* `__thread a, b;` 每个声明符都要 */

    /* 注意：**不要**在这里重置 SAW_CTOR / SAW_DTOR / PA_STATIC——它们是
     * parse_typespec() 在解析 `__attribute__((constructor))` 和 `static` 时
     * 置上的，调用方已经在调 parse_typespec 之前清过了。 */
    for (;;) {
        memset(&d, 0, sizeof(d));
        PA_MGD_PTR = base_mgd_ptr;
        PA_MGD_KIND = base_mgd_kind;
        PA_TLS = base_tls;
        ty = parse_declarator(base, &d);
        /* 声明符尾部的 `__aligned(N)` 由 parse_declarator 里的 skip_attributes
         * 记进 SAW_ALIGN；抄出来给下面 gen_one_global 分配存储时用。函数声明
         * 分支不用它，随它进函数体前会被下一次 parse 清掉。 */
        DECL_ALIGN_REQ = SAW_ALIGN;
        SAW_ALIGN = 0;
        /* tcc 口径：隐式 int 只对非函数声明告警（见 PA_II_PENDING）。 */
        if (PA_II_PENDING && !d.is_func)
            pa_warn_tcc("type defaults to int");
        PA_II_PENDING = 0;
        /* `name __attribute__((alias("目标")))` / `name __asm__("目标")`：
         * 属性可能写在后缀（参数表 / 数组）之后，所以只能等声明符解析完再看。 */
        al = SAW_ALIAS ? SAW_ALIAS : SAW_ASMNAME;
        SAW_ALIAS = NULL;
        SAW_ASMNAME = NULL;
        /* `int!error x = 1;`：`!error` 只挂在函数声明符上
         * （tests/errors/try.c6 的 test_fallible_not_a_function）。 */
        if (PA_FALLIBLE && !d.is_func) {
            pa_error("'!error' requires a function declarator");
            PA_FALLIBLE = 0;
        }
        if (!d.name) {
            /* `struct S { ... };` / `enum { ... };`：定义本身就是全部内容 */
            if (!pa_accept_ch(';'))
                pa_error("顶层声明缺名字");
            break;
        }
        if (d.is_func) {
            const char *nm = arena_strndup(&A_main, d.name, d.nlen);
            const char *enf = NULL;     /* 落到镜像里的名字（static 带 TU 后缀） */
            int fscope_static = (SCOPE && !SCOPE->up && PA_STATIC);
            int had_proto = 0;

            /* 内核模式：inline 函数本地化（发射名带 TU 后缀）。c6c 不做内联，
             * 会在每个 TU 全量发射 inline 函数体；GCC 的 inline 语义是"每个 TU
             * 一份、不跨 TU 冲突"，而 c6c 以前发成全局符号，导致 `native_save_fl`
             * 等与真实定义 multiple definition。按 static 的路子本地化即可。 */
            /* 带 alias 的名字是外部可见入口（SYSCALL_DEFINE 的 __x64_sys_*
             * = __do_sys_* 的别名，system call table 跨 TU 引用），不能被
             * inline 本地化——否则发成 STB_LOCAL，链接期 undefined。
             * SYSCALL_DEFINEn(n>0) 的 x64/ia32 两个 sys_ 入口是真实函数
             * （首形参 pt_regs 指针），同样必须全局：syscall table 跨 TU 引用。 */
            {
                /* `__x64_sys_*` / `__ia32_sys_*`：第 3 个字符区分 */
                int is_sysentry = (d.nlen > 3 && d.name[0] == '_'
                                   && d.name[1] == '_'
                                   && (d.name[2] == 'x' || d.name[2] == 'i'));

                if (PA_KERNEL_MODE && PA_INLINE_SEEN && SCOPE && !SCOPE->up
                    && !al && !is_sysentry)
                    fscope_static = 1;
            }
            enf = fscope_static ? tu_static_name(nm) : nm;
            s = sym_find(nm, d.nlen);
            if (s && s->is_func && ty_func_nparams(s->type) > 0)
                had_proto = 1;
            /* 同名但首形参不同 = 另一个"方法"（`int abs(int)` 之外又有
             * `Fix abs(Fix *self)`）。当成新符号登记，否则返回类型和元数都
             * 还是那个旧的（std/core/fixed.c6 的 abs / neg 就这样丢了）。 */
            /* 同名但签名不同的，是**另一个**函数（方法重载）：形参个数不同
             * 也算。`plain_area()` 与 `plain_area(struct Box *)`、libc 的
             * `getpid()` 与 `getpid(struct Pid *)` 都是这种，不分开的话第二个
             * 定义会把第一个的符号槽改掉（tests/method.c6 的两组断言）。 */
            if (s && s->is_func
                && (ty_func_nparams(s->type) != ty_func_nparams(ty)
                    || (ty_func_nparams(ty) > 0
                        && ty_func_param(s->type, 0) != ty_func_param(ty, 0))))
                s = NULL;
            {
                const char *tin = NULL;

                if (!s || !s->is_func) {
                    s = sym_add(nm, d.nlen, ty, SC_GLOBAL);
                    s->is_func = 1;
                    /* 文件作用域的 static：只在本 TU 可见（sym_tu_begin 靠这个
                     * 标记摘符号），发射名带 TU 后缀 */
                    if (fscope_static)
                        s->is_static = 1;
                    /* 首形参是指针的普通函数也进方法表：`int port(Tcp *self)`
                     * 这种"显式接收者"风格的方法调用糖要靠它挑对重载。 */
                    if (ty_func_nparams(ty) > 0 && ty_is_ptr(ty_func_param(ty, 0))) {
                        u32 self_ty2 = ty_target(ty_func_param(ty, 0));

                        tin = tmpl_inst_name(self_ty2);
                        if (!tin)
                            tin = sym_tag_name(self_ty2);
                        meth_add(s, self_ty2);
                    }
                    s->val = (i64)x64_sym(&X64, enf);
                    if (fscope_static)
                        X64.sym[(u32)s->val].is_static = 1;
                }
                /* `__attribute__((alias("target")))` / `__asm__("target")`：
                 * 这个名字只是 target 的另一个入口，没有自己的代码/存储。 */
                if (al && s)
                    alias_register(enf, al);
                /* `__attribute__((weak, alias("target")))`（内核 cpu_show_*）：
                 * 这是纯声明（`;` 结尾），走不到函数定义的 SAW_WEAK 应用处。
                 * 在这里把 weak 落到符号，否则发成强定义与真实实现 multiple
                 * definition。 */
                if (SAW_WEAK && s && (u32)s->val < X64.nsym)
                    X64.sym[(u32)s->val].is_weak = 1;
                /* `!error` 是这一条声明上的事实：立刻落到符号上。原型没有
                 * 函数体、走不到 pa_func_def，留着会把标记传给下一条声明
                 * （`tests/errors/drop_bad.c6` 顶上那条 `int!error boom(void);`）。 */
                if (PA_FALLIBLE && s) {
                    s->fallible = 1;
                    PA_FALLIBLE = 0;
                }
                if (pa_is_ch(';')) {
                    pa_advance();
                    break;
                }
                /* `int f(int a), g(int a), x;`：函数声明符后面跟 ','，这一条是
                 * **声明**而不是定义（C99 6.7 的 init-declarator-list）。以前
                 * 这里直接掉进 pa_func_def，于是报"这里要 '{'"。剩下的声明符和
                 * 本条共用同一个基础类型，递归回去接着按声明表处理。 */
                if (pa_is_ch(',')) {
                    pa_advance();
                    gen_decl_from_spec(base);
                    break;
                }
                /* 首形参是"有名字的结构体指针"时，**再补一个**
                 * `<结构体>_<函数名>` 的符号指向同一份代码（模板实例叫
                 * `<实例名>_<函数名>`，比如 `Vect_int_vect_sum`）。C 层面
                 * 方法就是这么命名的，纯 C 的 TU 按那个名字调；c6 这边照旧
                 * 用短名（源码名相当于弱别名）。只改名不行——同一个名字在
                 * 别处还按短名被调用着（`tests/generic.c6`、
                 * `tests/generic_fn.c6`，以及 tests/abi/method.c6 里纯 C
                 * 按原名调 `c6_area` 那种）。 */
                /* 注意这里不能复用上面那个 `tin`：它只在**新建符号**那条
                 * 分支里赋值，而"c6 先声明、纯 C 文件再定义"时符号已经存在
                 * （tests/abi/method.c6 的 `plain_area`），那条分支根本不走。 */
                if (ty_func_nparams(ty) > 0 && ty_is_ptr(ty_func_param(ty, 0))) {
                    u32 st = ty_target(ty_func_param(ty, 0));
                    const char *tn2 = tmpl_inst_name(st);

                    PA_IN_DROP = 0;     /* 每条声明重新判定 */

                    if (!tn2)
                        tn2 = sym_tag_name(st);
                    if (tn2) {
                        char mn[320] = {0};
                        /* 真符号是 `<结构体>_<方法>`（c6 的 C 层面命名），
                         * 源码名当弱别名：纯 C 的 TU 才写得出的那个名字，
                         * 和"同名方法按接收者区分"靠的都是它。 */
                        snprintf(mn, sizeof(mn), "%s_%s", tn2, s->name);
                        /* static 的函数名带 TU 后缀（见 tu_static_name）：
                         * 方法真名也得带，否则两个 TU 各自的同名 static 方法
                         * 会撞到同一个符号上。 */
                        {
                            /* 前向声明那条已经按**短名**建过一条 ELF 符号，
                             * 而且这之前的调用点（`poke(b)` 写在定义之前）已经
                             * 按它发过重定位。这里要换成真名，就得把旧的那条
                             * 也接到同一份代码上，否则那些引用永远悬着——
                             * 链接期报的 `poke$2` 未定义就是这么来的。
                             * 接的动作留到 `alias_apply()`（偏移定下来之后）。 */
                            u32 old_val = (u32)s->val;
                            const char *sn = s->is_static
                                ? tu_static_name(s->name) : s->name;

                            if (s->is_static)
                                s->val = (i64)x64_sym(&X64, emit_name(tu_static_name(mn)));
                            else
                                s->val = (i64)x64_sym(&X64, emit_name(mn));
                            if (s->is_static)
                                X64.sym[(u32)s->val].is_static = 1;
                            /* 只有"旧的那条确实是按短名建出来的"才记账：
                             * 没建过符号时 s->val 也可能是 0，别把 0 号符号
                             * （可能是别的函数）接过去。 */
                            /* 声明那条的发射名是 `tu_static_name(nm)`，**不带**
                             * 模块前缀（`s->val = x64_sym(&X64, enf)` 里那个
                             * enf），所以这里按同一个口径比。 */
                            if (old_val != (u32)s->val && X64.sym[old_val].name
                                && strcmp(X64.sym[old_val].name, sn) == 0)
                                meth_alias_register(old_val, (u32)s->val);
                            /* 方法别名(<Struct>_<fn>)已经分到新符号槽；weak 必须
                             * 同时设到短名符号 old_val 上，否则 __weak 的默认实现
                             * （内核 fork.c 的 arch_release_task_struct）短名那条
                             * 发成 GLOBAL，和 arch/x86 的强定义 multiple definition。 */
                            if (SAW_WEAK && old_val < X64.nsym)
                                X64.sym[old_val].is_weak = 1;
                        }
                        if (s->len == 4 && memcmp(s->name, "drop", 4) == 0
                            && ty_func_nparams(ty) == 1) {
                            if (ty_func_ret(ty) != ty_void())
                                pa_error("'drop' 必须返回 void：它在对象释放时跑，返回值没处去");
                            if (s->fallible)
                                pa_error("'drop' 不能失败（'!error'）：它在释放时跑，错误没处去");
                            if (drop_of(st))
                                pa_error("重复定义了析构函数");
                            if (CUR_ASYNC_DEF || PA_ASYNC)
                                pa_error("'async' 函数不能做方法：'drop'");
                            /* 体还没解析，先把"这是析构函数体"记下来 */
                            PA_IN_DROP = 1;
                            drop_reg(st, (u32)s->val);
                        }
                        if (!fn_overload_taken(s->name, s->len, s->type))
                            s->alias = s->is_static ? tu_static_name(s->name) : s->name;
                    }
                }
            }
            if (d.nlen == 4 && memcmp(d.name, "main", 4) == 0)
                PA_MAIN = s;
            if (SAW_CTOR && NCTOR < 256)
                CTORS[NCTOR++] = (u32)s->val;
            if (SAW_DTOR && NDTOR < 256)
                DTORS[NDTOR++] = (u32)s->val;
            if (SAW_WEAK && (u32)s->val < X64.nsym)
                X64.sym[(u32)s->val].is_weak = 1;
            /* K&R 旧式定义：`int f(a, b) float a; float b; { … }`
             * 参数表里只有名字（类型默认 int），真正的类型写在 `{` 前面的
             * 声明列表里。这里把声明里的类型回填到参数上。 */
            while (d.knr && !pa_is_ch('{') && pa_cur()->kind != TK_EOF) {
                u32 b2 = parse_typespec();

                for (;;) {
                    Declarator dd = {0};
                    u32 t2 = parse_declarator(b2, &dd);
                    int k = 0;

                    if (dd.name) {
                        for (k = 0; k < (int)d.nparams; k++)
                            if (d.plen[k] == dd.nlen && d.pname[k]
                                && memcmp(d.pname[k], dd.name, dd.nlen) == 0) {
                                d.ptype[k] = t2;
                                d.pknr[k] = 1;
                            }
                    }
                    if (!pa_accept_ch(','))
                        break;
                }
                pa_expect_ch(';');
            }
            d.knr_conv = (u8)(d.knr && !had_proto);
            pa_func_def(s, &d);
            /* 旧式（K&R）定义对**调用方**来说没有原型：实参按默认提升传，
             * 被调方入口再转回来。所以函数体生成完再把符号类型换成无原型。 */
            if (d.knr && !had_proto)
                s->type = ty_func(ty_target(ty), NULL, 0, 0);
            break;
        }
        /* `int alias_int __attribute__((alias("g_int")));`：这个名字没有自己
         * 的存储，只是目标的另一个入口（偏移等所有 TU 解析完再接）。 */
        if (al) {
            Sym *va = sym_find(d.name, d.nlen);

            if (!va || va->kind != SC_GLOBAL) {
                va = sym_add(d.name, d.nlen, ty, SC_GLOBAL);
                va->val = (i64)x64_sym(&X64, va->name);
            }
            alias_register(va->name, al);
            if (!pa_accept_ch(','))
                break;
            continue;
        }
        gen_one_global(ty, &d);
        if (!pa_accept_ch(','))
            break;
    }
}

/* 找到自带运行时。部署形态不同，搜索顺序也就不同：
 * 1) $C6C_RT；2) <编译器目录>/lib/rt.c6；3) <编译器目录>/../lib/rt.c6；
 * 4) <编译器目录>/../c6c/lib/rt.c6（源码树里 build/c6c 的位置）；5) ./lib/rt.c6 */
/* 库形态（src/embed.c6）没有 argv[0] 可推，得由宿主程序告诉我们在哪儿：
 * c6_set_runtime_path() 落到这个变量上，搜索顺序里排第一。 */
static const char *PA_RT_OVERRIDE;

static void pa_set_runtime(const char *path) { PA_RT_OVERRIDE = path; }

static const char *find_runtime(const char *argv0)
{
    static const char *cand[] = {"/lib/rt.c6", "/../lib/rt.c6", "/../lib/c6/rt.c6",
                                 "/../c6c/lib/rt.c6", "/../../c6c/lib/rt.c6"};
    char buf[1024] = {0};
    char dir[512] = {0};
    const char *slash = argv0 ? strrchr(argv0, '/') : NULL;
    size_t dn = 0;
    u32 i = 0;

    if (PA_RT_OVERRIDE && src_load(PA_RT_OVERRIDE))
        return arena_strdup(&A_main, PA_RT_OVERRIDE);
    {
        const char *env = getenv("C6C_RT");

        if (env && src_load(env))
            return arena_strdup(&A_main, env);
    }
    if (slash) {
        dn = (size_t)(slash - argv0);
        if (dn < sizeof(dir)) {
            memcpy(dir, argv0, dn);
            dir[dn] = 0;
            for (i = 0; i < 5; i++) {
                snprintf(buf, sizeof(buf), "%s%s", dir, cand[i]);
                if (src_load(buf))
                    return arena_strdup(&A_main, buf);
            }
        }
    }
    if (src_load("lib/rt.c6"))
        return "lib/rt.c6";
    return NULL;
}

/* 三个交接量本身也是数据段里的全局量：**永远**定义（哪怕这次编译没有
 * 任何 `__thread`），因为 lib/rt.c6 无条件引用它们。偏移 0 留空——符号表里
 * goff==0 的意思是"还没有存储"，占着它会让 rt.c6 里的 `extern` 声明再开一份。 */
static void tls_globals_init(void)
{
    (void)data_alloc(8, 8);
    SYM_TLS_IMG = sym_add("__c6_tls_img", 12, ty_ptr(ty_void()), SC_GLOBAL);
    SYM_TLS_IMG->goff = data_alloc(8, 8);
    SYM_TLS_IMG->val = (i64)x64_data_sym(&X64, "__c6_tls_img", ELF_HDR + SYM_TLS_IMG->goff);
    SYM_TLS_LEN = sym_add("__c6_tls_len", 12, ty_ulong(), SC_GLOBAL);
    SYM_TLS_LEN->goff = data_alloc(8, 8);
    SYM_TLS_LEN->val = (i64)x64_data_sym(&X64, "__c6_tls_len", ELF_HDR + SYM_TLS_LEN->goff);
    SYM_TLS_DELTA = sym_add("__c6_tls_delta", 14, ty_ulong(), SC_GLOBAL);
    SYM_TLS_DELTA->goff = data_alloc(8, 8);
    SYM_TLS_DELTA->val = (i64)x64_data_sym(&X64, "__c6_tls_delta",
                                           ELF_HDR + SYM_TLS_DELTA->goff);
}

/* 解析完再回填：影像范围只有全部声明过完才知道。 */
static void tls_finish(void)
{
    u32 i = 0;

    /* `extern __thread` 的引用：偏移现在定得下来了（所有 TU 都解析完），
     * 写进各自的数据槽。没人定义就按"未定义的符号"报——和链接期同一口径，
     * 而且这时候还没写产物。 */
    for (i = 0; i < NTLS_REF; i++) {
        Sym *r = TLS_REF[i];
        Sym *d = sym_find_def(r->name, r->len);

        if (d && d->is_tls && d->goff)
            glob_store(r->tls_slot, 0, ty_ulong(), (u64)d->goff);
        else {
            fprintf(stderr, "c6c: 未定义的符号 '%s'\n", r->name);
            PA_LINK_UNDEF = 1;
        }
    }
    if (NTLS == 0) {
        glob_store(SYM_TLS_IMG->goff, 0, ty_ptr(ty_void()), 0);
        glob_store(SYM_TLS_LEN->goff, 0, ty_ulong(), 0);
        glob_store(SYM_TLS_DELTA->goff, 0, ty_ulong(), 0);
        return;
    }
    glob_store(SYM_TLS_IMG->goff, 0, ty_ptr(ty_void()), (u64)DATA_VA(TLS_LO));
    glob_store(SYM_TLS_LEN->goff, 0, ty_ulong(), (u64)(TLS_HI - TLS_LO));
    glob_store(SYM_TLS_DELTA->goff, 0, ty_ulong(), (u64)TLS_LO);
}

/* vreg/label 是 16 位的（见 src/ir.c6 的说明）：用超了以前是静默绕回、算错结果，
 * 现在由 ir.c6 回调到这里报一条明确的编译错误。 */
static void ir_overflow_error(void)
{
    pa_error("函数太大：虚拟寄存器/标号超过 16 位上限（65535）");
}

/* ---- 一次编译的公共前半段 ----
 *
 * 多 TU 和单 TU 都从这里起步：清全局状态、开输出后端。**不解析任何 TU**，
 * 也不碰预处理栈——那是调用方的事（单 TU 时源文件已经在栈里了；多 TU 时
 * 每个 TU 由 main.c6 压、由 pa_parse_new_tu() 解析）。 */
static int pa_setup(const char *out)
{
    sym_init();
    tt_init();
    tykw_init();
    ir_set_overflow_hook(ir_overflow_error);
    memset(&FN, 0, sizeof(FN));
    memset(&X64, 0, sizeof(X64));
    img_init(&CODE_IMG, 8192);
    X64.im = &CODE_IMG;
    TLS_LO = 0;
    TLS_HI = 0;
    NTLS = 0;
    NTLS_REF = 0;
    PA_TLS = 0;
    PA_TU = 0;
    tls_globals_init();
    NLOOP = 0;
    PA_MAIN = NULL;
    scope_enter();
    PP_SKIP_NL = 1;
    if (c99_mode()) {
        C99_OUT = fopen(out, "w");

        if (!C99_OUT) {
            fprintf(stderr, "c6c: 写不了 %s\n", out);
            return 1;
        }
        /* 函数体先写进临时文件：前向声明要排在所有函数体前面，而函数体是
         * 流式发出去的，没法回头补。 */
        snprintf(C99_TMP, sizeof(C99_TMP), "%s.fn", out);
        C99_FNOUT = fopen(C99_TMP, "w");
        if (!C99_FNOUT) {
            fprintf(stderr, "c6c: 写不了 %s\n", C99_TMP);
            return 1;
        }
    }
    if (llvm_mode() && !llvm_open(out))
        return 1;
    return 0;
}

/* 自带运行时压进预处理栈（找不着就报错）。压完由调用方决定它属于哪个 TU：
 * 单 TU 时它接在调用方的文件后面（同一个 TU），多 TU 时它就是 TU 0。 */
static int pa_push_rt(const char *argv0)
{
    const char *rt = find_runtime(argv0);

    if (!rt) {
        fprintf(stderr, "c6c: 找不到自带运行时 lib/rt.c6（可用 $C6C_RT 指定，"
                        "或用 -nostdlib 关掉）\n");
        return 1;
    }
    {
        SrcFile *rf = src_load(rt);

        if (rf) {
            /* 记下来：c6 判定要能认出它、并且不因为它就把整个 TU 认成 c6
             * （见 C6_RT_FILE 的说明）。 */
            C6_RT_FILE = rf->id;
            pp_push_file(rf, -1);
        }
    }
    return 0;
}

/* ---- 多 TU 驱动 ----
 *
 * 单文件调用和以前完全一样（一个 TU，自带运行时接在同一个 TU 里）；
 * 命令行上有多个源文件时才逐个走 pa_parse_new_tu()。 */
static void pa_parse_new_tu(void)
{
    PA_TU++;
    /* 前一个 TU 的文件作用域 static 到此为止（符号表 + TU 后缀，见 sym.c6） */
    sym_tu_begin(PA_TU);
    /* 预处理器栈是调用方刚 reset 干净的，解析窗口里却还可能留着上一个 TU
     * 尾巴上的 token（含 EOF）：不清掉的话新 TU 一进来就看见 EOF，整个 TU
     * 静默空跑。 */
    pa_win_clear();
    NSRC = 0;
    PA_HEAD = 0;
    pa_parse_tu();
}

/* 多 TU 的起手：初始化 + 自带运行时作为 TU 0 单独解析。
 * 返回 0 表示可以开始逐个 pa_parse_new_tu()。 */
static int pa_begin_multi(const char *out, const char *argv0, int with_rt)
{
    if (pa_setup(out))
        return 1;
    if (with_rt) {
        pp_reset();
        if (pa_push_rt(argv0))
            return 1;
        pa_parse_new_tu();
    }
    return 0;
}

/* `__attribute__((alias("目标")))` / `__asm__("目标")` 的收尾：所有 TU 都
 * 解析完了、目标的偏移定下来了，把别名接到同一个 off/va 上。
 * 目标没定义就按链接期的口径报（上游那条用例的注释也写着"不在同一个单元里
 * 定义就不该编过"）。 */
static void alias_apply(void)
{
    u32 i = 0;

    for (i = 0; i < NALIAS; i++) {
        u32 from = x64_sym(&X64, ALIAS_FROM[i]);
        u32 to = x64_sym(&X64, emit_name(ALIAS_TO[i]));

        if (!X64.sym[to].defined) {
            fprintf(stderr, "c6c: 未定义的符号 '%s'\n", ALIAS_TO[i]);
            PA_LINK_UNDEF = 1;
            continue;
        }
        x64_alias_idx(&X64, from, to);
    }
    /* 方法式函数的前向声明：短名那条接到真名上。只声明没定义的不算错
     * （真名本来就没定义，短名也没人引用），静悄悄跳过。 */
    for (i = 0; i < NMETH_ALIAS; i++) {
        u32 from = METH_ALIAS_FROM[i];
        u32 to = METH_ALIAS_TO[i];

        if (X64.sym[to].defined && !X64.sym[from].defined)
            x64_alias_idx(&X64, from, to);
    }
}

static int pa_finish(const char *out);

static int pa_compile_ex(const char *out, const char *argv0, int with_rt)
{
    int rc = 0;
    u32 code_len = 0;       /* 报"字节数"用的是纯代码长度（不含回填期补的跳板） */
    int setup_rc = 0;

    setup_rc = pa_setup(out);
    if (setup_rc)
        return setup_rc;
    if (with_rt && pa_push_rt(argv0))
        return 1;
    pa_parse_tu();
    return pa_finish(out);
}

/* 收尾：所有 TU 都解析完了才走到这里 —— TLS 回填、引用环检查、合成测试入口、
 * 缺 main 的检查，最后出码（native / C99 / LLVM IR 三选一）。 */
static int pa_finish(const char *out)
{
    int rc = 0;
    u32 code_len = 0;       /* 报"字节数"用的是纯代码长度（不含回填期补的跳板） */

    alias_apply();              /* 别名属性：目标偏移现在定下来了 */
    tls_finish();
    gc_cycle_check();
    synth_test_main();          /* 全局作用域还在，才能找到 printf */
    scope_leave();
    if (PA_ERRS || DG.errors) {
        char msg[128] = {0};

        snprintf(msg, sizeof(msg), "c6c: %u 个错误，不写输出", PA_ERRS + (u32)DG.errors);
        diag_emit(msg);
        return 1;
    }
    if (PA_LINK_UNDEF && !PA_RELOC) {
        /* `extern __thread` 到最后没人定义：tls_finish 已经按链接期的口径
         * 报过名字了，这里只负责别写出一个读 0 的产物。
         * -c 例外：可重定位文件里"未定义"是正常状态，由链接器去别处找。 */
        diag_emit("c6c: 有未定义的外部符号，不写输出");
        return 1;
    }
    if (!PA_MAIN && !PA_SYNTAX_ONLY && !PA_RELOC && !llvm_mode()) {
        diag_emit("c6c: 没有 main（可执行文件需要入口）");
        return 1;
    }
    if (PA_SYNTAX_ONLY)
        return 0;               /* -fsyntax-only：前端跑完就算过 */
    if (c99_mode()) {
        FILE *cf = C99_OUT;
        char mn[256] = {0};
        u32 i = 0;

        if (!cf) {
            fprintf(stderr, "c6c: 写不了 %s\n", out);
            return 1;
        }
        c99_prologue(DATA_IMG.n);
        /* 先补所有函数的前向声明（函数体是流式发的，调用点可能在前） */
        for (i = 0; i < C99_NFN; i++) {
            u32 k2 = 0;

            fprintf(cf, "uint64_t %s(", C99_FNNAME[i]);
            if (c99_wasm_mode() && !c99_real_variadic(C99_FNNAME[i])) {
                /* wasm call_indirect 要求签名严格一致：非真变参函数一律
                 * 声明成 8 定参（和 c99.c6 里的调用点 cast 对齐）。 */
                for (k2 = 0; k2 < C99_WASM_NARGS; k2++)
                    fprintf(cf, "%suint64_t", k2 ? ", " : "");
                fprintf(cf, ");\n");
                continue;
            }
            for (k2 = 0; k2 < C99_FNNP[i]; k2++)
                fprintf(cf, "%suint64_t", k2 ? ", " : "");
            if (C99_FNNP[i] == 0)
                fprintf(cf, "uint64_t");
            fprintf(cf, ", ...);\n");
        }
        fprintf(cf, "\n");
        {
            char buf[65536] = {0};
            FILE *in = NULL;
            size_t got = 0;

            fclose(C99_FNOUT);
            C99_FNOUT = NULL;
            in = fopen(C99_TMP, "r");
            if (in) {
                while ((got = fread(buf, 1, sizeof(buf), in)) > 0)
                    fwrite(buf, 1, got, cf);
                fclose(in);
            }
            remove(C99_TMP);
        }
        c99_emit_data();
        c99_sym((u32)PA_MAIN->val, mn, sizeof(mn));
        fprintf(cf, "int main(int argc, char **argv)\n{\n  uint64_t r = 0;\n  c6c_init_data();\n");
        for (i = 0; i < NCTOR; i++) {
            char cn[256] = {0};

            c99_sym(CTORS[i], cn, sizeof(cn));
            fprintf(cf, "  ((uint64_t(*)(void))%s)();\n", cn);
        }
        fprintf(cf, "  {\n    r = ((uint64_t(*)(uint64_t, uint64_t))%s)"
                    "((uint64_t)argc, (uint64_t)(uintptr_t)argv);\n", mn);
        for (i = 0; i < NDTOR; i++) {
            char dn[256] = {0};

            c99_sym(DTORS[i], dn, sizeof(dn));
            fprintf(cf, "    (void)r;\n  }\n  ((uint64_t(*)(void))%s)();\n", dn);
        }
        if (NDTOR == 0)
            fprintf(cf, "    (void)r;\n  }\n");
        fprintf(cf, "  return (int)r;\n}\n");
        fclose(cf);
        printf("c6c: %s（C99 后端，%u 个符号）\n", out, X64.nsym);
        return 0;
    }
    if (llvm_mode())
        return llvm_finish(out);
    if (aso_on()) {                 /* -S：写汇编文本，不写 ELF */
        if (aout_on()) {
            aout_write(out);
            return aout_had_error() ? 1 : 0;
        }
        aso_write(out);
        return aso_had_error() ? 1 : 0;
    }
    {
        /* 布局：[ELF 头 120][数据段][代码]。
         * 代码发在 CODE_IMG 里，**就地**回填、就地写出——不再把它和数据段
         * memcpy 进一份新的连续镜像：那份镜像自编译时 10.6 MB，纯属中间产物，
         * 峰值 RSS 里有一整个它（外加 1.5 倍增长时的 5 MB 余量）。
         * 补丁偏移仍留在 CODE_IMG 坐标里，相对位移的基准交给 X64.im_base。 */
        u32 code_off = 0;
        u32 entry_off = 0;
        u32 main_sym = 0;
        u32 i = 0;

        /* -c：出 ET_REL。没有入口、不拍绝对地址——_start 也不该有（一个 .o
         * 里塞个 _start，多 TU 一链就重定义）。这里只把编译器自带跳板补进
         * 代码段，剩下的交给 obj.c6 落重定位。 */
        if (PA_RELOC) {
            X64_OBJ = 1;
            X64.im_base = 0;
            /* 两遍发射：IR 已全缓存，现在按可达集写出 live 函数（死函数
             * 不生成字节），再补跳板、出 .o。非该模式时 NDEF=0，直接返回。 */
            pa_emit_deferred();
            /* 两遍发射才产生的别名（如系统调用 __x64_sys_* 的方法别名
             * pt_regs___x64_sys_*、static_call trampoline）目标函数此时才
             * defined，pa_finish 开头那次 alias_apply 跑得早、跳过了它们。
             * x64_alias_idx 是幂等赋值，再跑一次把短名接上。 */
            if (pa_defer_enabled()) {
                alias_apply();
                /* 别名符号（__x64_sys_* 等）在源码里是全局的，但 x64_alias_idx
                 * 把目标的 is_static 拷过来——目标 do_sys_* 是 static（方法别名
                 * 本地化），于是全局别名也成了 STB_LOCAL，跨 TU 看不到。
                 * 两遍发射下把源码别名恢复成全局。 */
                for (i = 0; i < NALIAS; i++) {
                    u32 as = x64_sym(&X64, ALIAS_FROM[i]);

                    if (as < X64.nsym && X64.sym[as].defined)
                        X64.sym[as].is_static = 0;
                }
            }
            x64_resolve(&X64);
            code_len = CODE_IMG.n;
            obj_write(out);
            return rc;
        }

        main_sym = (u32)PA_MAIN->val;
        entry_off = CODE_IMG.n;
        x64_emit_start(&X64, main_sym, CTORS, NCTOR, DTORS, NDTOR);

        /* 顺序要卡准：先算出代码段偏移 → 平移符号 VA → 回填数据段里的
         * 地址常量 → 最后才回填代码（否则补丁白打）。 */
        code_off = ELF_HDR + DATA_IMG.n;
        x64_finish_label_addrs(&X64, (u64)ELF_BASE_VA + (u64)code_off);
        for (i = 0; i < NCLBL; i++) {
            u64 va = (u64)ELF_BASE_VA + (u64)code_off
                     + (u64)x64_lbl_off(&X64, CLBL_FN[i], CLBL_LBL[i]);
            u32 k = 0;

            for (k = 0; k < 8; k++)
                DATA_IMG.p[CLBL_OFF[i] + k] = (u8)(va >> (8 * k));
        }
        for (i = 0; i < X64.nsym; i++) {
            if (X64.sym[i].defined && !X64.sym[i].is_data)
                X64.sym[i].off += code_off;
            if (X64.sym[i].defined)
                X64.sym[i].va = ELF_BASE_VA + X64.sym[i].off;   /* VA 跟着偏移走 */
        }
        data_fixups_apply();
        /* asmblob 跳板是回填阶段才追加到代码尾的（自编译时 144 字节）。
         * 先留死 64 KB 余量，免得 1.5 倍增长为这 144 字节多清 1.4 MB 的页。 */
        img_slack(&CODE_IMG, 64u * 1024u);
        code_len = CODE_IMG.n;      /* 报告的是"源码编出来的代码"，不含跳板 */
        X64.im_base = code_off;
        x64_resolve(&X64);
        x64_report_undef();
        {
            /* 头单独放栈上：120 字节 vs 10 MB，这就是整个改动的意思 */
            u8 hdr[ELF_HDR] = {0};

            elf_write_parts(out, hdr, &DATA_IMG, &CODE_IMG, entry_off + code_off);
        }
    }
    if (!PA_QUIET_OUT)
        printf("c6c: %s（%u 字节，%u 个符号）\n", out, code_len, X64.nsym);
    return rc;
}

static int pa_compile(const char *out)
{
    return pa_compile_ex(out, NULL, 0);
}
