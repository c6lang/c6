/* std/encoding/aead：AEAD 封装——AES-128-GCM、AES-256-GCM、ChaCha20-Poly1305。
 *
 *     import std.encoding.aead;
 *
 *     Aead a = { 0 };
 *     a.init(AEAD_AES_128_GCM, key, 16);
 *     u8 out[512] = { 0 };
 *     int n = a.seal(nonce, aad, aad_len, pt, pt_len, out, sizeof out);
 *     // out = 密文 || 16 字节 tag
 *     int m = a.open(nonce, aad, aad_len, out, n, back, sizeof back);
 *
 * TLS 1.3 和 QUIC 都只用到这三种，且 nonce 都是 12 字节、tag 都是 16 字节，所以
 * 接口给的是「12 字节 nonce + 16 字节 tag」，要别的长度请自己拼（GCM 的
 * nonce 长度其实可以变，但那需要单独算 J0，这里不做）。
 *
 * 结构上 `seal`/`open` 是同一个缓冲区都行的（原地加密和解密），因为 AES-CTR 和
 * ChaCha20 都是逐字节异或，GCM/GHASH 只在写完密文之后才读它。
 *
 * 除了 `Aead` 这个门面，还导出两个底层件，QUIC 的包头保护（std.net.quichp）
 * 要直接用：
 *
 * - `aead_gcm_ghash`：GHASH（GF(2^128) 乘法，逐位实现，不建表）；
 * - `aead_gcm_tag`：算 GCM tag（AAD + 密文），不自带 CTR。
 *
 * 常数时间比较 `aead_tag_equal` 也别自己写——tag 比较一旦提前 return 就是
 * padding oracle 的入口。
 */
#include <string.h>

module std.encoding.aead;
import std.core.types;
import std.encoding.aes;
import std.encoding.chacha20;
import std.encoding.poly1305;

enum Error { OK = 0, INVAL = 1, TAG = 2, RANGE = 3 };

#define AEAD_AES_128_GCM        1
#define AEAD_AES_256_GCM        2
#define AEAD_CHACHA20_POLY1305  3

#define AEAD_NONCE_LEN 12
#define AEAD_TAG_LEN   16

struct Aead {
    int kind;
    int key_len;
    int valid;
    u8 key[32];
    Aes aes;
};

int aead_key_len_for(int kind)
{
    switch (kind) {
    case AEAD_AES_128_GCM: return 16;
    case AEAD_AES_256_GCM: return 32;
    case AEAD_CHACHA20_POLY1305: return 32;
    default: return 0;
    }
}

const char *aead_kind_name(int kind)
{
    switch (kind) {
    case AEAD_AES_128_GCM: return "AES-128-GCM";
    case AEAD_AES_256_GCM: return "AES-256-GCM";
    case AEAD_CHACHA20_POLY1305: return "CHACHA20-POLY1305";
    default: return "unknown";
    }
}

int kind_of(Aead *self) { return self && self->valid ? self->kind : 0; }
int ok(Aead *self) { return self && self->valid; }
int nonce_len(Aead *self) { (void)self; return AEAD_NONCE_LEN; }
int tag_len(Aead *self) { (void)self; return AEAD_TAG_LEN; }

/* 初始化；key 长度必须和算法对上（16/32），否则 valid 保持 0。 */
void init(Aead *self, int kind, const void *key, int key_len)
{
    int want = 0;

    if (!self)
        return;
    memset(self, 0, sizeof *self);
    want = aead_key_len_for(kind);
    if (!key || want == 0 || key_len != want)
        return;
    self->kind = kind;
    self->key_len = key_len;
    memcpy(self->key, key, (size_t)key_len);
    if (kind != AEAD_CHACHA20_POLY1305)
        self->aes = aes_key(key, (usize)key_len);
    self->valid = 1;
}

/* ---- GHASH（GF(2^128)，按 RFC 摘要里的「右移 + 0xe1」算法） ---- */

/* x = x * h，两操作数都是 16 字节（大端位序，bit0 是最高字节的最高位） */
static void gf_mul(u8 *x, const u8 *h)
{
    u8 z[16] = { 0 };
    u8 v[16] = { 0 };
    int i = 0;
    int j = 0;

    memcpy(v, h, sizeof v);
    for (i = 0; i < 128; i++) {
        if (x[i >> 3] & (0x80 >> (i & 7))) {
            for (j = 0; j < 16; j++)
                z[j] ^= v[j];
        }
        {
            int lsb = v[15] & 1;

            for (j = 15; j > 0; j--)
                v[j] = (u8)((v[j] >> 1) | ((v[j - 1] & 1) << 7));
            v[0] >>= 1;
            if (lsb)
                v[0] ^= 0xe1;
        }
    }
    memcpy(x, z, sizeof z);
}

static void ghash_block(u8 *y, const u8 *h, const u8 *blk)
{
    int i = 0;

    for (i = 0; i < 16; i++)
        y[i] ^= blk[i];
    gf_mul(y, h);
}

static void put_be64(u8 *p, u64 v)
{
    int i = 0;

    for (i = 0; i < 8; i++)
        p[i] = (u8)(v >> (56 - 8 * i));
}

/* S = GHASH(AAD, 密文)：1 成功 / -1 参数错。out16 可以指向临时缓冲。 */
int aead_gcm_ghash(const void *h16, const void *aad, int alen,
                   const void *ct, int clen, void *out16)
{
    const u8 *h = (const u8 *)h16;
    const u8 *a = (const u8 *)aad;
    const u8 *c = (const u8 *)ct;
    u8 y[16] = { 0 };
    u8 len[16] = { 0 };
    int i = 0;

    if (!h || !out16 || alen < 0 || clen < 0)
        return -1;
    if ((alen > 0 && !a) || (clen > 0 && !c))
        return -1;
    for (i = 0; i + 16 <= alen; i += 16)
        ghash_block(y, h, a + i);
    if (alen & 15) {
        u8 blk[16] = { 0 };

        memcpy(blk, a + i, (size_t)(alen & 15));
        ghash_block(y, h, blk);
    }
    for (i = 0; i + 16 <= clen; i += 16)
        ghash_block(y, h, c + i);
    if (clen & 15) {
        u8 blk[16] = { 0 };

        memcpy(blk, c + i, (size_t)(clen & 15));
        ghash_block(y, h, blk);
    }
    put_be64(len, (u64)alen * 8);
    put_be64(len + 8, (u64)clen * 8);
    ghash_block(y, h, len);
    memcpy(out16, y, sizeof y);
    return 0;
}

/* tag = E_K(J0) xor GHASH(...)；h16 = E_K(0^128)，j0 = nonce||0x00000001 */
int aead_gcm_tag(Aes *aes, const void *h16, const void *j0_16, const void *aad,
                 int alen, const void *ct, int clen, void *tag16)
{
    u8 s[16] = { 0 };
    u8 ek[16] = { 0 };
    int i = 0;

    if (!aes || !h16 || !j0_16 || !tag16)
        return -1;
    if (aead_gcm_ghash(h16, aad, alen, ct, clen, s) < 0)
        return -1;
    aes->encrypt_block((const u8 *)j0_16, ek);
    for (i = 0; i < 16; i++)
        ((u8 *)tag16)[i] = (u8)(s[i] ^ ek[i]);
    return 0;
}

/* 常数时间比较（长度固定 16）；相等 1、不等 0。 */
int aead_tag_equal(const void *a, const void *b, int n)
{
    const u8 *x = (const u8 *)a;
    const u8 *y = (const u8 *)b;
    u8 d = 0;
    int i = 0;

    if (!a || !b || n <= 0)
        return 0;
    for (i = 0; i < n; i++)
        d |= (u8)(x[i] ^ y[i]);
    return d == 0;
}

/* ---- GCM 内部：J0 与数据段的计数器 ---- */

static void gcm_j0(const u8 *nonce, u8 *j0)
{
    memcpy(j0, nonce, 12);
    j0[12] = 0;
    j0[13] = 0;
    j0[14] = 0;
    j0[15] = 1;
}

static void gcm_ctr0(const u8 *nonce, u8 *iv)
{
    memcpy(iv, nonce, 12);
    iv[12] = 0;
    iv[13] = 0;
    iv[14] = 0;
    iv[15] = 2;
}

static int gcm_crypt(Aead *self, const u8 *nonce, const void *in, int n,
                     void *out)
{
    u8 iv[16] = { 0 };

    if (n == 0)
        return 0;
    gcm_ctr0(nonce, iv);
    return self->aes.ctr_xor(iv, in, (usize)n, (u8 *)out);
}

static int gcm_seal(Aead *self, const void *nonce, const void *aad, int alen,
                    const void *pt, int n, void *out, int cap)
{
    u8 h[16] = { 0 };
    u8 zero[16] = { 0 };
    u8 j0[16] = { 0 };
    u8 *dst = (u8 *)out;

    if (cap < n + AEAD_TAG_LEN)
        return -1;
    self->aes.encrypt_block(zero, h);
    gcm_j0((const u8 *)nonce, j0);
    if (gcm_crypt(self, (const u8 *)nonce, pt, n, dst) < 0)
        return -1;
    if (aead_gcm_tag(&self->aes, h, j0, aad, alen, dst, n,
                     dst + n) < 0)
        return -1;
    return n + AEAD_TAG_LEN;
}

static int gcm_open(Aead *self, const void *nonce, const void *aad, int alen,
                    const void *ct, int n, void *out, int cap)
{
    u8 h[16] = { 0 };
    u8 zero[16] = { 0 };
    u8 j0[16] = { 0 };
    u8 tag[16] = { 0 };
    const u8 *src = (const u8 *)ct;
    int clen = n - AEAD_TAG_LEN;

    if (n < AEAD_TAG_LEN || cap < clen)
        return -1;
    self->aes.encrypt_block(zero, h);
    gcm_j0((const u8 *)nonce, j0);
    if (aead_gcm_tag(&self->aes, h, j0, aad, alen, src, clen, tag) < 0)
        return -1;
    if (!aead_tag_equal(tag, src + clen, AEAD_TAG_LEN))
        return -2;              /* tag 不对：此时还没写出任何明文 */
    if (gcm_crypt(self, (const u8 *)nonce, src, clen, out) < 0)
        return -1;
    return clen;
}

/* ---- ChaCha20-Poly1305（RFC 8439 §2.8） ---- */

static void poly_pad(Poly1305 *st, int n)
{
    static const u8 zero[16] = { 0 };
    int r = n & 15;

    if (r > 0)
        st->update(zero, (usize)(16 - r));
}

static void put_le64(u8 *p, u64 v)
{
    int i = 0;

    for (i = 0; i < 8; i++)
        p[i] = (u8)(v >> (8 * i));
}

static int chacha_seal(Aead *self, const void *nonce, const void *aad,
                       int alen, const void *pt, int n, void *out, int cap)
{
    u8 blk[64] = { 0 };
    u8 lenblk[16] = { 0 };
    Poly1305 st = { { 0 }, { 0 }, { 0 }, { 0 }, 0, 0 };
    u8 *dst = (u8 *)out;

    if (cap < n + AEAD_TAG_LEN)
        return -1;
    if (chacha20_block(self->key, nonce, 0, blk) < 0)
        return -1;
    if (chacha20_xor(self->key, nonce, 1, pt, (usize)n, dst) < 0)
        return -1;
    st = poly1305_init(blk);
    if (!st.ok())
        return -1;
    if (alen > 0)
        st.update(aad, (usize)alen);
    poly_pad(&st, alen);
    if (n > 0)
        st.update(dst, (usize)n);
    poly_pad(&st, n);
    put_le64(lenblk, (u64)alen);
    put_le64(lenblk + 8, (u64)n);
    st.update(lenblk, sizeof lenblk);
    st.final(dst + n);
    return n + AEAD_TAG_LEN;
}

static int chacha_open(Aead *self, const void *nonce, const void *aad,
                       int alen, const void *ct, int n, void *out, int cap)
{
    u8 blk[64] = { 0 };
    u8 lenblk[16] = { 0 };
    u8 tag[16] = { 0 };
    Poly1305 st = { { 0 }, { 0 }, { 0 }, { 0 }, 0, 0 };
    const u8 *src = (const u8 *)ct;
    int clen = n - AEAD_TAG_LEN;

    if (n < AEAD_TAG_LEN || cap < clen)
        return -1;
    if (chacha20_block(self->key, nonce, 0, blk) < 0)
        return -1;
    st = poly1305_init(blk);
    if (!st.ok())
        return -1;
    if (alen > 0)
        st.update(aad, (usize)alen);
    poly_pad(&st, alen);
    if (clen > 0)
        st.update(src, (usize)clen);
    poly_pad(&st, clen);
    put_le64(lenblk, (u64)alen);
    put_le64(lenblk + 8, (u64)clen);
    st.update(lenblk, sizeof lenblk);
    st.final(tag);
    if (!aead_tag_equal(tag, src + clen, AEAD_TAG_LEN))
        return -2;
    if (chacha20_xor(self->key, nonce, 1, src, (usize)clen, out) < 0)
        return -1;
    return clen;
}

/* ---- 门面 ---- */

/* 加密 + 认证：out = 密文 || tag，返回总长度；参数错 -1。 */
int seal(Aead *self, const void *nonce, const void *aad, int alen,
         const void *pt, int n, void *out, int cap)
{
    if (!self || !self->valid || !nonce || !out || n < 0 || alen < 0
        || (n > 0 && !pt))
        return -1;
    if (self->kind == AEAD_CHACHA20_POLY1305)
        return chacha_seal(self, nonce, aad, alen, pt, n, out, cap);
    return gcm_seal(self, nonce, aad, alen, pt, n, out, cap);
}

/* 解密 + 验签：in = 密文 || tag，返回明文长度；tag 不对 -2（不写明文）。 */
int open(Aead *self, const void *nonce, const void *aad, int alen,
         const void *ct, int n, void *out, int cap)
{
    if (!self || !self->valid || !nonce || !ct || !out || n < 0 || alen < 0)
        return -1;
    if (self->kind == AEAD_CHACHA20_POLY1305)
        return chacha_open(self, nonce, aad, alen, ct, n, out, cap);
    return gcm_open(self, nonce, aad, alen, ct, n, out, cap);
}

/* ---- 自测 ---- */

static int hex_eq(const u8 *d, int n, const char *want)
{
    int i = 0;

    for (i = 0; i < n; i++) {
        int hi = want[i * 2];
        int lo = want[i * 2 + 1];
        int v = 0;

        if (hi >= '0' && hi <= '9')
            v = (hi - '0') << 4;
        else if (hi >= 'a' && hi <= 'f')
            v = (hi - 'a' + 10) << 4;
        else
            return 0;
        if (lo >= '0' && lo <= '9')
            v |= lo - '0';
        else if (lo >= 'a' && lo <= 'f')
            v |= lo - 'a' + 10;
        else
            return 0;
        if (d[i] != (u8)v)
            return 0;
    }
    return 1;
}

test "AEAD：AES-128/256-GCM（NIST 向量）" {
    u8 key[32] = { 0 };
    u8 nonce[12] = { 0 };
    u8 out[128] = { 0 };
    Aead a = { 0 };

    a.init(AEAD_AES_128_GCM, key, 16);
    if (!a.ok() || a.kind_of() != AEAD_AES_128_GCM
        || strcmp(aead_kind_name(a.kind_of()), "AES-128-GCM") != 0)
        return err(1, "AES-128-GCM 初始化失败");
    if (a.nonce_len() != 12 || a.tag_len() != 16)
        return err(2, "nonce/tag 长度应是 12/16");
    /* 空明文 + 空 AAD：只剩 tag */
    if (a.seal(nonce, 0, 0, 0, 0, out, (int)sizeof out) != 16)
        return err(3, "空明文的 seal 应给 16 字节");
    if (!hex_eq(out, 16, "58e2fccefa7e3061367f1d57a4e7455a"))
        return err(4, "空明文的 tag 不对");
    /* 16 字节零明文 */
    {
        u8 pt[16] = { 0 };

        if (a.seal(nonce, 0, 0, pt, 16, out, (int)sizeof out) != 32)
            return err(5, "16 字节明文的 seal 应给 32 字节");
        if (!hex_eq(out, 16, "0388dace60b6a392f328c2b971b2fe78"))
            return err(6, "16 字节零明文的密文不对");
        if (!hex_eq(out + 16, 16, "ab6e47d42cec13bdf53a67b21257bddf"))
            return err(7, "16 字节零明文的 tag 不对");
        /* 往返 + 原地解密 */
        if (a.open(nonce, 0, 0, out, 32, out, (int)sizeof out) != 16
            || memcmp(out, pt, 16) != 0)
            return err(8, "16 字节零明文的往返不对");
    }
    /* tag 被改一个字节必须失败 */
    {
        u8 pt[16] = { 0 };
        u8 back[32] = { 0 };

        a.seal(nonce, 0, 0, pt, 16, out, (int)sizeof out);
        out[20] ^= 1;
        if (a.open(nonce, 0, 0, out, 32, back, (int)sizeof back) != -2)
            return err(9, "篡改 tag 应失败");
        out[20] ^= 1;
        if (a.open(nonce, 0, 0, out, 32, back, (int)sizeof back) != 16)
            return err(10, "恢复 tag 后应能解开");
    }
    /* AES-256-GCM：NIST test case 16 */
    {
        static const u8 k2[32] = {
            0xfe, 0xff, 0xe9, 0x92, 0x86, 0x65, 0x73, 0x1c,
            0x6d, 0x6a, 0x8f, 0x94, 0x67, 0x30, 0x83, 0x08,
            0xfe, 0xff, 0xe9, 0x92, 0x86, 0x65, 0x73, 0x1c,
            0x6d, 0x6a, 0x8f, 0x94, 0x67, 0x30, 0x83, 0x08
        };
        static const u8 iv[12] = {
            0xca, 0xfe, 0xba, 0xbe, 0xfa, 0xce, 0xdb, 0xad,
            0xde, 0xca, 0xf8, 0x88
        };
        static const u8 aad[20] = {
            0xfe, 0xed, 0xfa, 0xce, 0xde, 0xad, 0xbe, 0xef,
            0xfe, 0xed, 0xfa, 0xce, 0xde, 0xad, 0xbe, 0xef,
            0xab, 0xad, 0xda, 0xd2
        };
        static const u8 pt[60] = {
            0xd9, 0x31, 0x32, 0x25, 0xf8, 0x84, 0x06, 0xe5,
            0xa5, 0x59, 0x09, 0xc5, 0xaf, 0xf5, 0x26, 0x9a,
            0x86, 0xa7, 0xa9, 0x53, 0x15, 0x34, 0xf7, 0xda,
            0x2e, 0x4c, 0x30, 0x3d, 0x8a, 0x31, 0x8a, 0x72,
            0x1c, 0x3c, 0x0c, 0x95, 0x95, 0x68, 0x09, 0x53,
            0x2f, 0xcf, 0x0e, 0x24, 0x49, 0xa6, 0xb5, 0x25,
            0xb1, 0x6a, 0xed, 0xf5, 0xaa, 0x0d, 0xe6, 0x57,
            0xba, 0x63, 0x7b, 0x39
        };
        static const u8 want[76] = {
            0x52, 0x2d, 0xc1, 0xf0, 0x99, 0x56, 0x7d, 0x07,
            0xf4, 0x7f, 0x37, 0xa3, 0x2a, 0x84, 0x42, 0x7d,
            0x64, 0x3a, 0x8c, 0xdc, 0xbf, 0xe5, 0xc0, 0xc9,
            0x75, 0x98, 0xa2, 0xbd, 0x25, 0x55, 0xd1, 0xaa,
            0x8c, 0xb0, 0x8e, 0x48, 0x59, 0x0d, 0xbb, 0x3d,
            0xa7, 0xb0, 0x8b, 0x10, 0x56, 0x82, 0x88, 0x38,
            0xc5, 0xf6, 0x1e, 0x63, 0x93, 0xba, 0x7a, 0x0a,
            0xbc, 0xc9, 0xf6, 0x62, 0x76, 0xfc, 0x6e, 0xce,
            0x0f, 0x4e, 0x17, 0x68, 0xcd, 0xdf, 0x88, 0x53,
            0xbb, 0x2d, 0x55, 0x1b
        };

        a.init(AEAD_AES_256_GCM, k2, 32);
        if (!a.ok())
            return err(11, "AES-256-GCM 初始化失败");
        if (a.seal(iv, aad, 20, pt, 60, out, (int)sizeof out) != 76)
            return err(12, "AES-256-GCM 的 seal 长度不对");
        if (memcmp(out, want, 76) != 0)
            return err(13, "AES-256-GCM 的密文/tag 不对");
        {
            u8 back[64] = { 0 };

            if (a.open(iv, aad, 20, out, 76, back, (int)sizeof back) != 60
                || memcmp(back, pt, 60) != 0)
                return err(14, "AES-256-GCM 往返不对");
            /* AAD 改了也要失败 */
            if (a.open(iv, aad, 19, out, 76, back, (int)sizeof back) != -2)
                return err(15, "AAD 变短应验签失败");
        }
    }
    /* 参数检查 */
    {
        Aead bad = { 0 };

        bad.init(AEAD_AES_128_GCM, key, 32);
        if (bad.ok())
            return err(16, "AES-128 给 32 字节 key 应失败");
        bad.init(AEAD_AES_128_GCM, 0, 16);
        if (bad.ok())
            return err(17, "空 key 应失败");
        bad.init(99, key, 16);
        if (bad.ok() || aead_key_len_for(99) != 0)
            return err(18, "未知算法应失败");
        if (a.seal(nonce, 0, 0, 0, 0, out, 8) != -1)
            return err(19, "目标缓冲放不下 tag 应失败");
        if (a.open(nonce, 0, 0, out, 8, out, 64) != -1)
            return err(20, "输入短于 tag 应失败");
    }
}

test "AEAD：ChaCha20-Poly1305（RFC 8439 §2.8.2）" {
    static const char *pt = "Ladies and Gentlemen of the class of '99: If I "
                            "could offer you only one tip for the future, "
                            "sunscreen would be it.";
    u8 key[32] = { 0 };
    u8 nonce[12] = { 0x07, 0x00, 0x00, 0x00, 0x40, 0x41,
                     0x42, 0x43, 0x44, 0x45, 0x46, 0x47 };
    u8 aad[12] = { 0x50, 0x51, 0x52, 0x53, 0xc0, 0xc1,
                   0xc2, 0xc3, 0xc4, 0xc5, 0xc6, 0xc7 };
    u8 out[256] = { 0 };
    u8 back[256] = { 0 };
    Aead a = { 0 };
    int n = 0;
    int plen = (int)strlen(pt);
    int i = 0;

    for (i = 0; i < 32; i++)
        key[i] = (u8)(0x80 + i);
    a.init(AEAD_CHACHA20_POLY1305, key, 32);
    if (!a.ok() || a.kind_of() != AEAD_CHACHA20_POLY1305)
        return err(1, "ChaCha20-Poly1305 初始化失败");
    n = a.seal(nonce, aad, 12, pt, plen, out, (int)sizeof out);
    if (n != plen + 16)
        return err(2, "seal 长度应是明文 + 16");
    if (!hex_eq(out, 16, "d31a8d34648e60db7b86afbc53ef7ec2"))
        return err(3, "首 16 字节密文不对");
    if (!hex_eq(out + 32, 16, "3dbea45e8ca9671282fafb69da92728b"))
        return err(4, "第 3 个 16 字节密文不对");
    if (!hex_eq(out + n - 16, 16, "1ae10b594f09e26a7e902ecbd0600691"))
        return err(5, "tag 不对");
    if (a.open(nonce, aad, 12, out, n, back, (int)sizeof back) != plen)
        return err(6, "open 失败");
    if (memcmp(back, pt, (size_t)plen) != 0)
        return err(7, "ChaCha20-Poly1305 往返不对");
    /* 改动密文中间一个字节 → tag 失败 */
    out[40] ^= 0x80;
    if (a.open(nonce, aad, 12, out, n, back, (int)sizeof back) != -2)
        return err(8, "篡改密文应验签失败");
    out[40] ^= 0x80;
    /* 空 AAD、空明文 */
    {
        u8 tag[32] = { 0 };

        if (a.seal(nonce, 0, 0, 0, 0, tag, (int)sizeof tag) != 16)
            return err(9, "空明文的 seal 应给 16 字节");
        if (a.open(nonce, 0, 0, tag, 16, back, (int)sizeof back) != 0)
            return err(10, "空明文的 open 应给 0");
    }
    /* 与 GCM 一样，两种算法都对 64 字节整块数据工作 */
    {
        u8 buf[128] = { 0 };

        for (i = 0; i < 64; i++)
            buf[i] = (u8)i;
        n = a.seal(nonce, aad, 12, buf, 64, out, (int)sizeof out);
        if (n != 80)
            return err(11, "64 字节明文的 seal 长度不对");
        if (a.open(nonce, aad, 12, out, n, back, (int)sizeof back) != 64
            || memcmp(back, buf, 64) != 0)
            return err(12, "64 字节往返不对");
    }
}

test "AEAD：GHASH 与常数时间比较" {
    /* GHASH 单块：H = 0^128 时任何输入都给 0 */
    {
        u8 h[16] = { 0 };
        u8 s[16] = { 0 };
        u8 zero16[16] = { 0 };
        u8 x[16] = { 1, 2, 3 };

        if (aead_gcm_ghash(h, x, 16, 0, 0, s) != 0)
            return err(1, "ghash 调用失败");
        if (!aead_tag_equal(s, zero16, 16))
            return err(2, "H=0 时 GHASH 应是 0");
    }
    /* H 取乘法单位元时，GHASH 退化成「逐块异或」：两个输入块 + 长度块 */
    {
        u8 h[16] = { 0 };
        u8 aad[16] = { 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
                       0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa };
        u8 ct[16] = { 0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0x55,
                      0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0x55, 0x55 };
        u8 s[16] = { 0 };
        u8 want[16] = { 0 };

        h[0] = 0x80;            /* GCM 的反射位序里，最高位才是 x^0（乘法单位元） */
        /* want = aad ^ ct ^ (aad_bits || ct_bits)，长度块只有第 7、15 字节非零 */
        {
            int i = 0;

            for (i = 0; i < 16; i++)
                want[i] = (u8)(aad[i] ^ ct[i]);
            want[7] ^= 0x80;    /* 128 bit = 0x80 放在大端 64 位的最高位 */
            want[15] ^= 0x80;
        }
        aead_gcm_ghash(h, aad, 16, ct, 16, s);
        if (memcmp(s, want, 16) != 0)
            return err(3, "单位元 H 下的 GHASH 应等于逐块异或再叠长度块");
    }
    /* 常数时间比较 */
    {
        u8 a16[16] = { 0 };
        u8 b16[16] = { 0 };

        b16[15] = 1;
        if (aead_tag_equal(a16, b16, 16) != 0)
            return err(4, "不同 tag 应给 0");
        if (aead_tag_equal(a16, a16, 16) != 1)
            return err(5, "相同 tag 应给 1");
        if (aead_tag_equal(0, a16, 16) != 0)
            return err(6, "空指针应给 0");
    }
}
