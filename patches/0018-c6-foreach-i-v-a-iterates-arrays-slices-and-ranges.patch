From bd9d9a65099d3ff3f069218f53dfb32bdde5ad6a Mon Sep 17 00:00:00 2001
From: c6 <c6@localhost>
Date: Sat, 7 Nov 2026 05:23:07 +0800
Subject: [PATCH] c6: 'foreach |i, v| a { }' iterates arrays, slices and ranges

The statement is binder-first and requires a braced body:

    foreach |i, v| a { ... }       -- complete array or slice 'T[:]'
    foreach |i| 0:n { ... }        -- half-open integer range [0, n)
    foreach |_, v| a { ... }       -- '_' discards a binding

The iterable is evaluated once.  An array or a slice is spilled into the
'{ elem *data; size_t len; }' frame pair the slice runtime already uses,
so 'foreach |i, v| f()' (f returns a slice) and 'foreach |i, v|
obj.items' take the same path; a range stores its upper bound in a
hidden integer slot and uses the index binder as the counter.  Both
binders are ordinary locals pushed with sym_push(), the body goes
through lblock(), so break/continue/defer/await/goto behave exactly as
they do inside a 'for' -- and the hidden slots are plain frame slots, so
the statement also works in an 'async' body (the frame is saved and
restored as a whole).

'v' is a fresh copy of the element, so writing it never touches the
container; 'i' is the loop counter itself, so writing it changes the
iteration, exactly like the 'for' it rewrites to (rule R14 in
docs/grammar.md).  A bare array re-loads the element each round, a slice
iterates a '{data, len}' snapshot.  With '_' the load/store is not even
generated.

Three design decisions worth recording:

  - binders come first, the iterable second: 'for' stays pure C, and '|'
    is already the bit-or token, so an expression never has to guess
    whether a '|' starts a binding list;
  - no runtime iteration protocol.  Methods are not renamed per receiver,
    so len/at/has would collide with user functions (same-named methods
    must live in different packages), and 'void *next()' erases the
    element type.  Arrays, slices and ranges only; a user type exposes a
    slice member instead ('foreach |i, v| obj.items');
  - 'lo:hi' instead of '0..n': '0..3' lexes as the two float constants
    '0.' and '.3', and ':' is unambiguous here because the iterable is
    parsed as a conditional-expression, so a ternary's ':' has already
    been consumed.

TOK_C6_FOREACH is appended at the very end of tcctok.h (the i386 asm
keyword range must stay last); without -std=c6 tccpp.c uninterns it and
'foreach' stays a plain identifier, which also keeps 'int foreach = 1;',
'foreach(x);', 'p->foreach' and 'goto foreach;' working: the statement
dispatch needs the next token to be '|'.
---
 tccgen.c | 216 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 tccpp.c  |   2 +-
 tcctok.h |   1 +
 3 files changed, 218 insertions(+), 1 deletion(-)

diff --git a/tccgen.c b/tccgen.c
index ab3ef07..a39093b 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -282,6 +282,7 @@ typedef struct C6SpPending {
 } C6SpPending;
 static C6SpPending *c6_sp_pending;
 static void c6_task_decl(void);
+static void c6_foreach_parse(void);
 static void c6_task_check_handle(CType *t, const char *what);
 static void c6_task_defer_destroy(int slot);
 static void c6_async_propagate(void);
@@ -9667,6 +9668,16 @@ again:
         if (!c6_ext_on())
             tcc_error("'catch' requires -std=c6");
         tcc_error("'catch' has no operand");
+
+    } else if (t == TOK_C6_FOREACH) {
+        if (!c6_ext_on())
+            tcc_error("'foreach' requires -std=c6");
+        if (tok != '|') {
+            /* not a statement: 'foreach' is used as a plain name here */
+            unget_tok(t);
+            goto expr;
+        }
+        c6_foreach_parse();
 #endif
 
     } else if (t == TOK_FOR) {
@@ -11784,6 +11795,202 @@ static void c6_task_decl(void)
     skip(';');
 }
 
+/* ---------------------------------------------------------------------- */
+/* 'foreach |i, v| iterable { ... }'                                       */
+/*                                                                         */
+/* The iterable is evaluated once.  A complete array or a slice becomes    */
+/* the '{ elem *data; size_t len; }' frame pair that the slice runtime     */
+/* already uses, a range 'lo:hi' becomes two integer slots.  The binders    */
+/* are ordinary locals -- the index counts and the value is a fresh copy    */
+/* of the element -- so 'break', 'continue', 'defer' and 'await' behave     */
+/* exactly as they do inside a 'for'.  A user type is iterated through a    */
+/* slice it exposes ('foreach |i, v| obj.items'): there is no runtime       */
+/* protocol and no call into a library.                                    */
+
+/* what the usual arithmetic conversions give for two integer operands:
+   the wider type, unsigned when both are as wide and either is unsigned,
+   and never narrower than 'int' (default promotions) */
+static CType c6_common_int_type(CType *a, CType *b)
+{
+    CType r;
+    int al, bl, sa, sb;
+
+    sa = type_size(a, &al);
+    sb = type_size(b, &bl);
+    r = sb > sa ? *b : *a;
+    if (sa == sb && ((a->t | b->t) & VT_UNSIGNED))
+        r.t |= VT_UNSIGNED;
+    if (type_size(&r, &al) < (int)sizeof(int))
+        r.t = VT_INT;
+    return r;
+}
+
+static int c6_is_int_type(CType *t)
+{
+    if (is_float(t->t))
+        return 0;
+    return is_integer_btype(t->t & VT_BTYPE);
+}
+
+/* 'foreach' keeps the 'for' semantics: the binders live in their own scope
+   and 'lblock' collects the break/continue jumps of the body. */
+static void c6_foreach_parse(void)
+{
+    C6Slice *sl;
+    CType t, elem, ept, ctr;
+    struct scope o;
+    char buf[256];
+    int n1, n2, nb, is_range;
+    int i_off, v_off, pair, hi_off, size, align;
+    int a, b, c, d;
+
+    n1 = n2 = nb = i_off = v_off = pair = hi_off = 0;
+    is_range = 0;
+
+    next();                             /* '|' */
+    for (;;) {
+        int name;
+        if (tok < TOK_UIDENT)
+            tcc_error("'foreach' expects a binding name");
+        if (nb == 2)
+            tcc_error("'foreach' takes at most two bindings");
+        name = 0;
+        if (strcmp(get_tok_str(tok, NULL), "_"))
+            name = tok;
+        if (nb++ == 0)
+            n1 = name;
+        else
+            n2 = name;
+        next();
+        if (tok != ',')
+            break;
+        next();
+    }
+    skip('|');
+
+    new_scope(&o);
+
+    expr_cond();
+    if (tok == ':') {
+        is_range = 1;
+        next();
+        expr_cond();
+        if (nb != 1)
+            tcc_error("a range yields only an index: write 'foreach |i| lo:hi'");
+        if (!c6_is_int_type(&vtop[-1].type) || !c6_is_int_type(&vtop->type))
+            tcc_error("range bounds must be integers");
+        ctr = c6_common_int_type(&vtop[-1].type, &vtop->type);
+        size = type_size(&ctr, &align);
+        /* the upper bound goes to a hidden slot ... */
+        loc = (loc - size) & -align;
+        hi_off = loc;
+        vset(&ctr, VT_LOCAL | VT_LVAL, hi_off);
+        vswap();
+        vstore();
+        vpop();
+        /* ... and the binder is the counter, so it starts at the lower
+           bound (the store converts it to the common type) */
+        loc = (loc - size) & -align;
+        i_off = loc;
+        if (n1)
+            sym_push(n1, &ctr, VT_LOCAL | VT_LVAL, i_off);
+        vset(&ctr, VT_LOCAL | VT_LVAL, i_off);
+        vswap();
+        vstore();
+        vpop();
+    } else {
+        t = vtop->type;
+        if (nb != 2)
+            tcc_error("an array or slice yields an index and a value: "
+                      "write 'foreach |i, v| a'");
+        if (t.t & VT_VLA)
+            tcc_error("cannot iterate over a variable length array");
+        if (t.t & VT_ARRAY) {
+            if (!t.ref || t.ref->c < 0)
+                tcc_error("cannot iterate over an array of unknown length");
+            elem = *pointed_type(&t);
+            elem.t &= ~VT_QUAL;
+            pair = c6_slice_spill(NULL);
+        } else if ((sl = c6_slice_of_type(&t)) != NULL) {
+            elem = sl->elem;
+            pair = c6_slice_spill(sl);
+        } else {
+            type_to_str(buf, sizeof buf, &t, NULL);
+            if ((t.t & VT_BTYPE) == VT_PTR)
+                tcc_error("cannot iterate over '%s' (use a slice parameter "
+                          "'T[:]', or '(T[:]){p, n}')", buf);
+            if (c6_is_int_type(&t))
+                tcc_error("cannot iterate over '%s' (write a range: "
+                          "'foreach |i| lo:hi')", buf);
+            tcc_error("cannot iterate over '%s' (expose a slice member, "
+                      "e.g. 'T[:] items')", buf);
+        }
+        if (!n1 && !n2)
+            tcc_error("'foreach' discards both binders");
+        if (elem.t & VT_ARRAY) {
+            type_to_str(buf, sizeof buf, &elem, NULL);
+            tcc_error("'foreach' cannot copy an element of type '%s'", buf);
+        }
+        size = type_size(&elem, &align);
+        if (size < 0) {
+            type_to_str(buf, sizeof buf, &elem, NULL);
+            tcc_error("cannot iterate over incomplete element type '%s'", buf);
+        }
+        ctr = c6_size_type();
+        /* hidden slots first, then the two binders */
+        loc = (loc - size) & -align;
+        v_off = loc;
+        loc = (loc - PTR_SIZE) & -PTR_SIZE;
+        i_off = loc;
+        if (n1)
+            sym_push(n1, &ctr, VT_LOCAL | VT_LVAL, i_off);
+        if (n2)
+            sym_push(n2, &elem, VT_LOCAL | VT_LVAL, v_off);
+        vset(&ctr, VT_LOCAL | VT_LVAL, i_off);       /* i = 0 */
+        vpushi(0);
+        vstore();
+        vpop();
+    }
+
+    c = gind();
+    vset(&ctr, VT_LOCAL | VT_LVAL, i_off);
+    vset(&ctr, VT_LOCAL | VT_LVAL, is_range ? hi_off : pair + PTR_SIZE);
+    gen_op(TOK_LT);
+    a = gvtst(1, 0);
+
+    /* the value binder is loaded from the pair on every iteration */
+    if (n2) {
+        ept = elem;
+        mk_pointer(&ept);
+        vset(&elem, VT_LOCAL | VT_LVAL, v_off);     /* destination */
+        vset(&ept, VT_LOCAL | VT_LVAL, pair);       /* data */
+        vset(&ctr, VT_LOCAL | VT_LVAL, i_off);      /* index */
+        gen_op('+');
+        indir();
+        vstore();
+        vpop();
+    }
+    if (tok != '{')
+        expect("'{'");                              /* the body is a block */
+    b = 0;                      /* no 'continue' jumps yet */
+    lblock(&a, &b);
+
+    /* 'continue' lands on the increment */
+    d = gind();
+    gsym_addr(b, d);
+    vset(&ctr, VT_LOCAL | VT_LVAL, i_off);
+    vpushi(1);
+    gen_op('+');
+    vset(&ctr, VT_LOCAL | VT_LVAL, i_off);
+    vswap();
+    vstore();
+    vpop();
+    gjmp_addr(c);
+    gsym(a);
+
+    prev_scope(&o, 0);
+}
+
 /* ---------------------------------------------------------------------- */
 /* soft keywords                                                           */
 /*                                                                         */
@@ -12411,6 +12618,15 @@ static int decl(int l)
                 unget_tok(c6_name);
             }
         }
+        /* 'foreach |i, v| a { ... }' is a statement: at file scope it is
+           always a mistake, not a declaration with an implicit int */
+        if (tcc_state->c6_ext && l == VT_CONST && tok == TOK_C6_FOREACH) {
+            int c6_name = tok;
+            next();
+            if (tok == '|')
+                tcc_error("'foreach' can only be used inside a function");
+            unget_tok(c6_name);
+        }
 #endif
         if (!parse_btype(&btype, &adbase, l == VT_LOCAL)) {
             if (l == VT_JMP)
diff --git a/tccpp.c b/tccpp.c
index 77bcbe6..a402236 100644
--- a/tccpp.c
+++ b/tccpp.c
@@ -4014,7 +4014,7 @@ ST_FUNC void tccpp_new(TCCState *s)
            'test' may already be interned as an asm keyword, in which
            case the range ends before TOK_C6_TEST. */
         int t;
-        for (t = TOK_C6_PACKAGE; t <= TOK_C6_AWAIT && t < tok_ident; t++)
+        for (t = TOK_C6_PACKAGE; t <= TOK_C6_FOREACH && t < tok_ident; t++)
             tok_unintern(t);
         if (TOK_C6_PACKAGE < tok_ident)
             tok_ident = TOK_C6_PACKAGE;
diff --git a/tcctok.h b/tcctok.h
index 4e8270c..d09551c 100644
--- a/tcctok.h
+++ b/tcctok.h
@@ -454,4 +454,5 @@
      DEF(TOK_C6_CATCH,     "catch")
      DEF(TOK_C6_ASYNC,     "async")
      DEF(TOK_C6_AWAIT,     "await")
+     DEF(TOK_C6_FOREACH,   "foreach")
 #endif
-- 
