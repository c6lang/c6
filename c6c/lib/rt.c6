/* stdio 的错误/EOF 标志：rt.c6 的 FILE 就是 fd，没有标志位可读，
 * 所以这三个只能给出"没有错误、还没到 EOF"（`fileno` 倒是准确的）。
 * 以 `feof` 为循环条件的代码在 c6c 默认运行时下会一直读到 read 返回 0，
 * 因此这里如实说明，而不是假装有状态。 */
int ferror(void *f)
{
    (void)f;
    return 0;
}

int feof(void *f)
{
    (void)f;
    return 0;
}

void clearerr(void *f)
{
    (void)f;
}

int fileno(void *f)
{
    return (int)(long)f;
}

int execvp(const char *file, char *const argv[])
{
    long r = c6c_sys3(59 /* execve */, (long)file, (long)argv, (long)environ);

    return (int)r;
}

/* realpath：相对路径按 cwd 展开、折叠 "." / ".." / 多余斜杠，最后确认文件存在。
 * resolved 为 NULL 时自己 malloc（glibc 的行为）。以前这里是个只会填 cwd 的桩，
 * 于是 tcc（用 c6c 编出来的那个）里 `#pragma once` 的
 * `normalized_PATHCMP()` 永远失败，同一个头文件被包含好几次
 * （tcc tests2 的 18_include 就是这么暴露的）。 */
char *realpath(const char *path, char *resolved)
{
    static char full[4096];
    static char out[4096];
    int fl = 0;
    int ol = 1;
    int i = 0;
    char *buf = resolved;

    if (!path || !*path)
        return 0;
    if (path[0] != '/') {
        if (!getcwd(full, (int)sizeof(full)))
            return 0;
        fl = (int)strlen(full);
        if (fl > 0 && full[fl - 1] != '/' && fl < (int)sizeof(full) - 1)
            full[fl++] = '/';
    }
    for (i = 0; path[i] && fl < (int)sizeof(full) - 1; i++)
        full[fl++] = path[i];
    full[fl] = 0;

    out[0] = '/';
    out[1] = 0;
    i = 0;
    while (full[i]) {
        int s = 0;
        int n = 0;

        while (full[i] == '/')
            i++;
        s = i;
        while (full[i] && full[i] != '/')
            i++;
        n = i - s;
        if (n == 0)
            continue;
        if (n == 1 && full[s] == '.')
            continue;
        if (n == 2 && full[s] == '.' && full[s + 1] == '.') {
            while (ol > 1 && out[ol - 1] != '/')
                ol--;
            if (ol > 1)
                ol--;
            out[ol] = 0;
            continue;
        }
        if (ol > 1 && out[ol - 1] != '/' && ol < (int)sizeof(out) - 1)
            out[ol++] = '/';
        {
            int k = 0;

            for (k = 0; k < n && ol < (int)sizeof(out) - 1; k++)
                out[ol++] = full[s + k];
        }
        out[ol] = 0;
    }
    if (out[0] != '/') {
        out[0] = '/';
        ol = 1;
        out[1] = 0;
    }
    /* 必须真的存在（access(F_OK)） */
    if ((long)c6c_sys2(21 /* access */, (long)out, 0) != 0)
        return 0;
    if (!buf) {
        buf = (char *)malloc((long)ol + 1);
        if (!buf)
            return 0;
    }
    for (i = 0; i <= ol; i++)
        buf[i] = out[i];
    return buf;
}

int gettimeofday(void *tv, void *tz)
{
    (void)tz;
    return (int)c6c_sys2(96 /* gettimeofday */, (long)tv, 0);
}

/* 约定：FILE* 就是文件描述符本身（见上面的 fopen） */
int fseek(FILE *f, long off, int whence)
{
    long r = c6c_sys3(C6C_SYS_LSEEK, (long)f, off, (long)whence);

    return r < 0 ? -1 : 0;
}

long ftell(FILE *f)
{
    return c6c_sys3(C6C_SYS_LSEEK, (long)f, 0, 1 /* SEEK_CUR */);
}

FILE *fdopen(int fd, const char *mode)
{
    (void)mode;
    return (FILE *)(long)fd;
}

FILE *freopen(const char *path, const char *mode, FILE *f)
{
    (void)f;
    return (FILE *)fopen(path, mode);
}

/* libc 自己那份：c6 里只引用不定义要写 extern */
extern char **environ;

float strtof(const char *s, char **end)
{
    return (float)strtod(s, end);
}

long double strtold(const char *s, char **end)
{
    return (long double)strtod(s, end);
}

long double ldexpl(long double x, int e)
{
    long double r = x;
    int i = 0;

    for (i = 0; i < (e > 0 ? e : -e); i++)
        r = (e > 0) ? r * 2.0L : r / 2.0L;
    return r;
}

/* 动态链接：c6c 产出静态可执行文件，没有 .so 可加载 */
void *dlopen(const char *path, int flags) { (void)path; (void)flags; return 0; }
void *dlsym(void *h, const char *name) { (void)h; (void)name; return 0; }
int dlclose(void *h) { (void)h; return 0; }
char *dlerror(void) { return (char *)"dynamic loading is not available"; }

/* 信号：c6c 的运行时没有信号投递 */
int sigprocmask(int how, const void *set, void *old) { (void)how; (void)set; (void)old; return 0; }
int sigaction(int s, const void *act, void *old) { (void)s; (void)act; (void)old; return 0; }

/* 信号量：单线程，空操作 */
int sem_init(void *s, int pshared, unsigned int v) { (void)s; (void)pshared; (void)v; return 0; }
int sem_wait(void *s) { (void)s; return 0; }
int sem_post(void *s) { (void)s; return 0; }
int sem_destroy(void *s) { (void)s; return 0; }
/* 信号量这几个也是空操作（rt.c6 的 sem_* 没有计数），trywait/timedwait 一律
 * "拿到了"，getvalue 给 0——调用方按返回值分支的逻辑在单线程用例里成立。 */
int sem_trywait(void *s) { (void)s; return 0; }
int sem_timedwait(void *s, const void *abstime) { (void)s; (void)abstime; return 0; }
int sem_getvalue(void *s, int *v) { (void)s; if (v) *v = 0; return 0; }

/* longjmp：没有可恢复的栈上下文（要保存 rsp/rip），明确退出而不是静默错走 */
int _setjmp(void *buf) { (void)buf; return 0; }
void longjmp(void *buf, int v)
{
    (void)buf;
    (void)v;
    _exit(2);
}


/* ---------- 数学函数（double） ----------
 * 目标不是 bit 级复刻 libm，而是"6 位小数跟 glibc 一致"。用的都是收敛很快的
 * 级数 + 区间归约，误差在 1e-15 量级，远小于 %f 的 1e-6 需求。
 * 注意：只处理 double（c6c 的 long double 就是 double）。 */

double fabs(double x) { return x < 0 ? -x : x; }

double floor(double x)
{
    double t = (double)(long)x;

    if (t > x)
        t -= 1.0;
    return t;
}

double ceil(double x)
{
    double t = (double)(long)x;

    if (t < x)
        t += 1.0;
    return t;
}

double fmod(double x, double y)
{
    double q = 0;

    if (y == 0.0)
        return 0.0;
    q = x / y;
    q = (double)(long)q;            /* 向零取整 */
    return x - q * y;
}

double sqrt(double x)
{
    double g = 0;
    int i = 0;

    if (x <= 0.0)
        return 0.0;
    g = x > 1.0 ? x : 1.0;
    for (i = 0; i < 60; i++)
        g = 0.5 * (g + x / g);
    return g;
}

/* exp(x)：先折半到 |r| <= 0.5，再 Taylor，最后平方回去 */
double exp(double x)
{
    double r = x;
    double sum = 1.0;
    double term = 1.0;
    int k = 0;
    int i = 0;

    while (r > 0.5) { r = r * 0.5; k++; }
    while (r < -0.5) { r = r * 0.5; k++; }
    for (i = 1; i < 30; i++) {
        term = term * r / (double)i;
        sum = sum + term;
    }
    for (i = 0; i < k; i++)
        sum = sum * sum;
    return sum;
}

/* log(x)：用 x = m * 2^e 归约，m 再折到 [sqrt(0.5), sqrt(2)]，用 atanh 级数 */
double log(double x)
{
    double m = x;
    double s = 0;
    double z = 0;
    double term = 0;
    double sum = 0;
    int e = 0;
    int i = 0;

    if (x <= 0.0)
        return -1.0e308;
    /* 归约方向别搞反：除以 2 指数 +1，乘以 2 指数 -1 */
    while (m >= 1.4142135623730951) { m = m * 0.5; e++; }
    while (m < 0.7071067811865476) { m = m * 2.0; e--; }
    z = (m - 1.0) / (m + 1.0);
    term = z;
    sum = z;
    for (i = 3; i < 60; i += 2) {
        term = term * z * z;
        sum = sum + term / (double)i;
    }
    s = 2.0 * sum + (double)e * 0.6931471805599453;
    return s;
}

double log10(double x) { return log(x) / 2.302585092994046; }
double log2(double x) { return log(x) / 0.6931471805599453; }

double pow(double x, double y)
{
    if (y == 0.0)
        return 1.0;
    if (x == 0.0)
        return 0.0;
    if (x < 0.0) {
        double t = exp(y * log(-x));

        return (fmod(y, 2.0) == 0.0) ? t : -t;
    }
    return exp(y * log(x));
}

/* 三角：先把 x 归约到 [-pi, pi]，再折到 [-pi/2, pi/2] 用 Taylor */
#define C6C_PI 3.141592653589793
#define C6C_2PI 6.283185307179586

static double c6c_sin_small(double x)
{
    double term = x;
    double sum = x;
    int i = 0;

    for (i = 1; i < 15; i++) {
        term = -term * x * x / (double)((2 * i) * (2 * i + 1));
        sum = sum + term;
    }
    return sum;
}

static double c6c_cos_small(double x)
{
    double term = 1.0;
    double sum = 1.0;
    int i = 0;

    for (i = 1; i < 15; i++) {
        term = -term * x * x / (double)((2 * i - 1) * (2 * i));
        sum = sum + term;
    }
    return sum;
}

static double c6c_reduce(double x)
{
    long k = 0;

    /* 归约到 [-pi, pi] */
    k = (long)(x / C6C_2PI);
    x = x - (double)k * C6C_2PI;
    return x;
}

double sin(double x)
{
    double r = c6c_reduce(x);

    if (r > C6C_PI / 2.0)
        r = C6C_PI - r;
    else if (r < -C6C_PI / 2.0)
        r = -C6C_PI - r;
    return c6c_sin_small(r);
}

double cos(double x)
{
    double r = c6c_reduce(x);

    if (r > C6C_PI)
        r = r - C6C_2PI;
    else if (r < -C6C_PI)
        r = r + C6C_2PI;
    return c6c_cos_small(r);
}

double tan(double x) { return sin(x) / cos(x); }

/* atan：|x|>1 用 pi/2 - atan(1/x)，小值用级数（x/(1+x^2) 形式收敛慢，用折半） */
double atan(double x)
{
    double s = 0;
    double t = 0;
    double sum = 0;
    double term = 0;
    int k = 0;
    int i = 0;

    if (x < 0.0)
        return -atan(-x);
    if (x > 1.0)
        return C6C_PI / 2.0 - atan(1.0 / x);
    /* 折半 4 次：atan(x) = 2*atan(x / (1 + sqrt(1 + x^2))) */
    for (k = 0; k < 4; k++)
        x = x / (1.0 + sqrt(1.0 + x * x));
    term = x;
    sum = x;
    t = x * x;
    for (i = 3; i < 40; i += 2) {
        term = -term * t;
        sum = sum + term / (double)i;
    }
    s = sum;
    for (k = 0; k < 4; k++)
        s = s * 2.0;
    return s;
}

double asin(double x)
{
    if (x >= 1.0)
        return C6C_PI / 2.0;
    if (x <= -1.0)
        return -C6C_PI / 2.0;
    return atan(x / sqrt(1.0 - x * x));
}

double acos(double x) { return C6C_PI / 2.0 - asin(x); }

double sinh(double x)
{
    double e = exp(x);

    return (e - 1.0 / e) * 0.5;
}

double cosh(double x)
{
    double e = exp(x);

    return (e + 1.0 / e) * 0.5;
}

double tanh(double x)
{
    double e = exp(2.0 * x);

    return (e - 1.0) / (e + 1.0);
}


double round(double x)
{
    double t = (double)(long)x;

    if (x >= 0) {
        if (x - t >= 0.5)
            t += 1.0;
    } else {
        if (t - x >= 0.5)
            t -= 1.0;
    }
    return t;
}

double trunc(double x) { return (double)(long)x; }

double rint(double x) { return round(x); }
double nearbyint(double x) { return round(x); }
double copysign(double x, double y)
{
    double a = fabs(x);

    return (y < 0 || (y == 0 && 1.0 / y < 0)) ? -a : a;
}
double ldexp(double x, int e)
{
    double r = x;
    int i = 0;

    for (i = 0; i < (e > 0 ? e : -e); i++)
        r = (e > 0) ? r * 2.0 : r / 2.0;
    return r;
}
double frexp(double x, int *e)
{
    int k = 0;

    if (x == 0.0) { *e = 0; return 0.0; }
    while (fabs(x) >= 1.0) { x = x * 0.5; k++; }
    while (fabs(x) < 0.5) { x = x * 2.0; k--; }
    *e = k;
    return x;
}
double modf(double x, double *ip)
{
    double t = trunc(x);

    *ip = t;
    return x - t;
}
double cbrt(double x) { return x < 0 ? -pow(-x, 1.0 / 3.0) : pow(x, 1.0 / 3.0); }
double hypot(double x, double y) { return sqrt(x * x + y * y); }
double fmax(double x, double y) { return x > y ? x : y; }
double fmin(double x, double y) { return x < y ? x : y; }
double expm1(double x) { return exp(x) - 1.0; }
double log1p(double x) { return log(1.0 + x); }
double asinh(double x) { return log(x + sqrt(x * x + 1.0)); }
double acosh(double x) { return log(x + sqrt(x * x - 1.0)); }
double atanh(double x) { return 0.5 * log((1.0 + x) / (1.0 - x)); }

/* `-lm` 那一族的补丁：`atan2` 以前缺，std/geo 的用例就卡在链接期。剩下几个
 * 是同一个面（log2/exp2/copysign/fdim/nextafter）——都是能精确写出来的，
 * 不靠查表，也没有"近似到多少位"的模糊地带。 */
double atan2(double y, double x)
{
    if (x > 0.0)
        return atan(y / x);
    if (x < 0.0)
        return y >= 0.0 ? atan(y / x) + C6C_PI : atan(y / x) - C6C_PI;
    if (y > 0.0)
        return C6C_PI / 2.0;
    if (y < 0.0)
        return -C6C_PI / 2.0;
    return 0.0;
}

double exp2(double x) { return exp(x * 0.69314718055994530942); }
double fdim(double x, double y) { return x > y ? x - y : 0.0; }

/* nextafter：按 IEEE-754 的位模式做，不碰数值 */
double nextafter(double x, double y)
{
    unsigned long xi = *(unsigned long *)&x;

    if (x == y)
        return y;
    if (x == 0.0) {
        xi = 1ul;
        return y > 0.0 ? *(double *)&xi : -*(double *)&xi;
    }
    if ((x < y) == (x > 0.0))
        xi++;
    else
        xi--;
    return *(double *)&xi;
}

/* ---- -test 运行器：和 tcc 的 native 运行器（tccrun.c 的 tcc_run_tests）同一套
 * 输出协议 ----
 *
 * c6c 的 synth_test_main() 给每条 `test "描述" { … }` 块生成一次调用：跑它、
 * 报告、把失败数累加起来当退出码。协议逐字对齐 tcc，所以 tests/run-tests.sh
 * 里那几条检查（PASS 行、FAIL 行带错误消息、收尾统计、过滤后块数）对两个
 * 编译器同样成立：
 *
 *   PASS: 描述                → stdout
 *   FAIL: 描述: 错误消息       → stderr（错误通道里没有消息时只报描述）
 *   N test(s), M failure(s)   → stdout，报告的最后一行
 *
 * 返回 1 表示这条失败、0 表示通过——调用方直接把它加起来当失败数。
 */
int __c6c_test_run(int (*fn)(void), const char *desc)
{
    const char *msg = 0;
    int r = 0;

    /* 上一条的 err 状态不能漏到这一条（tcc 的运行器也每块清一次） */
    __tcc_err_clear();
    r = fn();
    if (!r) {
        printf("PASS: %s\n", desc);
        return 0;
    }
    msg = __tcc_err_msg_get();
    if (msg && msg[0])
        fprintf((void *)2, "FAIL: %s: %s\n", desc, msg);
    else
        fprintf((void *)2, "FAIL: %s\n", desc);
    return 1;
}

/* 收尾一行。顺带等所有 spawn 出去的线程：它们还在这段代码里跑着，
 * 主线程一返回（进程退出）就没人回收了（tcc 的运行器同样先 join）。 */
void __c6c_test_summary(int nrun, int nfail)
{
    __c6_th_join_all();
    printf("%d test(s), %d failure(s)\n", nrun, nfail);
}

#endif /* _C6C_RT_C6 */
