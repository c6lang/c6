/* std/data/ubjson：UBJSON 解析（零分配，扁平事件 + 容器栈）。
 *
 *     import std.data.ubjson;
 *
 *     UbjReader r = { 0 };
 *     UbjValue v = { 0 };
 *     ubj_open(text, n, &r);
 *     while (r.next(&v) == 1) {
 *         // v.type / v.i / v.d / v.s
 *     }
 *
 * 出来的是事件流：标量各一个事件，容器发 `UBJ_ARRAY` / `UBJ_OBJECT` 开始，
 * 结束时发 `UBJ_END`（对象里的键发 `UBJ_KEY`）。容器自动闭合时（用了 `#`
 * 计数的「优化容器」）也会补一个 `UBJ_END`，所以调用方只用看事件。
 *
 * 约定：
 *
 * - 支持 `Z N T F` / `i U I l L` / `d D H` / `C S` / `[ ] { }` / `$ #`；
 * - `$`（统一类型）与 `#`（计数）可以只出现一个、也可以都有，顺序是 `$` 在前；
 *   计数容器的元素进来时不再带类型标记；
 * - `H`（高精度）当字符串给，`v.s` 是原文；
 * - `S`/`C` 的长度是 UBJSON 的「整数」编码（本身就是带标记的整数）；
 * - 深度上限 16、`#` 计数上限 1e6，超了按坏数据（-1）；
 * - `next` 返回 1 有事件 / 0 读完 / -1 坏数据；读到容器结束但外层没结束时继续
 *   给外层的下一个事件；
 * - 不支持带强类型的对象键（UBJSON 里键总是 `S`）。
 */
#include <string.h>

module std.data.ubjson;
import std.core.types;
import std.text.str;

enum UbjType {
    UBJ_NULL,
    UBJ_TRUE,
    UBJ_FALSE,
    UBJ_INT,
    UBJ_FLOAT,
    UBJ_STRING,
    UBJ_CHAR,
    UBJ_ARRAY,
    UBJ_OBJECT,
    UBJ_KEY,
    UBJ_END,
};

#define UBJ_MAX_DEPTH 16
#define UBJ_MAX_COUNT 1000000

struct UbjFrame {
    int kind;           /* 0 数组、1 对象 */
    int remaining;      /* -1 表示没有 `#` */
    int fixed;          /* -1 表示没有 `$`，否则是标记字符 */
    int expect_key;     /* 对象里下一个是不是键 */
};

struct UbjReader {
    const u8 *p;
    int n;
    int pos;
    int depth;
    int bad;
    UbjFrame stack[UBJ_MAX_DEPTH];
};

struct UbjValue {
    int type;
    long long i;
    double d;
    Str s;
};

static u32 ubj_u32(const u8 *p, int n)
{
    u32 v = 0;
    int i = 0;

    for (i = 0; i < n; i++)
        v = (v << 8) | (u32)p[i];
    return v;
}

int ubj_open(const void *src, int n, UbjReader *out)
{
    if (!src || !out || n <= 0)
        return -1;
    memset(out, 0, sizeof *out);
    out->p = (const u8 *)src;
    out->n = n;
    return 1;
}

/* 读一个整数（带标记），返回 1 成功 / -1 坏；值写进 *v */
static int ubj_int(UbjReader *self, long long *v)
{
    const u8 *p = self->p;
    int pos = self->pos;

    if (pos >= self->n)
        return -1;
    switch (p[pos]) {
    case 'i':
        if (pos + 2 > self->n)
            return -1;
        *v = (long long)(signed char)p[pos + 1];
        self->pos = pos + 2;
        return 1;
    case 'U':
        if (pos + 2 > self->n)
            return -1;
        *v = (long long)p[pos + 1];
        self->pos = pos + 2;
        return 1;
    case 'I':
        if (pos + 3 > self->n)
            return -1;
        *v = (long long)(short)ubj_u32(p + pos + 1, 2);
        self->pos = pos + 3;
        return 1;
    case 'l': {
        u32 raw = 0;

        if (pos + 5 > self->n)
            return -1;
        raw = ubj_u32(p + pos + 1, 4);
        *v = (long long)(int)raw;
        self->pos = pos + 5;
        return 1;
    }
    case 'L': {
        u64 hi = 0, lo = 0;

        if (pos + 9 > self->n)
            return -1;
        hi = ubj_u32(p + pos + 1, 4);
        lo = ubj_u32(p + pos + 5, 4);
        *v = (long long)((hi << 32) | lo);
        self->pos = pos + 9;
        return 1;
    }
    default:
        return -1;
    }
}

/* 读 `S`/`C`/`H` 的载荷：pos 指向长度（`H` 也是长度在前），marker 已确定 */
static int ubj_str_body(UbjReader *self, Str *out, char marker)
{
    const u8 *p = self->p;
    long long len = 0;

    if (ubj_int(self, &len) != 1 || len < 0)
        return -1;
    if ((u64)self->pos + (u64)len > (u64)self->n)
        return -1;
    if (marker == 'C') {
        if (len != 1)
            return -1;
        out->s = (char[:]){ (char *)p + self->pos, 1 };
        self->pos += 1;
        return 1;
    }
    out->s = (char[:]){ (char *)p + self->pos, (int)len };
    self->pos += (int)len;
    return 1;
}

/* 读一个标量；fixed >= 0 表示容器用 `$` 指定了类型，此时没有类型标记 */
static int ubj_scalar(UbjReader *self, int fixed, UbjValue *out)
{
    const u8 *p = self->p;
    int pos = self->pos;
    int c = 0;

    if (pos >= self->n)
        return -1;
    if (fixed >= 0) {
        c = fixed;
        switch (c) {
        case 'Z': out->type = UBJ_NULL; return 1;
        case 'N': out->type = UBJ_NULL; return 1;
        case 'T': out->type = UBJ_TRUE; return 1;
        case 'F': out->type = UBJ_FALSE; return 1;
        case 'i':
            out->type = UBJ_INT;
            out->i = (long long)(signed char)p[pos];
            self->pos = pos + 1;
            return 1;
        case 'U':
            out->type = UBJ_INT;
            out->i = (long long)p[pos];
            self->pos = pos + 1;
            return 1;
        case 'I':
            out->type = UBJ_INT;
            out->i = (long long)(short)ubj_u32(p + pos, 2);
            self->pos = pos + 2;
            return 1;
        case 'l':
            out->type = UBJ_INT;
            out->i = (long long)(int)ubj_u32(p + pos, 4);
            self->pos = pos + 4;
            return 1;
        case 'L': {
            u64 hi = ubj_u32(p + pos, 4), lo = ubj_u32(p + pos + 4, 4);

            out->type = UBJ_INT;
            out->i = (long long)((hi << 32) | lo);
            self->pos = pos + 8;
            return 1;
        }
        case 'd': {
            u32 bits = ubj_u32(p + pos, 4);
            float f = 0;

            memcpy(&f, &bits, 4);
            out->type = UBJ_FLOAT;
            out->d = (double)f;
            self->pos = pos + 4;
            return 1;
        }
        case 'D': {
            u64 bits = ((u64)ubj_u32(p + pos, 4) << 32)
                       | (u64)ubj_u32(p + pos + 4, 4);
            double d = 0;

            memcpy(&d, &bits, 8);
            out->type = UBJ_FLOAT;
            out->d = d;
            self->pos = pos + 8;
            return 1;
        }
        case 'S':
        case 'H':
        case 'C':
            out->type = c == 'C' ? UBJ_CHAR : UBJ_STRING;
            return ubj_str_body(self, &out->s, (char)c);
        default:
            return -1;
        }
    }
    c = p[pos];
    self->pos = pos + 1;
    switch (c) {
    case 'Z':
    case 'N':
        out->type = UBJ_NULL;
        return 1;
    case 'T': out->type = UBJ_TRUE; return 1;
    case 'F': out->type = UBJ_FALSE; return 1;
    case 'i':
    case 'U':
    case 'I':
    case 'l':
    case 'L':
        self->pos = pos;                /* 让 ubj_int 自己吃标记 */
        out->type = UBJ_INT;
        return ubj_int(self, &out->i);
    case 'd': {
        u32 bits = 0;
        float f = 0;

        if (pos + 5 > self->n)
            return -1;
        bits = ubj_u32(p + pos + 1, 4);
        memcpy(&f, &bits, 4);
        self->pos = pos + 5;
        out->type = UBJ_FLOAT;
        out->d = (double)f;
        return 1;
    }
    case 'D': {
        u64 bits = 0;
        double d = 0;

        if (pos + 9 > self->n)
            return -1;
        bits = ((u64)ubj_u32(p + pos + 1, 4) << 32)
               | (u64)ubj_u32(p + pos + 5, 4);
        memcpy(&d, &bits, 8);
        self->pos = pos + 9;
        out->type = UBJ_FLOAT;
        out->d = d;
        return 1;
    }
    case 'S':
    case 'H':
    case 'C':
        out->type = c == 'C' ? UBJ_CHAR : UBJ_STRING;
        return ubj_str_body(self, &out->s, (char)c);
    default:
        return -1;
    }
}

/* 容器头：当前 pos 指向 '[' 或 '{'，可选 `$` 与 `#` */
static int ubj_container(UbjReader *self, int *kind, int *fixed, int *count)
{
    const u8 *p = self->p;
    int pos = self->pos;

    if (pos >= self->n)
        return -1;
    *kind = p[pos] == '[' ? 0 : 1;
    pos++;
    *fixed = -1;
    *count = -1;
    while (pos < self->n) {
        if (p[pos] == '$') {
            if (pos + 1 >= self->n)
                return -1;
            if (*fixed >= 0)
                return -1;
            *fixed = p[pos + 1];
            pos += 2;
            continue;
        }
        if (p[pos] == '#') {
            long long v = 0;
            int save = self->pos;

            if (*count >= 0)
                return -1;
            self->pos = pos + 1;
            if (ubj_int(self, &v) != 1 || v < 0 || v > UBJ_MAX_COUNT) {
                self->pos = save;
                return -1;
            }
            *count = (int)v;
            pos = self->pos;
            continue;
        }
        break;
    }
    self->pos = pos;
    return 1;
}

static int ubj_top(UbjReader *self)
{
    return self->depth > 0 ? self->depth - 1 : -1;
}

int next(UbjReader *self, UbjValue *out)
{
    for (;;) {
        int top = ubj_top(self);
        int fixed = -1, kind = 0, count = 0, c = 0;

        if (!self || self->bad || !out)
            return -1;
        memset(out, 0, sizeof *out);
        /* 容器自动闭合 */
        if (top >= 0 && self->stack[top].remaining == 0) {
            self->depth--;
            out->type = UBJ_END;
            return 1;
        }
        if (self->pos >= self->n) {
            if (top < 0)
                return 0;
            self->bad = 1;
            return -1;                  /* 容器没闭合 */
        }
        c = self->p[self->pos];
        /* 显式结束标记 */
        if (c == ']' || c == '}') {
            if (top < 0)
                return -1;
            if (c == ']' && self->stack[top].kind != 0)
                return -1;
            if (c == '}' && self->stack[top].kind != 1)
                return -1;
            if (self->stack[top].remaining > 0)
                return -1;              /* `#` 说的个数还没读完 */
            self->pos++;
            self->depth--;
            out->type = UBJ_END;
            return 1;
        }
        if (top >= 0) {
            UbjFrame *f = &self->stack[top];

            fixed = f->fixed;
            if (f->kind == 1 && f->expect_key) {
                Str key = { 0 };

                if (c != 'S')
                    return -1;
                self->pos++;
                if (ubj_str_body(self, &key, 'S') != 1)
                    return -1;
                f->expect_key = 0;
                out->type = UBJ_KEY;
                out->s = key;
                return 1;
            }
        }
        /* 值 */
        if (c == '[' || c == '{') {
            if (self->depth >= UBJ_MAX_DEPTH)
                return -1;
            if (ubj_container(self, &kind, &fixed, &count) != 1)
                return -1;
            self->stack[self->depth].kind = kind;
            self->stack[self->depth].remaining = count;
            self->stack[self->depth].fixed = fixed;
            self->stack[self->depth].expect_key = kind == 1;
            self->depth++;
            if (top >= 0) {
                UbjFrame *f = &self->stack[top];

                if (f->kind == 1)
                    f->expect_key = 1;
            }
            out->type = kind == 0 ? UBJ_ARRAY : UBJ_OBJECT;
            return 1;
        }
        if (ubj_scalar(self, fixed, out) != 1)
            return -1;
        if (top >= 0) {
            UbjFrame *f = &self->stack[top];

            if (f->remaining > 0)
                f->remaining--;
            if (f->kind == 1)
                f->expect_key = 1;
        }
        return 1;
    }
}

/* ---- 自测 ---- */

test "UBJSON：标量、容器与计数/统一类型" {
    /* { "a": [1, 2, 3], "b": "hi", "c": true } —— 数组用 # 计数 */
    static const char *doc =
        "{Si\x01" "a" "[$U#i\x03\x01\x02\x03" "Si\x01" "b" "Si\x02" "hi"
        "Si\x01" "c" "T}";
    UbjReader r = { 0 };
    UbjValue v = { 0 };
    int depth = 0, ints = 0, n = (int)strlen(doc);

    if (ubj_open(doc, n, &r) != 1)
        return err(1, "打开失败");
    if (r.next(&v) != 1 || v.type != UBJ_OBJECT)
        return err(2, "第一个应该是对象");
    if (r.next(&v) != 1 || v.type != UBJ_KEY || v.s.s.len != 1
        || v.s.s.data[0] != 'a')
        return err(3, "键 a 不对");
    if (r.next(&v) != 1 || v.type != UBJ_ARRAY)
        return err(4, "a 的值应该是数组");
    /* #U 之后是固定类型的三个 int8，没有标记 */
    if (r.next(&v) != 1 || v.type != UBJ_INT || v.i != 1)
        return err(5, "数组第一个元素不对");
    if (r.next(&v) != 1 || v.type != UBJ_INT || v.i != 2)
        return err(6, "数组第二个元素不对");
    if (r.next(&v) != 1 || v.type != UBJ_INT || v.i != 3)
        return err(7, "数组第三个元素不对");
    if (r.next(&v) != 1 || v.type != UBJ_END)
        return err(8, "计数够了应该自动闭合");
    if (r.next(&v) != 1 || v.type != UBJ_KEY || v.s.s.data[0] != 'b')
        return err(9, "键 b 不对");
    if (r.next(&v) != 1 || v.type != UBJ_STRING || v.s.s.len != 2
        || memcmp(v.s.s.data, "hi", 2) != 0)
        return err(10, "字符串 b 不对");
    if (r.next(&v) != 1 || v.type != UBJ_KEY || v.s.s.data[0] != 'c')
        return err(11, "键 c 不对");
    if (r.next(&v) != 1 || v.type != UBJ_TRUE)
        return err(12, "c 应该是 true");
    if (r.next(&v) != 1 || v.type != UBJ_END)
        return err(13, "对象应该结束");
    if (r.next(&v) != 0)
        return err(14, "应该读完");
    (void)depth;
    (void)ints;
}

test "UBJSON：各数值类型、优化容器与坏数据" {
    static char buf[128] = { 0 };
    UbjReader r = { 0 };
    UbjValue v = { 0 };
    int n = 0;

    /* 标量序列：null / int8 / uint8 / int16 / int32 / int64 / float32 / float64 */
    {
        static char s[32] = { 0 };
        int len = 0;

        s[len++] = 'Z';
        s[len++] = 'i';
        s[len++] = (char)0xFF;
        s[len++] = 'U';
        s[len++] = (char)0xFF;
        s[len++] = 'I';
        s[len++] = (char)0xFE;
        s[len++] = 0x00;
        s[len++] = 'l';
        s[len++] = (char)0xFF;
        s[len++] = (char)0xFF;
        s[len++] = (char)0xFF;
        s[len++] = (char)0xFE;
        s[len++] = 'L';
        s[len++] = (char)0xFF;
        s[len++] = (char)0xFF;
        s[len++] = (char)0xFF;
        s[len++] = (char)0xFF;
        s[len++] = (char)0xFF;
        s[len++] = (char)0xFF;
        s[len++] = (char)0xFF;
        s[len++] = (char)0xFE;

        if (ubj_open(s, len, &r) != 1)
            return err(15, "打开失败");
        if (r.next(&v) != 1 || v.type != UBJ_NULL)
            return err(16, "null 不对");
        if (r.next(&v) != 1 || v.i != -1)
            return err(17, "int8 -1 不对");
        if (r.next(&v) != 1 || v.i != 255)
            return err(18, "uint8 255 不对");
        if (r.next(&v) != 1 || v.i != -512)
            return err(19, "int16 -512 不对");
        if (r.next(&v) != 1 || v.i != -2)
            return err(20, "int32 -2 不对");
        if (r.next(&v) != 1 || v.i != -2)
            return err(21, "int64 -2 不对");
    }
    /* float64 1.5 */
    {
        static char f[16] = { 0 };

        f[0] = 'D';
        f[1] = 0x3F;
        f[2] = (char)0xF8;
        f[5] = 0;
        if (ubj_open(f, 9, &r) != 1)
            return err(22, "打开失败");
        if (r.next(&v) != 1 || v.type != UBJ_FLOAT || v.d != 1.5)
            return err(23, "float64 1.5 不对");
    }
    /* 空数组与空对象 */
    if (ubj_open("[]{}", 4, &r) != 1)
        return err(24, "打开失败");
    if (r.next(&v) != 1 || v.type != UBJ_ARRAY || r.next(&v) != 1
        || v.type != UBJ_END)
        return err(25, "空数组不对");
    if (r.next(&v) != 1 || v.type != UBJ_OBJECT || r.next(&v) != 1
        || v.type != UBJ_END)
        return err(26, "空对象不对");
    /* `#` 计数容器：3 个字符串 */
    {
        static const char *t = "[$S#i\x03" "i\x01" "a" "i\x01" "b"
                               "i\x01" "c";
        char tmp[64] = { 0 };

        n = (int)strlen(t);
        memcpy(tmp, t, (size_t)n);
        memcpy(buf, tmp, (size_t)n);
    }
    if (ubj_open(buf, n, &r) != 1)
        return err(27, "打开失败");
    if (r.next(&v) != 1 || v.type != UBJ_ARRAY)
        return err(28, "计数数组开始不对");
    if (r.next(&v) != 1 || v.s.s.len != 1 || v.s.s.data[0] != 'a')
        return err(29, "计数数组第 0 项不对");
    if (r.next(&v) != 1 || v.s.s.data[0] != 'b' || r.next(&v) != 1
        || v.s.s.data[0] != 'c')
        return err(30, "计数数组后两项不对");
    if (r.next(&v) != 1 || v.type != UBJ_END || r.next(&v) != 0)
        return err(31, "计数数组收尾不对");
    /* 坏数据：容器不闭合 / 计数不符 / 未知标记 */
    if (ubj_open("[Si\x01" "a", 5, &r) != 1)
        return err(32, "打开失败");
    if (r.next(&v) != 1 || r.next(&v) != 1 || r.next(&v) != -1)
        return err(33, "容器不闭合应该 -1");
    if (ubj_open("[#i\x02Si\x01" "a]", 10, &r) != 1)
        return err(34, "打开失败");
    if (r.next(&v) != 1 || r.next(&v) != 1 || r.next(&v) != -1)
        return err(35, "计数没读满就遇到 ] 应该 -1");
    if (ubj_open("?", 1, &r) != 1)
        return err(36, "打开失败");
    if (r.next(&v) != -1)
        return err(37, "未知标记应该 -1");
    if (ubj_open(0, 4, &r) != -1)
        return err(38, "空指针应该 -1");
}
