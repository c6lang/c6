/* tests/module.c6 的第二个翻译单元：模块 tu.module 的实现。
 *
 * 模块里的文件作用域名字在编译器内部加 'tu__module__' 前缀；源码仍然
 * 写短名。方法 'area(Point *)' 导出的符号是
 * 'tu__module__Point_area'。
 */
module tu.module;

struct Point { int x, y; };
typedef struct Point Point;
enum Color { RED, GREEN };

interface Shape {
    int area();
}

int counter = 7;
Point origin = { 3, 4 };

int add(int a, int b) { return a + b; }
int twice(int a) { return add(a, a); }
int area(Point *p) { return p->x * p->y; }
int bump(void) { return ++counter; }

test "模块内部照样用短名" {
    Point p = { 2, 2 };
    if (add(1, 1) != 2)
        err(1, "internal add");
    if (area(&p) != 4)
        err(2, "internal area");
    if (RED != 0)
        err(3, "internal enum");
}
