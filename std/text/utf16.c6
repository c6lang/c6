/* std/text/utf16：UTF-16 解码、编码与计数（零分配）。
 *
 *     import std.text.utf16;
 *
 *     u16 units[5] = { 'h', 'e', 'l', 'l', 'o' };
 *     Utf16 s = utf16((u16[:]){ units, 5 });
 *     int pos = 0;
 *     u32 cp = 0;
 *     s.decode(&pos, &cp);          // 1, cp == 'h'
 *     s.count();                    // 5
 *
 * 按 UTF-16 代码单元处理：BMP 字符一个单元，非 BMP 用高低代理对。解码遇到
 * 落单的代理、高代理后面不是低代理时返回 -1；输入在代理对中间结束时返回 0
 * （截断）；`count` 遇到非法序列返回 -1。编码只接受 <= U+10FFFF 且不在代理区
 * 的码点，失败不写任何单元。不做 BOM 处理，也不区分大小端：`u16` 就是宿主
 * 端序，跨字节序传输时调用方自己换。
 */
#include <string.h>

module std.text.utf16;
import std.core.types;

struct Utf16 {
    u16[:] units;
};

Utf16 utf16(u16[:] units)
{
    Utf16 s = { units };

    return s;
}

static int u16_high(u16 w) { return w >= 0xd800 && w <= 0xdbff; }

static int u16_low(u16 w) { return w >= 0xdc00 && w <= 0xdfff; }

/* 1 = 成功，0 = 截断，-1 = 非法/参数错。 */
int decode(Utf16 *self, int *pos, u32 *out)
{
    u16 w1 = 0;
    u16 w2 = 0;

    if (!self || !pos || !out || self->units.len < 0 || *pos < 0
        || *pos > self->units.len)
        return -1;
    if (*pos == self->units.len)
        return 0;
    w1 = self->units.data[*pos];
    if (u16_high(w1)) {
        if (*pos + 1 >= self->units.len)
            return 0;
        w2 = self->units.data[*pos + 1];
        if (!u16_low(w2))
            return -1;
        *out = 0x10000u + (((u32)w1 - 0xd800u) << 10)
               + ((u32)w2 - 0xdc00u);
        *pos += 2;
        return 1;
    }
    if (u16_low(w1))
        return -1;
    *out = w1;
    (*pos)++;
    return 1;
}

int valid(Utf16 *self)
{
    int pos = 0;
    u32 cp = 0;

    if (!self)
        return 0;
    while (pos < self->units.len) {
        if (self->decode(&pos, &cp) != 1)
            return 0;
    }
    return 1;
}

/* 码点个数；非法序列给 -1。 */
int count(Utf16 *self)
{
    int pos = 0;
    int n = 0;
    u32 cp = 0;

    if (!self)
        return -1;
    while (pos < self->units.len) {
        if (self->decode(&pos, &cp) != 1)
            return -1;
        n++;
    }
    return n;
}

/* 编码需要几个 u16；非法码点给 0。 */
int utf16_encoded_len(u32 cp)
{
    if (cp > 0x10ffffu || (cp >= 0xd800u && cp <= 0xdfffu))
        return 0;
    return cp <= 0xffffu ? 1 : 2;
}

/* 编码；cap 不够或码点非法返回 -1 且不写任何单元。 */
int utf16_encode(u32 cp, u16 *dst, int cap)
{
    int need = utf16_encoded_len(cp);

    if (need == 0 || need > cap || (need > 0 && !dst))
        return -1;
    if (need == 1) {
        dst[0] = (u16)cp;
        return 1;
    }
    cp -= 0x10000u;
    dst[0] = (u16)(0xd800u + (cp >> 10));
    dst[1] = (u16)(0xdc00u + (cp & 0x3ffu));
    return 2;
}

/* 一次解码的便捷入口；语义同 Utf16.decode。 */
int utf16_decode_one(u16[:] units, int *pos, u32 *out)
{
    Utf16 s = utf16(units);

    return s.decode(pos, out);
}

/* ---- 自测 ---- */

test "BMP 字符与计数" {
    u16 units[5] = { 'h', 'e', 'l', 'l', 'o' };
    Utf16 s = utf16((u16[:]){ units, 5 });
    int pos = 0;
    int p2 = 0;
    u32 cp = 0;
    int n = 0;

    if (!s.valid() || s.count() != 5)
        return err(1, "ASCII 计数不对");
    while (pos < 5) {
        if (s.decode(&pos, &cp) != 1)
            return err(2, "ASCII 解码失败");
        n++;
    }
    if (n != 5 || cp != 'o')
        return err(3, "ASCII 解码结果不对");
    if (s.decode(&pos, &cp) != 0)
        return err(4, "末尾没有给截断");
    if (utf16_decode_one((u16[:]){ units, 5 }, &p2, &cp) != 1
        || cp != 'h')
        return err(5, "utf16_decode_one 不对");
}

test "代理对与非 BMP" {
    u16 pair[2] = { 0xd83d, 0xde00 };      /* U+1F600 */
    Utf16 s = utf16((u16[:]){ pair, 2 });
    u16 out[2] = { 0 };
    int pos = 0;
    u32 cp = 0;

    if (!s.valid() || s.count() != 1)
        return err(6, "代理对计数不对");
    if (s.decode(&pos, &cp) != 1 || cp != 0x1f600u || pos != 2)
        return err(7, "代理对解码不对");
    if (utf16_encoded_len(0x1f600u) != 2)
        return err(8, "代理对编码长度不对");
    if (utf16_encode(0x1f600u, out, 2) != 2 || out[0] != 0xd83d
        || out[1] != 0xde00)
        return err(9, "代理对编码不对");
    if (utf16_encoded_len(0xffffu) != 1 || utf16_encode(0xffffu, out, 1) != 1
        || out[0] != 0xffffu)
        return err(10, "BMP 边界不对");
}

test "非法代理、截断与越界码点" {
    u16 lone_hi[1] = { 0xd83d };
    u16 lone_lo[1] = { 0xdc00 };
    u16 bad_pair[2] = { 0xd83d, 'x' };
    u16 trunc[1] = { 0xd83d };
    Utf16 a = utf16((u16[:]){ lone_hi, 1 });
    Utf16 b = utf16((u16[:]){ lone_lo, 1 });
    Utf16 c = utf16((u16[:]){ bad_pair, 2 });
    Utf16 d = utf16((u16[:]){ trunc, 1 });
    u16 out[3] = { 0 };
    int pos = 0;
    u32 cp = 0;

    if (a.valid() || a.count() != -1 || a.decode(&pos, &cp) != 0)
        return err(11, "落单高代理处理不对");
    pos = 0;
    if (b.valid() || b.count() != -1 || b.decode(&pos, &cp) != -1)
        return err(12, "落单低代理处理不对");
    pos = 0;
    if (c.valid() || c.count() != -1 || c.decode(&pos, &cp) != -1)
        return err(13, "高代理后接非低代理处理不对");
    pos = 0;
    if (d.valid() || d.count() != -1 || d.decode(&pos, &cp) != 0)
        return err(14, "截断代理对处理不对");
    if (utf16_encoded_len(0xd800u) != 0 || utf16_encoded_len(0x110000u) != 0)
        return err(15, "非法码点长度不是 0");
    if (utf16_encode(0xd800u, out, 3) != -1
        || utf16_encode(0x1f600u, out, 1) != -1
        || utf16_encode(0x41u, 0, 1) != -1)
        return err(16, "非法编码没有返回 -1");
    if (out[0] != 0 || out[1] != 0)
        return err(17, "失败时写了半个编码");
}

test "空视图与参数错误" {
    u16 units[1] = { 0x41 };
    Utf16 s = utf16((u16[:]){ units, 0 });
    Utf16 *np = 0;
    int pos = 0;
    u32 cp = 0;

    if (!s.valid() || s.count() != 0 || s.decode(&pos, &cp) != 0)
        return err(18, "空视图处理不对");
    if (np->valid() || np->count() != -1 || np->decode(&pos, &cp) != -1)
        return err(19, "空指针处理不对");
    pos = -1;
    if (s.decode(&pos, &cp) != -1)
        return err(20, "负 pos 没有报错");
    pos = 1;
    if (s.decode(&pos, &cp) != -1)
        return err(21, "大于长度的 pos 没有报错");
}
