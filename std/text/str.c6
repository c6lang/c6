/* std/text/str：字符串视图 Str。
 *
 *     import std.text.str;
 *
 *     Str s = { S("hello") };               // 字面量，零成本，不含结尾 NUL
 *     Str t = str(buf);                 // C 字符串 -> 视图（要 strlen）
 *     if ((&s)->eq(t)) ...
 *     Str head = (&s)->take(2);
 *
 * Str 是 `char[:]` 的一层包装：**不拥有**内存、不分配、不复制，所以可以
 * 按值声明和传参（它只有一对指针+长度，没有托管字段）。普通结构体的方法
 * 就是「第一个参数是 `Str *` 的文件作用域函数」，调用要写 `(&s)->m()`：
 *
 *     Str s = { S("abc") };
 *     Str *p = &s;              // 之后 p->count()、p->find_char('b') ...
 *
 * `S("...")` 是零成本修正：裸字面量转 `char[:]` 会把结尾的 NUL 也算进
 * 长度（"hello" 得到 6），S() 用 sizeof-1 给出真实字符数。
 *
 * 生命周期由调用方保证：视图指向的内存必须比 Str 活得久。
 */
#include <string.h>

module std.text.str;
import std.core.types;

/* 字面量 -> 视图：长度不含结尾 NUL */
#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

struct Str {
    char[:] s;
};

int count(Str *self) { return self->s.len; }

int is_empty(Str *self) { return self->s.len == 0; }

/* 第 i 个字节；越界返回 0，扫描时不必先查长度 */
char at(Str *self, int i)
{
    return (i >= 0 && i < self->s.len) ? self->s[i] : 0;
}

/* 带检查的取字节 */
int get(Str *self, int i, char *out)
{
    if (i < 0 || i >= self->s.len)
        return 0;
    *out = self->s[i];
    return 1;
}

/* 前 k 个 / 跳过前 k 个：只调整边界，不分配 */
Str take(Str *self, int k)
{
    Str r = { self->s };

    if (k < 0)
        k = 0;
    if (k > self->s.len)
        k = self->s.len;
    r.s = (char[:]){ self->s.data, k };
    return r;
}

Str drop(Str *self, int k)
{
    Str r = { self->s };

    if (k < 0)
        k = 0;
    if (k > self->s.len)
        k = self->s.len;
    r.s = (char[:]){ self->s.data + k, self->s.len - k };
    return r;
}

Str sub(Str *self, int start, int n)
{
    Str r = { self->s };

    if (start < 0)
        start = 0;
    if (start > self->s.len)
        start = self->s.len;
    if (n < 0)
        n = 0;
    if (start + n > self->s.len)
        n = self->s.len - start;
    r.s = (char[:]){ self->s.data + start, n };
    return r;
}

/* 字节比较：-1 / 0 / 1 */
int cmp(Str *self, char[:] o)
{
    int n = self->s.len < o.len ? self->s.len : o.len;
    int i = 0;

    for (i = 0; i < n; i++) {
        if (self->s[i] != o[i])
            return self->s[i] < o[i] ? -1 : 1;
    }
    if (self->s.len == o.len)
        return 0;
    return self->s.len < o.len ? -1 : 1;
}

int eq(Str *self, char[:] o) { return self->cmp(o) == 0; }

/* 子串第一次出现的位置，找不到返回 -1（朴素扫描，够用且无分配） */
int find(Str *self, char[:] needle)
{
    int i = 0, j = 0;

    if (needle.len == 0)
        return 0;
    if (needle.len > self->s.len)
        return -1;
    for (i = 0; i + needle.len <= self->s.len; i++) {
        for (j = 0; j < needle.len; j++)
            if (self->s[i + j] != needle[j])
                break;
        if (j == needle.len)
            return i;
    }
    return -1;
}

int find_char(Str *self, char c)
{
    int i = 0;

    for (i = 0; i < self->s.len; i++)
        if (self->s[i] == c)
            return i;
    return -1;
}

int starts_with(Str *self, char[:] p)
{
    int i = 0;

    if (p.len > self->s.len)
        return 0;
    for (i = 0; i < p.len; i++)
        if (self->s[i] != p[i])
            return 0;
    return 1;
}

int ends_with(Str *self, char[:] p)
{
    int off = self->s.len - p.len;
    int i = 0;

    if (p.len > self->s.len)
        return 0;
    for (i = 0; i < p.len; i++)
        if (self->s[off + i] != p[i])
            return 0;
    return 1;
}

int contains(Str *self, char[:] needle) { return self->find(needle) >= 0; }

/* 最后一次出现的位置，找不到返回 -1（空 needle 返回 count()） */
int last_find(Str *self, char[:] needle)
{
    int i = 0, j = 0;

    if (needle.len == 0)
        return self->s.len;
    if (needle.len > self->s.len)
        return -1;
    for (i = self->s.len - needle.len; i >= 0; i--) {
        for (j = 0; j < needle.len; j++)
            if (self->s[i + j] != needle[j])
                break;
        if (j == needle.len)
            return i;
    }
    return -1;
}

int last_find_char(Str *self, char c)
{
    int i = 0;

    for (i = self->s.len - 1; i >= 0; i--)
        if (self->s[i] == c)
            return i;
    return -1;
}

/* 某个字节出现几次 */
int count_char(Str *self, char c)
{
    int i = 0, n = 0;

    for (i = 0; i < self->s.len; i++)
        if (self->s[i] == c)
            n++;
    return n;
}

/* 不重叠的子串出现几次（空 needle 记 0 次） */
int count_sub(Str *self, char[:] needle)
{
    int i = 0, j = 0, n = 0;

    if (needle.len == 0)
        return 0;
    for (i = 0; i + needle.len <= self->s.len; i++) {
        for (j = 0; j < needle.len; j++)
            if (self->s[i + j] != needle[j])
                break;
        if (j == needle.len) {
            n++;
            i += needle.len - 1;
        }
    }
    return n;
}

/* 空白集合：和 trim() 认的是同一组字节 */
int is_space(char c)
{
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

/* 只去掉左边 / 只去掉右边的空白 */
Str trim_left(Str *self)
{
    Str r = { self->s };
    int b = 0;

    while (b < self->s.len && is_space(self->s[b]))
        b++;
    r.s = (char[:]){ self->s.data + b, self->s.len - b };
    return r;
}

Str trim_right(Str *self)
{
    Str r = { self->s };
    int e = self->s.len;

    while (e > 0 && is_space(self->s[e - 1]))
        e--;
    r.s = (char[:]){ self->s.data, e };
    return r;
}

/* 去掉两端空白，返回新视图（不改原视图） */
Str trim(Str *self)
{
    Str r = { self->s };
    int b = 0, e = self->s.len;

    while (b < e && is_space(self->s[b]))
        b++;
    while (e > b && is_space(self->s[e - 1]))
        e--;
    r.s = (char[:]){ self->s.data + b, e - b };
    return r;
}

/* FNV-1a 32：和 std.container.map 的字节哈希、std.core.hash 的 fnv1a_bytes 是同一套常量
   （offset 2166136261、prime 16777619）。这里保持内联，好让「import std.text.str」
   不必再多编一个 std/core/hash.c6；三处的已知向量测试互相钉住，改常量要三处一起改。 */
u32 hash(Str *self)
{
    u32 h = 2166136261u;
    int i = 0;

    for (i = 0; i < self->s.len; i++)
        h = (h ^ (u32)(u8)self->s[i]) * 16777619u;
    return h;
}

char upper_char(char c)
{
    return (c >= 'a' && c <= 'z') ? (char)(c - 'a' + 'A') : c;
}

char lower_char(char c)
{
    return (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
}

/* 大小写转换要写进别人的缓冲（视图不能改原内存）：成功返回长度，空间不够返回 -1 */
int copy_upper(Str *self, char *dst, int cap)
{
    int i = 0;

    if (cap <= self->s.len)
        return -1;
    for (i = 0; i < self->s.len; i++)
        dst[i] = upper_char(self->s[i]);
    dst[self->s.len] = 0;
    return self->s.len;
}

int copy_lower(Str *self, char *dst, int cap)
{
    int i = 0;

    if (cap <= self->s.len)
        return -1;
    for (i = 0; i < self->s.len; i++)
        dst[i] = lower_char(self->s[i]);
    dst[self->s.len] = 0;
    return self->s.len;
}

/* 十进制解析：整个视图必须是整数，允许前导 +/- 与两端空白 */
int!error to_int(Str *self, int *out)
{
    Str t = self->trim();
    Str *p = &t;
    int i = 0, neg = 0;
    long v = 0;
    int digits = 0;

    if (p->s.len == 0)
        return err(1, "str: empty number");
    if (p->s[0] == '-' || p->s[0] == '+') {
        neg = p->s[0] == '-';
        i = 1;
    }
    for (; i < p->s.len; i++) {
        if (p->s[i] < '0' || p->s[i] > '9')
            return err(2, "str: not a number");
        v = v * 10 + (p->s[i] - '0');
        if (v > 2147483647L)
            return err(3, "str: number out of range");
        digits++;
    }
    if (!digits)
        return err(4, "str: no digits");
    *out = (int)(neg ? -v : v);
    return 0;
}

/* 按 base 进制解析无符号整数（2..36，字母不分大小写），允许两端空白。
   不接受的输入返回错误；*out 只在成功时写。 */
int!error to_base(Str *self, int base, u32 *out)
{
    Str t = self->trim();
    Str *p = &t;
    u32 v = 0u;
    int i = 0, digits = 0, d = 0;

    if (base < 2 || base > 36)
        return err(5, "str: base must be 2..36");
    if (p->s.len == 0)
        return err(6, "str: empty number");
    for (i = 0; i < p->s.len; i++) {
        char c = p->s[i];

        if (c >= '0' && c <= '9')
            d = c - '0';
        else if (c >= 'a' && c <= 'z')
            d = c - 'a' + 10;
        else if (c >= 'A' && c <= 'Z')
            d = c - 'A' + 10;
        else
            return err(7, "str: bad digit");
        if (d >= base)
            return err(8, "str: digit out of base");
        /* 2^32 检查：先看能不能放下，再看溢出 */
        if ((u64)v * (u64)base + (u64)d > 4294967295ull)
            return err(9, "str: number out of range");
        v = v * (u32)base + (u32)d;
        digits++;
    }
    if (!digits)
        return err(10, "str: no digits");
    *out = v;
    return 0;
}

/* 十进制无符号 64 位解析：允许两端空白与前导 '+'；'-' 不接受（无符号）。
   错误码与 to_int 对齐：1 空、2 不是数字、3 越界、4 没有数字。 */
int!error to_u64(Str *self, u64 *out)
{
    Str t = self->trim();
    Str *p = &t;
    int i = 0, digits = 0;
    u64 v = 0ull;

    if (p->s.len == 0)
        return err(1, "str: empty number");
    if (p->s[0] == '+')
        i = 1;
    for (; i < p->s.len; i++) {
        u64 d = 0ull;

        if (p->s[i] < '0' || p->s[i] > '9')
            return err(2, "str: not a number");
        d = (u64)(p->s[i] - '0');
        /* 先判后乘：v * 10 溢出之前就拦住 */
        if (v > (18446744073709551615ull - d) / 10ull)
            return err(3, "str: number out of range");
        v = v * 10ull + d;
        digits++;
    }
    if (!digits)
        return err(4, "str: no digits");
    *out = v;
    return 0;
}

/* 两个视图比较：-1 / 0 / 1（cmp 接 char[:]，这里是 Str 对 Str） */
int cmp_str(Str *self, Str *o)
{
    return self->cmp(o->s);
}

/* C 字符串比较：-1 / 0 / 1（z 为 NULL 时按空串算） */
int cmp_cstr(Str *self, char *z)
{
    char[:] o = { z, 0 };

    if (z)
        o = (char[:]){ z, (int)strlen(z) };
    return self->cmp(o);
}

/* 去掉前缀：命中返回 1 并把剩下的视图写进 *out；没命中返回 0（不改 *out） */
int strip_prefix(Str *self, char[:] p, Str *out)
{
    int i = 0;

    if (p.len > self->s.len)
        return 0;
    for (i = 0; i < p.len; i++)
        if (self->s[i] != p[i])
            return 0;
    out->s = (char[:]){ self->s.data + p.len, self->s.len - p.len };
    return 1;
}

/* 去掉后缀：语义与 strip_prefix 对称 */
int strip_suffix(Str *self, char[:] p, Str *out)
{
    int i = 0;
    int b = self->s.len - p.len;

    if (p.len > self->s.len)
        return 0;
    for (i = 0; i < p.len; i++)
        if (self->s[b + i] != p[i])
            return 0;
    out->s = (char[:]){ self->s.data, b };
    return 1;
}

/* 在 from 处是否正好是 needle */
int find_at(Str *self, int from, char[:] needle)
{
    int j = 0;

    if (from < 0 || from + needle.len > self->s.len)
        return 0;
    for (j = 0; j < needle.len; j++)
        if (self->s[from + j] != needle[j])
            return 0;
    return 1;
}

/* 把 needle 全部换成 repl，结果写进 dst（cap 含 NUL）：
   成功返回写入长度，空间不够返回 -1（不写半截），needle 为空返回错误。
   注意 repl 可以比 needle 长，dst 必须够大。 */
int replace(Str *self, char[:] needle, char[:] repl, char *dst, int cap)
{
    int i = 0, k = 0, at = 0, n = 0;

    if (needle.len == 0)
        return -2;
    if (cap <= 0)
        return -1;
    while (i < self->s.len) {
        if (self->s.len - i >= needle.len &&
            self->find_at(i, needle)) {
            n = repl.len;
            if (k + n + (self->s.len - i - needle.len) >= cap)
                return -1;
            if (n > 0)
                memcpy(dst + k, repl.data, (usize)n);
            k += n;
            i += needle.len;
        } else {
            if (k + 1 + (self->s.len - i - 1) >= cap)
                return -1;
            dst[k++] = self->s[i++];
        }
    }
    dst[k] = 0;
    at = k;
    return at;
}

/* 按第一个出现的 sep 切成两半：命中返回 1 并写 *head / *tail，
   没命中返回 0（不改 *head / *tail）。 */
int split_once(Str *self, char[:] sep, Str *head, Str *tail)
{
    int i = self->find(sep);

    if (i < 0)
        return 0;
    head->s = (char[:]){ self->s.data, i };
    tail->s = (char[:]){ self->s.data + i + sep.len,
                         self->s.len - i - sep.len };
    return 1;
}

/* 写进外部缓冲：成功返回写入长度，空间不够返回 -1（不写半截） */
int copy_to(Str *self, char *dst, int cap)
{
    if (cap <= self->s.len)
        return -1;
    memcpy(dst, self->s.data, (usize)self->s.len);
    dst[self->s.len] = 0;
    return self->s.len;
}

/* C 字符串 -> 视图（要 strlen；已知长度的字面量请用 S()） */
Str str(char *z)
{
    Str r = { (char[:]){ z, 0 } };

    if (z)
        r.s = (char[:]){ z, (int)strlen(z) };
    return r;
}

/* 按分隔符切分：空字段被跳过（"a,,b" 只给两个），`foreach (Str tok = (&s)->split(','))` */
struct Split {
    char[:] s;
    int pos;
    char sep;
};

/* 切分器有 `has()`/`next()` 两个方法，`foreach` 就能直接吃它。
   普通结构体不能在体内写方法体（只认第一个形参是指针），所以照旧写在体外：
   第一个形参是指针就自动注册成方法，`it->has()` 和 `it.has()` 是同一个调用。 */
int has(Split *self)
{
    while (self->pos < self->s.len) {
        if (self->s[self->pos] != self->sep)
            return 1;
        self->pos++;
    }
    return 0;
}

Str next(Split *self)
{
    Str r = { self->s };
    int b = self->pos;

    while (self->pos < self->s.len && self->s[self->pos] != self->sep)
        self->pos++;
    r.s = (char[:]){ self->s.data + b, self->pos - b };
    if (self->pos < self->s.len)
        self->pos++;          /* 跳过分隔符 */
    return r;
}

/* 切分器由 `Str` 造出来（`(&s)->split(',')`），但 `split` 的接收者必须是
   `Str` 才能注册成 `Str` 的方法；而 `Str` 的体在上面、改不得（见文件头），
   所以这里按「接收者就是第一个形参」的老写法留一个文件作用域函数。 */
Split split(Str *self, char sep)
{
    Split sp = { self->s, 0, sep };

    return sp;
}

/* 按行切分：结尾的 '\n' 不留空行，行尾的 '\r' 去掉（CRLF 文本） */
struct Lines {
    char[:] s;
    int pos;
};

int has(Lines *self) { return self->pos < self->s.len; }

Str next(Lines *self)
{
    Str r = { self->s };
    int b = self->pos;

    while (self->pos < self->s.len && self->s[self->pos] != '\n')
        self->pos++;
    r.s = (char[:]){ self->s.data + b, self->pos - b };
    if (self->pos < self->s.len)
        self->pos++;          /* 跳过 '\n' */
    if (r.s.len > 0 && r.s.data[r.s.len - 1] == '\r')
        r.s = (char[:]){ r.s.data, r.s.len - 1 };
    return r;
}

Lines lines(Str *self)
{
    Lines l = { self->s, 0 };

    return l;
}

/* 用 sep 把 n 个 Str 连起来写进 dst（要能放下结果 + 结尾 NUL）：
   成功返回长度，空间不够返回 -1（不写半截） */
int join(Str *parts, int n, char sep, char *dst, int cap)
{
    int i = 0, j = 0, k = 0, need = n > 0 ? n - 1 : 0;

    for (i = 0; i < n; i++)
        need += parts[i].s.len;
    if (cap <= need)
        return -1;
    for (i = 0; i < n; i++) {
        for (j = 0; j < parts[i].s.len; j++)
            dst[k++] = parts[i].s.data[j];
        if (i + 1 < n)
            dst[k++] = sep;
    }
    dst[k] = 0;
    return k;
}

/* 按空白切分：连续空白只算一个分隔，空字段被跳过（"  a  b " 给 a、b）。
   `foreach (Str w = (&s)->fields()) { ... }` */
struct Fields {
    char[:] s;
    int pos;
};

int has(Fields *self)
{
    int n = self->s.len;

    while (self->pos < n && is_space(self->s[self->pos]))
        self->pos++;
    return self->pos < n;
}

Str next(Fields *self)
{
    Str r = { self->s };
    int b = 0;
    int n = self->s.len;

    while (self->pos < n && is_space(self->s[self->pos]))
        self->pos++;
    b = self->pos;
    while (self->pos < n && !is_space(self->s[self->pos]))
        self->pos++;
    r.s = (char[:]){ self->s.data + b, self->pos - b };
    return r;
}

Fields fields(Str *self)
{
    Fields f = { self->s, 0 };

    return f;
}

/* ---- 自测 ---- */

test "S() 给出不含结尾 NUL 的长度" {
    Str s = { S("hello") };
    Str *p = &s;
    Str e = { S("") };
    Str *pe = &e;

    if (p->count() != 5)
        return err(1, "S(\"hello\") 的长度不是 5");
    if (pe->count() != 0)
        return err(2, "S(\"\") 的长度不是 0");
    if (p->at(0) != 'h' || p->at(4) != 'o')
        return err(3, "at 不对");
    if (p->at(5) != 0)
        return err(4, "越界没有返回 0");
}

test "str() 接 C 字符串" {
    Str s = str((char *)"abc");
    Str *p = &s;

    if (p->count() != 3)
        return err(5, "str() 的长度不对");
    if (!p->eq(S("abc")))
        return err(6, "str() 的内容不对");
    if (p->count() != 3 || p->is_empty())
        return err(7, "空判断不对");
}

test "比较与相等" {
    Str a = { S("abc") };
    Str b = { S("abd") };
    Str c = { S("abc") };
    Str d = { S("ab") };
    Str *pa = &a, *pb = &b, *pd = &d;

    if (!pa->eq(c.s))
        return err(8, "相同内容不相等");
    if (pa->eq(b.s))
        return err(9, "不同内容相等了");
    if (pa->cmp(b.s) != -1 || pb->cmp(a.s) != 1)
        return err(10, "cmp 的正负不对");
    if (pa->cmp(d.s) != 1 || pd->cmp(a.s) != -1)
        return err(11, "前缀关系不对");
}

test "find / find_char / starts_with / ends_with" {
    Str s = { S("hello world") };
    Str *p = &s;

    if (p->find(S("world")) != 6)
        return err(12, "find 子串不对");
    if (p->find(S("zzz")) != -1)
        return err(13, "找不到时应返回 -1");
    if (p->find_char('o') != 4)
        return err(14, "find_char 不对");
    if (!p->starts_with(S("hello")) || p->starts_with(S("world")))
        return err(15, "starts_with 不对");
    if (!p->ends_with(S("world")) || p->ends_with(S("hello")))
        return err(16, "ends_with 不对");
}

test "trim / take / drop / sub 都是视图" {
    Str s = { S("  hi \t") };
    Str *p = &s;
    Str t = p->trim();
    Str *pt = &t;
    Str a = p->take(3);
    Str b = p->drop(2);
    Str *pb = &b;
    Str c = p->sub(2, 2);
    Str *pc = &c;

    if (pt->count() != 2 || !pt->eq(S("hi")))
        return err(17, "trim 不对");
    if ((&a)->count() != 3)
        return err(18, "take 不对");
    if (!pb->eq(S("hi \t")))
        return err(19, "drop 不对");
    if (!pc->eq(S("hi")))
        return err(20, "sub 不对");
    /* 视图指回原内存 */
    if (t.s.data != s.s.data + 2)
        return err(21, "trim 没有指回原内存");
}

/* 成功返回 0，失败把错误 id 带出来（catch 体必须以 return/err/goto 结束） */
int to_int_id(Str *s)
{
    int v = 0;

    s->to_int(&v) catch e { return e.id; };
    return 0;
}

test "十进制解析" {
    Str a = { S(" -42 ") };
    Str b = { S("7") };
    Str c = { S("12x") };
    Str d = { S("99999999999") };
    int v = 0;

    (&a)->to_int(&v) catch e { return err(22, "负数解析失败"); };
    if (v != -42)
        return err(23, "负数解析结果不对");
    (&b)->to_int(&v) catch e { return err(24, "正数解析失败"); };
    if (v != 7)
        return err(25, "正数解析结果不对");
    if (to_int_id(&c) != 2)
        return err(26, "非法字符应报 id 2");
    if (to_int_id(&d) != 3)
        return err(27, "溢出应报 id 3");
}

test "copy_to 不写半截" {
    char buf[4] = { 0, 0, 0, 0 };
    Str ok = { S("abc") };
    Str big = { S("abcdef") };

    if ((&ok)->copy_to(buf, 4) != 3)
        return err(28, "copy_to 成功时应返回长度");
    if (strcmp(buf, "abc") != 0)
        return err(29, "copy_to 内容不对");
    if ((&big)->copy_to(buf, 4) != -1)
        return err(30, "空间不够时应返回 -1");
    if (strcmp(buf, "abc") != 0)
        return err(31, "空间不够时改写了缓冲");
}

test "contains / last_find / count_char / count_sub" {
    Str s = { S("a,b,c,b") };
    Str *p = &s;

    if (!p->contains(S("b,c")) || p->contains(S("zz")))
        return err(32, "contains 不对");
    if (p->last_find(S("b")) != 6)
        return err(33, "last_find 不对");
    if (p->last_find(S("zz")) != -1)
        return err(34, "last_find 找不到应返回 -1");
    if (p->last_find(S("")) != 7)
        return err(35, "空 needle 应返回 count()");
    if (p->last_find_char('b') != 6 || p->last_find_char('z') != -1)
        return err(36, "last_find_char 不对");
    if (p->count_char(',') != 3 || p->count_char('z') != 0)
        return err(37, "count_char 不对");
    if (p->count_sub(S("b")) != 2 || p->count_sub(S("bb")) != 0)
        return err(38, "count_sub 不对");
    if (p->count_sub(S("")) != 0)
        return err(39, "空 needle 应记 0 次");
}

test "hash 对相同内容稳定" {
    Str a = { S("hello") };
    Str b = { S("hello") };
    Str c = { S("hellp") };

    if ((&a)->hash() != (&b)->hash())
        return err(40, "相同内容哈希不同");
    if ((&a)->hash() == (&c)->hash())
        return err(41, "不同内容的哈希撞了");
    /* 已知向量：与 std/core/hash 的 fnv1a_bytes 必须是同一个值 */
    if ((&a)->hash() != 0x4f9f2cabu)
        return err(76, "FNV-1a 32 的已知向量不对");
    if ((&a)->hash() == 0x811c9dc5u)   /* 空串的值，不该撞 */
        return err(77, "非空串的哈希等于空串的哈希");
}

test "trim_left / trim_right 只动一边" {
    Str s = { S("  hi \t") };
    Str l = (&s)->trim_left();
    Str r = (&s)->trim_right();

    if ((&l)->count() != 4 || !(&l)->eq(S("hi \t")))
        return err(42, "trim_left 不对");
    if ((&r)->count() != 4 || !(&r)->eq(S("  hi")))
        return err(43, "trim_right 不对");
    if ((&s)->count() != 6 || s.s.data[0] != ' ')
        return err(44, "trim 改动了原视图");
}

test "copy_upper / copy_lower" {
    Str s = { S("Ab,cd") };
    char buf[8] = { 0 };
    char small[4] = { 0 };

    if ((&s)->copy_upper(buf, 8) != 5 || strcmp(buf, "AB,CD") != 0)
        return err(45, "copy_upper 不对");
    if ((&s)->copy_lower(buf, 8) != 5 || strcmp(buf, "ab,cd") != 0)
        return err(46, "copy_lower 不对");
    if ((&s)->copy_upper(small, 4) != -1)
        return err(47, "空间不够应返回 -1");
}

test "split 跳过空字段" {
    Str s = { S("a,,b,c") };
    int n = 0, sum = 0, ok = 0;

    foreach (Str tok = (&s)->split(',')) {
        n++;
        sum += tok.s.len;
        if (n == 2 && tok.s.len == 1 && tok.s.data[0] == 'b')
            ok = 1;
    }
    if (n != 3 || sum != 3 || !ok)
        return err(48, "split 结果不对");
}

test "lines 去掉换行与 CRLF 的 CR" {
    Str s = { S("a\r\nbb\n") };
    int n = 0, ok = 0;

    foreach (Str line = (&s)->lines()) {
        n++;
        if (n == 1 && line.s.len == 1 && line.s.data[0] == 'a')
            ok |= 1;
        if (n == 2 && line.s.len == 2 && line.s.data[0] == 'b')
            ok |= 2;
    }
    if (n != 2 || ok != 3)
        return err(49, "lines 结果不对");
}

test "join 拼接并检查空间" {
    Str parts[3] = { { S("a") }, { S("bb") }, { S("c") } };
    char buf[16] = { 0 };
    char small[8] = { 0 };

    if (join(parts, 3, '-', buf, 16) != 6 || strcmp(buf, "a-bb-c") != 0)
        return err(50, "join 结果不对");
    if (join(parts, 3, '-', small, 6) != -1)
        return err(51, "空间不够应返回 -1");
    if (small[0] != 0)
        return err(52, "空间不够时不该写");
}

test "to_base 解析 2..36 进制" {
    Str hex = { S("ff") };
    Str bin = { S("1010") };
    Str dec = { S(" 42 ") };
    Str bad = { S("xyz") };
    Str big = { S("fffffffff") };
    u32 v = 0u;
    u32 *pv = &v;

    hex.to_base(16, pv) catch e { return err(53, "ff 解析失败"); };
    if (v != 255u)
        return err(54, "0xff 应为 255");
    bin.to_base(2, pv) catch e { return err(55, "1010 解析失败"); };
    if (v != 10u)
        return err(56, "0b1010 应为 10");
    dec.to_base(10, pv) catch e { return err(57, "42 解析失败"); };
    if (v != 42u)
        return err(58, "带空白的 42 不对");
    bad.to_base(10, pv) catch e { goto bad_ok; };
    return err(59, "xyz 不该解析成功");
bad_ok:
    big.to_base(16, pv) catch e { goto big_ok; };
    return err(60, "超出 u32 的数不该解析成功");
big_ok:
    hex.to_base(1, pv) catch e { goto base_ok; };
    return err(61, "base 1 应当报错");
base_ok:
    return 0;
}

test "cmp_str / cmp_cstr" {
    Str a = { S("abc") };
    Str b = { S("abd") };
    Str c = { S("abc") };
    Str empty = { S("") };

    if (a.cmp_str(&b) != -1 || b.cmp_str(&a) != 1 || a.cmp_str(&c) != 0)
        return err(62, "cmp_str 不对");
    if (a.cmp_cstr((char *)"abd") != -1 || a.cmp_cstr((char *)"abc") != 0)
        return err(63, "cmp_cstr 不对");
    if (empty.cmp_cstr((char *)"") != 0 || empty.cmp_cstr(0) != 0)
        return err(64, "空串比较不对");
    if (empty.cmp_str(&a) != -1)
        return err(65, "空串应当更小");
}

test "replace 全部替换，空间不够不写半截" {
    Str s = { S("a-b-c") };
    char buf[16] = { 0 };
    char tiny[5] = { 0 };
    Str n = { S("-") };
    Str r = { S("::") };

    if (s.replace(n.s, r.s, buf, sizeof(buf)) != 7)
        return err(66, "替换长度不对");
    if (strcmp(buf, "a::b::c") != 0)
        return err(67, "替换结果不对");
    if (s.replace(n.s, r.s, tiny, sizeof(tiny)) != -1)
        return err(68, "空间不够应返回 -1");
    if (tiny[0] != 0)
        return err(69, "空间不够时不该写");
}

test "split_once 只按第一个分隔符切" {
    Str s = { S("k=v=w") };
    Str head = { S("x") };
    Str tail = { S("y") };
    Str sep = { S("=") };
    Str miss = { S("zzz") };
    char buf[8] = { 0 };

    if (s.split_once(sep.s, &head, &tail) != 1)
        return err(70, "split_once 没命中");
    if (head.count() != 1 || head.s.data[0] != 'k')
        return err(71, "head 不对");
    if (tail.count() != 3)
        return err(72, "tail 长度不对");
    if (tail.copy_to(buf, sizeof(buf)) != 3 || strcmp(buf, "v=w") != 0)
        return err(73, "tail 内容不对");
    if (s.split_once(miss.s, &head, &tail) != 0)
        return err(74, "没命中应当返回 0");
    if (head.count() != 1 || head.s.data[0] != 'k')
        return err(75, "没命中时不该改 head");
}

test "to_u64 解析与四类错误" {
    Str a = { S("  18446744073709551615 ") };
    Str b = { S("+42") };
    Str c = { S("-1") };
    Str d = { S("") };
    Str e = { S("12x") };
    Str f = { S("18446744073709551616") };
    u64 v = 0ull;
    int bad = 0;

    (&a)->to_u64(&v) catch e { return err(78, "最大 u64 解析失败"); };
    if (v != 18446744073709551615ull)
        return err(79, "最大 u64 的值不对");
    (&b)->to_u64(&v) catch e { return err(80, "正号解析失败"); };
    if (v != 42ull)
        return err(81, "正号解析的值不对");
    (&c)->to_u64(&v) catch e {
        bad = e.id;
        goto c_done;
    };
    return err(82, "负数却没报错");
c_done:
    if (bad != 2)
        return err(83, "负数应报错码 2");
    bad = 0;
    (&d)->to_u64(&v) catch e {
        bad = e.id;
        goto d_done;
    };
    return err(84, "空串却没报错");
d_done:
    if (bad != 1)
        return err(85, "空串应报错码 1");
    bad = 0;
    (&e)->to_u64(&v) catch e {
        bad = e.id;
        goto e_done;
    };
    return err(86, "非数字却没报错");
e_done:
    if (bad != 2)
        return err(87, "非数字应报错码 2");
    bad = 0;
    (&f)->to_u64(&v) catch e {
        bad = e.id;
        goto f_done;
    };
    return err(88, "越界却没报错");
f_done:
    if (bad != 3)
        return err(89, "越界应报错码 3");
}

test "strip_prefix / strip_suffix 只动命中" {
    Str s = { S("hello.c6") };
    Str pre = { S("hello") };
    Str suf = { S(".c6") };
    Str miss = { S("x") };
    Str out = { S("keep") };
    Str *po = &out;

    if ((&s)->strip_prefix(pre.s, &out) != 1 || !po->eq(S(".c6")))
        return err(90, "strip_prefix 没命中");
    if ((&s)->strip_suffix(suf.s, &out) != 1 || !po->eq(S("hello")))
        return err(91, "strip_suffix 没命中");
    po->s = S("keep");
    if ((&s)->strip_prefix(miss.s, &out) != 0)
        return err(92, "strip_prefix 不该命中");
    if (po->count() != 4)
        return err(93, "没命中时改动了 *out");
}

test "fields 按空白切分，空字段跳过" {
    Str s = { S("  one\ttwo \n three ") };
    int n = 0, total = 0;

    foreach (Str w = (&s)->fields()) {
        n++;
        total += (&w)->count();
    }
    if (n != 3 || total != 11)
        return err(94, "fields 轮数/长度不对");
}

test "fields 空输入与全空白不产生字段" {
    Str e = { S("") };
    Str sp = { S(" \t\r\n ") };
    int n = 0;

    foreach (Str w = (&e)->fields()) {
        n++;
        if ((&w)->count() > 0)
            return err(95, "空串产生了非空字段");
    }
    foreach (Str w2 = (&sp)->fields()) {
        n++;
        if ((&w2)->count() > 0)
            return err(96, "全空白产生了非空字段");
    }
    if (n != 0)
        return err(97, "空输入不该产生字段");
}
