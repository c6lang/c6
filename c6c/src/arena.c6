/* arena.c6 —— 阶段式内存：整块链，永不 free 单条（design.md §9）
 *
 * 为什么不用 malloc/条目：design.md §9 列了五个内存陷阱，第一个就是“每节点一次
 * malloc”。编译器的分配要么活到 TU 结束（声明表、类型表、行号表），要么活到
 * 函数结束（IR）。两者都用“整段释放”，所以只需要块链 + 一个游标。
 *
 * 预算：60k 行自编译时 arena 总占用应 ≤10 MB（≈170 B/行）。
 */

#define ARENA_BLOCK (64u * 1024u)

typedef struct ArenaBlock {
    struct ArenaBlock *next;
    size_t cap;
    size_t used;
} ArenaBlock;

typedef struct Arena {
    ArenaBlock *head;
    size_t total;      /* 已从内核拿到的字节数，供 --scan 报内存 */
} Arena;

static Arena A_main;
/* 优化器的临时数组放在这里，每个函数前后整块回收，否则自编译时
 * 每函数几 MB 的 use/known/val 数组会把 RSS 顶爆（实测 O2 49MB / O3 59MB）。 */
static Arena A_opt;

static void arena_reset(Arena *a)
{
    ArenaBlock *b = a->head;

    while (b) {
        ArenaBlock *next = b->next;

        free(b);
        b = next;
    }
    a->head = 0;
    a->total = 0;
}

/* 分项统计（-v 时打印）：arena 里谁在吃内存，得先量再改。
 * 只加一次加法，热路径上没有分支。 */
enum {
    A_MISC = 0, A_MBODY, A_MSTRUCT, A_EXP, A_DIR, A_HIDE, A_IF, A_SRC, A_FILE,
    A_NTAG
};
static const char *const A_TAGNAME[A_NTAG] = {
    "其它", "宏体", "宏结构", "展开结果", "指令行", "隐藏集", "#if 求值",
    "源栈兜底", "文件"
};
static size_t A_TAG[A_NTAG];

static void *arena_alloc_t(Arena *a, size_t n, int tag);

static void arena_report(void)
{
    int i = 0;

    fprintf(stderr, "arena 总计 %.2f MB\n", (double)A_main.total / (1024.0 * 1024.0));
    for (i = 0; i < A_NTAG; i++)
        if (A_TAG[i])
            fprintf(stderr, "  %-10s %8.2f MB\n", A_TAGNAME[i],
                    (double)A_TAG[i] / (1024.0 * 1024.0));
}

/* 16 字节对齐：c6 的 long double 是 16 字节对齐，结构体里可能放得下 */
static void *arena_alloc(Arena *a, size_t n)
{
    ArenaBlock *b = a->head;
    void *p = NULL;

    n = (n + 15u) & ~(size_t)15u;
    if (!b || b->cap - b->used < n) {
        size_t cap = n > ARENA_BLOCK ? n : ARENA_BLOCK;
        b = malloc(sizeof(ArenaBlock) + cap);
        if (!b) {
            fprintf(stderr, "c6c: 内存耗尽（arena 申请 %lu 字节）\n", (unsigned long)n);
            exit(2);
        }
        b->cap = cap;
        b->used = 0;
        b->next = a->head;
        a->head = b;
        a->total += cap + sizeof(ArenaBlock);
    }
    p = (char *)(b + 1) + b->used;
    b->used += n;
    return p;
}

static void *arena_zalloc(Arena *a, size_t n)
{
    void *p = arena_alloc(a, n);
    memset(p, 0, n);
    return p;
}

static char *arena_strndup(Arena *a, const char *s, size_t n)
{
    char *p = arena_alloc(a, n + 1);
    memcpy(p, s, n);
    p[n] = 0;
    return p;
}

static char *arena_strdup(Arena *a, const char *s)
{
    return arena_strndup(a, s, strlen(s));
}

static void *arena_zalloc_t(Arena *a, size_t n, int tag)
{
    void *p = arena_alloc_t(a, n, tag);
    memset(p, 0, n);
    return p;
}

static char *arena_strndup_t(Arena *a, const char *s, size_t n, int tag)
{
    char *p = arena_alloc_t(a, n + 1, tag);
    memcpy(p, s, n);
    p[n] = 0;
    return p;
}

static void *arena_alloc_t(Arena *a, size_t n, int tag)
{
    A_TAG[tag] += (n + 15u) & ~(size_t)15u;
    return arena_alloc(a, n);
}
