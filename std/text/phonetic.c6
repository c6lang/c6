/* std/text/phonetic：英文姓名/单词的发音编码（Soundex 与简化版 Metaphone）。
 *
 *     import std.text.phonetic;
 *
 *     char a[16] = { 0 };
 *     char b[16] = { 0 };
 *     soundex(S("Robert"), a);      // "R163"
 *     soundex(S("Rupert"), b);      // "R163"
 *     phone_same((char[:]){ a, 4 }, (char[:]){ b, 4 });   // 1
 *
 * Soundex（经典 4 字符码）：保留首字母，按表给后续辅音编码
 * `b f p v`=1、`c g j k q s x z`=2、`d t`=3、`l`=4、`m n`=5、`r`=6；
 * `a e i o u y` 是「分隔」、`h w` 直接忽略（不打断相邻同码）；同码相邻只留一个，
 * 不足 4 位补 0。
 *
 * Metaphone（简化版，只做常见规则）：转大写、只留字母；开端 `KN`→N、`WR`→R、
 * `GN`→N、`PH`→F、`TH`→0、`SH`/`CH`→X；`C` 在 `e i y` 前是 S 否则 K；`G` 在
 * `e i y` 前是 J 否则 K；`Q`→K、`X`→KS、`Z`→S；其余辅音保留、元音（除首字母）
 * 丢掉；相邻重复字母只留一个。
 *
 * 约定：
 *
 * - 两个函数都只输出大写 ASCII，`soundex` 固定 4 个字符（没有字母时输出
 *   `"0000"），`metaphone` 长度不定；
 * - 容量不够返回 -1；`soundex`/`metaphone` 成功时返回写入长度；
 * - `phone_same` 比较两个编码串（大小写不敏感），任一为空返回 0；
 * - 简化版 Metaphone **不是** Lawrence Philips 的完整算法，`ough`、软 `CH` 等
 *   特例没有覆盖，只保证「常见拼写变体码相同」。
 */
#include <string.h>

module std.text.phonetic;
import std.core.types;
import std.text.str;

static char phone_upper(char c)
{
    if (c >= 'a' && c <= 'z')
        return (char)(c - 'a' + 'A');
    return c;
}

static int phone_is_alpha(char c)
{
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
}

static int soundex_code(char c)
{
    if (c == 'B' || c == 'F' || c == 'P' || c == 'V')
        return '1';
    if (c == 'C' || c == 'G' || c == 'J' || c == 'K' || c == 'Q' || c == 'S'
        || c == 'X' || c == 'Z')
        return '2';
    if (c == 'D' || c == 'T')
        return '3';
    if (c == 'L')
        return '4';
    if (c == 'M' || c == 'N')
        return '5';
    if (c == 'R')
        return '6';
    return 0;
}

int soundex(char[:] name, char *dst)
{
    int i = 0, o = 0, last = 0;
    char first = 0;

    if (!name.data || !dst)
        return -1;
    for (i = 0; i < name.len; i++) {
        if (phone_is_alpha(name.data[i])) {
            first = phone_upper(name.data[i]);
            break;
        }
    }
    if (first == 0) {
        memcpy(dst, "0000", 5);
        return 4;
    }
    dst[o++] = first;
    last = soundex_code(first);
    for (i = i + 1; i < name.len && o < 4; i++) {
        char c = phone_upper(name.data[i]);
        int code = 0;

        if (!phone_is_alpha(c))
            continue;
        if (c == 'H' || c == 'W')
            continue;                   /* 不打断同码 */
        code = soundex_code(c);
        if (code == 0) {
            last = 0;                   /* 元音：断开 */
            continue;
        }
        if (code != last) {
            dst[o++] = (char)code;
            last = code;
        }
    }
    while (o < 4)
        dst[o++] = '0';
    dst[o] = 0;
    return 4;
}

int metaphone(char[:] word, char *dst, int cap)
{
    char up[64] = { 0 };
    char tmp[64] = { 0 };
    int n = 0, i = 0, o = 0, k = 0, prev = 0;

    if (!word.data || !dst || cap <= 0)
        return -1;
    for (i = 0; i < word.len && n < 63; i++) {
        if (phone_is_alpha(word.data[i]))
            up[n++] = phone_upper(word.data[i]);
    }
    if (n == 0)
        return -1;
    /* 开端特例 */
    if (n >= 2 && up[0] == 'K' && up[1] == 'N') {
        memmove(up, up + 1, (size_t)(n - 1));
        n--;
    } else if (n >= 2 && up[0] == 'W' && up[1] == 'R') {
        memmove(up, up + 1, (size_t)(n - 1));
        n--;
    } else if (n >= 2 && up[0] == 'G' && up[1] == 'N') {
        memmove(up, up + 1, (size_t)(n - 1));
        n--;
    }
    for (i = 0; i < n && o < 62; i++) {
        char c = up[i];
        char nextc = i + 1 < n ? up[i + 1] : 0;

        if (c == prev)
            continue;                   /* 相邻重复只留一个 */
        prev = c;
        if (c == 'P' && nextc == 'H') {
            tmp[o++] = 'F';
            i++;
        } else if (c == 'T' && nextc == 'H') {
            tmp[o++] = '0';
            i++;
        } else if ((c == 'S' || c == 'C') && nextc == 'H') {
            tmp[o++] = 'X';
            i++;
        } else if (c == 'C') {
            if (nextc == 'E' || nextc == 'I' || nextc == 'Y')
                tmp[o++] = 'S';
            else
                tmp[o++] = 'K';
        } else if (c == 'G') {
            if (nextc == 'E' || nextc == 'I' || nextc == 'Y')
                tmp[o++] = 'J';
            else
                tmp[o++] = 'K';
        } else if (c == 'Q') {
            tmp[o++] = 'K';
        } else if (c == 'X') {
            tmp[o++] = 'K';
            tmp[o++] = 'S';
        } else if (c == 'Z') {
            tmp[o++] = 'S';
        } else if (c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U') {
            if (i == 0)
                tmp[o++] = c;           /* 首字母元音保留 */
        } else if (c == 'H' || c == 'W' || c == 'Y') {
            continue;
        } else {
            tmp[o++] = c;
        }
    }
    if (o >= cap)
        return -1;
    for (i = 0; i <= o; i++)
        dst[i] = tmp[i];
    (void)k;
    return o;
}

int phone_same(char[:] a, char[:] b)
{
    int i = 0;

    if (a.len <= 0 || b.len <= 0 || a.len != b.len)
        return 0;
    for (i = 0; i < a.len; i++) {
        if (phone_upper(a.data[i]) != phone_upper(b.data[i]))
            return 0;
    }
    return 1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "soundex：经典码" {
    char a[8] = { 0 };
    char b[8] = { 0 };

    if (soundex(S("Robert"), a) != 4 || memcmp(a, "R163", 4) != 0)
        return err(1, "Robert 应该是 R163");
    if (soundex(S("Rupert"), b) != 4 || memcmp(b, "R163", 4) != 0)
        return err(2, "Rupert 应该是 R163");
    if (phone_same((char[:]){ a, 4 }, (char[:]){ b, 4 }) != 1)
        return err(3, "Robert 与 Rupert 应该同码");
    if (soundex(S("Tymczak"), a) != 4 || memcmp(a, "T522", 4) != 0)
        return err(4, "Tymczak 应该是 T522");
    if (soundex(S("Pfister"), a) != 4 || memcmp(a, "P236", 4) != 0)
        return err(5, "Pfister 应该是 P236");
    if (soundex(S("Ashcraft"), a) != 4 || memcmp(a, "A261", 4) != 0)
        return err(6, "Ashcraft 应该是 A261（h/w 不打断）");
    if (soundex(S("Lee"), a) != 4 || memcmp(a, "L000", 4) != 0)
        return err(7, "Lee 应该是 L000");
    if (soundex(S("123"), a) != 4 || memcmp(a, "0000", 4) != 0)
        return err(8, "没有字母应该是 0000");
    if (soundex(S("  robert  "), a) != 4 || memcmp(a, "R163", 4) != 0)
        return err(9, "前后空白与非字母应该跳过");
}

test "metaphone：简化规则" {
    char a[32] = { 0 };
    char b[32] = { 0 };
    int n = 0;

    n = metaphone(S("Smith"), a, (int)sizeof a);
    if (n <= 0 || memcmp(a, "SM0", 3) != 0)
        return err(10, "Smith 应该以 SM0 开头");
    if (metaphone(S("Smyth"), b, (int)sizeof b) != n
        || phone_same((char[:]){ a, n }, (char[:]){ b, n }) != 1)
        return err(11, "Smith 与 Smyth 应该同码");
    n = metaphone(S("Knight"), a, (int)sizeof a);
    if (n <= 0 || a[0] != 'N')
        return err(12, "Knight 的开端 KN 应该折成 N");
    n = metaphone(S("phone"), a, (int)sizeof a);
    if (n <= 0 || a[0] != 'F')
        return err(13, "phone 的 PH 应该折成 F");
    n = metaphone(S("civic"), a, (int)sizeof a);
    if (n <= 0 || a[0] != 'S' || a[1] != 'V')
        return err(14, "civic 的软 C 应该折成 S");
    n = metaphone(S("Exit"), a, (int)sizeof a);
    if (n <= 0 || memcmp(a, "EKST", 4) != 0)
        return err(15, "Exit 的 X 应该展开成 KS");
    if (metaphone(S("???")[0:3], a, (int)sizeof a) != -1)
        return err(16, "没有字母应该 -1");
    if (metaphone(S("hello"), a, 1) != -1)
        return err(17, "容量不够应该 -1");
    if (phone_same(S("ABC"), S("abc")) != 1 || phone_same(S("ABC"), S("ABD")) != 0)
        return err(18, "phone_same 比较不对");
}
