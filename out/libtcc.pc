prefix=${pcfiledir}/../..
exec_prefix=${prefix}
bindir=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include
tccdir=${prefix}/lib/tcc

Name: libtcc
Description: libtcc - TinyCC/c6 embeddable C compiler library
URL: https://github.com/c6lang/c6
Version: 0.6.0
Libs: -L${libdir} -ltcc
Libs.private: -lm -ldl -lpthread
Cflags: -I${includedir}

# 变量：pkgconf --variable=c6 c6 / pkgconf --variable=tccdir c6
c6=${bindir}/c6
libtcc1=${tccdir}/libtcc1.a
