/* std/text/hyphen：英文断词（连字符位置）—— VCCV 启发式 + 最小前后缀约束。
 *
 *     import std.text.hyphen;
 *
 *     Hyphenator h = { 0 };
 *     h.init(5, 2, 3);                  // 最短 5 字母；头 2 尾 3 不动
 *     char out[64] = { 0 };
 *     h.hyphenate("hyphenation", 11, '-', out, sizeof out);   // "hyphen-ation"
 *     int pos[8] = { 0 };
 *     int n = h.breaks("computer", 8, pos, 8);                // 3, com-put-er
 *
 * 说明白点：**这是启发式，不是 TeX 的断词字典**。规则是经典的「元音-辅音-辅音-元音
 * 之间断」（VCCV），再加几条常见前后缀（`-tion`、`-ing`、`-ment`、`pre-`、`un-`…）。
 * 好处是零依赖、可预测、对普通英文单词命中率不错；代价是会有错（"pro-ject" 与
 * "proj-ect" 这种要靠字典）。要出版级排版请用断词词典，这里的目标是「终端/邮件里
 * 折行不要太难看」。
 *
 * 约束（都可配）：
 *
 * - 单词短于 `min_len` 不断；
 * - 断点离词首至少 `min_head` 个字母、离词尾至少 `min_tail` 个（默认 2/3）；
 * - 只在 ASCII 字母组成的词上工作，含数字/非 ASCII 直接返回 0（不猜）。
 */
#include <string.h>

module std.text.hyphen;
import std.core.types;

enum Error { OK = 0, PARSE = 1, INVAL = 2, RANGE = 3 };

struct Hyphenator {
    int min_len;
    int min_head;
    int min_tail;
    int ready;
};

void init(Hyphenator *h, int min_len, int min_head, int min_tail)
{
    if (!h)
        return;
    memset(h, 0, sizeof *h);
    h->min_len = min_len > 0 ? min_len : 5;
    h->min_head = min_head > 0 ? min_head : 2;
    h->min_tail = min_tail > 0 ? min_tail : 3;
    h->ready = 1;
}

int config(Hyphenator *h, int *min_len, int *min_head, int *min_tail)
{
    if (!h || !h->ready)
        return -1;
    if (min_len)
        *min_len = h->min_len;
    if (min_head)
        *min_head = h->min_head;
    if (min_tail)
        *min_tail = h->min_tail;
    return 0;
}

static int hy_low(int c)
{
    return (c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c;
}

static int hy_is_alpha(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

static int hy_is_vowel(int c)
{
    int l = hy_low(c);

    return l == 'a' || l == 'e' || l == 'i' || l == 'o' || l == 'u' || l == 'y';
}

/* 常见后缀：在「后缀起点」处断（返回模式串长度，0 = 没命中）。 */
static int hy_suffix(const char *w, int len, int at)
{
    static const char *const sufs[] = { "tion", "sion", "ment", "ness", "ing",
                                        "able", "ible", "ally", "less", "ful" };
    int rest = len - at;

    for (int i = 0; i < (int)(sizeof sufs / sizeof sufs[0]); i++) {
        int sl = (int)strlen(sufs[i]);

        if (sl == rest) {
            int ok = 1;

            for (int k = 0; k < sl; k++)
                if (hy_low((int)(unsigned char)w[at + k])
                    != (int)(unsigned char)sufs[i][k]) {
                    ok = 0;
                    break;
                }
            if (ok)
                return sl;
        }
    }
    return 0;
}

/* 常见前缀：在「前缀终点」处断（返回前缀长度，0 = 没命中）。 */
static int hy_prefix(const char *w, int len)
{
    static const char *const pre[] = { "un", "re", "pre", "dis", "over", "under" };

    for (int i = 0; i < (int)(sizeof pre / sizeof pre[0]); i++) {
        int pl = (int)strlen(pre[i]);

        if (pl < len) {
            int ok = 1;

            for (int k = 0; k < pl; k++)
                if (hy_low((int)(unsigned char)w[k]) != (int)(unsigned char)pre[i][k]) {
                    ok = 0;
                    break;
                }
            if (ok)
                return pl;
        }
    }
    return 0;
}

/* 计算断点（返回断点个数；pos 里存「断点后的下标」）。 */
int breaks(Hyphenator *h, const char *word, int len, int *pos, int max)
{
    int n = 0;
    int plen = 0;

    if (!h || !h->ready || !word || len <= 0 || !pos || max <= 0)
        return -1;
    if (len < h->min_len)
        return 0;
    for (int i = 0; i < len; i++)
        if (!hy_is_alpha((int)(unsigned char)word[i]))
            return 0;           /* 含数字/非字母：不猜 */
    /* 前缀断点 */
    plen = hy_prefix(word, len);
    if (plen >= h->min_head && len - plen >= h->min_tail) {
        if (n < max)
            pos[n++] = plen;
    }
    /* VCCV：在两个辅音之间断（第 2 个辅音之前） */
    for (int i = 1; i + 2 < len; i++) {
        if (hy_is_vowel((int)(unsigned char)word[i - 1])
            && !hy_is_vowel((int)(unsigned char)word[i])
            && !hy_is_vowel((int)(unsigned char)word[i + 1])
            && hy_is_vowel((int)(unsigned char)word[i + 2])) {
            int at = i + 1;

            if (at < h->min_head || len - at < h->min_tail)
                continue;
            if (n > 0 && pos[n - 1] == at)
                continue;
            if (n < max)
                pos[n++] = at;
        }
    }
    /* 后缀断点 */
    for (int at = h->min_head; at + h->min_tail <= len; at++)
        if (hy_suffix(word, len, at)) {
            if (n > 0 && pos[n - 1] == at)
                continue;
            if (n < max)
                pos[n++] = at;
        }
    /* 排序（断点本来大致有序，这里做个插入排序保证） */
    for (int i = 1; i < n; i++) {
        int v = pos[i];
        int j = i - 1;

        while (j >= 0 && pos[j] > v) {
            pos[j + 1] = pos[j];
            j--;
        }
        pos[j + 1] = v;
    }
    return n;
}

/* 在断点处插入 sep；返回输出长度，失败 -1。 */
int hyphenate(Hyphenator *h, const char *word, int len, char sep, char *out,
              int cap)
{
    int pos[32] = { 0 };
    int n = 0;
    int o = 0;
    int k = 0;

    if (!h || !word || !out || cap <= 0)
        return -1;
    n = breaks(h, word, len, pos, 32);
    if (n < 0)
        return -1;
    for (int i = 0; i < len; i++) {
        if (o + 1 + 1 > cap)
            return -1;
        out[o++] = word[i];
        while (k < n && pos[k] == i + 1) {
            if (o + 1 + 1 > cap)
                return -1;
            out[o++] = sep;
            k++;
        }
    }
    out[o] = 0;
    return o;
}

/* ---- 自测 ---- */

test "hyphen：断点位置" {
    Hyphenator h = { 0 };
    int pos[8] = { 0 };
    int n = 0;

    h.init(5, 2, 3);
    /* 短词不断 */
    if (h.breaks("cat", 3, pos, 8) != 0)
        return err(1, "3 字母的词不该断");
    /* hyphenation：VCCV 断在 hyphen-ation，后缀 -tion 也命中 */
    n = h.breaks("hyphenation", 11, pos, 8);
    if (n <= 0)
        return err(2, "hyphenation 应该有断点");
    {
        int has7 = 0;

        for (int i = 0; i < n; i++)
            if (pos[i] == 7)
                has7 = 1;
        if (!has7)
            return err(3, "hyphenation 应在 7 处断（hyphen-ation，-tion 后缀）");
    }
    /* computer：com-put-er → 至少一个断点，且都满足头 2 尾 3 */
    n = h.breaks("computer", 8, pos, 8);
    if (n <= 0)
        return err(4, "computer 应该有断点");
    for (int i = 0; i < n; i++)
        if (pos[i] < 2 || 8 - pos[i] < 3)
            return err(5, "断点应满足最小前后缀约束");
    /* 断点递增且不重复 */
    for (int i = 1; i < n; i++)
        if (pos[i] <= pos[i - 1])
            return err(6, "断点应严格递增");
    /* 配置可改：min_len 调大后短词不断 */
    {
        Hyphenator h2 = { 0 };

        h2.init(12, 2, 3);
        if (h2.breaks("computer", 8, pos, 8) != 0)
            return err(7, "min_len=12 时 computer 不该断");
    }
}

test "hyphen：插入连字符、前后缀与坏输入" {
    Hyphenator h = { 0 };
    char out[64] = { 0 };
    int n = 0;

    h.init(5, 2, 3);
    n = h.hyphenate("hyphenation", 11, '-', out, sizeof out);
    if (n <= 0)
        return err(1, "hyphenate 失败");
    if (strchr(out, '-') == 0)
        return err(2, "输出里应有连字符");
    /* 去掉连字符后应还原成原词 */
    {
        char back[64] = { 0 };
        int k = 0;

        for (int i = 0; i < n; i++)
            if (out[i] != '-')
                back[k++] = out[i];
        back[k] = 0;
        if (strcmp(back, "hyphenation") != 0)
            return err(3, "去掉连字符应还原原词");
    }
    /* 短词原样输出 */
    if (h.hyphenate("cat", 3, '-', out, sizeof out) != 3 || strcmp(out, "cat") != 0)
        return err(4, "短词应原样");
    /* 前缀 unhappiness：un- 应成为一个断点 */
    {
        int pos[8] = { 0 };
        int cnt = h.breaks("unhappiness", 11, pos, 8);

        if (cnt <= 0)
            return err(5, "unhappiness 应有断点");
        if (pos[0] != 2)
            return err(6, "第一个断点应是 2（un-）");
    }
    /* 含数字/非字母：不猜 */
    {
        int pos[8] = { 0 };

        if (h.breaks("abc123", 6, pos, 8) != 0)
            return err(7, "含数字不该断");
        if (h.breaks("caf\xc3\xa9", 5, pos, 8) != 0)
            return err(8, "含非 ASCII 不该断");
    }
    /* 容量不足 */
    if (h.hyphenate("hyphenation", 11, '-', out, 4) != -1)
        return err(9, "容量不足应失败");
    if (h.breaks("abc", 3, 0, 8) != -1)
        return err(10, "pos 为空应失败");
}
