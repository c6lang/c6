/* stdpack：标准库第十四批（lz4 / rle / base85 / hexdump）的拼装示例。
 *
 * 和 stdform/stdtext/stdnum 一样：这个文件没有 `module`（入口 `main` 只能写在
 * 模块外的文件里），四节各带自检，失败打 FAIL，最后按失败数决定退出码。
 *
 * 四节讲的是一条「把二进制存下来/传出去」的链路：
 *
 *   - lz4：一段重复的遥测帧 → LZ4 块压缩 → 解回来（报告压缩率）；
 *   - rle：缓变采样先做差分、再走 PackBits RLE，比较「原始 / 差分+RLE」大小；
 *   - base85：二进制换成可打印文本（Ascii85 与 Z85 两套字母表，含标准向量）；
 *   - hexdump：按 8 字节一行、偏移从 0x1000 起排出文本，再反向解析回来。
 *
 * 编译（import 只带来声明，模块正文要单独列出来）：
 *
 *     ./tcc/c6 -B tcc -I . -o build/stdpack \
 *         examples/stdpack.c6 std/core/types.c6 \
 *         std/encoding/lz4.c6 std/encoding/rle.c6 std/encoding/base85.c6 \
 *         std/encoding/hexdump.c6
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.encoding.lz4;
import std.encoding.rle;
import std.encoding.base85;
import std.encoding.hexdump;

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int checks = 0;
static int fails = 0;

static void check(int cond, char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("FAIL: %s\n", what);
    }
}

/* LZ4：重复的遥测帧压缩与还原 */
static void tour_lz4(void)
{
    static char src[1024] = { 0 };
    static char packed[2048] = { 0 };
    static char back[1024] = { 0 };
    int table[LZ4_HASH_SIZE] = { 0 };
    const char *pat = "sensor=42;temp=21.5;";
    int plen = 20;
    int i = 0, n = 0, m = 0;

    for (i = 0; i < (int)sizeof src; i++)
        src[i] = pat[i % plen];
    n = lz4_compress(src, (int)sizeof src, packed, (int)sizeof packed, table,
                     LZ4_HASH_SIZE);
    check(n > 0, "lz4: 压缩成功");
    check(n < (int)sizeof src / 8, "lz4: 重复帧至少压到 1/8");
    printf("lz4: %d -> %d 字节（%.0f%%）\n", (int)sizeof src, n,
           100.0 * (double)n / (double)sizeof src);
    m = lz4_decompress(packed, n, back, (int)sizeof back);
    check(m == (int)sizeof src && memcmp(back, src, (size_t)m) == 0,
          "lz4: 往返一致");
    check(lz4_compress_bound((int)sizeof src) >= n, "lz4: 上界够用");
    /* 坏数据要拒绝：偏移为 0 */
    {
        const u8 bad[4] = { 0x10, 'a', 0x00, 0x00 };

        check(lz4_decompress(bad, 4, back, (int)sizeof back) == -1,
              "lz4: 偏移 0 拒绝");
    }
}

/* RLE + 差分：缓变采样 */
static void tour_rle(void)
{
    static char samples[256] = { 0 };
    static char delta[256] = { 0 };
    static char packed[512] = { 0 };
    static char un[256] = { 0 };
    static char back[256] = { 0 };
    int i = 0, dn = 0, rn = 0, m = 0;

    /* 缓慢上升的锯齿：相邻差基本是 3 */
    for (i = 0; i < (int)sizeof samples; i++)
        samples[i] = (char)((i * 3) & 0xff);
    dn = delta_encode(samples, (int)sizeof samples, delta, (int)sizeof delta);
    check(dn == (int)sizeof samples, "rle: 差分长度");
    rn = rle_encode(delta, dn, packed, (int)sizeof packed);
    check(rn > 0, "rle: 压缩成功");
    printf("rle: %d 字节采样 -> 差分 %d -> RLE %d 字节\n",
           (int)sizeof samples, dn, rn);
    check(rn < 64, "rle: 缓变数据压到 1/4 以下");
    m = rle_decode(packed, rn, un, (int)sizeof un);
    check(m == dn, "rle: RLE 解回差分");
    m = delta_decode(un, m, back, (int)sizeof back);
    check(m == (int)sizeof samples
              && memcmp(back, samples, (size_t)m) == 0,
          "rle: 差分还原");
    check(rle_encoded_len(delta, dn) == rn, "rle: 长度与实现一致");
    /* 坏数据：字面量越过末尾 */
    {
        const u8 bad[3] = { 0x05, 'a', 'b' };

        check(rle_decode(bad, 3, back, (int)sizeof back) == -1,
              "rle: 截断要拒绝");
    }
}

/* base85：二进制转文本 */
static void tour_base85(void)
{
    static char enc[256] = { 0 };
    static char dec[128] = { 0 };
    const u8 vec[8] = { 0x86, 0x4f, 0xd2, 0x6f, 0xb5, 0x59, 0xf7, 0x5b };
    char vecs[8] = { 0 };
    char blob[37] = { 0 };
    int i = 0, n = 0, m = 0;

    n = a85_encode(S("hello"), enc, (int)sizeof enc - 1);
    enc[n > 0 ? n : 0] = 0;
    check(n == 7 && strcmp(enc, "BOu!rDZ") == 0, "base85: Ascii85 的 hello");
    m = a85_decode((char[:]){ enc, n }, dec, (int)sizeof dec);
    check(m == 5 && memcmp(dec, "hello", 5) == 0, "base85: Ascii85 往返");

    for (i = 0; i < 8; i++)
        vecs[i] = (char)vec[i];
    n = z85_encode((char[:]){ vecs, 8 }, enc, (int)sizeof enc - 1);
    enc[n > 0 ? n : 0] = 0;
    check(n == 10 && strcmp(enc, "HelloWorld") == 0, "base85: Z85 标准向量");
    m = z85_decode((char[:]){ enc, n }, dec, (int)sizeof dec);
    check(m == 8 && memcmp(dec, vecs, 8) == 0, "base85: Z85 往返");

    /* 37 字节的任意二进制：Ascii85 往返 */
    for (i = 0; i < (int)sizeof blob; i++)
        blob[i] = (char)(i * 37 + 11);
    n = a85_encode((char[:]){ blob, (int)sizeof blob }, enc,
                   (int)sizeof enc - 1);
    check(n == a85_encoded_len((int)sizeof blob), "base85: Ascii85 长度");
    m = a85_decode((char[:]){ enc, n }, dec, (int)sizeof dec);
    check(m == (int)sizeof blob && memcmp(dec, blob, (size_t)m) == 0,
          "base85: 37 字节往返");
    check(!z85_valid((char[:]){ "abc", 3 }), "base85: Z85 长度约束");
}

/* hexdump：文本化与反向解析 */
static void tour_hexdump(void)
{
    static char text[1024] = { 0 };
    static char back[64] = { 0 };
    static char src[20] = { 0 };
    HexOpts o = hex_opts();
    int i = 0, n = 0, m = 0;

    for (i = 0; i < (int)sizeof src; i++)
        src[i] = "hexdump rocks!"[i % 14];
    o.width = 8;
    o.base = 0x1000u;
    n = hexdump(src, (int)sizeof src, (char[:]){ text, (int)sizeof text }, o);
    text[n > 0 ? n : 0] = 0;
    printf("---- hexdump(width=8, base=0x1000) ----\n%s", text);
    check(n == hexdump_len((int)sizeof src, o), "hexdump: 长度一致");
    check(strncmp(text, "00001000  ", 10) == 0, "hexdump: 偏移基数");
    m = hexundump((char[:]){ text, n }, (char[:]){ back, (int)sizeof back });
    check(m == (int)sizeof src && memcmp(back, src, (size_t)m) == 0,
          "hexdump: 反向解析");
    /* 纯十六进制（没有偏移）也认 */
    m = hexundump(S("48 65 6c 6c 6f\n"), (char[:]){ back, (int)sizeof back });
    check(m == 5 && memcmp(back, "Hello", 5) == 0, "hexdump: 纯 hex");
    /* 大写与关闭 ASCII 列 */
    o = hex_opts();
    o.upper = 1;
    o.ascii = 0;
    n = hexdump("\xde\xad", 2, (char[:]){ text, (int)sizeof text }, o);
    text[n > 0 ? n : 0] = 0;
    check(strncmp(text, "00000000  DE AD", 15) == 0, "hexdump: 大写、无 ASCII 列");
}

int main(void)
{
    printf("stdpack: 标准库第十四批（lz4 / rle / base85 / hexdump）\n");
    tour_lz4();
    tour_rle();
    tour_base85();
    tour_hexdump();
    printf("stdpack: %d check(s), %d failure(s)\n", checks, fails);
    return fails ? 1 : 0;
}
