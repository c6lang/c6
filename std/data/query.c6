/* std/data/query：URL 查询串 / form-urlencoded 的解析与构建（零分配）。
 *
 *     import std.data.query;
 *
 *     QueryReader r = query_open(S("a=1&b=hello+world&c=%E4%B8%AD"));
 *     QueryPair p = { 0 };
 *     while (r.next(&p) == 1) {
 *         // p.name / p.value 是输入上的原文视图（%XX 与 + 还在）
 *     }
 *     char buf[32] = { 0 };
 *     query_get(S("a=1&b=2"), S("b"), (char[:]){ buf, (int)sizeof buf });  // 1 字节 "2"
 *
 * 这是 `application/x-www-form-urlencoded` 的语义，和 `std.net.url` 的百分号
 * 编解码**不一样**的地方：`+` 表示空格、参数之间用 `&` 分隔、值里可以再出现
 * `=`（只按**第一个** `=` 切）。所以单独一个模块，不往 `std.net.url` 里塞。
 *
 * 约定：
 *
 * - 解析是零分配的：`QueryPair.name`/`value` 是输入上的视图，原样保留 `%XX`
 *   和 `+`；要解码就调 `query_decode`（`+` → 空格、`%XX` → 字节、非法转义 -1）。
 * - 空段（`a=1&&b=2` 里的空段）忽略；`key`（没有 `=`）的 `has_eq = 0`、`value`
 *   为空；空名字（`=x`）也给出（`name` 为空视图），由调用方决定要不要。
 * - `query_get`/`query_get_nth` 先解码名字再比较（按字节），值解码后写调用方
 *   缓冲；找不到返回 -1，放不下也返回 -1。
 * - 构建（`query_encode`/`query_build`）用 `+` 表示空格，其余按 RFC 3986 的
 *   unreserved（`A-Za-z0-9-._~`）原样，其它字节写大写 `%XX`；长度先算再写，
 *   放不下返回 -1 且不写半截。
 */
#include <string.h>

module std.data.query;
import std.core.types;
import std.text.str;

struct QueryPair {
    Str name;
    Str value;
    int has_eq;              /* 0 = 这一段没有 '='（value 为空） */
};

struct QueryReader {
    Str text;
    int pos;
};

QueryReader query_open(Str text)
{
    QueryReader r = { { { (char *)0, 0 } }, 0 };

    r.text = text;
    return r;
}

/* 下一个参数：1 = 有，0 = 结束 */
int next(QueryReader *self, QueryPair *out)
{
    QueryPair p = { { { (char *)0, 0 } }, { { (char *)0, 0 } }, 0 };
    int start = 0, eq = -1, sep = 0;

    if (!out)
        return 0;
    /* 跳过空段（连续 & 或开头/结尾的 &） */
    while (self->pos < self->text.s.len && self->text.s.data[self->pos] == '&')
        self->pos++;
    if (self->pos >= self->text.s.len)
        return 0;
    start = self->pos;
    sep = self->text.s.len;
    eq = -1;
    while (self->pos < self->text.s.len) {
        int c = (u8)self->text.s.data[self->pos];

        if (c == '&') {
            sep = self->pos;
            break;
        }
        if (c == '=' && eq < 0)
            eq = self->pos;
        self->pos++;
    }
    if (eq >= 0) {
        Str nm = { { self->text.s.data + start, eq - start } };
        Str vl = { { self->text.s.data + eq + 1, sep - (eq + 1) } };

        p.name = nm;
        p.value = vl;
        p.has_eq = 1;
    } else {
        Str nm = { { self->text.s.data + start, sep - start } };

        p.name = nm;
        p.has_eq = 0;
    }
    self->pos = (sep < self->text.s.len) ? sep + 1 : sep;
    *out = p;
    return 1;
}

/* 参数个数（跳过空段） */
int count(QueryReader *self)
{
    int save = self->pos, n = 0;
    QueryPair p = { 0 };

    self->pos = 0;
    while (next(self, &p) == 1)
        n++;
    self->pos = save;
    return n;
}

/* ---- 编解码 ---- */

static int q_hex(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
        return c - 'A' + 10;
    return -1;
}

/* 解码一个名字/值：'+' → 空格，%XX → 字节；坏转义/放不下返回 -1 */
int query_decode(Str raw, char[:] out)
{
    int i = 0, di = 0;

    while (i < raw.s.len) {
        int c = (u8)raw.s.data[i];

        if (c == '+') {
            if (di + 1 > out.len)
                return -1;
            out.data[di++] = ' ';
            i++;
            continue;
        }
        if (c == '%') {
            int h = 0, l = 0;

            if (i + 2 >= raw.s.len)
                return -1;
            h = q_hex((u8)raw.s.data[i + 1]);
            l = q_hex((u8)raw.s.data[i + 2]);
            if (h < 0 || l < 0)
                return -1;
            if (di + 1 > out.len)
                return -1;
            out.data[di++] = (char)(h * 16 + l);
            i += 3;
            continue;
        }
        if (di + 1 > out.len)
            return -1;
        out.data[di++] = (char)c;
        i++;
    }
    return di;
}

static int q_unreserved(int c)
{
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
           || (c >= '0' && c <= '9') || c == '-' || c == '.' || c == '_'
           || c == '~';
}

/* 编码后长度 */
int query_encode_len(char[:] s)
{
    int i = 0;
    i64 n = 0;

    if (s.len < 0)
        return -1;
    for (i = 0; i < s.len; i++) {
        int c = (u8)s.data[i];

        n += q_unreserved(c) ? 1 : ((c == ' ') ? 1 : 3);
    }
    if (n > (i64)I32_MAX)
        return -1;
    return (int)n;
}

/* 编码：unreserved 原样、空格写 '+'、其它写大写 %XX；返回字节数或 -1 */
int query_encode(char[:] s, char[:] out)
{
    static const char hex[] = "0123456789ABCDEF";
    int i = 0, di = 0;

    if (s.len < 0 || query_encode_len(s) > out.len)
        return -1;
    for (i = 0; i < s.len; i++) {
        int c = (u8)s.data[i];

        if (q_unreserved(c)) {
            out.data[di++] = (char)c;
        } else if (c == ' ') {
            out.data[di++] = '+';
        } else {
            out.data[di++] = '%';
            out.data[di++] = hex[(c >> 4) & 0xf];
            out.data[di++] = hex[c & 0xf];
        }
    }
    return di;
}

/* ---- 便捷查询 ---- */

/* 第 idx 个名为 name 的参数，值解码后写 out；返回字节数，找不到/放不下 -1 */
int query_get_nth(Str text, char[:] name, int idx, char[:] out)
{
    QueryReader r = query_open(text);
    QueryPair p = { { { (char *)0, 0 } }, { { (char *)0, 0 } }, 0 };
    int n = 0;

    while (next(&r, &p) == 1) {
        char nm[256] = { 0 };
        int k = query_decode(p.name, (char[:]){ nm, (int)sizeof nm });

        if (k < 0)
            return -1;
        if (k == name.len && (k == 0 || memcmp(nm, name.data, (usize)k) == 0)) {
            if (n == idx)
                return query_decode(p.value, out);
            n++;
        }
    }
    return -1;
}

int query_get(Str text, char[:] name, char[:] out)
{
    return query_get_nth(text, name, 0, out);
}

/* 有没有这个参数（名字解码后比较） */
int query_has(Str text, char[:] name)
{
    QueryReader r = query_open(text);
    QueryPair p = { { { (char *)0, 0 } }, { { (char *)0, 0 } }, 0 };

    while (next(&r, &p) == 1) {
        char nm[256] = { 0 };
        int k = query_decode(p.name, (char[:]){ nm, (int)sizeof nm });

        if (k < 0)
            return 0;
        if (k == name.len && (k == 0 || memcmp(nm, name.data, (usize)k) == 0))
            return 1;
    }
    return 0;
}

/* ---- 构建 ---- */

/* 构建后的长度（不含结尾 NUL） */
int query_build_len(QueryPair *pairs, int n)
{
    i64 total = 0;
    int i = 0;

    if (n < 0 || (n > 0 && !pairs))
        return -1;
    for (i = 0; i < n; i++) {
        int nl = query_encode_len(pairs[i].name.s);
        int vl = query_encode_len(pairs[i].value.s);

        if (nl < 0 || vl < 0)
            return -1;
        total += nl + 1 + vl + ((i + 1 < n) ? 1 : 0);
        if (total > (i64)I32_MAX)
            return -1;
    }
    return (int)total;
}

/* 按 a=b&c=d 构建；放不下返回 -1 且不写半截 */
int query_build(QueryPair *pairs, int n, char[:] out)
{
    int need = query_build_len(pairs, n);
    int i = 0, di = 0;

    if (need < 0 || need > out.len)
        return -1;
    for (i = 0; i < n; i++) {
        int k = query_encode(pairs[i].name.s, (char[:]){ out.data + di, out.len - di });

        di += k;
        out.data[di++] = '=';
        k = query_encode(pairs[i].value.s, (char[:]){ out.data + di, out.len - di });
        di += k;
        if (i + 1 < n)
            out.data[di++] = '&';
    }
    return di;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static Str q_str(char[:] s)
{
    Str r = { { (char *)0, 0 } };

    r.s = s;
    return r;
}

static int q_eq(Str s, const char *want)
{
    int n = (int)strlen(want);

    return s.s.len == n && (n == 0 || memcmp(s.s.data, want, (usize)n) == 0);
}

test "解析参数" {
    Str text = { S("a=1&b=hello+world&c=%E4%B8%AD&&d&e=") };
    QueryReader r = query_open(text);
    QueryPair p = { 0 };
    int n = 0;

    while (next(&r, &p) == 1) {
        n++;
        if (n == 1) {
            if (!q_eq(p.name, "a") || !q_eq(p.value, "1") || !p.has_eq)
                return err(1, "a=1");
        } else if (n == 2) {
            if (!q_eq(p.name, "b") || !q_eq(p.value, "hello+world"))
                return err(2, "b");
        } else if (n == 3) {
            if (!q_eq(p.name, "c") || !q_eq(p.value, "%E4%B8%AD"))
                return err(3, "c");
        } else if (n == 4) {
            if (!q_eq(p.name, "d") || p.has_eq || p.value.s.len != 0)
                return err(4, "d 没有 =");
        } else if (n == 5) {
            if (!q_eq(p.name, "e") || !p.has_eq || p.value.s.len != 0)
                return err(5, "e=");
        }
    }
    if (n != 5)
        return err(6, "参数个数");
    /* 重新开一个 reader 数个数 */
    r = query_open(text);
    if (r.count() != 5)
        return err(7, "count");
    /* 空输入 */
    {
        QueryReader e = query_open(q_str(S("")));

        if (next(&e, &p) != 0)
            return err(8, "空输入");
    }
    /* 只有分隔符 */
    {
        QueryReader e = query_open(q_str(S("&&&")));

        if (next(&e, &p) != 0)
            return err(9, "只有 &");
    }
    /* 值里可以再出现 = */
    {
        QueryReader e = query_open(q_str(S("a=b=c")));

        if (next(&e, &p) != 1 || !q_eq(p.name, "a") || !q_eq(p.value, "b=c"))
            return err(10, "值里的 =");
    }
}

test "解码 %XX 与 +" {
    char buf[32] = { 0 };
    int n = 0;

    n = query_decode(q_str(S("hello+world")), (char[:]){ buf, (int)sizeof buf - 1 });
    buf[n > 0 ? n : 0] = 0;
    if (n != 11 || strcmp(buf, "hello world") != 0)
        return err(11, "+ 变空格");
    n = query_decode(q_str(S("%E4%B8%AD")), (char[:]){ buf, (int)sizeof buf - 1 });
    if (n != 3 || memcmp(buf, "\xe4\xb8\xad", 3) != 0)
        return err(12, "UTF-8 的 %XX");
    n = query_decode(q_str(S("a%2Bb")), (char[:]){ buf, (int)sizeof buf - 1 });
    buf[n > 0 ? n : 0] = 0;
    if (n != 3 || strcmp(buf, "a+b") != 0)
        return err(13, "%2B 不是空格");
    n = query_decode(q_str(S("")), (char[:]){ buf, (int)sizeof buf - 1 });
    if (n != 0)
        return err(14, "空串");
    /* 坏转义 */
    if (query_decode(q_str(S("%ZZ")), (char[:]){ buf, (int)sizeof buf }) != -1)
        return err(15, "坏十六进制");
    if (query_decode(q_str(S("%4")), (char[:]){ buf, (int)sizeof buf }) != -1)
        return err(16, "截断的转义");
    if (query_decode(q_str(S("abc")), (char[:]){ buf, 2 }) != -1)
        return err(17, "放不下");
}

test "编码与构建" {
    char buf[64] = { 0 };
    int n = 0;
    QueryPair p[3] = { { { { (char *)0, 0 } }, { { (char *)0, 0 } }, 0 },
                       { { { (char *)0, 0 } }, { { (char *)0, 0 } }, 0 },
                       { { { (char *)0, 0 } }, { { (char *)0, 0 } }, 0 } };
    if (query_encode_len(S("a b")) != 3)
        return err(18, "空格编成 +");
    n = query_encode(S("a b"), (char[:]){ buf, (int)sizeof buf - 1 });
    buf[n > 0 ? n : 0] = 0;
    if (n != 3 || strcmp(buf, "a+b") != 0)
        return err(19, "编码 a b");
    n = query_encode(S("/x?y=中"), (char[:]){ buf, (int)sizeof buf - 1 });
    buf[n > 0 ? n : 0] = 0;
    if (strcmp(buf, "%2Fx%3Fy%3D%E4%B8%AD") != 0)
        return err(20, "编码保留字符与 UTF-8");
    if (query_encode_len(S("plain-._~09")) != 11)
        return err(21, "unreserved 原样");

    p[0].name = q_str(S("a"));
    p[0].value = q_str(S("1 2"));
    p[1].name = q_str(S("b"));
    p[1].value = q_str(S("/x"));
    p[2].name = q_str(S("c"));
    p[2].value = q_str(S(""));
    n = query_build(p, 3, (char[:]){ buf, (int)sizeof buf - 1 });
    buf[n > 0 ? n : 0] = 0;
    if (n != query_build_len(p, 3) || strcmp(buf, "a=1+2&b=%2Fx&c=") != 0)
        return err(22, "构建查询串");
    /* 放不下不写 */
    {
        char small[4] = { 0 };
        int i = 0;

        for (i = 0; i < 4; i++)
            small[i] = 'Z';
        if (query_build(p, 3, (char[:]){ small, 4 }) != -1)
            return err(23, "放不下给 -1");
        for (i = 0; i < 4; i++)
            if (small[i] != 'Z')
                return err(24, "放不下时写了半截");
    }
    /* 构建 → 解析 → 解码 往返 */
    {
        QueryReader r = query_open(q_str((char[:]){ buf, n }));
        QueryPair got = { 0 };
        char out[32] = { 0 };

        if (next(&r, &got) != 1 || !q_eq(got.name, "a"))
            return err(25, "往返：第一个");
        query_decode(got.value, (char[:]){ out, (int)sizeof out - 1 });
        if (strcmp(out, "1 2") != 0)
            return err(26, "往返：值解码");
    }
}

test "便捷查询" {
    char buf[32] = { 0 };
    int n = 0;

    n = query_get(q_str(S("a=1&b=hello+world")), S("b"),
                  (char[:]){ buf, (int)sizeof buf - 1 });
    buf[n > 0 ? n : 0] = 0;
    if (n != 11 || strcmp(buf, "hello world") != 0)
        return err(27, "query_get 解码");
    if (query_get(q_str(S("a=1")), S("z"), (char[:]){ buf, (int)sizeof buf }) != -1)
        return err(28, "找不到给 -1");
    if (!query_has(q_str(S("a=1")), S("a")) || query_has(q_str(S("a=1")), S("b")))
        return err(29, "query_has");
    /* 同名参数：第 0 个与第 1 个 */
    n = query_get_nth(q_str(S("x=1&x=2&y=3")), S("x"), 1,
                      (char[:]){ buf, (int)sizeof buf - 1 });
    buf[n > 0 ? n : 0] = 0;
    if (n != 1 || strcmp(buf, "2") != 0)
        return err(30, "query_get_nth");
    /* 名字本身带 %XX 也能查到 */
    n = query_get(q_str(S("a%20b=7")), S("a b"),
                  (char[:]){ buf, (int)sizeof buf - 1 });
    if (n != 1 || buf[0] != '7')
        return err(31, "解码后的名字");
    /* 放不下 */
    if (query_get(q_str(S("a=hello")), S("a"), (char[:]){ buf, 2 }) != -1)
        return err(32, "query_get 放不下");
}
