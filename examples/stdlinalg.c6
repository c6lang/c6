/* examples/stdlinalg.c6 —— 第七十五批（线性代数）的集成示例。
 *
 *     cmake --build build --target std-linalg
 *
 * 四节：LU 分解求解/求逆/行列式、Jacobi 特征分解与幂法、三对角 Thomas 求解、
 * CSR 稀疏矩阵的 SpMV 与转置。
 */
#include <stdio.h>
#include <math.h>
#include <string.h>

import std.core.types;
import std.text.str;
import std.core.lu;
import std.core.eigen;
import std.core.tridiag;
import std.core.sparse;

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int checks = 0;
static int fails = 0;

static void check(int cond, const char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("   ✗ %s\n", what);
    }
}

static void do_lu(void)
{
    double a[9] = { 2, 1, 1, 4, 3, 3, 8, 7, 9 };
    double lbuf[9] = { 0 };
    int piv[3] = { 0, 0, 0 };
    Lu f = { 0 };
    double b[3] = { 4, 10, 24 };
    double x[3] = { 0, 0, 0 };
    double w[9] = { 0 };
    double inv[9] = { 0 };

    printf("== lu\n");
    check(f.init(a, 3, lbuf, piv) == 3, "满秩分解");
    printf("   det = %.6f，主元行 %d/%d/%d\n", f.det(), f.pivots(0), f.pivots(1),
           f.pivots(2));
    check(fabs(f.det() - 4.0) < 1e-9, "行列式 = 4");
    check(f.solve(b, x, w) == 1, "求解成功");
    printf("   解：(%g, %g, %g)\n", x[0], x[1], x[2]);
    check(fabs(x[0] - 1.0) < 1e-9 && fabs(x[2] - 1.0) < 1e-9, "解 = (1,1,1)");
    check(f.inverse(inv, w) == 1, "求逆成功");
    /* A·A⁻¹ 的第一列 */
    check(fabs(a[0] * inv[0] + a[1] * inv[3] + a[2] * inv[6] - 1.0) < 1e-9,
          "A·A⁻¹ 的 (0,0) 元素 = 1");
}

static void do_eigen(void)
{
    double a[4] = { 2, 1, 1, 2 };
    double ab[4] = { 0 }, vb[4] = { 0 }, db[4] = { 0 };
    Eigen e = { 0 };
    double x0[2] = { 1, 0 };
    double xo[2] = { 0, 0 };
    double lam = 0.0;

    printf("== eigen\n");
    check(e.init(a, 2, ab, vb, db) == 1, "init");
    check(e.jacobi(1e-12, 100) > 0 && e.converged() == 1, "Jacobi 收敛");
    e.sorted();
    printf("   特征值 %g 与 %g（%d 次扫掠）\n", e.value(0), e.value(1), e.sweeps());
    check(fabs(e.value(0) - 1.0) < 1e-9 && fabs(e.value(1) - 3.0) < 1e-9,
          "特征值 1 与 3");
    check(fabs(e.vector_at(1, 0) - e.vector_at(1, 1)) < 1e-6, "λ=3 的向量是 (1,1)/√2");
    /* jacobi 之后 e 的 a 已经是对角阵，幂法要另起一个（未旋转过的）实例 */
    {
        double pb[4] = { 0 }, pv[4] = { 0 }, pd[4] = { 0 };
        Eigen p = { 0 };

        check(p.init(a, 2, pb, pv, pd) == 1, "幂法 init");
        lam = p.power(x0, 200, 1e-12, xo);
    }
    printf("   幂法主特征值 %.10f\n", lam);
    check(fabs(lam - 3.0) < 1e-8, "幂法给出 3");
}

static void do_tridiag(void)
{
    double lo[8] = { 0, -1, -1, -1, -1, -1, -1, -1 };
    double di[8] = { 2, 2, 2, 2, 2, 2, 2, 2 };
    double up[8] = { -1, -1, -1, -1, -1, -1, -1, 0 };
    double buf[40] = { 0 };
    double b[8] = { 1, 0, 0, 0, 0, 0, 0, 1 };
    double x[8] = { 0 };
    Tridiag t = { 0 };
    int i = 0;

    printf("== tridiag\n");
    check(t.init(lo, di, up, 8, buf) == 1, "init");
    check(t.dim() == 8 && t.degenerate() == 0, "维数/退化");
    printf("   det = %.4f\n", t.det());
    check(t.solve(b, x) == 1, "Poisson 求解");
    for (i = 0; i < 8; i++)
        check(fabs(x[i] - 1.0) < 1e-9, "Poisson 解全 1");
    printf("   x = (%.0f, %.0f, … , %.0f)\n", x[0], x[1], x[7]);
}

static void do_sparse(void)
{
    double val[16] = { 0 };
    int col[16] = { 0 };
    int ptr[4] = { 0 };
    Sparse s = { 0 };
    double m[9] = { 1, 0, 2, 0, 3, 0, 4, 0, 5 };
    double x[3] = { 1, 2, 3 };
    double y[3] = { 0, 0, 0 };
    double v2[16] = { 0 };
    int c2[16] = { 0 };
    int p2[4] = { 0 };

    printf("== sparse\n");
    check(s.init(3, 3, val, col, ptr, 16) == 1, "init");
    check(s.dense(m, 3, 3) == 5, "稠密建表 nnz = 5");
    printf("   行非零数 %d/%d/%d，行和 %g/%g/%g\n", s.row_nnz(0), s.row_nnz(1),
           s.row_nnz(2), s.row_sum(0), s.row_sum(1), s.row_sum(2));
    check(s.get(0, 2) == 2.0 && s.get(2, 2) == 5.0, "取非零元");
    check(s.get(1, 0) == 0.0 && s.get(1, 1) == 3.0, "取零元与对角");
    check(s.spmv(x, y) == 1, "SpMV");
    printf("   A·[1,2,3] = [%g, %g, %g]\n", y[0], y[1], y[2]);
    check(fabs(y[0] - 7.0) < 1e-9 && fabs(y[2] - 19.0) < 1e-9, "SpMV 结果");
    check(s.transpose(v2, c2, p2, 16) == 5, "转置 nnz = 5");
    check(p2[1] == 2 && p2[2] == 3 && p2[3] == 5, "转置的行偏移");
}

int main(void)
{
    do_lu();
    do_eigen();
    do_tridiag();
    do_sparse();
    printf("\n%d check(s), %d failure(s)\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
