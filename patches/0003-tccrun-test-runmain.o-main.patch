From f2a53238f856ba32ebe1c54ad626ebc6e94ffa00 Mon Sep 17 00:00:00 2001
From: superc <superc@localhost>
Date: Fri, 6 Nov 2026 17:03:54 +0800
Subject: [PATCH 3/3] =?UTF-8?q?tccrun:=20'-test'=20=E6=A8=A1=E5=BC=8F?=
 =?UTF-8?q?=E4=B8=8B=20runmain.o=20=E5=8F=AA=E5=9C=A8=E5=AD=98=E5=9C=A8=20?=
 =?UTF-8?q?main=20=E6=97=B6=E9=93=BE=E6=8E=A5?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

test 运行器直接调用 test 函数，用户 main 是可选的；runmain.o 引用了
main，之前会让“只有 test 块、没有 main”的文件报 unresolved reference
to 'main'。现在 -test 模式且在符号表里找不到 main 时不再拉入 runmain.o。
---
 .superc-mode | 1 +
 tccrun.c     | 8 +++++++-
 2 files changed, 8 insertions(+), 1 deletion(-)
 create mode 100644 .superc-mode

diff --git a/.superc-mode b/.superc-mode
new file mode 100644
index 0000000..bdcc60e
--- /dev/null
+++ b/.superc-mode
@@ -0,0 +1 @@
+ext
diff --git a/tccrun.c b/tccrun.c
index ccf684d..196580a 100644
--- a/tccrun.c
+++ b/tccrun.c
@@ -285,7 +285,13 @@ LIBTCCAPI int tcc_run(TCCState *s1, int argc, char **argv)
     s1->run_main = "_runmain", top_sym = "main";
     if (s1->elf_entryname)
         s1->run_main = top_sym = s1->elf_entryname;
-    tcc_add_support(s1, "runmain.o");
+#ifdef TCC_EXT
+    /* with '-test' the runner calls the test functions directly and a
+       user 'main' is optional; runmain.o references 'main', so pull it
+       in only when there is one */
+    if (!s1->superc_test_mode || (addr_t)-1 != get_sym_addr(s1, "main", 0, 1))
+#endif
+        tcc_add_support(s1, "runmain.o");
 
     if (tcc_relocate(s1) < 0)
         return -1;
