/* cp 在有序区间表里？ */
static int w_in(WRange *tab, int n, u32 cp)
{
    int lo = 0;
    int hi = n - 1;

    while (lo <= hi) {
        int mid = lo + (hi - lo) / 2;

        if (cp < tab[mid].lo)
            hi = mid - 1;
        else if (cp > tab[mid].hi)
            lo = mid + 1;
        else
            return 1;
    }
    return 0;
}

/* 一个码点占几列：-1 = 控制/不可打印，0 = 零宽，1 = 窄，2 = 宽 */
int cp_width(u32 cp)
{
    if (cp < 0x20u || (cp >= 0x7fu && cp <= 0x9fu))
        return -1;
    if (w_in(w_zero, (int)(sizeof w_zero / sizeof w_zero[0]), cp))
        return 0;
    if (w_in(w_wide, (int)(sizeof w_wide / sizeof w_wide[0]), cp))
        return 2;
    return 1;
}

/* 整段的显示列数：控制字符 0 列、非法字节 1 列，从不失败。 */
int text_width(char[:] s)
{
    int i = 0;
    int cols = 0;

    while (i < s.len) {
        u32 cp = 0;
        int n = utf8_decode(s, i, &cp);
        int w = 0;

        if (n <= 0) {               /* 非法字节：按 1 列，前进 1 重同步 */
            cols += 1;
            i += 1;
            continue;
        }
        w = cp_width(cp);
        if (w > 0)
            cols += w;
        i += n;
    }
    return cols;
}

/* 严格版：有非法 UTF-8 或控制字符就返回 -1。 */
int text_width_checked(char[:] s)
{
    int i = 0;
    int cols = 0;

    while (i < s.len) {
        u32 cp = 0;
        int n = utf8_decode(s, i, &cp);
        int w = 0;

        if (n <= 0)
            return -1;
        w = cp_width(cp);
        if (w < 0)
            return -1;
        cols += w;
        i += n;
    }
    return cols;
}

/* 最长的、宽度不超过 cols 的前缀占多少**字节**（只在码点边界切）。
   控制字符 0 列照样带过去；非法字节按 1 列。cols <= 0 给 0。 */
int text_prefix_len(char[:] s, int cols)
{
    int i = 0;
    int used = 0;

    if (cols <= 0)
        return 0;
    while (i < s.len) {
        u32 cp = 0;
        int n = utf8_decode(s, i, &cp);
        int w = 0;

        if (n <= 0) {
            if (used + 1 > cols)
                return i;
            used += 1;
            i += 1;
            continue;
        }
        w = cp_width(cp);
        if (w < 0)
            w = 0;
        if (used + w > cols)
            return i;
        used += w;
        i += n;
    }
    return i;
}

/* 把「宽度不超过 cols 的前缀」拷进 out，返回字节数；out 不够返回 -1。 */
int text_fit(char[:] s, char[:] out, int cols)
{
    int need = text_prefix_len(s, cols);

    if (need < 0 || need > out.len)
        return -1;
    if (need > 0)
        memcpy(out.data, s.data, (size_t)need);
    return need;
}

/* 截断 + 补齐到**恰好** cols 列（宽了先截，窄了补空格），返回字节数；
   cols < 0 或 out 放不下返回 -1（一个字节都不写）。 */
int text_pad(char[:] s, char[:] out, int cols)
{
    int n = 0;
    int w = 0;
    int need = 0;
    int i = 0;

    if (cols < 0)
        return -1;
    n = text_prefix_len(s, cols);
    if (n < 0)
        return -1;
    w = text_width((char[:]){ s.data, n });
    need = n + (cols - w);
    if (need > out.len)
        return -1;
    if (n > 0)
        memcpy(out.data, s.data, (size_t)n);
    for (i = 0; i < cols - w; i++)
        out.data[n + i] = ' ';
    return need;
}

/* 截断到 cols 列以内，被截断时补 "..."（总宽度仍 <= cols）；没截断就原样拷。
   返回字节数；cols < 0 或 out 放不下返回 -1。 */
int text_clip(char[:] s, char[:] out, int cols)
{
    int total = text_width(s);
    int keep = 0;
    int n = 0;
    int need = 0;

    if (cols < 0)
        return -1;
    if (total <= cols) {
        if (s.len > out.len)
            return -1;
        if (s.len > 0)
            memcpy(out.data, s.data, (size_t)s.len);
        return s.len;
    }
    if (cols <= 3) {                    /* 连省略号都放不下就不放 */
        keep = cols;
        need = 0;
    } else {
        keep = cols - 3;
        need = 3;
    }
    n = text_prefix_len(s, keep);
    if (n < 0 || n + need > out.len)
        return -1;
    if (n > 0)
        memcpy(out.data, s.data, (size_t)n);
    if (need > 0) {
        out.data[n] = '.';
        out.data[n + 1] = '.';
        out.data[n + 2] = '.';
    }
    return n + need;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "宽度：ASCII、CJK、全角、emoji、组合符与零宽" {
    if (text_width(S("hello")) != 5)
        return err(1, "ASCII 宽度不对");
    if (text_width(S("")) != 0)
        return err(2, "空串宽度不对");
    if (text_width(S("\xe4\xb8\xad\xe6\x96\x87")) != 4)
        return err(3, "中文应当占 4 列");
    if (text_width(S("A\xe4\xb8\xad" "B")) != 4)
        return err(4, "混排宽度不对");
    if (text_width(S("\xef\xbc\xa1")) != 2)
        return err(5, "全角 Ａ 应当占 2 列");
    if (text_width(S("\xf0\x9f\x99\x82")) != 2)
        return err(6, "emoji 应当占 2 列");
    if (text_width(S("e\xcc\x81")) != 1)
        return err(7, "组合符不该多占列");
    if (text_width(S("a\xe2\x80\x8d" "b")) != 2)
        return err(8, "ZWJ 不该占列");
    if (text_width(S("\xc2\xad")) != 0)
        return err(9, "软连字符应当零宽");
    if (text_width(S("\xe1\x85\xa0")) != 0)
        return err(10, "谚文中声 U+1160 应当零宽");
    if (text_width(S("\xe1\x84\x80")) != 2)
        return err(11, "谚文初声 U+1100 应当 2 列");
    if (cp_width(0x41) != 1 || cp_width(0x4e2d) != 2 || cp_width(0x301) != 0)
        return err(12, "cp_width 不对");
    if (cp_width(0x1b) != -1 || cp_width(0x7f) != -1 || cp_width(0x9b) != -1)
        return err(13, "控制字符应当 -1");
    if (text_width(S("a\tb")) != 2)
        return err(14, "text_width 里控制字符应当 0 列");
    if (text_width_checked(S("a\tb")) != -1)
        return err(15, "严格版应当拒绝控制字符");
    if (text_width_checked(S("a\xff" "b")) != -1)
        return err(16, "严格版应当拒绝非法 UTF-8");
    if (text_width(S("a\xff" "b")) != 3)
        return err(17, "非严格版应当按 1 列算非法字节");
    if (text_width_checked(S("\xe4\xb8\xad")) != 2)
        return err(18, "严格版对合法串应当给列数");
}

test "前缀裁剪：只在码点边界切" {
    if (text_prefix_len(S("a\xe4\xb8\xad" "b"), 1) != 1)
        return err(20, "cols=1 应当只留下 'a'");
    if (text_prefix_len(S("a\xe4\xb8\xad" "b"), 2) != 1)
        return err(21, "中放不下时不该硬塞");
    if (text_prefix_len(S("a\xe4\xb8\xad" "b"), 3) != 4)
        return err(22, "cols=3 应当收下 'a' + 中");
    if (text_prefix_len(S("\xe4\xb8\xad"), 1) != 0)
        return err(23, "宽字符放不下应当给 0");
    if (text_prefix_len(S("abc"), 0) != 0 || text_prefix_len(S("abc"), -1) != 0)
        return err(24, "cols<=0 应当给 0");
    if (text_prefix_len(S("e\xcc\x81" "x"), 1) != 3)
        return err(25, "零宽组合符应当跟着前一个字符一起留下");
    if (text_prefix_len(S("hello"), 99) != 5)
        return err(26, "放得下就该整段");
}

test "fit / pad / clip 与缓冲边界" {
    char out[16] = { 0 };
    char tiny[2] = { 0 };
    char small[1] = { 0 };

    if (text_fit(S("a\xe4\xb8\xad" "b"), (char[:]){ out, (int)sizeof out }, 2) != 1
        || out[0] != 'a')
        return err(30, "text_fit 截断不对");
    if (text_fit(S("abc"), (char[:]){ small, 0 }, 3) != -1)
        return err(31, "text_fit 缓冲不够应当 -1");
    if (text_pad(S("abc"), (char[:]){ out, (int)sizeof out }, 6) != 6
        || memcmp(out, "abc   ", 6) != 0)
        return err(32, "text_pad 补空格不对");
    if (text_pad(S("\xe4\xb8\xad\xe6\x96\x87"), (char[:]){ out, (int)sizeof out }, 3) != 4
        || memcmp(out, "\xe4\xb8\xad ", 4) != 0)
        return err(33, "text_pad 截宽再补不对");
    if (text_pad(S("abc"), (char[:]){ tiny, (int)sizeof tiny }, 4) != -1)
        return err(34, "text_pad 缓冲不够应当 -1");
    if (text_pad(S("abc"), (char[:]){ out, (int)sizeof out }, -1) != -1)
        return err(35, "text_pad 负列数应当 -1");
    if (text_pad(S("\xe4\xb8\xad"), (char[:]){ out, (int)sizeof out }, 0) != 0)
        return err(36, "text_pad 0 列应当空");
    if (text_clip(S("abcdef"), (char[:]){ out, (int)sizeof out }, 4) != 4
        || memcmp(out, "a...", 4) != 0)
        return err(37, "text_clip 省略号不对");
    if (text_clip(S("abc"), (char[:]){ out, (int)sizeof out }, 3) != 3
        || memcmp(out, "abc", 3) != 0)
        return err(38, "放得下就不该加省略号");
    if (text_clip(S("abc"), (char[:]){ out, (int)sizeof out }, 2) != 2
        || memcmp(out, "ab", 2) != 0)
        return err(39, "cols<=3 时直接截断");
    if (text_clip(S("\xe4\xb8\xad\xe6\x96\x87\xe4\xb8\xad"), (char[:]){ out, (int)sizeof out }, 5) != 6
        || memcmp(out, "\xe4\xb8\xad...", 6) != 0)
        return err(40, "text_clip 宽字符不对");
    if (text_clip(S("abcdef"), (char[:]){ tiny, (int)sizeof tiny }, 4) != -1)
        return err(41, "text_clip 缓冲不够应当 -1");
    if (text_clip(S("abcdef"), (char[:]){ out, (int)sizeof out }, -1) != -1)
        return err(42, "text_clip 负列数应当 -1");
}
