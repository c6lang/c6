/* c6 自测：错误码号段
 *
 *     id = (area << 27) | (slot << 12) | code        (bit31 恒为 0)
 *
 * 检查四件事（见 docs/reference/grammar.md §8.1）：
 *   - 没有 module 的文件 slot = 0，`return err(7, "…")` 的 id 仍然是 7；
 *   - 模块的 `enum Error` 成员落在这个模块自己的号段里，低 12 位是声明值；
 *   - 0 永远是「没有错误」，不参与加基址；
 *   - std 模块的号段内置在编译器里：std.err 固定在 0x6000。
 *
 * 运行（仓库根目录）：
 *   ./tcc/tcc -B tcc -I tests -I . -test tests/err_ids.c6 tests/tu/err_ids.c6
 */
#include <stdio.h>

import tu.err_ids;
import std.err;

#define AREA(id) (((unsigned)(id) >> 27) & 0xfu)
#define SLOT(id) (((unsigned)(id) >> 12) & 0x7fffu)
#define CODE(id) ((unsigned)(id) & 0xfffu)

/* 没有 module 的文件：slot 0 */
static int!error plain(void)
{
    return err(7, "seven");
}

static int plain_id(void)
{
    int v = plain() catch e {
        return e.id;
    };
    (void)v;
    return -1;
}

static int fail_a_id(void)
{
    int v = tu.err_ids.fail_a() catch e {
        return e.id;
    };
    (void)v;
    return -1;
}

test "没有 module 的文件保持小 id（slot 0）" {
    if (plain_id() != 7)
        return err(1, "err(7) 在非模块文件里必须还是 7");
    if (AREA(7) != 0 || SLOT(7) != 0 || CODE(7) != 7)
        return err(2, "号段分解不对");
}

test "模块的成员落在本模块的号段里" {
    if (AREA(tu.err_ids.id_a()) != 0)
        return err(1, "用户模块的 area 必须是 0");
    if (SLOT(tu.err_ids.id_a()) == 0)
        return err(2, "模块必须有自己的号段");
    if (SLOT(tu.err_ids.id_a()) != SLOT(tu.err_ids.id_last()))
        return err(3, "同一个模块的成员必须共用一个号段");
    if (CODE(tu.err_ids.id_a()) != 1)
        return err(4, "低 12 位是声明的值");
    if (CODE(tu.err_ids.id_b()) != 2)
        return err(5, "低 12 位是声明的值");
    if (CODE(tu.err_ids.id_last()) != 4095)
        return err(6, "4095 是成员上限");
    if ((unsigned)tu.err_ids.id_a() >> 31)
        return err(7, "bit31 必须为 0");
}

test "0 永远是「没有错误」，不参与加基址" {
    if (tu.err_ids.id_ok() != 0)
        return err(1, "模块里的 OK = 0 必须还是 0");
    if (tu.err_ids.OK != 0)
        return err(2, "OK 交换出来的值必须是 0");
}

test "err(A) 送出的 id 就是模块里的成员值" {
    if (fail_a_id() != (int)tu.err_ids.id_a())
        return err(1, "err() 的 id 必须等于模块里的成员值");
    if (fail_a_id() != (int)tu.err_ids.A)
        return err(2, "err() 的 id 必须等于模块里的成员值（限定写法）");
}

test "std 模块的号段内置在编译器里" {
    if (AREA(std.err.NOMEM) != 1)
        return err(1, "std 的 area 必须是 1");
    if (SLOT(std.err.NOMEM) != 0x6000)
        return err(2, "std.err 的号段固定在 0x6000");
    if (SLOT(std.err.INVAL) != SLOT(std.err.BUSY))
        return err(3, "同一个 std 模块共用一个号段");
    if (CODE(std.err.NOMEM) != 3)
        return err(4, "std.err.NOMEM 的码是 3");
    if (CODE(std.err.BUSY) != 15)
        return err(5, "std.err.BUSY 的码是 15");
    if (std.err.OK != 0)
        return err(6, "std.err.OK 必须是 0");
    if ((unsigned)std.err.NOMEM != 0x0e000003u)
        return err(7, "std.err.NOMEM 必须是 0x0e000003");
}
