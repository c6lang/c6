/* std/core/bignum：任意精度整数（定长 1024 位，零分配）。
 *
 *     import std.core.bignum;
 *
 *     Big a = big_parse(S("123456789012345678901234567890"));
 *     Big b = big_from_i64(7);
 *     Big q = { 0 }, r = { 0 };
 *     a.divmod(b, &q, &r);              // 1 = 成功；q*7 + r == a
 *     char out[64] = { 0 };
 *     q.format((char[:]){ out, (int)sizeof out });   // 十进制
 *
 * 表示：符号位 + 32 个 32 位 limb（小端），容量 **1024 位**，也就是十进制约
 * 308 位数字。够 RSA-1024 / 阶乘 / 大数进制转换这类活；要更大就改 `BIG_LIMBS`
 * 重新编译（结构体大小跟着变，是值类型，没有堆）。
 *
 * 语义约定：
 *
 * - **截断除法**：`divmod` 的商向零取整、余数和被除数同号，和 C 的 `/`、`%`
 *   一致（`-7 / 2 == -3`、`-7 % 2 == -1`）；除数为 0 返回 0。
 * - 任何运算只要超出 1024 位（加法的最高进位、乘法的结果、幂、解析的数字
 *   太大）就把 `err` 置 1，结果不可用；`err` 会随结果传播（拿坏结果继续算
 *   还是 err）。
 * - `cmp` 只看值、不看 `err`；`is_err` 要单独查。
 * - 进制 2..36，数字用 `0-9a-z`（输出小写，输入大小写都收）。
 * - `format_base`/`format` 先写临时缓冲，放不下返回 -1 且**一个字节都不写**。
 */
#include <string.h>

module std.core.bignum;
import std.core.types;

/* 1024 位 = 32 个 limb；十进制最多 308 位，临时缓冲按 1100 留够 */
enum BigLimits {
    BIG_LIMBS = 32,
    BIG_FMT = 1100,
};

/* 大整数：v[0] 是最低的 32 位，n 是有效 limb 数（0 表示值为 0） */
struct Big {
    int sgn;      /* 0 非负、1 负 */
    int n;
    int err;
    u32 v[BIG_LIMBS];
};

/* ---- 工厂 ---- */

Big big_zero(void)
{
    Big r = { 0 };

    return r;
}

Big big_from_u64(u64 x)
{
    Big r = { 0 };
    int i = 0;

    while (x != 0u && i < BIG_LIMBS) {
        r.v[i++] = (u32)(x & 0xffffffffu);
        x >>= 32;
    }
    r.n = i;
    return r;
}

Big big_from_i64(i64 x)
{
    Big r = { 0 };
    u64 m = 0;

    if (x < 0) {
        r.sgn = 1;
        m = (u64)0 - (u64)x;
    } else {
        m = (u64)x;
    }
    r = big_from_u64(m);
    r.sgn = (x < 0 && r.n > 0);
    return r;
}

/* ---- 内部：幅值运算 ---- */

static void big_trim(Big *a)
{
    while (a->n > 0 && a->v[a->n - 1] == 0u)
        a->n--;
    if (a->n == 0)
        a->sgn = 0;
}

static int big_cmp_mag(Big *a, Big *b)
{
    int i = 0;

    if (a->n != b->n)
        return a->n < b->n ? -1 : 1;
    for (i = a->n - 1; i >= 0; i--) {
        if (a->v[i] != b->v[i])
            return a->v[i] < b->v[i] ? -1 : 1;
    }
    return 0;
}

static Big big_add_mag(Big *a, Big *b)
{
    Big r = { 0 };
    int n = (a->n > b->n) ? a->n : b->n;
    u64 carry = 0;
    int i = 0;

    r.n = n;
    for (i = 0; i < n; i++) {
        u64 cur = carry;

        if (i < a->n)
            cur += a->v[i];
        if (i < b->n)
            cur += b->v[i];
        r.v[i] = (u32)(cur & 0xffffffffu);
        carry = cur >> 32;
    }
    if (carry != 0) {
        if (n >= BIG_LIMBS) {
            r.err = 1;
            return r;
        }
        r.v[n] = (u32)carry;
        r.n = n + 1;
    }
    big_trim(&r);
    return r;
}

/* 要求 |a| >= |b| */
static Big big_sub_mag(Big *a, Big *b)
{
    Big r = { 0 };
    i64 borrow = 0;
    int i = 0;

    r.n = a->n;
    for (i = 0; i < a->n; i++) {
        i64 cur = (i64)a->v[i] - borrow;

        if (i < b->n)
            cur -= (i64)b->v[i];
        if (cur < 0) {
            cur += 4294967296LL;
            borrow = 1;
        } else {
            borrow = 0;
        }
        r.v[i] = (u32)cur;
    }
    big_trim(&r);
    return r;
}

static int big_bits(Big *a)
{
    u32 top = 0;
    int bits = 0;

    if (a->n == 0)
        return 0;
    top = a->v[a->n - 1];
    bits = (a->n - 1) * 32;
    while (top != 0u) {
        bits++;
        top >>= 1;
    }
    return bits;
}

static void big_shl1(Big *a)
{
    u32 carry = 0;
    int i = 0;

    for (i = 0; i < a->n; i++) {
        u32 nc = a->v[i] >> 31;

        a->v[i] = (a->v[i] << 1) | carry;
        carry = nc;
    }
    if (carry != 0u) {
        if (a->n >= BIG_LIMBS) {
            a->err = 1;
            return;
        }
        a->v[a->n++] = carry;
    }
}

static void big_set_bit(Big *a, int i)
{
    int limb = i / 32;

    if (limb < 0 || limb >= BIG_LIMBS) {
        a->err = 1;
        return;
    }
    a->v[limb] |= 1u << (i % 32);
    if (a->n < limb + 1)
        a->n = limb + 1;
}

static Big big_mul_small(Big *a, u32 m)
{
    Big r = { 0 };
    u64 carry = 0;
    int i = 0, n = a->n;

    for (i = 0; i < n; i++) {
        u64 cur = (u64)a->v[i] * (u64)m + carry;

        r.v[i] = (u32)(cur & 0xffffffffu);
        carry = cur >> 32;
    }
    r.n = n;
    if (carry != 0u) {
        if (n >= BIG_LIMBS) {
            r.err = 1;
            return r;
        }
        r.v[n] = (u32)carry;
        r.n = n + 1;
    }
    big_trim(&r);
    return r;
}

static Big big_divmod_small(Big *a, u32 d, u32 *rem)
{
    Big q = { 0 };
    u64 r = 0;
    int i = 0;

    q.n = a->n;
    for (i = a->n - 1; i >= 0; i--) {
        u64 cur = (r << 32) | (u64)a->v[i];

        q.v[i] = (u32)(cur / (u64)d);
        r = cur % (u64)d;
    }
    big_trim(&q);
    if (rem)
        *rem = (u32)r;
    return q;
}

/* 幅值的二进制长除法：q = a / b，r = a % b（都非负） */
static void big_divmod_mag(Big *a, Big *b, Big *q, Big *r)
{
    Big rem = { 0 };
    int i = 0, bits = big_bits(a);

    *q = big_zero();
    *r = big_zero();
    if (b->n == 0) {
        q->err = 1;
        r->err = 1;
        return;
    }
    for (i = bits - 1; i >= 0; i--) {
        big_shl1(&rem);
        if (rem.err) {
            q->err = 1;
            r->err = 1;
            return;
        }
        if (((a->v[i / 32] >> (i % 32)) & 1u) != 0u)
            big_set_bit(&rem, 0);
        if (big_cmp_mag(&rem, b) >= 0) {
            rem = big_sub_mag(&rem, b);
            big_set_bit(q, i);
        }
    }
    if (q->err || rem.err) {
        q->err = 1;
        r->err = 1;
        return;
    }
    big_trim(q);
    big_trim(&rem);
    *r = rem;
}

/* ---- 查询 ---- */

int is_zero(Big *self) { return self->n == 0; }

int is_neg(Big *self) { return self->sgn != 0 && self->n > 0; }

int is_err(Big *self) { return self->err != 0; }

/* 值的符号：-1 / 0 / 1（不看 err；两边 err 时结果没有意义） */
int cmp(Big *self, Big o)
{
    int c = 0;

    if (self->n == 0 && o.n == 0)
        return 0;
    if (self->sgn != o.sgn)
        return self->sgn ? -1 : 1;
    c = big_cmp_mag((Big *)self, &o);
    return self->sgn ? -c : c;
}

/* ---- 四则 ---- */

/* 负号翻转（0 保持 0） */
Big neg(Big *self)
{
    Big r = *self;

    if (r.n > 0)
        r.sgn = !r.sgn;
    return r;
}

Big abs(Big *self)
{
    Big r = *self;

    r.sgn = 0;
    return r;
}

Big add(Big *self, Big o)
{
    Big r = { 0 };
    int c = 0;

    if (self->err || o.err) {
        r.err = 1;
        return r;
    }
    if (self->sgn == o.sgn) {
        r = big_add_mag((Big *)self, &o);
        r.sgn = (self->sgn != 0 && r.n > 0);
        return r;
    }
    c = big_cmp_mag((Big *)self, &o);
    if (c == 0)
        return r;                    /* 0 */
    if (c > 0) {
        r = big_sub_mag((Big *)self, &o);
        r.sgn = (self->sgn != 0 && r.n > 0);
    } else {
        r = big_sub_mag(&o, (Big *)self);
        r.sgn = (o.sgn != 0 && r.n > 0);
    }
    return r;
}

Big sub(Big *self, Big o)
{
    Big n = o;

    if (n.n > 0)
        n.sgn = !n.sgn;
    return self->add(n);
}

Big mul(Big *self, Big o)
{
    Big r = { 0 };
    u32 tmp[BIG_LIMBS + 1] = { 0 };
    int i = 0, j = 0, n = 0;

    if (self->err || o.err) {
        r.err = 1;
        return r;
    }
    if (self->n == 0 || o.n == 0)
        return r;
    if (self->n + o.n > BIG_LIMBS + 1) {
        r.err = 1;
        return r;
    }
    for (i = 0; i < self->n; i++) {
        u64 carry = 0;

        for (j = 0; j < o.n; j++) {
            u64 cur = (u64)self->v[i] * (u64)o.v[j] + (u64)tmp[i + j] + carry;

            tmp[i + j] = (u32)(cur & 0xffffffffu);
            carry = cur >> 32;
        }
        tmp[i + o.n] = (u32)carry;   /* 这个位置此前没被写过 */
    }
    n = self->n + o.n;
    if (tmp[n - 1] == 0u)
        n--;
    if (tmp[BIG_LIMBS] != 0u || n > BIG_LIMBS) {
        r.err = 1;
        return r;
    }
    for (i = 0; i < n; i++)
        r.v[i] = tmp[i];
    r.n = n;
    r.sgn = (self->sgn != o.sgn && n > 0);
    big_trim(&r);
    return r;
}

/* 截断除法：商向零取整、余数与被除数同号；除数为 0 返回 0 */
int divmod(Big *self, Big o, Big *q, Big *r)
{
    Big a = *self, b = o, quo = { 0 }, rem = { 0 };

    if (!q || !r)
        return 0;
    if (self->err || o.err || o.n == 0)
        return 0;
    big_divmod_mag(&a, &b, &quo, &rem);
    if (quo.err || rem.err) {
        q->err = 1;
        r->err = 1;
        return 0;
    }
    quo.sgn = (a.sgn != b.sgn && quo.n > 0);
    rem.sgn = (a.sgn != 0 && rem.n > 0);
    *q = quo;
    *r = rem;
    return 1;
}

/* 商（除零给 err + 零值）；余数见 divmod / mod */
Big div(Big *self, Big o)
{
    Big q = { 0 }, r = { 0 };

    if (!self->divmod(o, &q, &r)) {
        q = big_zero();
        q.err = 1;
    }
    return q;
}

/* 余数（除零给 err + 零值） */
Big mod(Big *self, Big o)
{
    Big q = { 0 }, r = { 0 };

    if (!self->divmod(o, &q, &r)) {
        r = big_zero();
        r.err = 1;
    }
    return r;
}

/* 幂：指数是 u32，结果超过 1024 位就 err */
Big pow(Big *self, u32 e)
{
    Big r = big_from_u64(1u);
    Big base = *self;

    if (self->err) {
        r.err = 1;
        return r;
    }
    while (e != 0u) {
        if ((e & 1u) != 0u) {
            r = r.mul(base);
            if (r.err)
                return r;
        }
        e >>= 1;
        if (e != 0u) {
            base = base.mul(base);
            if (base.err) {
                r.err = 1;
                return r;
            }
        }
    }
    return r;
}

/* ---- 转换 ---- */

/* 转 u64：放得下返回 1，负数/太大返回 0 */
int to_u64(Big *self, u64 *out)
{
    u64 v = 0;
    int i = 0;

    if (!out || self->err)
        return 0;
    if (self->sgn && self->n > 0)
        return 0;
    if (self->n > 2)
        return 0;
    for (i = self->n - 1; i >= 0; i--)
        v = (v << 32) | (u64)self->v[i];
    *out = v;
    return 1;
}

/* 转 i64：放得下返回 1（包括 I64_MIN） */
int to_i64(Big *self, i64 *out)
{
    u64 m = 0;
    Big mag = *self;

    if (!out || self->err)
        return 0;
    mag.sgn = 0;
    if (!mag.to_u64(&m))
        return 0;
    if (self->sgn) {
        if (m > 9223372036854775808ULL)
            return 0;
        *out = (i64)(0u - m);
    } else {
        if (m > 9223372036854775807ULL)
            return 0;
        *out = (i64)m;
    }
    return 1;
}

static const char big_digits[] = "0123456789abcdefghijklmnopqrstuvwxyz";

/* 以 base 输出到 out：返回字节数；放不下（或参数非法）返回 -1，不写半截 */
int format_base(Big *self, char[:] out, int base)
{
    char tmp[BIG_FMT] = { 0 };
    Big a = { 0 };
    int n = 0, i = 0, len = 0;
    u32 rem = 0;

    if (self->err || base < 2 || base > 36)
        return -1;
    a = *self;
    a.sgn = 0;
    if (a.n == 0) {
        if (out.len < 1)
            return -1;
        out.data[0] = '0';
        return 1;
    }
    while (a.n > 0) {
        a = big_divmod_small(&a, (u32)base, &rem);
        if (n >= BIG_FMT)
            return -1;
        tmp[n++] = big_digits[rem];
    }
    if (self->sgn)
        tmp[n++] = '-';
    len = n;
    if (len > out.len)
        return -1;
    for (i = 0; i < len; i++)
        out.data[i] = tmp[len - 1 - i];
    return len;
}

int format(Big *self, char[:] out)
{
    return self->format_base(out, 10);
}

/* 以 base 表示需要多少字节（含负号）；参数非法给 -1 */
int digits(Big *self, int base)
{
    char tmp[BIG_FMT] = { 0 };

    return self->format_base((char[:]){ tmp, (int)sizeof tmp }, base);
}

static int big_digit_value(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'z')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'Z')
        return c - 'A' + 10;
    return -1;
}

/* 解析：可选 +/-，后面至少一位 base 进制数字；空串/非法字符 → err */
Big big_parse_base(char[:] s, int base)
{
    Big r = { 0 };
    int i = 0, d = 0, any = 0, neg = 0;
    Big t = { 0 }, dg = { 0 };

    if (base < 2 || base > 36) {
        r.err = 1;
        return r;
    }
    if (s.len > 0 && (s.data[0] == '-' || s.data[0] == '+')) {
        neg = (s.data[0] == '-');
        i = 1;
    }
    for (; i < s.len; i++) {
        d = big_digit_value((u8)s.data[i]);
        if (d < 0 || d >= base) {
            Big bad = big_zero();

            bad.err = 1;
            return bad;
        }
        any = 1;
        t = big_mul_small(&r, (u32)base);
        if (t.err)
            return t;
        dg = big_from_u64((u32)d);
        r = big_add_mag(&t, &dg);
        if (r.err)
            return r;
    }
    if (!any) {
        r.err = 1;
        return r;
    }
    r.sgn = (neg != 0 && r.n > 0);
    return r;
}

Big big_parse(char[:] s)
{
    return big_parse_base(s, 10);
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

/* 和期望的十进制字符串比较（format 的结果） */
static int big_is_dec(Big a, const char *want)
{
    char tmp[64] = { 0 };
    int n = a.format((char[:]){ tmp, (int)sizeof tmp });

    if (n < 0)
        return 0;
    tmp[n] = 0;
    return strcmp(tmp, want) == 0;
}

test "i64/u64 往返与符号" {
    i64 v[6] = { 0, 1, -1, 2147483648LL, -9223372036854775807LL - 1,
                 123456789012345LL };
    int i = 0;

    for (i = 0; i < 6; i++) {
        Big a = big_from_i64(v[i]);
        i64 back = 0;

        if (!a.to_i64(&back) || back != v[i])
            return err(1, "i64 往返");
    }
    {
        Big a = big_from_i64(-1);
        u64 u = 0;

        if (a.to_u64(&u))
            return err(2, "负数不该转成 u64");
        if (!a.is_neg() || !big_zero().is_zero())
            return err(3, "符号/零判定");
    }
    {
        Big a = big_from_u64(18446744073709551615ULL);
        u64 u = 0;
        i64 sv = 0;

        if (!a.to_u64(&u) || u != 18446744073709551615ULL)
            return err(4, "u64 最大值");
        if (a.to_i64(&sv))
            return err(5, "u64 最大值放不进 i64");
    }
}

test "加减法与进位" {
    Big a = big_from_u64(0xffffffffu);
    Big one = big_from_i64(1);
    Big r = a.add(one);
    Big t = { 0 };

    if (!big_is_dec(r, "4294967296"))
        return err(6, "跨 limb 进位");
    r = r.sub(one);
    if (!big_is_dec(r, "4294967295"))
        return err(7, "减法");
    t = big_from_i64(5);
    r = t.sub(big_from_i64(8));
    if (!big_is_dec(r, "-3"))
        return err(8, "结果为负");
    t = big_from_i64(-5);
    r = t.add(big_from_i64(3));
    if (!big_is_dec(r, "-2"))
        return err(9, "异号相加");
    r = t.add(big_from_i64(5));
    if (!big_is_dec(r, "0"))
        return err(10, "相反数");
    t = big_from_i64(3);
    r = t.neg();
    if (!big_is_dec(r, "-3"))
        return err(11, "neg");
    t = big_from_i64(-3);
    r = t.abs();
    if (!big_is_dec(r, "3"))
        return err(12, "abs");
}

test "乘法和阶乘" {
    Big a = big_from_u64(0x100000000ULL);
    Big b = big_from_u64(0x100000000ULL);
    Big r = a.mul(b);

    if (!big_is_dec(r, "18446744073709551616"))
        return err(13, "2^64");
    {
        Big f = big_from_i64(1);
        Big i = { 0 };
        int k = 0;

        for (k = 1; k <= 20; k++) {
            i = big_from_i64((i64)k);
            f = f.mul(i);
        }
        if (!big_is_dec(f, "2432902008176640000"))
            return err(14, "20!");
    }
    a = big_from_i64(-3);
    r = a.mul(big_from_i64(4));
    if (!big_is_dec(r, "-12"))
        return err(15, "负乘正");
    r = a.mul(big_from_i64(-4));
    if (!big_is_dec(r, "12"))
        return err(16, "负乘负");
}

test "幂与 1024 位上限" {
    Big two = big_from_i64(2);
    Big r = two.pow(100);
    Big m = { 0 };

    if (!big_is_dec(r, "1267650600228229401496703205376"))
        return err(17, "2^100");
    r = two.pow(10);
    if (!big_is_dec(r, "1024"))
        return err(18, "2^10");
    m = big_from_i64(-2);
    r = m.pow(3);
    if (!big_is_dec(r, "-8"))
        return err(19, "负底数奇次幂");
    /* 2^1023 是最大能表示的量级，再乘 2 就溢出 */
    r = two.pow(1023);
    if (r.err)
        return err(20, "2^1023 应该放得下");
    m = r.mul(two);
    if (!m.err)
        return err(21, "1024 位溢出要报错");
    r = two.pow(0);
    if (!big_is_dec(r, "1"))
        return err(22, "x^0 = 1");
}

test "截断除法与余数" {
    Big a = big_from_i64(-7);
    Big b = big_from_i64(2);
    Big q = { 0 }, r = { 0 }, t = { 0 };

    if (!a.divmod(b, &q, &r))
        return err(23, "divmod 失败");
    if (!big_is_dec(q, "-3") || !big_is_dec(r, "-1"))
        return err(24, "负数截断除法");
    a = big_parse(S("12345678901234567890"));
    b = big_from_i64(7);
    if (!a.divmod(b, &q, &r))
        return err(25, "大数除法失败");
    if (!big_is_dec(q, "1763668414462081127") || !big_is_dec(r, "1"))
        return err(26, "大数除法的商/余数");
    /* q * b + r == a */
    t = q.mul(b);
    t = t.add(r);
    if (!big_is_dec(t, "12345678901234567890"))
        return err(27, "除法还原");
    if (a.divmod(big_from_i64(0), &q, &r))
        return err(28, "除零要失败");
    t = a.div(big_from_i64(1000));
    if (!big_is_dec(t, "12345678901234567"))
        return err(52, "div 的商");
    t = a.mod(big_from_i64(1000));
    if (!big_is_dec(t, "890"))
        return err(53, "mod 的余数");
    if (!a.div(big_from_i64(0)).is_err() || !a.mod(big_from_i64(0)).is_err())
        return err(54, "div/mod 除零");
    a = big_from_i64(3);
    b = big_from_i64(7);
    if (!a.divmod(b, &q, &r) || !q.is_zero() || !big_is_dec(r, "3"))
        return err(29, "小的被除数");
}

test "进制互转" {
    Big a = big_from_i64(255);
    char buf[64] = { 0 };
    int n = 0;

    n = a.format_base((char[:]){ buf, (int)sizeof buf }, 16);
    buf[n > 0 ? n : 0] = 0;
    if (n != 2 || strcmp(buf, "ff") != 0)
        return err(30, "255 的十六进制");
    n = a.format_base((char[:]){ buf, (int)sizeof buf }, 2);
    buf[n > 0 ? n : 0] = 0;
    if (n != 8 || strcmp(buf, "11111111") != 0)
        return err(31, "255 的二进制");
    if (a.digits(10) != 3 || a.digits(2) != 8)
        return err(32, "digits");
    a = big_parse_base(S("ff"), 16);
    if (!big_is_dec(a, "255"))
        return err(33, "解析十六进制");
    a = big_parse_base(S("zz"), 36);
    if (!big_is_dec(a, "1295"))
        return err(34, "解析 base36");
    a = big_parse_base(S("-ff"), 16);
    if (!big_is_dec(a, "-255"))
        return err(35, "带符号解析");
    a = big_parse_base(S("0"), 16);
    if (!a.is_zero())
        return err(36, "解析 0");
    a = big_parse_base(S("FF"), 16);
    if (!big_is_dec(a, "255"))
        return err(37, "大写数字");
    /* 非法输入一律 err + 零值 */
    a = big_parse(S("12x"));
    if (!a.is_err() || !a.is_zero())
        return err(38, "非法字符");
    a = big_parse(S(""));
    if (!a.is_err())
        return err(39, "空串");
    a = big_parse(S("-"));
    if (!a.is_err())
        return err(40, "只有负号");
    a = big_parse_base(S("2"), 2);
    if (!a.is_err())
        return err(41, "base 2 里的 2");
    a = big_parse_base(S("1"), 1);
    if (!a.is_err())
        return err(42, "非法进制");
}

test "格式化放不下与比较" {
    Big a = big_parse(S("123456789012345678901234567890"));
    Big b = { 0 };
    char small[8] = { 0 };
    char buf[64] = { 0 };
    int n = 0, i = 0;

    for (i = 0; i < 8; i++)
        small[i] = 'Z';
    if (a.format((char[:]){ small, 8 }) != -1)
        return err(43, "放不下要给 -1");
    for (i = 0; i < 8; i++)
        if (small[i] != 'Z')
            return err(44, "放不下时写了半截");
    n = a.format((char[:]){ buf, (int)sizeof buf });
    buf[n > 0 ? n : 0] = 0;
    if (n != 30 || strcmp(buf, "123456789012345678901234567890") != 0)
        return err(45, "30 位十进制");
    b = big_parse(S("123456789012345678901234567891"));
    if (a.cmp(b) >= 0)
        return err(46, "同长度比较");
    if (big_from_i64(-1).cmp(big_from_i64(0)) >= 0)
        return err(47, "负数比较");
    if (big_from_i64(-2).cmp(big_from_i64(-1)) >= 0)
        return err(48, "两个负数比较");
    if (a.cmp(a) != 0 || big_from_i64(5).cmp(big_from_i64(5)) != 0)
        return err(49, "相等");
    /* 0 的表示没有负号 */
    if (big_from_i64(-1).add(big_from_i64(1)).is_neg())
        return err(50, "0 不该是负数");
    /* err 会传播 */
    {
        Big bad = big_zero();
        Big sum = { 0 };

        bad.err = 1;
        sum = bad.add(big_from_i64(1));
        if (!sum.is_err())
            return err(51, "err 没传播");
    }
}
