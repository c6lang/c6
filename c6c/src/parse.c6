/* parse.c6 —— 声明层 + 表达式/语句 → IR（流式，不建表达式树）。
 *
 * 原则（design.md §4）：**边解析边降 IR**。每个 gen_* 返回一个虚拟寄存器号，
 * 值已经在 IR 里算好了；没有 AST，也就没有节点分配和二次遍历。
 * 需要“先看再说”的语义（defer/闭包捕获/泛型）留到 P4，用 token 区间重放。
 *
 * 值模型：标量在虚拟寄存器里统一按 64 位存，宽度信息留在 IR 的 type 字段，
 * 后端按它选指令（当前后端只用 64 位，P3-3 补 8/16/32 位读写）。
 */

#define PA_LOOK 16

/* 后端入口。llvm.c6 必须排在 parse.c6 **之后**（它要读数据段、重定位表和
 * 构造器表，那些都在后面才定义），所以这里先给声明。 */
static int llvm_mode(void);
static int llvm_open(const char *out);
static int llvm_finish(const char *out);
static void be_emit_fn(IrFn *f, u32 func_sym);

static IrFn FN;
static int PA_ERRS;
static Image CODE_IMG;

/* --- token 流（跳过换行；带 4 个 token 的前瞻） --- */

/* 前瞻窗口：PA_BUF[0] 永远是“当前 token”，消费就是整体左移一格。
 * 只做 memmove ≤4 个 32 字节结构，比“PA_POS 游标 + 边界处理”省心得多
 * （游标版本在窗口末端会让 pa_peek(1) 误报 EOF）。 */
static void agg_names_set(u32 ty, const char **names, const u32 *lens, u32 n);

/* ---------- interface ---------- */
#define IFACE_MAX 32
#define IFACE_NMET 8

static const char *IFACE_NAME[IFACE_MAX];
static u32 IFACE_NLEN[IFACE_MAX];
static const char *IFACE_MET[IFACE_MAX][IFACE_NMET];
static u32 IFACE_MLEN[IFACE_MAX][IFACE_NMET];
static u32 IFACE_RET[IFACE_MAX][IFACE_NMET];
#define IFACE_NPARAM 6
static u32 IFACE_PTY[IFACE_MAX][IFACE_NMET][IFACE_NPARAM];   /* 形参类型（不含接收者） */
static u32 IFACE_NP[IFACE_MAX][IFACE_NMET];
/* interface 签名里第一次出现的 tag：按 C 的规则那是**原型作用域**的 tag，和
 * 随后文件作用域里同名的 struct 不是同一个类型
 * （tests/errors/iface.c6 的 test_proto_scope_tag）。 */
#define PROTO_TAG_MAX 64
static u32 PROTO_TAG[PROTO_TAG_MAX];
static int NPROTO_TAG;
/* 正在解析 interface 的成员签名：这里第一次出现的 tag 属于**原型作用域**，
 * 用和普通 tag 不同的 intern 键建类型，并且只记名字（诊断要打印）、不进标签
 * 名字空间——否则随后文件作用域的 `struct P` 会命中同一个 id，两个类型就分
 * 不开了（tests/errors/iface.c6 的 test_proto_scope_tag）。 */
static int PA_IN_PROTO;
/* 原型作用域 tag 的 intern 键：把普通键的第 30 位翻一下，两者永远不相等 */
#define PROTO_TAG_KEY 0x40000000u

static void proto_tag_mark(u32 ty)
{
    int i = 0;

    for (i = 0; i < NPROTO_TAG; i++)
        if (PROTO_TAG[i] == ty)
            return;
    if (NPROTO_TAG < PROTO_TAG_MAX)
        PROTO_TAG[NPROTO_TAG++] = ty;
}

static int proto_tag_has(u32 ty)
{
    int i = 0;

    for (i = 0; i < NPROTO_TAG; i++)
        if (PROTO_TAG[i] == ty)
            return 1;
    return 0;
}
static u32 IFACE_NM[IFACE_MAX];
static u32 IFACE_TY[IFACE_MAX];
static u32 NIFACE;

/* 有没有接口类型：没有的话 store_conv / 语句分派里那几处热路径可以直接跳过 */
static int TY_HAS_IFACE;

static u32 ty_iface(u32 idx)
{
    u32 mem[2] = {0};
    const char *names[2] = {"self", "vt"};
    u32 lens[2] = {4, 2};
    u32 ty = 0;

    TY_HAS_IFACE = 1;

    if (IFACE_TY[idx])
        return IFACE_TY[idx];
    mem[0] = ty_ptr(ty_void());
    mem[1] = ty_ptr(ty_void());
    ty = ty_agg(mem, NULL, 2, 0,
                1u + (u32)(sym_hash_str("iface", 5) & 0x7FFFFFFFu) + idx);
    agg_names_set(ty, names, lens, 2);
    IFACE_TY[idx] = ty;
    return ty;
}

static int ty_is_iface(u32 ty, u32 *idx)
{
    u32 i = 0;

    for (i = 0; i < NIFACE; i++)
        if (IFACE_TY[i] == ty) {
            if (idx)
                *idx = i;
            return 1;
        }
    return 0;
}

static u32 iface_find(const char *nm, u32 nl)
{
    u32 i = 0;

    for (i = 0; i < NIFACE; i++)
        if (IFACE_NLEN[i] == nl && memcmp(IFACE_NAME[i], nm, nl) == 0)
            return i;
    return IFACE_MAX;
}

static void data_fixup_add(u32 data_off, u32 sym);

#define VT_MAX 64
static u32 VT_IF[VT_MAX];
static u32 VT_ST[VT_MAX];
static u32 VT_SYM[VT_MAX];
static u32 NVT;

static Sym *meth_find(u32 self_ty, const char *nm, u32 nl);
static void iface_check_impl(u32 ty, u32 ifx);

static u32 iface_vtbl(u32 ifidx, u32 sty)
{
    u32 k = 0;
    u32 nm = 0;
    u32 off = 0;

    for (k = 0; k < NVT; k++)
        if (VT_IF[k] == ifidx && VT_ST[k] == sty)
            return VT_SYM[k];
    nm = IFACE_NM[ifidx];
    off = data_alloc(nm * 8 ? nm * 8 : 8, 8);
    if (NVT < VT_MAX) {
        char vn[64] = {0};

        snprintf(vn, sizeof(vn), "__vt_%u_%u", (unsigned)ifidx, (unsigned)sty);
        VT_IF[NVT] = ifidx;
        VT_ST[NVT] = sty;
        VT_SYM[NVT] = x64_data_sym(&X64, arena_strdup(&A_main, vn), ELF_HDR + off);
        NVT++;
    }
    for (k = 0; k < nm; k++) {
        /* 先按"接收者就是这个实现类型"找（同名方法可以有好几份：
         * Circle_area / Rect_area），找不到再退回按裸名字找。 */
        Sym *f = meth_find(sty, IFACE_MET[ifidx][k], IFACE_MLEN[ifidx][k]);

        if (!f)
            f = sym_find(IFACE_MET[ifidx][k], IFACE_MLEN[ifidx][k]);
        if (f && f->is_func)
            data_fixup_add(off + k * 8, (u32)f->val);
    }
    return NVT ? VT_SYM[NVT - 1] : 0;
}

/* ---------- `@T` 的 GC 描述符 ----------
 * 结构体类型里哪些字段是托管引用只有前端知道（类型系统里 `@U` 和 `U *`
 * 是同一个类型 id），所以在这里单独记一张"结构体 → 托管字段下标"表，
 * 需要时再换成偏移。 */
#define MGDST_MAX 256
#define MGDST_FLD 64
static u32 MGDST_TY[MGDST_MAX];
static u8 MGDST_IDX[MGDST_MAX][MGDST_FLD];
static u8 MGDST_KIND[MGDST_MAX][MGDST_FLD];   /* 0=一个引用 1=引用数组 2=嵌套聚合 */
static u8 MGDST_CNT[MGDST_MAX][MGDST_FLD];
static u32 MGDST_N[MGDST_MAX];
static u16 MGDST_FILE[MGDST_MAX];             /* 定义落在哪个源文件（跨 TU 环诊断用） */
static u32 NMGDST;

static void mgdst_add(u32 ty, const u8 *idx, const u8 *kind, const u8 *cnt, u32 n,
                      u32 file)
{
    u32 k = 0;
    u32 j = 0;

    if (!n)
        return;
    for (k = 0; k < NMGDST; k++)
        if (MGDST_TY[k] == ty)
            break;
    if (k == NMGDST) {
        if (NMGDST >= MGDST_MAX)
            return;
        MGDST_TY[k] = ty;
        MGDST_N[k] = 0;
        NMGDST++;
    }
    /* 一个 TU 里两个结构体的类型 id 互不相同，但同一次编译里的第二个
     * 翻译单元（tests/tu/*.c6）有自己的 id 空间之外的文件归属 —— 记下
     * 定义所在文件，环检查才分得清「单元内成环」和「跨翻译单元成环」。 */
    MGDST_FILE[k] = (u16)(file > 0xFFFFu ? 0xFFFFu : file);
    if (getenv("C6C_DBG_MGDST"))
        fprintf(stderr, "[mgdst] ty=%u n=%u\n", (unsigned)ty, (unsigned)n);
    MGDST_N[k] = 0;                 /* 同一个类型会增量登记，最后一次为准 */
    for (j = 0; j < n && MGDST_N[k] < MGDST_FLD; j++) {
        if (getenv("C6C_DBG_MGDST"))
            fprintf(stderr, "  [mgdst] idx=%u kind=%u cnt=%u\n",
                    (unsigned)idx[j], (unsigned)kind[j], (unsigned)cnt[j]);
        MGDST_IDX[k][MGDST_N[k]] = idx[j];
        MGDST_KIND[k][MGDST_N[k]] = kind[j];
        MGDST_CNT[k][MGDST_N[k]] = cnt[j];
        MGDST_N[k]++;
    }
}

static int agg_find_promoted(u32 ty, const char *nm, u32 nl, u32 *sty, u32 *soff);

/* ty（含按值嵌套）里有没有叫 nm 的成员？只要个是与否。 */
static int agg_has_member(u32 ty, const char *nm, u32 nl)
{
    u32 st = 0;
    u32 so = 0;

    return agg_find_promoted(ty, nm, nl, &st, &so);
}

static u32 mgdst_find(u32 ty)
{
    u32 k = 0;

    for (k = 0; k < NMGDST; k++)
        if (MGDST_TY[k] == ty)
            return k;
    return 0xFFFFFFFFu;
}

/* 类型的定义落在哪个源文件；没登记过（或没有托管字段）返回 0xFFFF。 */
static u32 mgd_file(u32 ty)
{
    u32 k = mgdst_find(ty);

    return k == 0xFFFFFFFFu ? 0xFFFFu : (u32)MGDST_FILE[k];
}

/* 成员 idx 的种类：0=不是托管字段 1=托管引用 2=托管引用数组 3=弱引用 */
static int mgdst_kind(u32 ty, u32 idx)
{
    u32 k = mgdst_find(ty);
    u32 j = 0;

    if (k == 0xFFFFFFFFu || idx == 0xFFFFFFFFu)
        return 0;
    for (j = 0; j < MGDST_N[k]; j++)
        if ((u32)MGDST_IDX[k][j] == idx) {
            /* 内部编码：0=引用 1=引用数组 2=弱引用 3=按值嵌套
             * 对外：1=托管引用 2=引用数组 3=弱引用（嵌套本身不是指针） */
            if (MGDST_KIND[k][j] == 3)
                return 0;
            if (MGDST_KIND[k][j] == 4)
                return 1;       /* own 也是托管引用（只是不参与引用环） */
            return (int)MGDST_KIND[k][j] + 1;
        }
    return 0;
}

/* 这个类型"按值"带着托管引用吗？（结构体、按值嵌套的子结构体、
 * 托管字段数组都算）——这种类型不能按值声明/传参/赋值：拷贝一份引用
 * 却不加计数，两头都会以为自己拥有它。 */
static int ty_has_mgd(u32 ty)
{
    u32 n = 0;
    u32 i = 0;

    if (!ty || ty_is_ptr(ty) || !ty_is_agg(ty))
        return 0;
    n = TY_AT(ty)->a;                 /* 成员个数 */
    for (i = 0; i < n; i++) {
        int k = mgdst_kind(ty, i);

        if (k == 1 || k == 2)         /* 托管引用 / 托管引用数组 */
            return 1;
        if (k == 3)                   /* 弱引用：不拥有对象，拷贝没事 */
            continue;
        if (TY_AT(ty)->kids && ty_has_mgd(TY_AT(ty)->kids[i]))
            return 1;                 /* 按值嵌套的子结构体 */
    }
    return 0;
}

/* 诊断里用的类型名：`struct Foo` / `union Foo` */
static void agg_disp_name(u32 ty, char *buf, size_t cap);
static void pa_error(const char *fmt, ...);
static int in_c6_tu(void);
static int E_CLOSURE_LIT;
static const char *E_CLOSURE_NAME;

/* 捕获式字面量的值是个**闭包对象**（带环境）：转成普通函数指针就把环境丢了，
 * 调用时参数对不上、一跳就飞（tests/errors/closure_capture.c6）。 */
static void closure_lit_check(u32 to_ty)
{
    if (!E_CLOSURE_LIT || !in_c6_tu())
        return;
    if (ty_is_ptr(to_ty) && ty_is_func(ty_target(to_ty)))
        pa_error("this literal captures '%s', so its value is a closure, not a "
                 "function pointer: use 'closure RET (parameters)' as the type, or "
                 "pass the value in as a parameter",
                 E_CLOSURE_NAME ? E_CLOSURE_NAME : "?");
}



/* 诊断里用的类型名：聚合体走 agg_disp_name，标量/指针给个短名。
 * 轮流用 4 块缓冲，同一条 pa_error 里出现两次也不会串。 */
static const char *ty_disp(u32 ty)
{
    static char b[4][96];
    static int k;

    k = (k + 1) & 3;
    b[k][0] = 0;
    if (ty_is_agg(ty)) {
        agg_disp_name(ty, b[k], sizeof(b[k]));
        return b[k];
    }
    if (ty == ty_void())
        snprintf(b[k], sizeof(b[k]), "void");
    else if (ty_is_ptr(ty)) {
        if (ty_target(ty) == ty_void())
            snprintf(b[k], sizeof(b[k]), "void *");
        else if (ty_is_agg(ty_target(ty))) {
            char t2[64] = {0};

            agg_disp_name(ty_target(ty), t2, sizeof(t2));
            snprintf(b[k], sizeof(b[k]), "%s *", t2);
        } else
            snprintf(b[k], sizeof(b[k]), "pointer");
    } else if (ty_is_array(ty))
        snprintf(b[k], sizeof(b[k]), "array of %s", ty_disp(ty_target(ty)));
    else if (ty_is_int(ty))
        snprintf(b[k], sizeof(b[k]), "int");
    else
        snprintf(b[k], sizeof(b[k]), "value");
    return b[k];
}

static void pa_error(const char *fmt, ...);
static u32 ty_tuple(const u32 *tys, u32 n);
static u32 ty_slice(u32 et);

/* 在函数体里声明的 struct/union：这种类型只在那个函数里可见，不能出现在
 * 元组/切片这类"要按值搬来搬去"的地方。 */
#define LOCAL_AGG_MAX 512
static u32 LOCAL_AGG[LOCAL_AGG_MAX];
static int NLOCAL_AGG;

static void local_agg_mark(u32 ty)
{
    int i = 0;

    for (i = 0; i < NLOCAL_AGG; i++)
        if (LOCAL_AGG[i] == ty)
            return;
    if (NLOCAL_AGG < LOCAL_AGG_MAX)
        LOCAL_AGG[NLOCAL_AGG++] = ty;
}

static int is_local_agg(u32 ty)
{
    int i = 0;

    for (i = 0; i < NLOCAL_AGG; i++)
        if (LOCAL_AGG[i] == ty)
            return 1;
    return 0;
}

/* 元组元素的合法性（tests/errors/tuple.c6）：元组按值搬，元素不能是 void、
 * 函数、数组，也不能是不完整类型或者函数里声明的结构体。 */
static u32 ty_tuple_chk(const u32 *tys, u32 tn)
{
    u32 i = 0;

    for (i = 0; i < tn; i++) {
        u32 t = tys[i];

        if (t == ty_void()) {
            pa_error("'tuple' element cannot be 'void'");
            continue;
        }
        if (ty_is_func(t)) {
            pa_error("'tuple' element cannot be a function type");
            continue;
        }
        if (ty_is_array(t)) {
            pa_error("'tuple' element cannot be an array type");
            continue;
        }
        if (ty_is_agg(t) && ty_size(t) == 0) {
            pa_error("'tuple' requires a complete element type, not '%s'", ty_disp(t));
            continue;
        }
        if (ty_is_agg(t) && is_local_agg(t))
            pa_error("the element type of a 'tuple' must be declared at file scope, "
                     "but '%s' is local", ty_disp(t));
    }
    return ty_tuple(tys, tn);
}

/* 切片元素的合法性：和元组一样按值搬，元素必须完整、不能是函数里声明的
 * 结构体，也不能是 `error`（tests/errors/slice.c6）。 */
static u32 ty_slice_chk(u32 et)
{
    if (ty_is_agg(et) && ty_size(et) == 0)
        pa_error("'[:]' requires a complete element type, not '%s'", ty_disp(et));
    else if (ty_is_agg(et) && is_local_agg(et))
        pa_error("the element type of '[:]' must be declared at file scope, but "
                 "'%s' is local", ty_disp(et));
    else if (ty_is_func(et))
        pa_error("'[:]' element cannot be a function type");
    return ty_slice(et);
}

static void agg_disp_name(u32 ty, char *buf, size_t cap)
{
    const char *tn = sym_tag_name(ty);

    snprintf(buf, cap, "%s %s", ty_is_union(ty) ? "union" : "struct",
             tn ? tn : "<anonymous>");
}

static void data_u64(u32 off, u64 v)
{
    int i = 0;

    for (i = 0; i < 8; i++)
        DATA_IMG.p[off + i] = (u8)((v >> (i * 8)) & 0xFF);
}

/* `<结构体>_drop` 登记：`void drop(struct T *self)` 和结构体体里的
 * `void drop()` 方法都算 T 的析构，运行时释放到零时调它。 */
#define MGD_DROP_MAX 128
static u32 DROP_TY[MGD_DROP_MAX];
static u32 DROP_SYM[MGD_DROP_MAX];
static u32 NDROP;

static void drop_reg(u32 ty, u32 sym)
{
    u32 k = 0;

    for (k = 0; k < NDROP; k++)
        if (DROP_TY[k] == ty) {
            DROP_SYM[k] = sym;
            return;
        }
    if (NDROP < MGD_DROP_MAX) {
        DROP_TY[NDROP] = ty;
        DROP_SYM[NDROP] = sym;
        NDROP++;
    }
}

/* 这个符号是不是登记过的析构函数（`T_drop`）？析构函数不能显式调用：
 * 它由引用计数在最后一个引用放掉时调。 */
static int drop_is_sym(u32 sym)
{
    u32 k = 0;

    if (!sym)
        return 0;
    for (k = 0; k < NDROP; k++)
        if (DROP_SYM[k] == sym)
            return 1;
    return 0;
}

static u32 drop_of(u32 ty)
{
    u32 k = 0;

    for (k = 0; k < NDROP; k++)
        if (DROP_TY[k] == ty)
            return DROP_SYM[k];
    return 0;
}

#define DESC_MAX 256
static u32 DESC_TY[DESC_MAX];
static u32 DESC_SYM[DESC_MAX];
static u32 NDESC;

/* 把 ty 的托管字段展开成偏移表（递归进按值嵌套的结构体，数组按元素展开）。
 * 返回写进 out 的条数。 */
static u32 mgd_offsets(u32 ty, u32 base, u32 *out, u32 cap, u32 n)
{
    u32 mi = mgdst_find(ty);
    u32 k = 0;

    if (mi == 0xFFFFFFFFu)
        return n;
    for (k = 0; k < MGDST_N[mi] && n < cap; k++) {
        u32 mo = ty_member_off(ty, MGDST_IDX[mi][k]);
        u32 kind = MGDST_KIND[mi][k];
        u32 cnt = MGDST_CNT[mi][k];
        u32 i = 0;

        if (kind == 0 || kind == 4) {
            /* 4 = `own @T`：不参与引用环分析，但销毁时照样要放 */
            out[n++] = base + mo;
        } else if (kind == 1) {
            /* 引用数组：元素是 8 字节指针，逐个登记 */
            for (i = 0; i < cnt && n < cap; i++)
                out[n++] = base + mo + i * 8;
        } else if (kind == 3) {
            n = mgd_offsets(ty_member(ty, MGDST_IDX[mi][k]), base + mo, out, cap, n);
        }
    }
    return n;
}

/* 给结构体类型 ty 发一份 `{ drop, foff, nfoff }` 描述符，返回数据符号。 */
/* ty 里偏移 off 上的成员是托管引用吗？（方法体里裸写成员名时要用：
 * 那里是手搓地址，不会经过普通成员访问的 PEND_MGD 判定） */
static int mgd_at_off(u32 ty, u32 off)
{
    u32 foffs[64] = {0};
    u32 n = 0;
    u32 i = 0;

    n = mgd_offsets(ty, 0, foffs, 64, 0);
    for (i = 0; i < n; i++)
        if (foffs[i] == off)
            return 1;
    return 0;
}

static u32 mgd_desc(u32 ty)
{
    u32 k = 0;
    u32 off = 0;
    u32 foff = 0;
    u32 fsym = 0;
    u32 mi = 0;
    u32 nf = 0;
    u32 *foffs = NULL;
    u32 drop_sym = 0;
    char nm[192] = {0};
    const char *tag = sym_tag_name(ty);

    for (k = 0; k < NDESC; k++)
        if (DESC_TY[k] == ty)
            return DESC_SYM[k];
    if (NDESC >= DESC_MAX)
        return 0;
    mi = mgdst_find(ty);
    if (mi != 0xFFFFFFFFu && MGDST_N[mi] > 0) {
        u32 FOFF_MAX2 = 8 * MGDST_FLD;

        foffs = arena_alloc(&A_main, (size_t)FOFF_MAX2 * sizeof(u32));
        nf = mgd_offsets(ty, 0, foffs, FOFF_MAX2, 0);
        if (nf) {
            foff = data_alloc(nf * 8, 8);
            for (k = 0; k < nf; k++)
                data_u64(foff + k * 8, (u64)foffs[k]);
            snprintf(nm, sizeof(nm), "__c6_fo_%u", (unsigned)ty);
            fsym = x64_data_sym(&X64, arena_strdup(&A_main, nm), ELF_HDR + foff);
        }
    }
    drop_sym = drop_of(ty);
    off = data_alloc(24, 8);
    if (drop_sym)
        data_fixup_add(off, drop_sym);
    if (fsym)
        data_fixup_add(off + 8, fsym);
    data_u64(off + 16, (u64)nf);
    snprintf(nm, sizeof(nm), "__c6_desc_%u", (unsigned)ty);
    k = x64_data_sym(&X64, arena_strdup(&A_main, nm), ELF_HDR + off);
    DESC_TY[NDESC] = ty;
    DESC_SYM[NDESC] = k;
    NDESC++;
    return k;
}

/* c6 元组 `(T1, T2, …)`：就是一个布局固定的匿名 struct，成员名按位置叫
 * "0"/"1"/…。按元素类型列表缓存，同一个元组在任何地方都是同一个类型 id。 */
#define TUPLE_CACHE_MAX 128
#define TUPLE_MAXN 8
static u32 TUPLE_KEY[TUPLE_CACHE_MAX][TUPLE_MAXN];
static u32 TUPLE_TY[TUPLE_CACHE_MAX];
static u32 NTUPLE;

static u32 ty_tuple(const u32 *tys, u32 n)
{
    u32 i = 0;
    u32 j = 0;
    u32 mem[TUPLE_MAXN] = {0};
    const char *names[TUPLE_MAXN] = {0};
    u32 lens[TUPLE_MAXN] = {0};
    u32 ty = 0;

    if (n < 2)
        return n ? tys[0] : ty_int();
    for (i = 0; i < NTUPLE; i++) {
        int same = 1;

        for (j = 0; j < n; j++)
            if (TUPLE_KEY[i][j] != tys[j])
                same = 0;
        if (same)
            return TUPLE_TY[i];
    }
    for (j = 0; j < n; j++) {
        char *nm = arena_alloc(&A_main, 4);

        mem[j] = tys[j];
        nm[0] = (char)('0' + (int)j);
        nm[1] = 0;
        names[j] = nm;
        lens[j] = 1;
    }
    ty = ty_agg(mem, NULL, n, 0, 1u + (u32)(sym_hash_str("tuple", 5) & 0x7FFFFFFFu) + NTUPLE);
    agg_names_set(ty, names, lens, n);
    if (NTUPLE < TUPLE_CACHE_MAX) {
        for (j = 0; j < n; j++)
            TUPLE_KEY[NTUPLE][j] = tys[j];
        TUPLE_TY[NTUPLE] = ty;
        NTUPLE++;
    }
    return ty;
}

static int ty_is_tuple(u32 ty)
{
    u32 i = 0;

    for (i = 0; i < NTUPLE; i++)
        if (TUPLE_TY[i] == ty)
            return 1;
    return 0;
}

static Tok PA_BUF[PA_LOOK];
static int PA_HAVE;
/* 环形游标：消费时只挪 PA_HEAD，不再把整个窗口往前 memmove。
 * 窗口满的时候（一次深度前瞻之后）每次 advance 要搬 15 个 32 字节的
 * token，profiler 里 pa_fill 一项就占 16%。 */
static int PA_HEAD;

/* 窗口里“当前 token”的地址，PA_HAVE == 0 时为 NULL。
 *
 * pa_cur() 是**全编译器调用次数最多的函数**（tcc.c 上一次编译 648 万次，
 * 加上 pa_is_punct 319 万、pa_is_ident 239 万），原来每次都要
 * `PA_HAVE 判断 + PA_HEAD 取模 + PA_BUF 基址` 三条 load 加几条 lea。
 * 把地址缓存在这里之后只剩一条 load 一次判断，省下约 4 条指令/次。
 * 只在 pa_fill 结尾和 pa_advance 结尾写，另外 PA_HAVE 清零的地方统一走
 * pa_win_clear()。 */
static Tok *PA_CURP;

C6C_INLINE void pa_win_clear(void)
{
    PA_HAVE = 0;
    PA_CURP = NULL;
}

/* ---------- 模板（泛型）的 token 重放 ----------
 * c6 的模板在声明处只**捕获 token 区间**，实例化时把这段 token 重放一遍，
 * 参数名临时绑成 typedef——不需要"类型替换"那套机械，模板体里写什么就按
 * 什么解析。捕获和重放都挂在 pa_fill 上，前向窗口的逻辑一行没动。 */
#define RP_MAX 8
typedef struct RpFrame {
    Tok *toks;
    u32 n;
    u32 pos;
} RpFrame;

static RpFrame RP[RP_MAX];
static int RP_N;

/* token 来源栈：重放模板时，当前**前瞻窗口里还没消费**的 token 必须先存下来、
 * 排到重放流后面去（否则重放一开始读到的是源文件里紧跟着的那几个）。
 * 栈空时用预处理器。 */
#define SRC_MAX 16
typedef struct TokSrc {
    Tok *t;
    u32 n;
    u32 pos;
} TokSrc;

static TokSrc SRC[SRC_MAX];
static int NSRC;

static void pa_src_push(Tok *t, u32 n)
{
    if (NSRC >= SRC_MAX || n == 0)
        return;
    SRC[NSRC].t = t;
    SRC[NSRC].n = n;
    SRC[NSRC].pos = 0;
    NSRC++;
}

/* 把 `t` 压回源栈、让解析器重读一遍。**前瞻窗口里已经拉到但还没消费的 token
 * 必须先垫在下面**（SRC 是栈，后压的在上面），否则重放一开始读到的是那几个
 * 旧 token，整段就串位了。 */
static Tok *pa_peek(int k);      /* 下面几百行才定义，这里先用 */

static void pa_src_push_back(Tok *t, u32 n)
{
    if (PA_HAVE > 0) {
        Tok *save = arena_alloc(&A_main, sizeof(Tok) * (size_t)PA_HAVE);
        u32 ns = (u32)PA_HAVE;
        u32 q = 0;

        for (q = 0; q < ns; q++)
            save[q] = *pa_peek((int)q);
        pa_win_clear();
        pa_src_push(save, ns);
    }
    pa_src_push(t, n);
}

#define CAP_MAX 32768
static Tok CAP_TOK[CAP_MAX];
static u32 CAP_N;
static int CAP_ON;

static void pa_fill(int want)
{
    if (PA_HAVE >= want)
        return;
    while (PA_HAVE < want && PA_HAVE < PA_LOOK) {
        int at = PA_HEAD + PA_HAVE;
        Tok *t = NULL;
        int k = 0;

        if (at >= PA_LOOK)
            at -= PA_LOOK;
        /* 直接填进窗口格子（out 只是中途落脚点）：先落到局部 Tok、再拷进
         * PA_BUF 是每个 token 两趟 40 字节的搬运。 */
        t = &PA_BUF[at];
        if (NSRC > 0) {
            TokSrc *sc = &SRC[NSRC - 1];

            if (sc->pos < sc->n) {
                *t = sc->t[sc->pos++];
                k = (int)t->kind;
            } else {
                NSRC--;
                continue;
            }
        } else {
            k = pp_next(t);
            if (k == TK_NL)
                continue;
        }
        /* 捕获要记**所有**进来的 token，不只是预处理器的。函数字面量里再写
         * 函数字面量时，外层体是从 SRC 栈里重放的，只记预处理器那条路的话
         * 内层体捕到的是空串（`tests/fn_lit.c6` 的嵌套字面量）。 */
        if (CAP_ON && CAP_N < CAP_MAX) {
            /* 拉进来的 token 未必都会被消费（前瞻窗口会多拉几个），
             * 由捕获结束时的花括号配平来裁掉多余的。 */
            CAP_TOK[CAP_N++] = *t;
        }
        PA_HAVE++;
        if (k == TK_EOF)
            break;
    }
    PA_CURP = PA_HAVE > 0 ? &PA_BUF[PA_HEAD] : NULL;
}

static Tok *pa_peek_slow(int k)
{
    static Tok eof_tok;
    static int inited = 0;

    if (!inited) {
        memset(&eof_tok, 0, sizeof(eof_tok));
        eof_tok.kind = TK_EOF;
        inited = 1;
    }
    pa_fill(k + 1);
    if (k >= PA_HAVE)
        return &eof_tok;
    {
        int idx2 = PA_HEAD + k;

        if (idx2 >= PA_LOOK)
            idx2 -= PA_LOOK;
        return &PA_BUF[idx2];
    }
}

/* 前瞻一格是解析器最频繁的动作之一（profile 里 pa_peek 占 2.6%）。
 * 窗口里已经有就直接给指针，不再走 pa_fill 的那个函数调用 + 判空。 */
C6C_INLINE Tok *pa_peek(int k)
{
    if (k < PA_HAVE) {
        int idx = PA_HEAD + k;

        if (idx >= PA_LOOK)
            idx -= PA_LOOK;
        return &PA_BUF[idx];
    }
    return pa_peek_slow(k);
}

C6C_INLINE Tok *pa_cur(void)
{
    Tok *t = PA_CURP;

    if (t)
        return t;
    pa_fill(1);
    t = PA_CURP;
    if (t)
        return t;
    return pa_peek(0);
}

static void pa_advance(void)
{
    if (PA_HAVE <= 0)
        return;
    PA_HEAD++;
    if (PA_HEAD >= PA_LOOK)
        PA_HEAD = 0;
    PA_HAVE--;
    pa_fill(1);
    PA_CURP = PA_HAVE > 0 ? &PA_BUF[PA_HEAD] : NULL;
}

/* 单字符标点：`pa_is_punct("}")` 这一类占全部标点判断的九成二（550/597 个
 * 调用点）。走字符串版要先 load 首字节、再查 s[t->len] 是不是 0、最后还要进
 * tok_eq 循环，二十条指令才能说一句“不是”；单字符版只要 kind / len / 首字节
 * 三条判断，十亿级调用次数下这笔差值是实打实的。调用点统一换成 pa_is_ch。 */
C6C_INLINE int pa_is_ch(int ch)
{
    Tok *t = pa_cur();
    const char *d = NULL;

    if (t->kind != TK_PUNCT || t->len != 1)
        return 0;
    d = tok_data(t);
    return (u8)d[0] == (u8)(ch & 0xFF);
}

/* 同上：名字是固定字面量，长度编译期已知，先比 t->len 再比字节。
 * 调用点由脚本统一换成 PA_IS_IDENT / PA_ACCEPT_IDENT。 */
C6C_INLINE int pa_is_ident_n(const char *s, u32 n)
{
    Tok *t = pa_cur();

    return t->kind == TK_IDENT && tok_eq_len(t, s, n);
}

C6C_INLINE int pa_accept_ident_n(const char *s, u32 n)
{
    if (pa_is_ident_n(s, n)) {
        pa_advance();
        return 1;
    }
    return 0;
}

#define PA_IS_IDENT(lit) pa_is_ident_n((lit), (u32)(sizeof(lit) - 1))
#define PA_ACCEPT_IDENT(lit) pa_accept_ident_n((lit), (u32)(sizeof(lit) - 1))

C6C_INLINE int pa_accept_ch(int ch)
{
    if (pa_is_ch(ch)) {
        pa_advance();
        return 1;
    }
    return 0;
}

C6C_INLINE int pa_is_punct(const char *s)
{
    Tok *t = pa_cur();

    /* 先比首字节和长度，绝大多数不匹配的调用一步就否掉（profiler 里这条
     * 判断占 9.9%，是全编译器最热的谓词之一）。 */
    if (t->kind != TK_PUNCT || t->len == 0 || tok_data(t)[0] != s[0] || s[t->len] != 0)
        return 0;
    return tok_eq(t, s);
}

C6C_INLINE int pa_is_ident(const char *s)
{
    Tok *t = pa_cur();

    return t->kind == TK_IDENT && tok_eq(t, s);
}

C6C_INLINE int pa_accept_punct(const char *s)
{
    if (pa_is_punct(s)) {
        pa_advance();
        return 1;
    }
    return 0;
}

C6C_INLINE int pa_accept_ident(const char *s)
{
    if (pa_is_ident(s)) {
        pa_advance();
        return 1;
    }
    return 0;
}

static void pa_dbg_counts(void);
static u32 frame_slots_for(u32 size);
static void gen_init_braced(u32 addr, u32 ty, u32 off);
static void gen_init_obj(u32 addr, u32 ty, u32 off);
static u32 INIT_COUNT;      /* 上一次初始化器给了多少个元素（补全 a[] 长度用） */
static int INIT_CNT_OK;     /* INIT_COUNT 是否被这次初始化器写过（空初始化器也算 0） */
/* GNU 语句表达式 ({ ... })：值 = 块里最后一条表达式语句的值 */
static u32 BLOCK_VAL;
static u32 BLOCK_TY;
static int BLOCK_HAS;
static u32 METHOD_SELF_TY;  /* 结构体内方法：接收者类型（0 = 普通函数） */
static u32 CUR_RET_TY;      /* 当前函数的返回类型（return 要按它转换） */
static u32 ty_promote(u32 ty);
static u32 gen_unary(void);
static int parse_const_u64(u64 *out);
static u32 cur_op_ty(void);
static u32 gen_convert(u32 v, u32 from, u32 to);
static void gen_block(void);

/* 上限可调：环境变量 C6C_MAX_ERRORS（默认 20），调大是为了能一次看清
 * 大文件（比如 tcc.h）里所有独立的错误点。 */
static int pa_err_cap = -1;

/* 当前 token 所在的源文件是不是 c6 翻译单元（扩展名 `.c6`）？c6 的语法与
 * 诊断只对 `.c6` 生效：纯 C 的 TU（`tests/abi/*_plain.c`、tcc 的源码）照 C
 * 的规矩来——那边"未初始化"是合法的。 */
static int DEF_DEPTH;      /* 前向声明：块嵌套深度（定义在后面，见 gen_block） */

static int C6_TU_SEEN;      /* 这个编译单元里有 .c6 文件（主文件就是） */

static int in_c6_tu(void)
{
    Tok *t = pa_cur();
    SrcFile *f = t ? file_by_id(t->file) : NULL;
    size_t n = 0;

    if (!f || !f->path)
        return 0;
    n = strlen(f->path);
    if (n > 3 && memcmp(f->path + n - 3, ".c6", 3) == 0) {
        /* 记一笔：从 .c6 里 include 进来的头文件（`.h`）也按 c6 的规矩查
         * （tests/errors/loc.c6 的 test_sizeof_in_header：头文件里不能
         * `int g;` 这样定义未初始化的对象）。 */
        C6_TU_SEEN = 1;
        return 1;
    }
    if (C6_TU_SEEN && n > 2 && memcmp(f->path + n - 2, ".h", 2) == 0)
        return 1;
    return 0;
}

/* c6 的软关键字（`shared` / `weak` / `own` / `closure` / `try` / `@` …）只在
 * .c6 里才有特殊含义。`.c` 是**纯 C99**（README 明说没有 -std=c6），这些词
 * 在那里必须是普通标识符：`int shared = 1;`、`struct S { int own; };`、
 * `s.weak++`、`s.try` 全都要编得过。所有认这几个词的地方都先过这一道。 */
static int c6_kw(void)
{
    return in_c6_tu();
}

static Tok *PA_ERR_AT;
static void pa_error(const char *fmt, ...)
{
    va_list ap = {0};
    Tok *t = PA_ERR_AT ? PA_ERR_AT : pa_cur();

    PA_ERRS++;
    if (pa_err_cap < 0) {
        const char *e = getenv("C6C_MAX_ERRORS");

        pa_err_cap = e ? atoi(e) : 20;
        if (pa_err_cap <= 0)
            pa_err_cap = 20;
    }
    if (PA_ERRS > (u32)pa_err_cap) {
        fprintf(stderr, "c6c: 错误太多，停止\n");
        exit(1);
    }
    if (getenv("C6C_DBG_COUNTS"))
        pa_dbg_counts();
    {
        /* 文件 id 0 是**合法**的首个文件——不能拿 0 当"没有位置" */
        SrcFile *sf = file_by_id(t->file);

        if (!sf && FILES.head)
            sf = FILES.head;
        fprintf(stderr, "c6c: %s:%u: ", sf ? src_path_of(sf) : "<internal>",
                sf ? src_line_of(sf, t->off) : 0);
    }
    va_start(ap, fmt);
    vfprintf(stderr, fmt, ap);
    va_end(ap);
    fputc('\n', stderr);
}

static void pa_expect_ch(int ch)
{
    if (!pa_accept_ch(ch))
        pa_error("这里要 '%c'（当前是 '%.*s'）", ch, (int)pa_cur()->len, tok_data(pa_cur()));
}

static void pa_expect_punct(const char *s)
{
    if (!pa_accept_punct(s))
        pa_error("这里要 '%s'（当前是 '%.*s'）", s, (int)pa_cur()->len, tok_data(pa_cur()));
}

/* tcc 口径的 warning：`path:line: warning: …`（**没有列号**）。
 * tcc 的 tests2 里有一批 .expect 的第一段就是它自己的告警原文
 * （tests2/149_parameter_qualifier_errors.expect 只有一行这个），格式对不上
 * 就整条用例判"输出不符"。列号那版走 diag_warn()，这个是给上游兼容用的。 */
static void pa_warn_tcc(const char *fmt, ...)
{
    va_list ap = {0};
    Tok *t = pa_cur();
    SrcFile *sf = file_by_id(t->file);

    if (!sf && FILES.head)
        sf = FILES.head;
    fprintf(stderr, "%s:%u: warning: ", sf ? src_path_of(sf) : "<internal>",
            sf ? src_line_of(sf, t->off) : 0);
    va_start(ap, fmt);
    vfprintf(stderr, fmt, ap);
    va_end(ap);
    fputc('\n', stderr);
}

/* --- 类型说明符与声明符 --- */

/* 关键字表：预先算好每个关键字的 hash，查表时先比 hash 再比字节。
 * 这个函数每个标识符 token 都要调一次，线性比 41 个字符串曾经占掉 13% 的运行时间
 * （profiler 里 tok_eq 高居第二）。 */
static u32 TYKW_HASH[64];
static const char *const TYKW_NAME[64] = {
    "void", "char", "short", "int", "long", "float", "double", "signed",
    "unsigned", "const", "volatile", "struct", "union", "enum", "static",
    "extern", "inline", "register", "auto", "_Bool", "_Atomic", "_Complex",
    "_Noreturn", "__signed__", "__const", "__volatile__", "restrict",
    "__restrict", "__restrict__", "__extension__", "typeof", "__typeof__",
    "__typeof", "_Alignas", "alignas", "_Thread_local", "__thread",
    "__attribute__", "__attribute", "_Static_assert", "__inline", "__inline__",
    "typedef",
    NULL
};

/* 关键字查找的开放寻址表：`is_typename_tok` 每个标识符都调一次，线性扫 42 个
 * 字符串曾经是 profile 里稳定的一块。槽里存"下标 + 1"，0 = 空。 */
static u16 TYKW_SLOT[256];

static void tykw_init(void)
{
    int i = 0;

    for (i = 0; TYKW_NAME[i] && i < 64; i++) {
        u32 h = tok_hash(TYKW_NAME[i], (u32)strlen(TYKW_NAME[i]));
        u32 sl = h & 255;
        int g = 0;

        TYKW_HASH[i] = h;
        while (TYKW_SLOT[sl] && g++ < 8)
            sl = (sl + 1) & 255;
        if (!TYKW_SLOT[sl])
            TYKW_SLOT[sl] = (u16)(i + 1);
    }
}

static int is_typename_tok(Tok *t)
{
    int i = 0;
    Sym *s = NULL;

    if (t->kind != TK_IDENT)
        return 0;
    /* `closure` 不进关键字表：它是 c6 独有的类型关键字，`.c` 里必须能当普通
     * 标识符（`static int wrap(int closure){ … }` 的形参名就是这么用的）。
     * 先比长度，热路径上几乎不花钱。 */
    if (t->len == 7 && memcmp(tok_data(t), "closure", 7) == 0)
        return c6_kw();
    {
        u32 sl = t->hash & 255;
        int g = 0;

        while (TYKW_SLOT[sl] && g++ < 8) {
            u32 k = (u32)TYKW_SLOT[sl] - 1;

            if (TYKW_HASH[k] == t->hash && tok_eq(t, TYKW_NAME[k]))
                return 1;
            sl = (sl + 1) & 255;
        }
    }
    i = 0;
    s = sym_find(tok_data(t), t->len);
    if (s && s->kind == SC_TYPEDEF)
        return 1;
    /* 接口名也是类型名（`sizeof(Shape)`、`(Shape)x`、`Shape s = x;`），
     * 但它不在符号表里，走接口表。 */
    return NIFACE > 0 && iface_find(tok_data(t), t->len) < IFACE_MAX;
}

/* 一个函数能有多少个形参/实参。tcc 的 `tests/abitest.c` 里有超过 16 个实参的
 * 调用，16 太紧；64 够用，栈上的临时数组也就 64 字节。 */
#define PA_ARG_MAX 64

typedef struct Declarator {
    const char *name;
    u32 nlen;
    int is_func;
    u32 ptype[16];      /* 形参类型 */
    const char *pname[16];  /* 形参名字（可能为 NULL） */
    u32 plen[16];
    u32 nparams;
    int variadic;
    u8 knr;             /* 旧式（K&R）定义：参数表里只有名字 */
    u8 knr_conv;        /* 实参按默认提升传进来（调用方没看到原型） */
    u8 pknr[PA_ARG_MAX];        /* 该参数的类型是在 K&R 声明列表里给出的 */
    u8 pmgd[PA_ARG_MAX];        /* 该参数是托管引用：1 = `@T p`（借用，返回时要加计数），2 = `weak @T p` */
    u8 pshared[PA_ARG_MAX];     /* 该参数写了 `shared @T` */
    u8 pconst[PA_ARG_MAX];      /* 该参数的**对象**是只读的（`int *const p`） */
    u8 obj_const;       /* 这个声明符声明的对象本身带 const（`*const p`） */
    u8 arrqual;         /* `int x[const 5]` 方括号里的限定符（形参：归调整后的指针） */
    u8 vla;             /* C99 变长数组：长度是运行期表达式 */
    u32 vla_cnt;        /* 长度（vreg） */
    u32 vla_esz;        /* 元素大小（字节） */
    u32 type;           /* 解析出来的完整类型（形参/抽象声明符也要用） */
    u8 mgd;             /* `@T`：托管引用（机器层面还是 T *，但要插引用计数） */
    u8 mgd_kind;        /* 0=强引用 1=weak（不加计数） 2=own（同强引用） */
    u8 mgd_shared;      /* `shared @T`：这个槽/形参按跨线程共享处理 */
    u8 own_params_taken;    /* 标识符自己那层参数表已经解析过（见 parse_param_list） */
} Declarator;

/* 发射层加模块前缀（docs/modules.md 的 M2'）：
 * 符号表里永远是短名（std/ 里跨模块引用、方法表、接口表全按短名比），
 * 只有"最终要落到目标文件里的名字"才加 `<模块前缀>`。这样 std/ 不会被前缀
 * 搅坏，两个 TU 编到一起时又不会撞名。非模块文件前缀是空串，等于恒等。 */
static const char *emit_name(const char *nm)
{
    const char *pfx = "";
    u32 pl = 0;
    char *b = NULL;

    if (CUR_FILE)
        pfx = mod_prefix(mod_of_file((u32)CUR_FILE->id));
    if (!pfx || !pfx[0] || !nm)
        return nm;
    pl = (u32)strlen(pfx);
    b = arena_alloc(&A_main, pl + strlen(nm) + 1);
    memcpy(b, pfx, pl);
    strcpy(b + pl, nm);
    return b;
}

static void pa_func_def(Sym *s, Declarator *d);
static u32 gen_expr(void);
static u32 gen_assign(void);
static u32 value_of(u32 v);
static int agg_find_promoted(u32 ty, const char *name, u32 nlen, u32 *out_ty,
                             u32 *out_off);

/* struct/union 的成员名。类型本身是 hash-consing 的（同构同 id），
 * 名字放不进 C6Type，所以另开一张由类型 id 索引的小表。
 * 查找是线性的——单 TU 里聚合类型数量是几百到几千量级，比再建一层哈希划算。 */
#define AGG_CAP0 1024
/* 成员表放在 arena 里按需增长：tcc 的 struct TCCState 有三百多个成员，
 * 定长数组要么炸要么浪费一大片 BSS。 */
typedef struct AggInfo {
    u32 ty;
    const char **names;
    u32 *lens;
    u32 n;
    u32 next_same;          /* 同类型 id 的下一条（名字表可能不同），0 = 链尾 */
} AggInfo;

/* 类型 id → 条目链的桶。成员查找是热路径（每个 `.`/`->` 都走），线性扫全表
 * 在 tcc.c 这种 TU 上会退化成 O(n²)。 */
#define AGG_NB 4096
static u32 AGG_HEAD[AGG_NB];    /* 0 = 空，否则是"条目下标 + 1" */


static AggInfo *AGG;
static u32 NAGG;
static u32 AGG_CAP;

/* 表按需扩容（arena 里翻倍 + 拷贝）：tcc.c 一个 TU 里的 struct/union 定义
 * 就超过四千个，定长表满了就静默丢条目，后面所有成员查找都变成"没有成员" */
static void agg_tab_grow(void)
{
    u32 nc = AGG_CAP ? AGG_CAP * 2 : AGG_CAP0;
    AggInfo *na = arena_alloc(&A_main, (size_t)nc * sizeof(AggInfo));

    if (AGG && NAGG)
        memcpy(na, AGG, (size_t)NAGG * sizeof(AggInfo));
    AGG = na;
    AGG_CAP = nc;
}

/* 成员 i 有没有名字？（无名的位域 `unsigned :32;` 在**位置初始化**里不占位，
 * 却有布局意义——tests2/90_struct-init.c 的 test_init_bf） */
static int agg_member_named(u32 ty, u32 idx)
{
    u32 b = ty % AGG_NB;
    u32 j = AGG_HEAD[b];

    while (j) {
        AggInfo *e = &AGG[j - 1];

        if (e->ty == ty && idx < e->n && e->names && e->names[idx]
            && e->lens && e->lens[idx] > 0)
            return 1;
        j = e->next_same;
    }
    return 0;
}

static void agg_names_set(u32 ty, const char **names, const u32 *lens, u32 n)
{
    u32 i = 0;

    /* 同构类型共用一个 type id（类型 id 只按布局哈希，不含成员名），但**成员名
     * 可能不同**。所以只有名字表完全一样才能真正共用条目，否则各占一条，
     * 查找时按类型 id 扫所有条目。`struct { unsigned short cmp_op, cmp_r; }` 与
     * 别的同布局结构撞 id，正是 tcc 的 SValue 查不到 cmp_op 的原因。 */
    {
        u32 b = ty % AGG_NB;
        u32 j = AGG_HEAD[b];

        while (j) {
            AggInfo *e = &AGG[j - 1];
            u32 k = 0;
            int same = 1;

            if (e->ty == ty && e->n == n) {
                for (k = 0; k < n; k++) {
                    if (e->lens[k] != lens[k] || !e->names[k] || !names[k]
                        || memcmp(e->names[k], names[k], lens[k]) != 0) {
                        same = 0;
                        break;
                    }
                }
                if (same)
                    return;
            }
            j = e->next_same;
        }
    }
    if (NAGG >= AGG_CAP)
        agg_tab_grow();
    AGG[NAGG].ty = ty;
    AGG[NAGG].n = n;
    AGG[NAGG].names = arena_alloc(&A_main, (size_t)(n ? n : 1) * sizeof(char *));
    AGG[NAGG].lens = arena_alloc(&A_main, (size_t)(n ? n : 1) * sizeof(u32));
    for (i = 0; i < n; i++) {
        AGG[NAGG].names[i] = names[i];
        AGG[NAGG].lens[i] = lens[i];
    }
    {
        u32 b = ty % AGG_NB;

        AGG[NAGG].next_same = AGG_HEAD[b];
        AGG_HEAD[b] = NAGG + 1;
    }
    NAGG++;
}

/* 刚访问到的成员是不是位域、位宽多少（0 = 不是位域）。整型提升要用：
 * 宽度 < 32 的无符号位域要提升成 int，否则 `u3 - 100 < 0` 会按无符号算出 0。 */
static u32 AGG_FOUND_BITS;
static u32 AGG_FOUND_IDX = 0xFFFFFFFFu;
static u32 AGG_FOUND_BITOFF;
static int AGG_FOUND_ENUMBF;
static u32 PEND_BITS;
static u32 PEND_BITOFF;
static int PEND_BF_ENUM;

/* 返回成员下标；没找到返回 -1 */
static int agg_find_member(u32 ty, const char *name, u32 len)
{
    u32 j = AGG_HEAD[ty % AGG_NB];

    while (j) {
        AggInfo *e = &AGG[j - 1];
        u32 i = 0;

        if (e->ty == ty) {
            for (i = 0; i < e->n; i++)
                if (e->lens[i] == len && e->names[i] &&
                    memcmp(e->names[i], name, len) == 0)
                    return (int)i;
            /* 同一个 type id 可能有多条名字表（布局相同、名字不同），继续找 */
        }
        j = e->next_same;
    }
    return -1;
}

/* 成员 k 是否匿名（C11 的匿名 struct/union 成员：没有名字，其成员提升到
 * 外层）。tcc 的 Sym 就是 `union { struct {int c;}; int *d; ... };` 这种。 */
static int agg_member_is_anon(u32 ty, u32 idx)
{
    u32 j = AGG_HEAD[ty % AGG_NB];

    while (j) {
        AggInfo *e = &AGG[j - 1];

        if (e->ty == ty) {
            if (idx >= e->n)
                return 0;
            if (e->names[idx] == NULL || e->lens[idx] == 0)
                return 1;       /* 任一条名字表说它是匿名的，就当匿名 */
        }
        j = e->next_same;
    }
    return 0;
}

/* 成员查找（含匿名成员的提升）：成功时给出成员类型与相对偏移 */
static int agg_find_promoted(u32 ty, const char *nm, u32 len, u32 *mty, u32 *moff)
{
    int i = 0;
    u32 n = 0;
    u32 k = 0;

    *mty = 0;
    *moff = 0;
    AGG_FOUND_IDX = 0xFFFFFFFFu;
    i = agg_find_member(ty, nm, len);
    if (i >= 0) {
        u32 bw = 0;

        AGG_FOUND_IDX = (u32)i;
        *mty = ty_member(ty, (u32)i);
        *moff = ty_member_off(ty, (u32)i);
        AGG_FOUND_BITS = ty_member_bits(ty, (u32)i);
        AGG_FOUND_BITOFF = ty_member_bitoff(ty, (u32)i);
        AGG_FOUND_ENUMBF = ty_member_enum_bf(ty, (u32)i);
        bw = AGG_FOUND_BITS;
        (void)bw;
        return 1;
    }
    n = ty_member_n(ty);
    for (k = 0; k < n; k++) {
        u32 mt = ty_member(ty, k);
        u32 sub = 0;

        if (!ty_is_agg(mt) || !agg_member_is_anon(ty, k))
            continue;
        if (agg_find_promoted(mt, nm, len, mty, &sub)) {
            *moff = ty_member_off(ty, k) + sub;
            return 1;              /* AGG_FOUND_BITS 已经由内层设好 */
        }
    }
    return 0;
}

/* 字符族判断：插值只接受"能当文本看"的切片/指针。`@char` 这种托管文本
 * 在类型表里是"切片，元素是 char 指针"，所以要顺着指针再认一层。 */
static int ty_charish(u32 t)
{
    if (!t)
        return 0;
    if (t == ty_char() || t == ty_schar() || t == ty_uchar())
        return 1;
    if (ty_size(t) == 1)
        return 1;
    if (ty_is_ptr(t))
        return ty_charish(ty_target(t));
    return 0;
}

/* 任务句柄：`async T f(…)` 的返回类型是指向 `struct f_task { T val; }` 的
 * 指针（见 pa_func_def）。判断"这是个任务"就看目标类型有没有 val 成员。 */
static int ty_is_task_ptr(u32 ty)
{
    u32 mt = 0;
    u32 mo = 0;

    if (!ty_is_ptr(ty))
        return 0;
    return agg_find_promoted(ty_target(ty), "val", 3, &mt, &mo);
}

static u32 parse_typespec(void);

/* 当前 `(` 打头的是不是元组类型 `(T1, T2, …)`？
 *
 * 光看"有逗号"不够：函数指针形参 `(const void *, const void *)` 里也有逗号。
 * 元组类型后面一定紧跟着声明符的名字，所以再加一条"配对 `)` 之后是标识符"。
 * 只看 PA_LOOK 以内的 token，看不完就当不是。 */
static int pa_at_tuple_type(void)
{
    int depth = 0;
    int comma = 0;
    int k = 0;

    if (!pa_is_ch('('))
        return 0;
    for (k = 0; k < PA_LOOK; k++) {
        Tok *q = pa_peek(k);

        if (q->kind != TK_PUNCT)
            continue;
        if (tok_eq(q, "(")) {
            depth++;
        } else if (tok_eq(q, ")")) {
            depth--;
            if (depth == 0) {
                Tok *nx = pa_peek(k + 1);

                return comma && nx && nx->kind == TK_IDENT;
            }
        } else if (depth == 1 && TOK_EQ(q, "...")) {
            return 0;                /* 变参函数类型，不是元组 */
        } else if (depth == 1 && tok_eq(q, ",")) {
            comma = 1;
        }
    }
    return 0;
}

/* ---------- c6 角色宏 ----------
 * 文件作用域里长得像函数的宏：
 *
 *   stmt swap(expr a, expr b) { typeof(a) t = (a); (a) = (b); (b) = t; }
 *
 * 开头那个词是**角色**，说明展开结果怎么用；每个形参前面也带角色。展开是
 * 纯 token 级的（和模板一样把 token 压进 SRC 栈重放），所以实参里可以再写
 * 宏调用，递归展开是自然发生的。
 *
 *   expr  展开成 ( 体 )，实参各自加一层括号
 *   stmt  展开成 { 体 }，当语句用
 *   ident 原样重放（给 ## / 字符串化用）
 *   type  原样重放，当类型说明符用
 *
 * 卫生：宏体里自己声明的局部变量，每次展开加一个唯一后缀重命名，不会捕获
 * 调用处的同名变量；写了 `__local` 的保持原名。
 */
#define CM_MAX 96
#define CM_NP 8
#define CM_TOK_MAX 4096
#define CM_ID_MAX 64

enum { CM_ROLE_EXPR = 0, CM_ROLE_STMT = 1, CM_ROLE_IDENT = 2, CM_ROLE_TYPE = 3 };

typedef struct CMacro {
    const char *name;
    u32 nlen;
    int role;
    int np;
    const char *pname[CM_NP];
    u32 plen[CM_NP];
    int prole[CM_NP];
    Tok *body;
    u32 nbody;
    /* 体内自己声明的局部变量（卫生重命名用） */
    const char *loc[CM_NP * 4];
    u32 loclen[CM_NP * 4];
    int nloc;
} CMacro;

static CMacro CM[CM_MAX];
static u32 NCM;
static u32 CM_SEQ;

static u32 tmpl_capture_body(void);
static int CM_STMT_DEPTH;
static int CM_EXPR_DEPTH;

static int cm_role_of(const char *s, u32 n)
{
    if (n == 4 && memcmp(s, "expr", 4) == 0)
        return CM_ROLE_EXPR;
    if (n == 4 && memcmp(s, "stmt", 4) == 0)
        return CM_ROLE_STMT;
    if (n == 5 && memcmp(s, "ident", 5) == 0)
        return CM_ROLE_IDENT;
    if (n == 4 && memcmp(s, "type", 4) == 0)
        return CM_ROLE_TYPE;
    return -1;
}

static CMacro *cm_find(const char *s, u32 n)
{
    u32 i = 0;

    for (i = 0; i < NCM; i++)
        if (CM[i].nlen == n && memcmp(CM[i].name, s, n) == 0)
            return &CM[i];
    return NULL;
}

static Tok cm_syn_punct(const char *s, u32 n)
{
    Tok t = {0};

    t.kind = TK_PUNCT;
    t.len = n;
    t.hash = tok_hash(s, n);
    t.flags = TF_SYN;
    t.syn = (char *)s;
    return t;
}

static Tok cm_syn_ident(const char *s, u32 n)
{
    Tok t = {0};
    char *buf = arena_alloc(&A_main, (size_t)n + 1);

    memcpy(buf, s, n);
    buf[n] = 0;
    t.kind = TK_IDENT;
    t.len = n;
    t.hash = tok_hash(buf, n);
    t.flags = TF_SYN;
    t.syn = buf;
    return t;
}

/* 当前 token 是不是这个宏的调用点（名字后面紧跟 '('） */
static CMacro *cm_at_call(int role)
{
    Tok *t = pa_cur();
    CMacro *m = NULL;

    if (t->kind != TK_IDENT)
        return NULL;
    if (!pa_peek(1) || pa_peek(1)->kind != TK_PUNCT || !tok_eq(pa_peek(1), "("))
        return NULL;
    m = cm_find(tok_data(t), t->len);
    if (!m || (role >= 0 && m->role != role))
        return NULL;
    return m;
}

/* 读一个实参：从当前 token 开始，括号/方括号/花括号配平，遇到顶层 ',' 或
 * ')' 停（不消费它们）。返回收进 out 的 token 数。 */
static u32 cm_read_arg(Tok *out, u32 cap)
{
    int depth = 0;
    u32 n = 0;

    while (pa_cur()->kind != TK_EOF) {
        Tok *t = pa_cur();

        if (t->kind == TK_PUNCT) {
            if (depth == 0 && (tok_eq(t, ",") || tok_eq(t, ")")))
                break;
            if (tok_eq(t, "(") || TOK_EQ(t, "[") || TOK_EQ(t, "{"))
                depth++;
            else if (tok_eq(t, ")") || TOK_EQ(t, "]") || TOK_EQ(t, "}"))
                depth--;
        }
        if (n < cap)
            out[n++] = *t;
        pa_advance();
    }
    return n;
}

/* 展开一次（当前 token 是宏名）。args/alen 已由调用方读好。 */
static void cm_push_expansion(CMacro *m, Tok *args, const u32 *aoff, const u32 *alen,
                              int narg)
{
    Tok *out = arena_alloc(&A_main, sizeof(Tok) * CM_TOK_MAX);
    u32 no = 0;
    u32 i = 0;
    u32 seq = CM_SEQ++;
    int paste = 0;
    /* 卫生后缀：`tmp` → `tmp__<seq>` */
    char sfx[24] = {0};
    u32 slen = 0;

    snprintf(sfx, sizeof(sfx), "__%u", (unsigned)seq);
    slen = (u32)strlen(sfx);

#define CM_PUT(tok) do { \
        if (no < CM_TOK_MAX) { \
            out[no] = (tok); \
            if (paste && no > 0) { \
                char *cat = arena_alloc(&A_main, (size_t)out[no - 1].len + out[no].len + 1); \
                memcpy(cat, tok_data(&out[no - 1]), out[no - 1].len); \
                memcpy(cat + out[no - 1].len, tok_data(&out[no]), out[no].len); \
                cat[out[no - 1].len + out[no].len] = 0; \
                out[no - 1] = cm_syn_ident(cat, out[no - 1].len + out[no].len); \
                paste = 0; \
                no--; \
            } \
            no++; \
        } \
    } while (0)

    for (i = 0; i < m->nbody; i++) {
        Tok *b = &m->body[i];
        int pi = -1;
        int k = 0;
        const char *bd = NULL;

        if (b->kind == TK_EOF)
            continue;                    /* `__local` 的占位 */
        if (b->kind == TK_PUNCT && TOK_EQ(b, "##")) {
            paste = 1;
            continue;
        }
        /* 形参？ */
        if (b->kind == TK_IDENT) {
            bd = tok_data(b);
            for (k = 0; k < m->np; k++) {
                if (m->plen[k] == b->len && memcmp(m->pname[k], bd, b->len) == 0) {
                    pi = k;
                    break;
                }
            }
        }
        if (pi >= 0) {
            u32 a0 = aoff[pi];
            u32 an = alen[pi];
            u32 j = 0;

            if (m->prole[pi] == CM_ROLE_EXPR) {
                CM_PUT(cm_syn_punct("(", 1));
                for (j = 0; j < an; j++)
                    CM_PUT(args[a0 + j]);
                CM_PUT(cm_syn_punct(")", 1));
            } else {
                for (j = 0; j < an; j++)
                    CM_PUT(args[a0 + j]);
            }
            continue;
        }
        /* 体内局部变量：重命名 */
        if (b->kind == TK_IDENT && m->nloc > 0) {
            int isloc = 0;

            bd = tok_data(b);
            for (k = 0; k < m->nloc; k++) {
                if (m->loclen[k] == b->len && memcmp(m->loc[k], bd, b->len) == 0) {
                    isloc = 1;
                    break;
                }
            }
            if (isloc) {
                char *nm = arena_alloc(&A_main, (size_t)b->len + slen + 1);

                memcpy(nm, bd, b->len);
                memcpy(nm + b->len, sfx, slen);
                nm[b->len + slen] = 0;
                CM_PUT(cm_syn_ident(nm, b->len + slen));
                continue;
            }
        }
        CM_PUT(*b);
    }
#undef CM_PUT

    if (m->role == CM_ROLE_EXPR) {
        Tok *w = arena_alloc(&A_main, sizeof(Tok) * (no + 2));
        u32 j = 0;

        w[0] = cm_syn_punct("(", 1);
        for (j = 0; j < no; j++)
            w[j + 1] = out[j];
        w[no + 1] = cm_syn_punct(")", 1);
        out = w;
        no += 2;
    } else if (m->role == CM_ROLE_STMT) {
        Tok *w = arena_alloc(&A_main, sizeof(Tok) * (no + 2));
        u32 j = 0;

        w[0] = cm_syn_punct("{", 1);
        for (j = 0; j < no; j++)
            w[j + 1] = out[j];
        w[no + 1] = cm_syn_punct("}", 1);
        out = w;
        no += 2;
    }
    (void)narg;
    if (no > 0) {
        /* 前瞻窗口里已经拉到、但还没消费的 token 要先垫在下面 */
        if (PA_HAVE > 0) {
            Tok *save = arena_alloc(&A_main, sizeof(Tok) * (size_t)PA_HAVE);
            u32 ns = (u32)PA_HAVE;
            u32 q = 0;

            for (q = 0; q < ns; q++)
                save[q] = *pa_peek((int)q);
            pa_win_clear();
            pa_src_push(save, ns);
        }
        pa_src_push(out, no);
    }
}

/* 收集实参（当前 token 是宏名）。返回实参个数，argc 越界时截断。 */
#define CM_ARG_MAX 8192
static Tok CM_ARGS[CM_ARG_MAX];

static int cm_collect_args(CMacro *m, u32 *aoff, u32 *alen)
{
    int n = 0;
    u32 used = 0;

    pa_expect_ch('(');
    if (pa_accept_ch(')'))
        return (m->np == 0) ? 0 : 0;
    for (;;) {
        u32 k = cm_read_arg(CM_ARGS + used, (u32)CM_ARG_MAX - used);

        if (n < CM_NP) {
            aoff[n] = used;
            alen[n] = k;
        }
        used += k;
        n++;
        if (pa_accept_ch(','))
            continue;
        break;
    }
    pa_expect_ch(')');
    return n;
}

/* 文件作用域上试一次角色宏定义：`role name(role p, …) { … }`。
 * 不是这个形状就什么也不做、返回 0。 */
static int cm_try_define(void)
{
    Tok *t0 = pa_cur();
    Tok *t1 = NULL;
    Tok *t2 = NULL;
    int role = 0;
    CMacro *m = NULL;
    u32 ntok = 0;
    u32 i = 0;

    if (t0->kind != TK_IDENT || NCM >= CM_MAX)
        return 0;
    role = cm_role_of(tok_data(t0), t0->len);
    if (role < 0)
        return 0;
    t1 = pa_peek(1);
    t2 = pa_peek(2);
    if (!t1 || t1->kind != TK_IDENT)
        return 0;
    if (!t2 || t2->kind != TK_PUNCT || !tok_eq(t2, "("))
        return 0;
    if (cm_find(tok_data(t1), t1->len))
        return 0;
    pa_advance();                                /* 角色词 */
    m = &CM[NCM++];
    memset(m, 0, sizeof(*m));
    m->role = role;
    m->name = tok_data(pa_cur());
    m->nlen = pa_cur()->len;
    pa_advance();                                /* 名字 */
    pa_expect_ch('(');
    if (!pa_accept_ch(')')) {
        for (;;) {
            int pr = -1;

            if (pa_cur()->kind != TK_IDENT)
                break;
            pr = cm_role_of(tok_data(pa_cur()), pa_cur()->len);
            if (pr < 0) {
                pa_error("宏形参前面要写角色词（expr / stmt / ident / type）");
                break;
            }
            pa_advance();
            if (pa_cur()->kind != TK_IDENT) {
                pa_error("a parameter name must follow the '%s' role",
                         pr == CM_ROLE_EXPR ? "expr"
                                            : (pr == CM_ROLE_STMT ? "stmt"
                                                                  : (pr == CM_ROLE_IDENT
                                                                         ? "ident"
                                                                         : "type")));
                break;
            }
            if (m->np < CM_NP) {
                m->prole[m->np] = pr;
                m->pname[m->np] = tok_data(pa_cur());
                m->plen[m->np] = pa_cur()->len;
                m->np++;
            }
            pa_advance();
            if (pa_accept_ch(','))
                continue;
            break;
        }
        pa_expect_ch(')');
    }
    if (!pa_is_ch('{'))
        return 1;
    ntok = tmpl_capture_body();
    if (ntok >= 2) {
        m->nbody = ntok - 2;
        m->body = arena_alloc(&A_main, sizeof(Tok) * (size_t)(m->nbody ? m->nbody : 1));
        for (i = 0; i < m->nbody; i++)
            m->body[i] = CAP_TOK[i + 1];
    } else {
        m->nbody = 0;
        m->body = arena_alloc(&A_main, sizeof(Tok));
    }
    /* `expr f(expr a) { a + 1; }`：结尾的 ';' 可有可无，展开时要吃掉——
     * 否则 `( a + 1 ; )` 就不是表达式了。 */
    if (m->role != CM_ROLE_STMT) {
        while (m->nbody > 0 && m->body[m->nbody - 1].kind == TK_PUNCT
               && TOK_EQ(&m->body[m->nbody - 1], ";"))
            m->nbody--;
        /* `expr` 宏的体就是**一个表达式**：空的、或者中间还有分号（多条
         * 语句）都不是表达式（tests/errors/macro.c6 的 expr_empty /
         * expr_statements）。语句请写 `stmt` 宏 + `({ … })`。 */
        if (m->nbody == 0) {
            pa_error("an 'expr' macro needs an expression in its body");
        } else {
            int d2 = 0;
            u32 j2 = 0;

            for (j2 = 0; j2 < m->nbody; j2++) {
                if (m->body[j2].kind != TK_PUNCT)
                    continue;
                if (tok_eq(&m->body[j2], "(") || TOK_EQ(&m->body[j2], "[")
                    || TOK_EQ(&m->body[j2], "{"))
                    d2++;
                else if (tok_eq(&m->body[j2], ")") || TOK_EQ(&m->body[j2], "]")
                         || TOK_EQ(&m->body[j2], "}"))
                    d2--;
                else if (TOK_EQ(&m->body[j2], ";") && d2 == 0) {
                    pa_error("an 'expr' macro body is one expression: use a "
                             "'stmt' macro and '({ ... })' for statements");
                    break;
                }
            }
        }
    }
    /* `#` / `##` 只能作用在 ident 形参上 */
    {
        u32 j3 = 0;

        for (j3 = 0; j3 + 1 < m->nbody; j3++) {
            if (m->body[j3].kind != TK_PUNCT)
                continue;
            if (!TOK_EQ(&m->body[j3], "#") && !TOK_EQ(&m->body[j3], "##"))
                continue;
            /* 运算符**两边**都查：`a ## b` 里 a 是左边那个 */
            if (j3 > 0 && m->body[j3 - 1].kind == TK_IDENT) {
                u32 k3 = 0;

                for (k3 = 0; k3 < m->np; k3++)
                    if (m->plen[k3] == m->body[j3 - 1].len
                        && memcmp(m->pname[k3], tok_data(&m->body[j3 - 1]),
                                  m->plen[k3]) == 0) {
                        if (m->prole[k3] != CM_ROLE_IDENT)
                            pa_error("'%.*s' has role '%s': '#' and '##' need an "
                                     "'ident' parameter", (int)m->plen[k3],
                                     m->pname[k3],
                                     m->prole[k3] == CM_ROLE_EXPR
                                         ? "expr"
                                         : (m->prole[k3] == CM_ROLE_STMT ? "stmt"
                                                                         : "type"));
                        break;
                    }
            }
            if (m->body[j3 + 1].kind == TK_IDENT) {
                u32 k3 = 0;

                for (k3 = 0; k3 < m->np; k3++)
                    if (m->plen[k3] == m->body[j3 + 1].len
                        && memcmp(m->pname[k3], tok_data(&m->body[j3 + 1]),
                                  m->plen[k3]) == 0) {
                        if (m->prole[k3] != CM_ROLE_IDENT)
                            pa_error("'%.*s' has role '%s': '#' and '##' need an "
                                     "'ident' parameter", (int)m->plen[k3],
                                     m->pname[k3],
                                     m->prole[k3] == CM_ROLE_EXPR
                                         ? "expr"
                                         : (m->prole[k3] == CM_ROLE_STMT ? "stmt"
                                                                         : "type"));
                        break;
                    }
            }
        }
    }
    /* 找体内自己声明的局部变量：`typename 名字` / `typeof(…) 名字` */
    for (i = 0; i + 1 < m->nbody; i++) {
        int decl = 0;
        u32 j = i + 1;

        if (m->body[i].kind == TK_IDENT && TOK_EQ(&m->body[i], "__local"))
            continue;                /* 手动指定：后面的名字不重命名 */
        if (m->body[i].kind == TK_IDENT
            && (TOK_EQ(&m->body[i], "typeof") || TOK_EQ(&m->body[i], "__typeof__")
                || TOK_EQ(&m->body[i], "__typeof"))) {
            int d = 0;

            j = i + 1;
            while (j < m->nbody) {
                if (m->body[j].kind == TK_PUNCT && tok_eq(&m->body[j], "("))
                    d++;
                else if (m->body[j].kind == TK_PUNCT && tok_eq(&m->body[j], ")")) {
                    d--;
                    if (d == 0) {
                        j++;
                        break;
                    }
                }
                j++;
            }
            decl = 1;
        } else if (is_typename_tok(&m->body[i])) {
            decl = 1;
        }
        if (!decl)
            continue;
        while (j < m->nbody && m->body[j].kind == TK_PUNCT
               && (TOK_EQ(&m->body[j], "*") || TOK_EQ(&m->body[j], "const")))
            j++;
        if (j >= m->nbody || m->body[j].kind != TK_IDENT)
            continue;
        {
            int isparam = 0;
            int k = 0;
            int dup = 0;

            for (k = 0; k < m->np; k++)
                if (m->plen[k] == m->body[j].len
                    && memcmp(m->pname[k], tok_data(&m->body[j]), m->body[j].len) == 0)
                    isparam = 1;
            for (k = 0; k < m->nloc; k++)
                if (m->loclen[k] == m->body[j].len
                    && memcmp(m->loc[k], tok_data(&m->body[j]), m->body[j].len) == 0)
                    dup = 1;
            if (!isparam && !dup && m->nloc < CM_NP * 4) {
                m->loc[m->nloc] = tok_data(&m->body[j]);
                m->loclen[m->nloc] = m->body[j].len;
                m->nloc++;
            }
        }
    }
    /* `__local` 那个占位 token 在展开时跳过：把 kind 换成 TK_NL 之类不可见的
     * 不行（会影响语法），干脆标成空指针 token，展开循环里显式跳。 */
    for (i = 0; i < m->nbody; i++) {
        if (m->body[i].kind == TK_IDENT && m->body[i].len == 7
            && memcmp(tok_data(&m->body[i]), "__local", 7) == 0)
            m->body[i].kind = TK_EOF;            /* 展开时丢弃 */
    }
    return 1;
}

/* `ident` 角色的宏：结果直接当成一个标识符用（`int cat(ab, cd) = 7;` 里的
 * 声明符名字）。返回合成好的名字，不是 ident 宏就返回 NULL。 */
static const char *cm_ident_name(u32 *outlen)
{
    CMacro *m = cm_at_call(CM_ROLE_IDENT);
    u32 aoff[CM_NP] = {0};
    u32 alen[CM_NP] = {0};
    char buf[256] = {0};
    u32 bl = 0;
    int n = 0;
    int i = 0;
    int k = 0;

    if (!m)
        return NULL;
    pa_advance();                                /* 宏名 */
    n = cm_collect_args(m, aoff, alen);
    for (i = 0; i < (int)m->nbody; i++) {
        Tok *b = &m->body[i];
        int pi = -1;

        if (b->kind == TK_EOF)
            continue;
        if (b->kind == TK_PUNCT && TOK_EQ(b, "##"))
            continue;
        if (b->kind == TK_IDENT) {
            for (k = 0; k < m->np; k++)
                if (m->plen[k] == b->len
                    && memcmp(m->pname[k], tok_data(b), b->len) == 0) {
                    pi = k;
                    break;
                }
        }
        if (pi >= 0) {
            u32 j = 0;

            if (pi < n) {
                for (j = 0; j < alen[pi]; j++) {
                    Tok *at = &CM_ARGS[aoff[pi] + j];
                    u32 tl = at->len;

                    if (bl + tl < sizeof(buf)) {
                        memcpy(buf + bl, tok_data(at), tl);
                        bl += tl;
                    }
                }
            }
            continue;
        }
        if (bl + b->len < sizeof(buf)) {
            memcpy(buf + bl, tok_data(b), b->len);
            bl += b->len;
        }
    }
    *outlen = bl;
    if (bl == 0)
        return NULL;
    {
        char *r = arena_alloc(&A_main, (size_t)bl + 1);

        memcpy(r, buf, bl);
        r[bl] = 0;
        return r;
    }
}

/* 就地展开：当前 token 是宏名，后面跟 '('。返回 1 表示展开了。 */
static int cm_expand(int role)
{
    CMacro *m = cm_at_call(role);
    u32 aoff[CM_NP] = {0};
    u32 alen[CM_NP] = {0};
    int n = 0;

    if (!m)
        return 0;
    pa_advance();                                /* 宏名 */
    n = cm_collect_args(m, aoff, alen);
    (void)n;
    cm_push_expansion(m, CM_ARGS, aoff, alen, n);
    return 1;
}

static u32 parse_typename(void);
static void gen_decl_from_spec(u32 base);
static u32 gen_unary(void);
static void skip_attributes(void);
static void skip_paren_group(void);
static u32 GEN_TY;
static int PEND_LVAL;
static u32 PEND_ADDR;
static u32 PEND_TY;
/* typeof(表达式) 要的是**未退化**的类型：函数指示符不能变成函数指针 */
static int NO_DECAY;


/* 存储类标记：静态局部要落到数据段（有静态生存期），不能用栈槽 */
static int PA_STATIC;
/* `extern` 说明符：`extern int g;` 是引用不是定义，不要求初始化器 */
static int PA_EXTERN;
/* `__thread` / `_Thread_local`：这个声明定义的是线程局部量（TLS）
 *
 * 布局上 TLS 量就是数据段里的普通全局量（初始化器一个字都不用改），差别只在
 * **访问**：地址算成 `%fs 基址 + 数据段偏移`。运行期每个线程 mmap 一块
 * [TLS_LO, TLS_HI) 的拷贝，`%fs` 设成 `块首 - TLS_LO`，于是解析期生成的
 * 常量偏移正好落到拷贝里那个变量上（见 lib/rt.c6 的 c6c_tls_setup 和
 * src/x64.c6 的 __c6_fsbase）。块里会顺带拷贝夹在中间的不相干数据——它们
 * 只是副本、没人写回，换来的是"偏移在解析期就是常量"，不用二次扫描。
 *
 * 三个交给运行期的量（`.data` 里的 8 字节全局量，没有 TLS 时长度是 0）：
 *   __c6_tls_img   影像在数据段里的**地址**
 *   __c6_tls_len   影像长度
 *   __c6_tls_delta 影像起点相对数据段起点的偏移（%fs = 块首 - 这个）
 */
static int PA_TLS;
static u32 TLS_LO;              /* 第一个 TLS 变量的数据段偏移 */
static u32 TLS_HI;              /* 最后一个 TLS 变量的结尾 */
static u32 NTLS;
static Sym *SYM_TLS_IMG;
static Sym *SYM_TLS_LEN;
static Sym *SYM_TLS_DELTA;

static void tls_note(u32 goff, u32 sz)
{
    if (NTLS == 0 || goff < TLS_LO)
        TLS_LO = goff;
    if (goff + sz > TLS_HI)
        TLS_HI = goff + sz;
    NTLS++;
}
/* 模板定义（`struct B@(int N) {...}`）自己不产生声明，它后面的 `;` 是可选的；
 * 处理完把它置 1，让 gen_decl_from_spec 直接跳过（否则会去吃后面的 `test`）。 */
static int PA_TMPL_DEF_DONE;
/* 结构体体的"第一遍"：只登记方法签名、跳过方法体。为的是让前面的方法能调用
 * 后面才定义的方法（std/container/map.c6 的 rebuild → probe 就是这个形状）。 */
static int PA_SIG_ONLY;
static char TMPL_INST_NM[320];   /* 正在展开的模板实例名（方法命名用） */

/* 实例类型 id → 实例名（`Vect_int` 这种）。顶层函数带实例指针做首形参时，
 * 符号名要按 `<实例名>_<函数名>` 拼，所以得能反查。 */
#define TINST_MAX 128
static u32 TINST_ID[TINST_MAX];
static char TINST_NM[TINST_MAX][96];
static u32 NTINST;

static const char *tmpl_inst_name(u32 ty)
{
    u32 i = 0;

    for (i = 0; i < NTINST; i++)
        if (TINST_ID[i] == ty)
            return TINST_NM[i];
    return NULL;
}
/* 正在解析 `&` 的操作数：方法体里的成员访问默认会立刻 load 成右值，
 * 取地址时要留住左值（`&keys[i]`）。 */
static int PA_AMP;
/* 正在重放模板结构体的体：只有这种体才做"两遍"（第一遍只登记方法签名），
 * 普通结构体保持一遍，免得白跑一遍解析、也免得踩到只能在单遍里成立的写法。 */
static int PA_TMPL_BODY;
/* 正在解析模板**实参**（`V@int[:]` 里的 `int`）：这时不能把 `[:]` 当切片后缀
 * 吃掉——它是"实例的切片"（`ty_slice_chk(V@int)`），不是实参类型的一部分。 */
static int PA_TMPL_ARG;
/* `@T` 在 c6c 里就是 `T *`。指针**不能**在 parse_typespec 里就套上去：那样
 * `@int (*f)(int)` 的 base 一开始就是指针，`decl_fill_hole` 会把外层 `(int)`
 * 后缀装到错误的一层（现象：`f(3)` 编不过、`(*f)(3)` 段错误）。所以这里只
 * 记一个计数，由 parse_declarator 当成"额外的 `*`"叠进 nptr。 */
static int PA_MGD_PTR;
static int PA_MGD_SHARED;    /* 刚看到 `shared` 限定符 */
static int PA_CAST_CONV;     /* 正在做显式 cast */
static int PA_TMPL_STRUCT;   /* 正在定义的 struct/union 是模板（`struct X@T`） */
static int PA_MGD_KIND;      /* 0=强 1=weak 2=own */
/* `async T f()`：c6c 里就是"返回任务结构的普通函数"。任务结构
 * `struct <名字>_task { T val; }` 在编译器内部建好并登记成普通 tag，函数返回
 * 它的指针；`await t` 读 `t->val`。任务同步跑完，`__c6_co_wait` 恒 0。 */
static int PA_ASYNC;
static u32 CUR_TASK_TY;            /* 当前函数是 async 时为任务结构类型 */
static u32 CUR_TASK_VAL;           /* 任务结构里 val 的类型 */
/* async 体的"回卷出口"标签：销毁挂起的任务时，挂起点之后的检查会跳到这里，
 * 把 defer/errdefer 和栈上的托管局部量都收拾掉（见 async_unwind_gate）。 */
static u32 CUR_UNWIND_LBL;
/* 正在编 `co` 语句（决定 async 调用的起点闸门：co 跳过闸门） */
static int PA_CO_STMT;

/* 正在编的初始化表达式属于哪种声明：0 = 不是声明初始化，1 = 普通目标，
 * 2 = 托管引用（`@T`）。f-string 用它查"借来的文本存进托管引用"这类错。 */
static u8 PA_DECL_INIT_MGD;
/* async 的上下文检查用：defer 体里不许 await；sizeof/typeof 这种不求值上下文
 * 里也不许；`task`/`thread` 是哪个关键字写出来的（文件作用域只禁 `task`）。 */
static int PA_IN_DEFER;
static int PA_DEFER_DEPTH;   /* defer 体的嵌套层数（上限 8） */
static int PA_DEFER_SITES;   /* 本函数的清理点个数（上限 128） */
static int PA_RET_EXPR;      /* 正在编 `return` 的操作数（err() 只许在这里） */
/* 刚编完的那次调用可不可失败：0 = 不是调用，1 = 返回 T!error，2 = 普通函数，
 * 3 = 可失败性看不出来（方法/函数指针调用），4 = 已经被 catch 处理过。 */
static int E_CALL_FALLIBLE;
static int E_NEW_SEEN;       /* 刚编完的表达式里有 `new` */
static int E_NEW_SHARED;     /* 那个 `new` 带 `shared`（原子计数） */
static int PA_LAST_TERM;     /* 上一条语句是 return/goto（catch 体的收尾检查） */
/* `move(a)` 之后槽里的引用就交出去了：再读、再比较、再传参、再 move 拿到的
 * 都是空值，编译期直接拦下来（tests/errors/gc_move.c6）。
 *
 * 用**稀疏表**存：一个函数里同时空着的槽通常只有一两个，别为每个 if/循环
 * memcpy 一张 2 KB 位图（profiler 里那是实打实 1% 的开销）。 */
#define MV_MAX 24
static u16 MV_SLOT[MV_MAX];
static int MV_N;
/* 控制流汇合用的快照：分支各自从"进来时"的状态开始分析，出去时取并集
 * （一条路重新赋值、另一条没有，就算"还可能是空的"）。defer 体单独分析，
 * 里面的 move 不漏到外面。 */
#define MV_SNAP_MAX 24
static u16 MV_SNAP[MV_SNAP_MAX][MV_MAX];
static u8 MV_SNAP_N[MV_SNAP_MAX];
static u16 MV_TMP[MV_MAX];
static u8 MV_TMP_N;
static int MV_SP;

static int mv_has(u32 slot)
{
    int i = 0;

    for (i = 0; i < MV_N; i++)
        if (MV_SLOT[i] == (u16)slot)
            return 1;
    return 0;
}

static void mv_set(u32 slot)
{
    if (slot > 0xFFFFu || mv_has(slot))
        return;
    if (MV_N < MV_MAX)
        MV_SLOT[MV_N++] = (u16)slot;
}

static void mv_clear(u32 slot)
{
    int i = 0;

    for (i = 0; i < MV_N; i++)
        if (MV_SLOT[i] == (u16)slot) {
            MV_SLOT[i] = MV_SLOT[--MV_N];
            return;
        }
}

static void mv_push(void)
{
    if (MV_SP < MV_SNAP_MAX) {
        memcpy(MV_SNAP[MV_SP], MV_SLOT, sizeof(MV_SLOT));
        MV_SNAP_N[MV_SP] = (u8)MV_N;
        MV_SP++;
    }
}

static void mv_restore(void)
{
    if (MV_SP > 0) {
        memcpy(MV_SLOT, MV_SNAP[MV_SP - 1], sizeof(MV_SLOT));
        MV_N = MV_SNAP_N[MV_SP - 1];
    }
}

static void mv_pop(void)
{
    if (MV_SP > 0)
        MV_SP--;
}

static void mv_save_tmp(void)
{
    memcpy(MV_TMP, MV_SLOT, sizeof(MV_SLOT));
    MV_TMP_N = (u8)MV_N;
}

static void mv_union_tmp(void)
{
    int i = 0;

    for (i = 0; i < MV_TMP_N; i++)
        mv_set(MV_TMP[i]);
}

/* 循环体/分支体：进门快照，出门取"入口 ∪ 体"——循环可能一次都不跑，
 * 体里的赋值保证不了执行（tests/errors/gc_move.c6 的 loop / switch_case）。 */
static void mv_loop_enter(void) { mv_push(); }

static void mv_loop_leave(void)
{
    mv_save_tmp();
    mv_restore();
    mv_union_tmp();
    mv_pop();
}

static int NLOOP;            /* 循环/switch 的嵌套层数（下面再定义一次） */
static int PA_IN_COND;        /* 正在编 if/while/switch 的分支体：里面的赋值
                                不能保证执行，清不了"已移走"标记 */
static int PA_MOVE_OPERAND;   /* 正在编 move() 的操作数：这一处不算读 */
static int PA_UNEVAL;
static int PA_AWAIT_IO;      /* 正在编 await 的操作数：c6_io 只在这里合法 */
static int PA_INLINE_SEEN;
static u8 PA_TASK_KW;
/* `!error` 返回类型：PA_FALLIBLE 是"刚看到标记，等挂到声明上"，
 * CUR_FALLIBLE 是"当前这个函数带 `!error`"（try 要查它）。 */
/* 刚解析完的表达式是一次函数调用吗？（返回值可能是新引用，比如
 * `@T f()`——那种情况下 `@T p = f();` 完全合法） */
static int E_WAS_CALL;
/* 刚解析完的表达式是 `&x` 吗？（拿普通地址初始化 `@T` 就是这条） */
static int E_WAS_ADDR;
/* 刚读出来的是 `weak @T` 吗？（弱引用要先升级成 `@T` 才能用） */
static int E_WEAK;
/* 刚解析完的操作数是不是**空指针常量**（C11 6.3.2.3p3）。三元式的类型合并要用 */
static int E_NPC;
/* 刚解析的类型名里出现过 const/volatile/restrict（c6c 不把限定符放进类型 id） */
static int SAW_TYPE_QUAL;
static int CAST_QUAL;       /* 当前这个强转的类型名里带限定符 */
static int PA_FALLIBLE;
static int PA_IN_DROP;      /* 正在生成析构函数体（`drop`），不能挂起/失败 */
static int CUR_ASYNC_DEF;   /* 当前函数定义带 `async`（文件作用域登记 drop 时还要看） */
static int CUR_FALLIBLE;

/* 合成出来的任务结构类型（`struct f_task`）：句柄上的 wait/done/kind/cancel/start
 * 是内建成员，直接落到 `__c6_co_*`。类型系统里没有"任务"这个叶子类型，
 * 所以在合成的时候登记一张表。 */
#define TASK_TY_MAX 256
static u32 TASK_TY[TASK_TY_MAX];
static u32 NTASKTY;
/* 任务体入口处错误标志的快照槽（0 = 没有） */
static u32 TASK_ERR_SLOT;
/* 任务结构指针的槽，以及前缀里已经填了几个托管引用 */
static u32 TASK_SLOT;
static u32 TASK_MG_N;

static int ty_is_task(u32 ty)
{
    u32 i = 0;
    u32 t = ty_is_ptr(ty) ? ty_target(ty) : ty;

    for (i = 0; i < NTASKTY; i++)
        if (TASK_TY[i] == t)
            return 1;
    return 0;
}

/* 任务结构的布局是 `{ long kind; T val; }`：kind 在偏移 0，运行时
 * `__c6_co_wait()` 靠它回报"成功 / 出错"（c6c 没有调度器，任务同步跑完，
 * 能表达的就这两种状态）。val 的偏移按名字查，别写死。 */
static u32 task_off(const char *nm, u32 nl)
{
    u32 ft = 0;
    u32 fo = 0;

    if (!CUR_TASK_TY || !agg_find_promoted(CUR_TASK_TY, nm, nl, &ft, &fo))
        return 0;
    return fo;
}

static u32 task_val_off(void)
{
    return task_off("val", 3);
}

/* 托管形参前缀：任务持有每个托管实参的一份引用（创建时 +1，销毁时 −1），
 * 最多 4 个。 */
#define TASK_MG_CAP 4

/* 任务结构在函数**入口**就 calloc 好：形参拷进来的时候要往引用前缀里填，
 * 各条 return 出口只是把同一个指针交出去。 */
static void task_new(void)
{
    u32 c1 = 0;
    u32 c2 = 0;
    u32 t = 0;
    u32 a = 0;

    TASK_SLOT = frame_slots_for(8);
    TASK_MG_N = 0;
    c1 = irfn_vreg(&FN);
    c2 = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_U64, (u16)c1, 0, 0, 0, 1);
    irfn_push(&FN, IR_CONST, IRT_U64, (u16)c2, 0, 0, 0,
              ty_size(CUR_TASK_TY) ? ty_size(CUR_TASK_TY) : 8);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)c1, 0, 0, 0);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)c2, 0, 0, 1);
    t = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALL, IRT_PTR, (u16)t, 0, 0, 0, x64_sym(&X64, "calloc"));
    FN.ops[FN.n - 1].narg = 2;
    a = irfn_vreg(&FN);
    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)a, 0, 0, 0, X64_SLOT(TASK_SLOT));
    irfn_push(&FN, IR_STORE, IRT_U64, (u16)a, (u16)t, 0, 0, 0);
    /* 任务结构登记到协程上：函数体可能停在某个 `await`，创建者那时还没拿到
     * 返回值，只能从协程记录里取（__c6_co_start 就是读它）。 */
    {
        u32 pa2 = irfn_vreg(&FN);
        u32 pv2 = irfn_vreg(&FN);

        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)t, 0, 0, 0);
        irfn_push(&FN, IR_CALL, IRT_VOID, (u16)pv2, 0, 0, 0,
                  x64_sym(&X64, "__c6_co_publish"));
        FN.ops[FN.n - 1].narg = 1;
        (void)pa2;
    }
}

/* 挂起点之后问一句"正被回卷吗"：是就跳到回卷出口。只有 async 体才有。 */
static u32 task_get(void);
static void task_seal(u32 tsk);
static void defer_run(int from_scope, int on_error);

static void async_unwind_gate(void)
{
    u32 uv = 0;
    u32 z = 0;
    u32 cc = 0;
    u32 lclean = 0;
    u32 cont = 0;

    if (!CUR_TASK_TY)
        return;
    uv = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALL, IRT_I64, (u16)uv, 0, 0, 0,
              x64_sym(&X64, "__c6_co_unwind_pending"));
    FN.ops[FN.n - 1].narg = 0;
    z = irfn_vreg(&FN);
    cc = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_U64, (u16)z, 0, 0, 0, 0);
    irfn_push(&FN, IR_CMP, IRT_I64, (u16)cc, (u16)uv, (u16)z, 0, 0);
    FN.ops[FN.n - 1].flags = (u8)IRCC_NE;
    lclean = irfn_label(&FN);
    cont = irfn_label(&FN);
    irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)cc, (u16)lclean, (u16)cont, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lclean, 0, 0, 0);
    /* 回卷：就地收尾——把**此刻**还登记着的清理体（defer、errdefer、托管
     * 局部量）逆序跑掉，任务按失败结，然后直接返回。放在挂起点原地而不是跳到
     * 函数末尾，是因为块的清理代码就发在块尾，跳过去会把它整个跳过
     * （errdefer 就丢了）。 */
    {
        u32 dt = 0;

        defer_run(1, 1);
        dt = task_get();
        task_seal(dt);
        irfn_push(&FN, IR_RET, IRT_PTR, 0, (u16)dt, 0, 0, 0);
    }
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)cont, 0, 0, 0);
}

static u32 task_get(void)
{
    u32 a = irfn_vreg(&FN);
    u32 t = irfn_vreg(&FN);

    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)a, 0, 0, 0, X64_SLOT(TASK_SLOT));
    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)t, (u16)a, 0, 0, 0);
    return t;
}

/* 收尾：带 `!error` 的 async 函数把"这次是不是失败"记进 kind。
 *
 * 判据是"现在的错误标志 != 进入任务体时的标志"——创建任务的人手上可能已经
 * 带着一个待处理的错误（前一次调用留下的），那不能算到这个任务头上
 * （tests/task_method.c6 "成功的任务与失败的任务相邻" 就是这条）。
 * 记完之后把标志清掉：错误已经搬到任务里了。 */
static void task_seal(u32 tsk)
{
    u32 f = 0;
    u32 a = 0;
    u32 e = 0;
    u32 c = 0;

    if (!CUR_FALLIBLE)
        return;
    f = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALL, IRT_I64, (u16)f, 0, 0, 0,
              x64_sym(&X64, "__tcc_err_flag_get"));
    FN.ops[FN.n - 1].narg = 0;
    if (TASK_ERR_SLOT) {
        a = irfn_vreg(&FN);
        e = irfn_vreg(&FN);
        c = irfn_vreg(&FN);
        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)a, 0, 0, 0, X64_SLOT(TASK_ERR_SLOT));
        irfn_push(&FN, IR_LOAD, IRT_I64, (u16)e, (u16)a, 0, 0, 0);
        irfn_push(&FN, IR_CMP, IRT_I64, (u16)c, (u16)f, (u16)e, 0, 0);
        FN.ops[FN.n - 1].flags = (u8)IRCC_NE;
        f = c;
    }
    {
        u32 ka = irfn_vreg(&FN);

        irfn_push(&FN, IR_LEA, IRT_PTR, (u16)ka, (u16)tsk, 0, 0,
                  task_off("kind", 4));
        irfn_push(&FN, IR_STORE, IRT_U64, (u16)ka, (u16)f, 0, 0, 0);
    }
    if (TASK_ERR_SLOT) {
        u32 z = irfn_vreg(&FN);

        irfn_push(&FN, IR_CALL, IRT_VOID, (u16)z, 0, 0, 0,
                  x64_sym(&X64, "__tcc_err_clear"));
        FN.ops[FN.n - 1].narg = 0;
    }
}
static u32 NSTATIC;
/* 刚扫到 `__attribute__((packed))`（由 parse_agg_spec 取走并作用到那个结构体） */
static int SAW_PACKED;
/* 结构体嵌套时 TY_PACK 的存档栈（每个 parse_agg_spec 进体前压、出体后弹） */
static int PACK_SAVE[32];
static int NPACK_SAVE;
static int SAW_ALIGN;
static int ALIGN_SAVE[32];

/* 只看类型时（模板实参 `Vect@int v;` 里的 `int`）不要把后面的标识符
 * 当成声明符的名字吃掉。 */
static int PA_NO_NAME;
/* 解析模板**类型实参**时置上：此时不能把后面的 `[:]` 当成切片后缀
 * （`V@int[:] s` 里那个 `[:]` 属于外层声明，不是实参）。 */
static int PA_TYPE_ATOM;

/* __attribute__((constructor)) 收集表：进程入口在 main 之前按序调用 */
/* c6 的 `test "名字" { … }` 块：编成一个 int(void) 函数，失败返回非 0。
 * 名字进表里，`--run-tests` 时按顺序调用（P6-5）。 */
static u32 TESTS[512];
static const char *TEST_NAMES[512];
static u32 NTESTS;

static u32 CTORS[256];
static u32 NCTOR;
static int SAW_CTOR;
/* __attribute__((destructor))：main 返回之后按**逆序**调用 */
static u32 DTORS[256];
static u32 NDTOR;
static int SAW_DTOR;
/* 成员/声明里刚见过 enum 说明符：枚举位域要按零扩展（tcc 的约定） */
static int PA_SAW_ENUM;
/* -fsyntax-only：完整跑前端，但既不要求 main 也不写输出 */
static int PA_SYNTAX_ONLY;
/* -run：输出只是临时 ELF，别把临时文件名报出来（main.c6 里置 1） */
static int PA_QUIET_OUT;

/* 吞掉多余的初始化器元素：跳到 depth 0 处的 ',' 或 '}'（都不吃掉） */
static void skip_init_list(void)
{
    int depth = 0;
    int n = 0;

    while (pa_cur()->kind != TK_EOF && n < 100000) {
        Tok *t = pa_cur();

        if (depth == 0 && t->kind == TK_PUNCT && TOK_EQ(t, "}"))
            return;      /* 跳过剩下所有多余元素，停在收尾的 '}' 前 */
        if (t->kind == TK_PUNCT) {
            if (TOK_EQ(t, "{"))
                depth++;
            else if (TOK_EQ(t, "}"))
                depth--;
        }
        pa_advance();
        n++;
    }
}


/* ---------- 字面量解码 ----------
 * 数字：支持 0x/0b/0 前缀与 u/l 后缀（strtoull 不认 0b）。
 * 字符/字符串：完整的转义处理（八进制 1~3 位、\x 十六进制、常见字母转义）。 */
static u64 int_lit_val(const char *s, u32 len)
{
    u64 v = 0;
    u32 i = 0;

    if (len >= 2 && s[0] == '0' && (s[1] == 'b' || s[1] == 'B')) {
        for (i = 2; i < len; i++) {
            if (s[i] == '0' || s[i] == '1')
                v = v * 2 + (u64)(s[i] - '0');
            else
                break;
        }
        return v;
    }
    return (u64)strtoull(s, NULL, 0);
}

static int hex_val(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
        return c - 'A' + 10;
    return -1;
}

/* 解码一个转义序列：*pp 指向反斜杠之后，返回字节值并推进 *pp。 */
static u32 esc_decode(const char **pp, const char *end)
{
    const char *p = *pp;
    u32 v = 0;

    if (p >= end)
        return 0;
    switch (*p) {
    case 'n': *pp = p + 1; return 10;
    case 't': *pp = p + 1; return 9;
    case 'r': *pp = p + 1; return 13;
    case 'a': *pp = p + 1; return 7;
    case 'b': *pp = p + 1; return 8;
    case 'f': *pp = p + 1; return 12;
    case 'v': *pp = p + 1; return 11;
    case 'e': *pp = p + 1; return 27;
    case 'u':
    case 'U': {
        /* 通用字符名：\uXXXX（4 位）/ \UXXXXXXXX（8 位）→ 码点 */
        int want = (*p == 'u') ? 4 : 8;
        int k = 0;

        p++;
        for (k = 0; k < want && p < end && hex_val((u8)*p) >= 0; k++) {
            v = v * 16 + (u32)hex_val((u8)*p);
            p++;
        }
        *pp = p;
        return v;
    }
    case 'x': {
        int k = 0;

        p++;
        while (p < end && hex_val((u8)*p) >= 0) {
            v = v * 16 + (u32)hex_val((u8)*p);
            p++;
            k++;
        }
        (void)k;
        *pp = p;
        return v;
    }
    default:
        break;
    }
    if (*p >= '0' && *p <= '7') {
        int k = 0;

        while (k < 3 && p < end && *p >= '0' && *p <= '7') {
            v = v * 8 + (u32)(*p - '0');
            p++;
            k++;
        }
        *pp = p;
        return v;
    }
    *pp = p + 1;
    return (u32)(u8)*p;
}

/* 字符常量：跳过 L/u/U 前缀，按"多字节累积"处理 'ab' 这种写法 */
static i64 char_lit_val(Tok *t)
{
    const char *s = tok_data(t);
    const char *end = s + t->len;
    i64 v = 0;

    while (s < end && *s != '\'')
        s++;
    if (s < end)
        s++;
    if (end > s && end[-1] == '\'')
        end--;
    while (s < end) {
        u32 ch = 0;

        if (*s == '\\') {
            s++;
            ch = esc_decode(&s, end);
        } else {
            ch = (u32)(u8)*s;
            s++;
        }
        v = (v << 8) | (i64)(ch & 0xFF);
    }
    return v;
}

/* ---------- 编译期常量表达式 ----------
 * 数组长度、枚举值、位域宽度、case 标签、全局初始化器都要在**解析期**求值。
 * 这里走一条独立的递归下降，只做整数运算（不产生 IR）。 */
static i64 const_expr(void);

static i64 const_unary(void)
{
    if (pa_accept_ch('-'))
        return -(i64)const_unary();
    if (pa_accept_ch('+'))
        return (i64)const_unary();
    if (pa_accept_ch('~'))
        return ~(i64)const_unary();
    if (pa_accept_ch('!'))
        return const_unary() == 0 ? 1 : 0;
    if (pa_accept_ch('&')) {
        /* offsetof 的经典写法：`&((T *)0)->m` 的值就是成员偏移。真实代码里
         * `#define offsetof(t,m) ((size_t)&((t *)0)->m)` 到处都是（tcc 自己
         * 的 tccdbg.c / tccelf.c 用了三百多处）。外层可能还套着括号。 */
        u32 ty = 0;
        u32 off = 0;
        u32 mty = 0;
        int extra = 0;

        while (extra < 4 && pa_is_ch('(') && !is_typename_tok(pa_peek(1))) {
            pa_advance();
            extra++;
        }
        if (pa_is_ch('(') && (is_typename_tok(pa_peek(1))
            || (pa_peek(1)->kind == TK_IDENT && pa_peek(2)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(2), "@")))) {
            pa_advance();
            ty = parse_typename();
            if (pa_is_ch(',')) {
                /* `sizeof((int, int))`：元组类型 */
                u32 tys[TUPLE_MAXN] = {0};
                u32 tn = 0;

                tys[tn++] = ty;
                while (tn < TUPLE_MAXN && pa_accept_ch(','))
                    tys[tn++] = parse_typename();
                ty = ty_tuple_chk(tys, tn);
            }
            pa_expect_ch(')');
            if (pa_accept_ch('(')) {
                if (pa_cur()->kind == TK_NUM)
                    pa_advance();
                (void)pa_accept_ch(')');
            } else if (pa_cur()->kind == TK_NUM) {
                pa_advance();
            }
            /* 先把外层多余的 ')' 吃掉，然后才是成员链 */
            while (extra > 0) {
                pa_expect_ch(')');
                extra--;
            }
            for (;;) {
                int arrow = 0;
                char *nm = NULL;
                u32 nl = 0;
                u32 mo = 0;

                if (pa_accept_punct("->"))
                    arrow = 1;
                else if (!pa_accept_ch('.'))
                    break;
                if (arrow)
                    ty = ty_target(ty);
                if (pa_cur()->kind != TK_IDENT) {
                    pa_error("常量表达式里的取地址只能跟成员名");
                    return 0;
                }
                nm = (char *)tok_data(pa_cur());
                nl = pa_cur()->len;
                pa_advance();
                if (!agg_find_promoted(ty, nm, nl, &mty, &mo)) {
                    pa_error("常量表达式里的取地址找不到成员");
                    return 0;
                }
                off += mo;
                ty = mty;
            }
            return (i64)off;
        }
        pa_error("常量表达式里只支持 &((T *)0)->member 形式的取地址");
        return 0;
    }
    /* `_Generic` 也要能出现在常量上下文（`_Static_assert(_Generic(...), "…")`）。
     * 控制表达式只取类型：发一条赋值再撤销，和表达式那条路是同一招。 */
    if (PA_IS_IDENT("_Generic") && pa_peek(1)->kind == TK_PUNCT
        && tok_eq(pa_peek(1), "(")) {
        u32 cty = 0;
        i64 hit = 0;
        i64 dflt = 0;
        int found = 0;
        int has_dflt = 0;

        pa_advance();
        pa_advance();
        {
            u32 save0 = FN.n;

            (void)gen_assign();
            cty = GEN_TY;
            FN.n = save0;
            PEND_LVAL = 0;
        }
        while (pa_accept_ch(',')) {
            if (PA_IS_IDENT("default")) {
                pa_advance();
                pa_expect_ch(':');
                dflt = const_expr();
                has_dflt = 1;
                continue;
            }
            {
                u32 at = parse_typename();

                pa_expect_ch(':');
                if (!found && ty_unqual(at) == ty_unqual(cty)) {
                    hit = const_expr();
                    found = 1;
                } else {
                    /* 没选中：把这个值整体跳过去，停在 ',' 或 ')' 前 */
                    int depth = 0;

                    while (pa_cur()->kind != TK_EOF) {
                        Tok *t = pa_cur();

                        if (depth == 0 && t->kind == TK_PUNCT
                            && (tok_eq(t, ",") || tok_eq(t, ")")))
                            break;
                        if (t->kind == TK_PUNCT) {
                            if (tok_eq(t, "(") || TOK_EQ(t, "[") || TOK_EQ(t, "{"))
                                depth++;
                            else if (tok_eq(t, ")") || TOK_EQ(t, "]") || TOK_EQ(t, "}"))
                                depth--;
                        }
                        pa_advance();
                    }
                }
            }
        }
        pa_expect_ch(')');
        if (found)
            return hit;
        if (has_dflt)
            return dflt;
        pa_error("_Generic 没有匹配的类型分支");
        return 0;
    }
    if (PA_IS_IDENT("__builtin_types_compatible_p") && pa_peek(1)->kind == TK_PUNCT
        && tok_eq(pa_peek(1), "(")) {
        /* 类型 id 是 hash-consing 的，兼容 == id 相同（限定符也算在 id 里） */
        u32 a = 0;
        u32 b = 0;

        pa_advance();
        pa_advance();
        a = parse_typename();
        pa_expect_ch(',');
        b = parse_typename();
        pa_expect_ch(')');
        return a == b ? 1 : 0;
    }
    if (PA_IS_IDENT("sizeof") || PA_IS_IDENT("__alignof__")
        || PA_IS_IDENT("_Alignof") || PA_IS_IDENT("alignof")) {
        u32 ty = 0;
        int is_align = 0;

        if (PA_ACCEPT_IDENT("sizeof")) {
            is_align = 0;
        } else {
            (void)PA_ACCEPT_IDENT("__alignof__");
            (void)PA_ACCEPT_IDENT("_Alignof");
            (void)PA_ACCEPT_IDENT("alignof");
            is_align = 1;
        }
        if (pa_is_ch('(') && (is_typename_tok(pa_peek(1)) || (pa_peek(1)->kind == TK_IDENT && pa_peek(2)->kind == TK_PUNCT && TOK_EQ(pa_peek(2), "@")))) {
            pa_advance();
            ty = parse_typename();
            pa_expect_ch(')');
            return (i64)(is_align ? (u32)ty_align_of(ty) : ty_size(ty));
        }
        {
            /* `sizeof (表达式)` / `sizeof 表达式`（常量表达式里）：借普通表达式
             * 解析器拿到类型，把它生成的 IR 扔掉。`sizeof(a)/sizeof(a[0])` 当
             * 数组长度在真实代码里到处都是（tcc 自己的 tccdbg.c 就是）。 */
            u32 saveops = FN.n;
            u32 ty2 = 0;

            (void)gen_unary();
            ty2 = cur_op_ty();
            PEND_LVAL = 0;
            FN.n = saveops;
            return (i64)(is_align ? (u32)ty_align_of(ty2) : ty_size(ty2));
        }
    }
    if (pa_is_ch('(') && (is_typename_tok(pa_peek(1)) || (pa_peek(1)->kind == TK_IDENT && pa_peek(2)->kind == TK_PUNCT && TOK_EQ(pa_peek(2), "@")))) {
        u32 ty = 0;

        pa_advance();
        ty = parse_typename();
        pa_expect_ch(')');
        return (i64)const_unary();
    }
    if (pa_accept_ch('(')) {
        i64 v = const_expr();

        pa_expect_ch(')');
        return v;
    }
    if (pa_cur()->kind == TK_NUM) {
        i64 v = (i64)int_lit_val(tok_data(pa_cur()), pa_cur()->len);

        pa_advance();
        return v;
    }
    if (pa_cur()->kind == TK_CHAR) {
        i64 v = char_lit_val(pa_cur());

        pa_advance();
        return v;
    }
    if (pa_cur()->kind == TK_IDENT) {
        Sym *s = sym_find(tok_data(pa_cur()), pa_cur()->len);

        /* 枚举的限定名 `Color.RED` 也是常量表达式的一部分
         * （`int a[Color.BLUE]`、`(1u << Color.GREEN)`、`case Color.RED:`）。
         * 必须在裸名判断之前试：`Color` 自己也是类型名（枚举裸名当类型用），
         * 先看裸名就看走眼了。 */
        if (pa_peek(1) && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ".")
            && pa_peek(2) && pa_peek(2)->kind == TK_IDENT
            && (!s || (s->kind != SC_ENUMC && s->kind != SC_GLOBAL))
            && pa_cur()->len + pa_peek(2)->len + 2 < 256) {
            char qn[256] = {0};
            u32 qk = pa_cur()->len;

            memcpy(qn, tok_data(pa_cur()), qk);
            qn[qk++] = '.';
            memcpy(qn + qk, tok_data(pa_peek(2)), pa_peek(2)->len);
            qk += pa_peek(2)->len;
            s = sym_find(qn, qk);
            if (s) {
                pa_advance();
                pa_advance();
                pa_advance();
                return s->val;
            }
        }
        if (s && (s->kind == SC_ENUMC || s->kind == SC_GLOBAL)) {
            pa_advance();
            return s->val;
        }
        pa_error("常量表达式里出现未知名字 '%.*s'", (int)pa_cur()->len, tok_data(pa_cur()));
        pa_advance();
        return 0;
    }
    pa_error("这里要一个常量表达式");
    if (pa_cur()->kind != TK_EOF)
        pa_advance();
    return 0;
}

static i64 const_mul(void)
{
    i64 v = const_unary();

    for (;;) {
        if (pa_accept_ch('*')) {
            v = v * const_unary();
        } else if (pa_accept_ch('/')) {
            i64 r = const_unary();

            v = r ? v / r : 0;
        } else if (pa_accept_ch('%')) {
            i64 r = const_unary();

            v = r ? v % r : 0;
        } else {
            return v;
        }
    }
}

static i64 const_add(void)
{
    i64 v = const_mul();

    for (;;) {
        if (pa_accept_ch('+'))
            v = v + const_mul();
        else if (pa_accept_ch('-'))
            v = v - const_mul();
        else
            return v;
    }
}

static i64 const_shift(void)
{
    i64 v = const_add();

    for (;;) {
        if (pa_accept_punct("<<"))
            v = (i64)((u64)v << (u64)const_add());
        else if (pa_accept_punct(">>"))
            v = v >> (u64)const_add();
        else
            return v;
    }
}

static i64 const_rel(void)
{
    i64 v = const_shift();

    for (;;) {
        if (pa_accept_ch('<'))
            v = v < const_shift() ? 1 : 0;
        else if (pa_accept_punct("<="))
            v = v <= const_shift() ? 1 : 0;
        else if (pa_accept_ch('>'))
            v = v > const_shift() ? 1 : 0;
        else if (pa_accept_punct(">="))
            v = v >= const_shift() ? 1 : 0;
        else
            return v;
    }
}

static i64 const_eq(void)
{
    i64 v = const_rel();

    for (;;) {
        if (pa_accept_punct("=="))
            v = v == const_rel() ? 1 : 0;
        else if (pa_accept_punct("!="))
            v = v != const_rel() ? 1 : 0;
        else
            return v;
    }
}

static i64 const_band(void)
{
    i64 v = const_eq();

    while (pa_accept_ch('&'))
        v = v & const_eq();
    return v;
}

static i64 const_bxor(void)
{
    i64 v = const_band();

    while (pa_accept_ch('^'))
        v = v ^ const_band();
    return v;
}

static i64 const_bor(void)
{
    i64 v = const_bxor();

    while (pa_accept_ch('|'))
        v = v | const_bxor();
    return v;
}

static i64 const_land(void)
{
    i64 v = const_bor();

    while (pa_accept_punct("&&")) {
        i64 r = const_bor();

        v = (v != 0 && r != 0) ? 1 : 0;
    }
    return v;
}

static i64 const_lor(void)
{
    i64 v = const_land();

    while (pa_accept_punct("||")) {
        i64 r = const_land();

        v = (v != 0 || r != 0) ? 1 : 0;
    }
    return v;
}

static i64 const_cond(void)
{
    i64 c = const_lor();

    if (pa_accept_ch('?')) {
        i64 a = const_expr();
        i64 b = 0;

        pa_expect_ch(':');
        b = const_cond();
        return c ? a : b;
    }
    return c;
}

static i64 const_expr(void)
{
    return const_cond();
}

static u32 parse_declarator(u32 base, Declarator *d);

static void pa_dbg_counts(void)
{
    fprintf(stderr, "       [dbg] sym=%u nagg=%u type=%u data=%u static=%u\n",
            (unsigned)SYM_COUNT, (unsigned)NAGG, (unsigned)TT.n,
            (unsigned)DATA_IMG.n, (unsigned)NSTATIC);
}

/* struct/union 定义体：成员类型 + 成员名 + 位宽 */
#define AGG_CAP0 64

static void *agg_grow(void *old, u32 n, u32 cap, u32 esz)
{
    void *np = arena_alloc(&A_main, (size_t)cap * esz);

    if (old && n)
        memcpy(np, old, (size_t)n * esz);
    return np;
}

/* 从当前的 `{` 开始抓一段平衡的花括号，把**消费掉**的 token 抄进 out；
 * 返回抄了几个。不碰前瞻缓冲（tmpl_capture_body 会把前瞻前缀也算进去，
 * 拿来做"抓了再放回去"会错位）。 */
/* ---------- 方法表 ----------
 * 方法在符号表里就是"首形参是 ptr(接收者)"的普通函数，名字不带接收者，
 * 于是一个同名的全局变量/别的函数就能把它遮住（std/net/httpd.c6 的 `port`
 * 就是这样），方法调用糖失效、报"结构体没有成员"。另记一张
 * (接收者类型, 名字) 的表，按接收者类型查：既不受符号表遮蔽影响，
 * 模板实例之间也不会互相串味。 */
#define METH_MAX 8192
static Sym *METH_SYM[METH_MAX];
static u32 METH_SELF[METH_MAX];
static u32 METH_NEXT[METH_MAX];
static u32 NMETH;

/* (接收者类型 → 方法) 的桶链。原来 meth_find 线性扫整张方法表：tcc.c 这种 TU
 * 里表长近两千，而每次查找只有两三千次调用、却要扫上千个条目 —— profile 里
 * 1.8% 全花在这条 `METH_SELF[i] != self_ty` 的比较上。按接收者类型挂链之后
 * 只走同类型的那几条。**顺序必须保持“先登记的在前”**（TAIL 记链尾、追加到
 * 链尾），否则同名方法会挑到另一份，语义就和逐项比较不一样了。 */
#define METH_NB 1024
static u32 METH_HEAD[METH_NB];    /* 0 = 空，否则是下标 + 1 */
static u32 METH_TAIL[METH_NB];

static u32 meth_bucket(u32 self_ty)
{
    return (self_ty * 2654435761u) >> 22;
}

static void meth_add(Sym *p, u32 self_ty)
{
    u32 i = 0;
    u32 b = 0;

    if (NMETH >= METH_MAX)
        return;
    i = NMETH++;
    b = meth_bucket(self_ty);
    METH_SYM[i] = p;
    METH_SELF[i] = self_ty;
    METH_NEXT[i] = 0;
    if (METH_TAIL[b])
        METH_NEXT[METH_TAIL[b] - 1] = i + 1;
    else
        METH_HEAD[b] = i + 1;
    METH_TAIL[b] = i + 1;
}

/* 同名函数的**重载选择**：在符号表里找形参个数对得上、首形参类型也对得上
 * 的那一个。`area(&c)` / `area(&r)`、`plain_area()` / `plain_area(&b)`
 * 都是同一个名字的多个符号，光 `sym_find` 只会给最后登记的那个
 * （tests/method.c6）。 */
static Sym *sym_find_fn(const char *nm, u32 nl, u32 narg, u32 a0ty)
{
    u32 h = sym_hash_ns(nm, nl, 0);
    u32 b = h & (SYM_NBUCKET - 1);
    Sym *p = SYM_BUCKET[b];
    Sym *best = NULL;

    for (; p; p = p->next) {
        if (p->hash != h || p->len != nl || !p->is_func || !p->type)
            continue;
        if (memcmp(p->name, nm, nl) != 0)
            continue;
        if (!ty_is_func(p->type))
            continue;
        if (ty_func_nparams(p->type) != narg)
            continue;
        if (narg > 0 && a0ty && ty_func_param(p->type, 0) == a0ty)
            return p;
        if (!best)
            best = p;
    }
    return best;
}

/* 同一个名字、但**形参个数不同**的函数还在不在？方法输出成
 * `<结构体>_<方法>` 之后，源码名那个弱别名就不能再挂了——挂上去会把
 * libc 的 `getpid()` 顶掉，或者顶掉同名的普通函数（tests/method.c6 的
 * 两组断言）。形参个数相同的不算冲突：闭包参数在纯 C 一侧写成
 * `struct __c6_closure_any *`，那还是同一个函数（tests/abi/closure.c6）。 */
static int fn_overload_taken(const char *nm, u32 nl, u32 ty)
{
    u32 h = sym_hash_ns(nm, nl, 0);
    u32 b = h & (SYM_NBUCKET - 1);
    Sym *p = SYM_BUCKET[b];
    u32 np = ty_func_nparams(ty);

    for (; p; p = p->next)
        if (p->hash == h && p->len == nl && p->is_func && p->type
            && memcmp(p->name, nm, nl) == 0 && ty_is_func(p->type)
            && ty_func_nparams(p->type) != np)
            return 1;
    return 0;
}

static Sym *meth_find(u32 self_ty, const char *nm, u32 nl)
{
    u32 j = METH_HEAD[meth_bucket(self_ty)];

    while (j) {
        u32 i = j - 1;
        Sym *p = METH_SYM[i];

        if (METH_SELF[i] == self_ty && p && p->len == nl
            && memcmp(p->name, nm, nl) == 0)
            return p;
        j = METH_NEXT[i];
    }
    return NULL;
}

/* 抓花括号体的同时把"这片初始化器铺了多少个元素"数出来（游标模拟，规则和
 * C11 6.7.8 一致）：设计符把游标跳到 N+1，范围设计符取最后一个数，顺序值接在
 * 游标后面，嵌套花括号算一个条目，花括号省略接着填。
 * **在抓的时候就数**，省掉事后再扫一遍（实测省下的时间在噪声里，但少一遍
 * 就少一遍；`tcc.c` 里那几张大表都走这条路）。 */
static u32 CAP_BOUND;
static u32 body_capture(Tok *out, u32 cap)
{
    int depth = 0;
    u32 n = 0;
    u32 cur = 0;
    u32 bound = 0;
    int at_item = 1;
    int in_desig = 0;
    int desig_seen = 0;
    u32 desig_last = 0;

    for (;;) {
        Tok *t = pa_cur();

        if (t->kind == TK_EOF)
            break;
        if (t->kind == TK_PUNCT) {
            if (TOK_EQ(t, "{")) {
                if (depth == 1 && at_item) {
                    at_item = 0;
                    cur++;
                    if (cur > bound)
                        bound = cur;
                }
                depth++;
            } else if (TOK_EQ(t, "}")) {
                depth--;
            } else if (depth == 1) {
                if (in_desig) {
                    /* 设计符里的数字是 TK_NUM，不走这条标点分支（见下面非标点
                     * 那条）；这里只管收尾的 `]`。 */
                    if (TOK_EQ(t, "]")) {
                        in_desig = 0;
                        cur = desig_seen ? desig_last + 1 : cur + 1;
                        if (cur > bound)
                            bound = cur;
                    }
                } else if (tok_eq(t, ",")) {
                    at_item = 1;
                } else if (at_item) {
                    at_item = 0;
                    if (TOK_EQ(t, "[")) {
                        in_desig = 1;
                        desig_seen = 0;
                        desig_last = 0;
                    } else if (TOK_EQ(t, ".")) {
                        /* 成员设计符 `.m = …`：不推进数组游标 */
                    } else {
                        cur++;
                        if (cur > bound)
                            bound = cur;
                    }
                }
            }
        } else if (depth == 1 && in_desig) {
            /* `[N]` / `[a ... b]`：取最后一个数当游标终点 */
            int ok = t->kind == TK_NUM;
            u32 v = 0;
            u32 j = 0;

            if (ok) {
                for (j = 0; j < t->len; j++) {
                    char ch = t->syn[j];

                    if (ch < '0' || ch > '9') {
                        ok = 0;
                        break;
                    }
                    v = v * 10 + (u32)(ch - '0');
                }
            }
            if (ok) {
                desig_last = v;
                desig_seen = 1;
            }
        } else if (depth == 1 && at_item) {
            at_item = 0;
            cur++;
            if (cur > bound)
                bound = cur;
        }
        if (n < cap)
            out[n] = *t;
        n++;
        pa_advance();
        if (depth == 0)
            break;
    }
    CAP_BOUND = bound;
    return n < cap ? n : cap;
}

/* 把一段 token 塞回输入流的前面。**必须先腾空前瞻缓冲**：pa_src_push 只认
 * token 流，已经 peek 出来的那些不腾空就会和推回去的重复/错位。 */
static void pa_push_tokens(Tok *t, u32 n)
{
    if (PA_HAVE > 0) {
        Tok *save = arena_alloc(&A_main, (size_t)PA_HAVE * sizeof(Tok));
        u32 ns = (u32)PA_HAVE;
        u32 q = 0;

        for (q = 0; q < ns; q++)
            save[q] = *pa_peek((int)q);
        pa_win_clear();
        pa_src_push(save, ns);
    }
    pa_src_push(t, n);
}

static u32 parse_struct_body(u32 complete_id, u32 tag, int is_union)
{
    u32 cap = AGG_CAP0;
    u32 *mem = arena_alloc(&A_main, (size_t)cap * sizeof(u32));
    u32 *bits = arena_alloc(&A_main, (size_t)cap * sizeof(u32));
    const char **names = arena_alloc(&A_main, (size_t)cap * sizeof(char *));
    u32 *lens = arena_alloc(&A_main, (size_t)cap * sizeof(u32));
    u32 n = 0;
    u32 ty = 0;
    u8 mgd_idx[MGDST_FLD] = {0};
    u8 mgd_kind[MGDST_FLD] = {0};
    u8 mgd_cnt[MGDST_FLD] = {0};
    u32 nmgd_fld = 0;      /* 登记进 MGDST 的条目（含按值嵌套） */
    u32 nmgd_own = 0;      /* 本结构体自己拥有的托管字段（不含嵌套） */
    int saw_flex_mgd = 0;
    u16 def_file = pa_cur()->file;   /* 这个定义写在哪个翻译单元里 */
    u32 memb_align = 0;              /* 当前成员声明上的 aligned(N)，0 = 没写 */

    /* 体里有方法（出现了嵌套的 `{`）就先抓下来跑一遍"只登记签名"，
     * 再原样重放一遍正常解析。 */
    if (!PA_SIG_ONLY && PA_TMPL_BODY) {
        Tok *tmp = arena_alloc(&A_main, (size_t)CAP_MAX * sizeof(Tok));
        u32 e = body_capture(tmp, CAP_MAX);
        int nested = 0;

        if (e > 0 && !pa_is_ch('{')) {
            int d2 = 0;
            u32 i2 = 0;

            for (i2 = 0; i2 < e; i2++) {
                Tok *q = &tmp[i2];

                if (q->kind == TK_PUNCT && TOK_EQ(q, "{")) {
                    d2++;
                    if (d2 == 2) {
                        nested = 1;
                        break;
                    }
                }
            }
        }
        if (e > 0) {
            Tok *pb2 = arena_alloc(&A_main, (size_t)e * sizeof(Tok));
            Tok *pc2 = arena_alloc(&A_main, (size_t)e * sizeof(Tok));

            memcpy(pb2, tmp, (size_t)e * sizeof(Tok));
            memcpy(pc2, tmp, (size_t)e * sizeof(Tok));
            if (nested) {
                PA_SIG_ONLY = 1;
                pa_push_tokens(pb2, e);
                (void)parse_struct_body(complete_id, tag, is_union);
                PA_SIG_ONLY = 0;
            }
            pa_push_tokens(pc2, e);
        }
    }
    pa_expect_ch('{');
    PA_SAW_ENUM = 0;
    while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF) {
        u32 base = 0;
        int any = 0;
        int memb_is_enum = 0;
        int memb_method = 0;
        int base_mgd_ptr = 0;
        int base_mgd_kind = 0;

        PA_SAW_ENUM = 0;
        base = parse_typespec();
        memb_is_enum = PA_SAW_ENUM;
        /* 成员上的 `__attribute__((aligned(N)))` 写在**类型说明符之前**
         * （`A char a:4;` 里 A 就在 char 前面），parse_typespec 里那个
         * skip_attributes 已经把它记进 SAW_ALIGN 了——这里赶紧抄走，
         * 否则下面给"结构体级别"清位的时候就被扔掉（95_bitfields 的
         * WITH ALIGN 那一半靠它）。 */
        memb_align = SAW_ALIGN;
        SAW_ALIGN = 0;
        /* `@T a, b;`：`@` 是类型说明符的一部分（PA_MGD_PTR），
         * 而 parse_declarator 会把它吃掉清零——所以每个声明符之前都要补回来，
         * 否则第二个成员变成按值的 `T b`（托管字段登记成"嵌套"，释放时炸）。 */
        base_mgd_ptr = PA_MGD_PTR;
        base_mgd_kind = PA_MGD_KIND;

        for (;;) {
            Declarator d = {0};
            u32 mty = 0;

            PA_MGD_PTR = base_mgd_ptr;
            PA_MGD_KIND = base_mgd_kind;
            SAW_ALIGN = 0;      /* 结构体级别的 aligned 不能漏到成员上 */
            mty = parse_declarator(base, &d);
            /* 写在声明符后面的那种写法：`char a __attribute__((aligned(16)))` */
            if (SAW_ALIGN > memb_align)
                memb_align = SAW_ALIGN;
            SAW_ALIGN = 0;   /* 成员对齐已经抄进 memb_align，清掉免得外溢 */

            /* 结构体里放闭包 = 引用环：闭包可能捕获持有它的那个对象，而闭包
             * 的捕获表不能写成 weak（tests/errors/closure_cycle.c6）。 */
            if (ty_is_closure(mty, NULL) && in_c6_tu())
                pa_error("reference cycle: a closure member captures the object that "
                         "holds it; break it with 'weak' or 'own'");
            /* 结构体里"看着像函数"的成员：
             *   - 不带体（`T at(int i);`）—— 模板里也不许，方法必须有体；
             *   - 非模板结构体里带体 —— 普通结构体不能内联定义函数。 */
            if (ty_is_func(mty) && d.name) {
                if (!pa_is_ch('{'))
                    pa_error("a member function needs a body: write '%.*s(...) { ... }' "
                             "in the template", (int)d.nlen, d.name);
                /* 带体的成员函数只有**模板**结构体里才有意义：模板体是在实例化
                 * 时才重放的（`PA_TMPL_BODY`），那时才知道 `T` 是什么、接收者
                 * 类型是什么。普通结构体没有模板参数，方法写在外面。 */
                else if (!PA_TMPL_BODY)
                    pa_error("a function cannot be defined inside a struct: write '%.*s' "
                             "outside it", (int)d.nlen, d.name);
            }
            /* c6 结构体内的方法 */
            if (ty_is_func(mty) && d.name && pa_is_ch('{')) {
                u32 np = ty_func_nparams(mty);
                u32 ps[17] = {0};
                u32 i2 = 0;
                u32 self_ty = complete_id ? complete_id : tag;
                Sym *ms = NULL;

                ps[0] = ty_ptr(self_ty);
                for (i2 = 0; i2 < np && i2 < 16; i2++)
                    ps[i2 + 1] = ty_func_param(mty, i2);
                d.type = ty_func(ty_target(mty), ps, np + 1, 0);
                /* 全局登记：实例可能在块作用域里惰性展开，方法不能跟着块没掉 */
                ms = sym_add_gl(d.name, d.nlen, d.type, SC_GLOBAL);
                ms->is_func = 1;
                /* 链接名带上接收者类型：方法在 C 层面就是普通函数，同名就撞，
                 * 而 `port` 这种名字很容易和全局变量/别的函数同名（std/net/httpd.c6）。
                 * 调用点都走 ms->val，所以换个名字是安全的。 */
                {
                    char mn[320] = {0};

                    /* 模板实例里的方法按 `<实例名>_<方法名>` 命名——和普通
                     * 结构体的 `c6m_<方法>_<类型 id>` 不同：实例名本身就是
                     * 一个稳定的 C 标识符，测试（tests/generic.c6）能直接
                     * 写 `int Stack_int_4_cap(struct Stack_int_4 *);` 声明它，
                     * 两个 TU 之间也靠这个名字合成一份。 */
                    if (PA_TMPL_BODY && TMPL_INST_NM[0])
                        snprintf(mn, sizeof(mn), "%s_%s", TMPL_INST_NM, ms->name);
                    else
                        snprintf(mn, sizeof(mn), "c6m_%s_%u", ms->name,
                                 (unsigned)self_ty);
                    ms->val = (i64)x64_sym(&X64, emit_name(mn));
                }
                meth_add(ms, self_ty);
                if (ms->len == 4 && memcmp(ms->name, "drop", 4) == 0)
                    drop_reg(self_ty, (u32)ms->val);
                if (PA_SIG_ONLY) {
                    /* 第一遍：签名登记完就把方法体跳过去。
                     * 注意 skip_init_list 是"停在收尾 `}` 前"的，开头的 `{`
                     * 得先自己吃掉，否则它会一路吃到别的成员的 `}` 上。 */
                    pa_advance();
                    skip_init_list();
                    if (pa_is_ch('}'))
                        pa_advance();
                    memb_method = 1;
                    break;
                }
                METHOD_SELF_TY = self_ty;
                pa_func_def(ms, &d);
                METHOD_SELF_TY = 0;
                memb_method = 1;
                break;
            }
            if (n + 1 >= cap) {
                cap *= 2;
                mem = agg_grow(mem, n, cap, sizeof(u32));
                bits = agg_grow(bits, n, cap, sizeof(u32));
                names = agg_grow(names, n, cap, sizeof(char *));
                lens = agg_grow(lens, n, cap, sizeof(u32));
            }
            if (pa_accept_ch(':')) {
                u32 w = (u32)const_expr();

                /* 最高位标记"位域"；没有声明符的（`unsigned : 32;`）再加次高位
                 * 标记"无名"——这种不占初始化器位置、也不抬结构体对齐
                 * （见 type.c6 的布局）。`unsigned char a:4` 是有名字的，不能标。 */
                bits[n] = w | 0x80000000u | (d.name ? 0u : 0x2000u);
                if (memb_is_enum)
                    bits[n] |= 0x40000000u;  /* 枚举位域：取零扩展 */
            } else {
                bits[n] = 0;
            }
            /* 成员级 aligned(N)：编码 log2(N)+1 到 bits[] 的 14..29 位，
             * agg_layout 按这个把字段起点对到 N 字节边界（低 8 位是位域宽度、
             * 8..13 是单元内位偏移，最高两位是标志，中间空着）。 */
            if (memb_align > 1) {
                u32 v = (u32)memb_align;
                u32 lg = 0;

                while ((v >>= 1) != 0)
                    lg++;
                bits[n] |= ((lg + 1) & 0xFFFFu) << 14;
            }
            mem[n] = mty;
            names[n] = d.name;
            lens[n] = d.nlen;
            if (d.mgd && ty_is_array(mty) && ty_array_n(mty) == 0)
                saw_flex_mgd = 1;
            if (nmgd_fld < MGDST_FLD) {
                if (d.mgd) {
                    nmgd_own++;
                    mgd_idx[nmgd_fld] = (u8)n;
                    mgd_cnt[nmgd_fld] = 1;
                    if (d.mgd_kind == 1) {
                        /* 弱引用字段：不拥有对象（不进偏移表），但升级/赋值
                         * 时前端要知道它是托管的 */
                        mgd_kind[nmgd_fld] = 2;
                    } else if (d.mgd_kind == 2) {
                        /* `own @T`：所有权转移，不算引用环的边 */
                        mgd_kind[nmgd_fld] = 4;
                    } else if (ty_is_array(mty) && ty_is_ptr(ty_target(mty))) {
                        mgd_kind[nmgd_fld] = 1;
                        mgd_cnt[nmgd_fld] = (u8)(ty_array_n(mty) > 255 ? 255 : ty_array_n(mty));
                    } else {
                        mgd_kind[nmgd_fld] = 0;
                    }
                    nmgd_fld++;
                } else if (!d.mgd && ty_is_agg(mty)) {
                    /* 按值嵌套的结构体：它的托管字段也要跟着释放 */
                    mgd_idx[nmgd_fld] = (u8)n;
                    mgd_kind[nmgd_fld] = 3;
                    mgd_cnt[nmgd_fld] = 1;
                    nmgd_fld++;
                }
            }
            n++;
            any = 1;
            if (!pa_accept_ch(','))
                break;
        }
        (void)any;
        if (!memb_method)
            pa_expect_ch(';');
        /* 增量注册已看到的成员（方法体只能看到前面声明的成员） */
        if (n > 0) {
            u32 t2 = complete_id ? ty_agg_complete(complete_id, mem, bits, n, is_union)
                                 : ty_agg(mem, bits, n, is_union, tag);

            agg_names_set(t2, names, lens, n);
        }
    }
    pa_expect_ch('}');
    ty = complete_id ? ty_agg_complete(complete_id, mem, bits, n, is_union)
                     : ty_agg(mem, bits, n, is_union, tag);
    if (getenv("C6C_DBG_AGG"))
        fprintf(stderr, "       [dbg] struct ty=%u members=%u\n",
                (unsigned)ty, (unsigned)n);
    agg_names_set(ty, names, lens, n);
    if (DEF_DEPTH > 0)
        local_agg_mark(ty);
    if (nmgd_fld)
        mgdst_add(ty, mgd_idx, mgd_kind, mgd_cnt, nmgd_fld, (u32)def_file);
    if (nmgd_own && in_c6_tu()) {
        char dnm[160] = {0};

        agg_disp_name(ty, dnm, sizeof(dnm));
        if (saw_flex_mgd)
            pa_error("'%s' has a flexible array of managed references: "
                     "allocate it with 'new T[n]' instead", dnm);
        else if (is_union)
            pa_error("'%s' is a union with a managed field: which member is alive "
                     "cannot be known, use a struct", dnm);
        else if (DEF_DEPTH > 0 && !tmpl_inst_name(ty))
            pa_error("'%s' holds managed references and is defined in a block: "
                     "define it at file scope", dnm);
    }
    return ty;
}

static u32 parse_enum_spec(void);

/* `struct Tag` / `union Tag` / `enum {...}` */
/* c6 里 `struct Bitset { … }` 同时给出类型名 `Bitset`（不用 typedef）。
 * 只在 .c6 源文件里这么做——C 源码里同名标识符可能有别的含义。 */
static void c6_auto_typedef(const char *nm, u32 len, u32 ty)
{
    Sym *s = NULL;
    u32 n = 0;

    if (!CUR_FILE || !CUR_FILE->path)
        return;
    n = (u32)strlen(CUR_FILE->path);
    if (n < 3 || memcmp(CUR_FILE->path + n - 3, ".c6", 3) != 0)
        return;
    s = sym_find(nm, len);
    if (s && s->kind == SC_TYPEDEF)
        return;
    if (s)
        return;                  /* 已经有同名符号，不抢 */
    sym_add(nm, len, ty, SC_TYPEDEF);
}

/* `import a.b.c;`：把模块源码当"文本包含"读进来（单 TU 口径）。
 * 已导入过的按路径去重；找不到就报错（不静默）。 */
static const char *IMPORTED[256];
static u32 NIMPORTED;

static void c6_import(const char *path)
{
    SrcFile *f = NULL;
    u32 i = 0;
    int di = 0;

    for (i = 0; i < NIMPORTED; i++)
        if (strcmp(IMPORTED[i], path) == 0)
            return;                      /* 已经导入过 */
    f = find_include(path, 1, 0, &di);
    if (!f) {
        pa_error("找不到模块 '%s'（按 include 路径找 %s）", path, path);
        return;
    }
    if (NIMPORTED < 256)
        IMPORTED[NIMPORTED++] = arena_strdup(&A_main, path);
    pp_push_file(f, di);
}

/* c6 切片 `T[:]`：规范就是 `struct { T *const data; const size_t len; }`。
 * 这里按元素类型造（并缓存）一个这样的结构体类型，于是 `.data`/`.len`、
 * 按值传参、sizeof 全都直接复用现有的聚合支持；`s[i]` 在 gen_postfix 里
 * 改写成 `s.data[i]`（边界检查还没做，见 todo P6-3）。 */
#define SLICE_CACHE_MAX 256
static u32 SLICE_ET[SLICE_CACHE_MAX];
static u32 SLICE_TY[SLICE_CACHE_MAX];
static u32 NSLICE;

static u32 ty_slice(u32 et)
{
    u32 i = 0;
    u32 mem[2] = {0};
    u32 ty = 0;
    const char *names[2] = {"data", "len"};
    u32 lens[2] = {4, 3};

    for (i = 0; i < NSLICE; i++)
        if (SLICE_ET[i] == et)
            return SLICE_TY[i];
    mem[0] = ty_ptr(et);
    mem[1] = ty_ulong();
    ty = ty_agg(mem, NULL, 2, 0, 1u + (u32)(sym_hash_str("slice", 5) & 0x7FFFFFFFu)
                + NSLICE);
    agg_names_set(ty, names, lens, 2);
    if (NSLICE < SLICE_CACHE_MAX) {
        SLICE_ET[NSLICE] = et;
        SLICE_TY[NSLICE] = ty;
        NSLICE++;
    }
    return ty;
}


/* 是不是切片类型（ty_slice 造出来的那些） */
static int ty_is_slice(u32 ty)
{
    u32 i = 0;

    for (i = 0; i < NSLICE; i++)
        if (SLICE_TY[i] == ty)
            return 1;
    return 0;
}

static u32 ty_slice_elem(u32 ty)
{
    u32 i = 0;

    for (i = 0; i < NSLICE; i++)
        if (SLICE_TY[i] == ty)
            return SLICE_ET[i];
    return ty_int();
}

/* c6 `catch e { … }` 里 `e` 的类型：错误载荷 `{ int id; }`（最小版）。
 * 完整规范里载荷还有模块号段、消息指针等，见 docs/manual/errors.md。 */
static u32 ERRPAY_TY;

static u32 ty_errpay(void)
{
    u32 mem[2] = {0};
    const char *names[2] = {"id", "msg"};
    u32 lens[2] = {2, 3};

    if (!ERRPAY_TY) {
        mem[0] = ty_int();
        mem[1] = ty_ptr(ty_char());
        ERRPAY_TY = ty_agg(mem, NULL, 2, 0, 1u + (u32)(sym_hash_str("errpay", 6) & 0x7FFFFFFFu));
        agg_names_set(ERRPAY_TY, names, lens, 2);
    }
    return ERRPAY_TY;
}

/* ---------- 模板表（泛型）---------- */
#define TMPL_MAX 64

#define TMPL_NPARAM 4
#define TMPL_NINST 8

typedef struct Tmpl {
    const char *name;
    u32 nlen;
    const char *param[TMPL_NPARAM];
    u32 plen[TMPL_NPARAM];
    int pkind[TMPL_NPARAM];        /* 0 = 类型形参，1 = 值形参（常量） */
    u32 pvty[TMPL_NPARAM];         /* 值形参声明的类型（范围检查用） */
    u32 nparam;
    Tok *toks;
    u32 n;
    int is_union;
    int is_func;
    int is_typedef;                /* `|T| typedef <spec> <名字>;` */
    u32 name_i;
    u32 body_i;
    u32 ninst;
    u32 inst_arg[TMPL_NINST][TMPL_NPARAM];
    u32 inst_res[TMPL_NINST];
} Tmpl;

static Tmpl TMPL[TMPL_MAX];
static u32 NTMPL;

static Tmpl *tmpl_find(const char *nm, u32 nl)
{
    u32 i = 0;

    for (i = 0; i < NTMPL; i++)
        if (TMPL[i].nlen == nl && memcmp(TMPL[i].name, nm, nl) == 0)
            return &TMPL[i];
    return NULL;
}

/* 类型 → mangle 片段（`Vect@int` → `Vect_int`）。跨 TU 的约定，所以只用
 * 类型名本身，不用 id。 */
static void tmpl_mangle(u32 ty, char *out, u32 cap)
{
    const char *nm = NULL;

    if (ty == ty_int()) nm = "int";
    else if (ty == ty_uint()) nm = "uint";
    else if (ty == ty_long()) nm = "long";
    else if (ty == ty_ulong()) nm = "ulong";
    else if (ty == ty_llong()) nm = "llong";
    else if (ty == ty_ullong()) nm = "ullong";
    else if (ty == ty_short()) nm = "short";
    else if (ty == ty_ushort()) nm = "ushort";
    else if (ty == ty_char()) nm = "char";
    else if (ty == ty_schar()) nm = "schar";
    else if (ty == ty_uchar()) nm = "uchar";
    else if (ty == ty_float()) nm = "float";
    else if (ty == ty_double()) nm = "double";
    else if (ty == ty_void()) nm = "void";
    if (nm) {
        snprintf(out, cap, "%s", nm);
        return;
    }
    if (ty_is_ptr(ty)) {
        char sub[64] = {0};

        tmpl_mangle(ty_target(ty), sub, sizeof(sub));
        snprintf(out, cap, "p_%s", sub);
        return;
    }
    snprintf(out, cap, "t%u", (unsigned)ty);
}

typedef struct TmplSaved {
    IrFn fn;
    u32 ret;
    u32 self_ty;               /* 裸字段（`v` == `self->v`）靠它，模板实例化会改 */
    int loop;
    int sw;
    u32 nglbl;
    int dd;
    int ndf;
} TmplSaved;

static TmplSaved tmpl_sv;

static void tmpl_save_state(TmplSaved *sv);
static void tmpl_restore_state(TmplSaved *sv);

static u32 tmpl_inst(Tmpl *t, const u32 *args)
{
    u32 i = 0;
    u32 k = 0;
    u32 ty = 0;
    u32 tag = 0;
    u32 cid = 0;
    char m[256] = {0};
    char nm[320] = {0};
    char inst_nm_sv[sizeof(TMPL_INST_NM)] = {0};
    int tmpl_body_sv = 0;
    Sym *s = NULL;

    for (i = 0; i < t->ninst; i++) {
        int same = 1;

        for (k = 0; k < t->nparam; k++)
            if (t->inst_arg[i][k] != args[k])
                same = 0;
        if (same)
            return t->inst_res[i];
    }
    m[0] = 0;
    for (k = 0; k < t->nparam; k++) {
        char one[96] = {0};

        if (t->pkind[k])
            snprintf(one, sizeof(one), "%d", (int)args[k]);
        else
            tmpl_mangle(args[k], one, sizeof(one));
        if (k)
            strncat(m, "_", sizeof(m) - strlen(m) - 1);
        strncat(m, one, sizeof(m) - strlen(m) - 1);
    }
    snprintf(nm, sizeof(nm), "%.*s_%s", (int)t->nlen, t->name, m);
    tag = 1u + (u32)(sym_hash_str(nm, (u32)strlen(nm)) & 0x7FFFFFFFu);
    /* 先登记一个不完整类型占位并立刻进缓存：模板体里可能引用它自己
     * （`struct Node@T { Node@T *next; }`）。 */
    {
        u32 inc = ty_agg(NULL, NULL, 0, t->is_union, tag);

        if (NTINST < TINST_MAX && !tmpl_inst_name(inc)) {
            u32 q3 = 0;

            TINST_ID[NTINST] = inc;
            for (q3 = 0; q3 + 1 < 96 && nm[q3]; q3++)
                TINST_NM[NTINST][q3] = nm[q3];
            TINST_NM[NTINST][q3] = 0;
            NTINST++;
        }
        /* 实例名撞上已经存在的 tag（`struct Vect_int { … };` + `Vect@int`）：
         * 两个不同的类型用同一个 C 名字，链接/调试都说不清
         * （tests/errors/generic.c6 的 test_instance_name_taken）。 */
        {
            Sym *ex = sym_find_tag(nm, (u32)strlen(nm));

            /* 第二个 TU 里再写一遍同一个实例是合法的（类型表跨 TU 共享，
             * 占位类型 id 会不一样）——只有撞上**用户写的**同名结构体才报。 */
            if (ex && !tmpl_inst_name((u32)ex->val))
                pa_error("the instance name '%s' is already in use", nm);
        }
        s = sym_add_tag(nm, (u32)strlen(nm), inc);
        s->val = (i64)inc;
        cid = inc;
        if (t->ninst < TMPL_NINST) {
            for (k = 0; k < t->nparam; k++)
                t->inst_arg[t->ninst][k] = args[k];
            t->inst_res[t->ninst] = inc;
            t->ninst++;
        }
    }
    if (t->n == 0) {
        /* 前置声明的模板（`struct Fwd@T;`）：没有体，实例化出一个不完整类型 */
        return cid;
    }
    scope_enter();
    for (k = 0; k < t->nparam; k++) {
        if (t->pkind[k]) {
            /* 值形参：绑成枚举常量，这样 `T data[N]` 里的 N 能进常量表达式 */
            Sym *e = sym_add(t->param[k], t->plen[k], ty_int(), SC_ENUMC);

            e->val = (i64)args[k];
        } else {
            sym_add(t->param[k], t->plen[k], args[k], SC_TYPEDEF);
        }
    }
    if (PA_HAVE > 0) {
        Tok *save = arena_alloc(&A_main, (size_t)PA_HAVE * sizeof(Tok));
        u32 ns = (u32)PA_HAVE;
        u32 q2 = 0;

        for (q2 = 0; q2 < ns; q2++)
            save[q2] = *pa_peek((int)q2);
        pa_win_clear();
        pa_src_push(save, ns);
    }
    pa_src_push(t->toks, t->n);
    RP_N++;
    /* typedef 模板：体是 `typedef` 后面的那段（`<spec> <名字>;`），
     * 重新解析一遍就是实例化结果。 */
    if (t->is_typedef) {
        u32 n0 = FN.n;
        IrOp *bak = arena_alloc(&A_main, (size_t)(n0 ? n0 : 1) * sizeof(IrOp));

        if (n0)
            memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
        tmpl_save_state(&tmpl_sv);
        /* `PA_TMPL_BODY` 要**存档再恢复**，不能直接清零：实例化是在解析中途
         * 发生的（模板体里的某个成员/方法体又展开了别的模板），清零会把外层
         * "正在重放模板体"的状态一并抹掉——外层剩下的成员会被当成普通结构体
         * 的成员（方法体于是报"不能在结构体里定义函数"，链接名也从
         * `<实例名>_<方法>` 掉回 `c6m_...`）。 */
        tmpl_body_sv = PA_TMPL_BODY;
        PA_TMPL_BODY = 1;
        ty = parse_typespec();
        while (pa_accept_ch('*'))
            ty = ty_ptr(ty);
        if (ty && pa_cur()->kind == TK_IDENT) {
            /* 顺手按实例名登记成 typedef，`MyVec@int x;` 这种写法也能直接用 */
            Sym *td = sym_add(nm, (u32)strlen(nm), ty, SC_TYPEDEF);

            (void)td;
            pa_advance();
        }
        (void)pa_accept_ch(';');
        PA_TMPL_BODY = tmpl_body_sv;
        tmpl_restore_state(&tmpl_sv);
        if (n0)
            memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
        if (RP_N > 0)
            RP_N--;
        scope_leave();
        for (i = 0; i < t->ninst; i++)
            if (t->inst_res[i] == cid)
                t->inst_res[i] = ty;
        return ty;
    }
    /* 模板体里可能带**方法**。方法是真函数，`pa_func_def` 会 irfn_reset +
     * 立刻发射——而实例化往往发生在另一个函数（比如 main）的声明中间，
     * 所以当前函数的 IR 状态必须整份存档/恢复，否则外层函数的指令被冲掉
     * （现象是"编译通过、运行时崩"）。存档/恢复的实现在后面（那里能看到
     * NLOOP 等全局），这里只留调用。 */
    {
        /* 光存 `IrFn` 那份快照不够：`FN.ops` 指向的是**共用**的缓冲区，
         * 方法发射时会把里面的指令整片覆盖掉，恢复快照只把 n 拨回来、
         * 内容已经是方法体的了。所以连内容一起备份。 */
        u32 n0 = FN.n;
        IrOp *bak = arena_alloc(&A_main, (size_t)(n0 ? n0 : 1) * sizeof(IrOp));

        if (n0)
            memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
        tmpl_save_state(&tmpl_sv);
        tmpl_body_sv = PA_TMPL_BODY;
        PA_TMPL_BODY = 1;
        memcpy(inst_nm_sv, TMPL_INST_NM, sizeof(inst_nm_sv));
        memcpy(TMPL_INST_NM, nm, sizeof(TMPL_INST_NM));
        TMPL_INST_NM[sizeof(TMPL_INST_NM) - 1] = 0;
        ty = parse_struct_body(cid, tag, t->is_union);
        memcpy(TMPL_INST_NM, inst_nm_sv, sizeof(inst_nm_sv));
        PA_TMPL_BODY = tmpl_body_sv;
        tmpl_restore_state(&tmpl_sv);
        if (n0)
            memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
    }
    /* 模板体里的**方法**是普通函数，但登记在了"模板参数作用域"里，
     * scope_leave 之后就查不到了（`d->count()` 找不到 count）。这里把它们
     * 提到外层重新登记一次。 */
    {
        const char *lnm[64] = {0};
        u32 llen[64] = {0};
        u32 lty[64] = {0};
        i64 lval[64] = {0};
        u32 ln = 0;
        Sym *p = SCOPE ? SCOPE->head : NULL;

        for (; p && ln < 64; p = p->scope_next) {
            if (!p->is_func)
                continue;
            lnm[ln] = p->name;
            llen[ln] = p->len;
            lty[ln] = p->type;
            lval[ln] = p->val;
            ln++;
        }
        if (RP_N > 0)
            RP_N--;
        scope_leave();
        for (k = 0; k < ln; k++) {
            Sym *g = sym_add(lnm[k], llen[k], lty[k], SC_GLOBAL);

            g->is_func = 1;
            g->val = lval[k];
        }
    }
    for (i = 0; i < t->ninst; i++)
        if (t->inst_res[i] == cid)
            t->inst_res[i] = ty;
    return ty;
}

/* 吃掉一段平衡的花括号，同时（CAP_ON 时）把 token 收进 CAP_TOK；返回
 * 匹配 `}` 之后的 token 个数，用来裁掉前瞻多拉的那些。 */
static u32 tmpl_capture_body(void)
{
    int depth = 0;
    u32 i = 0;
    u32 e = 0;

    CAP_N = 0;
    for (i = 0; i < (u32)PA_HAVE; i++) {
        Tok *q = pa_peek((int)i);

        if (CAP_N < CAP_MAX)
            CAP_TOK[CAP_N++] = *q;
    }
    {
        /* 没出现过 `{` 的时候（`|T| typedef T *Ptr;` 这类），配对的终止符
         * 不是 `}` 而是 `;`——否则会一路吃到文件尾，连解析器位置也推到 EOF。 */
        int seen_brace = 0;

        CAP_ON = 1;
        while (pa_cur()->kind != TK_EOF) {
            int last = 0;

            if (pa_is_ch('{')) {
                depth++;
                seen_brace = 1;
            } else if (pa_is_ch('}')) {
                depth--;
                last = (depth == 0);
            } else if (!seen_brace && pa_is_ch(';')) {
                last = 1;
            }
            pa_advance();
            if (last)
                break;
        }
        CAP_ON = 0;
        if (!seen_brace)
            return CAP_N;
    }
    depth = 0;
    for (i = 0; i < CAP_N; i++) {
        Tok *q = &CAP_TOK[i];

        if (q->kind == TK_PUNCT) {
            if (TOK_EQ(q, "{")) {
                depth++;
            } else if (TOK_EQ(q, "}")) {
                depth--;
                if (depth == 0) {
                    e = i + 1;
                    break;
                }
            }
        }
    }
    return e;
}

/* ---------- 函数模板 ----------
 * 实例化分两步走，因为调用点在**另一个函数的表达式中间**：
 *   ① 调用点只重放"签名"（把捕获的 token 从返回类型截到参数表结束，末尾补一个
 *      合成的 `;`）——这一步只登记符号，不碰当前函数的 IR；
 *   ② 函数体的重放排进 worklist，等当前这条顶层声明做完（此时 FN 空闲）
 *      再跑，跑出来的实例直接发射。
 * 这样就不用在表达式中间存档/恢复整个 IrFn（那样做会把外层函数的 IR 搅乱）。
 */
/* 模板实参只允许"类型说明符 + 若干 `*`"：用 parse_typename() 会把紧跟的
 * `(`（调用的实参表）当成函数声明符吃进去。 */
static u32 tmpl_arg_ty(int allow_ptr)
{
    u32 t = 0;
    int save = PA_TYPE_ATOM;

    PA_TYPE_ATOM = 1;
    t = parse_typespec();
    PA_TYPE_ATOM = save;

    /* 只有带括号的写法 `@(int *)` 才吃 `*`。不带括号时 `*` 属于**外层声明符**：
     * `Vect@T *self` 里那个星号是指向实例的指针，被当成模板实参就会变成
     * `Vect@(T*)`——成员指针于是指向指针，下标步长翻倍（踩过）。 */
    if (allow_ptr) {
        while (pa_accept_ch('*'))
            t = ty_ptr(t);
    }
    return t;
}

/* 模板的重复定义：同一个文件里同一个名字定义了两次就是重定义；定义成另一种
 * 东西（struct / union / 函数）另报一条"as a different kind"。模块文件是文本
 * 内联的，重复解析的位置完全一样，不算。 */
#define TMPLDEF_MAX 256
static const char *TMPLDEF_NM[TMPLDEF_MAX];
static u32 TMPLDEF_LEN[TMPLDEF_MAX];
static u16 TMPLDEF_FILE[TMPLDEF_MAX];
static u32 TMPLDEF_OFF[TMPLDEF_MAX];
static u8 TMPLDEF_KIND[TMPLDEF_MAX];
static int NTMPLDEF;

static void tmpl_def_check(const char *nm, u32 len, int kind)
{
    int i = 0;

    if (!pa_cur())
        return;
    for (i = 0; i < NTMPLDEF; i++)
        if (TMPLDEF_LEN[i] == len && memcmp(TMPLDEF_NM[i], nm, len) == 0) {
            if (TMPLDEF_FILE[i] != pa_cur()->file || TMPLDEF_OFF[i] == pa_cur()->off)
                return;
            if (TMPLDEF_KIND[i] != (u8)kind)
                pa_error("redefinition of template '%.*s' as a different kind",
                         (int)len, nm);
            else
                pa_error("redefinition of template '%.*s'", (int)len, nm);
            return;
        }
    if (NTMPLDEF < TMPLDEF_MAX) {
        TMPLDEF_NM[NTMPLDEF] = nm;
        TMPLDEF_LEN[NTMPLDEF] = len;
        TMPLDEF_FILE[NTMPLDEF] = pa_cur()->file;
        TMPLDEF_OFF[NTMPLDEF] = pa_cur()->off;
        TMPLDEF_KIND[NTMPLDEF] = (u8)kind;
        NTMPLDEF++;
    }
}

/* 按模板声明的形参种类解析实参表：类型形参吃类型，值形参吃常量表达式。 */
static u32 tmpl_parse_args(Tmpl *t, u32 *args, int paren)
{
    u32 na = 0;

    /* 值形参必须用括号形式实例化：`Arr@4` 里的 4 到底是类型还是值看不出来
     * （tests/errors/generic.c6 的 test_value_arg_parens）。 */
    if (!paren && t && t->nparam > 0 && t->pkind[0]
        && in_c6_tu())
        pa_error("'%.*s' takes a value argument here: write '%.*s@(...)'",
                 (int)t->nlen, t->name, (int)t->nlen, t->name);
    if (paren)
        pa_expect_ch('(');
    while (na < TMPL_NPARAM && na < t->nparam && pa_cur()->kind != TK_EOF) {
        if (paren && pa_is_ch(')'))
            break;
        if (t->pkind[na]) {
            i64 v4 = (i64)const_expr();
            u32 vty4 = t->pvty[na];

            /* 值实参要能装进形参声明的类型（`short N` 配 40000 就是错的）
             * ——tests/errors/generic.c6 的 test_value_arg_range。 */
            if (vty4 && ty_is_int(vty4) && in_c6_tu()) {
                u32 bits = ty_size(vty4) * 8;
                i64 lo4 = 0;
                i64 hi4 = 0;

                if (bits > 0 && bits < 64) {
                    if (ty_is_signed(vty4)) {
                        lo4 = -((i64)1 << (bits - 1));
                        hi4 = ((i64)1 << (bits - 1)) - 1;
                    } else {
                        lo4 = 0;
                        hi4 = ((i64)1 << bits) - 1;
                    }
                    if (v4 < lo4 || v4 > hi4)
                        pa_error("value argument %ld does not fit in '%s'", (long)v4,
                                 ty_disp(vty4));
                }
            }
            args[na] = (u32)v4;
        } else {
            int save_ta = PA_TMPL_ARG;

            PA_TMPL_ARG = 1;
            args[na] = tmpl_arg_ty(paren);
            PA_TMPL_ARG = save_ta;
        }
        na++;
        if (!paren)
            break;
        if (!pa_accept_ch(','))
            break;
    }
    if (paren)
        pa_expect_ch(')');
    /* 实参个数必须和形参个数对上（tests/errors/generic.c6 的 zero_arg 等） */
    if (t && t->name && na < t->nparam)
        pa_error("'%.*s' needs %u type argument(s) (got %u)",
                 (int)t->nlen, t->name, (unsigned)t->nparam, (unsigned)na);
    return na;
}

#define FW_MAX 32
static Tmpl *FW_T[FW_MAX];
static u32 FW_A[FW_MAX][TMPL_NPARAM];
static u32 NFW;

static Tok *tmpl_syn_semi(void)
{
    Tok *t = arena_alloc(&A_main, sizeof(Tok));
    Tok z = {0};

    z.kind = TK_PUNCT;
    z.len = 1;
    z.hash = sym_hash_str(";", 1);
    z.flags = TF_SYN;
    z.syn = arena_strdup(&A_main, ";");
    *t = z;
    return t;
}

/* 用捕获的 token 重放一段：`n` 个 token + 可选的结尾 `;`。
 * 函数名 token 换成 mangle 后的合成 token（同一段 token 要吐出 f_int、f_char…）。 */
static void tmpl_poke(Tmpl *t, u32 n, int semi, const char *mname)
{
    Tok *toks = arena_alloc(&A_main, (size_t)(n + 1) * sizeof(Tok));

    memcpy(toks, t->toks, (size_t)n * sizeof(Tok));
    if (mname && t->name_i < n) {
        u32 nl2 = (u32)strlen(mname);

        toks[t->name_i].flags |= TF_SYN;
        toks[t->name_i].syn = arena_strndup(&A_main, mname, nl2);
        toks[t->name_i].len = nl2;
        toks[t->name_i].hash = sym_hash_str(mname, nl2);
    }
    if (semi) {
        Tok *z = tmpl_syn_semi();

        toks[n] = *z;
        n++;
    }
    if (PA_HAVE > 0) {
        Tok *save = arena_alloc(&A_main, (size_t)PA_HAVE * sizeof(Tok));
        u32 ns = (u32)PA_HAVE;
        u32 q2 = 0;

        for (q2 = 0; q2 < ns; q2++)
            save[q2] = *pa_peek((int)q2);
        pa_win_clear();
        pa_src_push(save, ns);
    }
    pa_src_push(toks, n);
}

static void tmpl_bind_params(Tmpl *t, const u32 *args)
{
    u32 k = 0;

    scope_enter();
    for (k = 0; k < t->nparam; k++) {
        if (t->pkind[k]) {
            Sym *e = sym_add(t->param[k], t->plen[k], ty_int(), SC_ENUMC);

            e->val = (i64)args[k];
        } else {
            sym_add(t->param[k], t->plen[k], args[k], SC_TYPEDEF);
        }
    }
}

/* 把一个作用域里登记的符号提到全局（模板参数作用域里登记的符号出了作用域
 * 就看不见了） */
static void tmpl_lift(const char *nm, u32 nl)
{
    Sym *fs = sym_find(nm, nl);
    u32 fty = fs ? fs->type : 0;
    i64 fval = fs ? fs->val : 0;
    int ff = fs ? fs->is_func : 0;

    scope_leave();
    if (fs && fty && ff) {
        Sym *g = sym_add(nm, nl, fty, SC_GLOBAL);

        g->is_func = 1;
        g->val = fval;
    }
}

static void tmpl_mangle_name(Tmpl *t, const u32 *args, u32 na, char *nm, u32 cap)
{
    char m[256] = {0};
    u32 k = 0;

    m[0] = 0;
    for (k = 0; k < na; k++) {
        char one[96] = {0};

        tmpl_mangle(args[k], one, sizeof(one));
        if (k)
            strncat(m, "_", sizeof(m) - strlen(m) - 1);
        strncat(m, one, sizeof(m) - strlen(m) - 1);
    }
    snprintf(nm, cap, "%.*s_%s", (int)t->nlen, t->name, m);
}

/* ① 只登记签名。返回符号 id（失败返回 0） */
/* 某个类型是模板的实例？是的话把 (模板下标, 实参) 找回来——方法调用糖在
 * 找不到 ms 时靠它把 `|T| T vat(Vect@T *self, …)` 这类**函数模板**实例化。 */
static int tmpl_args_of_ty(u32 ty, u32 *args, u32 *na)
{
    u32 i = 0;
    u32 k = 0;

    for (i = 0; i < NTMPL; i++) {
        for (k = 0; k < TMPL[i].ninst; k++) {
            if (TMPL[i].inst_res[k] == ty) {
                u32 j = 0;

                for (j = 0; j < TMPL[i].nparam && j < TMPL_NPARAM; j++)
                    args[j] = TMPL[i].inst_arg[k][j];
                *na = TMPL[i].nparam;
                return (int)i;
            }
        }
    }
    return -1;
}

static u32 tmpl_func_sig(Tmpl *t, const u32 *args, u32 na)
{
    char nm[320] = {0};
    Sym *s = NULL;

    tmpl_mangle_name(t, args, na, nm, sizeof(nm));
    s = sym_find(nm, (u32)strlen(nm));
    if (s && s->is_func)
        return (u32)s->val;
    tmpl_bind_params(t, args);
    tmpl_poke(t, t->body_i, 1, nm);
    {
        u32 base = parse_typespec();

        gen_decl_from_spec(base);
    }
    tmpl_lift(nm, (u32)strlen(nm));
    s = sym_find(nm, (u32)strlen(nm));
    return (s && s->is_func) ? (u32)s->val : 0;
}

/* ② 重放函数体（只在顶层声明之间调用，FN 空闲） */
static void tmpl_func_body(Tmpl *t, const u32 *args, u32 na)
{
    char nm[320] = {0};
    Tok *toks = NULL;

    tmpl_mangle_name(t, args, na, nm, sizeof(nm));
    (void)toks;
    tmpl_bind_params(t, args);
    tmpl_poke(t, t->n, 0, nm);
    {
        u32 base = parse_typespec();

        gen_decl_from_spec(base);
    }
    tmpl_lift(nm, (u32)strlen(nm));
}

/* ---------- 函数字面量 ----------
 * `int(int n) { … }`：不捕获的匿名函数。签名就地解析（拿类型、登记符号、
 * 给调用方一个地址），函数体排队到**本函数发射之前**再发——`irfn_reset`
 * 只把 n 归零、不换缓冲区，所以在中间发会把本函数的指令就地覆盖掉。 */
#define FN_LIT_MAX 32

#define FL_CAP_MAX 16

typedef struct FnLit {
    Sym *sym;
    Declarator d;
    Tok *toks;
    u32 n;
    u32 fty;                 /* 声明里的函数类型（不含隐藏的 env 形参） */
    int ncap;                /* 捕获了几个外层变量（0 = 不捕获） */
    const char *cname[FL_CAP_MAX];
    u32 clen[FL_CAP_MAX];
    u32 cty[FL_CAP_MAX];
    u32 coff[FL_CAP_MAX];
    u32 envbytes;
} FnLit;

static FnLit FL[FN_LIT_MAX];
static u32 NFL;
static int FL_LAST;          /* 最近一次 fnlit_parse_sym 的 FL 下标 */


/* 闭包体发射期间的捕获表（pa_func_def 进来时登记成"环境里的变量"） */
static u32 FLCAP_N;
static const char *FLCAP_NAME[FL_CAP_MAX];
static u32 FLCAP_LEN[FL_CAP_MAX];
static u32 FLCAP_TY[FL_CAP_MAX];
static u32 FLCAP_OFF[FL_CAP_MAX];
#define CAP_SLOT_BIT 0x80000000u

static void fnlit_drain(void)
{
    while (NFL > 0) {
        u32 i = --NFL;
        u32 q = 0;

        if (PA_HAVE > 0) {
            Tok *save = arena_alloc(&A_main, (size_t)PA_HAVE * sizeof(Tok));
            u32 ns = (u32)PA_HAVE;

            for (q = 0; q < ns; q++)
                save[q] = *pa_peek((int)q);
            pa_win_clear();
            pa_src_push(save, ns);
        }
        pa_src_push(FL[i].toks, FL[i].n);
        FLCAP_N = (u32)FL[i].ncap;
        for (q = 0; q < FLCAP_N && q < FL_CAP_MAX; q++) {
            FLCAP_NAME[q] = FL[i].cname[q];
            FLCAP_LEN[q] = FL[i].clen[q];
            FLCAP_TY[q] = FL[i].cty[q];
            FLCAP_OFF[q] = FL[i].coff[q];
        }
        pa_func_def(FL[i].sym, &FL[i].d);
        FLCAP_N = 0;
    }
}

/* 把一个外层变量登记进字面量的捕获表（已经在表里就不重复）。 */
static void fnlit_add_capture(u32 fi, Tok *t, Sym *cs)
{
    u32 k2 = 0;

    for (k2 = 0; k2 < (u32)FL[fi].ncap; k2++)
        if (FL[fi].clen[k2] == t->len
            && memcmp(FL[fi].cname[k2], tok_data(t), t->len) == 0)
            return;
    if (FL[fi].ncap >= FL_CAP_MAX)
        return;
    {
        u32 csz = ty_size(cs->type);
        u32 kk = (u32)FL[fi].ncap;

        if (csz == 0)
            csz = 8;
        csz = (csz + 7u) & ~7u;
        FL[fi].cname[kk] = arena_strndup(&A_main, tok_data(t), t->len);
        FL[fi].clen[kk] = t->len;
        FL[fi].cty[kk] = cs->type;
        FL[fi].coff[kk] = 8 + FL[fi].envbytes;
        FL[fi].envbytes += csz;
        FL[fi].ncap++;
    }
}

/* 解析一个函数字面量：签名就地定，函数体排队。返回登记好的符号。 */
static u32 parse_param_list(u32 fnret, Declarator *d);

static Sym *fnlit_parse_sym(void)
{
    u32 ret = 0;
    int save_at = PA_TYPE_ATOM;
    Declarator d = {0};
    char nm[64] = {0};
    Sym *fs = NULL;
    static u32 NFNLIT;
    u32 ntok = 0;

    PA_TYPE_ATOM = 1;
    ret = parse_typespec();
    PA_TYPE_ATOM = save_at;
    snprintf(nm, sizeof(nm), "__fnlit_%u", (unsigned)NFNLIT++);
    d.name = arena_strdup(&A_main, nm);
    d.nlen = (u32)strlen(nm);
    pa_advance();                            /* '(' */
    d.type = parse_param_list(ret, &d);
    fs = sym_add(d.name, d.nlen, d.type, SC_GLOBAL);
    fs->is_func = 1;
    fs->val = (i64)x64_sym(&X64, emit_name(d.name));
    ntok = tmpl_capture_body();
    if (NFL < FN_LIT_MAX) {
        u32 fi = NFL;
        int prev_dot = 0;
        int k_skip = 0;

        FL[fi].sym = fs;
        FL[fi].d = d;
        FL[fi].n = ntok;
        FL[fi].fty = d.type;
        FL[fi].ncap = 0;
        FL[fi].envbytes = 0;
        FL[fi].toks = arena_alloc(&A_main, (size_t)(ntok ? ntok : 1) * sizeof(Tok));
        if (ntok)
            memcpy(FL[fi].toks, CAP_TOK, (size_t)ntok * sizeof(Tok));
        /* 体里引用的**外层**局部量/形参要拷进环境对象：体是排队到本函数
         * 发射前才发的，那时外层作用域已经没了，只能在这里先记下来。 */
        {
            u32 ti = 0;
            /* 体**自己**的形参和局部变量不算捕获。以前只按名字查外层符号，
             * `int p = 5;` 外层 + 体内 `int p = 0;` 就会把 p 抓进环境，字面量
             * 悄悄变成闭包对象，赋给普通函数指针后一跳就飞。 */
            const char *skip[64] = {0};
            u32 skipl[64] = {0};
            int nskip = 0;
            u32 pj = 0;

            for (pj = 0; pj < d.nparams && nskip < 64; pj++) {
                skip[nskip] = d.pname[pj];
                skipl[nskip] = d.plen[pj];
                nskip++;
            }
            {
                int decl = 0;

                for (ti = 0; ti < ntok && nskip < 64; ti++) {
                    Tok *t = &CAP_TOK[ti];

                    if (t->kind == TK_IDENT
                        && (TOK_EQ(t, "struct") || TOK_EQ(t, "union")
                            || TOK_EQ(t, "enum"))) {
                        ti++;
                        decl = 1;
                        continue;
                    }
                    if (is_typename_tok(t)) {
                        decl = 1;
                        continue;
                    }
                    if (decl && t->kind == TK_PUNCT && TOK_EQ(t, "*"))
                        continue;
                    if (decl && t->kind == TK_IDENT) {
                        skip[nskip] = tok_data(t);
                        skipl[nskip] = t->len;
                        nskip++;
                        decl = 0;
                        continue;
                    }
                    decl = 0;
                }
            }
            for (ti = 0; ti < ntok; ti++) {
                Tok *t = &CAP_TOK[ti];
                int isdot = (t->kind == TK_PUNCT
                             && (TOK_EQ(t, ".") || TOK_EQ(t, "->")));

                /* `sizeof(a)` / `typeof(a)` 里的名字**不求值**：数组、`own` 引用
                 * 这些"不能拷进环境"的东西出现在里面是合法的，不能当捕获
                 * （tests/closure.c6 的"sizeof 捕获：数组只做类型检查"）。 */
                if (t->kind == TK_IDENT
                    && (TOK_EQ(t, "sizeof") || TOK_EQ(t, "typeof")
                        || TOK_EQ(t, "__typeof__") || TOK_EQ(t, "__typeof")
                        || TOK_EQ(t, "alignof") || TOK_EQ(t, "_Alignof"))) {
                    if (ti + 1 < ntok && CAP_TOK[ti + 1].kind == TK_PUNCT
                        && tok_eq(&CAP_TOK[ti + 1], "(")) {
                        int sd = 0;
                        u32 sj = ti + 1;

                        for (; sj < ntok; sj++) {
                            if (CAP_TOK[sj].kind != TK_PUNCT)
                                continue;
                            if (tok_eq(&CAP_TOK[sj], "("))
                                sd++;
                            else if (tok_eq(&CAP_TOK[sj], ")")) {
                                sd--;
                                if (sd == 0)
                                    break;
                            }
                        }
                        /* 里面的名字**只做类型检查**：不报"不能捕获"，
                         * 但要静默登记进捕获表——函数体是排队到后面才发的，
                         * 不登记的话 `sizeof(a)` 里的 a 在体里就成了未声明。 */
                        {
                            u32 q4 = ti + 2;

                            for (; q4 < sj; q4++) {
                                if (CAP_TOK[q4].kind != TK_IDENT)
                                    continue;
                                {
                                    Sym *cs4 = sym_find(tok_data(&CAP_TOK[q4]),
                                                        CAP_TOK[q4].len);

                                    if (cs4 && (cs4->kind == SC_LOCAL
                                                || cs4->kind == SC_PARAM))
                                        fnlit_add_capture(fi, &CAP_TOK[q4], cs4);
                                }
                            }
                        }
                        ti = sj;              /* 整个 sizeof(…) 跳过 */
                    } else if (ti + 1 < ntok) {
                        ti++;
                    }
                    prev_dot = 0;
                    continue;
                }
                if (t->kind != TK_IDENT) {
                    prev_dot = isdot;
                    continue;
                }
                if (prev_dot) {
                    prev_dot = 0;
                    continue;
                }
                prev_dot = 0;
                {
                    int sk = 0;

                    for (k_skip = 0; k_skip < nskip; k_skip++)
                        if (skipl[k_skip] == t->len
                            && memcmp(skip[k_skip], tok_data(t), t->len) == 0)
                            sk = 1;
                    if (sk)
                        continue;
                }
                {
                    Sym *cs = sym_find(tok_data(t), t->len);
                    u32 k = 0;
                    int dup = 0;

                    if (!cs || (cs->kind != SC_LOCAL && cs->kind != SC_PARAM))
                        continue;
                    /* 能被拷进环境对象的只有"普通的值/托管引用"：
                     *   - `own` 引用会转移所有权，拷一份等于两份主人；
                     *   - `weak` 得先升级成 `@T`；
                     *   - 数组要按切片/指针传；
                     *   - 函数里声明的类型跨不过去
                     * （tests/errors/closure_capture_type.c6）。 */
                    if (cs->is_own) {
                        pa_error("a closure cannot capture '%.*s': an 'own' reference "
                                 "cannot be copied", (int)t->len, tok_data(t));
                        continue;
                    }
                    if (cs->is_mgd == 2) {
                        pa_error("a closure cannot capture '%.*s': upgrade the 'weak' "
                                 "reference to '@T' first", (int)t->len, tok_data(t));
                        continue;
                    }
                    if (ty_is_array(cs->type)) {
                        pa_error("a closure cannot capture the array '%.*s': pass a "
                                 "slice 'T[:]' or a pointer instead",
                                 (int)t->len, tok_data(t));
                        continue;
                    }
                    if (ty_is_agg(cs->type) && is_local_agg(cs->type)) {
                        pa_error("a closure cannot capture '%.*s': its type is declared "
                                 "in a block (move the type to file scope)",
                                 (int)t->len, tok_data(t));
                        continue;
                    }
                    /* 捕获另一个闭包（尤其是正在赋值的那个自己）：对象里存的是
                     * **旧值**，递归会拿到没初始化/过期的那份
                     * （tests/errors/closure_opaque.c6 的 test_self）。 */
                    if (ty_is_closure(cs->type, NULL)) {
                        pa_error("'%.*s' is captured by the closure being assigned to it: "
                                 "the closure would see the old value (use a named "
                                 "function for recursion)", (int)t->len, tok_data(t));
                        continue;
                    }
                    for (k = 0; k < (u32)FL[fi].ncap; k++)
                        if (FL[fi].clen[k] == t->len
                            && memcmp(FL[fi].cname[k], tok_data(t), t->len) == 0)
                            dup = 1;
                    if (dup || FL[fi].ncap >= FL_CAP_MAX)
                        continue;
                    {
                        u32 csz = ty_size(cs->type);
                        u32 k2 = (u32)FL[fi].ncap;

                        if (csz == 0)
                            csz = 8;
                        csz = (csz + 7u) & ~7u;
                        FL[fi].cname[k2] = arena_strndup(&A_main, tok_data(t), t->len);
                        FL[fi].clen[k2] = t->len;
                        FL[fi].cty[k2] = cs->type;
                        FL[fi].coff[k2] = 8 + FL[fi].envbytes;
                        FL[fi].envbytes += csz;
                        FL[fi].ncap++;
                    }
                }
            }
        }
        if (FL[fi].ncap > 0) {
            /* 捕获的闭包：函数体多一个隐藏首参 void *__env */
            Declarator nd = d;
            u32 k = 0;

            nd.nparams = d.nparams + 1;
            nd.pname[0] = "__env";
            nd.plen[0] = 5;
            nd.ptype[0] = ty_ptr(ty_void());
            for (k = 0; k < d.nparams && k + 1 < 16; k++) {
                nd.pname[k + 1] = d.pname[k];
                nd.plen[k + 1] = d.plen[k];
                nd.ptype[k + 1] = d.ptype[k];
            }
            FL[fi].d = nd;
            fs->type = ty_func(ret, nd.ptype, nd.nparams, 0);
        }
        FL_LAST = (int)fi;
        NFL++;
        E_CLOSURE_LIT = FL[fi].ncap > 0 ? 1 : 0;
        E_CLOSURE_NAME = FL[fi].ncap > 0 ? FL[fi].cname[0] : NULL;
    }
    return fs;
}

/* 把 worklist 跑空（顶层每做完一条声明调一次） */
static void tmpl_drain(void)
{
    u32 guard = 0;

    fnlit_drain();
    while (NFW > 0 && guard++ < 256) {
        u32 i = --NFW;
        u32 args[TMPL_NPARAM] = {0};
        u32 k = 0;

        for (k = 0; k < TMPL_NPARAM; k++)
            args[k] = FW_A[i][k];
        tmpl_func_body(FW_T[i], args, FW_T[i]->nparam);
    }
}


static u32 parse_agg_spec(int is_union)
{
    const char *tn = NULL;
    u32 tlen = 0;
    u32 tag = 0;
    u32 ty = 0;
    Sym *s = NULL;

    {
        int save_pk = TY_PACK;

        SAW_PACKED = 0;
        SAW_ALIGN = 0;
        skip_attributes();     /* `struct __attribute__((packed)) S {…}` */
        if (SAW_PACKED) {
            TY_PACK = 1;
            SAW_PACKED = 0;
        }
        ALIGN_SAVE[NPACK_SAVE & 31] = TY_ALIGN;
        if (SAW_ALIGN > 0) {
            TY_ALIGN = SAW_ALIGN;
            SAW_ALIGN = 0;
        }
        PACK_SAVE[NPACK_SAVE & 31] = save_pk;
        NPACK_SAVE++;
    }
    if (pa_cur()->kind == TK_IDENT && !pa_is_ch('{')) {
        /* 标签名走一张独立的表：用 SC_TAG 符号存 */
        tn = tok_data(pa_cur());
        tlen = pa_cur()->len;
        pa_advance();
    }
    /* 泛型：`struct Vect@T { … }` 是模板定义，`struct Vect@int` 是实例。
     * 实例化出来的类型名本身就是类型，前面不能再带 `struct`/`union`
     * （tests/errors/generic.c6 的 test_drop_struct）。 */
    if (tn && pa_is_ch('@')) {
        /* 往后找一个"这个 `@…` 是定义还是实例"的判据：跳过实参/形参表，
         * 后面跟 `{` 的是模板定义（`struct Vect@T { … }` /
         * `struct Vect@(T) { … }`），否则就是实例，而实例前面不能带
         * `struct`（tests/errors/generic.c6 的 test_drop_struct）。 */
        u32 lq = 1;
        int ld = 0;
        Tok *nx2 = NULL;

        if (pa_peek(lq) && pa_peek(lq)->kind == TK_PUNCT && tok_eq(pa_peek(lq), "(")) {
            for (; lq < PA_LOOK; lq++) {
                Tok *q2 = pa_peek(lq);

                if (!q2 || q2->kind == TK_EOF)
                    break;
                if (q2->kind != TK_PUNCT)
                    continue;
                if (tok_eq(q2, "(")) {
                    ld++;
                } else if (tok_eq(q2, ")")) {
                    ld--;
                    if (ld == 0) {
                        lq++;
                        break;
                    }
                }
            }
        } else {
            for (; lq < PA_LOOK; lq++) {
                Tok *q2 = pa_peek(lq);

                if (!q2 || q2->kind != TK_IDENT)
                    break;
                lq++;
                if (pa_peek(lq) && pa_peek(lq)->kind == TK_PUNCT && tok_eq(pa_peek(lq), ",")) {
                    lq++;
                    continue;
                }
                break;
            }
        }
        nx2 = pa_peek(lq);
        /* `{` = 定义、`;` = 模板的前置声明（`struct Fwd@T;`），两者都不是实例 */
        if (nx2 && !(nx2->kind == TK_PUNCT
                     && (TOK_EQ(nx2, "{") || TOK_EQ(nx2, ";"))))
            pa_error("an instance drops 'struct': write the instance name on its own");
    }
    if (tn && pa_is_ch('@')) {
        const char *pn = NULL;
        u32 plen = 0;
        const char *par_n[TMPL_NPARAM] = {0};
        u32 par_len[TMPL_NPARAM] = {0};
        int par_kind[TMPL_NPARAM] = {0};
        u32 par_vty[TMPL_NPARAM] = {0};
        u32 npar = 0;

        /* 两种形状：`@K` 一个参数，`@(K, V)` 多个。定义还是实例看参数表
         * 后面是不是 `{`——定义时参数是名字，实例时参数是类型。 */
        {
            int paren = 0;
            int is_def = 0;

            pa_advance();                 /* 吃掉 '@' */
            if (pa_is_ch('(')) {
                int depth = 0;
                int k = 0;

                paren = 1;
                /* 找匹配的 ')' 后面的那个 token */
                for (k = 0; k < PA_LOOK; k++) {
                    Tok *q = pa_peek(k);

                    if (q->kind != TK_PUNCT)
                        continue;
                    if (tok_eq(q, "(")) {
                        depth++;
                    } else if (tok_eq(q, ")")) {
                        depth--;
                        if (depth == 0) {
                            Tok *nx = pa_peek(k + 1);

                            is_def = (nx->kind == TK_PUNCT && TOK_EQ(nx, "{"));
                            break;
                        }
                    }
                }
            } else {
                Tok *p1 = pa_peek(0);
                Tok *p2 = pa_peek(1);

                is_def = (p1->kind == TK_IDENT && p2->kind == TK_PUNCT
                          && TOK_EQ(p2, "{"));
            }
            if (!is_def) {
                u32 args[TMPL_NPARAM] = {0};
                u32 na = 0;
                Tmpl *t0 = tmpl_find(tn, tlen);
                int save_nn = PA_NO_NAME;
                int was_fwd = 0;

                if (!t0 && !paren) {
                    /* 前置声明：`struct Fwd@T;`——模板只有声明没有体。形参就是
                     * 这一串标识符（逗号分隔），登记一个空模板，实例化出来的
                     * 是不完整类型（只能取指针）。 */
                    const char *fwd_n[TMPL_NPARAM] = {0};
                    u32 fwd_l[TMPL_NPARAM] = {0};
                    u32 nfa = 0;
                    int okfwd = 1;
                    u32 qf = 0;

                    for (;;) {
                        Tok *a1 = pa_peek(qf);
                        Tok *a2 = NULL;

                        if (!a1 || a1->kind != TK_IDENT) {
                            okfwd = 0;
                            break;
                        }
                        if (nfa < TMPL_NPARAM) {
                            fwd_n[nfa] = tok_data(a1);
                            fwd_l[nfa] = a1->len;
                            nfa++;
                        }
                        qf++;
                        a2 = pa_peek(qf);
                        if (a2 && a2->kind == TK_PUNCT && tok_eq(a2, ",")) {
                            qf++;
                            continue;
                        }
                        break;
                    }
                    if (okfwd && nfa > 0 && NTMPL < TMPL_MAX) {
                        Tmpl *tf = &TMPL[NTMPL];
                        u32 kf = 0;

                        memset(tf, 0, sizeof *tf);
                        tf->name = arena_strndup(&A_main, tn, tlen);
                        tf->nlen = tlen;
                        tf->nparam = nfa;
                        tf->is_union = is_union;
                        for (kf = 0; kf < nfa; kf++) {
                            tf->param[kf] = fwd_n[kf];
                            tf->plen[kf] = fwd_l[kf];
                            tf->pkind[kf] = 0;
                        }
                        NTMPL++;
                        t0 = tf;
                        was_fwd = 1;
                    }
                }
                if (!t0) {
                    pa_error("没有叫 '%.*s' 的模板", (int)tlen, tn);
                    pa_advance();
                    return ty_agg(NULL, NULL, 0, is_union, 0);
                }
                PA_NO_NAME = 1;
                na = tmpl_parse_args(t0, args, paren);
                PA_NO_NAME = save_nn;
                /* 前置声明的形参只是那串标识符：它们不是真正的类型名，
                 * 类型解析认不出来，会把 token 留在原地（`struct Fwd@T;`
                 * 的 `T` 于是被外面当成变量名，报一堆莫名其妙的错）。
                 * 这里按登记下来的形参个数补齐吃掉。 */
                if (was_fwd) {
                    while (pa_cur()->kind == TK_IDENT) {
                        pa_advance();
                        if (!pa_accept_ch(','))
                            break;
                    }
                }
                return tmpl_inst(t0, args);
            }
            /* 定义：收集参数名 */
            if (!paren) {
                if (pa_cur()->kind != TK_IDENT) {
                    pa_error("模板参数名要一个标识符");
                    return ty_int();
                }
                par_n[0] = tok_data(pa_cur());
                par_len[0] = pa_cur()->len;
                npar = 1;
                pa_advance();
            } else {
                pa_expect_ch('(');
                while (npar < TMPL_NPARAM && !pa_is_ch(')')) {
                    /* 两种写法：`T`（类型形参）/ `int N`（值形参，按常量绑定） */
                    if (pa_cur()->kind != TK_IDENT)
                        break;
                    if (pa_peek(1)->kind == TK_IDENT) {
                        u32 vpty2 = parse_typespec();   /* 值形参的类型 */

                        if (npar < TMPL_NPARAM)
                            par_vty[npar] = vpty2;
                        if (vpty2 && ty_size(vpty2) > 4)
                            pa_error("a value parameter must be an integer type no "
                                     "wider than 'int'");
                        if (pa_cur()->kind == TK_IDENT) {
                            par_n[npar] = tok_data(pa_cur());
                            par_len[npar] = pa_cur()->len;
                            par_kind[npar] = 1;
                            npar++;
                            pa_advance();
                        }
                    } else {
                        par_n[npar] = tok_data(pa_cur());
                        par_len[npar] = pa_cur()->len;
                        par_kind[npar] = 0;
                        npar++;
                        pa_advance();
                    }
                    if (!pa_accept_ch(','))
                        break;
                }
                pa_expect_ch(')');
            }
            pn = par_n[0];
            plen = par_len[0];
        }
        if (pa_is_ch('{')) {
            /* 定义：只捕获 token，不解析（参数名此刻还没有具体类型） */
            u32 ntok = tmpl_capture_body();
            Tmpl *t = NULL;
            u32 ti = 0;

            /* 模板表**跨 TU 保留**（token 串要等下个 TU 开头才能安全释放），
             * 所以第二个 TU 再写一遍同一个模板时会命中上一个 TU 留下的那格。
             * 必须**就地覆盖**：否则 `tmpl_find` 返回的是旧的那格，它的
             * 实例缓存（ninst）里已经有 `Vect_int`，实例化直接短路返回，
             * 这个 TU 里就没有 `Vect_int_at` 这个方法（tests/tu/generic.c6
             * 的 `p->at(0)` 就是这么挂的）。 */
            for (ti = 0; ti < NTMPL; ti++)
                if (TMPL[ti].nlen == tlen
                    && memcmp(TMPL[ti].name, tn, (size_t)tlen) == 0
                    && TMPL[ti].nparam == npar) {
                    t = &TMPL[ti];
                    break;
                }
            if (!t) {
                if (NTMPL >= TMPL_MAX) {
                    pa_error("模板太多（上限 %d）", TMPL_MAX);
                    return ty_int();
                }
                t = &TMPL[NTMPL++];
            }
            tmpl_def_check(arena_strndup(&A_main, tn, tlen), tlen, is_union ? 1 : 0);
            t->name = arena_strndup(&A_main, tn, tlen);
            t->nlen = tlen;
            t->nparam = npar;
            {
                u32 pk = 0;

                for (pk = 0; pk < npar; pk++) {
                    t->param[pk] = arena_strndup(&A_main, par_n[pk], par_len[pk]);
                    t->plen[pk] = par_len[pk];
                    t->pkind[pk] = par_kind[pk];
                    t->pvty[pk] = par_vty[pk];
                }
            }
            t->n = ntok;
            t->toks = arena_alloc(&A_main, (size_t)(ntok ? ntok : 1) * sizeof(Tok));
            if (ntok)
                memcpy(t->toks, CAP_TOK, (size_t)ntok * sizeof(Tok));
            t->is_union = is_union;
            t->ninst = 0;
            return ty_int();       /* 定义本身不产生类型；声明处会忽略 */
        }
    }
    if (pa_is_ch('{')) {
        char nm[256] = {0};
        u32 k = tlen < 200 ? tlen : 200;
        u32 cid = 0;

        if (tn) {
            tag = 1u + (u32)(sym_hash_str(tn, tlen) & 0x7FFFFFFFu);
            memcpy(nm, tn, k);
            /* 定义体里可能出现自引用（`struct Sym { struct Sym *next; }`），
             * 所以先把标签登记成一个**不完整类型**占位，成员解析时就能看到；
             * 等成员表解析完再就地补全同一个 id。 */
            s = sym_find_tag(nm, k);
            /* 同名标签在外层作用域：内层这次定义要新建一层来遮蔽它 */
            if (s && !sym_in_cur_scope(s))
                s = NULL;
            if (!s) {
                u32 inc = ty_agg(NULL, NULL, 0, is_union, tag);

                s = sym_add_tag(nm, k, inc);
                s->val = (i64)inc;
            }
            if (ty_is_agg((u32)s->val) && ty_member_n((u32)s->val) == 0)
                cid = (u32)s->val;
            /* 先把"标签也是类型名"登记上，再解析体：方法体里会写 `F r;`
             * （`F` 就是正在定义的这个结构体），登记晚了就解析不出来，
             * 报"未声明的标识符 'F'"。占位类型是就地补全的，先登记不影响。 */
            c6_auto_typedef(nm, k, (u32)s->val);
        }
        ty = parse_struct_body(cid, tag, is_union);
        if (NPACK_SAVE > 0) {
            NPACK_SAVE--;
            TY_PACK = PACK_SAVE[NPACK_SAVE & 31];
            TY_ALIGN = ALIGN_SAVE[NPACK_SAVE & 31];
        }
        /* `struct Vect@int v;`：实例化出来的类型名本身就是类型，前面不能再
         * 带 `struct`（tests/errors/generic.c6 的 test_drop_struct）。 */
        if (pa_is_ch('@'))
            pa_error("an instance drops 'struct': write the instance name on its own");
        if (tn) {
            if (s)
                s->val = (i64)ty;
            else {
                s = sym_add_tag(nm, k, ty);
                s->val = (i64)ty;
            }
            c6_auto_typedef(nm, k, ty);
        }
        return ty;
    }
    if (!tn) {
        pa_error("struct/union 缺标签名");
        return ty_int();
    }
    {
        char nm[256] = {0};
        u32 k = tlen < 200 ? tlen : 200;

        memcpy(nm, tn, k);
        s = sym_find_tag(nm, k);
        if (s)
            return (u32)s->val;
    }
    /* 前置声明 `struct S *p;`：给一个不完整类型 */
    {
        char nm[256] = {0};
        u32 k = tlen < 200 ? tlen : 200;
        u32 hv = 0;

        memcpy(nm, tn, k);
        hv = sym_hash_str(nm, k);
        if (PA_IN_PROTO) {
            /* interface 签名里的 tag：原型作用域，和文件作用域的同名 tag
             * 是两个类型，所以换一个 intern 键、并且**不登记**到标签表。 */
            ty = ty_agg(NULL, NULL, 0, is_union,
                        1u + (u32)((hv ^ PROTO_TAG_KEY) & 0x7FFFFFFFu));
            sym_tag_disp(nm, k, ty);
            return ty;
        }
        ty = ty_agg(NULL, NULL, 0, is_union, 1u + (u32)(hv & 0x7FFFFFFFu));
        s = sym_add_tag(nm, k, ty);
        s->val = (i64)ty;
    }
    return ty;
}

/* 有没有出现过带标签的枚举（`enum Color {…}`）。有的话 `Color.RED` 这种
 * 限定常量名才可能存在，标识符分派里那条检查才需要跑。 */
static int HAS_ENUM_TAG;

/* 两个枚举都定义了同名成员时，裸名就有歧义：用的时候必须写限定名
 * （tests/errors/enum_scope.c6 的 test_ambiguous_bare）。 */
#define POISON_MAX 256
static char POISON_NM[POISON_MAX][64];
static int NPOISON;

static void poison_add(const char *nm, u32 k)
{
    int i = 0;

    if (k >= 64)
        k = 63;
    for (i = 0; i < NPOISON; i++)
        if (memcmp(POISON_NM[i], nm, k) == 0 && POISON_NM[i][k] == 0)
            return;
    if (NPOISON < POISON_MAX) {
        memcpy(POISON_NM[NPOISON], nm, k);
        POISON_NM[NPOISON][k] = 0;
        NPOISON++;
    }
}

static int poison_find(const char *nm, u32 k)
{
    int i = 0;

    for (i = 0; i < NPOISON; i++)
        if (strlen(POISON_NM[i]) == k && memcmp(POISON_NM[i], nm, k) == 0)
            return 1;
    return 0;
}

/* enum：常量塞进符号表（SC_ENUMC），类型按 int（C 的整数提升一致） */
static u32 parse_enum_spec(void)
{
    PA_SAW_ENUM = 1;
    u32 val = 0;
    char etag[200] = {0};
    u32 etaglen = 0;
    int has_tag = 0;
    /* 模块里的 `enum Error` 就是它的错误码表：成员值要落进本模块的号段
     * `(area << 27) | (slot << 12) | code`（docs/modules.md M5）。 */
    u32 ebase = 0;

    if (pa_cur()->kind == TK_IDENT && !pa_is_ch('{')) {
        /* 标签名：登记到标签表，这样裸 tag 也能当类型用（`Color c;`）。
         * 枚举在 c6c 里就是 int，不做范围检查。 */
        if (!sym_find_tag(tok_data(pa_cur()), pa_cur()->len)) {
            Sym *te = sym_add_tag(tok_data(pa_cur()), pa_cur()->len, ty_int());

            te->val = (i64)ty_int();
        }
        /* c6 里 `enum Color {…}` 同时给出类型名 `Color`（和 struct 一样），
         * 否则 `Color c = BLUE;` / `(Color)GREEN` 会报"未声明的标识符" */
        c6_auto_typedef(tok_data(pa_cur()), pa_cur()->len, ty_int());
        /* 记下标签名：普通形式的 `enum Color { GREEN }` 也要能查限定名
         * `Color.GREEN`（明文写 `Color.GREEN` 定义的那条路本来就会登记）。 */
        if (pa_cur()->len < sizeof(etag)) {
            memcpy(etag, tok_data(pa_cur()), pa_cur()->len);
            etaglen = pa_cur()->len;
            has_tag = 1;
        }
        pa_advance();
    }
    if (has_tag && etaglen == 5 && memcmp(etag, "Error", 5) == 0 && CUR_FILE)
        ebase = mod_err_base(mod_of_file((u32)CUR_FILE->id));
    if (!pa_accept_ch('{'))
        return ty_int();
    while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF) {
        Tok *t = pa_cur();
        char nm[256] = {0};
        u32 k = 0;
        Sym *s = NULL;

        if (t->kind != TK_IDENT) {
            pa_error("枚举常量名缺失");
            break;
        }
        k = t->len < 200 ? t->len : 200;
        memcpy(nm, tok_data(t), k);
        pa_advance();
        /* c6 的限定成员名 `Color.RED`：常量同时按 "Color.RED" 登记，
         * 这样两个枚举可以有同名的成员（C 的裸名会撞车）。 */
        if (pa_is_ch('.') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
            && pa_peek(1)->len + k + 1 < sizeof(nm)) {
            char bare[256] = {0};
            u32 bk = 0;
            Tok *bt = pa_peek(1);

            bk = bt->len < 200 ? bt->len : 200;
            memcpy(bare, tok_data(bt), bk);
            /* 限定名只能用自己的 tag，匿名枚举根本没有 tag 可写 */
            if (!has_tag)
                pa_error("the enumerator of an anonymous enum cannot be qualified");
            else if (k != etaglen || memcmp(nm, etag, k) != 0)
                pa_error("enumerator qualifier '%.*s' must be the enum's own tag '%.*s'",
                         (int)k, nm, (int)etaglen, etag);
            nm[k] = '.';
            memcpy(nm + k + 1, bare, bk);
            k = k + 1 + bk;
            pa_advance();
            pa_advance();
            if (pa_accept_ch('='))
                val = (u32)(i32)const_expr();
            s = sym_add(nm, k, ty_int(), SC_ENUMC);
            s->val = (i64)(val ? (val | ebase) : 0u);
            {
                /* 裸名也登记一份；已经存在就不覆盖，改成"毒化"——两个枚举
                 * 都有这个成员名，裸用就是歧义。 */
                Sym *bs = sym_find(bare, bt->len);

                if (!bs) {
                    bs = sym_add(bare, bt->len, ty_int(), SC_ENUMC);
                    bs->val = (i64)(val ? (val | ebase) : 0u);
                } else if ((u32)bs->val != (val ? (val | ebase) : 0u)) {
                    /* 同名但值不同：两个枚举真的都有这个成员 */
                    poison_add(bare, bt->len);
                }
            }
            val++;
            if (!pa_accept_ch(','))
                break;
            continue;
        }
        if (pa_accept_ch('='))
            val = (u32)(i32)const_expr();
        /* 模块的错误码表：成员值会加在号段的低 12 位上，超出 12 位会撞进
         * 邻居的号段（docs/modules.md M5 / tests/errors/err_code.c6）。 */
        if (ebase && ((i32)val < 0 || val > 4095))
            pa_error("error code of '%s' is not in 0..4095", nm);
        /* 都不带限定符时，两个枚举里的同名成员仍然是 C 的重定义。模块文件是
         * 文本内联的（同一个文件被 import 两次就会解析两遍），那种重复登记的
         * 值完全一样，不算重定义。 */
        if (etaglen && !ebase) {
            Sym *ex4 = sym_find(nm, k);

            if (ex4 && ex4->kind == SC_ENUMC
                && (u32)ex4->val != (val ? (val | ebase) : 0u))
                pa_error("redeclaration of '%s'", nm);
        }
        s = sym_add(nm, k, ty_int(), SC_ENUMC);
        s->val = (i64)(val ? (val | ebase) : 0u);
        /* 有标签就再登记一份限定名 `Tag.名字`（`enum Color { GREEN }` 之后
         * 也能写 `Color.GREEN`）；同名已存在就不覆盖。 */
        if (etaglen && etaglen + k + 2 < sizeof(nm)) {
            char qn[256] = {0};
            u32 qk = etaglen;

            memcpy(qn, etag, etaglen);
            qn[qk++] = '.';
            memcpy(qn + qk, nm, k);
            qk += k;
            if (!sym_find(qn, qk)) {
                Sym *qs = sym_add(qn, qk, ty_int(), SC_ENUMC);

                qs->val = (i64)(val ? (val | ebase) : 0u);
            }
        }
        val++;
        if (!pa_accept_ch(','))
            break;
    }
    pa_expect_ch('}');
    if (has_tag)
        HAS_ENUM_TAG = 1;
    return ty_int();
}

/* typeof(expr) / __typeof__(type)：类型取自表达式（不求值） */
static u32 parse_typeof(void)
{
    u32 ty = 0;

    pa_advance();
    skip_attributes();
    pa_expect_ch('(');
    if (is_typename_tok(pa_cur())) {
        ty = parse_typename();
    } else {
        u32 save = FN.n;

        NO_DECAY = 1;           /* 函数指示符不能退化，typeof 要函数类型本身 */
        /* typeof 里是**完整表达式**，不是一元表达式：`typeof(1?f:f)`、
         * `typeof((a,b))` 都是合法写法（tcc tests2 的 33_ternary_op 靠这个）。 */
        (void)gen_expr();
        NO_DECAY = 0;
        ty = cur_op_ty();
        FN.n = save;
        PEND_LVAL = 0;
    }
    pa_expect_ch(')');
    return ty;
}

/* 块作用域里才允许 VLA：函数形参表里 `char a[n]` 是指针，不是新分配 */
static int PA_VLA_OK;

/* `[` 到这里为止是不是 VLA：括号里出现局部变量/形参就是运行期长度。
 * 常量表达式里不可能有局部变量，所以这个判断不会把常量数组误判成 VLA。
 * `sizeof(x)` 里出现局部变量是唯一的反例——它会按 VLA 处理，分配同样大小，
 * 语义仍然对，只是 `sizeof` 会退化成指针宽度。 */
static int pa_bracket_is_vla(void)
{
    int i = 0;
    /* 调用点已经吃掉了 `[`，所以一开始就在里面（depth = 1） */
    int depth = 1;

    for (i = 0; i < 64; i++) {
        Tok *t = pa_peek(i);

        if (!t || t->kind == TK_EOF)
            return 0;
        if (t->kind == TK_PUNCT) {
            if (TOK_EQ(t, "[")) {
                depth++;
            } else if (TOK_EQ(t, "]")) {
                depth--;
                if (depth == 0)
                    return 0;
            } else if (TOK_EQ(t, ";") || TOK_EQ(t, "{") || TOK_EQ(t, "}")) {
                return 0;
            }
            continue;
        }
        if (t->kind != TK_IDENT || depth != 1)
            continue;
        if (TOK_EQ(t, "sizeof") || TOK_EQ(t, "alignof")
            || TOK_EQ(t, "_Alignof") || TOK_EQ(t, "__alignof__")) {
            /* 跳过 sizeof(...)：括号里的局部变量是合法的常量表达式 */
            Tok *n1 = pa_peek(i + 1);

            if (n1 && n1->kind == TK_PUNCT && tok_eq(n1, "(")) {
                int k = i + 1;
                int d2 = 0;

                for (; k < 200; k++) {
                    Tok *tk = pa_peek(k);

                    if (!tk || tk->kind == TK_EOF)
                        return 0;
                    if (tk->kind == TK_PUNCT && tok_eq(tk, "("))
                        d2++;
                    else if (tk->kind == TK_PUNCT && tok_eq(tk, ")")) {
                        d2--;
                        if (d2 == 0)
                            break;
                    }
                }
                i = k;
            }
            continue;
        }
        if (is_typename_tok(t))
            continue;
        {
            Sym *v = sym_find(tok_data(t), t->len);

            /* c6 的枚举限定名 `Color.RED` 也是常量：两段拼起来再查一次 */
            if (!v) {
                Tok *n2 = pa_peek(i + 1);
                Tok *n3 = pa_peek(i + 2);

                if (n2 && n2->kind == TK_PUNCT && TOK_EQ(n2, ".") && n3
                    && n3->kind == TK_IDENT && t->len + n3->len + 2 < 256) {
                    char qn[256] = {0};
                    u32 qk = t->len;

                    memcpy(qn, tok_data(t), qk);
                    qn[qk++] = '.';
                    memcpy(qn + qk, tok_data(n3), n3->len);
                    qk += n3->len;
                    v = sym_find(qn, qk);
                }
            }
            /* 只有枚举常量和常量全局量能出现在常量表达式里，其余都是运行期长度 */
            if (!v || v->is_func || (v->kind != SC_ENUMC && v->kind != SC_GLOBAL))
                return 1;
        }
    }
    return 0;
}

/* 类型说明符（含指针） */
static u32 parse_closure_type(void)
{
    u32 rty = 0;
    u32 pts[TY_PARAM_MAX] = {0};
    u32 np = 0;

    pa_advance();                        /* closure */
    rty = parse_typespec();
    while (pa_accept_ch('*'))
        rty = ty_ptr(rty);
    int variadic = 0;

    pa_expect_ch('(');
    while (np < TY_PARAM_MAX && !pa_is_ch(')') && pa_cur()->kind != TK_EOF) {
        u32 pt = 0;

        /* `closure int(int, ...)`：省略号表示变参（词法上是**一个** token） */
        if (pa_is_punct("...")) {
            pa_advance();
            variadic = 1;
            break;
        }
        pt = parse_typespec();
        while (pa_accept_ch('*'))
            pt = ty_ptr(pt);
        /* 形参名可以写（只做提示，不进类型） */
        if (pa_cur()->kind == TK_IDENT)
            pa_advance();
        pts[np++] = pt;
        if (!pa_accept_ch(','))
            break;
    }
    pa_expect_ch(')');
    return ty_closure(ty_func(rty, pts, np, variadic));
}

static u32 parse_typespec(void)
{
    u32 base = 0;
    int nlong = 0;
    int nshort = 0;
    int uns = 0;
    /* 已经出现过基础类型关键字（int/long/short/unsigned…）。有了它，后面再
     * 出现同名 typedef 就是**声明符的名字**，不是又一个类型说明符——
     * `int byte = 3;` 曾经被解析成"类型 byte、名叫 3"，于是参数/局部变量
     * 想遮蔽同名 typedef 全都报错。 */
    int saw_int = 0;
    /* 说明符里出现的 const/volatile/restrict 掩码。c6c 里限定符对多数类型只是
     * 标记（对象的只读性走 Sym.is_const），但**数组**上的限定符必须落到元素上
     * （C11 6.7.3p9）——`typedef int *restrict rp; typedef restrict int *arr[2];`
     * 里 restrict 归元素，`rp[2]` 才能和它同 id（tests2/100_c99array-decls）。 */
    u8 qm = 0;

    /* typeof(expr) / __typeof__(type)：类型取自表达式（不求值） */
    if (PA_IS_IDENT("typeof") || PA_IS_IDENT("__typeof__") || PA_IS_IDENT("__typeof"))
        return parse_typeof();
    /* `closure RET(params)`：闭包类型，单字（指向 {代码指针, 捕获…} 的堆对象） */
    if (c6_kw() && PA_IS_IDENT("closure"))
        return parse_closure_type();
    /* `thread` 是**软**关键字：`thread h = spawn f();` 里是类型，
     * `static int thread = 1;` 里就是普通标识符（tests/errors/thread_handle.c6
     * 的正常路径要求这一点）。判据：后面紧跟一个标识符。 */
    if (pa_cur()->kind == TK_IDENT && tok_data(pa_cur())[0] == 't'
        && (PA_IS_IDENT("thread") || PA_IS_IDENT("task"))
        && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
        /* `task` 是 async 句柄（wait/done/kind/val），`thread` 是线程句柄
         * （join/done/value）。两者都是单字，但方法不同，所以类型也分开。 */
        PA_TASK_KW = PA_IS_IDENT("task") ? 1 : 2;
        pa_advance();
        return PA_TASK_KW == 1 ? ty_task() : ty_thread();
    }
    /* 声明位置上的 _Alignas(...) 直接忽略 */
    while (PA_IS_IDENT("_Alignas") || PA_IS_IDENT("alignas")) {
        pa_advance();
        if (pa_is_ch('('))
            skip_paren_group();
    }
    int nsigned = 0;

    /* 元组类型 `(T1, T2, …)`：写在类型位置、以 `(` 开头、里面有逗号。
     * 只有一个元素时 `(T)` 就是 T（括号而已）。 */
    if (pa_is_ch('(') && !PA_TYPE_ATOM) {
        u32 tys[TUPLE_MAXN] = {0};
        u32 tn = 0;

        pa_advance();
        /* `error` 不是一等类型：`(int, error)` 这里要直接点出来，否则它会被
         * 当成"隐式 int 的元素名"悄悄放过（tests/errors/tuple.c6）。 */
        if (PA_IS_IDENT("error"))
            pa_error("'error' can only be a return type, not a tuple element");
        tys[tn++] = parse_typename();
        if (pa_is_ch(',')) {
            while (tn < TUPLE_MAXN && pa_accept_ch(',')) {
                if (PA_IS_IDENT("error"))
                    pa_error("'error' can only be a return type, not a tuple element");
                tys[tn++] = parse_typename();
            }
            pa_expect_ch(')');
            /* 元组作 `!error` 返回类型：`(int, int)!error f()` */
            if (pa_is_ch('!') && pa_peek(1)->kind == TK_IDENT) {
                PA_FALLIBLE = 1;
                pa_advance();
                pa_advance();
            }
            return ty_tuple_chk(tys, tn);
        }
        pa_expect_ch(')');
        return tys[0];
    }
    /* 托管引用 `@T`：表示上和 `T *` 一样（对象头 + 引用计数还没做，
     * 见 docs/manual/gc.md 与 todo 的 P6-6）。`shared`/`weak`/`own` 是
     * 所有权修饰符，先按普通强引用处理。 */
    while (c6_kw()
           && (PA_IS_IDENT("shared") || PA_IS_IDENT("weak") || PA_IS_IDENT("own"))) {
        if (PA_IS_IDENT("weak"))
            PA_MGD_KIND = 1;
        else if (PA_IS_IDENT("own"))
            PA_MGD_KIND = 2;
        else
            PA_MGD_SHARED = 1;
        pa_advance();
    }
    if (pa_is_ch('@')) {
        u32 it = 0;
        int save_at = PA_TYPE_ATOM;

        pa_advance();
        PA_TYPE_ATOM = 0;
        it = parse_typespec();
        PA_TYPE_ATOM = save_at;
        /* 闭包本身就是一个托管引用（单字，堆上的 {代码, 环境}），外面再套
         * 一层 `@` 没有意义（tests/errors/closure_signature.c6）。 */
        if (ty_is_closure(it, NULL) && in_c6_tu())
            pa_error("'@' cannot be applied to a closure type: a closure is already "
                     "a managed reference");
        PA_MGD_PTR++;
        return it;
    }
    for (;;) {
        if (PA_ACCEPT_IDENT("unsigned")) { uns = 1; saw_int = 1; continue; }
        if (PA_ACCEPT_IDENT("signed")) { nsigned = 1; saw_int = 1; continue; }
        if (PA_ACCEPT_IDENT("long")) { nlong++; saw_int = 1; continue; }
        if (PA_ACCEPT_IDENT("short")) { nshort++; saw_int = 1; continue; }
        if (PA_IS_IDENT("typeof") || PA_IS_IDENT("__typeof__")
            || PA_IS_IDENT("__typeof")) {
            base = parse_typeof();
            continue;
        }
        /* c6 错误通道返回类型：`T!error`。完整语义（错误值是个带 id 的载荷、
         * catch 绑定）还没做，这里先按 `T` 解析，返回 err(id,msg) 就是那个 id。 */
        if (pa_is_ch('!') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
            if (base && ty_is_array(base))
                pa_error("'!error' 不支持数组返回类型");
            PA_FALLIBLE = 1;
            pa_advance();
            pa_advance();
            continue;
        }
        /* c6 切片类型：`T[:]`（写在类型位置，名字在后面：`int[:] s`）。
         * 不看 PA_TYPE_ATOM：类型位置上的 `[` 只可能是切片后缀，而函数字面量
         * 解析返回类型时正是 PA_TYPE_ATOM 状态（`int[:](int[:] s) { … }`）。 */
        if (!PA_TMPL_ARG && pa_is_ch('[') && pa_peek(1)
            && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ":")) {
            pa_advance();
            pa_advance();
            pa_expect_ch(']');
            if (base == ty_void())
                pa_error("'[:]' 不能是 void 元素类型");
            base = ty_slice_chk(base ? base : ty_int());
            continue;
        }
        if (PA_ACCEPT_IDENT("struct")) { base = parse_agg_spec(0);
            continue; }
        if (PA_ACCEPT_IDENT("union")) { base = parse_agg_spec(1); continue; }
        if (PA_ACCEPT_IDENT("enum")) { base = parse_enum_spec(); continue; }
        if (PA_ACCEPT_IDENT("void")) { base = ty_void(); continue; }
        if (PA_ACCEPT_IDENT("_Bool")) { base = ty_bool(); continue; }
        if (PA_ACCEPT_IDENT("_Complex")) { continue; }   /* 复数：当实数处理 */
        if (PA_ACCEPT_IDENT("_Noreturn")) { continue; }
        if (PA_IS_IDENT("_Atomic") && pa_peek(1)->kind == TK_PUNCT
            && tok_eq(pa_peek(1), "(")) {
            pa_advance();
            pa_advance();
            base = parse_typename();
            pa_expect_ch(')');
            continue;
        }
        if (PA_ACCEPT_IDENT("_Atomic")) { continue; }    /* 限定符位置 */
        if (PA_ACCEPT_IDENT("int")) { saw_int = 1; continue; }
        if (PA_ACCEPT_IDENT("char")) { base = uns ? ty_uchar() : (nsigned ? ty_schar() : ty_char()); continue; }
        if (PA_ACCEPT_IDENT("float")) { base = ty_float(); continue; }
        if (PA_ACCEPT_IDENT("double")) { base = ty_double(); continue; }
        if (PA_IS_IDENT("__attribute__") || PA_IS_IDENT("__attribute")) {
            skip_attributes();
            continue;
        }
        if (PA_IS_IDENT("_Alignas") || PA_IS_IDENT("alignas")) {
            /* `int _Alignas(16) i2;`：对齐说明符可以出现在类型说明符中间 */
            pa_advance();
            if (pa_is_ch('('))
                skip_paren_group();
            continue;
        }
        if (PA_ACCEPT_IDENT("static")) { PA_STATIC = 1; continue; }
        /* 所有权修饰符也可能出现在 `static` 之后（`static weak @T g;`） */
        if (c6_kw()
            && (PA_IS_IDENT("weak") || PA_IS_IDENT("own") || PA_IS_IDENT("shared"))) {
            if (PA_IS_IDENT("weak"))
                PA_MGD_KIND = 1;
            else if (PA_IS_IDENT("own"))
                PA_MGD_KIND = 2;
            else
                PA_MGD_SHARED = 1;
            pa_advance();
            continue;
        }
        /* `static inline int f(…)`：c6c 不做内联，`inline` 只是个装饰——
         * 但和 `async` 撞在一起要报（协程不能被就地展开）。 */
        if (PA_ACCEPT_IDENT("inline") || PA_ACCEPT_IDENT("__inline")
            || PA_ACCEPT_IDENT("__inline__")) {
            PA_INLINE_SEEN = 1;
            continue;
        }
        /* `async T f(…)`：c6c 没有协程调度器，async 函数就是普通函数（和
         * rt.c6 里那组 __c6_co_* 桩一个口径）。这里只把 async 吃掉。 */
        /* `async (int, int) f()`：返回类型也可以是元组，所以后面跟 `(` 也算。 */
        if (PA_IS_IDENT("async") && c6_kw() && pa_peek(1)
            && (pa_peek(1)->kind == TK_IDENT
                || (pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")))) {
            pa_advance();
            PA_ASYNC = 1;
            /* `async (int, int) f(…)`：返回类型是元组。元组那条分支在说明符
             * 循环之前就判过了（那时当前还是 `async`），所以这里补一次。 */
            if (pa_is_ch('(')) {
                u32 tys[TUPLE_MAXN] = {0};
                u32 tn = 0;

                pa_advance();
                tys[tn++] = parse_typename();
                while (tn < TUPLE_MAXN && pa_accept_ch(','))
                    tys[tn++] = parse_typename();
                pa_expect_ch(')');
                if (pa_is_ch('!') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
                    PA_FALLIBLE = 1;
                    pa_advance();
                    pa_advance();
                }
                base = ty_tuple_chk(tys, tn);
            }
            continue;
        }
        /* `@T` / `weak @T` / `shared @T` / `own @T` 也能出现在**说明符循环里**
         * （`static @Node give(...)`）：c6c 里 `@T` 的表示就是 `T *`。 */
        if (pa_is_ch('@')) {
            u32 it2 = 0;
            int save_at2 = PA_TYPE_ATOM;

            pa_advance();
            PA_TYPE_ATOM = 0;
            it2 = parse_typespec();
            PA_TYPE_ATOM = save_at2;
            PA_MGD_PTR++;
            base = it2;
            continue;
        }
        if (pa_cur()->kind == TK_IDENT) {
            char c0 = tok_data(pa_cur())[0];

            if (c6_kw()
                && ((c0 == 'w' && PA_IS_IDENT("weak"))
                    || (c0 == 's' && PA_IS_IDENT("shared"))
                    || (c0 == 'o' && PA_IS_IDENT("own")))) {
                if (c0 == 's')
                    PA_MGD_SHARED = 1;
                pa_advance();
                continue;
            }
        }
        if (c6_kw() && PA_IS_IDENT("closure")) { base = parse_closure_type(); continue; }
        if (pa_cur()->kind == TK_IDENT && tok_data(pa_cur())[0] == 't'
            && PA_IS_IDENT("thread") && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
            base = ty_thread();
            pa_advance();
            continue;
        }
        if (PA_ACCEPT_IDENT("extern")) {
            PA_EXTERN = 1;
            continue;
        }
        /* `__thread` / `_Thread_local`：线程局部存储的说明符。以前这两个词
         * 只是躺在关键字表里没人处理，顶层靠"把 `__thread` 当成隐式 int 的
         * 声明符名字"侥幸编过去——位域/声明形状一变就报错，而且语义上它们
         * 完全被忽略（tests2/144_tls 就是这么挂的）。 */
        if (PA_ACCEPT_IDENT("__thread") || PA_ACCEPT_IDENT("_Thread_local")) {
            PA_TLS = 1;
            continue;
        }
        if (PA_ACCEPT_IDENT("const") || PA_ACCEPT_IDENT("__const")) {
            qm = (u8)(qm | TQ_CONST);
            SAW_TYPE_QUAL = 1;
            continue;
        }
        if (PA_ACCEPT_IDENT("volatile") || PA_ACCEPT_IDENT("__volatile__")) {
            qm = (u8)(qm | TQ_VOLATILE);
            SAW_TYPE_QUAL = 1;
            continue;
        }
        if (PA_ACCEPT_IDENT("register") || PA_ACCEPT_IDENT("inline") ||
            PA_ACCEPT_IDENT("auto") || PA_ACCEPT_IDENT("__extension__")) {
            SAW_TYPE_QUAL = 1;
            continue;
        }
        if (PA_ACCEPT_IDENT("restrict") || PA_ACCEPT_IDENT("__restrict")
            || PA_ACCEPT_IDENT("__restrict__")) {
            qm = (u8)(qm | TQ_RESTRICT);
            SAW_TYPE_QUAL = 1;
            continue;
        }
        /* `static (int, int) f(…)`：元组返回类型出现在说明符**之后**。
         * 元组那条分支在循环之前，那时当前还是 `static`，所以这里补一次。 */
        if (base == 0 && pa_at_tuple_type()) {
            u32 tys[TUPLE_MAXN] = {0};
            u32 tn = 0;

            pa_advance();
            tys[tn++] = parse_typename();
            while (tn < TUPLE_MAXN && pa_accept_ch(','))
                tys[tn++] = parse_typename();
            pa_expect_ch(')');
            if (pa_is_ch('!') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
                PA_FALLIBLE = 1;
                pa_advance();
                pa_advance();
            }
            base = ty_tuple_chk(tys, tn);
            continue;
        }

        break;
    }
    if (!base && !saw_int) {
        Tok *t = pa_cur();

        /* 模板实例可以直接写在类型位置：`Vect@int v;`（不带 `struct`） */
        if (t->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(1), "@")) {
            Tmpl *tp = tmpl_find(tok_data(t), t->len);

            if (tp && !tp->is_func) {
                u32 args[TMPL_NPARAM] = {0};
                int paren = 0;

                pa_advance();               /* 名字 */
                pa_advance();               /* @ */
                if (pa_is_ch('('))
                    paren = 1;
                (void)tmpl_parse_args(tp, args, paren);
                base = tmpl_inst(tp, args);
                /* 实例后面还可能跟切片后缀：`Vect@int[:] s = arr;` */
                while (!PA_TMPL_ARG && pa_is_ch('[') && pa_peek(1)->kind == TK_PUNCT
                       && TOK_EQ(pa_peek(1), ":")) {
                    pa_advance();
                    pa_advance();
                    pa_expect_ch(']');
                    if (base == ty_void())
                        pa_error("'[:]' 不能是 void 元素类型");
                    base = ty_slice_chk(base);
                }
                goto typespec_done;
            }
        }
        if (t->kind == TK_IDENT) {
            Sym *s = sym_find(tok_data(t), t->len);

            /* 模块限定的类型名 `tu.module.Point`：前缀是命名空间装饰，跳到
             * 最后一段（只在第一段不是 typedef 时才退）。 */
            if ((!s || s->kind != SC_TYPEDEF) && pa_peek(1)
                && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ".")) {
                u32 qk2 = 1;

                while (pa_peek(qk2) && pa_peek(qk2)->kind == TK_PUNCT
                       && TOK_EQ(pa_peek(qk2), ".") && pa_peek(qk2 + 1)
                       && pa_peek(qk2 + 1)->kind == TK_IDENT)
                    qk2 += 2;
                if (qk2 > 1) {
                    Tok *lt2 = pa_peek(qk2 - 1);
                    Sym *ls2 = sym_find(tok_data(lt2), lt2->len);
                    Sym *ltg2 = sym_find_tag(tok_data(lt2), lt2->len);

                    if ((ls2 && ls2->kind == SC_TYPEDEF) || ltg2) {
                        while (qk2 > 1) {
                            pa_advance();
                            qk2--;
                        }
                        t = pa_cur();
                        s = ls2;
                    }
                }
            }
            /* c6 允许裸 tag 当类型用：`struct Node { Node *next; }`、
             * `typedef Vec VecAlias;`——typedef 查不到就再查标签表。 */
            if (NIFACE > 0 && (!s || s->kind != SC_TYPEDEF)) {
                u32 ii = iface_find(tok_data(t), t->len);

                if (ii < IFACE_MAX) {
                    base = ty_iface(ii);
                    pa_advance();
                    goto typespec_done;
                }
            }
            if (!s || s->kind != SC_TYPEDEF) {
                Sym *tg = sym_find_tag(tok_data(t), t->len);

                if (tg && tg->val)
                    s = tg;
            }
            if (s && (s->kind == SC_TYPEDEF || s->kind == SC_TAG)) {
                base = (s->kind == SC_TYPEDEF) ? s->type : (u32)s->val;
                pa_advance();
                /* c6 的 `T!error` 后缀：typedef 名（`i64!error fs_size(...)`）
                 * 是在循环之后才认的，循环里那段 `!error` 处理走不到，
                 * 得在这里补一次，否则 `i64` 被当成声明符名字，报"顶层声明缺名字" */
                if (pa_is_ch('!') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
                    if (base && ty_is_array(base))
                        pa_error("'!error' 不支持数组返回类型");
                    PA_FALLIBLE = 1;
                    pa_advance();
                    pa_advance();
                }
                /* typedef 名后面也可能直接跟切片后缀：`Row[:] rows`（c6 允许
                 * 把 `[:]` 写在类型位置）。循环里那个检查走不到这里，因为
                 * typedef 名是在循环**之后**才认的。 */
                while (!PA_TMPL_ARG && pa_is_ch('[') && pa_peek(1)->kind == TK_PUNCT
                       && TOK_EQ(pa_peek(1), ":")) {
                    pa_advance();
                    pa_advance();
                    pa_expect_ch(']');
                    if (base == ty_void())
                        pa_error("'[:]' 不能是 void 元素类型");
                    base = ty_slice_chk(base);
                }
            }
        }
    }
    if (!base) {
        if (nlong >= 2)
            base = uns ? ty_ullong() : ty_llong();
        else if (nlong == 1)
            base = uns ? ty_ulong() : ty_long();
        else if (nshort)
            base = uns ? ty_ushort() : ty_short();
        else
            base = uns ? ty_uint() : ty_int();
    }
typespec_done:
    /* 后缀限定符：`Vec const *cq`、`int const volatile *p`。前缀的
     * const/volatile 在说明符循环里吃掉了，写在类型名**后面**的这一份
     * 以前没人管，`Vec const` 就被当成"声明符名字是 const"。
     * 语义上 qualifier 对 c6c 只是标记，吃掉即可。 */
    while (PA_IS_IDENT("const") || PA_IS_IDENT("volatile") || PA_IS_IDENT("restrict")
           || PA_IS_IDENT("__const") || PA_IS_IDENT("__volatile__")
           || PA_IS_IDENT("__restrict") || PA_IS_IDENT("__restrict__")) {
        if (PA_IS_IDENT("const") || PA_IS_IDENT("__const"))
            qm = (u8)(qm | TQ_CONST);
        else if (PA_IS_IDENT("volatile") || PA_IS_IDENT("__volatile__"))
            qm = (u8)(qm | TQ_VOLATILE);
        else
            qm = (u8)(qm | TQ_RESTRICT);
        pa_advance();
    }
    /* 数组上的限定符按 C11 6.7.3p9 落到元素上。别的类型不动：c6c 里
     * `const int` 仍然是 int（对象只读性走 Sym.is_const），只有数组这一条
     * 必须真的改类型 id（`typedef restrict int *arr[2]` 要和 `int *restrict [2]`
     * 同 id）。ty_qual 对数组正是往下推的。 */
    if (qm && base && ty_is_array(base))
        base = ty_qual(base, qm);
    /* 注意：`*` 归声明符管，不在这里吃。parse_typespec 是**每个声明语句**
     * 调一次的，而 `int *a, *b;` 里每个声明符都要自己再吃一遍 `*`——
     * 在这里吃会让第二个声明符多出一层指针。 */
    return base;
}

/* 声明符：指针/数组后缀已经在 parse_typespec 里吃了指针，这里只管名字与后缀 */
/* `__attribute__((…))` / `__asm__(…)` / `__extension__` 这类扩展：
 * 语法上要吃掉，语义上大多数可以忽略（glibc 和 tcc 的头里到处都是）。 */
static void skip_paren_group(void)
{
    int depth = 0;
    int n = 0;

    if (!pa_is_ch('('))
        return;
    do {
        Tok *t = pa_cur();

        if (t->kind == TK_EOF)
            return;
        if (t->kind == TK_PUNCT) {
            if (tok_eq(t, "("))
                depth++;
            else if (tok_eq(t, ")"))
                depth--;
        }
        pa_advance();
        n++;
    } while (depth > 0 && n < 100000);
}

/* `__attribute__((cleanup(fn)))`：作用域退出时调 fn(&变量) */
static const char *SAW_CLEANUP;
static u32 SAW_CLEANUP_LEN;

/* skip_attributes 里那一长串 `pa_is_ident(...)` 在每个声明上都要跑一遍，
 * 每次都是一次 memcmp。先用 token 哈希快筛（标识符的哈希词法层已经算好了），
 * 命中才做真正的文本比较。 */
static const char *const SA_KW[] = {
    "__attribute__", "__attribute", "__extension__", "__restrict", "__restrict__",
    "restrict", "__inline", "__inline__", "inline", "__signed__", "_Nonnull",
    "_Nullable", "__const", "__volatile__", "__asm__", "__asm", "asm", NULL
};
static u32 SA_HASH[17];
static int SA_INIT;

static int sa_is_kw(Tok *t)
{
    u32 i = 0;

    if (!t || t->kind != TK_IDENT)
        return 0;
    if (!SA_INIT) {
        for (i = 0; SA_KW[i]; i++)
            SA_HASH[i] = tok_hash(SA_KW[i], strlen(SA_KW[i]));
        SA_INIT = 1;
    }
    for (i = 0; SA_KW[i]; i++)
        if (SA_HASH[i] == t->hash && tok_eq(t, SA_KW[i]))
            return 1;
    return 0;
}

static void skip_attributes(void)
{
    int n = 0;

    if (!sa_is_kw(pa_cur()))
        return;

    for (;;) {
        if (PA_IS_IDENT("__attribute__") || PA_IS_IDENT("__attribute")) {
            u32 save = FN.n;
            Tok *t1 = pa_peek(1);
            int is_ctor = 0;

            pa_advance();
            /* 扫一遍属性名，看是不是 constructor / destructor */
            if (t1 && t1->kind == TK_PUNCT && tok_eq(t1, "(")) {
                int depth = 0;
                int guard = 0;

                for (;;) {
                    Tok *c = pa_cur();

                    if (!c || c->kind == TK_EOF || ++guard > 256)
                        break;
                    if (c->kind == TK_PUNCT && tok_eq(c, "(")) {
                        depth++;
                        pa_advance();
                        continue;
                    }
                    if (c->kind == TK_PUNCT && tok_eq(c, ")")) {
                        depth--;
                        pa_advance();
                        if (depth <= 0)
                            break;
                        continue;
                    }
                    if (c->kind == TK_IDENT && TOK_EQ(c, "constructor"))
                        is_ctor = 1;
                    if (c->kind == TK_IDENT
                        && (TOK_EQ(c, "cleanup") || TOK_EQ(c, "__cleanup__"))) {
                        Tok *nx = pa_peek(1);
                        Tok *ny = pa_peek(2);

                        if (nx && ny && nx->kind == TK_PUNCT && tok_eq(nx, "(")
                            && ny->kind == TK_IDENT) {
                            SAW_CLEANUP = arena_strndup(&A_main, tok_data(ny), ny->len);
                            SAW_CLEANUP_LEN = ny->len;
                        }
                    }
                    if (c->kind == TK_IDENT && TOK_EQ(c, "destructor"))
                        SAW_DTOR = 1;
                    /* `__attribute__((packed))`：布局按 pack(1) 走 */
                    if (c->kind == TK_IDENT && TOK_EQ(c, "packed"))
                        SAW_PACKED = 1;
                    /* `__attribute__((aligned(N)))` / `__declspec(align(N))` */
                    if (c->kind == TK_IDENT
                        && (TOK_EQ(c, "aligned") || TOK_EQ(c, "align"))) {
                        Tok *nx2 = pa_peek(1);
                        Tok *ny2 = pa_peek(2);

                        if (nx2 && ny2 && nx2->kind == TK_PUNCT && tok_eq(nx2, "(")
                            && ny2->kind == TK_NUM) {
                            char ab[24] = {0};
                            u32 ak = ny2->len < 20 ? ny2->len : 20;

                            memcpy(ab, tok_data(ny2), ak);
                            ab[ak] = 0;
                            SAW_ALIGN = (int)strtol(ab, NULL, 0);
                        }
                    }
                    pa_advance();
                }
            } else {
                skip_paren_group();
            }
            FN.n = save;
            if (is_ctor)
                SAW_CTOR = 1;
        } else if (PA_IS_IDENT("__extension__") || PA_IS_IDENT("__restrict")
                   || PA_IS_IDENT("__restrict__") || PA_IS_IDENT("restrict")
                   || PA_IS_IDENT("__inline") || PA_IS_IDENT("__inline__")
                   || PA_IS_IDENT("inline") || PA_IS_IDENT("__signed__")
                   || PA_IS_IDENT("_Nonnull") || PA_IS_IDENT("_Nullable")
                   || PA_IS_IDENT("__const") || PA_IS_IDENT("__volatile__")) {
            pa_advance();
        } else if (PA_IS_IDENT("__asm__") || PA_IS_IDENT("__asm") || PA_IS_IDENT("asm")) {
            pa_advance();
            skip_paren_group();
        } else {
            break;
        }
        if (++n > 64)
            break;
    }
}

static u32 parse_declarator(u32 base, Declarator *d);

/* 现在解析的是不是**形参**声明符：决定了 `[` 里的限定符往哪放。
 * 形参：C11 6.7.6.3p7「形参声明成数组时调整成**带限定符的指针**」——
 * 限定符归调整后的指针（`int ca[const 2]` → `int *const`，
 * tests2/149_parameter_qualifiers）。非形参：C11 6.7.3p9「数组上的限定符
 * 修饰的是元素」。 */
static int PA_IN_PARAMS;

static u32 parse_param_list(u32 fnret, Declarator *d)
{
    /* 一个声明符里可以有好几层参数表：
     *   `int (*f1(int a, int b))(int c, int b)`
     * 前一个是 f1 自己的，后一个属于**返回类型**那层函数类型。以前两层都往
     * d->nparams 尾巴上堆，于是这个定义被当成 4 个形参去绑帧，而且同名形参
     * （内层的 `b`）直接把外层 `b` 的槽位顶掉——`a != b` 读到的是垃圾，
     * 返回的函数指针一调就段错误（c-testsuite single-exec/00124）。
     *
     * 现在每层只认自己那一段 d->ptype[base_n ..]；只有"标识符自己那层"
     * （这个声明符里**第一个**解析到的参数表）的参数留在 d 上，因为
     * pa_func_def 要靠它绑帧。 */
    u32 base_n = d->nparams;
    int own_layer = d->own_params_taken ? 0 : 1;
    int save_knr = d->knr;
    int save_variadic = d->variadic;
    u32 r = 0;

    d->own_params_taken = 1;
    /* 声明符对象可能被复用，`...` 的标记不能从上一个声明符漏进来 */
    d->variadic = 0;
    /* 先嗅一下是不是旧式（K&R）参数表：真正的原型一定以类型名开头，
     * 而以裸标识符开头的只能是 `int f(a, b)` 这种。 */
    if (pa_cur()->kind == TK_IDENT && !is_typename_tok(pa_cur()))
        d->knr = 1;
    if (pa_accept_ch(')')) {
        r = ty_func(fnret, d->ptype + base_n, 0, 0);
        goto fin;
    }
    if (PA_IS_IDENT("void") && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), ")")) {
        pa_advance();
        pa_advance();
        r = ty_func(fnret, d->ptype + base_n, 0, 0);
        goto fin;
    }
    for (;;) {
        Declarator pd = {0};
        u32 pt = 0;
        int save_inparams = PA_IN_PARAMS;

        skip_attributes();
        if (d->nparams >= PA_ARG_MAX) {
            pa_error("形参太多（上限 64）");
            skip_paren_group();
            r = ty_func(fnret, d->ptype + base_n, d->nparams - base_n, (u32)d->variadic);
            goto fin;
        }
        pt = parse_typespec();
        if (!pt)
            d->knr = 1;         /* 裸标识符形参：旧式（K&R）参数表 */
        PA_IN_PARAMS = 1;
        pt = parse_declarator(pt, &pd);
        PA_IN_PARAMS = save_inparams;
        if (ty_is_array(pt)) {
            /* 形参里的数组按指针传；`[` 里的限定符贴到这个指针上
             * （C11 6.7.6.3p7：`int ca[const 2]` 的形参类型是 `int *const`） */
            pt = ty_ptr(ty_target(pt));
            if (pd.arrqual)
                pt = ty_qual(pt, pd.arrqual);
        } else if (pd.arrqual) {
            pt = ty_qual(pt, pd.arrqual);
        }
        d->ptype[d->nparams] = pt;
        d->pmgd[d->nparams] = (u8)(pd.mgd ? (pd.mgd_kind == 1 ? 2 : 1) : 0);
        d->pshared[d->nparams] = pd.mgd_shared;
        d->pconst[d->nparams] = pd.obj_const;
        if (pd.name) {
            d->pname[d->nparams] = pd.name;
            d->plen[d->nparams] = pd.nlen;
        }
        if (pa_accept_punct("...")) {
            d->variadic = 1;   /* 省略号不是形参：不进 nparams */
            break;
        }
        d->nparams++;
        if (!pa_accept_ch(','))
            break;
    }
    pa_expect_ch(')');
    r = ty_func(fnret, d->ptype + base_n, d->nparams - base_n, (u32)d->variadic);
fin:
    if (!own_layer) {
        /* 不是自己那层：用完就退回，别把返回类型/形参类型里的形参名字
         * 混进这个函数定义的形参表里。 */
        d->nparams = base_n;
        d->knr = (u8)save_knr;
        d->variadic = save_variadic;
    }
    return r;
}

/* 后缀套在最里层的类型上（C 声明符的就近绑定规则）：
 * 普通情况 `int *f(int)`：后缀直接套在 int* 上 → 返回 int* 的函数；
 * 嵌套情况 `int (*f)(int)`：跳过指针套在 int 上 → 指向"返回 int 的函数"的指针。 */
static u32 decl_apply_suffix(u32 ty, Declarator *d, int at_target)
{
    u32 nptr = 0;
    u32 t = ty;
    u32 i = 0;

    if (at_target) {
        while (ty_is_ptr(t)) {
            nptr++;
            t = ty_target(t);
        }
    }
    /* 数组维度要**从右往左**套：`int a[2][3]` 是「2 个 int[3]」，不是
     * 「3 个 int[2]」。一边扫一边套就正好反了（`sizeof a[0]` 会给出 8 而不是
     * 12，推断长度的 `int a[][3]` 更是直接变成 0 长度）。所以先攒起来。 */
    {
        u32 dims[16] = {0};
        int nd = 0;

    while (pa_is_ch('(') || pa_is_ch('[')) {
        if (pa_is_ch('[')) {
            u32 cnt = 0;
            u8 bq = 0;

            pa_advance();
            if (pa_is_ch(':')) {
                /* c6 切片：`T[:]` */
                pa_advance();
                pa_expect_ch(']');
                while (nd > 0)
                    t = ty_array(t, dims[--nd]);
                t = ty_slice_chk(t);
                skip_attributes();
                continue;
            }
            /* C99 数组形参：`int x[const 5]`、`int x[static 5]`、`int x[volatile 5]` */
            while (PA_IS_IDENT("const") || PA_IS_IDENT("volatile") || PA_IS_IDENT("restrict")
                   || PA_IS_IDENT("static") || PA_IS_IDENT("__restrict")
                   || PA_IS_IDENT("__restrict__")
                   || PA_IS_IDENT("__const") || PA_IS_IDENT("__volatile__")) {
                if (PA_IS_IDENT("const") || PA_IS_IDENT("__const"))
                    bq = (u8)(bq | TQ_CONST);
                else if (PA_IS_IDENT("volatile") || PA_IS_IDENT("__volatile__"))
                    bq = (u8)(bq | TQ_VOLATILE);
                else if (PA_IS_IDENT("restrict") || PA_IS_IDENT("__restrict")
                         || PA_IS_IDENT("__restrict__"))
                    bq = (u8)(bq | TQ_RESTRICT);
                pa_advance();
            }
            if (bq && d) {
                if (PA_IN_PARAMS) {
                    /* 形参：留给 parse_param_list 在数组退化时贴到指针上 */
                    d->arrqual = (u8)(d->arrqual | bq);
                } else {
                    /* 非形参：下推到元素（`int a[const 5]` 是 5 个 const int） */
                    t = ty_qual(t, bq);
                }
            }
            if (pa_is_ch(']')) {
                cnt = 0;
            } else if (pa_is_ch('*')) {
                /* `int x[const *]`：C99 的"未指定大小的 VLA 形参"，* 是占位符 */
                pa_advance();
                cnt = 0;
            } else if (PA_VLA_OK && d && pa_bracket_is_vla()) {
                /* C99 VLA：`char acc[maxlen];`。类型降成元素指针，存储由
                 * IR_ALLOCA 在运行期按 rsp 现开；`&acc` 指向栈上那块。 */
                u32 n = value_of(gen_assign());

                d->vla = 1;
                d->vla_cnt = n;
                d->vla_esz = ty_size(t) ? ty_size(t) : 1;
                pa_expect_ch(']');
                while (nd > 0)
                    t = ty_array(t, dims[--nd]);
                t = ty_ptr(t);
                skip_attributes();
                continue;
            } else {
                cnt = (u32)const_expr();
            }
            pa_expect_ch(']');
            if (nd < 16) {
                dims[nd++] = cnt;
            } else {
                t = ty_array(t, cnt);
            }
        } else {
            /* 函数后缀前面攒下的数组维度要先按逆序套上 */
            while (nd > 0)
                t = ty_array(t, dims[--nd]);
            pa_advance();
            t = parse_param_list(t, d);
        }
        skip_attributes();
    }
    while (nd > 0)
        t = ty_array(t, dims[--nd]);
    }
    for (i = 0; i < nptr; i++)
        t = ty_ptr(t);
    /* `int f(int n)!error;`：错误标记也可以写在声明符（参数表）之后 */
    if (pa_is_ch('!') && pa_peek(1)->kind == TK_IDENT) {
        PA_FALLIBLE = 1;
        pa_advance();
        pa_advance();
    }
    return t;
}

/* 内层声明符解出来的类型里，原始 base 藏在某一串 ptr/array/func 壳的最里面
 * （那个位置就是“洞”）。把外层的指针和外层后缀填进去：从洞里往外重建。 */
#define DH_MAX 24
static u32 decl_fill_hole(u32 ty, u32 nptr, Declarator *d, const u8 *pq)
{
    u8 kind[DH_MAX] = {0};
    u32 num[DH_MAX] = {0};
    u32 keep[DH_MAX] = {0};
    u32 dep = 0;
    u32 t = ty;
    u32 i = 0;

    memset(kind, 0, sizeof(kind));
    memset(num, 0, sizeof(num));
    memset(keep, 0, sizeof(keep));
    while (dep < DH_MAX) {
        if (ty_is_ptr(t)) {
            kind[dep] = 0;
            keep[dep] = t;
            dep++;
            t = ty_target(t);
        } else if (ty_is_array(t)) {
            kind[dep] = 1;
            num[dep] = ty_array_n(t);
            keep[dep] = t;
            dep++;
            t = ty_target(t);
        } else if (ty_is_func(t)) {
            /* 洞在返回类型里（`int (*(*f)(void))(void)`） */
            kind[dep] = 2;
            keep[dep] = t;
            dep++;
            t = ty_func_ret(t);
        } else {
            break;
        }
    }
    for (i = 0; i < nptr; i++)
        t = ty_ptr_q(t, pq ? pq[i] : 0);
    t = decl_apply_suffix(t, d, 0);
    for (i = dep; i > 0; i--) {
        if (kind[i - 1] == 0) {
            /* 内层那层指针自己带的限定符（`int (* const f)(void)` 的 const）
             * 在 keep[] 里，套回去的时候要带上 */
            t = ty_ptr_q(t, TY_AT(keep[i - 1])->qual);
        } else if (kind[i - 1] == 1) {
            t = ty_array(t, num[i - 1]);
        } else {
            u32 prm[TY_PARAM_MAX] = {0};
            u32 n = ty_func_nparams(keep[i - 1]);
            u32 k = 0;
            u32 fid = keep[i - 1];

            if (n > TY_PARAM_MAX)
                n = TY_PARAM_MAX;
            for (k = 0; k < n; k++)
                prm[k] = ty_func_param(fid, k);
            t = ty_func(t, prm, n, ty_func_variadic(fid));
        }
    }
    return t;
}

/* 一个声明符里最多记多少层指针的限定符（超出就不记，只丢限定符不炸） */
#define PQ_MAX DH_MAX

static u32 parse_declarator(u32 base, Declarator *d)
{
    u32 ty = base;
    u32 nptr = 0;
    u32 i = 0;
    /* 每层指针的限定符掩码，按**扫描顺序**存（第 0 个就是最先读到的那层，
     * 也就是最里面、最先套到 base 上的那层）。决定类型 id 的那一份。 */
    u8 pq[PQ_MAX] = {0};

    memset(d, 0, sizeof(*d));
    d->type = base;
    if (PA_MGD_PTR) {                /* `@T` 的那层指针 */
        nptr += (u32)PA_MGD_PTR;
        PA_MGD_PTR = 0;
        d->mgd = 1;
        d->mgd_kind = (u8)PA_MGD_KIND;
        d->mgd_shared = (u8)PA_MGD_SHARED;
        PA_MGD_KIND = 0;
        PA_MGD_SHARED = 0;
    }
    skip_attributes();
    while (pa_accept_ch('*')) {
        /* 指针限定符可以叠加、重复：`int *restrict`、`const char * const *`…
         * （tcc 自己的源码里满是 `*restrict`）
         *
         * 只有**最外层**那层指针（token 里最后一个 `*`，也就是最后套到对象上的
         * 那层）的 const 才让被声明的对象本身只读：`int *const p` 的 p 不能
         * 赋值，`const int *p` 的 p 可以。所以每进一层指针就重置一次标记，
         * 循环结束时留下的是最外层的。tests2/149_parameter_qualifier_errors.c。 */
        d->obj_const = 0;
        {
            u8 q = 0;

            while (PA_IS_IDENT("const") || PA_IS_IDENT("volatile") || PA_IS_IDENT("restrict")
                   || PA_IS_IDENT("__restrict") || PA_IS_IDENT("__restrict__")
                   || PA_IS_IDENT("__const") || PA_IS_IDENT("__volatile__")) {
                if (PA_IS_IDENT("const") || PA_IS_IDENT("__const")) {
                    d->obj_const = 1;
                    q = (u8)(q | TQ_CONST);
                } else if (PA_IS_IDENT("volatile") || PA_IS_IDENT("__volatile__")) {
                    q = (u8)(q | TQ_VOLATILE);
                } else {
                    q = (u8)(q | TQ_RESTRICT);
                }
                pa_advance();
            }
            if (nptr < PQ_MAX)
                pq[nptr] = q;
        }
        nptr++;
        skip_attributes();
    }
    if (pa_is_ch('(') && pa_peek(1)->kind == TK_PUNCT
        && (TOK_EQ(pa_peek(1), "*") || tok_eq(pa_peek(1), "("))) {
        /* 嵌套声明符 (*name)(…)：括号里的 `*` 比外面的后缀更"紧"，
         * 而**外层**的指针反而套在最里面（贴着 base）。
         *
         *     int *(*f)(void);      f = 指向「返回 int* 的函数」的指针
         *     int (*q[4])(void);    q = 4 个「指向函数的指针」的数组
         *
         * 所以先把内层声明符按原 base 解出来（得到一个「在某个位置留了
         * 洞」的类型），再把外层的指针 + 外层后缀填进那个洞。 */
        u32 inner = 0;

        pa_advance();                 /* ( */
        inner = parse_declarator(base, d);
        pa_expect_ch(')');
        d->type = decl_fill_hole(inner, nptr, d, pq);
        d->is_func = ty_is_func(d->type);
        return d->type;
    }
    if (pa_cur()->kind == TK_IDENT && !PA_NO_NAME && cm_at_call(CM_ROLE_IDENT)) {
        /* `int cat(ab, cd) = 7;`：`ident` 宏当场拼成一个标识符 */
        u32 il = 0;
        const char *in2 = cm_ident_name(&il);

        if (in2) {
            d->name = in2;
            d->nlen = il;
        }
    }
    if (pa_cur()->kind == TK_IDENT && !PA_NO_NAME) {
        d->name = tok_data(pa_cur());
        d->nlen = pa_cur()->len;
        pa_advance();
    }
    ty = base;
    for (i = 0; i < nptr; i++)
        ty = ty_ptr_q(ty, i < PQ_MAX ? pq[i] : 0);
    skip_attributes();
    /* 普通声明符：后缀套在**整个**类型上（`int *f(int)` = 返回指针的函数）；
     * 只有嵌套声明符 `(*f)(…)` 才套到指针目标上。 */
    d->type = decl_apply_suffix(ty, d, 0);
    d->is_func = ty_is_func(d->type);
    return d->type;
}

/* --- 表达式 --- */

/* 流式求值只需要“最近一个值的类型”，不留表达式树（design.md §4）。
 *
 * 左值用**推迟取值**表示：gen_postfix 只把地址算进 vreg 并置 PEND_LVAL，
 * 真正需要值的一方（运算符 / return / 条件）调 value_of() 才发 LOAD。
 * 好处：`x = 1` 不会白读一次 x，也不需要“先看后面是不是 '='”的前瞻
 * （前瞻窗口只有 4 个 token，`a[i][j] = ...` 根本不够看）。 */
static u32 gen_expr(void);
static u32 gen_assign(void);
static u32 gen_cond(void);
static u32 gen_unary(void);
static u32 goto_label(const char *nm, u32 len);
/* 是不是浮点字面量：十进制里出现 '.' 或指数 e/E；十六进制里出现 'p/P' 或 '.' */
static int is_float_lit(const char *s, u32 n)
{
    int hex = 0;
    u32 i = 0;

    if (n > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
        hex = 1;
    for (i = 0; i < n; i++) {
        if (s[i] == '.')
            return 1;
        if (hex) {
            if (s[i] == 'p' || s[i] == 'P')
                return 1;
        } else if (s[i] == 'e' || s[i] == 'E') {
            return 1;
        }
    }
    return 0;
}

/* 10 的整数次幂（0..19 在 u64 里装得下，转 double 时都是精确值） */
static const u64 POW10_I[20] = {
    1ULL, 10ULL, 100ULL, 1000ULL, 10000ULL, 100000ULL, 1000000ULL,
    10000000ULL, 100000000ULL, 1000000000ULL, 10000000000ULL, 100000000000ULL,
    1000000000000ULL, 10000000000000ULL, 100000000000000ULL, 1000000000000000ULL,
    10000000000000000ULL, 100000000000000000ULL, 1000000000000000000ULL,
    10000000000000000000ULL
};

/* 十进制/十六进制浮点字面量 → IEEE-754 位模式。
 * 尾数 ≤ 2^53 且 |指数| ≤ 19 时只做一次乘或除，那一步就是正确舍入（Clinger
 * 快路径）；更长的字面量取前 19 位有效数字后走循环近似——不静默：精度只到
 * 双精度的最后一位，日常字面量都在快路径里。 */
static u64 float_lit_bits(const char *s, u32 n, int *is_f32)
{
    u64 m = 0;
    int dexp = 0;
    int ee = 0;
    int eneg = 0;
    int seen_dot = 0;
    int is_hex = 0;
    int have_e = 0;
    int i = 0;
    double v = 0;

    *is_f32 = 0;
    if (n > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
        is_hex = 1;
    i = is_hex ? 2 : 0;
    for (; i < (int)n; i++) {
        int c = (int)(unsigned char)s[i];
        int d = -1;

        if (c >= '0' && c <= '9')
            d = c - '0';
        else if (is_hex && c >= 'a' && c <= 'f')
            d = c - 'a' + 10;
        else if (is_hex && c >= 'A' && c <= 'F')
            d = c - 'A' + 10;
        if (d >= 0) {
            if (m < 1000000000000000000ULL) {
                m = m * (u64)(is_hex ? 16 : 10) + (u64)d;
                if (seen_dot)
                    dexp -= is_hex ? 4 : 1;
            } else if (!seen_dot) {
                dexp += is_hex ? 4 : 1;
            }
            continue;
        }
        if (c == '.') {
            seen_dot = 1;
            continue;
        }
        if (is_hex ? (c == 'p' || c == 'P') : (c == 'e' || c == 'E')) {
            have_e = 1;
            i++;
            if (i < (int)n && (s[i] == '-' || s[i] == '+')) {
                eneg = s[i] == '-';
                i++;
            }
            for (; i < (int)n; i++) {
                if (s[i] < '0' || s[i] > '9')
                    break;
                ee = ee * 10 + ((int)s[i] - '0');
            }
            /* 指数后面可能还有 f/F 后缀（.123E12F），别在这儿 break 掉 */
            i--;
            continue;
        }
        if (c == 'f' || c == 'F')
            *is_f32 = 1;
    }
    if (have_e && eneg)
        ee = -ee;
    if (is_hex) {
        int bexp = dexp + ee;

        v = (double)m;
        for (i = 0; i < bexp; i++)
            v = v * 2.0;
        for (i = 0; i < -bexp; i++)
            v = v / 2.0;
    } else {
        int de = dexp + ee;

        if (m <= (1ULL << 53) && de >= 0 && de < 20) {
            v = (double)m * (double)POW10_I[de];
        } else if (m <= (1ULL << 53) && de < 0 && -de < 20) {
            v = (double)m / (double)POW10_I[-de];
        } else {
            v = (double)m;
            for (i = 0; i < de; i++)
                v = v * 10.0;
            for (i = 0; i < -de; i++)
                v = v / 10.0;
        }
    }
    if (*is_f32) {
        u32 b32 = 0;
        float fv = (float)v;

        *(float *)&b32 = fv;          /* 类型双关：拿 float 的位模式 */
        return (u64)b32;
    }
    {
        u64 b64 = 0;

        *(double *)&b64 = v;
        return b64;
    }
}

static u32 gen_postfix(void);
static u32 parse_typename(void);
/* `_Static_assert ( 常量表达式 [, "消息"] ) ;` —— 档级和块级共用 */
static void parse_static_assert_rest(void)
{
    i64 v = 1;

    pa_expect_ch('(');
    v = const_expr();
    if (pa_accept_ch(',')) {
        if (pa_cur()->kind == TK_STR)
            pa_advance();
    }
    pa_expect_ch(')');
    pa_expect_ch(';');
    if (!v)
        pa_error("_Static_assert 失败");
}

static void gen_stmt(void);
static void gen_local_decl(int need_semi);
static void pa_func_def(Sym *fn, Declarator *d);

#define DATA_VA(off) (ELF_BASE_VA + ELF_HDR + (off))

/* 类型 id → IR 的宽度/符号码 */
static u8 ir_ty_of(u32 t)
{
    switch (ty_kind(t)) {
    case TY_BOOL: return IRT_U8;
    case TY_CHAR: return IRT_I8;
    case TY_SCHAR: return IRT_I8;
    case TY_UCHAR: return IRT_U8;
    case TY_SHORT: return IRT_I16;
    case TY_USHORT: return IRT_U16;
    case TY_INT: return IRT_I32;
    case TY_UINT: return IRT_U32;
    case TY_LONG: return IRT_I64;
    case TY_LLONG: return IRT_I64;
    case TY_ULONG: return IRT_U64;
    case TY_ULLONG: return IRT_U64;
    case TY_FLOAT: return IRT_F32;
    case TY_DOUBLE: return IRT_F64;
    case TY_LDOUBLE: return IRT_F64;
    case TY_PTR: return IRT_PTR;
    case TY_ARRAY: return IRT_PTR;
    case TY_FUNC: return IRT_PTR;
    default: return IRT_U64;
    }
}

static u32 load_lval(u32 addr, u32 ty)
{
    u32 d = irfn_vreg(&FN);

    irfn_push(&FN, IR_LOAD, ir_ty_of(ty), (u16)d, (u16)addr, 0, 0, 0);
    return d;
}

/* IR_STORE：dst 字段放地址，a 字段放值（见 x64.c6 的 IR_STORE） */
static void store_lval(u32 addr, u32 ty, u32 val)
{
    /* 聚合赋值（`*out = *in`、`s = t`）必须按字节整块拷：IR_STORE 只有
     * 1/2/4/8 的宽度，写成它只会拷头 8 字节（踩过：结构体拷贝只过前 8 字节，
     * 编译器自己编译自己时整个预处理器都读不出 token）。 */
    if (ty_is_agg(ty) || ty_is_array(ty)) {
        irfn_push(&FN, IR_COPY, IRT_U8, (u16)addr, (u16)val, 0, 0, ty_size(ty));
        return;
    }
    irfn_push(&FN, IR_STORE, ir_ty_of(ty), (u16)addr, (u16)val, 0, 0, 0);
}

/* 位域写入：读存储单元 → 清掉这一段 → 把值左移掩码后或进去 → 写回单元。
 * 单元类型就是成员类型（offs 指向单元起始字节）。 */
static u32 gen_addr_off(u32 base, u32 off);

/* 位域 RMW 的小工具：常数进 vreg、二元运算出一个新 vreg */
static u32 bf_k(u64 c)
{
    u32 v = irfn_vreg(&FN);

    irfn_push(&FN, IR_CONSTK, IRT_U64, (u16)v, 0, 0, 0, irfn_kconst(&FN, c));
    return v;
}

static u32 bf_bin(u8 op, u32 a, u32 b)
{
    u32 d = irfn_vreg(&FN);

    irfn_push(&FN, op, IRT_U64, (u16)d, (u16)a, (u16)b, 0, 0);
    return d;
}

static void store_lval_bits(u32 addr, u32 ty, u32 bits, u32 bo, u32 val)
{
    u32 old = 0;

    /* packed 结构体里字段可能跨过 8 字节边界：`int x:12; char y:6; long long z:63;`
     * 的 z 从第 18 位起占 63 位，最后一位落在第 9 个字节上，一个 u64 装不下。
     * 这种跨字的按「u64 + 尾字节」两段做，两段都只碰字段真正覆盖到的字节。 */
    if (bits >= 1 && bits + bo > 64) {
        u64 fmask = (bits >= 64) ? ~0ULL : ((1ULL << bits) - 1);
        u32 alo = addr;
        u32 ahi = gen_addr_off(addr, 8);
        u32 lo = load_lval(alo, ty_ulong());
        u32 hi = load_lval(ahi, ty_uchar());
        u32 virt = bf_bin(IR_AND, val, bf_k(fmask));
        u64 mlo = fmask << bo;                     /* 低段掩码（溢出位自然丢掉） */
        u64 mhi = (bo > 0) ? ((fmask >> (64 - bo)) & 0xFFu) : 0;
        u32 plo = bf_bin(IR_SHL, virt, bf_k(bo));
        u32 phi = bo > 0 ? bf_bin(IR_SHR, virt, bf_k(64 - bo)) : virt;
        u32 rlo = bf_bin(IR_OR, bf_bin(IR_AND, lo, bf_k(~mlo)),
                         bf_bin(IR_AND, plo, bf_k(mlo)));
        u32 rhi = bf_bin(IR_OR, bf_bin(IR_AND, hi, bf_k(~mhi & 0xFFu)),
                         bf_bin(IR_AND, phi, bf_k(mhi)));

        store_lval(alo, ty_ulong(), rlo);
        store_lval(ahi, ty_uchar(), rhi);
        return;
    }
    if (bits >= 1 && bits <= 64 && ty_size(ty) * 8 < bits + bo) {
        u32 need = bits + bo;

        if (need <= 8)
            ty = ty_uchar();
        else if (need <= 16)
            ty = ty_ushort();
        else if (need <= 32)
            ty = ty_uint();
        else
            ty = ty_ulong();
    }
    old = load_lval(addr, ty);
    u32 d = old;

    if (bo > 0) {
        u32 k = irfn_vreg(&FN);

        irfn_push(&FN, IR_CONST, IRT_U64, (u16)k, 0, 0, 0, bo);
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_SHL, IRT_U64, (u16)d, (u16)val, (u16)k, 0, 0);
    } else {
        d = val;
    }
    {
        u64 keep = 0;
        u32 mk = irfn_vreg(&FN);
        u32 a1 = irfn_vreg(&FN);
        u32 a2 = irfn_vreg(&FN);
        u64 fmask = (bits >= 64) ? ~0ULL : ((1ULL << bits) - 1);

        keep = ~(fmask << bo);
        irfn_push(&FN, IR_CONSTK, IRT_U64, (u16)mk, 0, 0, 0, irfn_kconst(&FN, fmask << bo));
        irfn_push(&FN, IR_AND, IRT_U64, (u16)a1, (u16)d, (u16)mk, 0, 0);
        {
            u32 km = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONSTK, IRT_U64, (u16)km, 0, 0, 0, irfn_kconst(&FN, keep));
            irfn_push(&FN, IR_AND, IRT_U64, (u16)a2, (u16)old, (u16)km, 0, 0);
        }
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_OR, IRT_U64, (u16)d, (u16)a1, (u16)a2, 0, 0);
    }
    store_lval(addr, ty, d);
}

/* ---------- 闭包 ----------
 * 闭包是一个机器字，指向堆上的对象：
 *     { void *code; void *target/捕获… }
 * 调用约定：把对象自己当**隐藏的首参**传给 code（code 的签名因此比
 * 声明的签名多一个 `void *`）。捕获的变量是对象里的副本，所以闭包里的
 * 写改的是副本、多次调用之间保留状态——和 c6 的语义一致。 */

static u32 gen_addr_off(u32 base, u32 off);

#define CLOS_THUNK_MAX 64
static u32 CLOS_FTY[CLOS_THUNK_MAX];
static u32 CLOS_SYM[CLOS_THUNK_MAX];
static u32 NCLOS_THUNK;

/* 分配闭包对象：{ code = code_sym, … extra 字节待填 }，返回对象指针（vreg） */
static u32 clos_alloc(u32 code_sym, u32 extra)
{
    u32 msz = irfn_vreg(&FN);
    u32 env = irfn_vreg(&FN);
    u32 code = irfn_vreg(&FN);
    u32 msym = x64_sym(&X64, "malloc");

    irfn_push(&FN, IR_CONST, IRT_U64, (u16)msz, 0, 0, 0, 8 + extra);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)msz, 0, 0, 0);
    irfn_push(&FN, IR_CALL, IRT_PTR, (u16)env, 0, 0, 0, msym);
    FN.ops[FN.n - 1].narg = 1;
    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)code, 0, 0, 0, code_sym);
    FN.ops[FN.n - 1].flags = 2;
    irfn_push(&FN, IR_STORE, IRT_U64, (u16)env, (u16)code, 0, 0, 0);
    return env;
}

/* 生成（并按签名缓存）一个中转函数：(void *env, a0…) → env[1](a0…) */
static u32 clos_thunk(u32 fty)
{
    u32 i = 0;
    u32 np = ty_func_nparams(fty);
    u32 slots[18] = {0};
    u32 dst = 0;
    u32 tgt = 0;
    u32 tsym = 0;
    u32 n0 = FN.n;
    u32 nx = 0;
    IrOp *bak = NULL;
    TmplSaved sv = {0};
    char nm[64] = {0};

    for (i = 0; i < NCLOS_THUNK; i++)
        if (CLOS_FTY[i] == fty)
            return CLOS_SYM[i];
    bak = arena_alloc(&A_main, (size_t)(n0 ? n0 : 1) * sizeof(IrOp));
    if (n0)
        memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
    tmpl_save_state(&sv);
    snprintf(nm, sizeof(nm), "c6c_clos_thunk_%u", (unsigned)NCLOS_THUNK);
    tsym = x64_sym(&X64, arena_strndup(&A_main, nm, (u32)strlen(nm)));
    irfn_reset(&FN, nm);
    CUR_RET_TY = ty_target(fty);
    FN.is_variadic = 0;
    /* 变参的闭包：thunk 把 env 挤成了第一个显式实参，所以后面的实参整体
     * 往后挪一格。多出来的实参个数在编译 thunk 时是不知道的（同一个类型
     * 可能被 1 个也可能被 5 个实参调用），这里固定多接 8 个槽位往下传：
     * 调用方少传的那些读到的是垃圾，被调方按自己的形参个数/va_arg 只取
     * 该取的那几个，不会看到它们。 */
    nx = ty_func_variadic(fty) ? 8 : 0;
    /* FN.params 只有 16 格：形参个数要在这儿就掐住（以前 `i < 18` 已经能
     * 写越界，只是没人踩到；变参多接 8 格一下就踩到了）。 */
    if (np + 1 + nx > 16)
        nx = np + 1 < 16 ? 15 - np : 0;
    for (i = 0; i < np + 1 + nx && i < 16; i++) {
        slots[i] = irfn_vreg(&FN);
        FN.params[FN.nparams++] = slots[i];
    }
    tgt = irfn_vreg(&FN);
    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)tgt, (u16)gen_addr_off(slots[0], 8), 0, 0, 0);
    for (i = 0; i < np + nx && i < 16; i++)
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)slots[i + 1], 0, 0, i);
    dst = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALLI, ir_ty_of(ty_target(fty)), (u16)dst, (u16)tgt, 0, 0, 0);
    FN.ops[FN.n - 1].narg = (u8)(np + nx < 16 ? np + nx : 16);
    irfn_push(&FN, IR_RET, ir_ty_of(ty_target(fty)), 0, (u16)dst, 0, 0, 0);
    x64_compile(&X64, &FN, tsym);
    tmpl_restore_state(&sv);
    if (n0)
        memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
    if (NCLOS_THUNK < CLOS_THUNK_MAX) {
        CLOS_FTY[NCLOS_THUNK] = fty;
        CLOS_SYM[NCLOS_THUNK] = tsym;
        NCLOS_THUNK++;
    }
    return tsym;
}

/* 普通函数指针 → 闭包：对象里存 {中转函数, 目标地址} */
static u32 clos_of_fn(u32 tgt, u32 fty)
{
    u32 env = clos_alloc(clos_thunk(fty), 8);
    u32 t8 = gen_addr_off(env, 8);

    irfn_push(&FN, IR_STORE, IRT_U64, (u16)t8, (u16)tgt, 0, 0, 0);
    return env;
}

/* ---------- spawn / thread ----------
 * `spawn f(a, b)`：实参在 spawn 处求值，拷进堆上的参数块
 *   { 代码指针, 目标地址, a0, a1, … }
 * 再 pthread_create 起线程；返回的 thread 就是那个含 pthread_t 的句柄对象。 */
#define SPN_THUNK_MAX 16
static u32 SPN_SYM[SPN_THUNK_MAX];

static void mgd_release(u32 v);        /* 托管引用的释放（定义在下面） */

/* 中转函数按 (实参个数, 哪些实参是托管引用) 缓存：托管实参要在线程体返回后
 * 放掉实参块那一份计数（"线程活多久对象就活多久"）。 */
static u32 spawn_thunk(int n, u32 mgdmask)
{
    u32 i = 0;
    u32 n0 = FN.n;
    IrOp *bak = NULL;
    TmplSaved sv = {0};
    char nm[64] = {0};
    u32 tsym = 0;
    u32 envs = 0;
    u32 tg = 0;
    u32 dst = 0;

    if (n < SPN_THUNK_MAX && mgdmask == 0 && SPN_SYM[n])
        return SPN_SYM[n];
    bak = arena_alloc(&A_main, (size_t)(n0 ? n0 : 1) * sizeof(IrOp));
    if (n0)
        memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
    tmpl_save_state(&sv);
    if (mgdmask)
        snprintf(nm, sizeof(nm), "c6c_spawn_%d_%x", n, (unsigned)mgdmask);
    else
        snprintf(nm, sizeof(nm), "c6c_spawn_%d", n);
    tsym = x64_sym(&X64, arena_strndup(&A_main, nm, (u32)strlen(nm)));
    irfn_reset(&FN, nm);
    CUR_RET_TY = ty_ptr(ty_void());
    FN.is_variadic = 0;
    envs = irfn_vreg(&FN);
    FN.params[FN.nparams++] = envs;
    tg = irfn_vreg(&FN);
    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)tg, (u16)gen_addr_off(envs, 8), 0, 0, 0);
    for (i = 0; i < (u32)n && i < 16; i++) {
        u32 av = irfn_vreg(&FN);

        irfn_push(&FN, IR_LOAD, IRT_U64, (u16)av,
                  (u16)gen_addr_off(envs, 16 + 8 * i), 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)av, 0, 0, i);
    }
    dst = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALLI, IRT_I64, (u16)dst, (u16)tg, 0, 0, 0);
    FN.ops[FN.n - 1].narg = (u8)(n < 16 ? n : 16);
    /* 托管实参：线程体已经返回，实参块那一份计数该还回去 */
    for (i = 0; i < (u32)n && i < 16; i++)
        if (mgdmask & (1u << i)) {
            u32 rv = irfn_vreg(&FN);

            irfn_push(&FN, IR_LOAD, IRT_U64, (u16)rv,
                      (u16)gen_addr_off(envs, 16 + 8 * i), 0, 0, 0);
            mgd_release(rv);
        }
    /* 中转函数把被调函数的返回值交出去：句柄的 h->value() 就是它
     * （`thread h = spawn f(x); h->value()`）。 */
    irfn_push(&FN, IR_RET, IRT_I64, 0, (u16)dst, 0, 0, 0);
    /* 中转函数也是"函数"：C99/LLVM 后端要按自己的方式发出去，不能只写镜像 */
    if (C99_MODE || llvm_mode())
        be_emit_fn(&FN, tsym);
    else
        x64_compile(&X64, &FN, tsym);
    tmpl_restore_state(&sv);
    if (n0)
        memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
    if (n < SPN_THUNK_MAX && mgdmask == 0)
        SPN_SYM[n] = tsym;
    return tsym;
}

/* 闭包的隐式转换：函数/函数指针 → 闭包对象（包一层中转函数） */
static u32 clos_conv(u32 v, u32 vty)
{
    u32 f = 0;

    if (ty_is_closure(vty, NULL))
        return v;
    /* 变参函数包不成闭包：中转函数得知道实参表长什么样，而变参的长度只有
     * 调用方知道（tests/errors/closure_convert.c6 的 test_variadic）。 */
    if ((ty_is_func(vty) || (ty_is_ptr(vty) && ty_is_func(ty_target(vty))))
        && ty_func_variadic(ty_is_func(vty) ? vty : ty_target(vty)) && in_c6_tu())
        pa_error("a variadic function pointer cannot be wrapped into a closure: a "
                 "trampoline cannot forward an unknown argument list (make it a "
                 "capturing literal instead)");
    if (ty_is_func(vty))
        f = vty;
    else if (ty_is_ptr(vty) && ty_is_func(ty_target(vty)))
        f = ty_target(vty);
    else
        return v;
    return clos_of_fn(v, f);
}

/* 位域取值：单元按实际跨度选（packed 结构体里字段可能跨过声明类型宽度），
 * 取出后右移位偏移、按位宽掩码，有符号再算术右移补符号。 */
static u32 load_bf(u32 addr, u32 ty, u32 bits, u32 bo, int is_signed, int zero_ext)
{
    u32 v2 = 0;
    u32 d = 0;

    if (bits >= 1 && bits + bo > 64) {
        /* 跨 8 字节边界：低 8 字节 + 尾字节拼回整段。这里已经移过位了，
         * 下面的公共尾巴不能再移一次（bo 会被移两遍，值变成 >>2*bo）。 */
        u32 lo = load_lval(addr, ty_ulong());
        u32 hi = load_lval(gen_addr_off(addr, 8), ty_uchar());

        v2 = bf_bin(IR_SHR, lo, bf_k(bo));
        v2 = bf_bin(IR_OR, v2, bf_bin(IR_SHL, hi, bf_k(64 - bo)));
        bo = 0;
    } else {
        if (bits >= 1 && bits <= 64 && ty_size(ty) * 8 < bits + bo) {
            u32 need = bits + bo;

            if (need <= 8)
                ty = ty_uchar();
            else if (need <= 16)
                ty = ty_ushort();
            else if (need <= 32)
                ty = ty_uint();
            else
                ty = ty_ulong();
        }
        v2 = load_lval(addr, ty);
    }
    d = v2;
    if (bo > 0) {
        u32 k = irfn_vreg(&FN);

        irfn_push(&FN, IR_CONST, IRT_U64, (u16)k, 0, 0, 0, bo);
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_SHR, IRT_U64, (u16)d, (u16)v2, (u16)k, 0, 0);
    }
    if (bits < 64) {
        u32 m = irfn_vreg(&FN);
        u32 d2 = irfn_vreg(&FN);
        u64 mask = (1ULL << bits) - 1;

        irfn_push(&FN, IR_CONSTK, IRT_U64, (u16)m, 0, 0, 0, irfn_kconst(&FN, mask));
        irfn_push(&FN, IR_AND, IRT_U64, (u16)d2, (u16)d, (u16)m, 0, 0);
        d = d2;
    }
    if (is_signed && !zero_ext && bits < 64) {
        u32 sh = irfn_vreg(&FN);
        u32 a1 = irfn_vreg(&FN);
        u32 a2 = irfn_vreg(&FN);

        irfn_push(&FN, IR_CONST, IRT_U64, (u16)sh, 0, 0, 0, 64 - bits);
        irfn_push(&FN, IR_SHL, IRT_U64, (u16)a1, (u16)d, (u16)sh, 0, 0);
        irfn_push(&FN, IR_SAR, IRT_U64, (u16)a2, (u16)a1, (u16)sh, 0, 0);
        d = a2;
    }
    return d;
}

/* 带隐式转换的存值：赋值/初始化把右值转成左值类型（浮点尤其要，否则
 * `float f = <double 字面量>;` 会把 double 位模式的低 4 字节当 float） */
static void store_conv(u32 addr, u32 ty, u32 v, u32 vty)
{
    u32 ifx = 0;
    u32 cft = 0;

    /* 结构体 → 接口的隐式转换（`Shape s = q;`）：胖指针是 {self, vt}，
     * self 存源对象的地址、vt 存静态 vtable 的地址。
     * 以前这里直接当聚合拷贝，第一字段进了 self、vt 留空，一调方法就跳野指针。 */
    if (TY_HAS_IFACE && NIFACE > 0 && ty_is_iface(ty, &ifx) && ty_is_agg(vty)
        && !ty_is_iface(vty, NULL)) {
        u32 sty = ty_is_ptr(vty) ? ty_target(vty) : vty;
        u32 vv = irfn_vreg(&FN);
        u32 sym = 0;

        /* 转换点先验签名：赋值/初始化也要报"没实现"，否则 vtable 里留空槽，
         * 一调方法就跳野指针（tests/errors/iface.c6 的 test_proto_scope_tag
         * 就是靠这里报出来的）。 */
        iface_check_impl(sty, ifx);
        sym = iface_vtbl(ifx, sty);

        store_conv(gen_addr_off(addr, 0), ty_ptr(ty_void()), v, ty_ptr(ty_void()));
        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)vv, 0, 0, 0, sym);
        FN.ops[FN.n - 1].flags = 2;
        store_conv(gen_addr_off(addr, 8), ty_ptr(ty_void()), vv, ty_ptr(ty_void()));
        return;
    }
    if (TY_HAS_CLOSURE && ty_is_closure(ty, &cft)) {
        v = clos_conv(v, vty);
        store_lval(addr, ty, v);
        return;
    }
    if (vty != ty && (ty_is_float(ty) || ty_is_float(vty)))
        v = gen_convert(v, vty, ty);
    store_lval(addr, ty, v);
}

/* ---------- 托管引用（`@T`）的引用计数 ----------
 * 机器层面 `@T` 就是 `T *`；前端负责在初始化、赋值、退出作用域、return
 * 这几处插 `__c6_gc_retain` / `__c6_gc_release`。没落到托管局部量上的临时
 * 值（`new T;` 丢弃、`f(new T)` 实参）在语句结束/调用返回后立刻释放。 */
#define MGD_TMP_MAX 64
static u32 MGD_TMPV[MGD_TMP_MAX];
static int NMGD_TMP;
static int PEND_MGD;             /* 当前左值是托管局部量 */
static Sym *PEND_MGD_SYM;
/* 当前左值对应的符号（不限托管量）。只用来判"这个对象是不是只读的"，
 * 赋值给 `int *const p` 时要发一条 tcc 口径的 warning。 */
static Sym *PEND_SYM;

static u32 mgd_call1(const char *fn, u32 v)
{
    Sym *ms = sym_find(fn, (u32)strlen(fn));
    u32 d = 0;

    if (!ms || !ms->is_func)
        return 0;
    /* v 一定是真的虚寄存器（vreg 0 也是合法的）；槽里存的 0 到运行时就是
     * NULL，release(NULL) 直接返回。 */
    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)v, 0, 0, 0);
    d = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALL, IRT_VOID, (u16)d, 0, 0, 0, (u32)ms->val);
    FN.ops[FN.n - 1].narg = 1;
    return d;
}

static void mgd_retain(u32 v)
{
    mgd_call1("__c6_gc_retain", v);
}

static void mgd_release(u32 v)
{
    mgd_call1("__c6_gc_release", v);   /* 0 就是 NULL，运行时直接返回 */
}

static void mgd_tmp_add(u32 v)
{
    if (NMGD_TMP < MGD_TMP_MAX)
        MGD_TMPV[NMGD_TMP++] = v;
}

/* v 是不是"还没被谁接管的新引用"（`new T` 的结果）？只看不动。 */
static int mgd_tmp_has(u32 v)
{
    int i = 0;

    for (i = 0; i < NMGD_TMP; i++)
        if (MGD_TMPV[i] == v)
            return 1;
    return 0;
}

/* 所有权从"临时值"转给某个托管量：从待释放表里摘掉 */
static int mgd_tmp_take(u32 v)
{
    int i = NMGD_TMP - 1;

    for (; i >= 0; i--)
        if (MGD_TMPV[i] == v) {
            int k = i;

            for (; k + 1 < NMGD_TMP; k++)
                MGD_TMPV[k] = MGD_TMPV[k + 1];
            NMGD_TMP--;
            return 1;
        }
    return 0;
}

static void mgd_tmp_flush(void)
{
    while (NMGD_TMP > 0) {
        NMGD_TMP--;
        mgd_release(MGD_TMPV[NMGD_TMP]);
    }
}

/* `__c6_gc_weak(&槽, 目标)`：把弱槽登记到运行时，目标死亡时置空 */
static void mgd_weak(u32 slot_addr, u32 val)
{
    Sym *ms = sym_find("__c6_gc_weak", 12);

    if (!ms || !ms->is_func)
        return;
    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)slot_addr, 0, 0, 0);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)val, 0, 0, 1);
    {
        u32 d = irfn_vreg(&FN);

        irfn_push(&FN, IR_CALL, IRT_VOID, (u16)d, 0, 0, 0, (u32)ms->val);
        FN.ops[FN.n - 1].narg = 2;
    }
}

static void mgd_defer_push(u32 slot_v);
static void task_defer_push(u32 slot_v);

static void mark_lval(u32 addr, u32 ty)
{
    PEND_LVAL = 1;
    PEND_ADDR = addr;
    PEND_TY = ty;
    PEND_BITS = 0;
    PEND_MGD = 0;
    PEND_MGD_SYM = NULL;
    PEND_SYM = NULL;
    GEN_TY = ty;
}

/* 当前操作数的类型：左值取 PEND_TY，但位域要按 C99 6.3.1.1p2 提升——
 * **放得进 int 就提升成 int**，跟声明类型无关（`long long b:2` 也是 int，
 * tests2 的 95_bitfields 用 `sizeof(s->b + 0)` 判打印宽度）；32 位按声明
 * 类型的符号选 int/uint。`s.u3 - 100 < 0` 也靠它按有符号算。 */
static u32 cur_op_ty(void)
{
    u32 t = PEND_LVAL ? PEND_TY : GEN_TY;

    if (PEND_LVAL && PEND_BITS >= 1 && PEND_BITS <= 64) {
        if (PEND_BITS <= 31)
            return ty_int();
        if (PEND_BITS == 32)
            return ty_is_signed(t) ? ty_int() : ty_uint();
    }
    return t;
}

/* 把“待取值”的左值变成值；不是左值就原样返回 */
static u32 value_of(u32 v)
{
    u32 addr = 0;
    u32 ty = 0;

    if (!PEND_LVAL)
        return v;
    PEND_LVAL = 0;
    addr = PEND_ADDR;
    ty = PEND_TY;
    GEN_TY = ty;
    if (ty_is_array(ty)) {
        GEN_TY = ty_ptr(ty_target(ty));   /* 数组自动退化成指向首元素的指针 */
        return addr;
    }
    if (ty_is_func(ty)) {
        /* 函数左值（`*fp` / 函数名）的值就是地址，不能再去读它的头 8 字节。
         * typeof 例外：它要的是函数类型本身，不是退化成指针的类型。 */
        GEN_TY = NO_DECAY ? ty : ty_ptr(ty);
        return addr;
    }
    if (ty_is_agg(ty))
        return addr;                      /* 聚合值用地址代表（只用于拷贝） */
    {
        u32 bits = PEND_BITS;
        u32 bo = PEND_BITOFF;
        u32 v2 = 0;

        if (bits >= 1 && bits <= 64) {
            v2 = load_bf(addr, ty, bits, bo, ty_is_signed(ty), PEND_BF_ENUM);
            /* 位域的整型提升（C99 6.3.1.1p2）：**放得进 int 就提升成 int**，
             * 跟声明类型无关。`long long b:2` 的表达式类型因此是 int——tcc/gcc
             * 都这样（tests2 的 95_bitfields 靠 `sizeof(s->b + 0)` 判断打印宽度）。 */
            if (bits <= 31)
                GEN_TY = ty_int();
            else if (bits == 32)
                GEN_TY = ty_is_signed(ty) ? ty_int() : ty_uint();
            PEND_BITS = 0;
            PEND_BITOFF = 0;
            return v2;
        }
        v2 = load_lval(addr, ty);

        PEND_BITS = 0;
        PEND_BITOFF = 0;
        if (bits >= 1 && bits <= 64 && (bo > 0 || bits < 64 || ty_is_signed(ty))) {
            u32 d = v2;

            if (bo > 0) {
                u32 k = irfn_vreg(&FN);

                irfn_push(&FN, IR_CONST, IRT_U64, (u16)k, 0, 0, 0, bo);
                d = irfn_vreg(&FN);
                irfn_push(&FN, IR_SHR, IRT_U64, (u16)d, (u16)v2, (u16)k, 0, 0);
            }
            if (bits < 64) {
                u32 m = irfn_vreg(&FN);
                u32 d2 = irfn_vreg(&FN);
                u64 mask = (1ULL << bits) - 1;

                irfn_push(&FN, IR_CONSTK, IRT_U64, (u16)m, 0, 0, 0, irfn_kconst(&FN, mask));
                irfn_push(&FN, IR_AND, IRT_U64, (u16)d2, (u16)d, (u16)m, 0, 0);
                d = d2;
            }
            /* 枚举类型的位域不符号扩展：tcc 对"只用正数的枚举"按零扩展，
             * 这样 8 位枚举位域存 148 这种带 bit7 的值才不会变成负数
             * （tcc tests2 的 92_enum_bitfield 就在验这一点）。 */
            if (ty_is_signed(ty) && !PEND_BF_ENUM && bits < 64) {
                u32 sh = irfn_vreg(&FN);
                u32 a1 = irfn_vreg(&FN);
                u32 a2 = irfn_vreg(&FN);

                irfn_push(&FN, IR_CONST, IRT_U64, (u16)sh, 0, 0, 0, 64 - bits);
                irfn_push(&FN, IR_SHL, IRT_U64, (u16)a1, (u16)d, (u16)sh, 0, 0);
                irfn_push(&FN, IR_SAR, IRT_U64, (u16)a2, (u16)a1, (u16)sh, 0, 0);
                d = a2;
            }
            v2 = d;
        }
        if (bits >= 1 && bits <= 31 && !ty_is_signed(ty))
            GEN_TY = ty_int();            /* 位域整型提升 */
        return v2;
    }
}

static u32 ident_addr(Sym *s)
{
    u32 v = irfn_vreg(&FN);

    /* 闭包体里的捕获变量：地址是环境对象里的那一格 */
    if (FLCAP_N > 0 && (s->slot & CAP_SLOT_BIT)) {
        u32 idx = s->slot & ~CAP_SLOT_BIT;
        Sym *ev = sym_find("__env", 5);
        u32 ep = 0;

        if (ev) {
            u32 ea = ident_addr(ev);

            ep = irfn_vreg(&FN);
            irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)ep, (u16)ea, 0, 0, 0);
            return gen_addr_off(ep, idx < FL_CAP_MAX ? FLCAP_OFF[idx] : 8);
        }
    }
    if (s->kind == SC_GLOBAL) {
        if (s->is_tls) {
            /* `__thread`：地址是 `%fs` 基址 + 数据段偏移。基址每个线程一份
             * （lib/rt.c6 的 c6c_tls_setup 用 arch_prctl 设），所以这里每次
             * 都问一遍——不能缓存到全局，跨线程就错了。 */
            u32 fsfn = x64_sym(&X64, "__c6_fsbase");
            u32 fs = irfn_vreg(&FN);
            u32 off = irfn_vreg(&FN);
            u32 r = irfn_vreg(&FN);

            irfn_push(&FN, IR_CALL, IRT_U64, (u16)fs, 0, 0, 0, fsfn);
            FN.ops[FN.n - 1].narg = 0;
            irfn_push(&FN, IR_CONST, IRT_U64, (u16)off, 0, 0, 0, s->goff);
            irfn_push(&FN, IR_ADD, IRT_PTR, (u16)r, (u16)fs, (u16)off, 0, 0);
            return r;
        }
        /* 全局符号：rip 相对 + 重定位（位置无关；做 .o 时直接变 R_X86_64_PC32） */
        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)v, 0, 0, 0, (u32)s->val);
        FN.ops[FN.n - 1].flags = 2;
    } else {
        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)v, 0, 0, 0, X64_SLOT(s->slot));
    }
    return v;
}

/* 字符串字面量解码后放进数据段，返回数据段偏移（token 前进一格） */
static u32 NLIT;
static u32 LIT_SYM;

static int WIDE_LIT;
/* 上一次 str_lit_data() 写出的字节数（不含结尾 0），用来推 `char s[] = "…"`
 * 的元素个数——拼接后的长度只有解码完才知道。 */
static u32 STR_LIT_N;

/* 相邻字符串字面量拼接时的一段（用链表，段数不设上限：tcc 的
 * tcctok.h 一个数组就拼了上百段） */
typedef struct StrChunk {
    struct StrChunk *next;
    const char *p;
    u32 n;
    const u32 *cps;     /* 宽字面量：码点数组 */
    u32 ncp;
} StrChunk;

static u32 str_lit_data(void)
{
    StrChunk *head = NULL;
    StrChunk *tail = NULL;
    int kind = 0;               /* 0 = 窄（UTF-8），2 = u""（UTF-16），4 = U""/L"" */
    u32 total = 0;
    u32 off = 0;
    u32 at = 0;
    StrChunk *c = NULL;

    /* 相邻的字符串字面量在翻译阶段就拼成一个（tcc 的 tcc_keywords 就是
     * 靠 `str "\0"` 连出来的），这里一次性收集再写数据段。 */
    while (pa_cur()->kind == TK_STR) {
        Tok *t = pa_cur();
        const char *s = tok_data(t);
        u32 cap = t->len * 4 + 8;
        u8 *buf = arena_alloc(&A_main, (size_t)cap);
        StrChunk *nk = arena_alloc(&A_main, sizeof(StrChunk));
        u32 n = 0;
        u32 i = 0;

        while (i < t->len && s[i] != '"')
            i++;                       /* 跳过 L/u/U/u8 前缀 */
        if (i > 0 && !(i == 2 && s[0] == 'u' && s[1] == '8'))
            kind = (s[0] == 'u') ? 2 : 4;
        i++;
        nk->cps = arena_alloc(&A_main, (size_t)cap * sizeof(u32));
        nk->ncp = 0;
        while (i + 1 < t->len) {
            u32 ch = 0;
            int from_esc = 0;

            if (s[i] == '\\') {
                const char *p = s + i + 1;

                ch = esc_decode(&p, s + t->len);
                i = (u32)(p - s);
                from_esc = 1;
            } else {
                ch = (u32)(u8)s[i];
                i++;
                if (ch >= 0xC0) {
                    /* 源码里直接写的 UTF-8 多字节序列：先解成码点，宽字面量
                     * 才拿得到真正的字符（窄字面量随后会重新编码成同样字节） */
                    u32 need = (ch >= 0xF0) ? 3 : (ch >= 0xE0) ? 2 : 1;
                    u32 acc = ch & ((need == 2) ? 0x0F : (need == 1) ? 0x1F : 0x07);
                    u32 k2 = 0;

                    for (k2 = 0; k2 < need && i < t->len; k2++) {
                        acc = (acc << 6) | ((u32)(u8)s[i] & 0x3F);
                        i++;
                    }
                    ch = acc;
                    from_esc = 1;
                }
            }
            if (kind == 0 && from_esc && ch >= 0x80) {
                /* 窄字面量里的非 ASCII 码点按 UTF-8 编码（\uXXXX 和源码里的
                 * UTF-8 字节都走这里） */
                if (ch < 0x800) {
                    buf[n++] = (u8)(0xC0 | (ch >> 6));
                    buf[n++] = (u8)(0x80 | (ch & 0x3F));
                } else if (ch < 0x10000) {
                    buf[n++] = (u8)(0xE0 | (ch >> 12));
                    buf[n++] = (u8)(0x80 | ((ch >> 6) & 0x3F));
                    buf[n++] = (u8)(0x80 | (ch & 0x3F));
                } else {
                    buf[n++] = (u8)(0xF0 | (ch >> 18));
                    buf[n++] = (u8)(0x80 | ((ch >> 12) & 0x3F));
                    buf[n++] = (u8)(0x80 | ((ch >> 6) & 0x3F));
                    buf[n++] = (u8)(0x80 | (ch & 0x3F));
                }
            } else {
                buf[n++] = (u8)(ch & 0xFF);
                ((u32 *)nk->cps)[nk->ncp] = ch;
                nk->ncp++;
            }
        }
        nk->next = NULL;
        nk->p = (const char *)buf;
        nk->n = n;
        if (tail)
            tail->next = nk;
        else
            head = nk;
        tail = nk;
        pa_advance();
    }
    total = 0;
    for (c = head; c; c = c->next)
        total += (kind == 0) ? c->n : c->ncp;
    STR_LIT_N = total;
    if (kind == 0) {
        off = data_alloc(total + 1, 1);
        for (c = head; c; c = c->next) {
            memcpy(DATA_IMG.p + off + at, c->p, (size_t)c->n);
            at += c->n;
        }
        DATA_IMG.p[off + at] = 0;
        WIDE_LIT = 0;
    } else {
        /* u"" 是 2 字节元素（UTF-16），U""/L"" 是 4 字节元素（UTF-32） */
        off = data_alloc((total + 1) * (u32)kind, (u32)kind);
        for (c = head; c; c = c->next) {
            u32 m = 0;

            for (m = 0; m < c->ncp; m++) {
                u32 ch = c->cps[m];
                u32 w = (u32)kind;

                if (kind == 2 && ch >= 0x10000) {
                    /* 代理对 */
                    u32 v2 = ch - 0x10000;

                    DATA_IMG.p[off + at * 2] = (u8)(0xD8 | ((v2 >> 18) & 0x03));
                    DATA_IMG.p[off + at * 2 + 1] = (u8)((v2 >> 10) & 0xFF);
                    at++;
                    DATA_IMG.p[off + at * 2] = (u8)(0xDC | ((v2 >> 8) & 0x03));
                    DATA_IMG.p[off + at * 2 + 1] = (u8)(v2 & 0xFF);
                    at++;
                    continue;
                }
                DATA_IMG.p[off + at * w] = (u8)(ch & 0xFF);
                DATA_IMG.p[off + at * w + 1] = (u8)((ch >> 8) & 0xFF);
                if (w == 4) {
                    DATA_IMG.p[off + at * w + 2] = (u8)((ch >> 16) & 0xFF);
                    DATA_IMG.p[off + at * w + 3] = (u8)((ch >> 24) & 0xFF);
                }
                at++;
            }
        }
        WIDE_LIT = 1;
    }
    /* 每个字面量一个数据符号，命名 .LC<n>（调试/符号表可见，链接器可合并） */
    {
        char nm[32] = {0};

        snprintf(nm, sizeof(nm), ".LC%u", NLIT++);
        LIT_SYM = x64_data_sym(&X64, nm, ELF_HDR + off);
    }
    return off;
}

static u32 gen_str_from(const char *str, u32 len)
{
    u32 off = data_alloc(len + 1, 1);
    u32 v = 0;
    char nm[32] = {0};
    u32 sym = 0;

    memcpy(DATA_IMG.p + off, str, len);
    DATA_IMG.p[off + len] = 0;
    snprintf(nm, sizeof(nm), ".LC%u", NLIT++);
    sym = x64_data_sym(&X64, nm, ELF_HDR + off);
    v = irfn_vreg(&FN);
    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)v, 0, 0, 0, sym);
    FN.ops[FN.n - 1].flags = 2;
    GEN_TY = ty_ptr(ty_char());
    return v;
}

static u32 gen_string(void)
{
    u32 off = str_lit_data();
    u32 v = irfn_vreg(&FN);

    (void)off;
    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)v, 0, 0, 0, LIT_SYM);
    FN.ops[FN.n - 1].flags = 2;
    GEN_TY = ty_ptr(WIDE_LIT ? ty_int() : ty_char());
    return v;
}

static u32 gen_addr_off(u32 addr, u32 off);
static void mark_lval(u32 addr, u32 ty);

/* 结构化接口的满足性检查：方法名 + 签名逐个比（接收者之外）。
 * tests/errors/iface.c6 的那几条诊断都从这里出。 */
static void iface_check_impl(u32 ty, u32 ifx)
{
    u32 k = 0;

    if (!in_c6_tu())
        return;
    for (k = 0; k < IFACE_NM[ifx]; k++) {
        Sym *ms = meth_find(ty, IFACE_MET[ifx][k], IFACE_MLEN[ifx][k]);
        u32 i = 0;

        if (!ms || !ms->is_func) {
            pa_error("'%s' does not implement interface '%.*s': missing method '%.*s'",
                     ty_disp(ty), (int)IFACE_NLEN[ifx], IFACE_NAME[ifx],
                     (int)IFACE_MLEN[ifx][k], IFACE_MET[ifx][k]);
            continue;
        }
        if (ty_func_nparams(ms->type) == 0
            || ty_func_nparams(ms->type) - 1 != IFACE_NP[ifx][k]) {
            pa_error("method '%.*s' of '%.*s' has the wrong number of parameters",
                     (int)IFACE_MLEN[ifx][k], IFACE_MET[ifx][k],
                     (int)IFACE_NLEN[ifx], IFACE_NAME[ifx]);
            continue;
        }
        if (ty_func_ret(ms->type) != IFACE_RET[ifx][k]) {
            pa_error("method '%.*s' of '%.*s' has an incompatible return type",
                     (int)IFACE_MLEN[ifx][k], IFACE_MET[ifx][k],
                     (int)IFACE_NLEN[ifx], IFACE_NAME[ifx]);
        }
        for (i = 0; i < IFACE_NP[ifx][k] && i < IFACE_NPARAM; i++) {
            u32 want = IFACE_PTY[ifx][k][i];
            u32 got = ty_func_param(ms->type, i + 1);

            if (want == got)
                continue;
            if (!ty_is_ptr(want) && !ty_is_ptr(got) && ty_is_int(want) && ty_is_int(got)
                && ty_size(want) == ty_size(got))
                continue;
            if (proto_tag_has(want))
                pa_error("method '%.*s' of '%.*s' has an incompatible parameter: the "
                         "interface's '%s' is a prototype-scope tag",
                         (int)IFACE_MLEN[ifx][k], IFACE_MET[ifx][k],
                         (int)IFACE_NLEN[ifx], IFACE_NAME[ifx], ty_disp(want));
            else
                pa_error("method '%.*s' of '%.*s' has an incompatible parameter",
                         (int)IFACE_MLEN[ifx][k], IFACE_MET[ifx][k],
                         (int)IFACE_NLEN[ifx], IFACE_NAME[ifx]);
            break;
        }
    }
}

static u32 gen_call(Sym *fs)
{
    /* 记下这次调用可不可失败：catch / 表达式语句要据此判断 */
    E_CALL_FALLIBLE = (fs && fs->fallible) ? 1 : 2;
    u32 args[16] = {0};
    u32 narg = 0;

    if (fs && drop_is_sym((u32)fs->val))
        pa_error("析构函数不能直接调用：最后一个引用放掉时它自己会跑（`p = NULL` 就够了）");
    u32 dst = 0;
    u32 i = 0;
    u32 a0ty = 0;
    u8 argmgd[PA_ARG_MAX] = {0};       /* 哪个实参是托管引用（async 要把它挂住） */
    u32 mgdmask2 = 0;

    pa_expect_ch('(');
    if (!pa_accept_ch(')')) {
        for (;;) {
            if (narg >= PA_ARG_MAX) {
                pa_error("实参太多（上限 64）");
                break;
            }
            {
                u32 av = gen_assign();
                u32 aty = cur_op_ty();
                u32 pty = ty_func_param(fs->type, narg);

                if (ty_has_mgd(aty)) {
                    char dnm[160] = {0};

                    agg_disp_name(aty, dnm, sizeof(dnm));
                    pa_error("'%s' holds managed references: a parameter is not possible. "
                             "Allocate it with 'new' and hold it in '@%s'", dnm, dnm);
                }
                if (narg == 0)
                    a0ty = aty;
                closure_lit_check(pty);
                /* 结构化接口：把聚合体传给接口形参时，逐个方法验签名 */
                {
                    u32 ifx5 = 0;

                    if (ty_is_iface(pty, &ifx5) && ty_is_agg(aty))
                        iface_check_impl(aty, ifx5);
                }
                {
                    int amgd = PEND_MGD;

                    av = value_of(av);
                    if (mgd_tmp_has(av))
                        amgd = 1;
                    if (amgd) {
                        argmgd[narg] = 1;
                        mgdmask2 |= 1u << narg;
                    }
                }
                /* c6 切片形参 + 数组实参：隐式转成 `{ptr, len}`（两个机器字）。
                 * 拷进调用者的临时槽，再把地址当实参传（聚合按值传参的既有约定）。 */
                {
                    u32 ifx = 0;

                    if (NIFACE > 0 && pty != 0 && ty_is_iface(pty, &ifx)) {
                        u32 sty2 = ty_is_ptr(aty) ? ty_target(aty) : aty;
                        u32 ts2 = frame_slots_for(16);
                        u32 ta2 = irfn_vreg(&FN);
                        u32 vv2 = irfn_vreg(&FN);
                        u32 sym2 = iface_vtbl(ifx, sty2);

                        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)ta2, 0, 0, 0, X64_SLOT(ts2));
                        store_conv(gen_addr_off(ta2, 0), ty_ptr(ty_void()), av,
                                   ty_ptr(ty_void()));
                        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)vv2, 0, 0, 0, sym2);
                        FN.ops[FN.n - 1].flags = 2;
                        store_conv(gen_addr_off(ta2, 8), ty_ptr(ty_void()), vv2,
                                   ty_ptr(ty_void()));
                        av = ta2;
                        aty = pty;
                    }
                }
                if (pty != 0 && ty_is_slice(pty) && ty_is_array(aty)) {
                    u32 tslot = frame_slots_for(16);
                    u32 taddr = irfn_vreg(&FN);
                    u32 lv = irfn_vreg(&FN);
                    u32 a8 = irfn_vreg(&FN);

                    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)taddr, 0, 0, 0, X64_SLOT(tslot));
                    irfn_push(&FN, IR_STORE, IRT_PTR, (u16)taddr, (u16)av, 0, 0, 0);
                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)lv, 0, 0, 0,
                              ty_array_n(aty) ? ty_array_n(aty) : 1);
                    irfn_push(&FN, IR_LEA, IRT_PTR, (u16)a8, (u16)taddr, 0, 0, 8);
                    irfn_push(&FN, IR_STORE, IRT_U64, (u16)a8, (u16)lv, 0, 0, 0);
                    av = taddr;
                    aty = pty;
                }
                /* 实参按形参类型转换；没有原型（或落在变参部分）时做默认实参
                 * 提升：float → double，否则 printf("%f", f) 拿到 4 字节位模式。 */
                if (pty != 0 && !ty_is_agg(pty)) {
                    if (aty != pty)
                        av = gen_convert(av, aty, pty);
                } else if (pty == 0 && ty_is_float(aty) && ty_size(aty) < 8) {
                    av = gen_convert(av, aty, ty_double());
                }

                /* 聚合按值传参：拷一份到调用者的临时槽，把**地址**当实参传。
                 * 被调方在自己的帧里再拷一份，语义等价。这样只用到"一个 8 字节
                 * 参数"的既有 IR，不必为 SysV 的寄存器分块/栈传递扩 IR。 */
                if (pty && ty_is_agg(pty) && ty_size(pty) > 0 && ty_size(pty) <= 4096) {
                    u32 sz = ty_size(pty);
                    u32 tslot = frame_slots_for(sz);
                    u32 taddr = irfn_vreg(&FN);

                    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)taddr, 0, 0, 0, X64_SLOT(tslot));
                    irfn_push(&FN, IR_COPY, IRT_U8, (u16)taddr, (u16)av, 0, 0, sz);
                    av = taddr;
                }
                args[narg] = av;
            }
            narg++;
            if (!pa_accept_ch(','))
                break;
        }
        pa_expect_ch(')');
    }
    /* 同名方法按**接收者**挑：`area(&c)` / `area(&r)` 在符号表里是同一个
     * 名字的多个函数（tests/method.c6 的 Circle_area / Rect_area），光按
     * 名字找只会有先注册的那个。第一个实参是指针时，用方法表里按接收者
     * 类型注册的那一条覆盖掉。 */
    {
        Sym *fb = sym_find_fn(fs->name, fs->len, narg, a0ty);

        if (fb && fb != fs) {
            fs = fb;
        } else if (narg > 0 && a0ty && ty_is_ptr(a0ty)) {
            Sym *mo = meth_find(ty_target(a0ty), fs->name, fs->len);

            if (mo && mo != fs && mo->is_func)
                fs = mo;
        }
    }
    /* 少传的实参按 C 惯例补 0：不补的话，那个寄存器/栈槽留着上一个表达式的
     * 垃圾值（native 后端会真的用上——`__c6_co_run()` 少传一个指针参数，被
     * 调用方就拿上个表达式的值当函数指针去调，直接段错误；C99 后端恰好把
     * 它写成 0，所以只有 native 崩）。 */
    if (!ty_func_variadic(fs->type)) {
        u32 np0 = ty_func_nparams(fs->type);

        while (narg < np0 && narg < 16) {
            u32 z0 = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, (u16)z0, 0, 0, 0, 0);
            args[narg] = z0;
            narg++;
        }
    }
    /* `async` 函数的调用：不能就地调用（任务体要能停在第一个 `await` 上）。
     * 照 spawn 的样子搭实参块 {中转函数, 目标地址, 实参…}，起一个协程并推进
     * 到第一个挂起/结束点，表达式的值就是 `__c6_co_task()` 交出的任务结构。 */
    if (ty_is_ptr(ty_target(fs->type)) && ty_is_task(ty_target(ty_target(fs->type)))) {
        /* mgdmask 传 0：async 的托管实参引用归**任务前缀**（创建时 retain、
         * 销毁时 release），不能交给中转函数在返回时放掉。 */
        u32 thunk2 = spawn_thunk((int)narg, 0);
        u32 env2 = clos_alloc(thunk2, 16 + 8 * narg);
        u32 tgv2 = irfn_vreg(&FN);
        u32 cov = irfn_vreg(&FN);
        u32 tsk2 = 0;

        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)tgv2, 0, 0, 0, (u32)fs->val);
        FN.ops[FN.n - 1].flags = 2;
        irfn_push(&FN, IR_STORE, IRT_U64, (u16)gen_addr_off(env2, 8), (u16)tgv2, 0, 0, 0);
        for (i = 0; i < narg; i++) {
            irfn_push(&FN, IR_STORE, IRT_U64, (u16)gen_addr_off(env2, 16 + 8 * i),
                      (u16)args[i], 0, 0, 0);
            /* 这里**不** retain：任务体在入口处会为每个托管形参在前缀里留一份
             * （见函数声明那一段），创建者手上那份照旧归自己。 */
        }
        {
            u32 nf = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, (u16)nf, 0, 0, 0,
                      (u32)(PA_CO_STMT ? 1 : 0));
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)env2, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)nf, 0, 0, 1);
        }
        irfn_push(&FN, IR_CALL, IRT_PTR, (u16)cov, 0, 0, 0,
                  x64_sym(&X64, "__c6_co_new"));
        FN.ops[FN.n - 1].narg = 2;
        FN.ops[FN.n - 1].narg = 1;
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)cov, 0, 0, 0);
        tsk2 = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_PTR, (u16)tsk2, 0, 0, 0,
                  x64_sym(&X64, "__c6_co_launch"));
        FN.ops[FN.n - 1].narg = 1;
        dst = tsk2;
        GEN_TY = ty_target(fs->type);
        E_WAS_CALL = 1;
        return dst;
    }
    for (i = 0; i < narg; i++)
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)args[i], 0, 0, i);
    dst = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALL, ir_ty_of(ty_target(fs->type)), (u16)dst, 0, 0, 0,
              (u32)fs->val);
    FN.ops[FN.n - 1].narg = (u8)narg;
    if (ty_func_variadic(fs->type))
        FN.ops[FN.n - 1].flags |= 1;   /* 变参调用（本地约定：浮点也走整型寄存器） */
    GEN_TY = ty_target(fs->type);
    E_WAS_CALL = 1;
    return dst;
}

/* 下标 / 成员 / 自增自减（postfix 链） */
static u32 gen_addr_off(u32 addr, u32 off);
static void mark_lval(u32 addr, u32 ty);
static int sizeof_inner_type_end(void);

static int pa_at_typename(void);
static u32 ident_addr(Sym *s);
static Sym *fnlit_parse_sym(void);
static u32 parse_param_list(u32 fnret, Declarator *d);
static u32 slice_len_load(u32 sadd);

static u32 gen_postfix_ops(u32 v)
{
    for (;;) {
        if (pa_accept_ch('[')) {
            u32 base = 0;
            u32 bty = 0;
            u32 slice_src = 0;
            int was_slice = 0;
            u32 idx = 0;
            u32 elem = 0;
            u32 esz = 0;
            u32 off = 0;
            int pmgd = PEND_MGD;

            if (PEND_LVAL) {
                /* 数组：地址就是首元素地址（自动退化）；
                 * 指针变量：**先取值**再当下标基址（取地址是它的槽地址，不是目标）。 */
                u32 a0 = PEND_ADDR;
                u32 ty0 = PEND_TY;

                /* c6 元组按下标取成员：`t[0]`。下标必须是常量（布局在编译期定） */
                if (ty_is_tuple(ty0)) {
                    u32 k = (u32)const_expr();
                    u32 mo = 0;
                    u32 mty = 0;

                    pa_expect_ch(']');
                    PEND_LVAL = 0;
                    if (k >= ty_member_n(ty0)) {
                        pa_error("元组下标越界");
                        GEN_TY = ty_int();
                        v = a0;
                        continue;
                    }
                    mty = ty_member(ty0, k);
                    mo = ty_member_off(ty0, k);
                    mark_lval(gen_addr_off(a0, mo), mty);
                    v = gen_addr_off(a0, mo);
                    continue;
                }

                PEND_LVAL = 0;
                /* 数组和切片都保持"地址"形态：切片还要从地址里取 .data，
                 * 先 load 成值就把整块当标量读了（踩过：切片下标拿到垃圾指针） */
                base = (ty_is_array(ty0) || ty_is_slice(ty0)) ? a0 : load_lval(a0, ty0);
                bty = ty0;
            } else {
                base = v;
                bty = GEN_TY;
            }
            slice_src = base;
            was_slice = 0;
            /* c6 切片：`s[i]` 就是 `s.data[i]`（base 在这里是切片的地址；
             * 边界检查还没做，见 todo P6-3） */
            {
                if (ty_is_slice(bty)) {
                    u32 pt = ty_ptr(ty_slice_elem(bty));

                    base = load_lval(base, pt);
                    bty = pt;
                    was_slice = 1;
                }
                /* 子切片 `s[lo:hi]`：两个边界都可以省。缺省上界要么是数组长度，
                 * 要么是切片自己的 len（指针不知道长度，按 0 算）。 */
                if (pa_is_ch(':')) {
                    u32 lo = 0;
                    u32 hi = 0;
                    u32 zero0 = 0;
                    u32 tmp = 0;
                    u32 ta = 0;
                    u32 pv = 0;
                    u32 lv = 0;
                    u32 selt = ty_is_ptr(bty) || ty_is_array(bty) ? ty_target(bty) : ty_int();
                    u32 se = ty_size(selt) ? ty_size(selt) : 1;

                    /* 切片的来源要么是数组、要么是切片本身：指针不知道长度，
                     * 不能切（tests/errors/slice.c6 的 test_pointer_slice /
                     * test_unknown_length）。 */
                    if (!was_slice) {
                        if (ty_is_ptr(bty) && !ty_is_array(bty))
                            pa_error("cannot slice a pointer; use '(T[:]){p, n}'");
                        else if (ty_is_array(bty) && ty_array_n(bty) == 0)
                            pa_error("cannot slice an array of unknown length");
                    }

                    pa_advance();
                    zero0 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)zero0, 0, 0, 0, 0);
                    lo = zero0;
                    if (!pa_is_ch(']')) {
                        hi = value_of(gen_expr());
                    } else if (was_slice) {
                        hi = slice_len_load(slice_src);
                    } else if (ty_is_ptr(bty) || ty_is_array(bty)) {
                        hi = irfn_vreg(&FN);
                        irfn_push(&FN, IR_CONST, IRT_U64, (u16)hi, 0, 0, 0,
                                  ty_is_array(bty) ? ty_array_n(bty) : 0);
                    } else {
                        hi = irfn_vreg(&FN);
                        irfn_push(&FN, IR_CONST, IRT_U64, (u16)hi, 0, 0, 0, 0);
                    }
                    pa_expect_ch(']');
                    tmp = frame_slots_for(16);
                    ta = irfn_vreg(&FN);
                    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)ta, 0, 0, 0, X64_SLOT(tmp));
                    pv = irfn_vreg(&FN);
                    if (se == 1 || se == 2 || se == 4 || se == 8) {
                        irfn_push(&FN, IR_LEA, IRT_PTR, (u16)pv, (u16)base, (u16)lo, 0, se);
                    } else {
                        u32 kk = irfn_vreg(&FN);
                        u32 mm = irfn_vreg(&FN);

                        irfn_push(&FN, IR_CONST, IRT_U64, (u16)kk, 0, 0, 0, se);
                        irfn_push(&FN, IR_MUL, IRT_U64, (u16)mm, (u16)lo, (u16)kk, 0, 0);
                        irfn_push(&FN, IR_ADD, IRT_PTR, (u16)pv, (u16)base, (u16)mm, 0, 0);
                    }
                    lv = irfn_vreg(&FN);
                    irfn_push(&FN, IR_SUB, IRT_U64, (u16)lv, (u16)hi, (u16)lo, 0, 0);
                    {
                        u32 a1 = irfn_vreg(&FN);
                        u32 a2 = irfn_vreg(&FN);

                        irfn_push(&FN, IR_LEA, IRT_PTR, (u16)a1, (u16)ta, 0, 0, 0);
                        store_conv(a1, ty_ptr(selt), pv, ty_ptr(selt));
                        irfn_push(&FN, IR_LEA, IRT_PTR, (u16)a2, (u16)ta, 0, 0, 8);
                        store_conv(a2, ty_ulong(), lv, ty_ulong());
                    }
                    GEN_TY = ty_slice_chk(selt);
                    PEND_LVAL = 1;
                    PEND_TY = GEN_TY;
                    PEND_ADDR = ta;
                    v = ta;
                    continue;
                }
            }
            idx = value_of(gen_expr());
            if (pa_is_ch(':')) {
                /* `s[lo:hi]`：把刚算出来的 lo 交给子切片那条路 */
                u32 lo = idx;
                u32 hi = 0;
                u32 tmp = 0;
                u32 ta = 0;
                u32 pv = 0;
                u32 lv = 0;
                u32 selt = ty_is_ptr(bty) || ty_is_array(bty) ? ty_target(bty) : ty_int();
                u32 se = ty_size(selt) ? ty_size(selt) : 1;

                /* 和上面 `[:hi]` 那条路同一个口径：指针不能切，长度未知的
                 * 数组也不能切（tests/errors/slice.c6 的 pointer_slice /
                 * unknown_length）。 */
                if (!was_slice) {
                    if (ty_is_ptr(bty) && !ty_is_array(bty))
                        pa_error("cannot slice a pointer; use '(T[:]){p, n}'");
                    else if (ty_is_array(bty) && ty_array_n(bty) == 0)
                        pa_error("cannot slice an array of unknown length");
                }
                pa_advance();
                if (!pa_is_ch(']')) {
                    hi = value_of(gen_expr());
                } else if (was_slice) {
                    hi = slice_len_load(slice_src);
                } else if (ty_is_array(bty)) {
                    hi = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)hi, 0, 0, 0, ty_array_n(bty));
                } else {
                    hi = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)hi, 0, 0, 0, 0);
                }
                pa_expect_ch(']');
                tmp = frame_slots_for(16);
                ta = irfn_vreg(&FN);
                irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)ta, 0, 0, 0, X64_SLOT(tmp));
                pv = irfn_vreg(&FN);
                if (se == 1 || se == 2 || se == 4 || se == 8) {
                    irfn_push(&FN, IR_LEA, IRT_PTR, (u16)pv, (u16)base, (u16)lo, 0, se);
                } else {
                    u32 kk = irfn_vreg(&FN);
                    u32 mm = irfn_vreg(&FN);

                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)kk, 0, 0, 0, se);
                    irfn_push(&FN, IR_MUL, IRT_U64, (u16)mm, (u16)lo, (u16)kk, 0, 0);
                    irfn_push(&FN, IR_ADD, IRT_PTR, (u16)pv, (u16)base, (u16)mm, 0, 0);
                }
                lv = irfn_vreg(&FN);
                irfn_push(&FN, IR_SUB, IRT_U64, (u16)lv, (u16)hi, (u16)lo, 0, 0);
                {
                    u32 a1 = irfn_vreg(&FN);
                    u32 a2 = irfn_vreg(&FN);

                    irfn_push(&FN, IR_LEA, IRT_PTR, (u16)a1, (u16)ta, 0, 0, 0);
                    store_conv(a1, ty_ptr(selt), pv, ty_ptr(selt));
                    irfn_push(&FN, IR_LEA, IRT_PTR, (u16)a2, (u16)ta, 0, 0, 8);
                    store_conv(a2, ty_ulong(), lv, ty_ulong());
                }
                GEN_TY = ty_slice_chk(selt);
                PEND_LVAL = 1;
                PEND_TY = GEN_TY;
                PEND_ADDR = ta;
                v = ta;
                continue;
            }
            pa_expect_ch(']');
            if (!ty_is_ptr(bty) && !ty_is_array(bty)) {
                pa_error("下标访问的对象不是数组也不是指针");
                bty = ty_ptr(ty_int());
            }
            elem = ty_target(bty);
            esz = ty_size(elem);
            if (esz == 0)
                esz = 1;
            off = irfn_vreg(&FN);
            if (esz == 1 || esz == 2 || esz == 4 || esz == 8) {
                irfn_push(&FN, IR_LEA, IRT_PTR, (u16)off, (u16)base, (u16)idx, 0, esz);
            } else {
                u32 k = irfn_vreg(&FN);
                u32 m = irfn_vreg(&FN);

                irfn_push(&FN, IR_CONST, IRT_U64, (u16)k, 0, 0, 0, esz);
                irfn_push(&FN, IR_MUL, IRT_U64, (u16)m, (u16)idx, (u16)k, 0, 0);
                irfn_push(&FN, IR_ADD, IRT_PTR, (u16)off, (u16)base, (u16)m, 0, 0);
            }
            mark_lval(off, elem);
            /* `h->arr[0]`：托管数组字段的元素也是托管引用（成员那一层已经把
             * PEND_MGD 标上了，下标这层不能把它抹掉）。 */
            if (pmgd)
                PEND_MGD = 1;
            v = off;
            continue;
        }
        /* 闭包调用：把闭包自己当隐藏的首参传给 env[0] 里的代码 */
        {
        u32 cft2 = 0;

        if (pa_is_ch('(') && ty_is_closure(GEN_TY, &cft2)) {
            u32 envv = value_of(v);
            u32 code = irfn_vreg(&FN);
            u32 args[16] = {0};
            u32 narg = 0;
            u32 i2 = 0;
            u32 dst = 0;

            args[narg++] = envv;
            pa_advance();
            if (!pa_accept_ch(')')) {
                for (;;) {
                    if (narg >= PA_ARG_MAX) {
                        pa_error("实参太多（上限 64）");
                        break;
                    }
                    args[narg] = value_of(gen_assign());
                    narg++;
                    if (!pa_accept_ch(','))
                        break;
                }
                pa_expect_ch(')');
            }
            irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)code, (u16)envv, 0, 0, 0);
            for (i2 = 0; i2 < narg; i2++)
                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)args[i2], 0, 0, i2);
            dst = irfn_vreg(&FN);
            irfn_push(&FN, IR_CALLI, ir_ty_of(ty_target(cft2)), (u16)dst, (u16)code, 0, 0, 0);
            FN.ops[FN.n - 1].narg = (u8)narg;
            if (ty_func_variadic(cft2))
                FN.ops[FN.n - 1].flags |= 1;   /* 变参：实参个数按实际传的算 */
            GEN_TY = ty_target(cft2);
            v = dst;
            continue;
        }
        }
        /* 间接调用：`(*fp)(…)` 或 `fp(…)`，fp 的类型是"指向函数的指针" */
        if (pa_is_ch('(')
            && (ty_is_func(GEN_TY) || (ty_is_ptr(GEN_TY) && ty_is_func(ty_target(GEN_TY))))) {
            u32 ft = ty_is_func(GEN_TY) ? GEN_TY : ty_target(GEN_TY);
            u32 fptr = value_of(v);
            u32 args[16] = {0};
            u32 narg = 0;
            u32 i2 = 0;
            u32 dst = 0;

            pa_advance();
            if (!pa_accept_ch(')')) {
                for (;;) {
                    if (narg >= PA_ARG_MAX) {
                        pa_error("实参太多（上限 64）");
                        break;
                    }
                    args[narg] = value_of(gen_assign());
                    narg++;
                    if (!pa_accept_ch(','))
                        break;
                }
                pa_expect_ch(')');
            }
            for (i2 = 0; i2 < narg; i2++)
                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)args[i2], 0, 0, i2);
            dst = irfn_vreg(&FN);
            irfn_push(&FN, IR_CALLI, ir_ty_of(ty_target(ft)), (u16)dst, (u16)fptr, 0, 0, 0);
            FN.ops[FN.n - 1].narg = (u8)narg;
            if (ty_func_variadic(ft))
                FN.ops[FN.n - 1].flags |= 1;
            GEN_TY = ty_target(ft);
            v = dst;
            continue;
        }
        /* 任务句柄上的内建成员：`t->wait()` / `t->done()` / `t->kind()` /
         * `t->cancel()` / `t->start()`。c6c 没有调度器，任务在创建时就同步
         * 跑完了，所以 start()/done() 都按"已结束"处理（和 __c6_co_state 一致）。 */
        /* 通用 `task` 句柄上的 `t->val`：val 在 {kind, state, val} 的偏移 16，
         * 按 long 读（具体任务结构是 `struct f_task *`，那种走普通成员）。 */
        /* `t->val`：`task` 句柄（TY_TASK）。手写 `struct X_task *` 的成员访问
         * 走下面的通用路径，只有成员是托管引用时才需要在这里接管。 */
        if (pa_is_punct("->") && ty_is_taskh(GEN_TY) && pa_peek(1)->kind == TK_IDENT
            && TOK_EQ(pa_peek(1), "val")) {
            u32 ao = 0;
            u32 av3 = 0;
            u32 vv3 = 0;

            pa_advance();
            pa_advance();
            ao = value_of(v);
            av3 = irfn_vreg(&FN);
            irfn_push(&FN, IR_LEA, IRT_PTR, (u16)av3, (u16)ao, 0, 0, 56);
            vv3 = irfn_vreg(&FN);
            irfn_push(&FN, IR_LOAD, IRT_I64, (u16)vv3, (u16)av3, 0, 0, 0);
            GEN_TY = ty_long();
            PEND_LVAL = 0;
            v = vv3;
            continue;
        }
        if (pa_is_punct("->")
            && (ty_is_task(GEN_TY) || ty_is_taskh(GEN_TY))
            && pa_peek(1)->kind == TK_IDENT
            && (TOK_EQ(pa_peek(1), "wait") || TOK_EQ(pa_peek(1), "done")
                || TOK_EQ(pa_peek(1), "kind") || TOK_EQ(pa_peek(1), "cancel")
                || TOK_EQ(pa_peek(1), "start"))) {
            int m = 0;
            u32 tv = 0;
            u32 dv = 0;

            if (TOK_EQ(pa_peek(1), "done"))
                m = 1;
            else if (TOK_EQ(pa_peek(1), "start"))
                m = 4;
            else if (TOK_EQ(pa_peek(1), "kind"))
                m = 2;
            else if (TOK_EQ(pa_peek(1), "cancel"))
                m = 3;
            pa_advance();
            pa_advance();
            if (pa_is_ch('(')) {
                pa_advance();
                pa_expect_ch(')');
            }
            tv = value_of(v);
            if (m == 3) {
                u32 zv = 0;

                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)tv, 0, 0, 0);
                zv = irfn_vreg(&FN);
                irfn_push(&FN, IR_CALL, IRT_VOID, (u16)zv, 0, 0, 0,
                          x64_sym(&X64, "__c6_co_destroy"));
                FN.ops[FN.n - 1].narg = 1;
                dv = irfn_vreg(&FN);
                irfn_push(&FN, IR_CONST, IRT_I64, (u16)dv, 0, 0, 0, 0);
            } else {
                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)tv, 0, 0, 0);
                dv = irfn_vreg(&FN);
                irfn_push(&FN, IR_CALL, IRT_I64, (u16)dv, 0, 0, 0,
                          x64_sym(&X64, m == 1 ? "__c6_co_state"
                                               : (m == 2 ? "__c6_co_kind"
                                                         : (m == 4 ? "__c6_co_start"
                                                                   : "__c6_co_wait"))));
                FN.ops[FN.n - 1].narg = 1;
                if (m == 1) {
                    /* done() = 状态等于 C6_CO_STATE_DONE(0) */
                    u32 z2 = irfn_vreg(&FN);
                    u32 c2 = irfn_vreg(&FN);

                    irfn_push(&FN, IR_CONST, IRT_I64, (u16)z2, 0, 0, 0, 0xFFFFFFFFu);
                    irfn_push(&FN, IR_CMP, IRT_I64, (u16)c2, (u16)dv, (u16)z2, 0, 0);
                    FN.ops[FN.n - 1].flags = (u8)IRCC_EQ;
                    dv = c2;
                }
            }
            GEN_TY = ty_int();
            PEND_LVAL = 0;
            v = dv;
            continue;
        }
        /* `h->done` / `h->value()`：thread 句柄上的两个内建成员。
         * 运行时的 pthread_create 是同步桩，"起线程"其实已经跑完了，所以
         * `done` 恒为 1；线程函数的返回值目前丢掉，`value()` 给 0（真做线程时
         * 在 __c6_thr_start 里把它存进句柄即可）。 */
        if (pa_is_punct("->") && ty_is_thread(GEN_TY) && pa_peek(1)->kind == TK_IDENT
            && (TOK_EQ(pa_peek(1), "wait") || TOK_EQ(pa_peek(1), "kind"))) {
            u32 wv = irfn_vreg(&FN);

            pa_advance();
            pa_advance();
            if (pa_is_ch('(')) {
                pa_advance();
                pa_expect_ch(')');
            }
            irfn_push(&FN, IR_CONST, IRT_I64, (u16)wv, 0, 0, 0, 0);
            GEN_TY = ty_int();
            PEND_LVAL = 0;
            v = wv;
            continue;
        }
        if (pa_is_punct("->") && ty_is_thread(GEN_TY) && pa_peek(1)->kind == TK_IDENT
            && TOK_EQ(pa_peek(1), "val")) {
            u32 vv2 = irfn_vreg(&FN);

            pa_advance();
            pa_advance();
            if (pa_is_ch('(')) {
                pa_advance();
                pa_expect_ch(')');
            }
            irfn_push(&FN, IR_CONST, IRT_I64, (u16)vv2, 0, 0, 0, 0);
            GEN_TY = ty_int();
            PEND_LVAL = 0;
            v = vv2;
            continue;
        }
        if (pa_is_punct("->") && ty_is_thread(GEN_TY) && pa_peek(1)->kind == TK_IDENT
            && (TOK_EQ(pa_peek(1), "done") || TOK_EQ(pa_peek(1), "value"))) {
            int is_done = TOK_EQ(pa_peek(1), "done");
            u32 hv2 = value_of(v);
            u32 hp2 = irfn_vreg(&FN);
            u32 dv2 = irfn_vreg(&FN);
            u32 fs2 = x64_sym(&X64, is_done ? "__c6_th_done" : "__c6_th_value");

            pa_advance();
            pa_advance();
            if (pa_is_ch('(')) {      /* `h->done()` 也认 */
                pa_advance();
                pa_expect_ch(')');
            }
            irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)hp2, (u16)hv2, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)hp2, 0, 0, 0);
            irfn_push(&FN, IR_CALL, IRT_I64, (u16)dv2, 0, 0, 0, fs2);
            FN.ops[FN.n - 1].narg = 1;
            GEN_TY = is_done ? ty_int() : ty_ptr(ty_void());
            PEND_LVAL = 0;
            v = dv2;
            continue;
        }
        if (pa_is_punct("->") && ty_is_thread(GEN_TY) && pa_peek(1)->kind == TK_IDENT
            && TOK_EQ(pa_peek(1), "value") && pa_peek(2)->kind == TK_PUNCT
            && tok_eq(pa_peek(2), "(")) {
            u32 dv3 = irfn_vreg(&FN);

            pa_advance();
            pa_advance();
            pa_advance();
            pa_expect_ch(')');
            irfn_push(&FN, IR_CONST, IRT_I64, (u16)dv3, 0, 0, 0, 0);
            GEN_TY = ty_int();
            PEND_LVAL = 0;
            v = dv3;
            continue;
        }
        /* `h->join()`：thread 句柄的 join 走 pthread_join */
        if (pa_is_punct("->") && ty_is_thread(GEN_TY) && pa_peek(1)->kind == TK_IDENT
            && TOK_EQ(pa_peek(1), "join") && pa_peek(2)->kind == TK_PUNCT
            && tok_eq(pa_peek(2), "(")) {
            u32 hv = value_of(v);
            u32 pj = x64_sym(&X64, "pthread_join");
            u32 a0 = irfn_vreg(&FN);
            u32 zz = irfn_vreg(&FN);
            u32 dd = irfn_vreg(&FN);

            pa_advance();                    /* -> */
            pa_advance();                    /* join */
            pa_advance();                    /* ( */
            pa_expect_ch(')');
            irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)a0, (u16)hv, 0, 0, 0);
            irfn_push(&FN, IR_CONST, IRT_U64, (u16)zz, 0, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)a0, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)zz, 0, 0, 1);
            irfn_push(&FN, IR_CALL, IRT_I64, (u16)dd, 0, 0, 0, pj);
            FN.ops[FN.n - 1].narg = 2;
            GEN_TY = ty_int();
            PEND_LVAL = 0;
            v = dd;
            continue;
        }
        if (pa_is_ch('.') || pa_is_punct("->")) {
            int is_arrow = pa_is_punct("->");
            u32 base = 0;

            u32 bty = 0;
            u32 addr = 0;
            Tok *mt = NULL;
            const char *mname = NULL;
            u32 mlen = 0;
            int idx = -1;
            u32 off = 0;
            u32 mty = 0;
            u32 a2 = 0;

            pa_advance();
            if (E_WEAK && in_c6_tu()) {
                char dnm[160] = {0};

                agg_disp_name(ty_target(GEN_TY), dnm, sizeof(dnm));
                pa_error("cannot use a 'weak @%s' directly: upgrade it first "
                         "('@T q = w;')", dnm);
                E_WEAK = 0;
            }
            if (is_arrow) {
                /* p->m：先取值（指针），对象类型是它的元类型 */
                base = value_of(v);
                bty = ty_target(GEN_TY);
                addr = base;
            } else {
                /* s.m：左值就取地址；聚合**值**（函数返回的结构体、复合字面量）
                 * 在我们的约定里本来就是"用地址代表值"，直接当基址用。 */
                if (!PEND_LVAL && ty_is_agg(GEN_TY)) {
                    addr = v;
                    bty = GEN_TY;
                } else if (!PEND_LVAL) {
                    /* 标量上的方法调用：`dec_parse(...).round(2)` 里接收者是个
                     * 值。先记下来，等会儿成员找不到时按方法糖处理（把值本身
                     * 当接收者传），找不到方法才报错。 */
                    addr = v;
                    bty = GEN_TY;
                } else {
                    addr = PEND_ADDR;
                    bty = PEND_TY;
                    PEND_LVAL = 0;
                }
            }
            /* 注意：pa_cur() 指向前瞻窗口，advance 会把窗口左移，
             * 所以必须**先按值拷出来**再 advance，否则读到的名字是下一个 token。 */
            mname = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
            mlen = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
            mt = pa_cur();
            if (mt->kind != TK_IDENT) {
                pa_error("'.' 后面要成员名");
                GEN_TY = ty_int();
                continue;
            }
            pa_advance();
            /* 接口值：`s.f(args)` → `vt[idx](self, args)`（胖指针在 addr） */
            {
                u32 ifix = 0;

                if (NIFACE > 0 && ty_is_iface(bty, &ifix)) {
                    u32 k = 0;
                    u32 mi = IFACE_NM[ifix];
                    u32 fnv = 0;
                    u32 selfv = 0;
                    u32 avs[16] = {0};
                    u32 narg = 0;
                    u32 dst3 = 0;

                    for (k = 0; k < IFACE_NM[ifix]; k++)
                        if (IFACE_MLEN[ifix][k] == mlen
                            && memcmp(IFACE_MET[ifix][k], mname, mlen) == 0) {
                            mi = k;
                            break;
                        }
                    if (mi >= IFACE_NM[ifix]) {
                        pa_error("接口 '%.*s' 没有方法 '%.*s'",
                                 (int)IFACE_NLEN[ifix], IFACE_NAME[ifix],
                                 (int)mlen, mname);
                        GEN_TY = ty_int();
                        continue;
                    }
                    selfv = irfn_vreg(&FN);
                    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)selfv, (u16)addr, 0, 0, 0);
                    {
                        u32 a8 = gen_addr_off(addr, 8);
                        u32 vtv = irfn_vreg(&FN);

                        irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)vtv, (u16)a8, 0, 0, 0);
                        fnv = irfn_vreg(&FN);
                        irfn_push(&FN, IR_LEA, IRT_PTR, (u16)fnv, (u16)vtv, 0, 0, mi * 8);
                        irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)fnv, (u16)fnv, 0, 0, 0);
                    }
                    avs[narg++] = selfv;
                    if (pa_accept_ch('(')) {
                        if (!pa_accept_ch(')')) {
                            for (;;) {
                                if (narg < 16)
                                    avs[narg++] = value_of(gen_assign());
                                if (!pa_accept_ch(','))
                                    break;
                            }
                            pa_expect_ch(')');
                        }
                    }
                    for (k = 0; k < narg; k++)
                        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)avs[k], 0, 0, k);
                    dst3 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CALLI, IRT_I64, (u16)dst3, (u16)fnv, 0, 0, 0);
                    FN.ops[FN.n - 1].narg = (u8)narg;
                    GEN_TY = IFACE_RET[ifix][mi] ? IFACE_RET[ifix][mi] : ty_int();
                    PEND_LVAL = 0;
                    v = dst3;
                    continue;
                }
            }
            if (!ty_is_agg(bty) || !agg_find_promoted(bty, mname, mlen, &mty, &off)) {
                /* c6 方法调用语法糖：`x->cmp(a)` / `x.cmp(a)` == `cmp(x, a)`
                 * （第一个形参是接收者）。找不到同名函数才报错。 */
                /* 先按接收者类型找（同名函数可能有多个重载/被全局变量遮住），
                 * 找不到再退回普通查名 */
                Sym *ms = meth_find(bty, mname, mlen);

                if (!ms)
                    ms = sym_find(mname, mlen);
                if (ms && ms->is_func) {
                    u32 avs[16] = {0};
                    u32 narg = 0;
                    u32 k2 = 0;
                    u32 dst2 = 0;

                    /* 只有"正好一个接收者参数"的 drop 才是析构；同名但带
                     * 别的参数的是普通方法（`std/container/span.c6` 的
                     * `Span drop(Span *self, int n)`）。 */
                    if (!pa_is_ch('('))
                        pa_error("method '%.*s' must be called", (int)mlen, mname);
                    if (ms->len == 4 && memcmp(ms->name, "drop", 4) == 0
                        && ty_func_nparams(ms->type) == 1 && drop_is_sym((u32)ms->val))
                        pa_error("析构函数不能直接调用：最后一个引用放掉时它自己会跑（`p = NULL` 就够了）");
                    avs[narg++] = is_arrow ? base : addr;
                    if (pa_accept_ch('(')) {
                        if (!pa_accept_ch(')')) {
                            for (;;) {
                                if (narg < 16)
                                    avs[narg++] = value_of(gen_assign());
                                if (!pa_accept_ch(','))
                                    break;
                            }
                            pa_expect_ch(')');
                        }
                    }
                    for (k2 = 0; k2 < narg; k2++)
                        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)avs[k2], 0, 0, k2);
                    dst2 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CALL, ir_ty_of(ty_target(ms->type)), (u16)dst2,
                              0, 0, 0, (u32)ms->val);
                    FN.ops[FN.n - 1].narg = (u8)narg;
                    GEN_TY = ty_target(ms->type);
                    PEND_LVAL = 0;
                    v = dst2;
                    continue;
                }
                /* 接收者是模板实例时，方法可能是**函数模板**
                 * （`|T| T vat(Vect@T *self, int i)`）：按实例的实参把它
                 * 实例化出来再调。注意实例化会就地发射函数体，所以外层函数
                 * 的指令要连内容一起备份。 */
                if (!ms) {
                    u32 targs[TMPL_NPARAM] = {0};
                    u32 tna = 0;
                    int ti = tmpl_args_of_ty(bty, targs, &tna);

                    if (ti >= 0) {
                        Tmpl *tp = tmpl_find(mname, mlen);

                        if (tp && tp->is_func && tna == tp->nparam) {
                            u32 n0 = FN.n;
                            IrOp *bak = arena_alloc(&A_main,
                                                    (size_t)(n0 ? n0 : 1) * sizeof(IrOp));
                            TmplSaved sv2 = {0};
                            u32 fsid = 0;
                            u32 k3 = 0;
                            int dup = 0;

                            if (n0)
                                memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
                            tmpl_save_state(&sv2);
                            fsid = tmpl_func_sig(tp, targs, tna);
                            tmpl_restore_state(&sv2);
                            if (n0)
                                memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
                            if (fsid) {
                                char nm2[320] = {0};

                                tmpl_mangle_name(tp, targs, tna, nm2, sizeof(nm2));
                                ms = sym_find(nm2, (u32)strlen(nm2));
                                for (k3 = 0; k3 < NFW; k3++) {
                                    u32 j3 = 0;
                                    int same = (FW_T[k3] == tp);

                                    if (same) {
                                        for (j3 = 0; j3 < TMPL_NPARAM; j3++)
                                            if (FW_A[k3][j3] != targs[j3])
                                                same = 0;
                                    }
                                    if (same)
                                        dup = 1;
                                }
                                if (!dup && NFW < FW_MAX) {
                                    for (k3 = 0; k3 < TMPL_NPARAM; k3++)
                                        FW_A[NFW][k3] = targs[k3];
                                    FW_T[NFW] = tp;
                                    NFW++;
                                }
                            }
                        }
                    }
                }
                if (ms && ms->is_func) {
                    u32 avs[16] = {0};
                    u32 narg = 0;
                    u32 k2 = 0;
                    u32 dst3 = 0;

                    /* 方法只能**调用**：写成值（`p->vec_sum`）拿到的是把
                     * 接收者当唯一实参的一次调用，语义完全不同
                     * （tests/errors/method.c6 的两条 without_call）。 */
                    if (!pa_is_ch('('))
                        pa_error("method '%.*s' must be called", (int)mlen, mname);
                    avs[narg++] = is_arrow ? base : addr;
                    if (pa_accept_ch('(')) {
                        if (!pa_accept_ch(')')) {
                            for (;;) {
                                if (narg < 16)
                                    avs[narg++] = value_of(gen_assign());
                                if (!pa_accept_ch(','))
                                    break;
                            }
                            pa_expect_ch(')');
                        }
                    }
                    for (k2 = 0; k2 < narg; k2++)
                        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)avs[k2], 0, 0, k2);
                    dst3 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CALL, ir_ty_of(ty_target(ms->type)), (u16)dst3,
                              0, 0, 0, (u32)ms->val);
                    FN.ops[FN.n - 1].narg = (u8)narg;
                    GEN_TY = ty_target(ms->type);
                    PEND_LVAL = 0;
                    v = dst3;
                    continue;
                }
                pa_error("结构体没有成员 '%.*s'", (int)mlen, mname);
                GEN_TY = ty_int();
                v = addr;
                continue;
            }
            a2 = addr;
            if (off) {
                a2 = irfn_vreg(&FN);
                irfn_push(&FN, IR_LEA, IRT_PTR, (u16)a2, (u16)addr, 0, 0, off);
            }
            mark_lval(a2, mty);
            if (mgdst_kind(bty, AGG_FOUND_IDX))
                /* 1 = 托管引用，2 = 弱引用（赋值走登记，读走升级） */
                PEND_MGD = mgdst_kind(bty, AGG_FOUND_IDX);
            PEND_BITS = AGG_FOUND_BITS;     /* 位域整型提升交给 cur_op_ty */
            PEND_BITOFF = AGG_FOUND_BITOFF;
            PEND_BF_ENUM = AGG_FOUND_ENUMBF;
            v = a2;
            continue;
        }
        if (pa_is_punct("++") || pa_is_punct("--")) {
            int inc = pa_is_punct("++");
            u32 addr = 0;
            u32 ty = 0;
            u32 old_v = 0;
            u32 one = 0;
            u32 nv = 0;

            pa_advance();
            if (!PEND_LVAL) {
                pa_error("++/-- 需要一个左值");
                continue;
            }
            {
                u32 bb = PEND_BITS;
                u32 bb_off = PEND_BITOFF;

                addr = PEND_ADDR;
                ty = PEND_TY;
                PEND_LVAL = 0;
                /* 位域要按字段取值/写回，不能整单元读改写 */
                old_v = bb ? load_bf(addr, ty, bb, bb_off, ty_is_signed(ty), PEND_BF_ENUM)
                           : load_lval(addr, ty);
                one = irfn_vreg(&FN);
                /* 指针的 ++/-- 要按**元素大小**步进（`struct R *q; q++` 加的是 24） */
                irfn_push(&FN, IR_CONST, IRT_U64, (u16)one, 0, 0, 0,
                          ty_is_ptr(ty) ? (ty_size(ty_target(ty)) ? ty_size(ty_target(ty)) : 1) : 1);
                nv = irfn_vreg(&FN);
                irfn_push(&FN, inc ? IR_ADD : IR_SUB, ir_ty_of(ty), (u16)nv, (u16)old_v,
                          (u16)one, 0, 0);
                if (bb)
                    store_lval_bits(addr, ty, bb, bb_off, nv);
                else
                    store_lval(addr, ty, nv);
            }
            GEN_TY = ty;
            v = old_v;
            continue;
        }
        break;
    }
    return v;
}


/* 整数字面量的"值 + 类型"：C 的规则简化版。
 * v 已经无符号解析出来；base 用来区分十进制/八进制十六进制的提升顺序，
 * uns/lng 是后缀的 U 与 L 个数（lng=2 表示 LL）。 */
static u32 lit_type(u64 v, int uns, int lng, int base)
{
    if (lng >= 2) {
        if (uns)
            return ty_ullong();
        return v <= 0x7FFFFFFFFFFFFFFFULL ? ty_llong() : ty_ullong();
    }
    if (uns) {
        if (v <= 0xFFFFFFFFULL)
            return ty_uint();
        if (lng >= 1)
            return v <= 0xFFFFFFFFFFFFFFFFULL ? ty_ulong() : ty_ullong();
        return ty_ulong();
    }
    if (lng >= 1) {
        if (v <= 0x7FFFFFFFFFFFFFFFULL)
            return ty_long();
        return ty_ulong();
    }
    if (base == 10) {
        if (v <= 0x7FFFFFFFULL)
            return ty_int();
        if (v <= 0x7FFFFFFFFFFFFFFFULL)
            return ty_long();
        return ty_ullong();
    }
    if (v <= 0x7FFFFFFFULL)
        return ty_int();
    if (v <= 0xFFFFFFFFULL)
        return ty_uint();
    if (v <= 0x7FFFFFFFFFFFFFFFULL)
        return ty_long();
    return ty_ulong();
}

/* 后缀扫描：U/u 一个、L/l 一到两个（大小写混写也认） */
static void lit_suffix(const char *s, u32 len, int *uns, int *lng, int *nbase)
{
    u32 i = len;
    int nl = 0;

    *uns = 0;
    *lng = 0;
    while (i > 0) {
        char c = s[i - 1];

        if (c == 'u' || c == 'U') {
            *uns = 1;
            i--;
        } else if (c == 'l' || c == 'L') {
            nl++;
            i--;
        } else {
            break;
        }
    }
    *lng = nl >= 2 ? 2 : (nl == 1 ? 1 : 0);
    /* 进制：0x/0X 开头是 16，0 开头是 8，否则 10 */
    *nbase = 10;
    if (i >= 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
        *nbase = 16;
    else if (i >= 2 && s[0] == '0' && (s[1] == 'b' || s[1] == 'B'))
        *nbase = 2;
    else if (i >= 2 && s[0] == '0')
        *nbase = 8;
}

/* 整数字面量 → vreg：类型按值/后缀定，超出 32 位的值走常量池 */
static u32 gen_int_lit(u64 c, u32 ty)
{
    u32 d = irfn_vreg(&FN);
    u32 irt = ir_ty_of(ty);

    if (c <= 0xFFFFFFFFULL)
        irfn_push(&FN, IR_CONST, irt, (u16)d, 0, 0, 0, (u32)c);
    else
        irfn_push(&FN, IR_CONSTK, irt, (u16)d, 0, 0, 0, irfn_kconst(&FN, c));
    GEN_TY = ty;
    return d;
}


/* 浮点字面量的**数值**（float 字面量也按 double 返回，别拿 float 的位模式
 * 去当 double 用——踩过：`float x = 12.5f;` 存进去是 5e-324）。 */
static double float_lit_d(const char *s, u32 n)
{
    int is32 = 0;
    u64 b = float_lit_bits(s, n, &is32);
    double dv = 0;

    if (is32) {
        u32 b32 = (u32)b;
        float fv = 0;

        *(u32 *)&fv = b32;
        return (double)fv;
    }
    *(u64 *)&dv = b;
    return dv;
}

/* 数据段初始化器里的浮点常量表达式：字面量、整数、括号、+ - * /。
 * 别的（标识符、cast、函数调用）一律 ok=0，由调用方决定怎么兜底。 */
static double const_fexpr(int *ok);

static double const_fprim(int *ok)
{
    Tok *t = pa_cur();
    double v = 0;

    if (pa_accept_ch('(')) {
        v = const_fexpr(ok);
        if (pa_is_ch(')'))
            pa_advance();
        else
            *ok = 0;
        return v;
    }
    if (pa_accept_ch('-'))
        return -const_fprim(ok);
    if (pa_accept_ch('+'))
        return const_fprim(ok);
    if (t->kind == TK_NUM) {
        if (is_float_lit(tok_data(t), t->len)) {
            v = float_lit_d(tok_data(t), t->len);
            pa_advance();
            return v;
        }
        v = (double)(i64)int_lit_val(tok_data(t), t->len);
        pa_advance();
        return v;
    }
    *ok = 0;
    return 0;
}

static double const_fmul(int *ok)
{
    double v = const_fprim(ok);

    for (;;) {
        if (pa_accept_ch('*')) {
            v = v * const_fprim(ok);
        } else if (pa_accept_ch('/')) {
            double r = const_fprim(ok);

            if (r == 0) {
                *ok = 0;
                return 0;
            }
            v = v / r;
        } else {
            return v;
        }
    }
}

static double const_fexpr(int *ok)
{
    double v = const_fmul(ok);

    for (;;) {
        if (pa_accept_ch('+'))
            v = v + const_fmul(ok);
        else if (pa_accept_ch('-'))
            v = v - const_fmul(ok);
        else
            return v;
    }
}

static u32 gen_postfix(void)
{
    Tok *t = pa_cur();
    u32 v = 0;

    /* 默认不是空指针常量：只有字面量 0（和它的指针强转）会重新置 1 */
    E_NPC = 0;

    if (t->kind == TK_NUM && is_float_lit(tok_data(t), t->len)) {
        int is32 = 0;
        u64 bits = float_lit_bits(tok_data(t), t->len, &is32);
        u32 fty = is32 ? ty_float() : ty_double();
        u32 d = irfn_vreg(&FN);

        pa_advance();
        irfn_push(&FN, IR_CONSTK, ir_ty_of(fty), (u16)d, 0, 0, 0,
                  irfn_kconst(&FN, bits));
        GEN_TY = fty;
        return gen_postfix_ops(d);
    }
    if (t->kind == TK_NUM) {
        u64 c = int_lit_val(tok_data(t), t->len);
        int uns = 0;
        int lng = 0;
        int nbase = 10;
        u32 d = 0;

        lit_suffix(tok_data(t), t->len, &uns, &lng, &nbase);
        pa_advance();
        E_NPC = (c == 0);      /* 字面量 0 是空指针常量 */
        d = gen_int_lit(c, lit_type(c, uns, lng, nbase));
        return gen_postfix_ops(d);
    }
    if (t->kind == TK_CHAR) {
        u64 c = (u64)char_lit_val(t);
        u32 d = 0;

        pa_advance();
        d = gen_int_lit(c, ty_int());
        return gen_postfix_ops(d);
    }
    if (t->kind == TK_STR)
        return gen_postfix_ops(gen_string());
    /* c6 的 `err(id, msg)`：错误通道的构造子。完整语义（T!error 返回类型、
     * catch、or 默认值）还没做，这里先当"值 = id"的 int 表达式，测试块能跑。 */
    /* `c6_io(fd, ev)` 只有在 `await` 的操作数位置才合法：挂起点必须写成
     * `await c6_io(…)`，别的地方调用它等于"要看一眼就绪、不用挂起"。 */
    if (t->kind == TK_IDENT && TOK_EQ(t, "c6_io") && pa_peek(1)
        && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(") && !PA_AWAIT_IO)
        pa_error("c6_io 只能写成 'await c6_io(fd, ev)'");
    if (t->kind == TK_IDENT && TOK_EQ(t, "err") && pa_peek(1)
        && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")) {
        u32 d = 0;

        /* 错误只走"返回"这一条路：`err(..)` 写在语句/条件/初始化器里都拦下来
         * （tests/errors/err_usage.c6）。 */
        if (!PA_RET_EXPR)
            pa_error("'err' can only be used as 'return err(id, msg)'");

        pa_advance();
        pa_advance();
        d = value_of(gen_assign());
        if (pa_accept_ch(',')) {
            /* 消息存进运行时的全局，`catch e { e.msg }` 从那里取 */
            u32 mv = value_of(gen_assign());
            Sym *g = sym_find("c6c_err_msg", 11);

            if (g) {
                u32 a = ident_addr(g);

                store_conv(a, ty_ptr(ty_char()), mv, cur_op_ty());
            }
        }
        pa_expect_ch(')');
        /* 同时把运行时的错误状态置上：`T!error` 函数的调用方靠它判断
         * （值本身仍是 id，测试块 `return err(N, …)` 的约定不变）。 */
        {
            u32 idv = irfn_vreg(&FN);
            u32 msv = irfn_vreg(&FN);
            u32 ign = irfn_vreg(&FN);
            Sym *gm2 = sym_find("c6c_err_msg", 11);

            if (gm2) {
                irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)msv, (u16)ident_addr(gm2), 0, 0, 0);
            } else {
                irfn_push(&FN, IR_CONST, IRT_U64, (u16)msv, 0, 0, 0, 0);
            }
            /* id 是运行期算出来的 vreg，不是常量——以前这里把 vreg 号当成立即数
             * 塞进 IR_CONST，`__tcc_err_set` 收到的 id 全是错的。 */
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)d, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)msv, 0, 0, 1);
            irfn_push(&FN, IR_CALL, IRT_VOID, (u16)ign, 0, 0, 0,
                      x64_sym(&X64, "__tcc_err_set"));
            FN.ops[FN.n - 1].narg = 2;
        }
        GEN_TY = ty_int();
        return gen_postfix_ops(d);
    }
    /* `move(x)`：c6 的"交出所有权"。值原样给出（不加计数），但**源槽必须
     * 清零**——不然源槽退出作用域时会再放一次，被交出去的对象就到 0 又被
     * 摘掉（踩过：own 树测试里 gc_live 一路减到 -2）。 */
    if (t->kind == TK_IDENT && TOK_EQ(t, "move") && pa_peek(1)
        && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")) {
        u32 mv2 = 0;
        u32 mty2 = 0;
        u32 maddr = 0;
        int mlval = 0;
        u32 mty3 = 0;

        pa_advance();
        pa_advance();
        PA_MOVE_OPERAND = 1;
        mv2 = gen_assign();
        PA_MOVE_OPERAND = 0;
        mty2 = GEN_TY;
        mlval = PEND_LVAL;
        maddr = PEND_ADDR;
        mty3 = PEND_TY;
        mv2 = value_of(mv2);
        pa_expect_ch(')');
        if (!mlval)
            pa_error("'move' 需要一个左值（要能把源槽清零）");
        /* 只接受"槽里的托管引用"：`move(3)` / `move(s.p)` 这种没有源槽可清零 */
        if (!PEND_MGD_SYM || PEND_MGD_SYM->is_mgd != 1) {
            char tnb[96] = {0};

            agg_disp_name(mty3, tnb, sizeof(tnb));
            pa_error("'move' needs a managed reference held in a slot, not a '%s'",
                     tnb[0] ? tnb : "?");
        } else {
            if (mv_has(PEND_MGD_SYM->slot))
                pa_error("'%s' was moved: assign a new reference before using it",
                         PEND_MGD_SYM->name ? PEND_MGD_SYM->name : "?");
            mv_set(PEND_MGD_SYM->slot);
        }
        /* 交出去的值是"一份新所有权"：没人接手（`move(a);` 这种光秃秃的
         * 语句）就在语句末尾放掉，被赋值/传参接走了就从待释放表里摘掉。 */
        mgd_tmp_take(mv2);
        mgd_tmp_add(mv2);
        if (ty_is_ptr(mty3)) {
            u32 z0 = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, (u16)z0, 0, 0, 0, 0);
            store_lval(maddr, mty3, z0);
        }
        GEN_TY = mty2;
        PEND_MGD = 0;
        PEND_MGD_SYM = NULL;
        return gen_postfix_ops(mv2);
    }
    if (t->kind == TK_IDENT && (TOK_EQ(t, "alloca") || TOK_EQ(t, "__builtin_alloca"))) {
        if (CUR_TASK_TY)
            pa_error("async 函数里不能用 alloca");
        /* alloca/__builtin_alloca：两条路。
         *   - 大小是**字面量**：直接开一个帧槽（不碰 rsp，函数尾声自然回收）；
         *   - 大小是运行期表达式（`alloca(strlen(s)+1)`、`alloca(n*2)`）：走
         *     VLA 那条 IR_ALLOCA（`rsp - align16(字节数)`），三个后端都已经
         *     实现了。以前这里报"必须是编译期常量"，tcc 上游的 boundtest.c
         *     正是拿它当标准用法。 */
        u64 n = 0;
        u32 addr = 0;

        pa_advance();
        pa_expect_ch('(');
        if (pa_cur()->kind == TK_NUM && parse_const_u64(&n)) {
            pa_expect_ch(')');
            {
                u32 slot = frame_slots_for((u32)n);

                addr = irfn_vreg(&FN);
                irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)addr, 0, 0, 0, X64_SLOT(slot));
            }
        } else {
            u32 cnt = value_of(gen_assign());

            pa_expect_ch(')');
            addr = irfn_vreg(&FN);
            /* imm = 1：a 直接就是字节数 */
            irfn_push(&FN, IR_ALLOCA, IRT_PTR, (u16)addr, (u16)cnt, 0, 0, 1);
        }
        GEN_TY = ty_ptr(ty_void());
        return gen_postfix_ops(addr);
    }
    if (TOK_EQ(t, "__builtin_syscall")) {
        /* __builtin_syscall(nr, a1..a6)：FreeBSD 风格，最多 6 个参数 */
        u32 d = 0;
        u32 k = 0;

        pa_advance();
        pa_expect_ch('(');
        for (k = 0; k < 7; k++) {
            u32 a = value_of(gen_assign());

            irfn_push(&FN, IR_ARG, IRT_VOID, 0, (u16)a, 0, 0, k);
            if (!pa_accept_ch(','))
                break;
        }
        pa_expect_ch(')');
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_I64, (u16)d, 0, 0, 0, 0);
        FN.ops[FN.n - 1].flags |= 2;
        GEN_TY = ty_long();
        return d;
    }
    if (t->kind == TK_IDENT &&
        (TOK_EQ(t, "__builtin_va_start") || TOK_EQ(t, "__builtin_va_arg") ||
         TOK_EQ(t, "__builtin_va_end"))) {
        int kind = TOK_EQ(t, "__builtin_va_start") ? 0
                   : TOK_EQ(t, "__builtin_va_arg") ? 1 : 2;
        u32 ap = 0;
        u32 ty = 0;
        u32 d = 0;

        pa_advance();
        pa_expect_ch('(');
        ap = value_of(gen_assign());
        if (kind == 0) {
            pa_expect_ch(')');
            irfn_push(&FN, IR_VASTART, IRT_VOID, 0, (u16)ap, 0, 0, FN.nparams * 8);
            d = irfn_vreg(&FN);
            irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0, 0);
            GEN_TY = ty_int();
            return d;
        }
        if (kind == 1) {
            pa_expect_ch(',');
            ty = parse_typename();
            pa_expect_ch(')');
            d = irfn_vreg(&FN);
            irfn_push(&FN, IR_VAARG, ir_ty_of(ty), (u16)d, (u16)ap, 0, 0, 0);
            if (ty_size(ty) < 8 && ty_size(ty) > 0) {
                u32 t2 = irfn_vreg(&FN);

                irfn_push(&FN, IR_TRUNC, ir_ty_of(ty), (u16)t2, (u16)d, 0, 0, 0);
                d = t2;
            }
            GEN_TY = ty;
            return d;
        }
        pa_expect_ch(')');
        irfn_push(&FN, IR_VAEND, IRT_VOID, 0, (u16)ap, 0, 0, 0);
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0, 0);
        GEN_TY = ty_int();
        return d;
    }
    /* _Generic(控制表达式, 类型: 表达式, …, default: 表达式)
     * 每个分支都照常生成 IR，记下各自的区间；选中的那一段搬到结果位置，
     * 其余丢掉。vreg 编号互不冲突，搬动是安全的。 */
    if (TOK_EQ(t, "_Generic")) {
        u32 cty = 0;
        u32 sel = 0;
        u32 k = 0;
        u32 nassoc = 0;
        u32 aty[32] = {0};
        u32 ast[32] = {0};
        u32 aen[32] = {0};
        u32 avl[32] = {0};
        u32 res = 0;
        u32 rty = 0;
        int pick = -1;
        int def = -1;

        pa_advance();
        pa_expect_ch('(');
        {
            u32 save0 = FN.n;

            (void)gen_assign();
            cty = GEN_TY;
            FN.n = save0;
            PEND_LVAL = 0;
        }
        sel = FN.n;
        while (pa_accept_ch(',')) {
            u32 at = 0;
            u32 st = 0;
            u32 v2 = 0;

            skip_attributes();
            if (PA_IS_IDENT("default")) {
                pa_advance();
                at = 0;
            } else {
                at = parse_typename();
            }
            pa_expect_ch(':');
            st = FN.n;
            v2 = value_of(gen_assign());
            if (nassoc < 32) {
                aty[nassoc] = at;
                ast[nassoc] = st;
                aen[nassoc] = FN.n;
                avl[nassoc] = v2;
                nassoc++;
            }
        }
        pa_expect_ch(')');
        for (k = 0; k < nassoc; k++) {
            if (aty[k] == 0) {
                if (def < 0)
                    def = (int)k;
            } else if (aty[k] == cty && pick < 0) {
                pick = (int)k;
            }
        }
        if (pick < 0)
            pick = def;
        if (pick < 0) {
            pa_error("_Generic 没有匹配的类型分支");
            GEN_TY = ty_int();
            return 0;
        }
        k = (u32)pick;
        if (aen[k] > ast[k]) {
            memmove(&FN.ops[sel], &FN.ops[ast[k]], (size_t)(aen[k] - ast[k]) * sizeof(IrOp));
            FN.n = sel + (aen[k] - ast[k]);
        } else {
            FN.n = sel;
        }
        res = avl[k];
        rty = ty_int();
        {
            /* 分支类型：再看一眼它的表达式类型（上面记录时已算过） */
            rty = GEN_TY;
        }
        GEN_TY = rty;
        return gen_postfix_ops(res);
    }
    /* 内建函数：能直接映射的就地映射，其余按恒等/常量处理 */
    /* `__atomic_*` 内建：读改写走运行期的 __c6_at_*（lib/rt.c6，自旋锁里
     * 一起做完「读→算→写」）。以前这里是「load; 算; store」三条 IR，
     * 单线程看不出问题，16 个真线程并发就丢更新（tests2/124_atomic_counter）。
     * 注意 tcc 的 stdatomic.h 用的是**泛型**形式（第二个参数是 &值），
     * 不是 _n 形式，两种都要认。 */
    if (TOK_EQ(t, "__atomic_load_n") || TOK_EQ(t, "__atomic_load")) {
        int generic = TOK_EQ(t, "__atomic_load");
        u32 p = 0;
        u32 pty = 0;
        u32 d = 0;
        u32 rp = 0;

        pa_advance();
        pa_expect_ch('(');
        p = value_of(gen_assign());
        pty = ty_is_ptr(GEN_TY) ? ty_target(GEN_TY) : ty_int();
        if (generic) {
            pa_expect_ch(',');
            rp = value_of(gen_assign());     /* &结果 */
        }
        while (pa_accept_ch(','))
            (void)value_of(gen_assign());
        pa_expect_ch(')');
        d = load_lval(p, pty);
        if (generic && rp)
            store_conv(rp, pty, d, pty);
        GEN_TY = pty;
        return gen_postfix_ops(d);
    }
    if (TOK_EQ(t, "__atomic_store_n") || TOK_EQ(t, "__atomic_store")) {
        int generic = TOK_EQ(t, "__atomic_store");
        u32 p = 0;
        u32 pty = 0;
        u32 v2 = 0;

        pa_advance();
        pa_expect_ch('(');
        p = value_of(gen_assign());
        pty = ty_is_ptr(GEN_TY) ? ty_target(GEN_TY) : ty_int();
        pa_expect_ch(',');
        v2 = value_of(gen_assign());
        if (generic)
            v2 = load_lval(v2, pty);         /* 参数是 &值 */
        while (pa_accept_ch(','))
            (void)value_of(gen_assign());
        pa_expect_ch(')');
        store_conv(p, pty, v2, pty);
        GEN_TY = ty_void();
        return 0;
    }
    if (TOK_EQ(t, "__atomic_thread_fence") || TOK_EQ(t, "__atomic_signal_fence")
        || TOK_EQ(t, "__sync_synchronize")) {
        pa_advance();
        if (pa_accept_ch('(')) {
            while (!pa_is_ch(')') && pa_cur()->kind != TK_EOF)
                (void)value_of(gen_assign()), pa_accept_ch(',');
            pa_expect_ch(')');
        }
        GEN_TY = ty_void();
        return 0;
    }
    if (TOK_EQ(t, "__atomic_exchange_n") || TOK_EQ(t, "__atomic_exchange")
        || TOK_EQ(t, "__atomic_fetch_add")
        || TOK_EQ(t, "__atomic_fetch_sub") || TOK_EQ(t, "__atomic_fetch_and")
        || TOK_EQ(t, "__atomic_fetch_or") || TOK_EQ(t, "__atomic_fetch_xor")
        || TOK_EQ(t, "__atomic_add_fetch") || TOK_EQ(t, "__atomic_sub_fetch")) {
        int xchg = 0;
        int generic = 0;         /* 泛型形式：值/返回值都是指针 */
        int aop = 0;             /* 0=加 1=减 2=与 3=或 4=异或（和 rt.c6 对齐） */
        int ret_new = 0;
        u32 p = 0;
        u32 pty = 0;
        u32 v2 = 0;
        u32 rp = 0;
        u32 old = 0;
        u32 nv = 0;
        u32 fn = 0;

        xchg = TOK_EQ(t, "__atomic_exchange_n") || TOK_EQ(t, "__atomic_exchange");
        generic = TOK_EQ(t, "__atomic_exchange");
        aop = TOK_EQ(t, "__atomic_fetch_add") || TOK_EQ(t, "__atomic_add_fetch") ? 0
            : TOK_EQ(t, "__atomic_fetch_sub") || TOK_EQ(t, "__atomic_sub_fetch") ? 1
            : TOK_EQ(t, "__atomic_fetch_and") ? 2
            : TOK_EQ(t, "__atomic_fetch_or") ? 3 : 4;
        ret_new = TOK_EQ(t, "__atomic_add_fetch") || TOK_EQ(t, "__atomic_sub_fetch");
        pa_advance();
        pa_expect_ch('(');
        p = value_of(gen_assign());
        pty = ty_is_ptr(GEN_TY) ? ty_target(GEN_TY) : ty_int();
        pa_expect_ch(',');
        v2 = value_of(gen_assign());
        if (generic) {
            /* __atomic_exchange(ptr, &值, &旧值, order)：两个都是指针 */
            v2 = load_lval(v2, pty);
            pa_expect_ch(',');
            rp = value_of(gen_assign());
        }
        while (pa_accept_ch(','))
            (void)value_of(gen_assign());
        pa_expect_ch(')');
        if (xchg) {
            fn = x64_sym(&X64, "__c6_at_xchg");
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)p, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)v2, 0, 0, 1);
            {
                u32 sz = irfn_vreg(&FN);

                irfn_push(&FN, IR_CONST, IRT_U64, (u16)sz, 0, 0, 0, ty_size(pty));
                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)sz, 0, 0, 2);
            }
            old = irfn_vreg(&FN);
            irfn_push(&FN, IR_CALL, IRT_U64, (u16)old, 0, 0, 0, fn);
            FN.ops[FN.n - 1].narg = 3;
            if (rp)
                store_conv(rp, pty, old, pty);
            GEN_TY = pty;
            return gen_postfix_ops(old);
        }
        /* fetch_add/sub/and/or/xor：__c6_at_rmw(p, v, op, 宽度) 返回旧值 */
        fn = x64_sym(&X64, "__c6_at_rmw");
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)p, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)v2, 0, 0, 1);
        {
            u32 opv = irfn_vreg(&FN);
            u32 sz = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, (u16)opv, 0, 0, 0, (u32)aop);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)opv, 0, 0, 2);
            irfn_push(&FN, IR_CONST, IRT_U64, (u16)sz, 0, 0, 0, ty_size(pty));
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)sz, 0, 0, 3);
        }
        old = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_U64, (u16)old, 0, 0, 0, fn);
        FN.ops[FN.n - 1].narg = 4;
        if (!ret_new) {
            GEN_TY = pty;
            return gen_postfix_ops(old);
        }
        /* add_fetch / sub_fetch：新值 = 旧值 ± v（这些不成对使用，够用） */
        nv = irfn_vreg(&FN);
        irfn_push(&FN, aop == 0 ? IR_ADD : IR_SUB, ir_ty_of(pty), (u16)nv, (u16)old,
                  (u16)v2, 0, 0);
        GEN_TY = pty;
        return gen_postfix_ops(nv);
    }
    if (TOK_EQ(t, "__atomic_compare_exchange_n") || TOK_EQ(t, "__atomic_compare_exchange")) {
        int generic = TOK_EQ(t, "__atomic_compare_exchange");
        u32 p = 0;
        u32 pty = 0;
        u32 pe = 0;
        u32 pd = 0;
        u32 r = 0;
        u32 sz = 0;

        pa_advance();
        pa_expect_ch('(');
        p = value_of(gen_assign());
        pty = ty_is_ptr(GEN_TY) ? ty_target(GEN_TY) : ty_int();
        pa_expect_ch(',');
        pe = value_of(gen_assign());
        pa_expect_ch(',');
        pd = value_of(gen_assign());
        if (generic)
            pd = load_lval(pd, pty);        /* 参数是 &值 */
        while (pa_accept_ch(','))
            (void)value_of(gen_assign());
        pa_expect_ch(')');
        /* __c6_at_cas(p, &expected, desired, 宽度)：1 = 换成，0 = 没换成
         * （没换成时它已经把实际值写进 *expected 了） */
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)p, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)pe, 0, 0, 1);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)pd, 0, 0, 2);
        sz = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)sz, 0, 0, 0, ty_size(pty));
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)sz, 0, 0, 3);
        r = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_U64, (u16)r, 0, 0, 0, x64_sym(&X64, "__c6_at_cas"));
        FN.ops[FN.n - 1].narg = 4;
        GEN_TY = ty_int();
        return gen_postfix_ops(r);
    }
    if (TOK_EQ(t, "__builtin_expect") || TOK_EQ(t, "__builtin_expect_with_probability")
        || TOK_EQ(t, "__builtin_assume_aligned")) {
        u32 v = 0;

        pa_advance();
        pa_expect_ch('(');
        v = value_of(gen_assign());
        while (pa_accept_ch(','))
            (void)value_of(gen_assign());
        pa_expect_ch(')');
        return gen_postfix_ops(v);
    }
    /* `__builtin_types_compatible_p(type, type)`：以前只有常量上下文（静态断言、
     * 枚举值）能用，写进普通表达式就报"未声明的标识符"。类型在解析期就定了，
     * 所以运行期这条路也只是发一条常量。 */
    if (TOK_EQ(t, "__builtin_types_compatible_p") && pa_peek(1)->kind == TK_PUNCT
        && TOK_EQ(pa_peek(1), "(")) {
        u32 a = 0;
        u32 b = 0;
        u32 d = 0;

        pa_advance();
        pa_advance();
        a = parse_typename();
        pa_expect_punct(",");
        b = parse_typename();
        pa_expect_punct(")");
        d = irfn_vreg(&FN);
        /* C11 6.2.7p1：**顶层**限定符不参与兼容性判断（`int *` 与 `int *const`
         * 兼容），嵌套层的参与（`int **` 与 `int *restrict *` 不兼容）。
         * 常量上下文那条路一直就是这么做的，这里对齐。 */
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0,
                  ty_unqual(a) == ty_unqual(b) ? 1 : 0);
        GEN_TY = ty_int();
        return gen_postfix_ops(d);
    }
    if (TOK_EQ(t, "__builtin_constant_p")) {
        u32 d = 0;

        pa_advance();
        pa_expect_ch('(');
        if (!pa_is_ch(')')) {
            u32 sv = FN.n;

            (void)gen_assign();
            FN.n = sv;
            PEND_LVAL = 0;
        }
        pa_expect_ch(')');
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0, 1);
        GEN_TY = ty_int();
        return gen_postfix_ops(d);
    }
    if (TOK_EQ(t, "__builtin_offsetof")) {
        u32 ty = 0;
        u32 off = 0;
        u32 d = 0;

        pa_advance();
        pa_expect_ch('(');
        ty = parse_typename();
        pa_expect_ch(',');
        {
            int first = 1;

            for (;;) {
                const char *mn = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
                u32 ml = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
                u32 mo = 0;

                if (!mn)
                    break;
                pa_advance();
                if (!agg_find_promoted(ty, mn, ml, &ty, &mo))
                    break;
                off += mo;
                first = 0;
                if (!pa_accept_ch('.'))
                    break;
            }
            (void)first;
        }
        pa_expect_ch(')');
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0, off);
        GEN_TY = ty_ulong();
        return gen_postfix_ops(d);
    }
    if (TOK_EQ(t, "__builtin_abort") || TOK_EQ(t, "__builtin_trap")) {
        u32 d = 0;

        pa_advance();
        pa_expect_ch('(');
        pa_expect_ch(')');
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_I64, (u16)d, 0, 0, 0, 134);
        {
            u32 v = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_I64, (u16)v, 0, 0, 0, 60);
            irfn_push(&FN, IR_CALL, IRT_I64, 0, (u16)v, (u16)d, 0, 1);
        }
        GEN_TY = ty_void();
        return 0;
    }
    if (TOK_EQ(t, "__FUNCTION__") || TOK_EQ(t, "__func__") || TOK_EQ(t, "__PRETTY_FUNCTION__")) {
        u32 v = 0;

        pa_advance();
        v = gen_str_from(FN.name ? FN.name : "", FN.name ? (u32)strlen(FN.name) : 0);
        return gen_postfix_ops(v);
    }
    if (t->kind == TK_IDENT) {
        Sym *s = sym_find(tok_data(t), t->len);
        int break_qualified = 1;


        /* c6 的枚举限定名 `Color.RED`：名字里带点，不可能同时是变量或类型，
         * 所以先按 "Tag.成员" 整串查一次——**要在 `!s` 之前查**，
         * 因为 `enum Color` 会自动给 `Color` 建一个 typedef，`s` 非空，
         * 否则就会退到"取最后一段"，把 `Fruit.RED` 认成 `Color.RED`。 */
        if (pa_peek(1) && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ".")
            && pa_peek(2) && pa_peek(2)->kind == TK_IDENT) {
            char qn[256] = {0};
            u32 qk = t->len;
            Tok *q2 = pa_peek(2);

            if (qk + q2->len + 2 < sizeof(qn)) {
                Sym *qs = NULL;

                memcpy(qn, tok_data(t), qk);
                qn[qk++] = '.';
                memcpy(qn + qk, tok_data(q2), q2->len);
                qk += q2->len;
                qs = sym_find(qn, qk);
                if (qs) {
                    pa_advance();       /* Tag */
                    pa_advance();       /* . */
                    pa_advance();       /* 成员名 */
                    /* 枚举常量直接在这里出值：以前只吃两格、留给后面的
                     * "SC_ENUMC 分支再吃一格"，可那条路还带着 `t = pa_cur()`
                     * 重读当前 token 的逻辑，状态一乱就把后面的语句（典型是
                     * `switch`）解析崩掉。自己吃完三格最稳。 */
                    if (qs->kind == SC_ENUMC) {
                        u32 dv = irfn_vreg(&FN);


                        irfn_push(&FN, IR_CONST, IRT_U64, (u16)dv, 0, 0, 0,
                                  (u32)qs->val);
                        GEN_TY = ty_int();
                        PEND_LVAL = 0;
                        PEND_BITS = 0;
                        PEND_BITOFF = 0;
                        return gen_postfix_ops(dv);
                    }
                    t = pa_cur();
                    s = qs;
                }
            }
        }
        /* c6 的模块限定名 `std.core.err.msg(rc)`：单 TU 文本导入下前缀只是
         * 命名空间装饰，真正要找的是最后一段。只在第一段没声明时才这么退，
         * 所以 `s.field` 之类照旧走成员访问。 */
        if (!s && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ".")
            && pa_peek(2) && pa_peek(2)->kind == TK_IDENT) {
            {
                char qn[256] = {0};
                u32 qk = t->len;
                Tok *q2 = pa_peek(2);

                if (q2 && qk + q2->len + 2 < sizeof(qn)) {
                    memcpy(qn, tok_data(t), qk);
                    qn[qk++] = '.';
                    memcpy(qn + qk, tok_data(q2), q2->len);
                    qk += q2->len;
                    s = sym_find(qn, qk);
                    if (s) {
                        pa_advance();       /* 走到 '.' */
                        pa_advance();       /* 走到成员名 */
                        t = pa_cur();
                    }
                }
            }
            /* 方法体里的 `成员.成员`（`cur.key`）不能走下面这条"跳到最后一个
             * 段"的模块限定名逻辑：`cur` 是接收者的成员、没有全局符号，
             * 一跳就把 `.key` 也吃掉了，报"未声明的标识符 'key'"。 */
            if (!s && METHOD_SELF_TY) {
                u32 st4 = 0;
                u32 so4 = 0;

                if (agg_find_promoted(METHOD_SELF_TY, tok_data(t), t->len, &st4, &so4))
                    break_qualified = 0;
            }
            /* 逐段吃，取"能查到符号的最长前缀"：`tu.module.origin.x` 里有
             * 全局变量 `tu__module__origin`，必须停在 `origin`，把 `.x` 留给
             * 成员访问；`tu.module.add` 则一路吃到 `add`。两种拼法都试
             * （点分的 `Tag.member` 那一族、前缀化的 `tu__module__origin`）。 */
            if (!s && break_qualified) {
                char qd[256] = {0};
                char qm[256] = {0};
                u32 dn = t->len;
                u32 mn = t->len;
                u32 best_segs = 0;
                Sym *best_sym = NULL;
                u32 k2 = 0;

                if (dn < sizeof(qd) && mn + 3 < sizeof(qm)) {
                    memcpy(qd, tok_data(t), dn);
                    memcpy(qm, tok_data(t), mn);
                    for (k2 = 0; k2 < 4; k2++) {
                        Tok *d1 = pa_peek((int)(k2 * 2 + 1));
                        Tok *d2 = pa_peek((int)(k2 * 2 + 2));
                        Sym *hit = NULL;

                        if (!(d1 && d1->kind == TK_PUNCT && TOK_EQ(d1, ".")
                              && d2 && d2->kind == TK_IDENT))
                            break;
                        if (dn + d2->len + 2 >= sizeof(qd) || mn + d2->len + 3 >= sizeof(qm))
                            break;
                        qd[dn++] = '.';
                        memcpy(qd + dn, tok_data(d2), d2->len);
                        dn += d2->len;
                        qm[mn++] = '_';
                        qm[mn++] = '_';
                        memcpy(qm + mn, tok_data(d2), d2->len);
                        mn += d2->len;
                        qd[dn] = 0;
                        qm[mn] = 0;
                        hit = sym_find(qd, dn);
                        if (!hit)
                            hit = sym_find(qm, mn);
                        if (hit) {
                            best_sym = hit;
                            best_segs = k2 + 1;
                        }
                    }
                }
                if (best_sym) {
                    for (k2 = 0; k2 < best_segs * 2; k2++)
                        pa_advance();
                    s = best_sym;
                    t = pa_cur();
                }
            }
            while (!s && break_qualified && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
                   && TOK_EQ(pa_peek(1), ".")
                   && pa_peek(2) && pa_peek(2)->kind == TK_IDENT) {
                pa_advance();
                pa_advance();
                t = pa_cur();
            }
            s = sym_find(tok_data(t), t->len);
        }
        /* 方法体里的裸名字先看接收者的成员：别的模块可能导出同名全局
         * （`std/core/fixed.c6` 的 `int cmp(Fix *self, Fix b)` 就让
         * std/container/pqueue.c6 的 `cmp` 成员在方法体里失效了）。
         * 形参/局部变量在更内层的作用域里，sym_find 会先找到，不受影响。 */
        if (METHOD_SELF_TY && (!s || s->kind == SC_GLOBAL)) {
            u32 mty4 = 0;
            u32 moff4 = 0;

            if (agg_find_promoted(METHOD_SELF_TY, tok_data(t), t->len, &mty4, &moff4)) {
                Sym *pself = sym_find("self", 4);

                if (getenv("C6C_DBG_SELF"))
                    fprintf(stderr, "[self] %.*s self_ty=%u mty=%u off=%u size=%u\n",
                            (int)t->len, tok_data(t), (unsigned)METHOD_SELF_TY,
                            (unsigned)mty4, (unsigned)moff4, (unsigned)ty_size(mty4));

                if (pself) {
                    u32 sa = irfn_vreg(&FN);
                    u32 sv = irfn_vreg(&FN);
                    u32 ma = irfn_vreg(&FN);
                    u32 rv = 0;
                    int assign_ctx = 0;

                    pa_advance();       /* 吃掉标识符，否则解析器原地打转 */
                    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)sa, 0, 0, 0, X64_SLOT(pself->slot));
                    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)sv, (u16)sa, 0, 0, 0);
                    if (moff4) {
                        irfn_push(&FN, IR_LEA, IRT_PTR, (u16)ma, (u16)sv, 0, 0, moff4);
                    } else {
                        irfn_push(&FN, IR_MOV, IRT_PTR, (u16)ma, (u16)sv, 0, 0, 0);
                    }
                    GEN_TY = mty4;
                    PEND_LVAL = 1;
                    PEND_ADDR = ma;
                    /* PEND_TY 也要给：赋值路径先把 addr/ty 存进局部再去算右边，
                     * 少了它 store 的宽度/类型就是陈旧的（踩过：方法里写成员
                     * 把 v.x/v.y 写成一堆垃圾）。 */
                    PEND_TY = mty4;
                    PEND_BITS = 0;
                    PEND_BITOFF = 0;
                    PEND_BF_ENUM = 0;
                    /* PEND_MGD 是"上一个表达式"留下的：不清掉的话，前面刚用过
                     * 托管引用的方法体里读个 char 成员也会被当成托管读
                     * （现象：`return data[i]` 变成 ld8 + retain，运行时炸）。 */
                    PEND_MGD = mgd_at_off(METHOD_SELF_TY, moff4) ? 1 : 0;
                    PEND_MGD_SYM = NULL;
                    rv = gen_postfix_ops(ma);
                    /* 紧跟赋值/自增就是左值；否则当场取值（把"地址 + PEND_LVAL"
                     * 原样交回去，这条回落路径上后面没人帮我 load，读出来是 0）。 */
                    if (PEND_LVAL && pa_cur()->kind == TK_PUNCT) {
                        const char *pp = tok_data(pa_cur());
                        u32 L2 = pa_cur()->len;

                        if (L2 == 1 && pp[0] == '=')
                            assign_ctx = 1;
                        else if (L2 == 2
                                 && ((pp[0] == '+' && pp[1] == '+')
                                     || (pp[0] == '-' && pp[1] == '-')
                                     || pp[1] == '='))
                            assign_ctx = 1;
                        else if (L2 == 3 && pp[2] == '=')
                            assign_ctx = 1;
                        else if (L2 == 1 && pp[0] == '[')
                            assign_ctx = 1;   /* `&keys[i]` / `keys[i] = …` */
                    }
                    if (PA_AMP)
                        assign_ctx = 1;
                    if (PEND_LVAL && assign_ctx)
                        return rv;
                    if (PEND_LVAL)
                        rv = load_lval(rv, mty4);
                    PEND_LVAL = 0;
                    GEN_TY = mty4;
                    return rv;
                }
            }
        }
        /* 方法体里直接调同类方法，不带接收者：`probe(&ok[i])` 就是
         * `self->probe(&ok[i])`——第一个形参是接收者，这里补上。 */
        if (METHOD_SELF_TY && (!s || s->kind == SC_GLOBAL)
            && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
            && tok_eq(pa_peek(1), "(")) {
            Sym *fs = meth_find(METHOD_SELF_TY, tok_data(t), t->len);

            if (!fs)
                fs = sym_find(tok_data(t), t->len);
            if (fs && fs->is_func && ty_func_nparams(fs->type) > 0
                && ty_func_param(fs->type, 0) == ty_ptr(METHOD_SELF_TY)) {
                Sym *pself2 = sym_find("self", 4);

                if (pself2) {
                    u32 sa2 = irfn_vreg(&FN);
                    u32 sv2 = irfn_vreg(&FN);
                    u32 avs[16] = {0};
                    u32 narg = 0;
                    u32 k2 = 0;
                    u32 dst2 = 0;

                    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)sa2, 0, 0, 0,
                              X64_SLOT(pself2->slot));
                    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)sv2, (u16)sa2, 0, 0, 0);
                    avs[narg++] = sv2;
                    pa_advance();       /* 名字 */
                    if (pa_accept_ch('(')) {
                        if (!pa_accept_ch(')')) {
                            for (;;) {
                                if (narg < 16)
                                    avs[narg++] = value_of(gen_assign());
                                if (!pa_accept_ch(','))
                                    break;
                            }
                            pa_expect_ch(')');
                        }
                    }
                    for (k2 = 0; k2 < narg; k2++)
                        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)avs[k2], 0, 0, k2);
                    dst2 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CALL, ir_ty_of(ty_target(fs->type)), (u16)dst2,
                              0, 0, 0, (u32)fs->val);
                    FN.ops[FN.n - 1].narg = (u8)narg;
                    GEN_TY = ty_target(fs->type);
                    E_WAS_CALL = 1;
                    PEND_LVAL = 0;
                    return gen_postfix_ops(dst2);
                }
            }
        }
        /* 函数模板调用：`f@int(…)` / 模板体内的 `f@T(…)`。
         * 名字**已经声明过**（同文件里还有普通函数同名、或者前面实例化过一次
         * 登记了符号）时也得走这条路——判据是"有同名函数模板"，不是"名字未声明"。 */
        if (pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), "@")) {
            Tmpl *t0 = tmpl_find(tok_data(t), t->len);

            if (t0 && t0->is_func) {
                u32 args[TMPL_NPARAM] = {0};
                u32 na = 0;
                u32 fsym = 0;

                pa_advance();           /* 名字 */
                pa_advance();           /* @ */
                na = tmpl_parse_args(t0, args, pa_is_ch('('));
                fsym = tmpl_func_sig(t0, args, na);
                /* 函数体排进 worklist，等这条顶层声明做完再发射 */
                if (NFW < FW_MAX) {
                    u32 k2 = 0;
                    u32 j2 = 0;
                    int dup = 0;

                    /* 去重要按 (模板, 实参)，同一个模板的不同实例都要发 */
                    for (k2 = 0; k2 < NFW; k2++) {
                        int same = (FW_T[k2] == t0);

                        if (same) {
                            for (j2 = 0; j2 < TMPL_NPARAM; j2++)
                                if (FW_A[k2][j2] != args[j2])
                                    same = 0;
                        }
                        if (same)
                            dup = 1;
                    }
                    if (!dup) {
                        for (k2 = 0; k2 < TMPL_NPARAM; k2++)
                            FW_A[NFW][k2] = args[k2];
                        FW_T[NFW] = t0;
                        NFW++;
                    }
                }
                {
                    char nm[320] = {0};
                    Sym *s2 = NULL;

                    tmpl_mangle_name(t0, args, na, nm, sizeof(nm));
                    s2 = sym_find(nm, (u32)strlen(nm));
                    if (s2 && s2->is_func) {
                        if (pa_is_ch('('))
                            return gen_postfix_ops(gen_call(s2));
                        GEN_TY = ty_ptr(s2->type);
                        return gen_postfix_ops(ident_addr(s2));
                    }
                }
                pa_error("函数模板实例化失败 '%.*s'", (int)t->len, tok_data(t));
                GEN_TY = ty_int();
                return 0;
            }
        }
        if (!s) {
            pa_error("未声明的标识符 '%.*s'", (int)t->len, tok_data(t));
            pa_advance();
            GEN_TY = ty_int();
            return 0;
        }
        if (s->is_func) {
            if (pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")) {
                pa_advance();
                return gen_postfix_ops(gen_call(s));
            }
            /* 函数名出现在值的位置：它的值就是地址（配合函数指针） */
            pa_advance();
            {
                u32 a2 = ident_addr(s);

                GEN_TY = ty_ptr(s->type);
                return gen_postfix_ops(a2);
            }
        }
        if (s->kind == SC_ENUMC) {
            u32 d = 0;

            /* 两个枚举都有这个成员名：裸名有歧义，提示写限定名。 */
            if (poison_find(tok_data(t), t->len))
                pa_error("'%.*s' is the member of more than one enum: write "
                         "'<enum>.%.*s'", (int)t->len, tok_data(t),
                         (int)t->len, tok_data(t));
            pa_advance();
            d = irfn_vreg(&FN);
            irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0, (u32)s->val);
            GEN_TY = ty_int();
            return gen_postfix_ops(d);
        }
        if (s->kind == SC_LOCAL || s->kind == SC_PARAM || s->kind == SC_GLOBAL) {
            u32 a = 0;
            /* `move(a)` 之后槽是空的：读它（解引用、比较、传参、再 move）
             * 拿到的是空值，编译期就报。赋值目标（`a = …`）不算读。 */
            int is_store = pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(1), "=");

            if (s->is_mgd == 1 && !is_store && !PA_MOVE_OPERAND && !PA_UNEVAL
                && mv_has(s->slot))
                pa_error("'%.*s' was moved: assign a new reference before using it",
                         (int)t->len, tok_data(t));

            pa_advance();
            a = ident_addr(s);
            mark_lval(a, s->type);
            PEND_SYM = s;
            if (s->is_mgd) {
                PEND_MGD = s->is_mgd == 2 ? 3 : 1;   /* 1/2 = 托管引用，3 = 弱 */
                E_WEAK = s->is_mgd == 2;
                if (s->is_mgd == 1)
                    PEND_MGD_SYM = s;
            }
            return gen_postfix_ops(a);
        }
        pa_error("'%.*s' 不能出现在表达式里", (int)t->len, tok_data(t));
        pa_advance();
        GEN_TY = ty_int();
        return 0;
    }
    if (pa_is_ch('(') && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), "{")) {
        /* GNU 语句表达式 ({ ... })：值取块里最后一条表达式语句的值 */
        u32 v = 0;
        u32 vt = 0;

        pa_advance();                  /* ( */
        BLOCK_HAS = 0;
        gen_block();
        pa_expect_ch(')');
        v = BLOCK_HAS ? BLOCK_VAL : 0;
        vt = BLOCK_HAS ? BLOCK_TY : ty_int();
        PEND_LVAL = 0;
        GEN_TY = vt;
        return gen_postfix_ops(v);
    }
    if (pa_accept_ch('(')) {
        u32 r = gen_expr();

        pa_expect_ch(')');
        return gen_postfix_ops(r);
    }
    pa_error("这里要一个表达式（当前是 '%.*s'）", (int)t->len, tok_data(t));
    pa_advance();
    GEN_TY = ty_int();
    return 0;
}

/* 类型名（无声明符名字），供 sizeof / 强制转换用 */
static u32 parse_typename(void)
{
    Declarator d = {0};
    u32 base = parse_typespec();

    return parse_declarator(base, &d);
}

static void defer_run(int from_scope, int on_error);

/* f-string 洞里是个表达式时：把洞的文本重新词法一遍，压进 token 源栈再
 * 当表达式求值。以前只认 `{标识符}`，`{(int)c}`、`{'A'}`、`{a.b}` 全被当成
 * 空串悄悄跳过。 */
static int fstr_hole_expr(const char *raw, u32 hfile, u32 hs, u32 hlen,
                          u32 *outv, u32 *outty)
{
    SrcFile sf = {0};
    Lex L = {0};
    Tok *toks = NULL;
    char *buf = NULL;
    u32 n = 0;
    u32 k = 0;
    u32 q = 0;
    u32 save_n = 0;
    static u32 sf_line0 = 0;

    if (hlen == 0 || hlen > 200)
        return 0;
    buf = arena_alloc(&A_main, (size_t)hlen + 1);
    /* 洞里的 `\"` 属于外层字符串字面量的转义，重新词法时要把反斜杠去掉
     * （`f"{a ? \"x\" : \"y\"}"`）；其它转义原样留着，嵌套字面量自己会解。 */
    for (q = 0; q < hlen; q++) {
        char hc = raw[hs + q];

        /* 只解**一层**：`\\` → `\`、`\"` → `"`。嵌套字面量自己再解下一层。 */
        if (hc == '\\' && q + 1 < hlen
            && (raw[hs + q + 1] == '\\' || raw[hs + q + 1] == '"'
                || raw[hs + q + 1] == '\'')) {
            buf[k++] = raw[hs + q + 1];
            q++;
            continue;
        }
        buf[k++] = hc;
    }
    buf[k] = 0;
    sf.path = "-";
    sf.data = buf;
    sf.size = k;
    sf.id = hfile;
    sf.lines = &sf_line0;
    sf.nlines = 1;
    lex_init(&L, &sf);
    toks = arena_alloc(&A_main, 64 * sizeof(Tok));
    while (L.pos < k && n < 63) {
        Tok t = {0};
        int kk = lex_next(&L, &t);

        if (kk == TK_EOF || L.pos > k)
            break;
        if (kk == TK_NL)
            continue;
        t.syn = buf + t.off;
        t.flags |= TF_SYN;
        toks[n++] = t;
    }
    if (n == 0)
        return 0;
    /* 已经被预读进窗口的 token 先抄走再压回去，否则洞里那段会把它们冲掉 */
    save_n = (u32)PA_HAVE;
    if (save_n > 0) {
        Tok *sv = arena_alloc(&A_main, (size_t)save_n * sizeof(Tok));
        u32 q2 = 0;

        for (q2 = 0; q2 < save_n; q2++)
            sv[q2] = *pa_peek((int)q2);
        pa_win_clear();
        pa_src_push(sv, save_n);
    }
    pa_src_push(toks, n);
    *outv = value_of(gen_assign());
    *outty = cur_op_ty();
    return 1;
}

/* 合成一个字符串字面量 token 并求它的地址（f-string 里 `_Bool` 要输出
 * "true"/"false"，那两个常量得进数据段）。 */
static u32 fstr_str_addr(const char *lit)
{
    Tok *t = arena_alloc(&A_main, sizeof(Tok));
    u32 save_n = (u32)PA_HAVE;

    memset(t, 0, sizeof(Tok));
    t->kind = TK_STR;
    t->len = (u32)strlen(lit);
    t->flags = TF_SYN;
    t->syn = (char *)lit;
    if (save_n > 0) {
        Tok *sv = arena_alloc(&A_main, (size_t)save_n * sizeof(Tok));
        u32 q = 0;

        for (q = 0; q < save_n; q++)
            sv[q] = *pa_peek((int)q);
        pa_win_clear();
        pa_src_push(sv, save_n);
    }
    pa_src_push(t, 1);
    return gen_string();
}

/* `_Bool` 要输出 true / false：按值挑一个常量字符串的地址 */
static u32 fstr_bool_str(u32 hv)
{
    u32 z = irfn_vreg(&FN);
    u32 cc = irfn_vreg(&FN);
    u32 rt = irfn_vreg(&FN);
    u32 l1 = irfn_label(&FN);
    u32 l2 = irfn_label(&FN);
    u32 l3 = irfn_label(&FN);

    irfn_push(&FN, IR_CONST, IRT_U64, (u16)z, 0, 0, 0, 0);
    irfn_push(&FN, IR_CMP, IRT_I64, (u16)cc, (u16)hv, (u16)z, 0, 0);
    FN.ops[FN.n - 1].flags = (u8)IRCC_NE;
    irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)cc, (u16)l1, (u16)l2, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)l1, 0, 0, 0);
    irfn_push(&FN, IR_MOV, IRT_PTR, (u16)rt, (u16)fstr_str_addr("\"true\""), 0, 0, 0);
    irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)l3, 0, 0, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)l2, 0, 0, 0);
    irfn_push(&FN, IR_MOV, IRT_PTR, (u16)rt, (u16)fstr_str_addr("\"false\""), 0, 0, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)l3, 0, 0, 0);
    return rt;
}

/* 按值的类型挑 printf 的转换说明；返回真正要传的那个实参 */
/* 切片/聚合的两个机器字：从地址取一个字段 */
static u32 fstr_load(u32 sadd, u32 ty, u32 off)
{
    u32 a = irfn_vreg(&FN);
    u32 v = irfn_vreg(&FN);

    irfn_push(&FN, IR_LEA, IRT_PTR, (u16)a, (u16)sadd, 0, 0, off);
    irfn_push(&FN, IR_LOAD, ir_ty_of(ty), (u16)v, (u16)a, 0, 0, 0);
    return v;
}

static u32 FSTR_SLOT[8];     /* 按嵌套深度复用的 f-string 临时缓冲 */
static int FSTR_DEPTH;

static u32 fstr_skip_space(u32 sadd)
{
    u32 a = irfn_vreg(&FN);
    u32 p = irfn_vreg(&FN);
    u32 i = irfn_vreg(&FN);
    u32 c = irfn_vreg(&FN);
    u32 one = irfn_vreg(&FN);
    u32 cc = irfn_vreg(&FN);
    u32 l1 = irfn_label(&FN);
    u32 l2 = irfn_label(&FN);

    irfn_push(&FN, IR_MOV, IRT_PTR, (u16)p, (u16)sadd, 0, 0, 0);
    irfn_push(&FN, IR_CONST, IRT_U64, (u16)i, 0, 0, 0, 0);
    irfn_push(&FN, IR_CONST, IRT_U64, (u16)one, 0, 0, 0, 1);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)l1, 0, 0, 0);
    irfn_push(&FN, IR_LOAD, IRT_U8, (u16)c, (u16)p, 0, 0, 0);
    irfn_push(&FN, IR_CMP, IRT_I64, (u16)cc, (u16)c, (u16)one, 0, 0);
    FN.ops[FN.n - 1].flags = (u8)IRCC_LT;
    irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)cc, (u16)l2, (u16)l1, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)l2, 0, 0, 0);
    irfn_push(&FN, IR_MOV, IRT_PTR, (u16)a, (u16)p, 0, 0, 0);
    return a;
}

/* f-string 洞的格式：`{expr}` / `{expr;spec}`。`spec` 是
 * `#[+- 0]宽度[.精度]转换`，转换可以是 d u x X o b c s f e E g。
 * 返回要传的实参；切片/`%.*s` 会先往 av[] 里追加一个长度。 */
static u32 fstr_fmt_arg(char *fmt, u32 *fl, u32 ty, u32 hv,
                        const char *sp, u32 sl, u32 *av, u32 *na)
{
    char flg[8] = {0};
    u32 nf = 0;
    char wid[8] = {0};
    u32 nw = 0;
    char pre[8] = {0};
    u32 np2 = 0;
    int has_pre = 0;
    char conv = 0;
    u32 i = 0;
    u32 arg = hv;
    int uns = 0;
    int kind = 0;               /* 0=int 1=str 2=float 3=char 4=bin 5=ptr */
    char lm[8] = {0};
    u32 nl = 0;
    char tail = 0;
    int pre_0x = 0;
    int prec_star = 0;

    for (i = 0; i < sl; i++) {
        char c = sp[i];

        if (c == '#' || c == '+' || c == '-' || c == ' ') {
            if (nf < 8)
                flg[nf++] = c;
        } else if (c == '0' && nw == 0) {
            if (nf < 8)
                flg[nf++] = c;
        } else if (c >= '0' && c <= '9') {
            if (nw < 8)
                wid[nw++] = c;
        } else if (c == '.') {
            has_pre = 1;
            i++;
            while (i < sl && sp[i] >= '0' && sp[i] <= '9' && np2 < 8)
                pre[np2++] = sp[i++];
            i--;
        } else {
            conv = c;
            break;
        }
    }
    if (ty == ty_bool()) {
        kind = 1;
    } else if (ty_is_slice(ty)) {
        kind = 1;
    } else if (ty_is_ptr(ty) || ty_is_array(ty)) {
        u32 tg = ty_is_array(ty) ? ty_target(ty) : ty_target(ty);

        if (tg == ty_char() || tg == ty_schar() || tg == ty_uchar())
            kind = 1;
        else
            kind = 5;
    } else if (ty_is_float(ty)) {
        kind = 2;
    } else if (ty == ty_char() || ty == ty_schar() || ty == ty_uchar()) {
        kind = 3;
    } else {
        kind = 0;
        uns = !ty_is_signed(ty);
    }
    /* 格式说明先自己查一遍：未知转换、类型对不上、宽度/精度越界，都在
     * 编译期报出来，别拖到 printf 里变成乱码。`kind` 到这里还是"值本身的
     * 自然类别"，下面才被 conv 改掉。 */
    {
        int nat = kind;
        int is_text = (kind == 1 && ty != ty_bool());
        int intconv = 0;
        int fltconv = 0;
        u32 wv = 0;
        u32 pv = 0;
        u32 z = 0;

        for (z = 0; z < nw; z++)
            wv = wv * 10 + (u32)(wid[z] - '0');
        for (z = 0; z < np2; z++)
            pv = pv * 10 + (u32)(pre[z] - '0');
        if (wv > 1024)
            pa_error("f-string: 格式宽度 %u 太大", wv);
        if (pv > 1024)
            pa_error("f-string: 格式精度 %u 太大", pv);
        if (conv) {
            intconv = (conv == 'd' || conv == 'i' || conv == 'u' || conv == 'x'
                       || conv == 'X' || conv == 'o' || conv == 'b'
                       || conv == 'c');
            fltconv = (conv == 'f' || conv == 'F' || conv == 'e'
                       || conv == 'E' || conv == 'g' || conv == 'G');
            if (!intconv && !fltconv && conv != 's')
                pa_error("f-string: 未知的格式转换 '%c'", conv);
            else if (nat == 2 && !fltconv)
                pa_error("f-string: 浮点值不能用 '%c' 格式", conv);
            else if (nat == 0 && fltconv)
                pa_error("f-string: 整数值不能用 '%c' 格式", conv);
            else if (is_text && intconv)
                pa_error("f-string: 文本不能用 '%c' 格式", conv);
        }
    }
    if (conv) {
        if (conv == 'd' || conv == 'i') {
            kind = 0;
            uns = 0;
        } else if (conv == 'u') {
            kind = 0;
            uns = 1;
        } else if (conv == 'x' || conv == 'X' || conv == 'o') {
            kind = 0;
            uns = 1;
        } else if (conv == 'b') {
            kind = 4;
            uns = 1;
        } else if (conv == 'c') {
            kind = 3;
        } else if (conv == 's') {
            kind = 1;
        } else if (conv == 'f' || conv == 'F' || conv == 'e' || conv == 'E'
                   || conv == 'g' || conv == 'G') {
            kind = 2;
        }
    }
    if (kind == 4) {
        /* 二进制：printf 没有这个转换，交给运行时写进一个临时缓冲 */
        u32 buf = frame_slots_for(80);
        u32 ba = irfn_vreg(&FN);
        u32 alt = irfn_vreg(&FN);
        u32 r = irfn_vreg(&FN);

        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)ba, 0, 0, 0, X64_SLOT(buf));
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)alt, 0, 0, 0, 0);
        for (i = 0; i < nf; i++)
            if (flg[i] == '#')
                FN.ops[FN.n - 1].imm = 1;
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)ba, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)arg, 0, 0, 1);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)alt, 0, 0, 2);
        irfn_push(&FN, IR_CALL, IRT_PTR, (u16)r, 0, 0, 0,
                  x64_sym(&X64, "__c6_fmt_bin"));
        FN.ops[FN.n - 1].narg = 3;
        kind = 1;
        arg = r;
        /* `#` 由运行时负责，printf 这边不许再看到 */
        {
            u32 q = 0;
            u32 k2 = 0;

            for (q = 0; q < nf; q++)
                if (flg[q] != '#')
                    flg[k2++] = flg[q];
            nf = k2;
        }
    }
    if (kind == 2 && ty_size(ty) > 0 && ty_size(ty) < 8)
        arg = gen_convert(arg, ty, ty_double());   /* float → double 的提升 */
    if (kind == 1 && ty == ty_bool())
        arg = fstr_bool_str(hv);
    if (kind == 0) {
        if (!uns && ty_size(ty) > 0 && ty_size(ty) < 8 && ty_is_signed(ty)) {
            u32 d = irfn_vreg(&FN);

            irfn_push(&FN, IR_SEXT, IRT_I64, (u16)d, (u16)arg, 0, 0, 0);
            arg = d;
        }
        lm[nl++] = 'l';
        lm[nl++] = 'l';
        if (!conv)
            tail = uns ? 'u' : 'd';
        else if (conv == 'o')
            tail = 'o';
        else if (conv == 'X')
            tail = 'X';
        else if (conv == 'x')
            tail = 'x';
        else if (conv == 'u')
            tail = 'u';
        else
            tail = 'd';
    } else if (kind == 1) {
        tail = 's';
        if (ty_is_slice(ty)) {
            u32 ptr = fstr_load(hv, ty_ptr(ty_char()), 0);
            u32 len = fstr_load(hv, ty_long(), 8);

            if (has_pre) {
                arg = ptr;
            } else {
                arg = ptr;
                prec_star = 1;
            }
            if (prec_star && *na < 8)
                av[(*na)++] = len;
        }
    } else if (kind == 2) {
        tail = conv ? conv : 'g';
    } else if (kind == 3) {
        tail = 'c';
    } else if (kind == 5) {
        if (!conv) {
            pre_0x = 1;
            lm[nl++] = 'l';
            tail = 'x';
        } else if (conv == 's') {
            tail = 's';
        } else if (conv == 'c') {
            tail = 'c';
        } else {
            lm[nl++] = 'l';
            lm[nl++] = 'l';
            tail = (conv == 'X') ? 'X' : (conv == 'o') ? 'o'
                   : (conv == 'u') ? 'u' : (conv == 'd') ? 'd' : 'x';
        }
    }
    if (pre_0x) {
        fmt[(*fl)++] = '0';
        fmt[(*fl)++] = 'x';
    }
    fmt[(*fl)++] = '%';
    for (i = 0; i < nf; i++)
        fmt[(*fl)++] = flg[i];
    for (i = 0; i < nw; i++)
        fmt[(*fl)++] = wid[i];
    if (prec_star) {
        fmt[(*fl)++] = '.';
        fmt[(*fl)++] = '*';
    } else if (has_pre) {
        fmt[(*fl)++] = '.';
        for (i = 0; i < np2; i++)
            fmt[(*fl)++] = pre[i];
    }
    for (i = 0; i < nl; i++)
        fmt[(*fl)++] = lm[i];
    fmt[(*fl)++] = tail;
    return arg;
}

static u32 gen_unary(void)
{
    /* 表达式位置上的 c6 角色宏：`imax(a + 1, b * 2)`。展开成 `( 体 )` 之后
     * 直接重进 gen_unary 解析它。 */
    if (NCM > 0 && CM_EXPR_DEPTH < 64 && cm_at_call(CM_ROLE_EXPR)) {
        CM_EXPR_DEPTH++;
        (void)cm_expand(CM_ROLE_EXPR);
        {
            u32 r = gen_unary();

            CM_EXPR_DEPTH--;
            return r;
        }
    }
    /* c6 的 f-string：`f"text {x} text"` / `@f"…"`（托管版本）。c6c 的 `@char`
     * 就是 `char *`，所以两者一样：把字面量拼成 printf 格式串、把 `{名字}`
     * 换成实参，调一次 snprintf 进栈上缓冲。**只支持 `{标识符}` 形式的洞**
     * （表达式要能重入词法器，那是另一件事），够 tests/ 里的用法了。 */
    if ((PA_IS_IDENT("f") && pa_peek(1) && pa_peek(1)->kind == TK_STR)
        || (pa_is_ch('@') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
            && TOK_EQ(pa_peek(1), "f") && pa_peek(2) && pa_peek(2)->kind == TK_STR)) {
        char fmt[512] = {0};
        u32 fl = 0;
        u32 av[8] = {0};
        u32 na = 0;
        Tok *stk = NULL;
        const char *raw = NULL;
        u32 rl = 0;
        u32 i2 = 0;
        u32 slot = 0;
        u32 aptr = 0;
        u32 cfmt = 0;
        u32 ccap = 0;
        u32 dst = 0;
        u32 foff = 0;
        u32 stk_off = 0;
        u32 stk_file = 0;
        u32 fdt = 0;
        int fdm = 0;

        fdt = FSTR_DEPTH;
        if (FSTR_DEPTH < 8)
            FSTR_DEPTH++;
        {
            /* `@char p = f"…"`（借来的文本给自己发引用）和
             * `const char *p = @f"…"`（把新引用交给普通指针）都得报。 */
            u8 dm = PA_DECL_INIT_MGD;

            if (dm == 2 && !(pa_is_ch('@') ? 1 : 0))
                pa_error("f-string: 普通文本是借来的，不能存进托管引用（写 @f\"…\"）");
            else if (dm == 1 && pa_is_ch('@'))
                pa_error("f-string: 新建的引用不能存进普通指针（目标要写成 @char）");
        }
        if (pa_is_ch('@')) {
            pa_advance();
            fdm = 1;             /* `@f".."` 是托管文本，不能跟普通的共用缓冲 */
        }
        pa_advance();                    /* f */
        stk = pa_cur();
        raw = tok_data(stk);
        rl = stk->len;
        stk_off = stk->off;
        stk_file = stk->file;
        pa_advance();
        /* 去掉首尾引号 */
        if (rl >= 2) {
            raw++;
            rl -= 2;
        }
        while (i2 < rl && fl < sizeof(fmt) - 8) {
            if (raw[i2] == '{') {
                u32 hs = 0;
                u32 hlen = 0;
                u32 depth = 0;
                const char *spec = NULL;
                u32 sl = 0;

                if (i2 + 1 < rl && raw[i2 + 1] == '{') {
                    fmt[fl++] = '{';     /* `{{` 不是洞 */
                    i2 += 2;
                    continue;
                }
                hs = ++i2;
                /* 洞的结束位置：配平嵌套的 `{}`，并跳过洞里的字符串字面量。
                 * 嵌套字面量的引号每深一层就多一层反斜杠（外层写 `\"`，
                 * 再深一层写 `\\\"`），所以定界符是"2^层数 - 1 个反斜杠 +
                 * 引号"。 */
                {
                    int lvl = 1;
                    int instr = 0;

                    while (i2 < rl) {
                        char ch = raw[i2];

                        if (ch == '\\') {
                            u32 k2 = 0;
                            u32 q2 = i2;
                            u32 need = 0;

                            while (q2 < rl && raw[q2] == '\\') {
                                k2++;
                                q2++;
                            }
                            if (q2 < rl && (raw[q2] == '"' || raw[q2] == '\'')) {
                                need = instr ? ((1u << (lvl - 1)) - 1)
                                             : ((1u << lvl) - 1);
                                if (k2 == need) {
                                    instr = !instr;
                                    if (instr)
                                        lvl++;
                                    else
                                        lvl--;
                                    i2 = q2 + 1;
                                    continue;
                                }
                                i2 = q2 + 1;   /* 转义掉的引号，跳过 */
                                continue;
                            }
                            i2 = q2;
                            continue;
                        }
                        if (ch == '"' || ch == '\'') {
                            char qc = ch;

                            i2++;
                            while (i2 < rl && raw[i2] != qc) {
                                if (raw[i2] == '\\' && i2 + 1 < rl)
                                    i2++;
                                i2++;
                            }
                            if (i2 < rl)
                                i2++;
                            continue;
                        }
                        if (!instr) {
                            if (ch == '{') {
                                depth++;
                                i2++;
                                continue;
                            }
                            if (ch == '}') {
                                if (depth == 0)
                                    break;
                                depth--;
                                i2++;
                                continue;
                            }
                        }
                        i2++;
                    }
                }
                hlen = i2 - hs;
                /* 洞必须真的包着东西，也必须真的闭合 */
                if (hlen == 0)
                    pa_error("f-string: '{}' 里要一个表达式");
                else if (i2 >= rl)
                    pa_error("f-string: 洞没闭合，缺 '}'");
                else {
                    u32 tq = 0;

                    /* 插值里不许出现 `try`：错误路径会从函数直接返回，
                     * 构造到一半的缓冲就留在栈上了。 */
                    while (tq + 3 <= hlen) {
                        if ((tq == 0 || !is_ident_cont((u8)raw[hs + tq - 1]))
                            && raw[hs + tq] == 't' && raw[hs + tq + 1] == 'r'
                            && raw[hs + tq + 2] == 'y'
                            && (tq + 3 >= hlen
                                || !is_ident_cont((u8)raw[hs + tq + 3]))) {
                            pa_error("f-string: 插值里不能用 'try'");
                            break;
                        }
                        tq++;
                    }
                }
                {
                    /* `{expr;spec}`：`;` 之后是格式说明；洞里带嵌套字符串
                     * 字面量的（`f"{f\"...\"}"`）先不做，避免把反斜杠层数
                     * 搞错。 */
                    u32 hq = 0;
                    u32 hd = 0;

                    /* 找 `;` 要跳过嵌套的 `{}` 和字符串字面量：嵌套 f-string
                     * `f"{f\"{n;x}\"}"` 里那个 `;` 属于内层的格式说明。 */
                    while (hq < hlen) {
                        char hc = raw[hs + hq];

                        if (hc == '{') {
                            hd++;
                        } else if (hc == '}') {
                            if (hd == 0)
                                break;
                            hd--;
                        } else if (hc == '"' || hc == '\'') {
                            char qc = hc;

                            hq++;
                            while (hq < hlen && raw[hs + hq] != qc) {
                                if (raw[hs + hq] == '\\')
                                    hq++;
                                hq++;
                            }
                        } else if (hc == '\\' && hq + 1 < hlen
                                   && (raw[hs + hq + 1] == '"'
                                       || raw[hs + hq + 1] == '\'')) {
                            char qc = raw[hs + hq + 1];

                            hq += 2;
                            while (hq + 1 < hlen
                                   && !(raw[hs + hq] == '\\'
                                        && raw[hs + hq + 1] == qc))
                                hq++;
                            hq++;
                        } else if (hc == ';' && hd == 0) {
                            spec = raw + hs + hq + 1;
                            sl = hlen - hq - 1;
                            hlen = hq;
                            if (sl == 0)
                                pa_error("f-string: '{expr;spec}' 里的格式说明是空的");
                            break;
                        }
                        hq++;
                    }

                }
                if (hlen > 0) {
                    Sym *hs2 = NULL;
                    u32 hv = 0;
                    u32 hty = 0;
                    int got = 0;
                    u32 q = 0;
                    int plain = 1;

                    for (q = 0; q < hlen; q++) {
                        int ch = (u8)raw[hs + q];

                        if (q == 0 ? !is_ident_start(ch) : !is_ident_cont(ch)) {
                            plain = 0;
                            break;
                        }
                    }
                    if (plain)
                        hs2 = sym_find(raw + hs, hlen);
                    if (hs2 && hs2->is_func) {
                        /* 函数不是值，函数指针才是（按地址输出） */
                        pa_error("f-string: 函数 '%.*s' 不是值，函数指针才是",
                                 (int)hlen, raw + hs);
                        hs2 = NULL;
                    }
                    if (hs2
                        && (hs2->kind == SC_LOCAL || hs2->kind == SC_PARAM
                            || hs2->kind == SC_GLOBAL)) {
                        /* 聚合/切片在我们的约定里就是"用地址代表值"，
                         * 不能走 load_lval（那会把它第一个机器字当成值）。 */
                        if (ty_is_agg(hs2->type) || ty_is_slice(hs2->type)
                            || ty_is_array(hs2->type))
                            hv = ident_addr(hs2);
                        else
                            hv = load_lval(ident_addr(hs2), hs2->type);
                        hty = hs2->type;
                        got = 1;
                    } else if (fstr_hole_expr(raw, stk_file, hs, hlen,
                                              &hv, &hty)) {
                        got = 1;
                    }
                    if (got) {
                        u32 stg = ty_is_slice(hty) ? ty_slice_elem(hty) : 0;

                        if (hty == ty_void())
                            pa_error("f-string: void 值不能插值");
                        else if (stg && !ty_charish(stg) && !ty_is_slice(stg)
                                 && !ty_is_agg(stg) && !ty_is_ptr(stg))
                            pa_error("f-string: 只有字符切片能插值（%d 元素不行）",
                                     (int)stg);
                        else if (ty_is_agg(hty) && !ty_is_slice(hty))
                            pa_error("f-string: 结构体/联合体的值不能插值");
                        /* 别写成 `av[na++] = fstr_fmt_arg(..., &na)`：那个
                         * `na++` 和函数里对 na 的自增没有先后序，切片要占
                         * 两格时正好踩到（实参顺序一乱就段错误）。 */
                        u32 rv = fstr_fmt_arg(fmt, &fl, hty, hv, spec, sl,
                                              av, &na);

                        if (na < 8) {
                            av[na] = rv;
                            na++;
                        }
                    }
                }
                if (i2 < rl)
                    i2++;
                continue;
            }
            if (raw[i2] == '{' && i2 + 1 < rl && raw[i2 + 1] == '{') {
                fmt[fl++] = '{';         /* `{{` 是字面量花括号 */
                i2 += 2;
                continue;
            }
            if (raw[i2] == '}' && i2 + 1 < rl && raw[i2 + 1] == '}') {
                fmt[fl++] = '}';         /* `}}` 同上 */
                i2 += 2;
                continue;
            }
            /* 字面量里的转义要在写数据段之前解掉：`fmt` 是 snprintf 直接读
             * 的字节，`\n`、`\"`、`\x41` 得变成真正的字符（以前原样抄
             * 进去，`f"\t{n}"` 输出的是反斜杠 t）。 */
            if (raw[i2] == '\\' && i2 + 1 < rl) {
                char e = raw[i2 + 1];
                int ch = 0;

                i2 += 2;
                switch (e) {
                case 'n': ch = '\n'; break;
                case 't': ch = '\t'; break;
                case 'r': ch = '\r'; break;
                case 'a': ch = 7; break;
                case 'b': ch = 8; break;
                case 'f': ch = 12; break;
                case 'v': ch = 11; break;
                case 'e': ch = 27; break;
                case 'x': {
                    u32 h = 0;

                    while (i2 < rl && h < 2
                           && ((raw[i2] >= '0' && raw[i2] <= '9')
                               || (raw[i2] >= 'a' && raw[i2] <= 'f')
                               || (raw[i2] >= 'A' && raw[i2] <= 'F'))) {
                        int dv = raw[i2] <= '9' ? raw[i2] - '0'
                                 : (raw[i2] | 32) - 'a' + 10;

                        ch = ch * 16 + dv;
                        h++;
                        i2++;
                    }
                    break;
                }
                default:
                    if (e >= '0' && e <= '7') {
                        u32 h = 0;

                        ch = e - '0';
                        while (i2 < rl && h < 2 && raw[i2] >= '0'
                               && raw[i2] <= '7') {
                            ch = ch * 8 + (raw[i2] - '0');
                            h++;
                            i2++;
                        }
                    } else {
                        ch = (u8)e;
                    }
                    break;
                }
                if (ch == '%')
                    fmt[fl++] = '%';
                fmt[fl++] = (char)ch;
                continue;
            }
            if (raw[i2] == '%')
                fmt[fl++] = '%';         /* 字面量里的 % 要转义 */
            fmt[fl++] = raw[i2];
            i2++;
        }
        fmt[fl] = 0;
        foff = data_alloc(fl + 1, 1);
        for (i2 = 0; i2 <= fl; i2++)
            DATA_IMG.p[foff + i2] = (u8)fmt[i2];
        /* 同一次求值深度上复用同一块临时缓冲（c6 的约定：`f".."` 借用的
         * 缓冲只保证到"下一次同深度求值"之前，见 tests/fstr.c6）；更深的
         * 嵌套用自己的那一格，不会盖掉外层的。 */
        if (fdt < 8 && !fdm) {
            if (FSTR_SLOT[fdt] == 0)
                FSTR_SLOT[fdt] = frame_slots_for(1024);
            slot = FSTR_SLOT[fdt];
        } else {
            slot = frame_slots_for(1024);
        }
        aptr = irfn_vreg(&FN);
        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)aptr, 0, 0, 0, X64_SLOT(slot));
        cfmt = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONSTK, IRT_PTR, (u16)cfmt, 0, 0, 0,
                  irfn_kconst(&FN, (u64)DATA_VA(foff)));
        ccap = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)ccap, 0, 0, 0, 1024);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)aptr, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)ccap, 0, 0, 1);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)cfmt, 0, 0, 2);
        {
            u32 k2 = 0;

            for (k2 = 0; k2 < na; k2++)
                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)av[k2], 0, 0, 3 + k2);
        }
        dst = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_I64, (u16)dst, 0, 0, 0, x64_sym(&X64, "snprintf"));
        FN.ops[FN.n - 1].narg = (u8)(3 + na);
        GEN_TY = ty_ptr(ty_char());
        E_WAS_CALL = 1;            /* `@f"…"` 也是新引用（帧内缓冲，够用就行） */
        FSTR_DEPTH = (int)fdt;
        return gen_postfix_ops(aptr);
    }
    /* `await expr`：任务都同步跑完了，await 就是取它的值（和 __c6_co_wait
     * 那组桩一致）。软关键字：后面跟 `=`/`;`/`)` 之类时是普通标识符。 */
    if (PA_IS_IDENT("await") && c6_kw() && pa_peek(1)
        && !(pa_peek(1)->kind == TK_PUNCT
             && (TOK_EQ(pa_peek(1), "=") || TOK_EQ(pa_peek(1), ";")
                 || tok_eq(pa_peek(1), ")") || tok_eq(pa_peek(1), ",")
                 || TOK_EQ(pa_peek(1), ".") || TOK_EQ(pa_peek(1), "[")))) {
        u32 av = 0;
        u32 aty = 0;

        int was_io = 0;

        pa_advance();
        /* await 只能在 async 函数里；defer 体里不行（defer 必须同步跑完）、
         * sizeof/typeof 这种不求值上下文里也不行。 */
        if (!CUR_TASK_TY)
            pa_error("'await' 只能出现在 async 函数里");
        else if (PA_IN_DEFER)
            pa_error("'await' 不能出现在 defer 体里");
        else if (PA_UNEVAL)
            pa_error("'await' 不能出现在 sizeof/typeof 这种不求值上下文里");
        /* `await c6_io(fd, ev)` 是合法形态；c6_io 单独调用见标识符那边。 */
        was_io = (pa_cur()->kind == TK_IDENT && TOK_EQ(pa_cur(), "c6_io")) ? 1 : 0;
        {
            int io_save = PA_AWAIT_IO;

            PA_AWAIT_IO = was_io;
            av = gen_unary();
            /* 按值返回聚合体的调用给出的是**地址**，别再取值（元组/struct
             * 结果被 `await` 时多 load 一次就是一堆垃圾，踩过）。 */
            if (!ty_is_agg(GEN_TY) && !ty_is_array(GEN_TY))
                av = value_of(av);
            PA_AWAIT_IO = io_save;
        }
        if (was_io)
            async_unwind_gate();          /* `await c6_io(…)` 的挂起点 */
        aty = GEN_TY;
        /* 任务结构指针：值在 `t->val` */
        if (ty_is_ptr(aty)) {
            u32 mty2 = 0;
            u32 moff2 = 0;

            if (agg_find_promoted(ty_target(aty), "val", 3, &mty2, &moff2)) {
                u32 lv = irfn_vreg(&FN);
                u32 la = irfn_vreg(&FN);
                u32 aw = irfn_vreg(&FN);

                /* 任务还没结束就在这里挂起（`await` 的语义），结束时返回 */
                if (!was_io) {
                    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)av, 0, 0, 0);
                    irfn_push(&FN, IR_CALL, IRT_I64, (u16)aw, 0, 0, 0,
                              x64_sym(&X64, "__c6_co_await"));
                    FN.ops[FN.n - 1].narg = 1;
                    async_unwind_gate();
                }

                irfn_push(&FN, IR_LEA, IRT_PTR, (u16)la, (u16)av, 0, 0, (u32)moff2);
                if (ty_is_agg(mty2) || ty_is_array(mty2)) {
                    /* `t->val` 本身是聚合体：按地址约定，地址就是那个 LEA */
                    GEN_TY = mty2;
                    PEND_LVAL = 0;
                    return gen_postfix_ops(la);
                }
                irfn_push(&FN, IR_LOAD, ir_ty_of(mty2), (u16)lv, (u16)la, 0, 0, 0);
                GEN_TY = mty2;
                PEND_LVAL = 0;
                return gen_postfix_ops(lv);
            }
        }
        if (!was_io)
            pa_error("'await' 的操作数必须是一次 async 调用（或 await c6_io(fd, ev)）");
        GEN_TY = aty;
        return gen_postfix_ops(av);
    }
    /* c6 的 `try expr`：出错就当场从当前函数返回那个错误码（错误槽保持置位，
     * 由调用方的 catch 接手），成功则原样给出表达式的值。软关键字——后面跟
     * `=` / `;` / `)` / `,` / `.` / `[` 的时候它是普通标识符。 */
    if (c6_kw() && PA_IS_IDENT("try") && pa_peek(1)
        && !(pa_peek(1)->kind == TK_PUNCT
             && (TOK_EQ(pa_peek(1), "=") || TOK_EQ(pa_peek(1), ";")
                 || tok_eq(pa_peek(1), ")") || tok_eq(pa_peek(1), ",")
                 || TOK_EQ(pa_peek(1), ".") || TOK_EQ(pa_peek(1), "[")))) {
        u32 tv = 0;
        u32 tty = 0;
        u32 tfl = 0;
        u32 lret = 0;
        u32 lend = 0;

        pa_advance();
        if (!CUR_FALLIBLE)
            pa_error("'try' 要求当前函数返回 'T!error'");
        if (PA_IN_DEFER)
            pa_error("'try' 不能出现在 defer 体里");
        if (PA_IN_DROP)
            pa_error("'drop' 不能失败：它在对象释放时跑，错误没处去");
        {
            int shaped = 1;    /* 1 = 标识符调用，2 = 说不准，0 = 明显不是调用 */

            if (!(pa_cur()->kind == TK_IDENT && pa_peek(1)
                  && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "("))) {
                shaped = 0;
                if (pa_cur()->kind == TK_IDENT && pa_peek(1)
                    && pa_peek(1)->kind == TK_PUNCT
                    && (TOK_EQ(pa_peek(1), "->") || TOK_EQ(pa_peek(1), ".")
                        || TOK_EQ(pa_peek(1), "[")))
                    shaped = 2;    /* 方法/下标调用：可失败性查不出来 */
                else if (pa_cur()->kind == TK_PUNCT
                         && (tok_eq(pa_cur(), "(") || TOK_EQ(pa_cur(), "*")))
                    shaped = 2;
            }
            if (shaped == 0) {
                pa_error("'try' 要跟一次返回 'T!error' 的调用");
            } else if (shaped == 1) {
                Sym *tfs = sym_find(tok_data(pa_cur()), pa_cur()->len);

                if (tfs && tfs->is_func && !tfs->fallible)
                    pa_error("'try' 要跟一次返回 'T!error' 的调用");
            }
        }
        tv = value_of(gen_unary());
        tty = GEN_TY;
        tfl = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_I32, (u16)tfl, 0, 0, 0,
                  x64_sym(&X64, "__tcc_err_flag_get"));
        FN.ops[FN.n - 1].narg = 0;
        lret = irfn_label(&FN);
        lend = irfn_label(&FN);
        irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)tfl, (u16)lret, (u16)lend, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lret, 0, 0, 0);
        defer_run(1, 1);                 /* 错误路径：errdefer 也要跑 */
        irfn_push(&FN, IR_RET, ir_ty_of(CUR_RET_TY), 0, (u16)tv, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
        GEN_TY = tty;
        return gen_postfix_ops(tv);
    }
    /* GNU 计算 goto 的取标号地址：`&&label`（一元位置）。注意别和逻辑与
     * 混淆——`&&` 出现在**一元**位置时后面一定跟标识符。 */
    if (pa_is_punct("&&") && pa_peek(1)->kind == TK_IDENT) {
        u32 l = goto_label(tok_data(pa_peek(1)), pa_peek(1)->len);
        u32 d = irfn_vreg(&FN);

        pa_advance();
        pa_advance();
        irfn_push(&FN, IR_LABELADDR, IRT_PTR, (u16)d, (u16)l, 0, 0, 0);
        GEN_TY = ty_ptr(ty_void());
        return gen_postfix_ops(d);
    }
    /* `spawn f(a, b)`：软关键字——后面是 标识符 + `(` 才算 */
    if (PA_IS_IDENT("spawn") && c6_kw() && pa_peek(1)->kind == TK_IDENT
        && pa_peek(2)->kind == TK_PUNCT
        && (tok_eq(pa_peek(2), "(") || TOK_EQ(pa_peek(2), "@"))) {
        if (PA_IN_DROP)
            pa_error("'drop' 不能挂起：它在对象释放时跑");
        Sym *ss = NULL;
        u32 sargs[16] = {0};
        u32 sargty[16] = {0};
        u8 sargmgd[PA_ARG_MAX] = {0};
        u32 mgdmask = 0;
        u32 sn = 0;
        u32 i2 = 0;
        u32 env = 0;
        u32 tgtv = 0;
        u32 th = 0;
        u32 thsz = 0;
        u32 startv = 0;
        u32 zv = 0;
        u32 pc = x64_sym(&X64, "pthread_create");
        u32 thr = x64_sym(&X64, "__c6_thr_start");
        u32 msym = x64_sym(&X64, "malloc");
        u32 thunk = 0;

        pa_advance();                        /* spawn */
        /* `spawn vsum@int(&v)`：函数模板的实例也是普通函数，先实例化再取符号 */
        if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(1), "@")) {
            Tmpl *st = tmpl_find(tok_data(pa_cur()), pa_cur()->len);

            if (st && st->is_func) {
                u32 targs[TMPL_NPARAM] = {0};
                u32 tna = 0;
                char tnm2[320] = {0};

                pa_advance();
                pa_advance();               /* @ */
                tna = tmpl_parse_args(st, targs, pa_is_ch('('));
                (void)tmpl_func_sig(st, targs, tna);
                tmpl_mangle_name(st, targs, tna, tnm2, sizeof(tnm2));
                ss = sym_find(tnm2, (u32)strlen(tnm2));
            }
        } else {
            ss = sym_find(tok_data(pa_cur()), pa_cur()->len);
        }
        if (!ss || !ss->is_func) {
            pa_error("spawn 后面要一个函数名");
            GEN_TY = ty_thread();
            return 0;
        }
        /* `spawn` 起的是普通线程：async 函数有自己的任务结构、可失败函数
         * 的错误没处送、变参和函数指针参数的约定也搬不过去
         * （tests/errors/spawn.c6）。 */
        if (ty_is_task_ptr(ty_func_ret(ss->type))) {
            pa_error("'spawn' requires a plain function: '%.*s' is 'async'",
                     (int)ss->len, ss->name);
        } else if (ss->fallible) {
            pa_error("'spawn' does not support fallible functions: '%.*s'",
                     (int)ss->len, ss->name);
        } else if (ty_func_variadic(ss->type)) {
            pa_error("'spawn' does not support variadic functions: '%.*s'",
                     (int)ss->len, ss->name);
        } else {
            u32 pi = 0;

            for (pi = 0; pi < ty_func_nparams(ss->type); pi++) {
                u32 pt = ty_func_param(ss->type, pi);

                if (ty_is_func(pt)
                    || (ty_is_ptr(pt) && ty_is_func(ty_target(pt)))) {
                    pa_error("'spawn' does not support this signature: '%.*s'",
                             (int)ss->len, ss->name);
                    break;
                }
            }
        }
        pa_advance();
        pa_advance();                        /* ( */
        if (!pa_accept_ch(')')) {
            for (;;) {
                if (sn >= PA_ARG_MAX) {
                    pa_error("spawn 实参太多（上限 16）");
                    break;
                }
                {
                    /* 托管引用（`shared @T`）要记下来：实参块自己持一份计数 */
                    u32 av0 = gen_assign();
                    int amgd = PEND_MGD;
                    Sym *asym = PEND_MGD_SYM;

                    /* 跨线程传引用必须写 `shared @T`：普通 `@T` 的计数不是原子的
                     * （tests/errors/gc_borrow.c6 的 test_spawn_plain）。 */
                    if (asym && asym->is_mgd == 1 && !asym->is_shared && in_c6_tu())
                        pa_error("passing a reference to 'spawn' requires 'shared'");
                    if (ty_is_closure(GEN_TY, NULL))
                        pa_error("a closure cannot cross a thread or a task: V2 "
                                 "closures are confined to the thread that creates "
                                 "them");
                    sargs[sn] = value_of(av0);
                    if (mgd_tmp_has(sargs[sn]))
                        amgd = 1;
                    sargmgd[sn] = (u8)(amgd ? 1 : 0);
                    sargty[sn] = GEN_TY;
                    if (amgd)
                        mgdmask |= 1u << sn;
                    sn++;
                }
                if (!pa_accept_ch(','))
                    break;
            }
            pa_expect_ch(')');
        }
        thunk = spawn_thunk((int)sn, mgdmask);
        /* 聚合实参按值传到线程里：参数块后面留一块副本区，spawn 处就把结构体
         * 拷过去，线程拿到的是副本（`spawn f(v); v.a = 100;` 不影响它）。
         * 非聚合的参数本来就是值，直接存 8 字节。 */
        {
            u32 aggsz = 0;

            for (i2 = 0; i2 < sn; i2++)
                if (sargty[i2] && ty_is_agg(sargty[i2]))
                    aggsz += (ty_size(sargty[i2]) + 7) / 8 * 8;
            env = clos_alloc(thunk, 16 + 8 * sn + aggsz);
        }
        tgtv = irfn_vreg(&FN);
        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)tgtv, 0, 0, 0, (u32)ss->val);
        FN.ops[FN.n - 1].flags = 2;
        irfn_push(&FN, IR_STORE, IRT_U64, (u16)gen_addr_off(env, 8), (u16)tgtv, 0, 0, 0);
        {
            u32 aggoff = 16 + 8 * sn;

            for (i2 = 0; i2 < sn; i2++) {
                if (sargty[i2] && ty_is_agg(sargty[i2])) {
                    u32 asz = ty_size(sargty[i2]);
                    u32 dstv = gen_addr_off(env, aggoff);

                    irfn_push(&FN, IR_COPY, IRT_U64, (u16)dstv, (u16)sargs[i2], 0, 0, asz);
                    irfn_push(&FN, IR_STORE, IRT_U64,
                              (u16)gen_addr_off(env, 16 + 8 * i2), (u16)dstv, 0, 0, 0);
                    aggoff += (asz + 7) / 8 * 8;
                } else {
                    irfn_push(&FN, IR_STORE, IRT_U64,
                              (u16)gen_addr_off(env, 16 + 8 * i2), (u16)sargs[i2], 0, 0, 0);
                }
                /* 实参块持有自己那一份（线程退出时由中转函数还回来） */
                if (sargmgd[i2])
                    mgd_retain(sargs[i2]);
            }
        }
        thsz = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)thsz, 0, 0, 0, 16);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)thsz, 0, 0, 0);
        th = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_PTR, (u16)th, 0, 0, 0, msym);
        FN.ops[FN.n - 1].narg = 1;
        zv = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)zv, 0, 0, 0, 0);
        startv = irfn_vreg(&FN);
        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)startv, 0, 0, 0, thr);
        FN.ops[FN.n - 1].flags = 2;
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)th, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)zv, 0, 0, 1);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)startv, 0, 0, 2);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)env, 0, 0, 3);
        {
            u32 d2 = irfn_vreg(&FN);

            irfn_push(&FN, IR_CALL, IRT_I64, (u16)d2, 0, 0, 0, pc);
            FN.ops[FN.n - 1].narg = 4;
        }
        GEN_TY = ty_thread();
        return gen_postfix_ops(th);
    }
    /* 函数字面量 `int(int n) { return n * 3; }`（不捕获） */
    /* 一元位置上出现类型名只可能是字面量（强转要以 `(` 开头、sizeof 走前面），
     * 所以不要求紧跟 `(`——`struct Point(int v){…}` 这种多 token 的返回类型
     * 也要能认出来。形状还是要扫一遍确认。 */
    if (pa_at_typename() && !(pa_peek(1)->kind == TK_PUNCT
                               && TOK_EQ(pa_peek(1), "."))) {
        int depth = 0;
        int q = 0;
        int is_lit = 0;

        for (q = 1; q < PA_LOOK; q++) {
            Tok *t2 = pa_peek(q);

            if (t2->kind != TK_PUNCT)
                continue;
            if (tok_eq(t2, "(")) {
                depth++;
            } else if (tok_eq(t2, ")")) {
                depth--;
                if (depth == 0) {
                    Tok *nx = pa_peek(q + 1);

                    is_lit = (nx->kind == TK_PUNCT && TOK_EQ(nx, "{"));
                    break;
                }
            }
        }
        if (is_lit) {
            Sym *fs = NULL;

            fs = fnlit_parse_sym();
            u32 addr = 0;
            int fi = FL_LAST;

            if (!fs) {
                GEN_TY = ty_int();
                return 0;
            }
            /* 捕获的闭包：现开一个环境对象，把外层变量的值拷进去 */
            if (fi >= 0 && fi < (int)NFL && FL[fi].ncap > 0) {
                u32 env = clos_alloc((u32)fs->val, FL[fi].envbytes);
                int k = 0;

                for (k = 0; k < FL[fi].ncap; k++) {
                    Sym *os = sym_find(FL[fi].cname[k], FL[fi].clen[k]);
                    u32 sz = 0;
                    u32 dst = 0;

                    if (!os)
                        continue;
                    sz = ty_size(os->type);
                    if (sz == 0)
                        sz = 8;
                    dst = gen_addr_off(env, FL[fi].coff[k]);
                    if (sz == 1 || sz == 2 || sz == 4 || sz == 8) {
                        u32 lv = irfn_vreg(&FN);

                        irfn_push(&FN, IR_LOAD, ir_ty_of(os->type), (u16)lv,
                                  (u16)ident_addr(os), 0, 0, 0);
                        irfn_push(&FN, IR_STORE, ir_ty_of(os->type), (u16)dst,
                                  (u16)lv, 0, 0, 0);
                    } else {
                        irfn_push(&FN, IR_COPY, IRT_U8, (u16)dst,
                                  (u16)ident_addr(os), 0, 0, sz);
                    }
                }
                GEN_TY = ty_closure(FL[fi].fty);
                return gen_postfix_ops(env);
            }
            /* 关键：走 ident_addr（内部会置 flags=2，发射成 rip 相对 + 重定位），
             * 手工 push 一条 IR_ADDR 会走成"栈槽偏移"那条分支。 */
            addr = ident_addr(fs);
            GEN_TY = ty_ptr(fs->type);
            return gen_postfix_ops(addr);
        }
    }
    /* `new T`：分配一块零初始化的 T（`@T` 的表示就是 `T *`，对象头与引用
     * 计数还没做，所以现在是"只分配不回收"，见 docs/manual/gc.md）。 */
    if (PA_IS_IDENT("new") && !(pa_peek(1)->kind == TK_PUNCT
        && (TOK_EQ(pa_peek(1), "=") || tok_eq(pa_peek(1), "(")
            || TOK_EQ(pa_peek(1), ";") || TOK_EQ(pa_peek(1), ".")))) {
        u32 ty = 0;
        u32 esz = 0;
        u32 d = 0;
        u32 ncnt = 0;
        int is_arr = 0;
        Sym *ms = NULL;

        pa_advance();
        ty = parse_typespec();
        if (ty_is_closure(ty, NULL))
            pa_error("a closure cannot be created with 'new': use a function "
                     "literal or a function pointer");
        /* `new shared T` 和 `new T` 的区别：前者带原子计数，能进 shared 槽
         * （tests/errors/gc_borrow.c6 的 test_shared_new_plain）。 */
        E_NEW_SEEN = 1;
        E_NEW_SHARED = PA_MGD_SHARED ? 1 : 0;
        PA_MGD_SHARED = 0;
        while (pa_accept_ch('*'))
            ty = ty_ptr(ty);
        esz = ty_size(ty) ? ty_size(ty) : 8;
        if (pa_accept_ch('[')) {
            /* `new T[n]`：元素个数是运行期值，运行时要靠它逐个析构 */
            ncnt = value_of(gen_expr());

            pa_expect_ch(']');
            is_arr = 1;
        }
        ms = sym_find(is_arr ? "__c6_gc_new_arr" : "__c6_gc_new",
                      is_arr ? 15 : 11);
        if (!ms || !ms->is_func) {
            pa_error("`new` 需要运行时提供 __c6_gc_new");
            GEN_TY = ty_ptr(ty);
            return 0;
        }
        {
            u32 nv = irfn_vreg(&FN);
            u32 ev = irfn_vreg(&FN);
            u32 dv = irfn_vreg(&FN);
            u32 dsym = mgd_desc(ty);

            /* 描述符：让运行时知道怎么析构、哪些字段是托管引用 */
            irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)dv, 0, 0, 0, dsym);
            FN.ops[FN.n - 1].flags = 2;
            if (is_arr) {
                irfn_push(&FN, IR_MOV, IRT_U64, (u16)nv, (u16)ncnt, 0, 0, 0);
                irfn_push(&FN, IR_CONST, IRT_U64, (u16)ev, 0, 0, 0, esz);
                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)nv, 0, 0, 0);
                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)ev, 0, 0, 1);
                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)dv, 0, 0, 2);
            } else {
                irfn_push(&FN, IR_CONST, IRT_U64, (u16)nv, 0, 0, 0, esz);
                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)nv, 0, 0, 0);
                irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)dv, 0, 0, 1);
            }
            d = irfn_vreg(&FN);
            irfn_push(&FN, IR_CALL, IRT_PTR, (u16)d, 0, 0, 0, (u32)ms->val);
            FN.ops[FN.n - 1].narg = (u32)(is_arr ? 3 : 2);
        }
        GEN_TY = ty_ptr(ty);
        mgd_tmp_add(d);
        return gen_postfix_ops(d);
    }
    /* c6 的 `try f(...)`：在 `T!error` 函数里转发错误。错误 id 就是返回值
     * （0 = 成功），所以非 0 时直接 `return 那个 id`，成功时值就是 0。
     * 语句形式 `try reserve(n + 1);` 是丢弃这个值，同一条路径。 */
    if (c6_kw() && PA_IS_IDENT("try")) {
        u32 l_bad = irfn_label(&FN);
        u32 l_ok = irfn_label(&FN);
        u32 v = 0;

        pa_advance();
        v = value_of(gen_unary());
        irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)v, (u16)l_bad, (u16)l_ok, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)l_bad, 0, 0, 0);
        irfn_push(&FN, IR_RET, ir_ty_of(CUR_RET_TY), 0, (u16)v, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)l_ok, 0, 0, 0);
        GEN_TY = ty_int();
        return v;
    }
    if (pa_accept_ch('&')) {
        u32 a = 0;
        int sav_amp = PA_AMP;

        E_WAS_ADDR = 1;
        PA_AMP = 1;
        a = gen_unary();
        PA_AMP = sav_amp;

        if (!PEND_LVAL && (ty_is_func(GEN_TY)
                           || (ty_is_ptr(GEN_TY) && ty_is_func(ty_target(GEN_TY))))) {
            /* &函数名：函数名在值位置上已经是"函数指针"，取地址还是它 */
            if (ty_is_func(GEN_TY))
                GEN_TY = ty_ptr(GEN_TY);
            return a;
        }
        /* `&call()`：按值返回聚合体本来就走"返回地址"这条约定，取地址还是它。 */
        if (!PEND_LVAL && ty_is_agg(GEN_TY))
            return a;
        if (!PEND_LVAL) {
            pa_error("'&' 需要一个左值");
            GEN_TY = ty_ptr(ty_int());
            return a;
        }
        PEND_LVAL = 0;
        GEN_TY = ty_ptr(PEND_TY);
        return PEND_ADDR;
    }
    if (pa_accept_ch('*')) {
        u32 p = 0;
        u32 ty = 0;

        if (ty_is_closure(GEN_TY, NULL))
            pa_error("'closure' is opaque: it can only be called, compared with "
                     "NULL, copied, moved or released");
        p = value_of(gen_unary());
        ty = GEN_TY;
        if (!ty_is_ptr(ty) && !ty_is_array(ty)) {
            pa_error("'*' 的对象不是指针");
            ty = ty_ptr(ty_int());
        }
        mark_lval(p, ty_target(ty));
        return p;
    }
    if (pa_accept_ch('-')) {
        u32 a = value_of(gen_unary());
        u32 ty = ty_promote(GEN_TY);
        u32 z = irfn_vreg(&FN);
        u32 d = irfn_vreg(&FN);

        if (ty_is_float(ty)) {
            irfn_push(&FN, IR_FNEG, ir_ty_of(ty), (u16)d, (u16)a, 0, 0, 0);
            GEN_TY = ty;
            return d;
        }
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)z, 0, 0, 0, 0);
        irfn_push(&FN, IR_SUB, ir_ty_of(ty), (u16)d, (u16)z, (u16)a, 0, 0);
        /* 一元负号也要按类型宽度回绕：`-(unsigned)0x80000002` 在 32 位里是
         * 0x7FFFFFFE，用 64 位中间值下去除就会算错（踩过 61_integers）。 */
        if (ty_is_int(ty) && ty_size(ty) < 8) {
            u32 t2 = irfn_vreg(&FN);

            irfn_push(&FN, IR_TRUNC, ir_ty_of(ty), (u16)t2, (u16)d, 0, 0, 0);
            d = t2;
        }
        GEN_TY = ty;
        return d;
    }
    if (pa_accept_ch('+'))
        return gen_unary();
    if (pa_accept_ch('!')) {
        u32 a = value_of(gen_unary());
        u32 z = irfn_vreg(&FN);
        u32 d = irfn_vreg(&FN);

        irfn_push(&FN, IR_CONST, IRT_U64, (u16)z, 0, 0, 0, 0);
        irfn_push(&FN, IR_CMP, IRT_U64, (u16)d, (u16)a, (u16)z, 0, IRCC_EQ);
        irfn_setcc(&FN, IRCC_EQ);
        GEN_TY = ty_int();
        return d;
    }
    if (pa_accept_ch('~')) {
        u32 a = value_of(gen_unary());
        u32 ty = GEN_TY;
        u32 d = irfn_vreg(&FN);

        irfn_push(&FN, IR_NOT, ir_ty_of(ty), (u16)d, (u16)a, 0, 0, 0);
        GEN_TY = ty;
        return d;
    }
    if (pa_is_punct("++") || pa_is_punct("--")) {
        int inc = pa_is_punct("++");
        u32 a = 0;
        u32 addr = 0;
        u32 ty = 0;
        u32 old_v = 0;
        u32 one = 0;
        u32 nv = 0;

        pa_advance();        /* 先吃掉 ++/--，不然递归会原地打转 */
        a = gen_unary();
        if (!PEND_LVAL) {
            pa_error("前缀 ++/-- 需要一个左值");
            GEN_TY = ty_int();
            return a;
        }
        {
            u32 bb = PEND_BITS;
            u32 bb_off = PEND_BITOFF;

            addr = PEND_ADDR;
            ty = PEND_TY;
            PEND_LVAL = 0;
            old_v = bb ? load_bf(addr, ty, bb, bb_off, ty_is_signed(ty), PEND_BF_ENUM)
                       : load_lval(addr, ty);
            one = irfn_vreg(&FN);
            irfn_push(&FN, IR_CONST, IRT_U64, (u16)one, 0, 0, 0,
                      ty_is_ptr(ty) ? (ty_size(ty_target(ty)) ? ty_size(ty_target(ty)) : 1) : 1);
            nv = irfn_vreg(&FN);
            irfn_push(&FN, inc ? IR_ADD : IR_SUB, ir_ty_of(ty), (u16)nv, (u16)old_v, (u16)one,
                      0, 0);
            if (bb)
                store_lval_bits(addr, ty, bb, bb_off, nv);
            else
                store_lval(addr, ty, nv);
        }
        GEN_TY = ty;
        return nv;
    }
    if (PA_IS_IDENT("sizeof") || PA_IS_IDENT("__alignof__")
        || PA_IS_IDENT("_Alignof") || PA_IS_IDENT("alignof")) {
        u32 ty = 0;
        u32 d = 0;
        int is_align = 0;

        if (PA_ACCEPT_IDENT("sizeof")) {
            is_align = 0;
        } else {
            (void)PA_ACCEPT_IDENT("__alignof__");
            (void)PA_ACCEPT_IDENT("_Alignof");
            (void)PA_ACCEPT_IDENT("alignof");
            is_align = 1;
        }
        if (pa_is_ch('(') && (is_typename_tok(pa_peek(1))
            || (pa_peek(1)->kind == TK_IDENT && pa_peek(2)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(2), "@"))
            /* `sizeof(@Node)` / `sizeof(weak @Node)`：托管类型的写法 */
            || (pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), "@"))
            || (pa_peek(1)->kind == TK_IDENT
                && (TOK_EQ(pa_peek(1), "weak") || TOK_EQ(pa_peek(1), "shared")
                    || TOK_EQ(pa_peek(1), "own"))
                && (pa_peek(2)->kind == TK_IDENT || pa_peek(2)->kind == TK_PUNCT))
            /* `sizeof((int, int))`：内层括号是类型，而且它的闭括号后面
             * 紧跟 sizeof 自己的 `)`——否则就是复合字面量 `(t){…}` */
            || (pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")
                && is_typename_tok(pa_peek(2))
                && pa_peek(3)->kind == TK_PUNCT
                && (tok_eq(pa_peek(3), ",") || tok_eq(pa_peek(3), ")"))
                && sizeof_inner_type_end()))) {
            pa_advance();
            ty = parse_typename();
            if (pa_is_ch(',')) {
                /* `sizeof((int, int))`：元组类型 */
                u32 tys[TUPLE_MAXN] = {0};
                u32 tn = 0;

                tys[tn++] = ty;
                while (tn < TUPLE_MAXN && pa_accept_ch(','))
                    tys[tn++] = parse_typename();
                ty = ty_tuple_chk(tys, tn);
            }
            pa_expect_ch(')');
        } else if (!is_align && pa_is_ch('(') && pa_peek(1)->kind == TK_STR
                   && pa_peek(2)->kind == TK_PUNCT && tok_eq(pa_peek(2), ")")) {
            /* sizeof("abc") 同 sizeof "abc"：括号里就一个字符串字面量 */
            pa_advance();
            (void)str_lit_data();
            ty = ty_array(ty_char(), STR_LIT_N + 1);
            pa_expect_ch(')');
        } else if (!is_align && pa_cur()->kind == TK_STR) {
            /* sizeof "abc" 是 4 不是 8：字符串字面量的类型是 char[N]（含结尾 0），
             * 按表达式求值只会拿到退化后的 char *。tcc 的
             * `file_offset = sizeof ARMAG - 1` 就靠这个，错了整份 .a 都读歪。 */
            (void)str_lit_data();
            ty = ty_array(ty_char(), STR_LIT_N + 1);
        } else {
            u32 save = FN.n;
            u32 v2 = 0;
            int un_save = PA_UNEVAL;

            PA_UNEVAL = 1;
            v2 = gen_unary();
            PA_UNEVAL = un_save;
            ty = cur_op_ty();
            (void)v2;
            FN.n = save;     /* sizeof 的操作数不求值 */
            /* 操作数留下的左值态必须清掉，否则外层 `(int)sizeof x` 会把
             * “x 的地址”当成 sizeof 的结果传上去 */
            PEND_LVAL = 0;
        }
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0,
                  is_align ? (u32)ty_align_of(ty) : ty_size(ty));
        GEN_TY = ty_ulong();
        return d;
    }
    if (pa_is_ch('(')
        && (is_typename_tok(pa_peek(1)) || TOK_EQ(pa_peek(1), "typeof")
            || (NIFACE > 0 && pa_peek(1)->kind == TK_IDENT
                && iface_find(tok_data(pa_peek(1)), pa_peek(1)->len) < IFACE_MAX)
            || (pa_peek(1)->kind == TK_IDENT && pa_peek(2)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(2), "@"))
            || TOK_EQ(pa_peek(1), "__typeof") || TOK_EQ(pa_peek(1), "__typeof__"))) {
        u32 ty = 0;
        u32 v = 0;

        pa_advance();
        SAW_TYPE_QUAL = 0;
        ty = parse_typename();
        CAST_QUAL = SAW_TYPE_QUAL;
        if (pa_is_ch(',')) {
            /* `(int, int){…}`：元组类型 */
            u32 tys[TUPLE_MAXN] = {0};
            u32 tn = 0;

            tys[tn++] = ty;
            while (tn < TUPLE_MAXN && pa_accept_ch(','))
                tys[tn++] = parse_typename();
            ty = ty_tuple_chk(tys, tn);
        }
        pa_expect_ch(')');
        {
            u32 ifx3 = 0;

            if (NIFACE > 0 && ty_is_iface(ty, &ifx3) && !pa_is_ch('{')) {
                u32 av3 = gen_unary();
                u32 aty3 = cur_op_ty();

                av3 = value_of(av3);       /* 聚合左值的"值"就是它的地址 */

                if (ty_is_agg(aty3) && !ty_is_iface(aty3, NULL)) {
                    u32 sty3 = ty_is_ptr(aty3) ? ty_target(aty3) : aty3;
                    u32 ts3 = frame_slots_for(16);
                    u32 ta3 = irfn_vreg(&FN);
                    u32 vv3 = irfn_vreg(&FN);
                    u32 sym3 = 0;

                    iface_check_impl(sty3, ifx3);
                    sym3 = iface_vtbl(ifx3, sty3);

                    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)ta3, 0, 0, 0, X64_SLOT(ts3));
                    store_conv(gen_addr_off(ta3, 0), ty_ptr(ty_void()), av3,
                               ty_ptr(ty_void()));
                    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)vv3, 0, 0, 0, sym3);
                    FN.ops[FN.n - 1].flags = 2;
                    store_conv(gen_addr_off(ta3, 8), ty_ptr(ty_void()), vv3,
                               ty_ptr(ty_void()));
                    GEN_TY = ty;
                    PEND_LVAL = 1;
                    PEND_ADDR = ta3;
                    PEND_TY = ty;
                    return gen_postfix_ops(ta3);
                }
                /* 接口 → 接口：普通拷贝（胖指针） */
                GEN_TY = ty;
                PEND_LVAL = 1;
                PEND_ADDR = av3;
                PEND_TY = ty;
                return gen_postfix_ops(av3);
            }
        }
        if (pa_is_ch('{')) {
            /* 复合字面量 (T){...}：在栈上开个临时对象，就地初始化，值是它的地址 */
            u32 slot = 0;
            u32 addr = irfn_vreg(&FN);

            if (ty_is_array(ty) && ty_size(ty) == 0) {
                /* (int[]){...}：元素个数由初始化器决定，先按 1 KB 开，
                 * 建完从 INIT_COUNT 得知真实长度（和局部 `int a[] = {...}` 同一招） */
                u32 et = ty_target(ty);
                u32 esz = ty_size(et) ? ty_size(et) : 1;
                u32 capn = (1024u / esz) ? (1024u / esz) : 1;

                slot = frame_slots_for(capn * esz);
                irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)addr, 0, 0, 0, X64_SLOT(slot));
                gen_init_obj(addr, ty_array(et, capn), 0);
                /* 复合字面量是左值（`&(int[]){…}` 要能取地址） */
                PEND_LVAL = 1;
                PEND_TY = ty_array(et, INIT_CNT_OK ? INIT_COUNT : 1);
                PEND_ADDR = addr;
                GEN_TY = ty_ptr(et);
                return addr;
            }
            slot = frame_slots_for(ty_size(ty));
            irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)addr, 0, 0, 0, X64_SLOT(slot));
            gen_init_obj(addr, ty, 0);
            PEND_LVAL = 1;
            PEND_TY = ty;
            PEND_ADDR = addr;
            GEN_TY = ty_is_array(ty) ? ty_ptr(ty_target(ty)) : ty;
            return addr;
        }
        v = gen_unary();
        {
            u32 src = cur_op_ty();

            v = value_of(v);
            /* 空指针常量再转一道指针：类型名里带限定符就不再是 NPC */
            if (E_NPC && (!ty_is_ptr(ty) || CAST_QUAL))
                E_NPC = 0;
            if (ty_is_ptr(ty) || ty_is_array(ty)) {
                GEN_TY = ty_is_array(ty) ? ty_ptr(ty_target(ty)) : ty;
                if (ty_is_float(src))
                    return gen_convert(v, src, ty_ulong());
                return v;
            }
            GEN_TY = ty;
            /* 显式 cast：只有这里的"切片转标量"要报（隐式转换那条路上
             * 还有 `.len` 这类历史遗留，见 todo）。 */
            PA_CAST_CONV = 1;
            {
                u32 rv9 = gen_convert(v, src, ty);

                PA_CAST_CONV = 0;
                return rv9;
            }
        }
    }
    return gen_postfix();
}

/* 整型提升：比 int 小的整型一律提升成 int。槽里的值本来就是按类型规范化过的
 * 8 字节值（char 已经符号/零扩展），所以这里只改"类型标签"——它决定除法、
 * 取模、移位、比较走有符号还是无符号那条路。`(short)1 << 4` 因此按 int 算。 */
static u32 ty_promote(u32 ty)
{
    if (ty_is_int(ty) && ty_size(ty) < 4)
        return ty_int();
    return ty;
}

/* C 的算术转换：把值 v（类型 from）转成类型 to。只处理标量。
 * 整数 → 整数 时按目标宽度回绕（和 gen_cast_to 一样），浮点走 SSE。 */
static u32 gen_convert(u32 v, u32 from, u32 to)
{
    int ff = ty_is_float(from);
    int ft = ty_is_float(to);
    u32 d = 0;

    /* 显式 cast 里切片转标量没有意义（`(int)s`）：切片是个 16 字节的对象，
     * 转成整数只会拿到它的地址（tests/errors/slice.c6 的 test_slice_to_int）。 */
    if (PA_CAST_CONV && ty_is_slice(from) && !ty_is_slice(to) && in_c6_tu())
        pa_error("cannot convert '%s' to '%s'", ty_disp(from), ty_disp(to));

    /* 闭包不是函数指针：它带着环境对象，转成裸指针之后调用会缺一个隐藏实参
     * （tests/errors/closure_convert.c6）。 */
    /* 变参函数指针包不成闭包：跳板没法转发一个长度未知的实参表。 */
    if (ty_is_closure(to, NULL)
        && ((ty_is_ptr(from) && ty_is_func(ty_target(from))) || ty_is_func(from))
        && ty_func_variadic(ty_is_ptr(from) ? ty_target(from) : from) && in_c6_tu())
        pa_error("a variadic function pointer cannot be wrapped into a closure: a "
                 "trampoline cannot forward an unknown argument list (make it a "
                 "capturing literal instead)");
    if (ty_is_closure(from, NULL) && in_c6_tu()) {
        if (ty_is_ptr(to) && ty_is_func(ty_target(to)))
            pa_error("a closure cannot become a plain function pointer: it carries "
                     "an environment (call it, or keep it as 'closure RET "
                     "(parameters)')");
        else if (ty_is_ptr(to) && ty_target(to) == ty_void())
            pa_error("a closure cannot be converted to 'void *': closures are opaque");
    }

    if (ff && ft) {
        if (ty_size(from) == ty_size(to))
            return v;
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_FCVT, ir_ty_of(to), (u16)d, (u16)v, 0, 0, 0);
        return d;
    }
    if (!ff && ft) {
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_I2F, ir_ty_of(to), (u16)d, (u16)v, 0, 0, 0);
        /* 64 位无符号源：cvtsi2sd 按有符号读会算出负数，后端要走移位套路 */
        if (ty_size(from) >= 8 && !ty_is_signed(from))
            FN.ops[FN.n - 1].flags |= 1;
        return d;
    }
    if (ff && !ft) {
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_F2I, ir_ty_of(from), (u16)d, (u16)v, 0, 0, 0);
        if (ty_is_int(to) && ty_size(to) >= 8 && !ty_is_signed(to))
            FN.ops[FN.n - 1].flags |= 1;
        if (ty_is_int(to) && ty_size(to) < 8) {
            u32 t2 = irfn_vreg(&FN);

            irfn_push(&FN, IR_TRUNC, ir_ty_of(to), (u16)t2, (u16)d, 0, 0, 0);
            d = t2;
        }
        return d;
    }
    if (ty_is_int(to) && ty_size(to) < 8) {
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_TRUNC, ir_ty_of(to), (u16)d, (u16)v, 0, 0, 0);
        return d;
    }
    return v;
}

/* 二元运算：a op b。先各做整型提升，再取宽者（同宽时无符号胜出） */
static u32 gen_bin2(u32 a, u32 aty, u8 op, u32 b, u32 bty)
{
    u32 d = irfn_vreg(&FN);
    u32 ty = 0;

    /* 二元运算的结果不是空指针常量（`i * 0` 也不是） */
    E_NPC = 0;

    if (ty_is_float(aty) || ty_is_float(bty)) {
        /* 浮点：任一操作数是 double 就按 double；两边先转成公共类型再算 */
        ty = (ty_size(aty) >= 8 || ty_size(bty) >= 8) ? ty_double() : ty_float();
        if (op == IR_ADD)
            op = IR_FADD;
        else if (op == IR_SUB)
            op = IR_FSUB;
        else if (op == IR_MUL)
            op = IR_FMUL;
        else if (op == IR_DIV)
            op = IR_FDIV;
        a = gen_convert(a, aty, ty);
        b = gen_convert(b, bty, ty);
        irfn_push(&FN, op, ir_ty_of(ty), (u16)d, (u16)a, (u16)b, 0, 0);
        GEN_TY = ty;
        return d;
    }
    aty = ty_promote(aty);
    bty = ty_promote(bty);
    ty = ty_size(aty) >= ty_size(bty) ? aty : bty;
    if (ty_size(aty) == ty_size(bty)) {
        /* 同宽时无符号吸收有符号（`0 - 0x80000002u` 是 unsigned，不是 int） */
        if (!ty_is_signed(aty))
            ty = aty;
        else if (!ty_is_signed(bty))
            ty = bty;
    }
    irfn_push(&FN, op, ir_ty_of(ty), (u16)d, (u16)a, (u16)b, 0, 0);
    /* 窄于 8 字节的整数运算要按类型宽度回绕（unsigned 取模 2^n 的语义）。
     * 少了它，`-(UINT_MAX/2+3)/2` 会拿 64 位中间值去除，结果高 32 位是垃圾。 */
    if (ty_is_int(ty) && ty_size(ty) < 8) {
        u32 t2 = irfn_vreg(&FN);

        irfn_push(&FN, IR_TRUNC, ir_ty_of(ty), (u16)t2, (u16)d, 0, 0, 0);
        d = t2;
    }
    GEN_TY = ty;
    return d;
}

/* 按运算类型归一化一个操作数：窄于 8 字节要重扩一次高低位。
 * 少了这一步，(int)-1 == 0xFFFFFFFFu 会变成 0xFFFFFFFFFFFFFFFF vs
 * 0x00000000FFFFFFFF —— 两个槽里的值不等，比较结果就错（踩过）。 */
static u32 gen_cast_to(u32 v, u32 ty)
{
    u32 d = 0;

    if (ty_size(ty) >= 8)
        return v;
    d = irfn_vreg(&FN);
    irfn_push(&FN, IR_TRUNC, ir_ty_of(ty), (u16)d, (u16)v, 0, 0, 0);
    return d;
}

/* 比较用"同级无符号吸收有符号"的规则挑公共类型 */
static u32 cmp_common_ty(u32 aty, u32 bty)
{
    if (ty_is_float(aty) || ty_is_float(bty))
        return (ty_size(aty) >= 8 || ty_size(bty) >= 8) ? ty_double() : ty_float();
    aty = ty_promote(aty);
    bty = ty_promote(bty);
    if (ty_size(aty) > ty_size(bty))
        return aty;
    if (ty_size(bty) > ty_size(aty))
        return bty;
    return ty_is_signed(aty) ? bty : aty;
}

static u32 gen_cmp3(u32 a, u32 aty, u32 b, u32 bty, u8 cc, u32 cty)
{
    u32 d = 0;

    if (ty_is_float(cty)) {
        /* 浮点比较：**浮点**操作数要先转成公共宽度，不能只截位。以前这里和
         * 整数一样走 gen_cast_to（只砍整数高位的），于是
         * `float f = 46.0f; f != 46.0` 拿 f32 的位模式（0x42380000）当 f64
         * 去和 46.0 比，恒为真——tests2/144_tls 的 `errors: 1` 就是它。
         * 整数那边**不动**：c6c 自己有个约定，通用 `task` 句柄的 `t->val`
         * 是按 long 读出来的裸位模式，和浮点字面量比时正好按位对上；改成
         * 整数转浮点会把它算成 4.6e18（tests/async.c6 会挂）。 */
        if (ty_is_float(aty))
            a = gen_convert(a, aty, cty);
        else
            a = gen_cast_to(a, cty);
        if (ty_is_float(bty))
            b = gen_convert(b, bty, cty);
        else
            b = gen_cast_to(b, cty);
    } else {
        a = gen_cast_to(a, cty);
        b = gen_cast_to(b, cty);
    }
    d = irfn_vreg(&FN);
    /* 浮点比较要知道宽度，才能选 ucomiss 还是 ucomisd */
    if (ty_is_float(cty))
        irfn_push(&FN, IR_CMP, ir_ty_of(cty), (u16)d, (u16)a, (u16)b, 0, cc);
    else
        irfn_push(&FN, IR_CMP, IRT_U64, (u16)d, (u16)a, (u16)b, 0, cc);
    irfn_setcc(&FN, cc);
    GEN_TY = ty_int();
    return d;
}

static u32 gen_cmp2(u32 a, u32 b, u8 cc)
{
    u32 d = irfn_vreg(&FN);

    irfn_push(&FN, IR_CMP, IRT_U64, (u16)d, (u16)a, (u16)b, 0, cc);
    irfn_setcc(&FN, cc);
    GEN_TY = ty_int();
    return d;
}

static u32 gen_mul(void)
{
    u32 a = gen_unary();
    u32 aty = cur_op_ty();

    for (;;) {
        if (pa_accept_ch('*')) {
            u32 av = value_of(a);
            u32 b = value_of(gen_unary());

            a = gen_bin2(av, aty, IR_MUL, b, GEN_TY);
            aty = GEN_TY;
        } else if (pa_accept_ch('/')) {
            u32 av = value_of(a);
            u32 aty2 = ty_promote(aty);
            u32 b = value_of(gen_unary());
            u32 bty2 = ty_promote(GEN_TY);
            /* 无符号操作数要走 div（idiv 会算成有符号） */
            u8 op = (!ty_is_signed(aty2) || !ty_is_signed(bty2)) ? IR_UDIV : IR_DIV;

            a = gen_bin2(av, aty2, op, b, bty2);
            aty = GEN_TY;
        } else if (pa_accept_ch('%')) {
            u32 av = value_of(a);
            u32 aty2 = ty_promote(aty);
            u32 b = value_of(gen_unary());
            u32 bty2 = ty_promote(GEN_TY);
            u8 op = (!ty_is_signed(aty2) || !ty_is_signed(bty2)) ? IR_UMOD : IR_MOD;

            a = gen_bin2(av, aty2, op, b, bty2);
            aty = GEN_TY;
        } else {
            return a;
        }
    }
}

static u32 gen_add(void)
{
    u32 a = gen_mul();
    u32 aty = cur_op_ty();

    for (;;) {
        int is_sub = 0;
        u32 av = 0;
        u32 b = 0;
        u32 bty = 0;

        if (pa_accept_ch('+')) {
            is_sub = 0;
        } else if (pa_accept_ch('-')) {
            is_sub = 1;
        } else {
            return a;
        }
        av = value_of(a);
        b = value_of(gen_mul());
        bty = GEN_TY;
        {
            u32 d = irfn_vreg(&FN);
            int aptr = ty_is_ptr(aty) || ty_is_array(aty);
            int bptr = ty_is_ptr(bty) || ty_is_array(bty);

            if (aptr && !bptr) {
                /* 指针 + 整数：按元素大小缩放 */
                u32 elem = ty_target(aty);
                u32 esz = ty_size(elem);
                u32 bv = b;

                if (esz > 1) {
                    u32 k = irfn_vreg(&FN);
                    u32 s = irfn_vreg(&FN);

                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)k, 0, 0, 0, esz);
                    irfn_push(&FN, IR_MUL, IRT_U64, (u16)s, (u16)b, (u16)k, 0, 0);
                    bv = s;
                }
                irfn_push(&FN, is_sub ? IR_SUB : IR_ADD, IRT_PTR, (u16)d, (u16)av, (u16)bv,
                          0, 0);
                aty = ty_ptr(elem);
                GEN_TY = aty;
                a = d;
            } else if (aptr && bptr && is_sub) {
                /* 指针差：字节差 / 元素大小 */
                u32 esz = ty_size(ty_target(aty));

                irfn_push(&FN, IR_SUB, IRT_U64, (u16)d, (u16)av, (u16)b, 0, 0);
                if (esz > 1) {
                    u32 k = irfn_vreg(&FN);

                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)k, 0, 0, 0, esz);
                    irfn_push(&FN, IR_DIV, IRT_I64, (u16)d, (u16)d, (u16)k, 0, 0);
                }
                aty = ty_long();
                GEN_TY = aty;
                a = d;
            } else {
                a = gen_bin2(av, aty, is_sub ? IR_SUB : IR_ADD, b, bty);
                aty = GEN_TY;
            }
        }
    }
}

/* 移位的特例：**结果类型只由左操作数的提升决定**，移位次数不参与"取宽"
 * （C99 6.5.7#3）。以前走 gen_bin2 的公共类型规则，`(short)1 << (unsigned)1`
 * 会被判成 unsigned，`(short)1 << (long)1` 会变成 long（踩过 55_lshift_type）。 */
static u32 gen_shift_one(u32 a, u32 aty, u8 op, u32 b)
{
    u32 d = irfn_vreg(&FN);

    irfn_push(&FN, op, ir_ty_of(aty), (u16)d, (u16)a, (u16)b, 0, 0);
    if (ty_is_int(aty) && ty_size(aty) < 8) {
        u32 t2 = irfn_vreg(&FN);

        irfn_push(&FN, IR_TRUNC, ir_ty_of(aty), (u16)t2, (u16)d, 0, 0, 0);
        d = t2;
    }
    GEN_TY = aty;
    return d;
}

static u32 gen_shift(void)
{
    u32 a = gen_add();
    u32 aty = cur_op_ty();

    for (;;) {
        if (pa_accept_punct("<<")) {
            u32 aty2 = ty_promote(aty);
            u32 av = value_of(a);
            u32 b = value_of(gen_add());

            a = gen_shift_one(av, aty2, IR_SHL, b);
            aty = GEN_TY;
        } else if (pa_accept_punct(">>")) {
            /* 无符号用逻辑右移，有符号用算术右移；左操作数先做整型提升 */
            u32 aty2 = ty_promote(aty);
            u8 op = ty_is_signed(aty2) ? IR_SAR : IR_SHR;
            u32 av = value_of(a);
            u32 b = value_of(gen_add());

            a = gen_shift_one(av, aty2, op, b);
            aty = GEN_TY;
        } else {
            return a;
        }
    }
}

static u32 gen_rel(void)
{
    u32 a = gen_shift();
    u32 aty = cur_op_ty();

    for (;;) {
        u8 cc = 0;
        u8 ucc = 0;

        if (pa_accept_punct("<=")) {
            cc = IRCC_LE;
            ucc = IRCC_ULE;
        } else if (pa_accept_punct(">=")) {
            cc = IRCC_GE;
            ucc = IRCC_UGE;
        } else if (pa_accept_ch('<')) {
            cc = IRCC_LT;
            ucc = IRCC_ULT;
        } else if (pa_accept_ch('>')) {
            cc = IRCC_GT;
            ucc = IRCC_UGT;
        } else {
            return a;
        }
        {
            u32 av = value_of(a);
            u32 b = value_of(gen_shift());
            u32 cty = cmp_common_ty(aty, GEN_TY);

            /* 无符号操作数必须用无符号条件码。用有符号的 jle/jl 会把
             * 0xcbf2... 当负数（u64 <= 0xFFFFFFFF 恒真，踩过这个坑）。 */
            if (!ty_is_float(cty) && !ty_is_signed(cty))
                cc = ucc;
            a = gen_cmp3(av, aty, b, GEN_TY, cc, cty);
            aty = GEN_TY;
        }
    }
}

static u32 gen_eq(void)
{
    u32 a = gen_rel();
    u32 aty = cur_op_ty();

    for (;;) {
        u8 cc = 0;

        if (pa_accept_punct("=="))
            cc = IRCC_EQ;
        else if (pa_accept_punct("!="))
            cc = IRCC_NE;
        else
            return a;
        {
            u32 aty2 = aty;
            u32 av = value_of(a);
            u32 b = value_of(gen_rel());
            u32 cty = cmp_common_ty(aty2, GEN_TY);

            a = gen_cmp3(av, aty2, b, GEN_TY, cc, cty);
            aty = GEN_TY;
        }
    }
}

static u32 gen_bitand(void)
{
    u32 a = gen_eq();
    u32 aty = cur_op_ty();

    while (pa_accept_ch('&')) {
        u32 av = value_of(a);
        u32 b = value_of(gen_eq());

        a = gen_bin2(av, aty, IR_AND, b, GEN_TY);
        aty = GEN_TY;
    }
    return a;
}

static u32 gen_bitxor(void)
{
    u32 a = gen_bitand();
    u32 aty = cur_op_ty();

    while (pa_accept_ch('^')) {
        u32 av = value_of(a);
        u32 b = value_of(gen_bitand());

        a = gen_bin2(av, aty, IR_XOR, b, GEN_TY);
        aty = GEN_TY;
    }
    return a;
}

static u32 gen_bitor(void)
{
    u32 a = gen_bitxor();
    u32 aty = cur_op_ty();

    while (pa_accept_ch('|')) {
        u32 av = value_of(a);
        u32 b = value_of(gen_bitxor());

        a = gen_bin2(av, aty, IR_OR, b, GEN_TY);
        aty = GEN_TY;
    }
    return a;
}

/* && / || 必须短路：用分支产生 0/1，不能改成位运算（右侧副作用会被多算一遍） */
static u32 gen_land(void)
{
    u32 a = gen_bitor();

    while (pa_accept_punct("&&")) {
        u32 ltest = irfn_label(&FN);
        u32 lfalse = irfn_label(&FN);
        u32 ltrue = irfn_label(&FN);
        u32 ldone = irfn_label(&FN);
        u32 d = irfn_vreg(&FN);
        u32 av = value_of(a);
        u32 b = 0;

        irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)av, (u16)ltest, (u16)lfalse, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ltest, 0, 0, 0);
        b = value_of(gen_bitor());
        irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)b, (u16)ltrue, (u16)lfalse, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ltrue, 0, 0, 0);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0, 1);
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)ldone, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lfalse, 0, 0, 0);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ldone, 0, 0, 0);
        a = d;
        GEN_TY = ty_int();
    }
    return a;
}

static u32 gen_lor(void)
{
    u32 a = gen_land();

    while (pa_accept_punct("||")) {
        u32 ltest = irfn_label(&FN);
        u32 lfalse = irfn_label(&FN);
        u32 ltrue = irfn_label(&FN);
        u32 ldone = irfn_label(&FN);
        u32 d = irfn_vreg(&FN);
        u32 av = value_of(a);
        u32 b = 0;

        irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)av, (u16)ltrue, (u16)ltest, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ltest, 0, 0, 0);
        b = value_of(gen_land());
        irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)b, (u16)ltrue, (u16)lfalse, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ltrue, 0, 0, 0);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0, 1);
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)ldone, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lfalse, 0, 0, 0);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)d, 0, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ldone, 0, 0, 0);
        a = d;
        GEN_TY = ty_int();
    }
    return a;
}

/* 三元表达式的**结果类型**（C11 6.5.15 的简化版）：两支同类型、指针/指针、
 * 指针/空指针常量、浮点、整数提升各来一条。c6c 以前直接用"then 支"的类型，
 * 于是 `fp ? 0L : (void)0` 的类型被算成 long，`_Generic(…, void*: …)` 匹配不上
 * （tcc tests2 的 33_ternary_op / 94_generic）。 */
static u32 ty_ternary(u32 a, u32 b, int anpc, int bnpc)
{
    if (a == b)
        return a;
    if (ty_is_ptr(a) && ty_is_ptr(b)) {
        u32 ta = ty_target(a);
        u32 tb = ty_target(b);
        int va = (ta == ty_void());
        int vb = (tb == ty_void());
        u8 q = (u8)(TY_AT(ta)->qual | TY_AT(tb)->qual);

        /* 一边是 `void*`：那半是**空指针常量**时结果取另一边，否则按 C11
         * 6.5.15p6 取 `void*`——限定符要**并起来**（`(int volatile*)0` 和
         * `(void const*)1` 合出来是 `void const volatile*`）。 */
        if (va != vb) {
            if (va && anpc)
                return b;
            if (vb && bnpc)
                return a;
            return ty_ptr(ty_qual(ty_void(), q));
        }
        /* 指向**数组**的指针：一边不完整（`int (*)[]`）另一边完整时，结果取
         * 补全的那一边（C11 6.2.7 的组合类型规则，tcc tests2 的 94_generic
         * 有两条专门查这个）。 */
        if (ty_is_array(ta) && ty_is_array(tb) && ty_target(ta) == ty_target(tb)) {
            u32 na = ty_array_n(ta);
            u32 nb = ty_array_n(tb);

            if (na == 0 && nb != 0)
                return b;
            if (nb == 0 && na != 0)
                return a;
        }
        /* 两边都指向同一族对象类型：限定符取并集 */
        if (q) {
            u32 base = (va && vb) ? ty_void()
                                  : (ty_size(ta) >= ty_size(tb) ? ta : tb);
            u32 u = ty_unqual(base);

            return ty_ptr(ty_qual(u, (u8)(q | TY_AT(u)->qual)));
        }
        return a;
    }
    if (ty_is_ptr(a))
        return a;
    if (ty_is_ptr(b))
        return b;
    /* 一支是 void 表达式（`(void)0`）时结果就是 void（C11 6.5.15 最后一条） */
    if (a == ty_void() || b == ty_void())
        return ty_void();
    if (ty_is_float(a) || ty_is_float(b)) {
        if (ty_is_float(a) && ty_is_float(b))
            return ty_size(a) >= ty_size(b) ? a : b;
        return ty_is_float(a) ? a : b;
    }
    if (ty_size(a) != ty_size(b))
        return ty_size(a) > ty_size(b) ? a : b;
    if (!ty_is_signed(a))
        return a;
    return b;
}

/* 切片的 len 在切片对象 +8 处（`IR_LOAD` 的发射器不看 imm，所以先 LEA 再 LOAD）。 */
static u32 slice_len_load(u32 sadd)
{
    u32 la = irfn_vreg(&FN);
    u32 lv = irfn_vreg(&FN);

    irfn_push(&FN, IR_LEA, IRT_PTR, (u16)la, (u16)sadd, 0, 0, 8);
    irfn_push(&FN, IR_LOAD, IRT_U64, (u16)lv, (u16)la, 0, 0, 0);
    return lv;
}

static u32 gen_cond(void)
{
    u32 c = 0;

    E_CALL_FALLIBLE = 0;
    c = gen_lor();

    /* c6 的错误处理后缀：`expr catch [e] { … }`。expr 给的是错误 id（0 = 成功）；
     * 非 0 时把 id 绑到 `e.id` 再跑块。块的语义是"就地处理"，整体值仍是 id。 */
    if (PA_IN_DROP && PA_IS_IDENT("catch") && pa_peek(1))
        pa_error("'drop' 不能失败：它在对象释放时跑，错误没处去");
    if (PA_IN_DEFER && PA_IS_IDENT("catch") && pa_peek(1))
        pa_error("'catch' 不能出现在 defer 体里");
    if (PA_IS_IDENT("catch") && c6_kw() && pa_peek(1) && E_CALL_FALLIBLE == 2)
        pa_error("'catch' requires a call to a function returning 'T!error'");
    while (PA_IS_IDENT("catch") && c6_kw() && pa_peek(1)
           && (pa_peek(1)->kind == TK_IDENT || TOK_EQ(pa_peek(1), "{")
               || tok_eq(pa_peek(1), "("))
           && (pa_peek(1)->kind != TK_IDENT || pa_peek(2))
           && (pa_peek(1)->kind != TK_IDENT || TOK_EQ(pa_peek(2), "{"))) {
        u32 v0 = value_of(c);
        u32 vty = GEN_TY;              /* catch 不影响表达式的类型（可能是 double） */
        u32 lbody = irfn_label(&FN);
        u32 lend = irfn_label(&FN);

        pa_advance();                          /* catch */
        /* 判据是运行时的**错误标志**，不是表达式的值：`half(8)` 这种正常返回
         * 一个非 0 值的调用以前会被当成"出错"，catch 体就跑起来了。 */
        {
            u32 fl = irfn_vreg(&FN);

            irfn_push(&FN, IR_CALL, IRT_I32, (u16)fl, 0, 0, 0,
                      x64_sym(&X64, "__tcc_err_flag_get"));
            FN.ops[FN.n - 1].narg = 0;
            irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)fl, (u16)lbody, (u16)lend, 0);
        }
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lbody, 0, 0, 0);
        scope_enter();
        if (pa_is_ch('(')) {
            /* `catch (e) { … }`：括号包着的绑定 */
            pa_advance();
            if (pa_cur()->kind == TK_IDENT) {
                Sym *e = sym_add(tok_data(pa_cur()), pa_cur()->len, ty_errpay(), SC_LOCAL);
                u32 slot = frame_slots_for(16);
                u32 addr = irfn_vreg(&FN);
                Sym *gm = sym_find("c6c_err_msg", 11);

                u32 idv = irfn_vreg(&FN);

                pa_advance();
                e->slot = slot;
                irfn_push(&FN, IR_CALL, IRT_I32, (u16)idv, 0, 0, 0,
                          x64_sym(&X64, "__tcc_err_id_get"));
                FN.ops[FN.n - 1].narg = 0;
                irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)addr, 0, 0, 0, X64_SLOT(slot));
                irfn_push(&FN, IR_STORE, IRT_I32, (u16)addr, (u16)idv, 0, 0, 0);
                if (gm) {
                    u32 mv = irfn_vreg(&FN);
                    u32 a8 = gen_addr_off(addr, 8);

                    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)mv, (u16)ident_addr(gm), 0, 0, 0);
                    store_conv(a8, ty_ptr(ty_char()), mv, ty_ptr(ty_char()));
                }
            }
            pa_expect_ch(')');
        }
        if (pa_cur()->kind == TK_IDENT) {
            Sym *e = sym_add(tok_data(pa_cur()), pa_cur()->len, ty_errpay(), SC_LOCAL);
            u32 slot = frame_slots_for(16);
            u32 addr = irfn_vreg(&FN);
            u32 idv = irfn_vreg(&FN);

            pa_advance();
            e->slot = slot;
            irfn_push(&FN, IR_CALL, IRT_I32, (u16)idv, 0, 0, 0,
                      x64_sym(&X64, "__tcc_err_id_get"));
            FN.ops[FN.n - 1].narg = 0;
            irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)addr, 0, 0, 0, X64_SLOT(slot));
            irfn_push(&FN, IR_STORE, IRT_I32, (u16)addr, (u16)idv, 0, 0, 0);
            {
                /* 消息从运行时的错误槽取（`c6c_err_msg` 是运行时 TU 里的
                 * static，主 TU 的符号表里根本没有，以前这里永远取不到）。 */
                u32 mv = irfn_vreg(&FN);
                u32 a8 = gen_addr_off(addr, 8);

                irfn_push(&FN, IR_CALL, IRT_PTR, (u16)mv, 0, 0, 0,
                          x64_sym(&X64, "__tcc_err_msg_get"));
                FN.ops[FN.n - 1].narg = 0;
                store_conv(a8, ty_ptr(ty_char()), mv, ty_ptr(ty_char()));
            }
        }
        {
            /* 错误值已经抄进 e.id / e.msg 了，标志要**在跑块之前**清掉：
             * 块里可能 `return`，那之后就不会再回来清了（tests/err.c6 的
             * "调用方处理错误后可以继续"就是被这个挂住的）。 */
            u32 cl = irfn_vreg(&FN);

            irfn_push(&FN, IR_CALL, IRT_VOID, (u16)cl, 0, 0, 0,
                      x64_sym(&X64, "__tcc_err_clear"));
            FN.ops[FN.n - 1].narg = 0;
        }
        if (pa_is_ch('{'))
            gen_block();
        else
            pa_error("catch 后面要一个 { … } 块");
        /* catch 体的语义是"就地处理掉错误"：必须以 return / err() / goto
         * 收尾，否则错误被吞掉接着往下跑（tests/errors/try.c6）。 */
        if (!PA_LAST_TERM)
            pa_error("'catch' body must end with 'return', 'err()' or 'goto'");
        scope_leave();
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
        GEN_TY = vty;
        c = v0;
        E_CALL_FALLIBLE = 4;    /* 这一次已经被处理掉了 */
    }

    if (pa_accept_ch('?')) {
        u32 lelse = irfn_label(&FN);
        u32 lthen = irfn_label(&FN);
        u32 lend = irfn_label(&FN);
        u32 d = irfn_vreg(&FN);
        u32 cty = cur_op_ty();
        u32 cv = value_of(c);
        u32 t = 0;
        u32 e = 0;
        u32 ty = 0;
        int tnpc = 0;      /* 两支各自是不是空指针常量（决定 void* 那半让不让位） */
        int enpc = 0;

        irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)cv, (u16)lthen, (u16)lelse, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lthen, 0, 0, 0);
        if (pa_is_ch(':')) {
            /* GNU `a ?: b`：中间项省略，值就是条件表达式的值（只求值一次） */
            t = cv;
            ty = cty;
            pa_advance();
        } else {
            t = value_of(gen_expr());
            ty = GEN_TY;
            tnpc = E_NPC;
            pa_expect_ch(':');
        }
        irfn_push(&FN, IR_MOV, ir_ty_of(ty), (u16)d, (u16)t, 0, 0, 0);
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)lend, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lelse, 0, 0, 0);
        e = value_of(gen_cond());
        enpc = E_NPC;
        irfn_push(&FN, IR_MOV, ir_ty_of(ty), (u16)d, (u16)e, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
        /* 结果类型按两支合并（IR 里 d 是 8 字节槽，写进去的位不变） */
        ty = ty_ternary(ty, GEN_TY, tnpc, enpc);
        GEN_TY = ty;
        return d;
    }
    return c;
}
static u32 gen_assign(void)
{
    u32 v = 0;

    E_WAS_CALL = 0;
    E_WAS_ADDR = 0;
    E_WEAK = 0;
    v = gen_cond();

    if (PEND_LVAL && pa_cur()->kind == TK_PUNCT) {
        Tok *t = pa_cur();
        int op = -1;
        u32 addr = PEND_ADDR;
        u32 ty = PEND_TY;
        u32 lv_bits = PEND_BITS;
        u32 lv_bo = PEND_BITOFF;

        if (TOK_EQ(t, "="))
            op = 0;
        else if (TOK_EQ(t, "+="))
            op = IR_ADD;
        else if (TOK_EQ(t, "-="))
            op = IR_SUB;
        else if (TOK_EQ(t, "*="))
            op = IR_MUL;
        else if (TOK_EQ(t, "/="))
            op = IR_DIV;
        else if (TOK_EQ(t, "%="))
            op = IR_MOD;
        else if (TOK_EQ(t, "&="))
            op = IR_AND;
        else if (TOK_EQ(t, "|="))
            op = IR_OR;
        else if (TOK_EQ(t, "^="))
            op = IR_XOR;
        else if (TOK_EQ(t, "<<="))
            op = IR_SHL;
        else if (TOK_EQ(t, ">>="))
            op = IR_SAR;
        if (op >= 0) {
            u32 r = 0;
            int lmgd = PEND_MGD;
            int rmgd = 0;
            Sym *lsym = PEND_MGD_SYM;   /* 左值那个槽（清"已移走"标记要用） */
            char opbuf[8] = {0};

            /* 给只读对象赋值（`int *const p; p = 0;`）：tcc 给一条 warning 后
             * 照常编下去，tests2/149_parameter_qualifier_errors.c 的 .expect
             * 就是那一行。C 里这是约束违背，但上游要的是"警告 + 继续"。 */
            if (PEND_SYM && PEND_SYM->is_const)
                pa_warn_tcc("assignment of read-only location");

            if (t->len < sizeof(opbuf)) {
                memcpy(opbuf, tok_data(t), t->len);
                opbuf[t->len] = 0;
            }
            if (op != 0 && lmgd)
                pa_error("'%s' is not supported for a managed reference", opbuf);
            pa_advance();
            PEND_LVAL = 0;
            PEND_MGD = 0;
            r = gen_assign();
            rmgd = (PEND_LVAL && PEND_MGD);
            /* 按值赋值：两边是同一个"带托管字段的结构体"就是整块拷贝，
             * 拷贝出来的引用不加计数——禁止。（`root->left = move(l)` 这种
             * 左值是托管字段、右值是 `@T` 的，类型不同，不算。） */
            /* 两个不同的聚合体类型之间不能赋值（`Vect@int a = b;` 里 b 是
             * `Vect@char`）——尺寸/布局都不一样
             * （tests/errors/generic.c6 的 test_two_instances）。 */
            if (op == 0 && !lmgd && ty_is_agg(ty) && ty_is_agg(GEN_TY) && ty != GEN_TY
                && !ty_is_iface(ty, NULL) && !ty_is_iface(GEN_TY, NULL)
                && in_c6_tu())
                pa_error("cannot convert '%s' to '%s'", ty_disp(GEN_TY), ty_disp(ty));
            if (op == 0 && !lmgd && GEN_TY == ty && ty_has_mgd(ty)) {
                char dnm[160] = {0};

                agg_disp_name(ty, dnm, sizeof(dnm));
                pa_error("'%s' holds managed references: an assignment is not possible. "
                         "Allocate it with 'new' and hold it in '@%s'", dnm, dnm);
            }
            r = value_of(r);
            if (op == 0) {
                /* 托管引用赋值：先给新值加计数，再存，最后放掉旧值。
                 * 这个顺序让 `p = p` 净变化为 0（先 +1 后 -1）。 */
                if (lmgd == 3) {
                    /* 弱槽赋值：只登记，不加计数也不释放旧值 */
                    store_conv(addr, ty, r, GEN_TY);
                    mgd_weak(addr, r);
                } else if (lmgd) {
                    u32 old = load_lval(addr, ty);

                    /* 重新赋值 = 槽里又有了新引用。分支体里的赋值不能保证
                     * 执行到，所以只有直落语句才清标记（tests/errors/gc_move.c6
                     * 的 branch/loop/switch_case 三条）。 */
                    if (lmgd == 1 && lsym && lsym->kind == SC_LOCAL)
                        mv_clear(lsym->slot);
                    /* 托管形参是**借**来的：它不拥有对象，改写它等于让调用方
                     * 的那份引用无处安放（tests/errors/gc_borrow.c6）。 */
                    if (lmgd == 1 && lsym && lsym->kind == SC_PARAM && in_c6_tu())
                        pa_error("'%s@%s' is a borrow: it owns nothing, so it cannot "
                                 "be reassigned", lsym->is_shared ? "shared " : "",
                                 ty_disp(lsym->type));

                    if (rmgd) {
                        if (!mgd_tmp_take(r))
                            mgd_retain(r);
                    } else {
                        (void)mgd_tmp_take(r);
                    }
                    store_conv(addr, ty, r, GEN_TY);
                    mgd_release(old);
                } else if (lv_bits)
                    store_lval_bits(addr, ty, lv_bits, lv_bo, r);
                else
                    store_conv(addr, ty, r, GEN_TY);
            } else {
                u32 old_v = lv_bits ? load_bf(addr, ty, lv_bits, lv_bo,
                                              ty_is_signed(ty), 0)
                                    : load_lval(addr, ty);
                u32 d = 0;

                /* 指针的 `p += n` / `p -= n`：n 要按元素大小缩放（和 p++ 一样） */
                if (ty_is_ptr(ty) && (op == IR_ADD || op == IR_SUB)) {
                    u32 esz = ty_size(ty_target(ty));
                    u32 k = 0;
                    u32 m = 0;

                    if (esz > 1) {
                        k = irfn_vreg(&FN);
                        irfn_push(&FN, IR_CONST, IRT_U64, (u16)k, 0, 0, 0, esz);
                        m = irfn_vreg(&FN);
                        irfn_push(&FN, IR_MUL, IRT_U64, (u16)m, (u16)r, (u16)k, 0, 0);
                        r = m;
                    }
                }
                d = gen_bin2(old_v, ty, (u8)op, r, GEN_TY);

                if (lv_bits)
                    store_lval_bits(addr, ty, lv_bits, lv_bo, d);
                else
                    store_conv(addr, ty, d, GEN_TY);
                r = d;
            }
            GEN_TY = ty;
            return r;
        }
    }
    /* 左值性要**留给上层**：`(*p)++`、`*p = x`、`&*p` 都靠它。
     * 以前在这里无条件 value_of()，把括号里的左值性吃掉了（踩过一次）。 */
    if (PEND_LVAL)
        return v;
    return value_of(v);
}

static u32 gen_expr(void)
{
    u32 v = gen_assign();

    /* 逗号运算符：值取最右操作数（左边只求值） */
    while (pa_accept_ch(',')) {
        v = value_of(gen_assign());
        if (PEND_LVAL) {
            /* 保留左值性：最右操作数是左值时整体也是左值 */
            mark_lval(PEND_ADDR, PEND_TY);
        }
    }
    return v;
}

/* --- 语句 --- */

/* switch：case 值在语体里才出现，分发链却必须放在语体**之前**。
 * 做法是先把语体照常发出去，解析完再往 IR 里"插入"一段比较链。 */
#define SW_MAX 8
#define SW_MAXCASE 160
typedef struct SwCase {
    i64 lo;
    i64 hi;
    u32 lbl;
    u8 is_range;
    u8 is_default;
} SwCase;

typedef struct SwState {
    u32 cv;
    u32 ins_at;
    u32 ncase;
    u32 def_lbl;
    u32 end_lbl;
    u8 has_def;
    SwCase cs[SW_MAXCASE];
} SwState;

static SwState SW[SW_MAX];
static int NSW;
#define PA_MAXLOOP 32
static u32 LOOP_BRK[PA_MAXLOOP];
/* 进每个循环时"最近的 VLA 保存点"：break/continue 要回到这里，
 * 不是回到最内层 if 块——循环体里的 b[f()] 才会每轮复用同一块栈。 */
static u32 LOOP_VLA[PA_MAXLOOP];
static struct Scope *LOOP_BODY[PA_MAXLOOP];   /* 循环体那个块（下一个进来的块） */
static u32 LOOP_CNT[PA_MAXLOOP];
/* 1：这个循环（`for`）自己带一层 init 作用域（深度 LOOP_DFB + 1），break 要
 * 连它一起清理；continue 只清理循环体。其它循环/switch 都是 0。 */
static int LOOP_OWN[PA_MAXLOOP];
/* 1：这一层是 switch（不是循环）。`continue` 在 switch 里要落到**外层循环**
 * 的头上，清理边界也得用外层循环的，不能拿 switch 自己的深度算。 */
static int LOOP_SW[PA_MAXLOOP];
static int NLOOP;

static void gen_stmt(void);
static void gen_block(void);

/* 聚合（数组/结构体）局部对象占多槽：分配 ceil(size/16) 个连续槽，
 * 对象基址取**最后一个**槽（X64_SLOT 是负偏移，最后一个槽地址最低，
 * size ≤ 16k 保证对象整个落在这一段里）。 */
static u32 frame_slots_for(u32 size)
{
    u32 k = (size + 15) / 16;
    u32 first = 0;
    u32 i = 0;

    if (k == 0)
        k = 1;
    first = irfn_vreg(&FN);
    for (i = 1; i < k; i++)
        (void)irfn_vreg(&FN);
    return first + k - 1;
}

/* 跳过聚合初始化器：`{ [designator] expr, ... }`，嵌套按括号配平 */

/* ---------- 聚合初始化器（P3-3b）----------
 * 局部：先把整个对象清零，再按 {…} 里的元素逐个写；
 * 全局：同样的遍历，但值必须是编译期常量，直接写数据段字节。
 * 字符串特例：char a[N] = "abc" 直接搬字面量。 */

static u32 gen_addr_off(u32 addr, u32 off)
{
    u32 c = 0;
    u32 d = 0;

    if (off == 0)
        return addr;
    c = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_U64, (u16)c, 0, 0, 0, off);
    d = irfn_vreg(&FN);
    irfn_push(&FN, IR_ADD, IRT_U64, (u16)d, (u16)addr, (u16)c, 0, 0);
    return d;
}

static void gen_zero_obj(u32 addr, u32 sz)
{
    u32 z = 0;

    if (sz == 0)
        return;
    /* IR_MEMSET：dst = 目标地址，a = 填充字节，imm = 字节数 */
    z = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_U64, (u16)z, 0, 0, 0, 0);
    irfn_push(&FN, IR_MEMSET, IRT_U8, (u16)addr, (u16)z, 0, 0, sz);
}


/* ---------- 全局聚合初始化器：纯编译期填字节 ---------- */
/* 全局初始化器里的位域：0 = 不是位域。全局初始化是编译期写数据段，
 * 和运行期的左值状态（PEND_*）无关，所以另开一组全局量。 */
static u32 GLOB_BF_BITS;
static u32 GLOB_BF_BITOFF;

static void data_fixup_drop_range(u32 lo, u32 hi);

static void glob_store(u32 goff, u32 off, u32 ty, u64 v)
{
    u32 sz = ty_size(ty);
    u32 i = 0;

    if (sz > 8)
        sz = 8;
    /* 这个位置后面被直接写了值，前面排队的重定位就作废了。重定位是最后统一
     * 打的补丁，不取消的话会反过来盖掉这里写的值：
     * `{[0 ... 3] = &f, [1] = 0}` 里那个 0 就白写了。 */
    data_fixup_drop_range(goff + off, goff + off + (sz ? sz : 1));
    for (i = 0; i < sz; i++)
        DATA_IMG.p[goff + off + i] = (u8)(v >> (8 * i));
    /* 指向数据段内部的绝对地址：C99 后端要按自己的基址重打一遍 */
    if (sz == 8 && v >= (u64)DATA_VA(0) && v < (u64)DATA_VA(DATA_IMG.n))
        c99_reloc_add(goff + off, (u32)(v - (u64)DATA_VA(0)));
}

/* 全局初始化器里的标量常量：走完整的常量表达式链（`A | B`、`sizeof(T)`、
 * 三目都算），而不是只认单个字面量——tcc 的 DWARF 表就是 `VT_LONG | VT_INT`。 */
static int parse_const_u64(u64 *out)
{
    u32 save = PA_ERRS;
    i64 v = const_expr();

    if (PA_ERRS != save)
        return 0;
    *out = (u64)v;
    return 1;
}

static void gen_glob_obj(u32 goff, u32 ty, u32 off);
static void gen_init_obj(u32 addr, u32 ty, u32 off);
static void init_skip_value(void);
static void gen_glob_braced_new(u32 goff, u32 ty, u32 off);
static void gen_local_braced_new(u32 addr, u32 ty, u32 off);
static int pa_is_compound_lit(void);
static u32 gen_addr_off(u32 addr, u32 off);
static void mark_lval(u32 addr, u32 ty);
static int pa_at_typename(void);
static u32 pa_take_paren_type(void);
static int pa_skip_empty_compound(void);
static void data_fixup_add(u32 data_off, u32 sym);
static void code_lbl_fixup_add(u32 data_off, u32 fnseq, u32 lbl);
static void data_fixup_drop_range(u32 lo, u32 hi);


static void gen_glob_desig_fill(u32 goff, u32 ty, u32 off)
{
    for (;;) {
        if (pa_accept_ch('[')) {
            u32 i = (u32)const_expr();
            u32 et = 0;

            pa_expect_ch(']');
            if (!ty_is_array(ty))
                return;
            et = ty_target(ty);
            if (i >= ty_array_n(ty))
                return;
            ty = et;
            off += i * ty_size(et);
            continue;
        }
        if (pa_accept_ch('.')) {
            const char *nm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
            u32 nl = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
            int idx = 0;

            if (!nm)
                return;
            pa_advance();
            if (!ty_is_agg(ty))
                return;
            {
                u32 mo = 0;

                if (!agg_find_promoted(ty, nm, nl, &ty, &mo)) {
                    pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                    return;
                }
                off += mo;
            }
            continue;
        }
        break;
    }
    pa_expect_ch('=');
    gen_glob_obj(goff, ty, off);
}

static void gen_glob_braced(u32 goff, u32 ty, u32 off)
{
    u32 cur = 0;
    int first = 1;

    if (ty_is_array(ty)) {
        u32 et = ty_target(ty);
        u32 esz = ty_size(et);
        u32 n = ty_array_n(ty);

        for (;;) {
            if (pa_is_ch('}') || pa_cur()->kind == TK_EOF)
                break;
            if (!first && !pa_accept_ch(','))
                break;
            first = 0;
            if (pa_is_ch('}'))
                break;
            if (pa_accept_ch('[')) {
                u32 lo = (u32)const_expr();
                u32 hi = lo;
                u32 k = 0;

                if (pa_accept_punct("..."))
                    hi = (u32)const_expr();
                pa_expect_ch(']');
                if (pa_is_ch('.') || pa_is_ch('[')) {
                    gen_glob_desig_fill(goff, et, off + lo * esz);
                } else {
                    pa_expect_ch('=');
                    for (k = lo; k <= hi && k < n; k++)
                        gen_glob_obj(goff, et, off + k * esz);
                }
                cur = hi + 1;
                continue;
            }
            if (pa_is_ch('.') && ty_is_agg(ty))
                break;
            if (cur >= n) {
                skip_init_list();
                break;
            }
            gen_glob_obj(goff, et, off + cur * esz);
            cur++;
        }
        if (off == 0)
            INIT_COUNT = cur;
        return;
    }
    {
        u32 n = ty_member_n(ty);

        if (n == 0) {
            if (!pa_is_ch('}'))
                gen_glob_obj(goff, ty, off);
            return;
        }
        for (;;) {
            if (pa_is_ch('}') || pa_cur()->kind == TK_EOF)
                break;
            if (!first && !pa_accept_ch(','))
                break;
            first = 0;
            if (pa_is_ch('}'))
                break;
            if (pa_accept_ch('.')) {
                const char *nm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
                u32 nl = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
                int idx = 0;
                u32 mty = 0;
                u32 moff = 0;

                if (!nm) {
                    pa_error("'.' 后面要成员名");
                    break;
                }
                pa_advance();
                if (!agg_find_promoted(ty, nm, nl, &mty, &moff)) {
                    pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                    break;
                }
                idx = agg_find_member(ty, nm, nl);
                if (pa_is_ch('.') || pa_is_ch('[')) {
                    gen_glob_desig_fill(goff, mty, off + moff);
                } else {
                    pa_expect_ch('=');
                    GLOB_BF_BITS = idx >= 0 ? ty_member_bits(ty, (u32)idx) : 0;
                    GLOB_BF_BITOFF = idx >= 0 ? ty_member_bitoff(ty, (u32)idx) : 0;
                    gen_glob_obj(goff, mty, off + moff);
                    GLOB_BF_BITS = 0;
                    GLOB_BF_BITOFF = 0;
                }
                cur = idx >= 0 ? (u32)idx + 1 : 0;
                continue;
            }
            if (cur >= n) {
                skip_init_list();
                break;
            }
            GLOB_BF_BITS = ty_member_bits(ty, cur);
            GLOB_BF_BITOFF = ty_member_bitoff(ty, cur);
            gen_glob_obj(goff, ty_member(ty, cur), off + ty_member_off(ty, cur));
            GLOB_BF_BITS = 0;
            GLOB_BF_BITOFF = 0;
            cur++;
        }
    }
}

/* 初始化器位置上的复合字面量 `(T){ … }` / `((T){ … })`。
 *
 * 前瞻窗口里有 8 个 token，够把「任意层括号 + 限定符 + 类型名 + * 序列 + )」
 * 扫完再看后面是不是 `{`——所以 `(u8)45`（cast）、`((const struct W *)w)->t.t`
 * 都不会被误判成复合字面量。 */
static int tykw_is_qual(Tok *t)
{
    return t->kind == TK_IDENT
        && (TOK_EQ(t, "const") || TOK_EQ(t, "volatile") || TOK_EQ(t, "restrict")
            || TOK_EQ(t, "__const") || TOK_EQ(t, "__volatile__") || TOK_EQ(t, "__restrict"));
}

/* 当前位置是不是一个类型名（关键字 / typedef / **模板实例** `Vect@int`） */
static int pa_at_typename(void)
{
    if (is_typename_tok(pa_cur()))
        return 1;
    if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
        && TOK_EQ(pa_peek(1), "@")) {
        /* `Vect@int v;` 是声明，但**函数模板**的 `vget@int(v, i)` 是调用——
         * 中间那个 `@` 只是显式实参。 */
        Tmpl *tq = tmpl_find(tok_data(pa_cur()), pa_cur()->len);

        return !(tq && tq->is_func);
    }
    /* `async (int, int) f()` / `async T f()`：async 是说明符，后面跟类型 */
    if (pa_cur()->kind == TK_IDENT && TOK_EQ(pa_cur(), "async") && pa_peek(1)
        && (pa_peek(1)->kind == TK_IDENT
            || (pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "("))))
        return 1;
    /* 模块限定的类型名 `tu.module.Point p;`：单 TU 文本导入下前缀只是命名空间
     * 装饰，看最后一段是不是类型即可。 */
    if (pa_cur()->kind == TK_IDENT && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
        && TOK_EQ(pa_peek(1), ".")) {
        u32 kq = 1;

        while (pa_peek(kq) && pa_peek(kq)->kind == TK_PUNCT && TOK_EQ(pa_peek(kq), ".")
               && pa_peek(kq + 1) && pa_peek(kq + 1)->kind == TK_IDENT)
            kq += 2;
        if (kq > 1) {
            Tok *lt = pa_peek(kq - 1);
            Sym *ls = sym_find(tok_data(lt), lt->len);

            if ((ls && ls->kind == SC_TYPEDEF)
                || sym_find_tag(tok_data(lt), lt->len))
                return 1;
        }
    }
    /* 托管类型开头的类型位置：`@int` / `weak @Node` / `shared @T` / `own @T`。
     * 函数字面量的返回类型就可能是 `@int`（`tests/fn_lit.c6`）。 */
    if (pa_is_ch('@'))
        return 1;
    if (c6_kw() && pa_cur()->kind == TK_IDENT
        && (PA_IS_IDENT("weak") || PA_IS_IDENT("shared") || PA_IS_IDENT("own"))
        && (pa_peek(1)->kind == TK_IDENT || pa_peek(1)->kind == TK_PUNCT))
        return 1;
    return 0;
}

/* `sizeof(` 的后面是不是"括号里的类型"：从 peek(1) 的 `(` 扫到配对的 `)`，
 * 要求它的下一个 token 正好是 sizeof 自己的 `)`。 */
static int sizeof_inner_type_end(void)
{
    int depth = 0;
    int q = 0;

    for (q = 1; q < PA_LOOK; q++) {
        Tok *t = pa_peek(q);

        if (t->kind != TK_PUNCT)
            continue;
        if (tok_eq(t, "(")) {
            depth++;
        } else if (tok_eq(t, ")")) {
            depth--;
            if (depth == 0) {
                Tok *nx = pa_peek(q + 1);

                return nx->kind == TK_PUNCT && tok_eq(nx, ")");
            }
        }
    }
    return 0;
}

static int pa_is_compound_lit(void)
{
    int i = 0;

    if (!pa_is_ch('('))
        return 0;
    /* 元组/单类型都能这么认：`(int, int){…}`、`(struct S){…}`、`(int){…}`
     * ——括号里是类型、闭括号后面紧跟 `{`。 */
    if (is_typename_tok(pa_peek(1))) {
        int depth = 0;
        int q = 0;

        for (q = 1; q < PA_LOOK; q++) {
            Tok *t = pa_peek(q);

            if (t->kind != TK_PUNCT)
                continue;
            if (tok_eq(t, "(")) {
                depth++;
            } else if (tok_eq(t, ")")) {
                depth--;
                if (depth == 0) {
                    Tok *nx = pa_peek(q + 1);

                    return nx->kind == TK_PUNCT && TOK_EQ(nx, "{");
                }
            }
        }
    }
    while (i < 3 && pa_peek(i)->kind == TK_PUNCT && tok_eq(pa_peek(i), "("))
        i++;
    while (i < 5 && tykw_is_qual(pa_peek(i)))
        i++;
    /* `(__typeof(expr)*){0}`：typeof 自己带一层括号，先把它整段跳过去 */
    if (TOK_EQ(pa_peek(i), "typeof") || TOK_EQ(pa_peek(i), "__typeof")
        || TOK_EQ(pa_peek(i), "__typeof__")) {
        int depth = 0;

        i++;
        while (i < 40 && pa_peek(i)->kind != TK_EOF) {
            if (pa_peek(i)->kind == TK_PUNCT && tok_eq(pa_peek(i), "("))
                depth++;
            else if (pa_peek(i)->kind == TK_PUNCT && tok_eq(pa_peek(i), ")")) {
                depth--;
                if (depth == 0) {
                    i++;
                    break;
                }
            }
            i++;
        }
    } else if (!is_typename_tok(pa_peek(i))) {
        return 0;
    } else {
        if (TOK_EQ(pa_peek(i), "struct") || TOK_EQ(pa_peek(i), "union")
            || TOK_EQ(pa_peek(i), "enum"))
            i += 2;
        else
            i += 1;
    }
    while (i < 12 && pa_peek(i)->kind == TK_PUNCT && TOK_EQ(pa_peek(i), "*"))
        i++;
    if (!(pa_peek(i)->kind == TK_PUNCT && tok_eq(pa_peek(i), ")")))
        return 0;
    i++;
    while (i < 14 && pa_peek(i)->kind == TK_PUNCT && tok_eq(pa_peek(i), ")"))
        i++;
    return pa_peek(i)->kind == TK_PUNCT && TOK_EQ(pa_peek(i), "{");
}

/* 吃掉 `(T)` 前缀，停在 `{` 上；返回多出来的左括号个数（收尾要补上 `)`）。
 * `ty_out` 非空时把 `(T)` 里的类型（含 `*` / `[N]` 这类声明符）一起带出来。 */
static u32 pa_take_paren_type_ex(u32 *ty_out)
{
    u32 extra = 0;

    while (pa_is_ch('(')) {
        pa_advance();
        extra++;
    }
    while (tykw_is_qual(pa_cur()))
        pa_advance();
    {
        u32 t = parse_typespec();

        if (ty_out) {
            Declarator ad = {0};

            t = parse_declarator(t, &ad);
            *ty_out = t;
        }
    }
    while (pa_accept_ch(')'))
        ;
    return extra ? extra - 1 : 0;
}

static u32 pa_take_paren_type(void)
{
    return pa_take_paren_type_ex(NULL);
}

/* 零字节对象的复合字面量（`empty_s x = (empty_s){}`）：没有字节要写，跳过 */
static int pa_skip_empty_compound(void)
{
    u32 ex = 0;

    if (!pa_is_compound_lit())
        return 0;
    ex = pa_take_paren_type();
    pa_advance();                    /* { */
    skip_init_list();
    pa_expect_ch('}');
    while (ex--)
        pa_expect_ch(')');
    return 1;
}

/* 匿名的静态存储期复合字面量（`&(T){…}`）一处一个名字 */
static u32 NCL_LIT;

/* `&(T){ … }`：文件作用域里取复合字面量的地址。
 *
 * C99 6.5.2.5p5：文件作用域的复合字面量是**静态存储期**对象，所以它的存储
 * 直接落在数据段里（语义上就是 `static T cl;` 加一次静态初始化），指针指过去
 * 是一个常量地址。以前这里只认 `&全局` / `&函数`，见到复合字面量就报
 * "全局地址初始化器只支持 &全局/函数"（c-testsuite single-exec/00149、00150）。
 *
 * 进来时游标停在 `&` 后面；返回 1 表示已经把这个初始化器整段吃干净。 */
static int gen_glob_compound_addr(u32 data_off)
{
    u32 cty = 0;
    u32 ex = 0;

    if (!pa_is_compound_lit())
        return 0;
    ex = pa_take_paren_type_ex(&cty);
    if (ty_is_array(cty) && ty_array_n(cty) == 0) {
        /* `&(int[]){1,2}`：长度得数一遍初始化器才知道（同 gen_one_global
         * 里 `T x[] = {…}` 那条路）——先把花括号体抓下来数顶层逗号，再把类型
         * 定死、把体放回源栈，后面照常按 `{` 走。 */
        Tok *body = arena_alloc(&A_main, (size_t)CAP_MAX * sizeof(Tok));
        u32 ncap = body_capture(body, CAP_MAX);

        cty = ty_array(ty_target(cty), CAP_BOUND > 0 ? CAP_BOUND : 1);
        pa_src_push_back(body, ncap);
    }
    if (ty_size(cty) > 0) {
        u32 soff = data_alloc(ty_size(cty), ty_align_of(cty));
        char nm[40] = {0};
        u32 n = (u32)snprintf(nm, sizeof(nm), "__c6_cl_%u", (unsigned)NCL_LIT++);
        u32 sym = x64_data_sym(&X64, arena_strndup(&A_main, nm, n), ELF_HDR + soff);

        gen_glob_braced_new(soff, cty, 0);
        data_fixup_add(data_off, sym);
    } else {
        /* 零字节对象（`&(empty_s){}`）：没有字节要写 */
        pa_advance();                    /* { */
        skip_init_list();
        pa_expect_ch('}');
    }
    while (ex--)
        pa_expect_ch(')');
    return 1;
}

static void gen_glob_obj(u32 goff, u32 ty, u32 off)
{
    if (ty_size(ty) == 0 && pa_skip_empty_compound())
        return;
    /* 文件作用域的切片不能拿数组/指针直接初始化：`{ data, len }` 里那个 len
     * 得是编译期常量，而从数组推不出来（`extern int ext[]` 更是没有长度）——
     * 写 `int[:] g = a;` 只会静默变成两个 0
     * （tests/errors/slice.c6 的 test_file_scope_array / test_unknown_length）。 */
    /* 静态存储期的闭包只能用 NULL 起步：闭包对象是运行期现开的
     * （tests/errors/closure_convert.c6 的 test_static / test_static_local）。 */
    if (ty_is_closure(ty, NULL) && !pa_is_ch('{') && in_c6_tu()) {
        Tok *t0 = pa_cur();

        if (!(t0 && ((t0->kind == TK_NUM && tok_data(t0)[0] == '0')
                     || (t0->kind == TK_IDENT
                         && (TOK_EQ(t0, "NULL") || TOK_EQ(t0, "nullptr"))))))
            pa_error("a closure is not a constant expression: initialize it at run "
                     "time ('NULL' is fine at file scope)");
    }
    if (ty_is_slice(ty) && !pa_is_ch('{') && in_c6_tu()) {
        pa_error("a slice cannot be initialized from an array in a static "
                 "initializer; use '{ data, len }'");
    }
    /* `void *p = &&label`：计算 goto 的标号地址，布局后回填 */
    if (ty_is_ptr(ty) && pa_is_punct("&&") && pa_peek(1)->kind == TK_IDENT) {
        u32 l = goto_label(tok_data(pa_peek(1)), pa_peek(1)->len);

        pa_advance();
        pa_advance();
        code_lbl_fixup_add(goff + off, x64_cur_fnseq(&X64), l);
        return;
    }
    if (pa_is_compound_lit()) {
        u32 ex = pa_take_paren_type();

        gen_glob_braced_new(goff, ty, off);
        while (ex--)
            pa_expect_ch(')');
        return;
    }
    /* 标量上的花括号（`(int){5}` / `{ {5} }`）：剥一层再走标量那条路 */
    if (!ty_is_agg(ty) && !ty_is_array(ty) && pa_is_ch('{')) {
        pa_advance();
        gen_glob_obj(goff, ty, off);
        while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF) {
            if (!pa_accept_ch(','))
                break;
            if (pa_is_ch('}'))
                break;
            init_skip_value();
        }
        pa_expect_ch('}');
        return;
    }
    if (ty_is_agg(ty) || ty_is_array(ty)) {
        if (pa_is_ch('{')) {
            gen_glob_braced_new(goff, ty, off);
            return;
        }
        if (ty_is_array(ty) && pa_cur()->kind == TK_STR) {
            u32 n = (u32)(pa_cur()->len > 1 ? pa_cur()->len - 1 : 1);
            u32 so = str_lit_data();
            u32 k = 0;
            u32 room = ty_size(ty);

            /* 注意这里 `n` 是源 token 的字符数，对宽字面量（`L"…"`）不等于
             * 字节数，所以**不能**照着 room 清零再拷 n 字节（97_utf8 就是这么
             * 被弄坏的）。数据段本身是零，保持原来的行为。 */
            for (k = 0; k < n && k < room; k++)
                DATA_IMG.p[goff + off + k] = DATA_IMG.p[so + k];
            return;      /* str_lit_data 已经把 token 吃掉了 */
        }
        {
            u32 et = ty_is_array(ty) ? ty_target(ty) : 0;
            u32 eo = 0;

            if (!ty_is_array(ty)) {
                if (ty_member_n(ty) == 0) {
                    pa_error("空的聚合类型不能这样初始化");
                    return;
                }
                et = ty_member(ty, 0);
                eo = ty_member_off(ty, 0);
            }
            gen_glob_obj(goff, et, off + eo);
            return;
        }
    }
    if (ty_is_ptr(ty) && pa_cur()->kind == TK_STR) {
        u32 so = str_lit_data();
        u64 va = (u64)DATA_VA(so);

        glob_store(goff, off, ty, va);
        return;      /* str_lit_data 已经把 token 吃掉了 */
    }
    /* 浮点成员：字面量或整型常量都要转成 IEEE-754 的位模式再落地，
     * `struct { double a; } g = { 1 };` 以前把整数 1 的字节直接写进去，
     * 读出来是 5e-324 这种鬼值（131_return_struct_in_reg 就是这样）。 */
    /* 全局聚合里的**地址常量**：`{ sys_one, &g, tab }`。
     * 以前这条路只认数字/浮点，函数名和全局符号名落进去就是 0——静态函数
     * 指针表整张都是空的（tcc 的 90_struct-init 正是这么崩的）。 */
    if (ty_is_ptr(ty)) {
        int amp = pa_accept_ch('&');

        if (amp && gen_glob_compound_addr(goff + off))
            return;
        if (pa_cur()->kind == TK_IDENT) {
            Sym *t = sym_find(tok_data(pa_cur()), pa_cur()->len);

            if (t && (t->kind == SC_GLOBAL || t->is_func)) {
                u32 sym = (u32)t->val;

                if (t->is_func)
                    sym = x64_sym(&X64, arena_strndup(&A_main, tok_data(pa_cur()), pa_cur()->len));
                pa_advance();
                if (!pa_is_ch('[') && !pa_is_ch('.') && !pa_is_ch('+')
                    && !pa_is_ch('-')) {
                    data_fixup_add(goff + off, sym);
                    return;
                }
            }
        }
        if (amp)
            pa_error("全局地址初始化器只支持 &全局/函数");
    }
    if (ty_is_float(ty)) {
        u64 bits = 0;
        int neg = 0;

        (void)neg;
        {
            double dv = 0;

            if (pa_cur()->kind == TK_NUM || pa_is_ch('-') || pa_is_ch('+')
                || pa_is_ch('(')) {
                int ok = 1;

                dv = const_fexpr(&ok);
                if (!ok)
                    dv = 0;
            } else {
                u64 iv = 0;

                if (parse_const_u64(&iv))
                    dv = (double)(i64)iv;
            }
            if (ty_size(ty) == 4) {
                u32 b32 = 0;
                float fv = (float)dv;

                *(float *)&b32 = fv;
                bits = (u64)b32;
            } else {
                *(double *)&bits = dv;
            }
        }
        glob_store(goff, off, ty, bits);
        return;
    }
    {
        u64 v = 0;

        if (parse_const_u64(&v)) {
            if (GLOB_BF_BITS) {
                /* 位域初始化：在数据段上做读-改-写 */
                u64 unit = 0;
                u64 fmask = (GLOB_BF_BITS >= 64)
                            ? ~0ULL : ((1ULL << GLOB_BF_BITS) - 1);
                u32 sz = ty_size(ty);
                u32 i = 0;

                if (sz > 8)
                    sz = 8;
                for (i = 0; i < sz; i++)
                    unit |= (u64)DATA_IMG.p[goff + off + i] << (8 * i);
                unit = (unit & ~(fmask << GLOB_BF_BITOFF))
                       | ((v & fmask) << GLOB_BF_BITOFF);
                glob_store(goff, off, ty, unit);
            } else {
                glob_store(goff, off, ty, v);
            }
        }
    }
}

static void gen_init_obj(u32 addr, u32 ty, u32 off);

/* 一组 {…} 里的元素：把每个元素写到它该在的偏移上 */

/* 指示符导航（`.name` / `[idx]`，可以链起来：`[1].x = 3`），
 * 走完最后一段再吃掉 '=' 填值。 */
static void gen_desig_fill(u32 addr, u32 ty, u32 off)
{
    for (;;) {
        if (pa_accept_ch('[')) {
            u32 i = 0;
            u32 et = 0;

            i = (u32)const_expr();
            pa_expect_ch(']');
            if (!ty_is_array(ty)) {
                pa_error("下标指示符用在了非数组上");
                return;
            }
            et = ty_target(ty);
            if (i >= ty_array_n(ty))
                return;                    /* 越界：整段忽略 */
            ty = et;
            off += i * ty_size(et);
            continue;
        }
        if (pa_accept_ch('.')) {
            const char *nm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
            u32 nl = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
            int idx = 0;

            if (!nm) {
                pa_error("'.' 后面要成员名");
                return;
            }
            pa_advance();
            if (!ty_is_agg(ty)) {
                pa_error("成员指示符用在了非聚合类型上");
                return;
            }
            {
                u32 mo = 0;

                if (!agg_find_promoted(ty, nm, nl, &ty, &mo)) {
                    pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                    return;
                }
                off += mo;
            }
            continue;
        }
        break;
    }
    pa_expect_ch('=');
    gen_init_obj(addr, ty, off);
}

static void gen_init_braced(u32 addr, u32 ty, u32 off)
{
    u32 cur = 0;
    int first = 1;

    if (ty_is_array(ty)) {
        u32 et = ty_target(ty);
        u32 esz = ty_size(et);
        u32 n = ty_array_n(ty);

        for (;;) {
            if (pa_is_ch('}') || pa_cur()->kind == TK_EOF)
                break;
            if (!first && !pa_accept_ch(','))
                break;
            first = 0;
            if (pa_is_ch('}'))
                break;
            if (pa_accept_ch('[')) {
                u32 lo = (u32)const_expr();
                u32 hi = lo;
                u32 k = 0;

                if (pa_accept_punct("..."))
                    hi = (u32)const_expr();
                pa_expect_ch(']');
                if (pa_is_ch('.') || pa_is_ch('[')) {
                    gen_desig_fill(addr, et, off + lo * esz);   /* 链式：只填首元素 */
                } else {
                    pa_expect_ch('=');
                    for (k = lo; k <= hi && k < n; k++)
                        gen_init_obj(addr, et, off + k * esz);
                }
                cur = hi + 1;
                continue;
            }
            if (pa_is_ch('.') && ty_is_agg(ty))
                break;                       /* 走到下面的聚合分支 */
            if (cur >= n) {
                skip_init_list();
                break;
            }
            gen_init_obj(addr, et, off + cur * esz);
            cur++;
        }
        if (off == 0)
            INIT_COUNT = cur;
        return;
    }
    if (!ty_is_agg(ty)) {
        /* 标量套了一层花括号：{5} */
        if (ty_member_n(ty) == 0 && !pa_is_ch('}')) {
            gen_init_obj(addr, ty, off);
            return;
        }
    }
    {
        u32 n = ty_member_n(ty);

        for (;;) {
            if (pa_is_ch('}') || pa_cur()->kind == TK_EOF)
                break;
            if (!first && !pa_accept_ch(','))
                break;
            first = 0;
            if (pa_is_ch('}'))
                break;
            if (pa_accept_ch('.')) {
                const char *nm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
                u32 nl = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
                int idx = 0;
                u32 mty = 0;
                u32 moff = 0;

                if (!nm) {
                    pa_error("'.' 后面要成员名");
                    break;
                }
                pa_advance();
                if (!agg_find_promoted(ty, nm, nl, &mty, &moff)) {
                    pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                    break;
                }
                idx = agg_find_member(ty, nm, nl);
                if (pa_is_ch('.') || pa_is_ch('[')) {
                    gen_desig_fill(addr, mty, off + moff);
                } else {
                    pa_expect_ch('=');
                    gen_init_obj(addr, mty, off + moff);
                }
                cur = idx >= 0 ? (u32)idx + 1 : 0;
                continue;
            }
            if (cur >= n) {
                skip_init_list();      /* 元素用完：多余的吞掉，别报错 */
                break;
            }
            gen_init_obj(addr, ty_member(ty, cur), off + ty_member_off(ty, cur));
            cur++;
        }
    }
}


/* --- 初始化器的叶子游标引擎 --------------------------------------------
 *
 * 旧实现是“一层花括号推进一层子对象”：一个聚合元素没有花括号（brace elision）
 * 时只填它的**第一个**子对象，父层就把这个元素当成填完了。真实代码里省略
 * 花括号到处都是：
 *
 *     PT cases[] = { a, b, c, d, e, f, g };      // PT 里有 I c[4]
 *     struct S g[] = { [1].x[0].b = 5, 6, 7 };   // 6、7 接着填 x[1]
 *
 * 两条都会被填错位置（75_array_in_struct_init / 152_designator_chain）。
 *
 * 新做法：先把整个对象摊平成一串**叶子**（标量成员，按声明顺序、带绝对字节
 * 偏移），用一个游标 INIT_CUR 线性推进。花括号只用来定位目标：从最内层往上找
 * 第一个“首叶正好是游标”的聚合，就是这次 `{…}` 要初始化的子对象；找不到就是
 * 标量套花括号 `{5}`。层栈随游标位置重建，所以 `{` 出现在任何深度都对得上。
 *
 * 叶子表放不下（超大对象）时整个引擎退回旧实现，保证不会因此编错。
 */
#define INIT_LF_MAX 16384
static u32 LF_OFF[INIT_LF_MAX];
static u32 LF_TY[INIT_LF_MAX];
static u32 LF_BITS[INIT_LF_MAX];
static u32 LF_BOFF[INIT_LF_MAX];
static u32 LF_N;
static int LF_TRUNC;
static u32 INIT_CUR;       /* 下一个要填的叶子 */
static u32 INIT_MAX;       /* 填过的最大叶子下标 + 1（顶层数组长度靠它） */

#define INIT_LV_MAX 32
static u32 LV_TY[INIT_LV_MAX];
static u32 LV_OFF[INIT_LV_MAX];
static u32 LV_DEPTH;

static int INIT_IS_GLOB;     /* 1 = 数据段初始化（goff），0 = 局部（addr vreg） */
static u32 INIT_GOFF;
static u32 INIT_ADDR;

/* `T a[] = { … }` 的元素个数只能从初始化器推。前瞻窗口只有 16 个 token
 * （`PA_LOOK`），边解析边看是看不到头的，所以调用方先把整个花括号体用
 * `body_capture()` 抓下来交给这里数一遍：
 *   - 顶层逗号数 + 1 = 顺序初始化的元素个数；
 *   - 设计符 `[N]`、`[a ... b]` 取 b + 1。
 * 算出来的是**上界**（顺序值和设计符混着写时会偏大），调用方解析完用
 * `INIT_COUNT` 收缩到真实长度——全局收数据段尾巴，局部改类型。
 * 以前这里按 `1024 / sizeof(元素)` 估，超过就静默截断：tcc 里那张 354 条的
 * 静态指令表被 c6c 编成只有 122 条，它的汇编器就这么坏的。 */
static u32 init_bound_count(Tok *t, u32 n)
{
    u32 i = 0;
    int depth = 0;
    u32 cur = 0;
    u32 bound = 0;
    int at_item = 1;          /* 刚过完一个顶层逗号，正看着一个新条目的开头 */

    for (i = 0; i < n; i++) {
        Tok *q = &t[i];

        if (q->kind != TK_PUNCT) {
            /* 普通条目可能是数字/字符串/标识符——它们不是标点，别在
             * at_item 判断之前就 continue 掉（`{ {1}, 2 }` 里的 2 就是这种）。 */
            if (depth == 1 && at_item) {
                at_item = 0;
                cur++;
                if (cur > bound)
                    bound = cur;
            }
            continue;
        }
        if (TOK_EQ(q, "{")) {
            if (depth == 1 && at_item) {
                /* `{…}` 也是条目：`{{1,2},{3,4}}` 里每个内层花括号一个元素 */
                at_item = 0;
                cur++;
                if (cur > bound)
                    bound = cur;
            }
            depth++;
            continue;
        }
        if (TOK_EQ(q, "}")) {
            depth--;
            continue;
        }
        if (depth != 1)
            continue;
        if (tok_eq(q, ",")) {
            at_item = 1;
            continue;
        }
        if (!at_item)
            continue;
        at_item = 0;
        if (TOK_EQ(q, "[")) {
            /* 设计符：`[N]` / `[a ... b]`，游标移到 b + 1 */
            u32 k = i + 1;
            u32 mx = 0;
            int seen = 0;

            for (; k < n; k++) {
                Tok *d = &t[k];
                u32 j = 0;
                u64 v = 0;
                int ok = 1;

                if (d->kind == TK_PUNCT && TOK_EQ(d, "]"))
                    break;
                if (d->kind != TK_NUM)
                    continue;
                for (j = 0; j < d->len; j++) {
                    char ch = d->syn[j];

                    if (ch < '0' || ch > '9') {
                        ok = 0;
                        break;
                    }
                    v = v * 10 + (u64)(ch - '0');
                }
                if (ok && v < 0x7fffffffu) {
                    mx = (u32)v;      /* `[a ... b]` 取最后一个数 */
                    seen = 1;
                }
            }
            cur = seen ? mx + 1 : cur + 1;
            i = k;
        } else if (TOK_EQ(q, ".")) {
            /* 成员设计符 `.m = …`：不推进数组游标 */
            continue;
        } else {
            /* 普通条目：游标 + 1（嵌套花括号里的逗号在 depth ≥ 2，不算条目） */
            cur++;
        }
        if (cur > bound)
            bound = cur;
    }
    if (bound == 0)
        bound = 1;
    return bound;
}

static u32 init_leaf_walk(u32 ty, u32 off, u32 bits, u32 boff, int collect)
{
    u32 cnt = 0;
    u32 n = 0;
    u32 i = 0;

    if (ty_is_array(ty)) {
        u32 et = ty_target(ty);
        u32 esz = ty_size(et);

        n = ty_array_n(ty);
        for (i = 0; i < n; i++)
            cnt += init_leaf_walk(et, off + i * esz, 0, 0, collect);
        return cnt;
    }
    if (ty_is_agg(ty)) {
        n = ty_member_n(ty);
        if (ty_is_union(ty) && n > 1)
            n = 1;              /* 联合体只初始化第一个成员 */
        for (i = 0; i < n; i++) {
            u32 mw = ty_member_bits(ty, i);

            /* 无名的位域（`unsigned :32;`、对齐用的 `:0`）不占初始化器的位置 */
            if (ty_member_anon(ty, i))
                continue;
            cnt += init_leaf_walk(ty_member(ty, i), off + ty_member_off(ty, i),
                                  mw, ty_member_bitoff(ty, i), collect);
        }
        return cnt;
    }
    if (collect) {
        if (LF_N >= INIT_LF_MAX) {
            LF_TRUNC = 1;
            return 1;
        }
        LF_OFF[LF_N] = off;
        LF_TY[LF_N] = ty;
        LF_BITS[LF_N] = bits;
        LF_BOFF[LF_N] = boff;
        LF_N++;
    }
    return 1;
}

/* 第一个 offset >= off 的叶子下标（LF_OFF 单调不减）。
 *
 * 原来一律二分：tcc.c 上 init_leaf_at 被调了 28 万次、走了 273 万步二分
 * （平均 9.7 步/次，每步一条带随机下标的 load）。但调用方的访问模式极有规律
 * ——初始化器是一次性扫过去的，查询的 off 基本单调前进，答案下标也跟着走。
 * 所以从**上一次的答案**出发线性探路，8 步内命中就直接返回（绝大多数 1 步），
 * 探不到再把二分区间收窄到剩下那一半。 */
static u32 LF_HINT;

static u32 init_leaf_at(u32 off)
{
    u32 lo = 0;
    u32 hi = LF_N;
    u32 h = LF_HINT;
    u32 q = 0;
    u32 k = 0;

    if (h > LF_N)
        h = LF_N;
    if (h < LF_N && LF_OFF[h] >= off) {
        /* 答案在 h 或更靠前 */
        q = h;
        while (k < 8 && q > 0 && LF_OFF[q - 1] >= off) {
            q--;
            k++;
        }
        if (q == 0 || LF_OFF[q - 1] < off) {
            LF_HINT = q;
            return q;
        }
        hi = q + 1;
    } else if (h < LF_N) {
        /* LF_OFF[h] < off：答案在 h 之后 */
        q = h;
        while (k < 8 && q < LF_N && LF_OFF[q] < off) {
            q++;
            k++;
        }
        if (q >= LF_N) {
            LF_HINT = LF_N;
            return LF_N;
        }
        if (LF_OFF[q] >= off) {
            LF_HINT = q;
            return q;
        }
        lo = q + 1;
    } else {
        /* 上次答案就是表尾：先往回收几步（常见的是 off 走出了表尾） */
        q = LF_N;
        while (k < 8 && q > 0 && LF_OFF[q - 1] >= off) {
            q--;
            k++;
        }
        if (q == 0 || LF_OFF[q - 1] < off) {
            LF_HINT = q;
            return q;
        }
        hi = q + 1;
    }
    while (lo < hi) {
        u32 m = (lo + hi) / 2;

        if (LF_OFF[m] < off)
            lo = m + 1;
        else
            hi = m;
    }
    LF_HINT = lo;
    return lo;
}

static u32 init_sub_n(u32 ty)
{
    if (ty_is_array(ty))
        return ty_array_n(ty);
    if (ty_is_agg(ty)) {
        u32 n = ty_member_n(ty);

        return (ty_is_union(ty) && n > 1) ? 1 : n;
    }
    return 0;
}

static u32 init_sub_ty(u32 ty, u32 i)
{
    return ty_is_array(ty) ? ty_target(ty) : ty_member(ty, i);
}

static u32 init_sub_off(u32 ty, u32 i)
{
    return ty_is_array(ty) ? i * ty_size(ty_target(ty)) : ty_member_off(ty, i);
}

static void init_mark(void)
{
    if (INIT_CUR + 1 > INIT_MAX)
        INIT_MAX = INIT_CUR + 1;
}

/* 写一个叶子。全局走数据段（带位域信息），局部走运行时地址。 */
static void init_store(u32 off, u32 ty, u32 bits, u32 boff)
{
    init_mark();
    if (INIT_IS_GLOB) {
        GLOB_BF_BITS = bits;
        GLOB_BF_BITOFF = boff;
        gen_glob_obj(INIT_GOFF, ty, off);
        GLOB_BF_BITS = 0;
        GLOB_BF_BITOFF = 0;
    } else {
        gen_init_obj(INIT_ADDR, ty, off);
    }
}

/* 把层栈重建到“游标位置的祖先链”：第 top 层是本次花括号自己的对象，
 * 往下每一层都是包含游标的那个子聚合，最深一层是游标叶子的直接父聚合。 */
static void init_sync(u32 top)
{
    u32 d = top + 1;

    while (d < INIT_LV_MAX && INIT_CUR < LF_N) {
        u32 pty = LV_TY[d - 1];
        u32 poff = LV_OFF[d - 1];
        u32 n = init_sub_n(pty);
        u32 i = 0;
        u32 sub = 0;
        int found = 0;

        for (i = 0; i < n; i++) {
            u32 st = init_sub_ty(pty, i);
            u32 so = poff + init_sub_off(pty, i);
            u32 sz = 0;
            u32 lo = init_leaf_at(so);

            /* 子对象的偏移是**递增**的（数组按元素、结构体按声明序），叶表也
             * 按偏移递增，所以 lo 一旦越过游标，后面的兄弟只会更靠后——
             * 直接停。tcc.c 里那些上千元素的静态表原来每个兄弟都要两次二分，
             * profiler 上 init_brace 的四成时间花在这两条 cmp 上。 */
            if (lo > INIT_CUR)
                break;
            sz = ty_size(st) ? ty_size(st) : 1;
            if (INIT_CUR < init_leaf_at(so + sz)) {
                sub = st;
                LV_TY[d] = st;
                LV_OFF[d] = so;
                found = 1;
                break;
            }
        }
        if (!found || ty_is_scalar(sub))
            break;
        d++;
    }
    LV_DEPTH = d;
}

/* 设计符链：`[i]` / `.name` 任意串联，返回最终目标的类型与绝对偏移 */
static int INIT_COLON;     /* 上一次设计符用的是上古 `name:` 写法（不需要 '='） */

static int init_desig(u32 *ty, u32 *off)
{
    INIT_COLON = 0;
    for (;;) {
        /* 上古 GNU 写法：`{ a: 1, b: 2 }`（成员名 + 冒号） */
        if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(1), ":")) {
            const char *nm = tok_data(pa_cur());
            u32 nl = pa_cur()->len;
            u32 mty = 0;
            u32 moff = 0;

            pa_advance();
            pa_advance();                /* : */
            if (!ty_is_agg(*ty) || !agg_find_promoted(*ty, nm, nl, &mty, &moff)) {
                pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                return 0;
            }
            *ty = mty;
            *off += moff;
            INIT_COLON = 1;
            continue;
        }
        if (pa_accept_ch('[')) {
            u32 i = 0;
            u32 et = 0;

            i = (u32)const_expr();
            pa_expect_ch(']');
            if (!ty_is_array(*ty)) {
                pa_error("设计符 '[...]' 用在了非数组上");
                return 0;
            }
            et = ty_target(*ty);
            if (i >= ty_array_n(*ty))
                return 0;
            *ty = et;
            *off += i * ty_size(et);
            continue;
        }
        if (pa_accept_ch('.')) {
            const char *nm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
            u32 nl = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
            u32 mty = 0;
            u32 moff = 0;

            if (!nm) {
                pa_error("'.' 后面要成员名");
                return 0;
            }
            pa_advance();
            if (!ty_is_agg(*ty) || !agg_find_promoted(*ty, nm, nl, &mty, &moff)) {
                pa_error("结构体没有成员 '%.*s'", (int)nl, nm);
                return 0;
            }
            *ty = mty;
            *off += moff;
            continue;
        }
        break;
    }
    return 1;
}

static void init_body(u32 top);

static void init_brace(u32 ty, u32 off)
{
    u32 my = 0;

    pa_expect_ch('{');
    if (LV_DEPTH >= INIT_LV_MAX - 1) {
        skip_init_list();
        pa_expect_ch('}');
        return;
    }
    my = LV_DEPTH;
    LV_TY[my] = ty;
    LV_OFF[my] = off;
    LV_DEPTH = my + 1;
    init_body(my);
    LV_DEPTH = my;
    pa_expect_ch('}');
    /* 零字节的聚合成员（`struct {} empty;`）不占叶子，游标要**停在原地**：
     * 加 1 会把它推过下一个成员，`{ 1, (empty_s){}, 022 }` 里的 022 就被
     * 「游标走完了」那条早退吞掉了。 */
    INIT_CUR = init_leaf_at(off + (ty_size(ty) ? ty_size(ty) : (ty_is_agg(ty) ? 0 : 1)));
}

/* 跳过当前项的值（指示符出错后用），停在 ',' 或 '}' 前 */
static void init_skip_value(void)
{
    int depth = 0;
    int n = 0;

    while (pa_cur()->kind != TK_EOF && n < 100000) {
        Tok *t = pa_cur();

        if (depth == 0 && t->kind == TK_PUNCT && (tok_eq(t, ",") || TOK_EQ(t, "}")))
            return;
        if (t->kind == TK_PUNCT) {
            if (TOK_EQ(t, "{") || tok_eq(t, "(") || TOK_EQ(t, "["))
                depth++;
            else if (TOK_EQ(t, "}") || tok_eq(t, ")") || TOK_EQ(t, "]"))
                depth--;
        }
        pa_advance();
        n++;
    }
}

static void init_body(u32 top)
{
    int first = 1;

    for (;;) {
        if (pa_is_ch('}') || pa_cur()->kind == TK_EOF)
            break;
        if (!first && !pa_accept_ch(','))
            break;
        first = 0;
        if (pa_is_ch('}'))
            break;
        /* 游标走完了：多余的值吞掉别报错。但**设计符不算多余**——它会把
         * 游标拽回去（`{.b = 8, .a = 7}` 里第二个设计符是往回走的），
         * 早退会把它静默丢掉。 */
        if (INIT_CUR >= LF_N
            && !(pa_is_ch('[') || pa_is_ch('.')
                 || (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
                     && TOK_EQ(pa_peek(1), ":")))) {
            skip_init_list();
            break;
        }
        /* 区间设计符 `[lo ... hi] = v` */
        if (pa_is_ch('[') && pa_peek(2) && pa_peek(2)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(2), "...")) {
            u32 bty = LV_TY[top];
            u32 boff = LV_OFF[top];
            u32 lo = 0;
            u32 hi = 0;
            u32 k = 0;

            pa_advance();
            lo = (u32)const_expr();
            pa_expect_punct("...");
            hi = (u32)const_expr();
            pa_expect_ch(']');
            pa_expect_ch('=');
            if (!ty_is_array(bty)) {
                pa_error("区间设计符只能用在数组上");
                init_skip_value();
                continue;
            }
            {
                u32 et = ty_target(bty);
                u32 esz = ty_size(et);
                u32 n = ty_array_n(bty);

                /* 值只求一次，然后抄给区间里的每个元素（C 就是这么规定的；
                 * `[6 ... 10] = elt` 里 elt 是个变量，重复解析根本做不到）。 */
                if (pa_is_ch('{')) {
                    /* `[0 ... 2] = {{3,4,5},{6,7,8}}`：花括号只能解析一次，
                     * 所以先填第一个元素，再把它的字节抄给区间里其余元素
                     * （数据段直接 memcpy；局部变量用 IR_MEMCPY）。 */
                    u32 blob = 0;

                    init_brace(et, boff + lo * esz);
                    blob = boff + lo * esz;
                    if (INIT_IS_GLOB) {
                        for (k = lo + 1; k <= hi && k < n; k++)
                            memcpy(DATA_IMG.p + INIT_GOFF + boff + k * esz,
                                   DATA_IMG.p + INIT_GOFF + blob, (size_t)esz);
                    } else {
                        for (k = lo + 1; k <= hi && k < n; k++) {
                            /* IR_MEMCPY 的 dst 是第一个操作数：写成 0 会把槽位 0
                             * 的内容当地址读，直接段错误。 */
                            u32 dv = gen_addr_off(INIT_ADDR, boff + k * esz);
                            u32 sv = gen_addr_off(INIT_ADDR, blob);

                            irfn_push(&FN, IR_MEMCPY, IRT_VOID, (u16)dv, (u16)sv,
                                      0, 0, esz);
                        }
                    }
                } else if (INIT_IS_GLOB && pa_is_punct("&&") && pa_peek(1)->kind == TK_IDENT) {
                    /* `[0 ... 31] = &&l_bad`：每个元素一条「代码标号」重定位 */
                    u32 l = goto_label(tok_data(pa_peek(1)), pa_peek(1)->len);

                    pa_advance();
                    pa_advance();
                    for (k = lo; k <= hi && k < n; k++)
                        code_lbl_fixup_add(INIT_GOFF + boff + k * esz,
                                           x64_cur_fnseq(&X64), l);
                } else if (INIT_IS_GLOB) {
                    Tok *vt = pa_cur();
                    Sym *gs = NULL;

                    (void)pa_accept_ch('&');
                    vt = pa_cur();
                    if (vt->kind == TK_IDENT)
                        gs = sym_find(tok_data(vt), vt->len);
                    if (gs && (gs->kind == SC_GLOBAL || gs->is_func)) {
                        /* `[0 ... 3] = &func`：每个元素一条重定位 */
                        u32 sym = (u32)gs->val;

                        if (gs->is_func)
                            sym = x64_sym(&X64, arena_strndup(&A_main, tok_data(vt), vt->len));
                        pa_advance();
                        for (k = lo; k <= hi && k < n; k++)
                            data_fixup_add(INIT_GOFF + boff + k * esz, sym);
                    } else {
                        i64 cv = const_expr();

                        for (k = lo; k <= hi && k < n; k++)
                            glob_store(INIT_GOFF, boff + k * esz, et, (u64)cv);
                    }
                } else {
                    u32 v = value_of(gen_assign());
                    u32 vty = cur_op_ty();

                    for (k = lo; k <= hi && k < n; k++)
                        store_conv(gen_addr_off(INIT_ADDR, boff + k * esz), et, v, vty);
                }
                /* 区间也要推进「推进到哪儿过」的标记，否则
                 * `void *t[] = {[0 ... 255] = &&l;}` 推不出 256 个元素，
                 * 数组只有 1 个长，越界读出来的是垃圾地址（跳到野指针）。
                 * 注意标记要按**最后一个元素**算：init_mark() 是 CUR+1，
                 * 而下面的游标已经指到区间后面去了，用它会多算一个元素。 */
                {
                    u32 last = init_leaf_at(boff + hi * esz);

                    if (last + 1 > INIT_MAX)
                        INIT_MAX = last + 1;
                }
                INIT_CUR = init_leaf_at(boff + (hi + 1) * esz);
            }
            continue;
        }
        if (pa_is_ch('[') || pa_is_ch('.')
            || (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(1), ":"))) {
            u32 dty = LV_TY[top];
            u32 doff = LV_OFF[top];
            u32 li = 0;

            if (!init_desig(&dty, &doff)) {
                init_skip_value();
                continue;
            }
            li = init_leaf_at(doff);
            if (li < LF_N && LF_OFF[li] != doff)
                li = LF_N;
            INIT_CUR = li;
            if (!pa_accept_ch('=') && !INIT_COLON) {
                pa_error("设计符后面要 '='");
                init_skip_value();
                continue;
            }
            if (pa_is_ch('{')) {
                init_brace(dty, doff);
                continue;
            }
            if (ty_is_agg(dty) || ty_is_array(dty)) {
                /* `[0] = 5`：值落到子对象的第一个叶子（C 就是这么规定） */
                if (INIT_IS_GLOB)
                    gen_glob_obj(INIT_GOFF, dty, doff);
                else
                    gen_init_obj(INIT_ADDR, dty, doff);
                INIT_CUR = init_leaf_at(doff + (ty_size(dty) ? ty_size(dty) : 1));
                continue;
            }
            if (li < LF_N)
                init_store(LF_OFF[li], LF_TY[li], LF_BITS[li], LF_BOFF[li]);
            else if (INIT_IS_GLOB)
                gen_glob_obj(INIT_GOFF, dty, doff);
            else
                gen_init_obj(INIT_ADDR, dty, doff);
            INIT_CUR = li + 1;
            continue;
        }
        /* 普通项 */
        init_sync(top);
        if (pa_cur()->kind == TK_STR) {
            /* 字符串填的是整个字符数组子对象，不是游标指向的那个字节 */
            u32 d = top + 1;
            u32 tty = 0;
            u32 toff = 0;
            int hit = 0;

            while (d < LV_DEPTH) {
                if (init_leaf_at(LV_OFF[d]) == INIT_CUR && ty_is_array(LV_TY[d])) {
                    tty = LV_TY[d];
                    toff = LV_OFF[d];
                    hit = 1;
                    break;
                }
                d++;
            }
            if (hit) {
                u32 last = 0;

                if (INIT_IS_GLOB)
                    gen_glob_obj(INIT_GOFF, tty, toff);
                else
                    gen_init_obj(INIT_ADDR, tty, toff);
                last = init_leaf_at(toff + (ty_size(tty) ? ty_size(tty) : 1));
                /* 字符串填的是整个子对象，推进的叶子也要记进 INIT_MAX，
                 * 否则 `char m[][2][3] = {…, "abc"}` 会少算一个元素。 */
                if (last > INIT_MAX)
                    INIT_MAX = last;
                INIT_CUR = last;
                continue;
            }
        }
        /* `{ (char *)"html", … }`：字符串字面量外面套一层强转。以前只有裸
         * 字面量才认，套了 `(char *)` 就走到 const_expr，报"要一个常量表达式"
         * （std/net/mime.c6 的 mime_tab）。 */
        if (INIT_IS_GLOB && !pa_is_compound_lit() && pa_is_ch('(')
            && is_typename_tok(pa_peek(1)) && INIT_CUR < LF_N
            && ty_is_ptr(LF_TY[INIT_CUR])) {
            u32 li2 = INIT_CUR;

            (void)pa_take_paren_type();
            /* pa_take_paren_type 遇到 `(char *)` 会停在 `*` 上（指针归声明符管），
             * 所以 `*` 和 `)` 都自己吃掉 */
            for (;;) {
                if (pa_is_ch('*') || pa_is_ch(')')) {
                    pa_advance();
                    continue;
                }
                break;
            }
            if (pa_cur()->kind == TK_STR) {
                u32 so = str_lit_data();

                glob_store(INIT_GOFF, LF_OFF[li2], LF_TY[li2], (u64)DATA_VA(so));
                INIT_CUR = li2 + 1;
                continue;
            }
        }
        if (pa_is_compound_lit()) {
            /* 目标子对象如果正好从游标开始，就照常按花括号填；否则它属于
             * 一个零字节成员（`empty_s` 之类），没有字节要写。 */
            u32 d = top + 1;
            u32 tty = 0;
            u32 toff = 0;
            int hit = 0;

            while (d < LV_DEPTH) {
                if (init_leaf_at(LV_OFF[d]) == INIT_CUR) {
                    tty = LV_TY[d];
                    toff = LV_OFF[d];
                    hit = 1;
                    break;
                }
                d++;
            }
            if (hit) {
                u32 ex = pa_take_paren_type();

                init_brace(tty, toff);
                while (ex--)
                    pa_expect_ch(')');
            } else {
                (void)pa_skip_empty_compound();
            }
            continue;
        }
        if (pa_is_ch('{')) {
            u32 d = top + 1;
            u32 tgt_ty = 0;
            u32 tgt_off = 0;
            int found = 0;

            /* 花括号绑定到“正好从游标处开始”的**最外层**子对象。
             *   QueryPair p[2] = { { {0,0}, {0,0}, 7 }, … }
             * 第一个 `{` 属于 p[0] 整个元素，不是更里层的成员 k——
             * 所以从 top+1 往上找第一个匹配，而不是从最深往下找。 */
            while (d < LV_DEPTH) {
                if (init_leaf_at(LV_OFF[d]) == INIT_CUR) {
                    tgt_ty = LV_TY[d];
                    tgt_off = LV_OFF[d];
                    found = 1;
                    break;
                }
                d++;
            }
            if (found) {
                init_brace(tgt_ty, tgt_off);
                continue;
            }
            /* 标量套花括号：{5}。多出来的项按 C 的规矩算“元素过多”，
             * 只填第一个、其余跳过（gcc 给警告，tcc 直接忽略）。 */
            {
                u32 li = INIT_CUR;

                pa_advance();
                if (!pa_is_ch('}')) {
                    if (li < LF_N)
                        init_store(LF_OFF[li], LF_TY[li], LF_BITS[li], LF_BOFF[li]);
                    else
                        skip_init_list();
                    while (pa_accept_ch(',')) {
                        if (pa_is_ch('}'))
                            break;
                        init_skip_value();
                    }
                }
                INIT_CUR = li + 1;
                pa_expect_ch('}');
            }
            continue;
        }
        /* 局部初始化器里的普通项：右值可能是**同类型的聚合变量**
         * （`struct U lu = {3, ls, 4, …}` 里的 `ls`），这时要整块拷，不能当成
         * 只填第一个叶子。先求值再看类型，两条路都不难走。 */
        if (!INIT_IS_GLOB) {
            u32 d2 = top + 1;
            u32 tty = 0;
            u32 toff = 0;
            u32 li = INIT_CUR;

            while (d2 < LV_DEPTH) {
                if (init_leaf_at(LV_OFF[d2]) == li && ty_is_agg(LV_TY[d2])) {
                    tty = LV_TY[d2];
                    toff = LV_OFF[d2];
                    break;
                }
                d2++;
            }
            if (tty) {
                u32 v = value_of(gen_assign());
                u32 vty = cur_op_ty();

                if (ty_is_agg(vty)) {
                    irfn_push(&FN, IR_COPY, IRT_U8,
                              (u16)gen_addr_off(INIT_ADDR, toff), (u16)v, 0, 0,
                              ty_size(tty));
                    INIT_CUR = init_leaf_at(toff + (ty_size(tty) ? ty_size(tty) : 1));
                    init_mark();
                    continue;
                }
                if (li < LF_N) {
                    store_conv(gen_addr_off(INIT_ADDR, LF_OFF[li]), LF_TY[li], v, vty);
                    INIT_CUR = li + 1;
                    init_mark();
                    continue;
                }
            }
        }
        init_store(LF_OFF[INIT_CUR], LF_TY[INIT_CUR], LF_BITS[INIT_CUR], LF_BOFF[INIT_CUR]);
        INIT_CUR++;
    }
}

/* 顶层数组长度补全：游标推进到第几个元素。返回 1 表示这个对象确实是
 * 顶层数组、长度有据可依（空初始化器也算，长度 0）。 */
static int init_count_of(u32 ty, u32 off, u32 *out)
{
    u32 esz = 0;
    u32 lpe = 0;

    if (!ty_is_array(ty) || off != 0)
        return 0;
    esz = ty_size(ty_target(ty));
    lpe = init_leaf_at(esz ? esz : 1);
    if (lpe == 0)
        return 0;
    *out = (INIT_MAX + lpe - 1) / lpe;
    return 1;
}

static void gen_glob_braced_new(u32 goff, u32 ty, u32 off)
{
    u32 save_cur = INIT_CUR;
    u32 save_max = INIT_MAX;
    int save_glob = INIT_IS_GLOB;
    u32 save_goff = INIT_GOFF;
    u32 save_depth = LV_DEPTH;
    u32 cnt = 0;

    LF_N = 0;
    LF_TRUNC = 0;
    LF_HINT = 0;
    (void)init_leaf_walk(ty, off, 0, 0, 1);
    if (LF_TRUNC) {
        INIT_CUR = save_cur;
        pa_advance();                       /* 对象太大：退回旧实现 */
        gen_glob_braced(goff, ty, off);
        pa_expect_ch('}');
        return;
    }
    INIT_IS_GLOB = 1;
    INIT_GOFF = goff;
    INIT_CUR = 0;
    INIT_MAX = 0;
    LV_DEPTH = 0;
    init_brace(ty, off);
    if (init_count_of(ty, off, &cnt)) {
        INIT_COUNT = cnt;
        INIT_CNT_OK = 1;
    }
    INIT_CUR = save_cur;
    INIT_MAX = save_max;
    INIT_IS_GLOB = save_glob;
    INIT_GOFF = save_goff;
    LV_DEPTH = save_depth;
}

static void gen_local_braced_new(u32 addr, u32 ty, u32 off)
{
    u32 save_cur = INIT_CUR;
    u32 save_max = INIT_MAX;
    int save_glob = INIT_IS_GLOB;
    u32 save_addr = INIT_ADDR;
    u32 save_depth = LV_DEPTH;
    u32 cnt = 0;

    LF_N = 0;
    LF_TRUNC = 0;
    LF_HINT = 0;
    (void)init_leaf_walk(ty, off, 0, 0, 1);
    if (LF_TRUNC) {
        INIT_CUR = save_cur;
        pa_advance();                       /* 对象太大：退回旧实现 */
        gen_init_braced(addr, ty, off);
        pa_expect_ch('}');
        return;
    }
    INIT_IS_GLOB = 0;
    INIT_ADDR = addr;
    INIT_CUR = 0;
    INIT_MAX = 0;
    LV_DEPTH = 0;
    init_brace(ty, off);
    if (init_count_of(ty, off, &cnt)) {
        INIT_COUNT = cnt;
        INIT_CNT_OK = 1;
    }
    INIT_CUR = save_cur;
    INIT_MAX = save_max;
    INIT_IS_GLOB = save_glob;
    INIT_ADDR = save_addr;
    LV_DEPTH = save_depth;
}

static void gen_init_obj(u32 addr, u32 ty, u32 off)
{
    if (ty_size(ty) == 0 && pa_skip_empty_compound())
        return;
    if (pa_is_compound_lit()) {
        u32 ex = pa_take_paren_type();

        gen_local_braced_new(addr, ty, off);
        while (ex--)
            pa_expect_ch(')');
        return;
    }
    /* 标量上的花括号：`(int){5}`、`{ {5} }`。C 允许给标量套花括号，
     * 但叶子引擎只吃聚合，所以这里自己剥一层（多出来的项按 GNU 语义忽略）。 */
    if (!ty_is_agg(ty) && !ty_is_array(ty) && pa_is_ch('{')) {
        pa_advance();
        gen_init_obj(addr, ty, off);
        while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF) {
            if (!pa_accept_ch(','))
                break;
            if (pa_is_ch('}'))
                break;
            init_skip_value();
        }
        pa_expect_ch('}');
        return;
    }
    if (ty_is_agg(ty) || ty_is_array(ty)) {
        if (pa_is_ch('{')) {
            gen_local_braced_new(addr, ty, off);
            return;
        }
        if (ty_is_array(ty) && pa_cur()->kind == TK_STR) {
            u32 src = gen_string();
            u32 a2 = gen_addr_off(addr, off);
            u32 n = ty_size(ty);
            /* 最内层的标量宽度：`char[2][3] = "abc"` 是按**字节**填的，
             * 用 ty_target 的宽度（char[3] = 3）会多拷两倍。 */
            u32 esc = ty;
            u32 esz = 1;
            u32 nc = 0;

            while (ty_is_array(esc))
                esc = ty_target(esc);
            esz = ty_size(esc) ? ty_size(esc) : 1;
            nc = (STR_LIT_N + 1) * esz;   /* 字面量 + 结尾的 NUL */

            /* 字符串只填前 STR_LIT_N+1 个字节，**其余的要自己清零**：
             * 数据段天然是零所以全局看着没事，局部数组不零就是上个栈帧的垃圾
             * （`char c[16] = "hello"` 的后 10 个字节全是脏的）。 */
            if (nc > n)
                nc = n;
            gen_zero_obj(a2, n);
            INIT_COUNT = STR_LIT_N + 1;   /* `char s[] = "…"` 的元素个数 */
            irfn_push(&FN, IR_COPY, IRT_U8, (u16)a2, (u16)src, 0, 0, nc);
            return;
        }
        /* 不是花括号：两种可能——同类型的聚合表达式（`struct S s = t;` /
         * `= (struct S){...}`，整块拷），或花括号省略（`{0}` 只给第一个叶子，其余
         * 已经清零了）。先求值，再看表达式自己的类型决定走哪条。 */
        {
            u32 et = ty_is_array(ty) ? ty_target(ty) : 0;
            u32 eo = 0;
            u32 v = 0;
            u32 ety = 0;
            u32 arr_len = 0;
            u32 lit_len = 0;
            int src_ptr = 0;    /* 初始化器的源是个真指针（不是数组/切片） */

            if (!ty_is_array(ty)) {
                if (ty_member_n(ty) == 0) {
                    pa_error("空的聚合类型不能这样初始化");
                    return;
                }
                et = ty_member(ty, 0);
                eo = ty_member_off(ty, 0);
            }
            /* `{0}` 落到"第一个叶子"是聚合（union/数组）时不能再走 store_conv：
             * 那会把标量当聚合指针整块 IR_COPY（从地址 0 读 16 字节）——tcc 的
             * `jmp_buf main_jb = {0}` 正是这样一进函数就段错误。局部聚合在声明时
             * 已经 gen_zero_obj 清零过，这里什么都不用生成。 */
            /* 这一支是"花括号省略"（`struct S s = 0;`，只给第一个叶子）。
             * 但右边整个就是同类型的聚合值（`struct S s = t;`、`= (struct S){…}`）
             * 时不能走这儿：那会只初始化**第一个成员**——第一个成员自己也是聚合
             * 时（`struct S { struct P p; int z; }`）就只拷了前 8 字节，z 永远是 0。 */
            {
                int whole = 0;

                if (pa_is_compound_lit())
                    whole = 1;
                else if (pa_cur()->kind == TK_IDENT) {
                    Sym *ws = sym_find(tok_data(pa_cur()), pa_cur()->len);

                    if (ws && (ty_is_agg(ws->type) || ty_is_array(ws->type)))
                        whole = 1;
                    /* `struct S s = f();`：f 按地址返回整个聚合 */
                    else if (ws && ws->is_func && ty_is_agg(ty_target(ws->type)))
                        whole = 1;
                }
                if (!whole && (ty_is_agg(et) || ty_is_array(et))) {
                    /* 往下走一层到真正的标量叶子再存：直接 store_conv 会把标量当成
                     * 聚合指针整块 IR_COPY（从地址 0 读十几字节），tcc 的
                     * `jmp_buf main_jb = {0}` 就是这样一进函数就段错误。 */
                    gen_init_obj(addr, et, off + eo);
                    return;
                }
            }
            {
                /* 数组左值在求值时会退化成指针，长度信息就没了——先看一眼
                 * 这个标识符本身是不是数组。 */
                Tok *nt = pa_cur();

                if (nt->kind == TK_IDENT) {
                    Sym *as = sym_find(tok_data(nt), nt->len);

                    if (as && ty_is_array(as->type))
                        arr_len = ty_array_n(as->type);
                    else if (as && ty_is_ptr(as->type) && !ty_is_slice(as->type))
                        src_ptr = 1;
                } else if (nt->kind == TK_STR) {
                    /* `char[:] m = "hello";`——字符串字面量的长度含结尾 NUL，
                     * 正好是 token 文本去掉开头引号后的字节数。 */
                    lit_len = nt->len - 1;
                }
            }
            v = value_of(gen_assign());
            ety = GEN_TY;
            /* 切片 ← 数组/指针：`int[:] s = arr;` 要现搭一个 `{ptr, len}`，
             * 直接 IR_COPY 16 字节只会把数组头两个元素当指针和长度。 */
            if (ty_is_slice(ty) && (ty_is_array(ety) || ty_is_ptr(ety))) {
                u32 a2 = gen_addr_off(addr, off);
                u32 dv = irfn_vreg(&FN);
                u32 lv = irfn_vreg(&FN);
                u32 a8 = 0;
                /* 切片只能从数组（或字符串字面量）来：元素类型要对得上，
                 * 长度得是已知的。数组在表达式里已经退化成了指针，所以
                 * "源是数组"靠 `arr_len`（声明处记下的长度）和 `ety` 是不是
                 * 数组类型两个线索；两个都没有、而源本身是个指针符号
                 * （`src_ptr`）就是真的在拿指针建切片，得写 `(T[:]){p, n}`。
                 * 赋值路径也会走到这里（两侧都是切片），那种情况三个线索全空，
                 * 一律不查——查了就是误报（std/container/pqueue.c6 就是）。 */
                if (ty_is_array(ety)) {
                    u32 se0 = ty_slice_elem(ty);

                    if (ty_array_n(ety) == 0)
                        pa_error("不能切一个长度未知的数组");
                    else if (ty_target(ety) != se0)
                        pa_error("切片的元素类型和数组对不上");
                } else if (arr_len) {
                    if (ty_is_ptr(ety) && ty_target(ety) != ty_slice_elem(ty))
                        pa_error("切片的元素类型和数组对不上");
                } else if (src_ptr) {
                    pa_error("不能从指针建切片，长度哪儿来？用 '(T[:]){p, n}'");
                }

                if (ty_is_array(ety)) {
                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)lv, 0, 0, 0,
                              ty_array_n(ety) ? ty_array_n(ety) : 1);
                    irfn_push(&FN, IR_MOV, IRT_PTR, (u16)dv, (u16)v, 0, 0, 0);
                } else if (arr_len) {
                    /* 数组在表达式中已经退化成指针了，长度得从声明处拿 */
                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)lv, 0, 0, 0, arr_len);
                    irfn_push(&FN, IR_MOV, IRT_PTR, (u16)dv, (u16)v, 0, 0, 0);
                } else {
                    irfn_push(&FN, IR_MOV, IRT_PTR, (u16)dv, (u16)v, 0, 0, 0);
                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)lv, 0, 0, 0, lit_len);
                }
                store_conv(a2, ty_ptr(ty_slice_elem(ty)), dv, ty_ptr(ty_slice_elem(ty)));
                a8 = gen_addr_off(addr, off + 8);
                store_conv(a8, ty_ulong(), lv, ty_ulong());
                return;
            }
            if (ty_is_agg(ety) || ty_is_array(ety)) {
                u32 a2 = gen_addr_off(addr, off);

                irfn_push(&FN, IR_COPY, IRT_U8, (u16)a2, (u16)v, 0, 0, ty_size(ty));
                return;
            }
            store_conv(gen_addr_off(addr, off + eo), et, v, ety);
            return;
        }
    }
    {
        u32 v = gen_assign();
        u32 vty = cur_op_ty();
        u32 a2 = gen_addr_off(addr, off);

        v = value_of(v);
        store_conv(a2, ty, v, vty);
    }
}


static void gen_one_global(u32 ty, Declarator *d);

static void gen_one_local(u32 ty, Declarator *d)
{
    Sym *s = NULL;
    int decl_static = PA_STATIC;      /* 块作用域的 `static`：初始化器必须是常量 */

    char udiag_name[160] = {0};      /* 诊断里打印的类型名（`struct Node`） */
    int udiag_nlen = 0;

    if (!d->name) {
        /* 语句位置上的 `void(int x);`：看着像函数字面量却没有体
         * （tests/errors/fn_lit.c6 的 test_no_body）。 */
        if (ty_is_func(ty) && in_c6_tu())
            pa_error("'{' expected: the body of the function literal");
        return;   /* `struct S { ... };`：只有类型定义 */
    }
    /* c6：变量声明就得初始化（静态局部、extern 例外——它们在数据段里，
     * 本来就是 0）。这跟 C 的"未初始化是未定义值"不是一回事：c6 认为读
     * 一个没写过初值的变量一定是 bug。 */
    if (in_c6_tu() && !PA_TMPL_BODY && !PA_SIG_ONLY && !PA_STATIC && !PA_EXTERN && !ty_is_func(ty)
        && !d->vla && !pa_is_ch('=') && !pa_is_ch('{'))
        pa_error("variable '%s' must be initialized",
                 arena_strndup(&A_main, d->name, d->nlen));
    if (in_c6_tu() && !PA_SIG_ONLY && !d->mgd && ty_has_mgd(ty)) {
        char dnm[160] = {0};

        agg_disp_name(ty, dnm, sizeof(dnm));
        pa_error("'%s' holds managed references: a declared object is not possible. "
                 "Allocate it with 'new' and hold it in '@%s'", dnm, dnm);
    }
    if (d->vla) {
        if (CUR_TASK_TY)
            pa_error("async 函数里不能用变长数组（任务结构要能整块搬）");
        /* 变长数组：在栈上现开 d->vla_cnt * d->vla_esz 字节，把指针存进槽。
         * 槽里放指针而不是数组本身，所以下标、传参、赋值全都走普通指针路径。
         * rsp 由函数尾声的 leave（mov rsp, rbp）恢复，不需要逐块回收。 */
        u32 p = irfn_vreg(&FN);

        if (SCOPE && !SCOPE->vla_save) {
            /* 记下这个块进来时的 rsp：换一块 VLA 就要能整体回收，
             * 循环体里的 VLA 才会每次拿到同一个地址。 */
            u32 z = irfn_vreg(&FN);

            SCOPE->vla_save = irfn_vreg(&FN);
            irfn_push(&FN, IR_CONST, IRT_U64, (u16)z, 0, 0, 0, 0);
            irfn_push(&FN, IR_ALLOCA, IRT_PTR, (u16)SCOPE->vla_save, (u16)z, 0, 0, 1);
        }
        irfn_push(&FN, IR_ALLOCA, IRT_PTR, (u16)p, (u16)d->vla_cnt, 0, 0, d->vla_esz);
        s = sym_add(d->name, d->nlen, ty, SC_LOCAL);
        s->slot = irfn_vreg(&FN);
        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)s->slot, 0, 0, 0, X64_SLOT(s->slot));
        irfn_push(&FN, IR_STORE, IRT_U64, (u16)s->slot, (u16)p, 0, 0, 0);
        return;
    }
    if (ty_is_func(ty)) {
        /* 块作用域的函数声明（`void f(void);` / `extern void f(void);`）：
         * 登记成全局符号，块里不分配存储。符号按名字 intern，所以文件后面
         * 真正的定义会落在同一个 ELF 符号上（tcc tests2 105_local_extern）。 */
        const char *nm = arena_strndup(&A_main, d->name, d->nlen);
        Sym *fs = sym_find(nm, d->nlen);

        if (!fs || !fs->is_func) {
            fs = sym_add(nm, d->nlen, ty, SC_GLOBAL);
            fs->is_func = 1;
            fs->val = (i64)x64_sym(&X64, emit_name(nm));
        }
        return;
    }
    if (PA_STATIC) {
        /* 静态局部：数据段一块存储，名字加后缀避免重名，再以原名登记到
         * 当前作用域（SC_GLOBAL 的寻址走 goff/数据符号，正是我们要的）。 */
        Declarator sd = *d;
        char *nm = arena_alloc(&A_main, 192);
        Sym *gs = NULL;
        Sym *ls = NULL;

        snprintf(nm, 192, "%s.%u", FN.name ? FN.name : "static", NSTATIC++);
        sd.name = nm;
        sd.nlen = (u32)strlen(nm);
        gen_one_global(ty, &sd);
        gs = sym_find(nm, sd.nlen);
        if (!gs)
            return;
        ls = sym_add(d->name, d->nlen, gs->type, SC_GLOBAL);
        ls->goff = gs->goff;
        ls->val = gs->val;
        return;
    }
    if (ty_is_array(ty) && ty_array_n(ty) == 0) {
        /* `char s[] = "abc"` / `int a[] = {1,2,3}`：长度由初始化器定。
         * 花括号体先整个抓下来数一遍（`init_bound_count`），按数出来的条数
         * 开帧槽；填完再按 `INIT_COUNT` 收到真实长度。早先按 1 KB 估，
         * 元素一多就静默截断。 */
        u32 et = ty_target(ty);
        u32 esz = ty_size(et) ? ty_size(et) : 1;
        u32 capn = (1024u / esz) ? (1024u / esz) : 1;
        u32 cnt = 0;
        Tok *body = NULL;
        u32 nbody = 0;

        if (pa_is_ch('=') && pa_peek(1)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(1), "{")) {
            body = arena_alloc(&A_main, (size_t)CAP_MAX * sizeof(Tok));
            pa_advance();                  /* 吃掉 `=`，游标停到 `{` */
            nbody = body_capture(body, CAP_MAX);
            if (nbody >= CAP_MAX)
                pa_error("初始化器太大（超过 token 上限）");
            capn = CAP_BOUND;
            if (capn == 0)
                capn = 1;
        }
        s = sym_add(d->name, d->nlen, ty_array(et, capn), SC_LOCAL);
        s->slot = frame_slots_for(capn * esz);
        gen_zero_obj(ident_addr(s), capn * esz);
        if (body) {
            pa_src_push_back(body, nbody);
            gen_init_obj(ident_addr(s), ty_array(et, capn), 0);
            cnt = INIT_CNT_OK ? INIT_COUNT : capn;
            /* `int a[] = {};` 是 GNU 的 0 元素数组（sizeof 为 0） */
            s->type = ty_array(et, cnt);
            return;
        }
        if (pa_accept_ch('=')) {
            gen_init_obj(ident_addr(s), ty_array(et, capn), 0);
            cnt = INIT_CNT_OK ? INIT_COUNT : capn;
            s->type = ty_array(et, cnt);
            return;
        }
        s->type = ty_array(et, cnt ? cnt : 1);
        return;
    }
    /* 接口局部量：`Shape s = q;` 要走 {self, vt} 的转换，不能当聚合整块拷。
     * （聚合拷贝会把源的第一字段塞进 self、vt 留空，一调方法就跳野指针。） */
    if (NIFACE > 0 && ty_is_iface(ty, NULL)) {
        s = sym_add(d->name, d->nlen, ty, SC_LOCAL);
        s->slot = frame_slots_for(ty_size(ty));
        gen_zero_obj(ident_addr(s), ty_size(ty));
        if (pa_accept_ch('=')) {
            if (pa_is_ch('{')) {
                gen_init_obj(ident_addr(s), ty, 0);
            } else {
                u32 r0 = gen_assign();
                u32 vty = cur_op_ty();

                store_conv(ident_addr(s), ty, value_of(r0), vty);
            }
        }
        return;
    }
    s = sym_add(d->name, d->nlen, ty, SC_LOCAL);
    agg_disp_name(ty_is_ptr(ty) ? ty_target(ty) : ty, udiag_name, sizeof(udiag_name));
    udiag_nlen = (int)strlen(udiag_name);
    if (ty_is_agg(ty) || ty_is_array(ty)) {
        u32 sz = ty_size(ty);

        s->slot = frame_slots_for(sz);
        /* `@T a[N]` / 带托管字段的聚合局部量也是托管量：不标上的话，之后
         * `a[0] = new T` 会被当成普通指针赋值，`new` 出来的引用直接被
         * 语句末尾的临时清理放掉（踩过：托管元素数组的 foreach 测试
         * live 减到 -2）。 */
        if (d->mgd) {
            s->is_mgd = (u8)(d->mgd_kind == 1 ? 2 : 1);
            s->is_shared = d->mgd_shared;
            s->is_own = (u8)(d->mgd_kind == 2 ? 1 : 0);
        }
        gen_zero_obj(ident_addr(s), sz);
        if (pa_accept_ch('='))
            gen_init_obj(ident_addr(s), ty, 0);
    } else {
        s->slot = irfn_vreg(&FN);
        if (ty == ty_thread() && !pa_is_ch('='))
            pa_error("task/thread 声明要带初始化器，类型从初始化器推出来");
        if (pa_accept_ch('=')) {
            u32 r0 = 0;
            u32 vty = 0;
            int rmgd = 0;
            u32 r = 0;

            PA_DECL_INIT_MGD = (u8)(d->mgd ? 2 : 1);
            E_CLOSURE_LIT = 0;
            E_NEW_SEEN = 0;
            E_NEW_SHARED = 0;
            {
                Tok *i0 = pa_cur();
                int is_null = 0;

                r0 = gen_assign();
                /* 闭包对象要现开一块内存，不是常量表达式：`static`/文件作用域
                 * 的闭包只能用 `NULL` 起步（tests/errors/closure_convert.c6 的
                 * test_static / test_static_local）。 */
                if (i0 && i0->kind == TK_NUM && tok_data(i0)[0] == '0')
                    is_null = 1;
                if (i0 && i0->kind == TK_IDENT
                    && (TOK_EQ(i0, "NULL") || TOK_EQ(i0, "nullptr")))
                    is_null = 1;
                /* 初始化器开头就写 `static` / `async`：这是函数字面量的存储类
                 * / 协程修饰，字面量两样都不允许（tests/errors/fn_lit.c6）。 */
                if (i0 && i0->kind == TK_IDENT && in_c6_tu()) {
                    if (TOK_EQ(i0, "static") || TOK_EQ(i0, "extern"))
                        pa_error("a function literal cannot have a storage class");
                    else if (TOK_EQ(i0, "async"))
                        pa_error("a function literal cannot be 'async'");
                }
                if (decl_static && !is_null && in_c6_tu()
                    && (ty_is_closure(ty, NULL)
                        || (ty_is_ptr(ty) && ty_is_closure(ty_target(ty), NULL))))
                    pa_error("a closure is not a constant expression: initialize it at "
                             "run time ('NULL' is fine at file scope)");
            }
            PA_DECL_INIT_MGD = 0;
            /* `shared @T p = new T;`：对象不是原子的（`new shared T` 才是），
             * 放进 shared 槽就是自欺欺人。 */
            if (d->mgd_shared && E_NEW_SEEN && !E_NEW_SHARED && in_c6_tu())
                pa_error("a 'shared' slot needs an object with an atomic count");
            vty = cur_op_ty();
            rmgd = (PEND_LVAL && PEND_MGD);
            closure_lit_check(ty);
            r = value_of(r0);
            /* `task t = …` 的类型是从初始化器推出来的：不是 async 调用
             * 就没法当任务句柄用（tests/errors/async.c6 的 test_task_init）。 */
            if ((ty == ty_thread() || ty_is_taskh(ty)) && vty != ty
                && !ty_is_task_ptr(vty))
                pa_error("the initializer of a 'task' variable must be a call of "
                         "an 'async' function");

            /* 托管引用的来源就那么几种：`new`、另一个托管引用、`@f"…"`、
             * 空值。拿普通指针（`&n`、`Node *q`）去初始化 `@T` 等于凭空
             * 造一个引用，计数就乱了；`own @T` 只接管新引用。 */
            if (in_c6_tu() && d->mgd && d->mgd_kind != 1 && !mgd_tmp_has(r)
                && !E_WAS_CALL) {
                if (d->mgd_kind == 2 && rmgd)
                    pa_error("'own @%.*s' takes ownership: only a fresh reference ('new') "
                             "or the empty value can be stored in it",
                             udiag_nlen, udiag_name);
                else if (!rmgd && E_WAS_ADDR && ty_is_ptr(vty)
                         && !ty_is_ptr(ty_target(ty)) && ty_target(vty) == ty_target(ty))
                    pa_error("cannot assign a '%.*s *' to '@%.*s': a managed reference is "
                             "only made by 'new', by another managed reference, by '@f\"..\"' "
                             "or by the empty value", udiag_nlen, udiag_name,
                             udiag_nlen, udiag_name);
            }
            /* 反过来：`T *p = new T;` 把新引用塞进普通指针，没人释放它。 */
            if (in_c6_tu() && !d->mgd && mgd_tmp_has(r) && ty_is_ptr(ty) && !E_WAS_CALL)
                pa_error("a new reference cannot be stored in '%.*s *': it is not a "
                         "managed reference (declare it as '@T')",
                         udiag_nlen, udiag_name);
            /* 初始化也要做隐式转换：`float f = <double 字面量>` 必须真的转成
             * float，`char c = 300` 也必须截断（槽是 8 字节，不截就带着 300 走）。 */
            if (ty_is_closure(ty, NULL))
                r = clos_conv(r, vty);
            else if (vty != ty)
                r = gen_convert(r, vty, ty);
            /* 托管引用：`@T p = q` 要先加计数；`new T` 的结果本来就是个引用，
             * 所有权直接转给 p。weak 不加计数、也不在退出时释放。 */
            if (d->mgd && d->mgd_kind == 1) {
                /* 弱引用：只登记槽，不加计数、不拥有对象 */
                s->is_mgd = 2;
                irfn_push(&FN, IR_MOV, ir_ty_of(ty), (u16)s->slot, (u16)r, 0, 0, 0);
                mgd_weak(ident_addr(s), r);
                return;
            }
            if (d->mgd && d->mgd_kind != 1) {
                /* 右值是另一个托管左值（`@T q = p`）才加计数；`new T` 或者
                 * 返回 `@T` 的调用结果本身就是一份新引用，所有权直接过来。 */
                if (rmgd) {
                    if (!mgd_tmp_take(r))
                        mgd_retain(r);
                } else {
                    (void)mgd_tmp_take(r);
                }
                s->is_mgd = 1;
                s->is_shared = d->mgd_shared;
                s->is_own = (u8)(d->mgd_kind == 2 ? 1 : 0);
                mgd_defer_push(s->slot);
            }
            irfn_push(&FN, IR_MOV, ir_ty_of(ty), (u16)s->slot, (u16)r, 0, 0, 0);
            /* `task t = f(...)`：句柄管的是任务本身的生命周期，离开作用域要
             * `__c6_co_destroy()`——挂起着就让体回卷（defer/errdefer 都跑、
             * 帧里的托管引用放掉），跑完的顺手回收。tests/task_method.c6 和
             * tests/async_frame.c6 的"作用域退出 → 回卷"就靠这条。 */
            if (ty_is_taskh(ty))
                task_defer_push(s->slot);
        } else {
            irfn_push(&FN, IR_CONST, IRT_U64, (u16)s->slot, 0, 0, 0, 0);
            if (d->mgd && d->mgd_kind != 1) {
                s->is_mgd = 1;
                mgd_defer_push(s->slot);
            }
        }
    }
}

static void gen_cleanup_defer(Sym *vs, Sym *cs);

static void gen_local_decl(int need_semi)
{
    if (0)
        fprintf(stderr, "[dbgL] 声明起点 %.*s\n", (int)pa_cur()->len, tok_data(pa_cur()));
    u32 base = 0;

    if (PA_ACCEPT_IDENT("typedef")) {
        /* 块作用域的 typedef（`typedef enum { e, f } h;` 写在函数里很常见）。 */
        Declarator d2 = {0};
        u32 b2 = parse_typespec();
        u32 t2 = parse_declarator(b2, &d2);

        if (d2.name)
            sym_add(d2.name, d2.nlen, t2, SC_TYPEDEF);
        if (need_semi)
            pa_expect_ch(';');
        return;
    }
    PA_STATIC = 0;
    PA_EXTERN = 0;
    base = parse_typespec();
    {
        int base_mgd_ptr = PA_MGD_PTR;      /* `@T a, b;` 的 @ 要给每个声明符 */
        int base_mgd_kind = PA_MGD_KIND;
        /* 写在**说明符**位置上的 cleanup 属性对这条声明的每个声明符都生效：
         * `__attribute__((cleanup(f))) char a = 'o', b = 'a';` 两个都要清
         * （gcc 就是这么做的，tcc tests2/101_cleanup 的 `c: a` 靠这条）。
         * 写在声明符自己身上（`int a, b __attribute__((cleanup(f)));`）的
         * 只作用于那个声明符，所以每个声明符重新扫一遍、扫到就用扫到的。 */
        const char *base_cleanup = SAW_CLEANUP;
        u32 base_cleanup_len = SAW_CLEANUP_LEN;

        SAW_CLEANUP = NULL;
    for (;;) {
        Declarator d = {0};
        u32 ty = 0;
        const char *dc = 0;
        u32 dcl = 0;

        skip_attributes();
        PA_VLA_OK = 1;
        PA_MGD_PTR = base_mgd_ptr;
        PA_MGD_KIND = base_mgd_kind;
        ty = parse_declarator(base, &d);
        PA_VLA_OK = 0;
        gen_one_local(ty, &d);
        dc = SAW_CLEANUP ? SAW_CLEANUP : base_cleanup;
        dcl = SAW_CLEANUP ? SAW_CLEANUP_LEN : base_cleanup_len;
        SAW_CLEANUP = NULL;
        if (dc && d.name) {
            Sym *vs = sym_find(d.name, d.nlen);
            Sym *cs = sym_find(dc, dcl);

            if (vs && cs && cs->is_func)
                gen_cleanup_defer(vs, cs);
        }
        if (!pa_accept_ch(','))
            break;
    }
    if (need_semi)
        pa_expect_ch(';');
    }
}

static void gen_vla_restore(void);

static void gen_vla_loop_push(void)
{
    /* 调用点在 `NLOOP++` 之后，而循环自己的槽位是 NLOOP - 1
     * （和 break/continue 读 LOOP_BRK[NLOOP - 1] 一致）。 */
    if (NLOOP > 0 && NLOOP - 1 < PA_MAXLOOP) {
        LOOP_VLA[NLOOP - 1] = 0;
        LOOP_BODY[NLOOP - 1] = NULL;
        /* 默认：循环自己不带作用域，break 的清理边界是 LOOP_DFB + 1
         * （= 循环体的深度）。`for` 会在 init 声明外面再开一层作用域，
         * 那两处调用点随后把它改成 1。 */
        LOOP_OWN[NLOOP - 1] = 0;
        LOOP_SW[NLOOP - 1] = 0;
    }
}

/* break/continue：回到进入这个循环时的保存点 */
static void gen_vla_restore_loop(void)
{
    Scope *b = NLOOP > 0 ? LOOP_BODY[NLOOP - 1] : NULL;

    if (b && b->vla_save)
        irfn_push(&FN, IR_SETRSP, IRT_VOID, 0, (u16)b->vla_save, 0, 0, 0);
    else
        gen_vla_restore();
}

/* 跳出 VLA 作用域（break/continue/goto）前把 rsp 还原到最近的保存点。
 * 取**最内层**保存点是安全的：跳转只会往外跳，内层保存点一定在外层之内。 */
static void gen_vla_restore(void)
{
    Scope *sc = SCOPE;

    for (; sc; sc = sc->up)
        if (sc->vla_save) {
            irfn_push(&FN, IR_SETRSP, IRT_VOID, 0, (u16)sc->vla_save, 0, 0, 0);
            return;
        }
}

/* ---------- defer / errdefer ----------
 * 清理体在**注册时**就照常解析一遍（顺便算类型、分配 vreg），把这段 IR 抄进
 * 私有缓冲区再从流里撤掉；每个出口再把它们插回去。同一段体会在多条出口各出现
 * 一份，所以里面的标签 id 每次都要重新分配。 */
/* 每帧最多多少条 defer/errdefer 记录。以前是 64，`tcc tests2` 的 101_cleanup
 * 用宏展开了几万条 cleanup，直接越过上限（现象是编译不报错但跑起来崩）。
 * 4096 条 × 每条几个指针，代价是 BSS 里几十 KB。 */
#define DEFER_MAX 4096

static IrOp *DF_OPS[DEFER_MAX];
static u32 DF_CNT[DEFER_MAX];
static int DF_SCOPE[DEFER_MAX];
static int DF_ERR[DEFER_MAX];
/* 释放某个帧槽里此刻的值，然后把槽清零（每轮迭代收尾用：先清零再放，
 * 万一释放过程里又回到这条路径也不会重复放）。 */
static void mgd_release_slot(u32 slot)
{
    u32 a = irfn_vreg(&FN);
    u32 v = irfn_vreg(&FN);
    u32 z = irfn_vreg(&FN);

    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)a, 0, 0, 0, X64_SLOT(slot));
    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)v, (u16)a, 0, 0, 0);
    irfn_push(&FN, IR_CONST, IRT_U64, (u16)z, 0, 0, 0, 0);
    irfn_push(&FN, IR_STORE, IRT_PTR, (u16)a, (u16)z, 0, 0, 0);
    mgd_release(v);
}

/* 给某个帧槽里此刻的值加一次计数（数组元素绑定时用）。 */
static void mgd_retain_slot(u32 slot)
{
    u32 a = irfn_vreg(&FN);
    u32 v = irfn_vreg(&FN);

    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)a, 0, 0, 0, X64_SLOT(slot));
    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)v, (u16)a, 0, 0, 0);
    mgd_retain(v);
}

static int DF_MGD[DEFER_MAX];    /* 托管局部量的释放体 */
static u32 DF_MSLOT[DEFER_MAX];  /* 它释放的那个槽 */
#define MGD_NO_SLOT 0xFFFFFFFFu
static u32 DF_EXCEPT = MGD_NO_SLOT;   /* `return p` 交出去的那个槽：跳过释放 */
static int NDF;
static int DEF_DEPTH;          /* 块嵌套深度：函数体是 1 */
static int LOOP_DFB[PA_MAXLOOP];   /* 进循环时的 DEF_DEPTH */

/* `__attribute__((cleanup(fn)))`：作用域退出时调 `fn(&变量)`（和 C 的语义
 * 一致：按声明的逆序）。
 *
 * 这里**不能**学 defer 那样"登记时复制一份 IR"：tcc 的 tests2/101_cleanup.c
 * 用宏把这条声明展开了六万多遍，一条一份 IR 既费内存又越上限。所以只记
 * (槽位, 函数)，到作用域出口就地发。 */
typedef struct ClRec {
    int depth;
    u32 slot;
    u32 fnval;
    u32 fnty;
} ClRec;

#define CL_MAX 262144
static ClRec *CL_RECS;
static u32 CL_N;

static void gen_cleanup_defer(Sym *vs, Sym *cs)
{
    if (!CL_RECS) {
        CL_RECS = (ClRec *)malloc(sizeof(ClRec) * CL_MAX);
        if (CL_RECS)
            memset(CL_RECS, 0, sizeof(ClRec) * CL_MAX);
    }
    if (!CL_RECS || CL_N >= CL_MAX) {
        pa_error("cleanup 太多");
        return;
    }
    CL_RECS[CL_N].depth = DEF_DEPTH;
    CL_RECS[CL_N].slot = vs->slot;
    CL_RECS[CL_N].fnval = (u32)cs->val;
    CL_RECS[CL_N].fnty = cs->type;
    CL_N++;
}

/* 作用域出口：发出 depth >= from_scope 的那些（pop=1 时一并弹掉） */
static void cleanup_run(int from_scope, int pop)
{
    u32 i = CL_N;

    u32 av = 0;
    u32 dst = 0;
    int have = 0;

    /* 虚寄存器只有 16 位（65535 个），六万多条 cleanup 一条三个就爆了——
     * 这些序列互不重叠，两条临时槽复用到底。 */
    while (i > 0 && CL_RECS[i - 1].depth >= from_scope) {
        i--;
        if (!have) {
            av = irfn_vreg(&FN);
            dst = irfn_vreg(&FN);
            have = 1;
        }
        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)av, 0, 0, 0, X64_SLOT(CL_RECS[i].slot));
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)av, 0, 0, 0);
        irfn_push(&FN, IR_CALL, ir_ty_of(ty_target(CL_RECS[i].fnty)), (u16)dst, 0, 0, 0,
                  CL_RECS[i].fnval);
        FN.ops[FN.n - 1].narg = 1;
    }
    if (pop)
        CL_N = i;
}

static u16 defer_map_label(u16 *oldl, u16 *newl, int *nl, u16 id)
{
    int i = 0;

    for (i = 0; i < *nl; i++)
        if (oldl[i] == id)
            return newl[i];
    if (*nl >= 64)
        return id;
    oldl[*nl] = id;
    newl[*nl] = (u16)irfn_label(&FN);
    (*nl)++;
    return newl[*nl - 1];
}

static void defer_emit(int idx)
{
    u16 oldl[64] = {0};
    u16 newl[64] = {0};
    int nl = 0;
    u32 k = 0;

    for (k = 0; k < DF_CNT[idx]; k++) {
        IrOp o = DF_OPS[idx][k];
        u8 m = o.op < IRK_N ? IR_LABELS[o.op] : 0;

        if (m & IRF_A)
            o.a = defer_map_label(oldl, newl, &nl, o.a);
        if (m & IRF_B)
            o.b = defer_map_label(oldl, newl, &nl, o.b);
        if (m & IRF_C)
            o.c = defer_map_label(oldl, newl, &nl, o.c);
        irfn_push(&FN, o.op, o.type, o.dst, o.a, o.b, o.c, o.imm);
        /* narg/flags 不在 irfn_push 的参数里（IR_CALL/IR_CALLI 的实参个数就在
         * narg 上），抄的时候必须一起带过来，否则清理体里的调用变成 0 个实参。 */
        FN.ops[FN.n - 1].narg = o.narg;
        FN.ops[FN.n - 1].flags = o.flags;
    }
}

/* 托管局部量的清理体：等价于在声明处写 `defer { __c6_gc_release(p); }`。
 * 走 defer 这套的好处是 return / break / err 传播那几条路径自动带上它。 */
static void mgd_defer_push(u32 slot_v)
{
    u32 start = 0;
    u32 nops = 0;

    if (NDF >= DEFER_MAX)
        return;
    if (getenv("C6C_DBG_DF"))
        fprintf(stderr, "[df] mgd slot=%u depth=%d\n", (unsigned)slot_v, DEF_DEPTH);
    start = FN.n;
    /* 退出时要放的是**那个槽里此刻的值**，不是声明时的快照——`@Tree l =
     * new Tree; … l = NULL;` 之后，快照里还是已经被 move 走/放掉的老对象
     * （踩过：own 树测试里 gc_live 一路减到 -2）。 */
    {
        u32 sa = irfn_vreg(&FN);
        u32 sv = irfn_vreg(&FN);

        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)sa, 0, 0, 0, X64_SLOT(slot_v));
        irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)sv, (u16)sa, 0, 0, 0);
        mgd_release(sv);
    }
    nops = FN.n - start;
    DF_CNT[NDF] = nops;
    DF_OPS[NDF] = arena_alloc(&A_main, (size_t)(nops ? nops : 1) * sizeof(IrOp));
    if (nops)
        memcpy(DF_OPS[NDF], &FN.ops[start], (size_t)nops * sizeof(IrOp));
    DF_SCOPE[NDF] = DEF_DEPTH;
    DF_ERR[NDF] = 0;
    DF_MGD[NDF] = 1;
    DF_MSLOT[NDF] = slot_v;
    NDF++;
    FN.n = start;
}

/* 任务句柄的清理体：等价于 `defer { __c6_co_destroy(t); }`。
 * 和托管引用一样取**槽里此刻的值**（`t = NULL` 之后块尾就是空操作）。 */
static void task_defer_push(u32 slot_v)
{
    u32 start = 0;
    u32 nops = 0;

    if (NDF >= DEFER_MAX)
        return;
    start = FN.n;
    {
        u32 sa = irfn_vreg(&FN);
        u32 sv = irfn_vreg(&FN);
        u32 cv = irfn_vreg(&FN);

        irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)sa, 0, 0, 0, X64_SLOT(slot_v));
        irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)sv, (u16)sa, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)sv, 0, 0, 0);
        irfn_push(&FN, IR_CALL, IRT_VOID, (u16)cv, 0, 0, 0,
                  x64_sym(&X64, "__c6_co_destroy"));
        FN.ops[FN.n - 1].narg = 1;
    }
    nops = FN.n - start;
    DF_CNT[NDF] = nops;
    DF_OPS[NDF] = arena_alloc(&A_main, (size_t)(nops ? nops : 1) * sizeof(IrOp));
    if (nops)
        memcpy(DF_OPS[NDF], &FN.ops[start], (size_t)nops * sizeof(IrOp));
    DF_SCOPE[NDF] = DEF_DEPTH;
    DF_ERR[NDF] = 0;
    DF_MGD[NDF] = 0;
    DF_MSLOT[NDF] = slot_v;
    NDF++;
    FN.n = start;
}

/* 执行并弹出所有 scope >= from_scope 的清理体（逆序）。
 * on_error 为真时 errdefer 也跑（错误路径：errdefer 与 defer 一起逆序执行）。 */
static void defer_run(int from_scope, int on_error)
{
    int i = NDF;
    int was_defer = PA_IN_DEFER;

    cleanup_run(from_scope, 0);
    PA_IN_DEFER = 1;

    /* 只有**块正常结束**时才把登记表弹掉（pop=1）。return / break / continue /
     * goto 只是"从这条路径上也执行一遍"——代码发完就完了，登记表不能动，
     * 否则循环体里的 defer 第一轮之后就没有了（静态发射，运行时每轮都会跑到
     * 同一段代码）。 */
    while (i > 0 && DF_SCOPE[i - 1] >= from_scope) {
        i--;
        if (DF_MGD[i] && DF_MSLOT[i] == DF_EXCEPT)
            continue;
        if (on_error || !DF_ERR[i])
            defer_emit(i);
    }
    PA_IN_DEFER = was_defer;
}

/* 只给 gen_block 用：执行并弹出。块是**正常结束**的，所以 errdefer 一条都
 * 不该跑，而且跑完就丢掉——出了这个块以后再 `return err(...)` 不能回头把
 * 已经失效的 errdefer 翻出来执行（tests/defer_scope.c6 的第 2 条）。 */
static void defer_run_pop(int from_scope)
{
    int i = NDF;

    cleanup_run(from_scope, 1);
    while (i > 0 && DF_SCOPE[i - 1] >= from_scope) {
        i--;
        if (DF_MGD[i] && DF_MSLOT[i] == DF_EXCEPT)
            continue;
        if (!DF_ERR[i])
            defer_emit(i);
    }
    NDF = i;
}

/* c6 元组解构（只能写成语句）：
 *   `(int q, int r) = f();`   声明 + 赋值
 *   `(q, r) = f();`           给现成的左值赋值
 * 右边是一个元组值（在我们的约定里聚合值就是地址），按成员偏移逐个搬。 */
static void gen_destructure(void)
{
    u32 pat_ty[8] = {0};       /* 非 0：声明式，类型是这个 */
    u32 pat_addr[8] = {0};     /* 左值式：目标的地址 */
    u32 pat_lty[8] = {0};      /* 左值式：目标的类型 */
    const char *pat_nm[8] = {0};
    u32 pat_nl[8] = {0};
    int pat_drop[8] = {0};
    u32 n = 0;
    u32 v = 0;
    u32 vty = 0;
    u32 k = 0;

    pa_advance();                      /* '(' */
    for (;;) {
        if (n >= 8) {
            pa_error("元组解构最多 8 个元素");
            return;
        }
        if (is_typename_tok(pa_cur())) {
            /* `(int q, …)`：类型 + 名字 */
            u32 ty = parse_typespec();

            while (pa_accept_ch('*'))
                ty = ty_ptr(ty);
            if (pa_cur()->kind != TK_IDENT) {
                pa_error("解构模式里要一个名字");
                return;
            }
            pat_nm[n] = tok_data(pa_cur());
            pat_nl[n] = pa_cur()->len;
            pat_drop[n] = (pa_cur()->len == 1 && pat_nm[n][0] == '_');
            pat_ty[n] = ty;
            pa_advance();
        } else if (pa_cur()->kind == TK_IDENT && pa_cur()->len == 1
                   && tok_data(pa_cur())[0] == '_'
                   && pa_peek(1)->kind == TK_PUNCT
                   && (tok_eq(pa_peek(1), ",") || tok_eq(pa_peek(1), ")"))) {
            /* `(_, r) = f();`：`_` 表示丢掉这个元素 */
            pat_drop[n] = 1;
            pa_advance();
        } else {
            /* `(q, r)` / `(arr[0], arr[1])`：普通左值 */
            u32 lv = gen_assign();

            if (!PEND_LVAL && !(pat_drop[n] = 0)) {
                pa_error("解构目标不是左值");
                return;
            }
            pat_addr[n] = PEND_ADDR;
            pat_lty[n] = PEND_TY;
            PEND_LVAL = 0;
            (void)lv;
        }
        n++;
        if (pa_accept_ch(','))
            continue;
        pa_expect_ch(')');
        break;
    }
    pa_expect_ch('=');
    /* 所有元素都是 `_`：这个解构什么都不做（tests/errors/tuple.c6 的
     * test_all_discard）。 */
    {
        u32 nd = 0;
        u32 kd = 0;

        for (kd = 0; kd < n; kd++)
            if (pat_drop[kd])
                nd++;
        if (n > 0 && nd == n)
            pa_error("'tuple' discards every element");
    }
    v = value_of(gen_assign());
    vty = cur_op_ty();
    pa_expect_ch(';');
    if (!ty_is_agg(vty)) {
        pa_error("解构的右边不是元组");
        return;
    }
    if (ty_member_n(vty) != n) {
        pa_error("解构的元素个数和元组不一致（%u vs %u）", (unsigned)n,
                 (unsigned)ty_member_n(vty));
        return;
    }
    for (k = 0; k < n; k++) {
        u32 mty = ty_member(vty, k);
        u32 moff = ty_member_off(vty, k);
        u32 val = 0;

        if (pat_ty[k] == 0 && pat_addr[k] == 0)
            continue;                  /* `_`：丢掉 */
        val = load_lval(gen_addr_off(v, moff), mty);
        if (pat_ty[k]) {
            Sym *ls = sym_add(pat_nm[k], pat_nl[k], pat_ty[k], SC_LOCAL);

            ls->slot = frame_slots_for(ty_size(pat_ty[k]) ? ty_size(pat_ty[k]) : 8);
            store_conv(ident_addr(ls), pat_ty[k], val, mty);
        } else {
            store_conv(pat_addr[k], pat_lty[k], val, mty);
        }
    }
}

static void gen_block(void)
{
    pa_expect_ch('{');
    scope_enter();
    DEF_DEPTH++;
    if (NLOOP > 0 && NLOOP - 1 < PA_MAXLOOP && !LOOP_BODY[NLOOP - 1])
        LOOP_BODY[NLOOP - 1] = SCOPE;
    while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF)
        gen_stmt();
    defer_run_pop(DEF_DEPTH);
    DEF_DEPTH--;
    if (SCOPE && SCOPE->vla_save)
        irfn_push(&FN, IR_SETRSP, IRT_VOID, 0, (u16)SCOPE->vla_save, 0, 0, 0);
    scope_leave();
    pa_expect_ch('}');
}

static void gen_switch(void)
{
    u32 cv = 0;
    u32 ins_at = 0;
    int si = 0;
    SwState *st = NULL;
    IrOp *chain = NULL;
    u32 nchain = 0;
    u32 i = 0;
    int sw_uns = 0;

    if (NSW >= SW_MAX) {
        pa_error("switch 嵌套太深（上限 %d）", SW_MAX);
        return;
    }
    pa_expect_ch('(');
    cv = value_of(gen_expr());
    /* case 区间比较的符号性跟 switch 表达式一致：`case 10^18ULL ... 10^19ULL`
     * 用有符号的 jle 会把上界当负数，整个区间恒不匹配（踩过）。 */
    sw_uns = !ty_is_signed(GEN_TY);
    pa_expect_ch(')');
    si = NSW++;
    st = &SW[si];
    memset(st, 0, sizeof(*st));
    st->cv = cv;
    st->ins_at = FN.n;
    st->def_lbl = irfn_label(&FN);
    st->end_lbl = irfn_label(&FN);
    LOOP_BRK[NLOOP] = st->end_lbl;
    /* switch 里的 continue 要落到外层循环头上（有的话） */
    LOOP_CNT[NLOOP] = NLOOP > 0 ? LOOP_CNT[NLOOP - 1] : st->end_lbl;
    LOOP_DFB[NLOOP] = DEF_DEPTH;
    NLOOP++;
    gen_vla_loop_push();
    LOOP_SW[NLOOP - 1] = 1;       /* switch 不是循环：continue 要跳过它 */
    mv_loop_enter();
    gen_stmt();
    mv_loop_leave();
    NLOOP--;
    NSW--;
    /* 生成分发链：cmp cv, lo; br eq body / 下一条 */
    chain = arena_zalloc(&A_main, (size_t)(st->ncase * 8 + 16) * sizeof(IrOp));
    for (i = 0; i < st->ncase; i++) {
        SwCase *c = &st->cs[i];
        u32 lnext = irfn_label(&FN);
        u32 t = irfn_vreg(&FN);

        if (!c->is_range) {
            u32 cnd = irfn_vreg(&FN);
            IrOp *o = NULL;

            chain[nchain].op = IR_CONSTK;      /* case 值可能是 64 位 */
            chain[nchain].type = IRT_U64;
            chain[nchain].dst = (u16)t;
            chain[nchain].imm = irfn_kconst(&FN, c->lo);
            nchain++;
            o = &chain[nchain];
            o->op = IR_CMP;
            o->type = IRT_U64;
            o->dst = (u16)cnd;
            o->a = (u16)cv;
            o->b = (u16)t;
            o->flags = IRCC_EQ;    /* CMP 的条件码放在 flags 里（不是 imm） */
            nchain++;
            o = &chain[nchain];
            o->op = IR_BR;
            o->a = (u16)cnd;
            o->b = (u16)c->lbl;
            o->c = (u16)lnext;
            nchain++;
        } else {
            u32 lchk = irfn_label(&FN);
            u32 c1 = irfn_vreg(&FN);
            u32 t2 = irfn_vreg(&FN);
            u32 c2 = irfn_vreg(&FN);
            IrOp *o = NULL;

            chain[nchain].op = IR_CONSTK;      /* case 值可能是 64 位 */
            chain[nchain].type = IRT_U64;
            chain[nchain].dst = (u16)t;
            chain[nchain].imm = irfn_kconst(&FN, c->lo);
            nchain++;
            o = &chain[nchain];
            o->op = IR_CMP;
            o->type = IRT_U64;
            o->dst = (u16)c1;
            o->a = (u16)cv;
            o->b = (u16)t;
            o->flags = sw_uns ? IRCC_UGE : IRCC_GE;
            nchain++;
            o = &chain[nchain];
            o->op = IR_BR;
            o->a = (u16)c1;
            o->b = (u16)lchk;
            o->c = (u16)lnext;
            nchain++;
            chain[nchain].op = IR_LABEL;
            chain[nchain].a = (u16)lchk;
            nchain++;
            chain[nchain].op = IR_CONSTK;      /* case 值可能是 64 位 */
            chain[nchain].type = IRT_U64;
            chain[nchain].dst = (u16)t2;
            chain[nchain].imm = irfn_kconst(&FN, c->hi);
            nchain++;
            o = &chain[nchain];
            o->op = IR_CMP;
            o->type = IRT_U64;
            o->dst = (u16)c2;
            o->a = (u16)cv;
            o->b = (u16)t2;
            o->flags = sw_uns ? IRCC_ULE : IRCC_LE;
            nchain++;
            o = &chain[nchain];
            o->op = IR_BR;
            o->a = (u16)c2;
            o->b = (u16)c->lbl;
            o->c = (u16)lnext;
            nchain++;
        }
        chain[nchain].op = IR_LABEL;
        chain[nchain].a = (u16)lnext;
        nchain++;
    }
    /* 都不匹配 → default（没有 default 就跳到末尾） */
    chain[nchain].op = IR_JMP;
    chain[nchain].a = (u16)(st->has_def ? st->def_lbl : st->end_lbl);
    nchain++;
    irfn_insert(&FN, st->ins_at, chain, nchain);
    if (!st->has_def)
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)st->def_lbl, 0, 0, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)st->end_lbl, 0, 0, 0);
}

/* 名字标号：goto 与 label 用同一张表，先到先得（前向 goto 也成立） */
#define GOTO_MAX 192
static const char *GLBL_NAME[GOTO_MAX];
static u32 GLBL_LEN[GOTO_MAX];
static u32 GLBL_ID[GOTO_MAX];
static int GLBL_DEPTH[GOTO_MAX];   /* 标号所在块深度（goto 按它决定跑哪些清理） */
static int GLBL_DEF[GOTO_MAX];     /* 标号已经定义过了（前向 goto 还不知道深度） */
static u32 NGLBL;

static u32 goto_label(const char *nm, u32 len)
{
    u32 i = 0;

    for (i = 0; i < NGLBL; i++)
        if (GLBL_LEN[i] == len && memcmp(GLBL_NAME[i], nm, len) == 0)
            return GLBL_ID[i];
    if (NGLBL >= GOTO_MAX) {
        pa_error("标号太多（上限 %d）", GOTO_MAX);
        return 0;
    }
    GLBL_NAME[NGLBL] = nm;
    GLBL_LEN[NGLBL] = len;
    GLBL_ID[NGLBL] = irfn_label(&FN);
    GLBL_DEPTH[NGLBL] = DEF_DEPTH;
    GLBL_DEF[NGLBL] = 0;
    return GLBL_ID[NGLBL++];
}

/* ---- 内联汇编（模板在 asmx.c6 里翻，这边只负责取文本和操作数）---------- */

/* asm 模板最多这么长（含转义解码后的字节）。模板都是小片段，超了就是
 * 我们不打算支持的大块汇编，宁可整体跳过。 */
#define ASM_TPL_MAX 8192
/* 操作数（%0/%1…）最多几个：寄存器只留 r10/r11/r8/r9/rsi/rdi 六个中转，
 * 再多就得考虑压栈，不值得 */
#define ASM_OPMAX 6

static const char *const ASM_REG64[ASM_OPMAX] = {
    "%r10", "%r11", "%r8", "%r9", "%rsi", "%rdi"
};
static const char *const ASM_REG32[ASM_OPMAX] = {
    "%r10d", "%r11d", "%r8d", "%r9d", "%esi", "%edi"
};
static const int ASM_REGNUM[ASM_OPMAX] = { 10, 11, 8, 9, 6, 7 };

/* 把一串相邻的字符串字面量拼成一段**解码后**的文本（asm 模板）。
 * 必须解码：`"cmp $0, %1\n\t"` 里的 \n 是换行，不解码整段就成了一个操作数
 * 里带反斜杠的行，翻不出来。 */
static const char *asm_concat_str(u32 *outlen)
{
    char *buf = arena_alloc(&A_main, ASM_TPL_MAX);
    u32 n = 0;

    *outlen = 0;
    while (pa_cur()->kind == TK_STR) {
        Tok *t = pa_cur();
        const char *s = tok_data(t);
        u32 i = 0;

        while (i < t->len && s[i] != '"')
            i++;                        /* 跳过 L/u/U/u8 前缀 */
        i++;
        while (i + 1 < t->len) {        /* 末尾那个是收尾的引号 */
            u32 ch = 0;

            if (s[i] == '\\') {
                const char *p = s + i + 1;

                ch = esc_decode(&p, s + t->len);
                i = (u32)(p - s);
            } else {
                ch = (u32)(u8)s[i];
                i++;
            }
            if (n + 8 >= ASM_TPL_MAX)
                return NULL;
            /* 汇编模板只可能是 ASCII；非 ASCII 截成低字节（翻不动会整体跳过） */
            buf[n++] = (char)(ch & 0xFF);
        }
        pa_advance();
    }
    buf[n] = 0;
    *outlen = n;
    return buf;
}

/* 把 `%0/%1…` 换成对应的寄存器名或地址表达式，`%%` 换成一个 `%`。
 * `%l[name]` 原样留着——asmx.c6 认得出它是 asm goto 的标号。 */
static const char *asm_subst(const char *tpl, u32 tlen, char **otext, u32 nop,
                            u32 *outlen)
{
    char *buf = arena_alloc(&A_main, ASM_TPL_MAX);
    u32 n = 0;
    u32 i = 0;

    *outlen = 0;
    while (i < tlen) {
        char c = tpl[i];

        if (c == '%' && i + 1 < tlen) {
            char d = tpl[i + 1];

            if (d == '%') {
                buf[n++] = '%';
                i += 2;
                continue;
            }
            if (d >= '0' && d <= '9') {
                u32 k = (u32)(d - '0');

                if (k < nop && otext[k]) {
                    const char *s = otext[k];

                    while (*s) {
                        if (n + 8 >= ASM_TPL_MAX)
                            return NULL;
                        buf[n++] = *s++;
                    }
                    i += 2;
                    continue;
                }
            }
        }
        if (n + 8 >= ASM_TPL_MAX)
            return NULL;
        buf[n++] = c;
        i++;
    }
    buf[n] = 0;
    *outlen = n;
    return buf;
}

/* `(%r10)` 这种地址表达式（内存操作数的替换文本）*/
static const char *asm_mem_text(u32 k)
{
    char buf[32] = {0};

    snprintf(buf, sizeof(buf), "(%s)", ASM_REG64[k]);
    return arena_strdup(&A_main, buf);
}

/* 操作数解析中途失败时，已经吃进肚子里、还没配上对的 '(' 的个数。
 * asm_skip_group 要靠它把括号数算平（`"S"(sym)` 失败时我们已经吃掉了
 * 操作数自己的 '('，此时剩下的配对 ')' 数是 2 而不是 1）。 */
static u32 ASM_UNBAL;

/* 一个操作数：`"约束"(表达式)`。成功返回 1，并且把绑定/替换文本填好。
 * 只支持内存操作数（`m`）和只读寄存器操作数（`r`）：
 *   - `m`：把表达式的**地址**装进中转寄存器，模板里的 %N 换成 `(%r10)`；
 *   - `r`：把值装进中转寄存器，%N 换成 `%r10`（32 位类型换 `%r10d`，
 *     这样 `cmp $0, %1` 比的是低 32 位的符号，跟 int 语义一致）；
 *   - 输出寄存器（`=r`/`+r`）要写回左值，得再做一次"寄存器→内存"的间接
 *     存储，后端没有这条 IR，先当不支持（整条 asm 跳过，保持老行为）。 */
static int asm_one_operand(AxBind *binds, u32 *nbinds, char **otext)
{
    u32 k = 0;
    int mem = 0;
    int iso = 0;
    int isreg = 0;
    int isread = 1;
    const char *cs = NULL;
    u32 cl = 0;

    if (pa_cur()->kind != TK_STR)
        return 0;
    cs = tok_data(pa_cur());
    cl = pa_cur()->len;
    for (k = 0; k < cl; k++) {
        if (cs[k] == '=')
            iso = 1;
        else if (cs[k] == '+' || cs[k] == '&') {
            iso = 1;
            isread = 1;
        } else if (cs[k] == 'm')
            mem = 1;
        else if (cs[k] == 'r')
            isreg = 1;
        else if (cs[k] == 'i' || cs[k] == 'n' || cs[k] == 'g')
            return 0;               /* 立即数/通用约束：不支持 */
    }
    if (iso && isreg)
        return 0;
    if (iso && !mem)
        return 0;
    pa_advance();
    if (!pa_is_ch('('))
        return 0;
    pa_advance();
    ASM_UNBAL++;
    if (mem) {
        u32 a = 0;

        /* 内存操作数要的是**地址**：gen_expr 走完如果是左值，PEND_ADDR 就是
         * 它的地址（和一元 `&` 用同一套）。 */
        (void)gen_expr();
        if (!PEND_LVAL)
            return 0;
        a = PEND_ADDR;
        PEND_LVAL = 0;
        if (*nbinds >= ASM_OPMAX)
            return 0;
        binds[*nbinds].disp = X64_SLOT(a);
        binds[*nbinds].reg = ASM_REGNUM[*nbinds];
        binds[*nbinds].store = 0;
        otext[*nbinds] = (char *)asm_mem_text(*nbinds);
        (*nbinds)++;
    } else if (isreg) {
        u32 v = 0;

        v = value_of(gen_expr());
        if (*nbinds >= ASM_OPMAX)
            return 0;
        binds[*nbinds].disp = X64_SLOT(v);
        binds[*nbinds].reg = ASM_REGNUM[*nbinds];
        binds[*nbinds].store = 0;
        if (ty_size(GEN_TY) <= 4)
            otext[*nbinds] = (char *)ASM_REG32[*nbinds];
        else
            otext[*nbinds] = (char *)ASM_REG64[*nbinds];
        (*nbinds)++;
    } else {
        return 0;
    }
    if (!pa_accept_ch(')'))
        return 0;
    ASM_UNBAL--;
    (void)isread;
    return 1;
}

/* `"=m"(a), "r"(b)` 这样的一串操作数 */
static int asm_operand_list(AxBind *binds, u32 *nbinds, char **otext)
{
    if (pa_cur()->kind != TK_STR)
        return 1;                   /* 空段 */
    for (;;) {
        if (!asm_one_operand(binds, nbinds, otext))
            return 0;
        if (!pa_accept_ch(','))
            break;
    }
    return 1;
}

/* clobber 段（`"memory"`、`"cc"`、`"rax"`…）：后端把所有值都放帧槽，寄存器
 * 全是临时，没有需要保护的活值，整段跳过即可。 */
static void asm_skip_clobbers(void)
{
    while (pa_cur()->kind == TK_STR) {
        pa_advance();
        if (!pa_accept_ch(','))
            break;
    }
}

/* asm goto 的标号列表：`smaller, larger` */
static void asm_label_list(AxGoto *gt, u32 *ngt)
{
    while (pa_cur()->kind == TK_IDENT) {
        u32 l = goto_label(tok_data(pa_cur()), pa_cur()->len);

        if (*ngt < AX_MAXGOTO) {
            gt[*ngt].name = arena_strndup(&A_main, tok_data(pa_cur()), pa_cur()->len);
            gt[*ngt].id = l;
            (*ngt)++;
        }
        pa_advance();
        if (!pa_accept_ch(','))
            break;
    }
}

/* 翻不动时把整组 `asm(...)` 的 token 吞干净：从外层 '(' 之后一直跳到配对的
 * ')'。不能指望 skip_paren_group —— 失败点可能停在操作数**中间**（`"S"(sym)`
 * 里的 sym、`"=r"(x)` 里的 x），那时候当前位置不是 '('，skip_paren_group 吞
 * 不到配对的 ')'，剩下的 `)` 就变成"这里要 ';'"。138/140 那批 arm64 用例
 * 本来靠"静默丢弃"过的，一露这个错就编不过了。 */
static void asm_skip_group(void)
{
    u32 depth = 1 + ASM_UNBAL;

    ASM_UNBAL = 0;

    while (pa_cur()->kind != TK_EOF) {
        if (pa_is_ch('(')) {
            depth++;
        } else if (pa_is_ch(')')) {
            depth--;
            if (!depth) {
                pa_advance();
                return;
            }
        }
        pa_advance();
    }
}

/* asm [volatile] [goto] ( 模板 : 输出 : 输入 : clobber : 标号 ) ;
 * 翻得动就发一条 IR_COMMENT 标记（出码时把预算好的机器码插进去），
 * 翻不动就只把 token 吃掉——和以前的"静默丢弃"完全一样，不会把原本能
 * 编过的用例变成编不过。 */
static int try_stmt_asm(void)
{
    const char *tpl = NULL;
    const char *txt = NULL;
    u32 tlen = 0;
    u32 xlen = 0;
    u32 idx = 0;
    AxBind binds[ASM_OPMAX] = {0};
    u32 nbinds = 0;
    AxGoto gts[AX_MAXGOTO] = {0};
    u32 ngts = 0;
    char *otext[ASM_OPMAX] = {0};
    int ok = 1;
    int isn = 0;

    if (!(PA_IS_IDENT("asm") || PA_IS_IDENT("__asm") || PA_IS_IDENT("__asm__")))
        return 0;
    pa_advance();
    while (PA_IS_IDENT("volatile") || PA_IS_IDENT("__volatile__")
           || PA_IS_IDENT("__volatile") || PA_IS_IDENT("inline")
           || PA_IS_IDENT("__inline__") || PA_IS_IDENT("goto")) {
        if (PA_IS_IDENT("goto"))
            isn = 1;
        pa_advance();
    }
    if (!pa_is_ch('(')) {
        while (!pa_is_ch(';') && pa_cur()->kind != TK_EOF)
            pa_advance();
        if (pa_is_ch(';'))
            pa_advance();
        return 1;
    }
    pa_advance();
    if (pa_cur()->kind == TK_STR) {
        tpl = asm_concat_str(&tlen);
        if (!tpl)
            ok = 0;
    } else {
        ok = 0;
    }
    /* 输出段 / 输入段 / clobber 段 / 标号段（后面几段都可以没有） */
    if (ok && pa_accept_ch(':')) {
        ok = asm_operand_list(binds, &nbinds, otext);
        if (ok && pa_accept_ch(':')) {
            ok = asm_operand_list(binds, &nbinds, otext);
            if (ok && pa_accept_ch(':')) {
                asm_skip_clobbers();
                if (pa_accept_ch(':') && isn)
                    asm_label_list(gts, &ngts);
            }
        }
    }
    if (!ok || !tpl) {
        asm_skip_group();
        if (pa_is_ch(';'))
            pa_advance();
        return 1;
    }
    if (pa_is_ch(')'))
        pa_advance();
    else
        asm_skip_group();
    if (pa_is_ch(';'))
        pa_advance();
    txt = asm_subst(tpl, tlen, otext, nbinds, &xlen);
    if (!txt)
        return 1;
    if (!asmx_piece(txt, xlen, binds, nbinds, gts, ngts, &idx))
        return 1;
    irfn_push(&FN, IR_COMMENT, IRT_VOID, 0, 0, 0, 0, AX_MARK | idx);
    return 1;
}

/* 文件作用域 asm：`asm(".globl vide\nvide: …")` —— 上游用例就是靠它定义
 * 符号（85/98/120）。翻译出来立刻放进代码镜像：这时候没有别的函数正在发，
 * 落点正好就是"这条声明所在的位置"，标签符号也能马上登记，后面 main 里
 * 调 vide() 时符号已经有定义了。 */
static int try_toplevel_asm(void)
{
    const char *tpl = NULL;
    u32 tlen = 0;
    u32 idx = 0;

    if (!(PA_IS_IDENT("asm") || PA_IS_IDENT("__asm") || PA_IS_IDENT("__asm__")))
        return 0;
    pa_advance();
    while (PA_IS_IDENT("volatile") || PA_IS_IDENT("__volatile__")
           || PA_IS_IDENT("__volatile") || PA_IS_IDENT("inline")
           || PA_IS_IDENT("__inline__")) {
        pa_advance();
    }
    if (!pa_is_ch('(')) {
        while (!pa_is_ch(';') && pa_cur()->kind != TK_EOF)
            pa_advance();
        if (pa_is_ch(';'))
            pa_advance();
        return 1;
    }
    pa_advance();
    if (pa_cur()->kind == TK_STR)
        tpl = asm_concat_str(&tlen);
    /* 文件作用域上不该有操作数；有多余的东西就整组跳掉，别乱吃 token */
    if (pa_is_ch(')'))
        pa_advance();
    else
        asm_skip_group();
    if (pa_is_ch(';'))
        pa_advance();
    if (tpl && tlen && asmx_piece(tpl, tlen, NULL, 0, NULL, 0, &idx))
        (void)asmx_flush(&X64, idx);
    return 1;
}

/* 预处理注入的 `__c6_pack(N);`：`#pragma pack` 的生效点。
 * 预处理整趟跑完才轮到语法分析，所以 pack 必须跟着 token 流走。 */
static int try_pack_directive(void)
{
    long v = 0;

    if (!PACK_SEEN || !PA_IS_IDENT("__c6_pack"))
        return 0;
    pa_advance();
    pa_expect_ch('(');
    if (pa_cur()->kind == TK_NUM) {
        char nb[24] = {0};
        u32 k = pa_cur()->len < 20 ? pa_cur()->len : 20;

        memcpy(nb, tok_data(pa_cur()), k);
        nb[k] = 0;
        v = strtol(nb, NULL, 0);
        pa_advance();
    }
    pa_expect_ch(')');
    pa_accept_ch(';');
    TY_PACK = (int)v;
    return 1;
}

/* 接口值（布局 `{self, vt}`，地址 addr）上调用第 mi 个方法：`vt[mi](self, …)`。
 * args 不含 self，返回结果的 vreg。foreach 的接口迭代器要用。 */
static u32 gen_iface_call(u32 addr, u32 mi, u32 ret_ty, u32 *args, u32 nargs)
{
    u32 selfv = irfn_vreg(&FN);
    u32 vt8 = gen_addr_off(addr, 8);
    u32 vtv = irfn_vreg(&FN);
    u32 fnv = irfn_vreg(&FN);
    u32 dst = irfn_vreg(&FN);
    u32 k = 0;

    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)selfv, (u16)addr, 0, 0, 0);
    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)vtv, (u16)vt8, 0, 0, 0);
    irfn_push(&FN, IR_LEA, IRT_PTR, (u16)fnv, (u16)vtv, 0, 0, mi * 8);
    irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)fnv, (u16)fnv, 0, 0, 0);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)selfv, 0, 0, 0);
    for (k = 0; k < nargs; k++)
        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)args[k], 0, 0, k + 1);
    irfn_push(&FN, IR_CALLI, ir_ty_of(ret_ty), (u16)dst, (u16)fnv, 0, 0, 0);
    FN.ops[FN.n - 1].narg = (u8)(nargs + 1);
    return dst;
}

/* 接口里叫 nm 的方法排第几？没有就 0xFFFFFFFF。 */
static u32 iface_slot(u32 ifx, const char *nm, u32 nl)
{
    u32 k = 0;

    if (ifx >= IFACE_MAX)
        return 0xFFFFFFFFu;
    for (k = 0; k < IFACE_NM[ifx]; k++)
        if (IFACE_MLEN[ifx][k] == nl && memcmp(IFACE_MET[ifx][k], nm, nl) == 0)
            return k;
    return 0xFFFFFFFFu;
}

static void gen_stmt(void)
{
    /* 进新语句了：上一个 `return` 的操作数已经编完 */
    PA_RET_EXPR = 0;
    PA_LAST_TERM = 0;
    E_CLOSURE_LIT = 0;
    /* 上一条语句留下的临时托管引用（`int v = take(new T);` 这种没走
     * 表达式语句收尾的路径）在这里补一次释放。 */
    if (NMGD_TMP)
        mgd_tmp_flush();
    /* `PEND_MGD` 也是"上一条语句"的状态：上一条读过托管引用，这条
     * `return -1;` 就会被当成"交出一个引用"而去 retain(-1)（踩过：
     * gc_async 里 `if (__c6_gc_refcount(n) != 2) return -1;` 直接崩）。 */
    PEND_MGD = 0;
    PEND_MGD_SYM = NULL;
    /* c6 角色宏：语句位置上的 `stmt` / `type` / `expr` 宏。展开是把 token
     * 压回 SRC 栈重放，所以这里再进一次 gen_stmt 就是"解析展开结果"。 */
    if (NCM > 0 && CM_STMT_DEPTH < 64 && cm_at_call(-1)) {
        int role = cm_at_call(-1)->role;

        if (role == CM_ROLE_STMT || role == CM_ROLE_TYPE || role == CM_ROLE_EXPR) {
            CM_STMT_DEPTH++;
            (void)cm_expand(role);
            gen_stmt();
            CM_STMT_DEPTH--;
            return;
        }
    }
    /* asm 要在 skip_attributes 之前认：`asm` 也在 SA_KW 里，先跑属性扫描会把
     * 它当成属性关键字默默吃掉，后面只剩 `goto (...)`，报"goto 后面要标号名"
     * （tcc tests2 的 127_asm_goto 就是这么挂的）。 */
    if (try_stmt_asm())
        return;
    skip_attributes();
    if (try_pack_directive())
        return;
    /* `defer stmt;` / `errdefer stmt;`：先把语句体解析一遍，把这段 IR 抄走，
     * 再从流里撤掉；出口处由 defer_run() 插回去。软关键字——后面不是
     * `= ; ( . , )` 才算。 */
    {
        int is_def = (c6_kw() && (PA_IS_IDENT("defer") || PA_IS_IDENT("errdefer")));
        int bad = 0;

        if (is_def && pa_peek(1)->kind == TK_PUNCT) {
            Tok *p1 = pa_peek(1);

            if (TOK_EQ(p1, "=") || TOK_EQ(p1, ";") || TOK_EQ(p1, ".")
                || tok_eq(p1, ",") || tok_eq(p1, ")") || TOK_EQ(p1, "["))
                bad = 1;
            if (tok_eq(p1, "(")) {
                /* `defer (…);` 是调用；`defer (a, b) = f();` 是元组解构 */
                Tok *p2 = pa_peek(2);
                Tok *p3 = pa_peek(3);

                if (!(p2->kind == TK_IDENT && p3->kind == TK_PUNCT
                      && (tok_eq(p3, ",") || tok_eq(p3, ")"))))
                    bad = 1;
            }
        }
        if (is_def && !bad) {
        int is_err = PA_IS_IDENT("errdefer");
        u32 start = 0;
        u32 nops = 0;

        pa_advance();
        /* 上游口径：一个函数最多 128 个清理点（tests/errors/defer.c6）。
         * 数的是**静态**的 defer 站点，不是登记表里当下有多少条——块作用域
         * 的 defer 每出一个块就被弹掉，光看 NDF 永远超不过 1。 */
        if (PA_DEFER_SITES++ >= 128) {
            pa_error("a function cannot have more than 128 cleanup sites");
            return;
        }
        if (NDF >= DEFER_MAX) {
            pa_error("defer/errdefer 太多（上限 %d）", DEFER_MAX);
            return;
        }
        if (PA_DEFER_DEPTH >= 8) {
            /* 8 层是允许的，第 9 层报 */
            pa_error("'defer' bodies nested too deeply");
            return;
        }
        start = FN.n;
        {
            int was = PA_IN_DEFER;

            PA_IN_DEFER = 1;
            PA_DEFER_DEPTH++;
            mv_push();
            gen_stmt();
            mv_restore();       /* defer 体单独分析：里面的 move 不漏到下面 */
            mv_pop();
            PA_DEFER_DEPTH--;
            PA_IN_DEFER = was;
        }
        nops = FN.n - start;
        DF_CNT[NDF] = nops;
        DF_OPS[NDF] = arena_alloc(&A_main, (size_t)(nops ? nops : 1) * sizeof(IrOp));
        if (nops)
            memcpy(DF_OPS[NDF], &FN.ops[start], (size_t)nops * sizeof(IrOp));
        DF_SCOPE[NDF] = DEF_DEPTH;
        DF_ERR[NDF] = is_err;
        NDF++;
        FN.n = start;               /* 从主流里撤掉 */
        return;
        }
    }
    if (PA_ACCEPT_IDENT("goto")) {
        if (PA_IN_DEFER)
            pa_error("'goto' is not allowed in a defer body");
        PA_LAST_TERM = 1;
        if (pa_is_ch('*')) {
            /* GNU 计算 goto：`goto *expr;` */
            u32 v = 0;

            pa_advance();
            v = value_of(gen_expr());
            pa_expect_ch(';');
            gen_vla_restore();
            irfn_push(&FN, IR_JMPIND, IRT_VOID, 0, (u16)v, 0, 0, 0);
            return;
        }
        if (pa_cur()->kind == TK_IDENT) {
            u32 l = goto_label(tok_data(pa_cur()), pa_cur()->len);
            int gi = 0;
            int ld = 0;

            pa_advance();
            pa_expect_ch(';');
            /* 前向 goto 这时还不知道标号在多深（按老规矩全跑一遍）；
             * 向后 goto 标号已经定义过，深度是准的。 */
            int fwd = 1;

            for (gi = 0; gi < NGLBL; gi++)
                if (GLBL_ID[gi] == l && GLBL_DEF[gi]) {
                    ld = GLBL_DEPTH[gi];
                    fwd = 0;
                }
            /* 变长数组的栈空间只在**回边**上回收（向后 goto = 自己搭的循环，
             * 不回收就一圈一圈往下叠）。前向 goto 不能回收：`goto end;` 后面
             * 还要用刚才那块 VLA（`end:` 和声明在同一个块里，按 C 的规矩它
             * 还活着），一回收就会和后面调用者的栈帧重叠——tcc tests1 的
             * vla_test.c 第二个用例正是这么踩的（memset 把调用者的返回地址
             * 抹成 0，ret 直接蹦到野地址）。 */
            if (!fwd)
                gen_vla_restore();
            /* 只跑**比标号更深**的作用域的清理：同一个作用域里 `again:` 之后
             * 注册的 defer，跳回 `again:` 时还活着，不能重复执行
             * （tests/defer_scope.c6 的"重复注册只跑一次"）。 */
            defer_run(ld > 0 ? ld + 1 : 1, 0);
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)l, 0, 0, 0);
        } else {
            pa_error("goto 后面要标号名或 '*' 表达式");
            while (!pa_is_ch(';') && pa_cur()->kind != TK_EOF)
                pa_advance();
            if (pa_is_ch(';'))
                pa_advance();
        }
        return;
    }
    if (PA_ACCEPT_IDENT("_Static_assert") || PA_ACCEPT_IDENT("static_assert")) {
        parse_static_assert_rest();
        return;
    }
    /* `co f(args);`：起一个游离任务（不等它）。c6c 的任务都是同步跑完的，
     * 所以这里就是"调一次、丢掉返回值"。软关键字：只有后面跟
     * `标识符 (` 时才算，`co = 1;` / `co(x)` 之类照旧。 */
    if (PA_IS_IDENT("co") && c6_kw() && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
        && pa_peek(2) && pa_peek(2)->kind == TK_PUNCT && tok_eq(pa_peek(2), "(")) {
        pa_advance();
        {
            u32 cv = 0;
            u32 dv = irfn_vreg(&FN);

            PA_CO_STMT = 1;
            cv = value_of(gen_expr());
            PA_CO_STMT = 0;
            if (GEN_TY != ty_thread() && !ty_is_task_ptr(GEN_TY))
                pa_error("'co' 的操作数必须是一次 async 调用");
            (void)cv;
            /* `co` 没有句柄：跑完由调度侧（__c6_co_run）自动回收并计失败 */
            irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)cv, 0, 0, 0);
            irfn_push(&FN, IR_CALL, IRT_VOID, (u16)dv, 0, 0, 0,
                      x64_sym(&X64, "__c6_co_detach"));
            FN.ops[FN.n - 1].narg = 1;
        }
        pa_expect_ch(';');
        return;
    }
    /* 名字标号：IDENT ':' */
    if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ":")
        && !PA_IS_IDENT("default")) {
        u32 l = goto_label(tok_data(pa_cur()), pa_cur()->len);
        int gi = 0;

        pa_advance();
        pa_advance();
        for (gi = 0; gi < NGLBL; gi++)
            if (GLBL_ID[gi] == l) {
                GLBL_DEPTH[gi] = DEF_DEPTH;
                GLBL_DEF[gi] = 1;
            }
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)l, 0, 0, 0);
        /* 标号后面**必须**接着生成被标号的那条语句。原来这里直接 return，
         * 于是 `if (c) lab: stmt;` 里的 stmt 会被当成 if 之后的**另一条语句**，
         * 条件为假时照样执行——tcc 里 `if (t0 == TOK_PPJOIN) bad_twosharp: …`
         * 就是靠这个把每一条 #define 都判成错的。C 里标号后面一定跟语句，
         * 只有 `lab: }`（C23）这种才没有。 */
        if (!pa_is_ch('}'))
            gen_stmt();
        return;
    }
    if (PA_ACCEPT_IDENT("case")) {
        i64 lo = 0;
        i64 hi = 0;
        int is_range = 0;
        u32 lbl = 0;

        lo = const_expr();
        hi = lo;
        if (pa_accept_punct("...")) {
            hi = const_expr();
            is_range = 1;
        }
        pa_expect_ch(':');
        lbl = irfn_label(&FN);
        if (NSW > 0 && SW[NSW - 1].ncase < SW_MAXCASE) {
            SwCase *c = &SW[NSW - 1].cs[SW[NSW - 1].ncase++];

            c->lo = lo;
            c->hi = hi;
            c->lbl = lbl;
            c->is_range = (u8)is_range;
        } else {
            pa_error("case 只能出现在 switch 里");
        }
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lbl, 0, 0, 0);
        /* 和名字标号同一条规矩：`case N:` 后面那条语句是**被标号**的语句，
         * 必须在这儿一起生成。`switch (x) case 1: return 1;` 这种不带花括号的
         * switch 以前就把 `return 1;` 漏在了 switch 外面——x 不是 1 也照跑
         * （c-testsuite single-exec/00051）。 */
        if (!pa_is_ch('}'))
            gen_stmt();
        return;
    }
    if (PA_ACCEPT_IDENT("default")) {
        pa_expect_ch(':');
        if (NSW > 0) {
            SW[NSW - 1].has_def = 1;
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)SW[NSW - 1].def_lbl, 0, 0, 0);
        } else {
            pa_error("default 只能出现在 switch 里");
        }
        if (!pa_is_ch('}'))
            gen_stmt();
        return;
    }
    if (PA_ACCEPT_IDENT("switch")) {
        gen_switch();
        return;
    }
    if (pa_is_ch('{')) {
        gen_block();
        return;
    }
    if (pa_accept_ch(';'))
        return;
    if (PA_ACCEPT_IDENT("return")) {
        if (PA_IN_DEFER)
            pa_error("'return' is not allowed in a defer body");
        PA_RET_EXPR = 1;
        PA_LAST_TERM = 1;
        u32 v = 0;
        int on_err = 0;

        /* `return err(...)` 是错误路径：errdefer 也要跑。其余正常路径只跑 defer。 */
        if (PA_IS_IDENT("err") && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "("))
            on_err = 1;
        if (pa_is_ch(';')) {
            pa_advance();
            if (CUR_TASK_TY) {
                /* `async void f()`：`return;` 也得把任务结构交出去——
                 * 否则调用方拿到 NULL，`await` 去读 t->val 就崩（踩过）。 */
                u32 tsk2 = task_get();

                task_seal(tsk2);
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, IRT_PTR, 0, (u16)tsk2, 0, 0, 0);
                return;
            }
            defer_run(1, on_err);
            irfn_push(&FN, IR_RET, IRT_VOID, 0, 0, 0, 0, 0);
            return;
        }
        /* `return {a, b};`：按返回类型就地初始化一个临时聚合，返回它的地址
         * （元组/struct 的按值返回本来就走"地址"这条约定）。 */
        if (pa_is_ch('{') && ty_is_agg(CUR_TASK_TY ? CUR_TASK_VAL : CUR_RET_TY)) {
            u32 aty = CUR_TASK_TY ? CUR_TASK_VAL : CUR_RET_TY;
            u32 sz = ty_size(aty);
            u32 slot = frame_slots_for(sz ? sz : 8);
            u32 addr = irfn_vreg(&FN);

            irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)addr, 0, 0, 0, X64_SLOT(slot));
            gen_init_obj(addr, aty, 0);
            pa_expect_ch(';');
            if (CUR_TASK_TY) {
                /* async：值放进任务结构的 val（偏移 0），返回任务指针 */
                u32 tsk = task_get();
                {
                    u32 voff = task_val_off();
                    u32 dst2 = tsk;

                    if (voff) {
                        dst2 = irfn_vreg(&FN);
                        irfn_push(&FN, IR_LEA, IRT_PTR, (u16)dst2, (u16)tsk, 0, 0, voff);
                    }
                    irfn_push(&FN, IR_COPY, IRT_U8, (u16)dst2, (u16)addr, 0, 0,
                              sz ? sz : 8);
                }
                task_seal(tsk);
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, IRT_PTR, 0, (u16)tsk, 0, 0, 0);
            } else {
                defer_run(1, on_err);
                irfn_push(&FN, IR_RET, ir_ty_of(CUR_RET_TY), 0, (u16)addr, 0, 0, 0);
            }
            return;
        }
        v = gen_expr();
        if (E_WEAK && in_c6_tu())
            pa_error("a weak reference cannot be returned: upgrade it first "
                     "('@T q = w;')");
        {
            u32 rty = cur_op_ty();

            /* `return p`：引用交给调用者，这个局部量的释放体要跳过。
             * `return new T` 同理——所有权跟着返回值走。
             * 借来的（字段、形参）不是自己的，得先加一次计数再交出去。
             * 判据是**返回值的类型**是（托管）指针，不是 PEND_MGD——后者可能
             * 是表达式里最后一个实参留下的（`return __c6_gc_refcount(n)` 会
             * 被当成"交出引用"而去 retain 一个整数，踩过）。 */
            int ret_mgd = (PEND_MGD && ty_is_ptr(rty)) ? PEND_MGD : 0;
            int v_took = 0;   /* 返回值本来就是一份新引用（`return new T`） */

            closure_lit_check(CUR_RET_TY);

            if (ret_mgd && CUR_TASK_TY) {
                /* `async @T f() { … return n; }`：局部那份引用**转移**进任务的
                 * val 槽（不加计数、也不在出口放掉），销毁任务时由运行时放。
                 * tests/gc_async.c6 "托管返回值由任务的 val 槽持有"。 */
                u32 tsk = 0;
                /* 顺手把任务结构的 `val`（第 8 个成员，下标 7）登记成托管
                 * 字段：`t->val` 这样的读才是"借"，赋值处才会加计数。 */
                {
                    u8 vi8[1] = {7};
                    u8 vk8[1] = {0};
                    u8 vc8[1] = {0};

                    mgdst_add(CUR_TASK_TY, vi8, vk8, vc8, 1, (u32)pa_cur()->file);
                }
                u32 voff = 0;
                u32 dst2 = 0;

                if (PEND_MGD_SYM && PEND_MGD_SYM->kind == SC_LOCAL)
                    DF_EXCEPT = PEND_MGD_SYM->slot;
                v = value_of(v);
                pa_expect_ch(';');
                tsk = task_get();
                voff = task_val_off();
                dst2 = tsk;
                if (voff) {
                    dst2 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_LEA, IRT_PTR, (u16)dst2, (u16)tsk, 0, 0, voff);
                }
                irfn_push(&FN, IR_STORE, IRT_U64, (u16)dst2, (u16)v, 0, 0, 0);
                {
                    u32 ov = irfn_vreg(&FN);

                    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)tsk, 0, 0, 0);
                    irfn_push(&FN, IR_CALL, IRT_VOID, (u16)ov, 0, 0, 0,
                              x64_sym(&X64, "__c6_co_ownval"));
                    FN.ops[FN.n - 1].narg = 1;
                }
                task_seal(tsk);
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, IRT_PTR, 0, (u16)tsk, 0, 0, 0);
                return;
            }
            if (ret_mgd && PEND_MGD_SYM && PEND_MGD_SYM->kind == SC_LOCAL) {
                DF_EXCEPT = PEND_MGD_SYM->slot;
            } else if (ret_mgd) {
                u32 rv = 0;

                pa_expect_ch(';');
                rv = value_of(v);
                mgd_retain(rv);
                v = rv;
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, ir_ty_of(CUR_RET_TY), 0, (u16)v, 0, 0, 0);
                return;
            }
            v_took = mgd_tmp_take(v);
            /* `async (int,int) f() { return await g(); }`：聚合返回值的 v
             * 已经是**地址**了（await/slice 这些聚合表达式按地址给），
             * 再 value_of 一下就变成"把地址当值"，任务里的 val 全是垃圾
             * （tests/tuple_async.c6 的嵌套 await 踩过）。 */
            if (!(CUR_TASK_TY && ty_is_agg(rty)))
                v = value_of(v);
            pa_expect_ch(';');
            /* 按**函数声明的返回类型**转换。少了这步，返回 signed char 的函数
             * 会把 0x80 原样带回去（调用方按 signed char 解释就是 +128），返回
             * float 的函数会把 double 的位模式整个带回去（踩过）。 */
            if (CUR_TASK_TY) {
                /* async 函数：返回值放进新建的任务结构，返回它的指针 */
                u32 a1 = irfn_vreg(&FN);
                u32 a2 = irfn_vreg(&FN);
                u32 tsk = 0;

                if (!on_err && CUR_TASK_VAL && ty_is_scalar(CUR_TASK_VAL)
                    && rty != CUR_TASK_VAL)
                    v = gen_convert(v, rty, CUR_TASK_VAL);
                tsk = task_get();
                /* 失败路径（`return err(...)`）**不写 val**：任务结构是 calloc
                 * 出来的，val 已经是全 0，也就是 +0.0 / 0 / NULL。把 err 的
                 * 返回码转换后写进去就成了 44.0 这种垃圾（tests/async.c6 的
                 * "double!error 失败路径写回 +0.0" 踩过）。 */
                if (!on_err) {
                    u32 voff = task_val_off();
                    u32 dst2 = tsk;

                    if (voff) {
                        dst2 = irfn_vreg(&FN);
                        irfn_push(&FN, IR_LEA, IRT_PTR, (u16)dst2, (u16)tsk, 0, 0, voff);
                    }
                    if (ty_is_agg(rty))
                        /* 聚合表达式：v 是它的地址，按字节拷进 val。
                         * 看的是**表达式**的类型：`return err(9, "…")` 在元组
                         * 返回的 async 函数里也合法，那时 v 是标量，不能当地址拷。 */
                        irfn_push(&FN, IR_COPY, IRT_U8, (u16)dst2, (u16)v, 0, 0,
                                  ty_size(rty) ? ty_size(rty) : 8);
                    else
                        irfn_push(&FN, IR_STORE, IRT_U64, (u16)dst2, (u16)v, 0, 0, 0);
                    /* `return new T;`（新引用）也是"交进 val 槽"：记上标记，
                     * 销毁任务时由运行时放掉，`t->val` 也就按托管字段处理
                     * （tests/gc_async.c6 的 t4_make_fresh 这条）。 */
                    if (v_took) {
                        u32 ov2 = irfn_vreg(&FN);
                        u8 vi9[1] = {7};
                        u8 vk9[1] = {0};
                        u8 vc9[1] = {0};

                        mgdst_add(CUR_TASK_TY, vi9, vk9, vc9, 1, (u32)pa_cur()->file);
                        irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)tsk, 0, 0, 0);
                        irfn_push(&FN, IR_CALL, IRT_VOID, (u16)ov2, 0, 0, 0,
                                  x64_sym(&X64, "__c6_co_ownval"));
                        FN.ops[FN.n - 1].narg = 1;
                    }
                }
                task_seal(tsk);
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, IRT_PTR, 0, (u16)tsk, 0, 0, 0);
            } else {
                if (ty_is_scalar(CUR_RET_TY) && rty != CUR_RET_TY)
                    v = gen_convert(v, rty, CUR_RET_TY);
                defer_run(1, on_err);
                DF_EXCEPT = MGD_NO_SLOT;
                irfn_push(&FN, IR_RET, ir_ty_of(CUR_RET_TY), 0, (u16)v, 0, 0, 0);
            }
        }
        return;
    }
    if (PA_ACCEPT_IDENT("if")) {
        u32 lthen = irfn_label(&FN);
        mv_push();
        u32 lelse = irfn_label(&FN);
        u32 lend = irfn_label(&FN);
        u32 c = 0;

        pa_expect_ch('(');
        c = value_of(gen_expr());
        pa_expect_ch(')');
        irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)c, (u16)lthen, (u16)lelse, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lthen, 0, 0, 0);
        gen_stmt();
        mv_save_tmp();          /* then 分支的状态 */
        mv_restore();           /* else 从"进来时"的状态开始 */
        if (PA_ACCEPT_IDENT("else")) {
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)lend, 0, 0, 0);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lelse, 0, 0, 0);
            gen_stmt();
        } else {
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lelse, 0, 0, 0);
        }
        mv_union_tmp();         /* 汇合：任一条路移走了就算移走 */
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
        mv_pop();
        return;
    }
    /* c6 `foreach (T v = it)` / `foreach ((T i, T v) = it)`：数组与切片。
     * 语法：foreach ( ['('] T1 n1 [, T2 n2] [')'] = expr ) stmt
     * 展开成"快照 ptr/len + 普通循环"。 */
    if (c6_kw() && PA_ACCEPT_IDENT("foreach")) {
        u32 bty[2] = {0};
        u32 bsl[2] = {0};
        int bnamed[2] = {0};
        int bmgd[2] = {0};        /* 绑定是托管引用（每轮收尾要放掉） */
        int bdisc[2] = {0};       /* 绑定名是 `_`（丢弃） */
        int nb = 0;
        int two = 0;
        u32 ltop = 0;
        u32 lbody = 0;
        u32 lcont = 0;
        u32 lend = 0;
        u32 pslot = 0;
        u32 nslot = 0;
        u32 islot = 0;
        u32 vbind = 0;
        u32 itslot = 0;
        u32 iter_has = 0;
        u32 iter_next = 0;
        int is_iter = 0;
        int shadowed = 0;         /* 类型上有同名字段，字段遮蔽方法 */
        int iter_ok = 0;
        int iter_own = 0;         /* 迭代器是"临时托管引用"，出口要放掉 */
        int iter_ifx = 0;         /* >0：接口值迭代器（IFACE 下标 + 1） */
        u32 iter_mi_has = 0;
        u32 iter_mi_next = 0;
        u32 ety_el = 0;           /* 被遍历序列的**元素**类型（可能和绑定类型不同） */
        int is_range = 0;         /* `foreach (T i = lo:hi)` 半开整数区间 */
        u32 rlo = 0;
        u32 rhi = 0;

        scope_enter();
        pa_expect_ch('(');
        two = pa_accept_ch('(');
        for (;;) {
            Declarator dn = {0};
            u32 t1 = 0;

            /* 头里得先有个类型名（tests/errors/foreach_head.c6 的 test_no_type：
             * `foreach (v = a)` 里的 v 是变量，不是类型）。 */
            {
                int head_ty = is_typename_tok(pa_cur());

                if (c6_kw()
                    && (pa_is_ch('@') || PA_IS_IDENT("shared")
                        || PA_IS_IDENT("weak") || PA_IS_IDENT("own")))
                    head_ty = 1;      /* `@T` / `shared @T` 也是类型写法 */
                if (!head_ty && pa_cur()->kind == TK_IDENT) {
                    Sym *hs = sym_find(tok_data(pa_cur()), pa_cur()->len);

                    if (hs && hs->kind == SC_TYPEDEF)
                        head_ty = 1;
                    if (sym_find_tag(tok_data(pa_cur()), pa_cur()->len))
                        head_ty = 1;
                    /* 模板实例 `Vect@int` 也是类型 */
                    if (pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
                        && TOK_EQ(pa_peek(1), "@"))
                        head_ty = 1;
                }
                if (!head_ty)
                    pa_error("a type name expected in the head of 'foreach'");
            }
            t1 = parse_typespec();
            (void)parse_declarator(t1, &dn);
            /* 绑定类型要用**声明符解析出来的完整类型**：`foreach (char *s =
             * ws)` 的 `t1` 只是 `char`，用 t1 会把指针当字符读（ld1 一个
             * 指针，再当 %s 传下去，直接段错误）。 */
            if (dn.type)
                t1 = dn.type;
            /* 绑定本身的合法性（tests/errors/foreach_head.c6） */
            if (t1 == ty_void())
                pa_error("a 'foreach' binding cannot be 'void'");
            else if (ty_is_array(t1))
                pa_error("a 'foreach' binding cannot be an array");
            if (!dn.name)
                pa_error("identifier expected");
            else if (dn.nlen == 1 && dn.name[0] == '_')
                bdisc[nb] = 1;
            if (nb == 1 && bdisc[0] && bdisc[1])
                pa_error("'foreach' discards both binders");
            if (nb < 2) {
                bty[nb] = t1;
                /* 元素是聚合体时绑定是"一个对象"，得占帧里的对象槽；标量绑定
                 * 才是一个 vreg（否则 `p.a` 会从装着地址的寄存器里取字段）。 */
                if ((ty_is_agg(t1) && ty_size(t1) > 0) || (dn.mgd && dn.mgd_kind != 1))
                    bsl[nb] = frame_slots_for(ty_size(t1) ? ty_size(t1) : 8);
                else
                    bsl[nb] = irfn_vreg(&FN);
                bmgd[nb] = (dn.mgd && dn.mgd_kind != 1) ? 1 : 0;
                if (dn.name && !(dn.nlen == 1 && dn.name[0] == '_')) {
                    Sym *sb = sym_add(dn.name, dn.nlen, t1, SC_LOCAL);

                    sb->slot = bsl[nb];
                    bnamed[nb] = 1;
                }
                nb++;
            }
            if (!pa_accept_ch(','))
                break;
        }
        if (two)
            pa_expect_ch(')');
        pa_expect_ch('=');
        {
            int had_lval = PEND_LVAL;
            int iv_lval = 0;
            u32 iv = 0;
            u32 ivty = 0;
            u32 base = 0;
            int lit_n = 0;           /* 被遍历的是字符串字面量时，它的元素个数 */

            /* `foreach (char c = "abc")`：字面量在表达式里是 `char *`，长度
             * 只有解析时才知道（含结尾 NUL，所以是 token 长度 - 1 再 +1）。 */
            if (pa_cur()->kind == TK_STR && pa_cur()->len >= 2)
                lit_n = (int)pa_cur()->len - 1;
            iv = gen_assign();
            ivty = PEND_LVAL ? PEND_TY : GEN_TY;
            {
                /* `foreach (int v = make_mcount(2))`：迭代器是个临时的托管
                 * 引用，循环完得放掉（不然每跑一次漏一个） */
                int iv_call0 = E_WAS_CALL;

                iter_own = (!PEND_LVAL && iv_call0 && ty_is_ptr(ivty)) ? 1 : 0;
            }
            base = iv;

            iv_lval = PEND_LVAL;
            if (PEND_LVAL) {
                base = PEND_ADDR;
                PEND_LVAL = 0;
            }
            /* 半开整数区间 `foreach (T i = lo:hi)`。
             * `had_lval` 是**进 gen_assign 之前**的快照，和 `lo` 是不是左值没
             * 关系；下界是变量时 `iv` 拿到的是它的地址，当循环下界用就一次都
             * 不转（`foreach (int i = lo:hi)`）。 */
            if (two && pa_is_ch(':'))
                pa_error("a range yields only an index");
            if (!two && nb >= 1 && pa_is_ch(':')) {
                rlo = iv_lval ? load_lval(base, ivty) : value_of(iv);
                pa_advance();
                rhi = value_of(gen_assign());
                is_range = 1;
                islot = bsl[0];
                nslot = 0;
                pa_expect_ch(')');
                goto range_done;
            }
            pslot = irfn_vreg(&FN);
            nslot = irfn_vreg(&FN);
            if (ty_is_slice(ivty)) {
                u32 dv = irfn_vreg(&FN);
                u32 a8 = irfn_vreg(&FN);

                ety_el = ty_slice_elem(ivty);

                irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)dv, (u16)base, 0, 0, 0);
                irfn_push(&FN, IR_MOV, IRT_PTR, (u16)pslot, (u16)dv, 0, 0, 0);
                irfn_push(&FN, IR_LEA, IRT_PTR, (u16)a8, (u16)base, 0, 0, 8);
                irfn_push(&FN, IR_LOAD, IRT_U64, (u16)nslot, (u16)a8, 0, 0, 0);
            } else if (ty_is_array(ivty)) {
                ety_el = ty_target(ivty);
                if (ty_array_n(ivty) == 0)
                    pa_error("cannot iterate over an array of unknown length");
                irfn_push(&FN, IR_MOV, IRT_PTR, (u16)pslot, (u16)base, 0, 0, 0);
                irfn_push(&FN, IR_CONST, IRT_U64, (u16)nslot, 0, 0, 0, ty_array_n(ivty));
            } else if (ty_is_agg(ivty)
                       || (ty_is_ptr(ivty) && ty_is_agg(ty_target(ivty)))) {
                /* 迭代器协议：可迭代值的类型提供 `has(T *)` / `next(T *)`。
                 * 也可以是**指向迭代器的指针**（`foreach (int v = &g)`），
                 * 这时那个指针本身就是迭代器地址，不用另开槽拷一份。 */
                /* 按**迭代器指针类型**挑重载：一个文件里往往给好几种类型
                 * 都写了 has()/next()，光按名字查拿到的是最后登记的那个
                 * （踩过：`foreach (char *s = ws)` 调到了 struct Pairs 的
                 * has/next，循环一次都不跑）。 */
                u32 ipty = ty_is_ptr(ivty) ? ivty : ty_ptr(ivty);
                u32 sty_it = ty_is_ptr(ivty) ? ty_target(ivty) : ivty;
                /* 参考实现（tcc 那边的 c6_iter_proto_of）找的是**这个
                 * 类型的方法表项**（`c6_method_of(tag, has)`）——首形参是
                 * `T *` 的普通函数也算方法，所以先查方法表；查不到才退回
                 * 按名字 + 首形参类型挑重载。 */
                Sym *sh = meth_find(sty_it, "has", 3);
                Sym *sn = meth_find(sty_it, "next", 4);
                u32 ifx0 = 0;

                /* 接口值迭代器：`interface IntIter { int has(); int next(); }`
                 * 按方法表分派，不能去符号表挑一个同名自由函数。 */
                if (NIFACE > 0 && ty_is_iface(ivty, &ifx0)) {
                    iter_ifx = (int)ifx0 + 1;
                    iter_mi_has = iface_slot(ifx0, "has", 3);
                    iter_mi_next = iface_slot(ifx0, "next", 4);
                    if (iter_mi_has == 0xFFFFFFFFu || iter_mi_next == 0xFFFFFFFFu)
                        pa_error("foreach：接口里没有 has()/next()，不能当迭代器");
                    ety_el = IFACE_RET[ifx0][iter_mi_next];
                    /* 接口值的 next 返回类型同样要有具体元素类型：
                     * `void *` 等于把元素类型擦掉了（foreach_iter 的
                     * test_interface_voidptr）。 */
                    if (ety_el == ty_void())
                        pa_error("iterator method 'next' must return a value (got 'void')");
                    else if (ty_is_ptr(ety_el) && ty_target(ety_el) == ty_void())
                        pa_error("iterator method 'next' cannot return 'void *': the "
                                 "element type would be erased (return 'E' or 'E *' "
                                 "with a concrete E)");
                }
                u32 itaddr = 0;

                if (!iter_ifx) {
                    /* 结构体上有**真字段**叫 has/next 时，字段遮蔽方法，这个
                     * 类型就不是迭代器（`p->has()` 是读字段）。这时候**不能**
                     * 再退回按名字挑自由函数——那会把别的类型的 has/next 认成
                     * 自己的（tests/errors/foreach_iter.c6 的 test_shadow）。 */
                    if (ty_is_agg(sty_it)
                        && (agg_has_member(sty_it, "has", 3)
                            || agg_has_member(sty_it, "next", 4))) {
                        sh = NULL;
                        sn = NULL;
                        shadowed = 1;
                    }
                    if (!shadowed && !sh)
                        sh = sym_find_fn("has", 3, 1, ipty);
                    if (!shadowed && !sn)
                        sn = sym_find_fn("next", 4, 1, ipty);
                    /* 签名口径和参考实现一致：两个都只收接收者，has 返回整数 */
                    if (sh && ty_func_nparams(sh->type) != 1)
                        pa_error("iterator method 'has' must take only the receiver");
                    if (sh && sh->is_func && !ty_is_int(ty_func_ret(sh->type)))
                        pa_error("iterator method 'has' must return an integer type (got '%s')",
                                 ty_disp(ty_func_ret(sh->type)));
                    if (sn && ty_func_nparams(sn->type) != 1)
                        pa_error("iterator method 'next' must take only the receiver");
                    /* next 的返回类型决定元素类型，限制不少 */
                    if (sn && sn->is_func) {
                        u32 nret = ty_func_ret(sn->type);

                        if (nret == ty_void())
                            pa_error("iterator method 'next' must return a value (got 'void')");
                        else if (ty_is_ptr(nret) && ty_target(nret) == ty_void())
                            pa_error("iterator method 'next' cannot return 'void *': "
                                     "the element type would be erased (return 'E' or "
                                     "'E *' with a concrete E)");
                        else if (ty_is_array(ty_is_ptr(nret) ? ty_target(nret) : nret))
                            pa_error("'foreach' cannot copy an element of type '%s'",
                                     ty_disp(nret));
                        else if (ty_is_agg(ty_is_ptr(nret) ? ty_target(nret) : nret)
                                 && ty_size(ty_is_ptr(nret) ? ty_target(nret) : nret) == 0)
                            pa_error("cannot iterate over incomplete element type '%s'",
                                     ty_disp(ty_is_ptr(nret) ? ty_target(nret) : nret));
                        else if (ty_has_mgd(nret))
                            pa_error("'%s' holds managed references: a foreach binding "
                                     "is not possible. Allocate it with 'new' and hold "
                                     "it in '@%s'", ty_disp(nret), ty_disp(nret));
                    }
                }
                if (!iter_ifx && (!sh || !sh->is_func || !sn || !sn->is_func))
                    pa_error("cannot iterate over '%s' (no 'has'/'next' iterator: use a "
                             "slice parameter 'T[:]', or '(T[:]){p, n}')", ty_disp(ivty));
                if (ty_is_ptr(ivty)) {
                    /* 已经是指针：迭代器地址就是它的**值**。注意别用 base
                     * ——`foreach (int v = p)` 的 p 是左值，base 是它的地址，
                     * has() 会去读指针自己的字节（踩过：托管迭代器的测试
                     * 死循环）。 */
                    /* 迭代器是左值时 iv 是它的**地址**（左值约定），要取
                     * 值：和半开区间那里一样用 load_lval。 */
                    itaddr = iv_lval ? load_lval(base, ivty) : value_of(iv);
                } else {
                    itslot = frame_slots_for(ty_size(ivty) ? ty_size(ivty) : 8);
                    itaddr = irfn_vreg(&FN);
                    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)itaddr, 0, 0, 0, X64_SLOT(itslot));
                    irfn_push(&FN, IR_COPY, IRT_U8, (u16)itaddr, (u16)base, 0, 0,
                              ty_size(ivty) ? ty_size(ivty) : 8);
                }
                iter_has = sh ? (u32)sh->val : 0;
                if (iter_ifx) {
                    iter_has = 0;
                    iter_next = 0;
                    iter_ok = 1;
                } else {
                    iter_next = sn ? (u32)sn->val : 0;
                    iter_ok = (sh && sh->is_func && sn && sn->is_func) ? 1 : 0;
                }
                is_iter = 1;
                /* 迭代器每步只产出一个值：两个绑定是"键 + 值"的写法，只有
                 * 区间和数组/切片支持（tests/errors/foreach_head.c6 的
                 * pair_iterator、foreach_iter.c6 的 two_binders）。 */
                if (two)
                    pa_error("an iterator yields only a value: write "
                             "'foreach (T v = it) { ... }'");
                islot = itaddr;         /* 迭代器地址，下面按迭代器发循环 */
                (void)pslot;
                (void)nslot;
            } else if (lit_n > 0 && ty_is_ptr(ivty)
                       && ty_target(ivty) == ty_char()) {
                /* 字符串字面量：当成 `char[lit_n]` 走数组那条路 */
                u32 cnt = irfn_vreg(&FN);

                ety_el = ty_char();
                irfn_push(&FN, IR_MOV, IRT_PTR, (u16)pslot, (u16)base, 0, 0, 0);
                irfn_push(&FN, IR_CONST, IRT_U64, (u16)cnt, 0, 0, 0, (u32)lit_n);
                irfn_push(&FN, IR_MOV, IRT_U64, (u16)nslot, (u16)cnt, 0, 0, 0);
            } else {
                pa_error("foreach 只能遍历数组或切片");
                irfn_push(&FN, IR_MOV, IRT_PTR, (u16)pslot, (u16)base, 0, 0, 0);
                irfn_push(&FN, IR_CONST, IRT_U64, (u16)nslot, 0, 0, 0, 0);
            }
        }
        pa_expect_ch(')');
        vbind = two ? (nb >= 2 ? bsl[1] : 0) : bsl[0];
        if (is_iter) {
            /* while (has(&it)) { v = next(&it); body } */
            u32 iaddr = islot;

            ltop = irfn_label(&FN);
            lbody = irfn_label(&FN);
            lcont = irfn_label(&FN);
            lend = irfn_label(&FN);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
            {
                u32 hv = 0;

                if (iter_ifx)
                    hv = gen_iface_call(iaddr, iter_mi_has, ty_int(), NULL, 0);
                else {
                    hv = irfn_vreg(&FN);
                    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)iaddr, 0, 0, 0);
                    irfn_push(&FN, IR_CALL, IRT_I32, (u16)hv, 0, 0, 0, iter_has);
                    FN.ops[FN.n - 1].narg = 1;
                }
                irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)hv, (u16)lbody, (u16)lend, 0);
            }
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lbody, 0, 0, 0);
            if (vbind) {
                u32 elty0 = two ? bty[1] : bty[0];
                u32 nv = 0;

                if (iter_ifx)
                    nv = gen_iface_call(iaddr, iter_mi_next, elty0, NULL, 0);
                else {
                    nv = irfn_vreg(&FN);
                    irfn_push(&FN, IR_ARG, IRT_U64, 0, (u16)iaddr, 0, 0, 0);
                    irfn_push(&FN, IR_CALL, ir_ty_of(elty0), (u16)nv, 0, 0, 0, iter_next);
                    FN.ops[FN.n - 1].narg = 1;
                }
                if (bmgd[two ? (nb >= 2 ? 1 : 0) : 0] && !bnamed[two ? (nb >= 2 ? 1 : 0) : 0]) {
                    /* `foreach (@T _ = it)`：next() 交回来的引用没人接手，
                     * 当场放掉（不然每轮漏一个） */
                    mgd_release(nv);
                } else if (ty_is_agg(elty0) && ty_size(elty0) > 0) {
                    /* 聚合体元素按地址约定交回来：拷进绑定自己的对象槽，
                     * 不能把地址本身当值（踩过：`foreach (struct Pair p =
                     * ps)` 里 p.a 读到的是栈地址）。 */
                    u32 bdst = irfn_vreg(&FN);

                    irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)bdst, 0, 0, 0, X64_SLOT(vbind));
                    irfn_push(&FN, IR_COPY, IRT_U8, (u16)bdst, (u16)nv, 0, 0,
                              ty_size(elty0));
                } else {
                    irfn_push(&FN, IR_MOV, ir_ty_of(elty0), (u16)vbind, (u16)nv, 0, 0, 0);
                }
            }
            LOOP_BRK[NLOOP] = lend;
            LOOP_CNT[NLOOP] = lcont;
            LOOP_DFB[NLOOP] = DEF_DEPTH;
            LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
            gen_vla_loop_push();
            mv_loop_enter();
            if (pa_is_ch('{'))
                gen_block();
            else
                pa_error("foreach 后面要一个 { … } 块");
            mv_loop_leave();
            NLOOP--;
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lcont, 0, 0, 0);
            /* 托管绑定：每轮收尾把这一轮拿到的引用放掉（`lcont` 之后才放，
             * 这样 `continue` 也走得到；出口再放一次，兜住 `break`）。 */
            if (bmgd[0] && bnamed[0])
                mgd_release_slot(vbind);
            if (two && bmgd[1] && bnamed[1])
                mgd_release_slot(vbind);
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
            if (iter_own)
                mgd_release(islot);
            if (bmgd[0] && bnamed[0])
                mgd_release_slot(vbind);
            if (two && bmgd[1] && bnamed[1])
                mgd_release_slot(vbind);
            scope_leave();
            (void)iter_ok;
            return;
        }
    range_done:
        /* 绑定声明成托管引用（`@T v`）时，元素本身必须是引用：`@int v` 绑到
         * 一个 int 元素上等于凭空造引用（tests/errors/foreach_head.c6 的
         * test_ownership）。 */
        if (!is_range && ety_el) {
            int bi = 0;

            for (bi = 0; bi < nb; bi++)
                if (bmgd[bi] && !ty_is_ptr(ety_el))
                    pa_error("a 'foreach' binding cannot change ownership");
        }
        if (is_range) {
            u32 lb = islot;

            if (lb) {
                /* 计数器放**隐藏槽**里，绑定每轮拿一份副本：`foreach (size_t i =
                 * 0:3) { i = 99; }` 里改绑定不能影响迭代次数。 */
                u32 rcnt = irfn_vreg(&FN);

                irfn_push(&FN, IR_MOV, ir_ty_of(bty[0]), (u16)rcnt, (u16)rlo, 0, 0, 0);
                ltop = irfn_label(&FN);
                lbody = irfn_label(&FN);
                lcont = irfn_label(&FN);
                lend = irfn_label(&FN);
                irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
                {
                    u32 c2 = irfn_vreg(&FN);
                    u8 cc = ty_is_signed(bty[0]) ? IRCC_LT : IRCC_ULT;

                    irfn_push(&FN, IR_CMP, IRT_U64, (u16)c2, (u16)rcnt, (u16)rhi, 0, cc);
                    FN.ops[FN.n - 1].flags = cc;
                    irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)c2, (u16)lbody, (u16)lend, 0);
                    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lbody, 0, 0, 0);
                    irfn_push(&FN, IR_MOV, ir_ty_of(bty[0]), (u16)lb, (u16)rcnt, 0, 0, 0);
                }
                LOOP_BRK[NLOOP] = lend;
                LOOP_CNT[NLOOP] = lcont;
                LOOP_DFB[NLOOP] = DEF_DEPTH;
                NLOOP++;
                gen_vla_loop_push();
                mv_loop_enter();
                if (pa_is_ch('{'))
                    gen_block();
                else
                    pa_error("foreach 后面要一个 { … } 块");
                mv_loop_leave();
                NLOOP--;
                irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lcont, 0, 0, 0);
                {
                    u32 one = irfn_vreg(&FN);
                    u32 nx = irfn_vreg(&FN);

                    irfn_push(&FN, IR_CONST, IRT_U64, (u16)one, 0, 0, 0, 1);
                    irfn_push(&FN, IR_ADD, IRT_U64, (u16)nx, (u16)rcnt, (u16)one, 0, 0);
                    irfn_push(&FN, IR_MOV, ir_ty_of(bty[0]), (u16)rcnt, (u16)nx, 0, 0, 0);
                }
                irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
                irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
            }
            scope_leave();
            return;
        }
        /* 单绑定形式 `(T v = …)` 里那个绑定是**值**，下标是隐藏临时量；
         * 两绑定形式 `((T i, T v) = …)` 才是 下标 + 值。 */
        /* 下标也放隐藏槽：`foreach ((size_t i, int v) = a) { i = 99; }` 里改
         * 绑定不能影响迭代（绑定每轮拿一份副本）。 */
        islot = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, (u16)islot, 0, 0, 0, 0);
        ltop = irfn_label(&FN);
        lbody = irfn_label(&FN);
        lcont = irfn_label(&FN);
        lend = irfn_label(&FN);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
        {
            u32 c2 = irfn_vreg(&FN);

            irfn_push(&FN, IR_CMP, IRT_U64, (u16)c2, (u16)islot, (u16)nslot, 0, IRCC_ULT);
            irfn_setcc(&FN, IRCC_ULT);
            irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)c2, (u16)lbody, (u16)lend, 0);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lbody, 0, 0, 0);
            if (two && bsl[0])
                irfn_push(&FN, IR_MOV, ir_ty_of(bty[0]), (u16)bsl[0], (u16)islot, 0, 0, 0);
        }
        if (vbind) {
            u32 vt = two ? bty[1] : bty[0];
            /* 步长按**元素**大小算：`foreach (long v = s)`（s 是 char[]）以前
             * 按绑定类型的 8 字节步进，读出来全是垃圾。 */
            u32 et2 = ety_el ? ety_el : vt;
            u32 esz = ty_size(et2) ? ty_size(et2) : 1;
            u32 off = irfn_vreg(&FN);
            u32 m = irfn_vreg(&FN);
            u32 a = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, (u16)off, 0, 0, 0, esz);
            irfn_push(&FN, IR_MUL, IRT_U64, (u16)m, (u16)islot, (u16)off, 0, 0);
            irfn_push(&FN, IR_LEA, IRT_PTR, (u16)a, (u16)pslot, (u16)m, 0, 0);
            irfn_push(&FN, IR_LOAD, ir_ty_of(et2), (u16)vbind, (u16)a, 0, 0, 0);
            /* 元素类型和绑定类型不同时按赋值规则转换（char -> long 之类） */
            if (et2 != vt) {
                u32 cv = gen_convert(vbind, et2, vt);

                irfn_push(&FN, IR_MOV, ir_ty_of(vt), (u16)vbind, (u16)cv, 0, 0, 0);
            }
            /* 托管元素是**借**的（数组还持有它）：绑定加一次计数，每轮收尾
             * 放掉（不然后面 a[0] = 0 一放，活计数就对不上了）。 */
            if (bmgd[two ? 1 : 0] && bnamed[two ? 1 : 0])
                mgd_retain_slot(vbind);
        }
        LOOP_BRK[NLOOP] = lend;
        LOOP_CNT[NLOOP] = lcont;
        LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
        gen_vla_loop_push();
        mv_loop_enter();
        if (pa_is_ch('{'))
            gen_block();
        else
            pa_error("foreach 后面要一个 { … } 块");
        mv_loop_leave();
        NLOOP--;
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lcont, 0, 0, 0);
        if (vbind && bmgd[two ? 1 : 0] && bnamed[two ? 1 : 0])
            mgd_release_slot(vbind);
        {
            u32 one = irfn_vreg(&FN);
            u32 nx = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, (u16)one, 0, 0, 0, 1);
            irfn_push(&FN, IR_ADD, IRT_U64, (u16)nx, (u16)islot, (u16)one, 0, 0);
            irfn_push(&FN, IR_MOV, IRT_U64, (u16)islot, (u16)nx, 0, 0, 0);
        }
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
        if (vbind && bmgd[two ? 1 : 0] && bnamed[two ? 1 : 0])
            mgd_release_slot(vbind);
        scope_leave();
        (void)bnamed;
        (void)two;
        return;
    }
    if (PA_ACCEPT_IDENT("while")) {
        u32 ltop = irfn_label(&FN);
        u32 lbodY = irfn_label(&FN);
        u32 lend = irfn_label(&FN);
        u32 c = 0;

        /* 标签必须在条件**之前**发出：条件本身会产生算 cmp 的指令，
         * 标签放在后面会让回边跳过条件求值（死循环）。 */
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
        pa_expect_ch('(');
        c = value_of(gen_expr());
        pa_expect_ch(')');
        irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)c, (u16)lbodY, (u16)lend, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lbodY, 0, 0, 0);
        LOOP_BRK[NLOOP] = lend;
        LOOP_CNT[NLOOP] = ltop;
        LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
        gen_vla_loop_push();
        mv_loop_enter();
        gen_stmt();
        mv_loop_leave();
        NLOOP--;
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
        return;
    }
    if (PA_ACCEPT_IDENT("for")) {
        u32 ltop = irfn_label(&FN);
        u32 lcont = irfn_label(&FN);
        u32 lbody = irfn_label(&FN);
        u32 lend = irfn_label(&FN);
        /* 条件不成立时的落点：先跑 init 作用域的清理，再到 lend。break 直接跳
         * lend（它已经就地跑过清理了），所以两条出口不会重复。 */
        u32 lclean = irfn_label(&FN);

        pa_expect_ch('(');
        scope_enter();
        /* `for (T v = …; …)`：init 里声明的变量属于 for 自己的作用域（循环结束
         * 就销毁），所以这里单独开一层深度。continue 不清理它，break 和循环正常
         * 结束要清理它（C 标准：离开作用域就跑 cleanup 函数）。 */
        DEF_DEPTH++;
        if (!pa_accept_ch(';')) {
            if (is_typename_tok(pa_cur()))
                gen_local_decl(1);
            else {
                (void)value_of(gen_expr());
                pa_expect_ch(';');
            }
        }
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
        if (!pa_accept_ch(';')) {
            u32 c = value_of(gen_expr());

            pa_expect_ch(';');
            irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)c, (u16)lbody, (u16)lclean, 0);
        } else {
            /* 空条件 `for (init; ; incr)`：没有条件分支，就得有**无条件**跳进
             * 循环体。少了这一条，控制流从 ltop 直接落到 lcont（先跑 incr）再
             * 跳回 ltop，循环体永远进不去——编译出来的程序死循环且一行 print
             * 都不出。tcc 的 `for (popt = tcc_options; ; ++popt)` 正好踩这个。 */
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)lbody, 0, 0, 0);
        }
        /* 源码顺序是 init; cond; incr; body，而 IR 里 body 要在 incr 之后执行，
         * 所以先跳过 incr 把 body 接在后面（token 只读一遍，不回头）。 */
        if (pa_accept_ch(')')) {
            LOOP_BRK[NLOOP] = lend;
            LOOP_CNT[NLOOP] = lcont;
            LOOP_DFB[NLOOP] = DEF_DEPTH;
            LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
            gen_vla_loop_push();
            LOOP_OWN[NLOOP - 1] = 1;      /* for 自己那层 init 作用域 */
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lbody, 0, 0, 0);
            mv_loop_enter();
            gen_stmt();
            mv_loop_leave();
            NLOOP--;
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lcont, 0, 0, 0);
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
            /* 循环正常结束（条件不成立落到 lclean）也要跑 init 作用域的清理。
             * 放在 lend 之前：break 跳过去时不能重复跑。 */
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lclean, 0, 0, 0);
            defer_run_pop(DEF_DEPTH);
            DEF_DEPTH--;
            if (SCOPE && SCOPE->vla_save)
                irfn_push(&FN, IR_SETRSP, IRT_VOID, 0, (u16)SCOPE->vla_save, 0, 0, 0);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
            scope_leave();
            return;
        }
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)lcont, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lcont, 0, 0, 0);
        (void)value_of(gen_expr());
        pa_expect_ch(')');
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lbody, 0, 0, 0);
        LOOP_BRK[NLOOP] = lend;
        LOOP_CNT[NLOOP] = lcont;
        LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
        gen_vla_loop_push();
        LOOP_OWN[NLOOP - 1] = 1;          /* for 自己那层 init 作用域 */
        mv_loop_enter();
        gen_stmt();
        mv_loop_leave();
        NLOOP--;
        irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)lcont, 0, 0, 0);
        /* 循环正常结束：init 作用域的清理（和上面那条分支同理） */
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lclean, 0, 0, 0);
        defer_run_pop(DEF_DEPTH);
        DEF_DEPTH--;
        if (SCOPE && SCOPE->vla_save)
            irfn_push(&FN, IR_SETRSP, IRT_VOID, 0, (u16)SCOPE->vla_save, 0, 0, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
        scope_leave();
        return;
    }
    if (PA_ACCEPT_IDENT("do")) {
        u32 ltop = irfn_label(&FN);
        u32 lcont = irfn_label(&FN);
        u32 lend = irfn_label(&FN);
        u32 c = 0;

        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)ltop, 0, 0, 0);
        LOOP_BRK[NLOOP] = lend;
        LOOP_CNT[NLOOP] = lcont;
        LOOP_DFB[NLOOP] = DEF_DEPTH;
        NLOOP++;
        gen_vla_loop_push();
        mv_loop_enter();
        gen_stmt();
        mv_loop_leave();
        NLOOP--;
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lcont, 0, 0, 0);
        if (!PA_ACCEPT_IDENT("while")) {
            pa_error("do 后面要 while");
            return;
        }
        pa_expect_ch('(');
        c = value_of(gen_expr());
        pa_expect_ch(')');
        pa_expect_ch(';');
        irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)c, (u16)ltop, (u16)lend, 0);
        irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lend, 0, 0, 0);
        return;
    }
    if (PA_ACCEPT_IDENT("break")) {
        if (PA_IN_DEFER)
            pa_error("'break' is not allowed in a defer body");
        pa_expect_ch(';');
        if (NLOOP > 0) {
            /* `for` 的 init 声明在自己的那一层作用域里：break 跳出整个循环，
             * 那层也要清理（LOOP_DFB + 0）。其它循环没有这一层，照旧 +1。 */
            defer_run(LOOP_DFB[NLOOP - 1] + (LOOP_OWN[NLOOP - 1] ? 0 : 1), 0);
            gen_vla_restore_loop();
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)LOOP_BRK[NLOOP - 1], 0, 0, 0);
        } else {
            pa_error("break 不在循环里");
        }
        return;
    }
    if (PA_ACCEPT_IDENT("continue")) {
        if (PA_IN_DEFER)
            pa_error("'continue' is not allowed in a defer body");
        pa_expect_ch(';');
        if (NLOOP > 0) {
            /* switch 不是 continue 的目标：跳过它，落到外层真正的循环上
             * （`for (…) { switch (i) { case 0: continue; } }` 里循环体那个块
             * 的 cleanup 也得跑，tcc tests2/101_cleanup 的 `-- loop 3 --`）。 */
            int cn = NLOOP - 1;

            while (cn > 0 && LOOP_SW[cn])
                cn--;
            defer_run(LOOP_DFB[cn] + 1, 0);
            gen_vla_restore_loop();
            irfn_push(&FN, IR_JMP, IRT_VOID, 0, (u16)LOOP_CNT[NLOOP - 1], 0, 0, 0);
        }
        else
            pa_error("continue 不在循环里");
        return;
    }
    /* 元组解构语句：`(int q, int r) = f();` / `(q, r) = f();` /
     * `(arr[0], arr[1]) = f();`。判据只有一条：括号里 depth 1 上有逗号，
     * 且闭括号后面紧跟 `=`——逗号表达式不能做赋值目标，所以不会误判。
     * 另外还有"元组类型的局部声明"：闭括号后面跟的是标识符。 */
    if (pa_is_ch('(')) {
        int depth = 0;
        int has_comma = 0;
        int q = 0;
        int is_des = 0;
        int is_decl = 0;

        for (q = 0; q < PA_LOOK; q++) {
            Tok *t2 = pa_peek(q);

            if (t2->kind != TK_PUNCT)
                continue;
            if (tok_eq(t2, "(")) {
                depth++;
            } else if (tok_eq(t2, ",") && depth == 1) {
                has_comma = 1;
            } else if (tok_eq(t2, ")")) {
                depth--;
                if (depth == 0) {
                    Tok *nx = pa_peek(q + 1);

                    if (has_comma && nx->kind == TK_PUNCT && TOK_EQ(nx, "="))
                        is_des = 1;
                    else if (has_comma && nx->kind == TK_IDENT)
                        is_decl = 1;
                    break;
                }
            }
        }
        if (is_des) {
            gen_destructure();
            return;
        }
        if (is_decl) {
            gen_local_decl(1);
            return;
        }
    }
    /* `thread h = spawn f();` / `task t = twice(5);`：软关键字，后面跟标识符
     * 才是声明 */
    if ((PA_IS_IDENT("thread") || PA_IS_IDENT("task"))
        && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
        && pa_peek(2) && (pa_peek(2)->kind == TK_PUNCT)) {
        gen_local_decl(1);
        return;
    }
    /* 接口类型开头的局部声明：`Shape t = s;`——接口名不是关键字。 */
    if (NIFACE > 0 && pa_cur()->kind == TK_IDENT
        && iface_find(tok_data(pa_cur()), pa_cur()->len) < IFACE_MAX) {
        gen_local_decl(1);
        return;
    }
    /* 模板实例开头的局部声明：`Vect@int v;`——`Vect` 是标识符不是类型关键字，
     * 但后面跟 `@` 就说明这是类型位置。 */
    if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
        && TOK_EQ(pa_peek(1), "@")) {
        Tmpl *tp = tmpl_find(tok_data(pa_cur()), pa_cur()->len);

        if (tp && !tp->is_func) {
            gen_local_decl(1);
            return;
        }
    }
    /* 托管引用/所有权修饰符开头的局部声明：`@T p = new T;`、
     * `shared @T q = …;` */
    if (c6_kw()
        && (pa_is_ch('@')
            || ((PA_IS_IDENT("shared") || PA_IS_IDENT("weak") || PA_IS_IDENT("own"))
                && (pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), "@"))))) {
        gen_local_decl(1);
        return;
    }
    /* 语句位置上的函数字面量：`int(int x) { … }(4);` / `f = int(int x){…};`
     * ——`类型 ( 参数表 ) {` 这个形状是字面量，不是声明。 */
    if (is_typename_tok(pa_cur()) && pa_peek(1)->kind == TK_PUNCT
        && tok_eq(pa_peek(1), "(")) {
        int ld = 0;
        int lq = 0;
        int lit = 0;

        for (lq = 1; lq < PA_LOOK; lq++) {
            Tok *t2 = pa_peek(lq);

            if (t2->kind != TK_PUNCT)
                continue;
            if (tok_eq(t2, "(")) {
                ld++;
            } else if (tok_eq(t2, ")")) {
                ld--;
                if (ld == 0) {
                    Tok *nx = pa_peek(lq + 1);

                    lit = (nx->kind == TK_PUNCT && TOK_EQ(nx, "{"));
                    break;
                }
            }
        }
        if (lit) {
            u32 v = gen_expr();

            (void)v;
            pa_expect_ch(';');
            return;
        }
    }
    if (pa_at_typename()) {
        gen_local_decl(1);
        return;
    }
    /* c6 的推断声明：`f = <表达式>;` —— f 还没声明过，就按右值的类型就地声明 */
    if (pa_cur()->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
        && TOK_EQ(pa_peek(1), "=")
        && !sym_find(tok_data(pa_cur()), pa_cur()->len)
        && !sym_find_tag(tok_data(pa_cur()), pa_cur()->len)
        /* 方法体里的 `x = …` 是给接收者的成员赋值，不是"推断声明"——
         * 成员不是符号，`sym_find` 当然找不到它（踩过：方法里写成员
         * 悄悄声明出一个同名局部变量，赋值全丢）。 */
        && !(METHOD_SELF_TY
             && agg_has_member(METHOD_SELF_TY, tok_data(pa_cur()), pa_cur()->len))) {
        char inm[256] = {0};
        u32 inl = pa_cur()->len < 200 ? pa_cur()->len : 200;
        u32 r0 = 0;
        u32 vty = 0;
        u32 r = 0;
        Sym *is = NULL;

        memcpy(inm, tok_data(pa_cur()), inl);
        pa_advance();
        pa_advance();
        r0 = gen_assign();
        vty = cur_op_ty();
        r = value_of(r0);
        is = sym_add(inm, inl, vty, SC_LOCAL);
        if (ty_is_agg(vty) || ty_is_array(vty)) {
            u32 sz = ty_size(vty);
            u32 a = 0;

            if (sz == 0)
                sz = 8;
            is->slot = frame_slots_for(sz);
            a = ident_addr(is);
            irfn_push(&FN, IR_COPY, IRT_U8, (u16)a, (u16)r, 0, 0, sz);
        } else {
            is->slot = irfn_vreg(&FN);
            irfn_push(&FN, IR_MOV, ir_ty_of(vty), (u16)is->slot, (u16)r, 0, 0, 0);
        }
        pa_expect_ch(';');
        return;
    }
    E_CALL_FALLIBLE = 0;
    {
        u32 v = value_of(gen_expr());

        BLOCK_VAL = v;
        BLOCK_TY = GEN_TY;
        BLOCK_HAS = 1;
    }
    /* 可失败函数的返回值必须被处理掉：丢掉就等于把错误吞了。
     * tests/errors/try.c6 的 test_result_unused。 */
    if (E_CALL_FALLIBLE == 1 && in_c6_tu())
        pa_error("the result of a 'T!error' function must be used with 'try' or "
                 "'catch'");
    E_CALL_FALLIBLE = 0;
    /* 语句结束：没落到托管量上的 `new T`（`new T;`、`f(new T)` 之类）在这里
     * 释放。 */
    mgd_tmp_flush();
    pa_expect_ch(';');
    return;
}

/* --- 顶层：函数定义 / 原型 / typedef --- */

static Sym *PA_MAIN;

/* 同一个文件里同一个函数定义了两次 → 重定义。模块文件是文本内联的（同一个
 * 文件被 import 两次就解析两遍），那种情况位置完全相同，不算重定义。 */
#define FNDEF_MAX 512
static const char *FNDEF_NM[FNDEF_MAX];
static u32 FNDEF_LEN[FNDEF_MAX];
static u16 FNDEF_FILE[FNDEF_MAX];
static u32 FNDEF_OFF[FNDEF_MAX];
static u32 FNDEF_TY[FNDEF_MAX];      /* 同名的不同签名是重载（c6 的方法） */
static int NFNDEF;

static void fndef_check(Sym *fn)
{
    int i = 0;

    if (!fn || !fn->is_func || !pa_cur())
        return;
    for (i = 0; i < NFNDEF; i++)
        if (FNDEF_LEN[i] == fn->len && FNDEF_TY[i] == fn->type
            && memcmp(FNDEF_NM[i], fn->name, fn->len) == 0) {
            if (FNDEF_FILE[i] == pa_cur()->file && FNDEF_OFF[i] != pa_cur()->off)
                pa_error("redefinition of '%.*s'", (int)fn->len, fn->name);
            return;
        }
    if (NFNDEF < FNDEF_MAX) {
        FNDEF_NM[NFNDEF] = fn->name;
        FNDEF_LEN[NFNDEF] = fn->len;
        FNDEF_FILE[NFNDEF] = pa_cur()->file;
        FNDEF_OFF[NFNDEF] = pa_cur()->off;
        FNDEF_TY[NFNDEF] = fn->type;
        NFNDEF++;
    }
}

static void pa_func_def(Sym *fn, Declarator *d)
{
    u32 i = 0;

    fndef_check(fn);
    irfn_reset(&FN, fn->name);
    memset(FSTR_SLOT, 0, sizeof(FSTR_SLOT));
    FSTR_DEPTH = 0;
    NDF = 0;
    DEF_DEPTH = 0;
    PA_DEFER_DEPTH = 0;
    PA_DEFER_SITES = 0;
    PA_IN_COND = 0;
    MV_N = 0;
    MV_SP = 0;
    PA_IN_DEFER = 0;
    CUR_ASYNC_DEF = PA_ASYNC;
    /* 析构函数：源码名就叫 `drop`，第一个参数是某个 tag 的指针。这种函数在
     * 对象释放时跑，不能挂起、不能失败、不能有返回值。 */
    /* 析构函数正好一个参数（接收者）；同名的普通方法（`std/text/str.c6`
     * 里那个 `Str drop(Str *self, int k)`）不是析构函数。 */
    if (fn->len == 4 && memcmp(fn->name, "main", 4) == 0 && CUR_FILE
        && mod_of_file((u32)CUR_FILE->id))
        pa_error("'main' cannot be declared in a module");
    PA_IN_DROP = (d->nlen == 4 && memcmp(d->name, "drop", 4) == 0
                  && d->nparams == 1 && ty_is_ptr(d->ptype[0]));
    fn->fallible = (u8)(fn->fallible || PA_FALLIBLE);
    CUR_FALLIBLE = fn->fallible;
    /* 可失败函数的返回值必须能装下"错误载荷"：不完整类型连大小都不知道，
     * 错误没地方放（tests/errors/try.c6 的 test_incomplete_return）。 */
    if (fn->fallible && fn->is_func) {
        u32 rty0 = ty_func_ret(fn->type);

        if (ty_is_agg(rty0) && ty_size(rty0) == 0)
            pa_error("cannot propagate an error from a function with an "
                     "incomplete return type");
    }
    PA_FALLIBLE = 0;
    {
        int was_inline = PA_INLINE_SEEN;

        PA_INLINE_SEEN = 0;
        if (PA_ASYNC) {
            if (fn->len == 4 && memcmp(fn->name, "main", 4) == 0)
                pa_error("'main' 不能是 async");
            if (METHOD_SELF_TY)
                pa_error("'async' 函数不能是方法");
            /* 首形参是"结构体指针"时，这个函数按显式接收者登记成方法
             * （`int port(Tcp *self)` 那种写法），方法调用会被改写成普通
             * 调用 —— 而 async 函数的体必须留在任务里，两者不能混
             * （tests/errors/async.c6 的 test_async_method）。 */
            if (ty_func_nparams(fn->type) > 0) {
                u32 p0 = ty_func_param(fn->type, 0);

                if (ty_is_ptr(p0) && ty_is_agg(ty_target(p0)) && !ty_is_task_ptr(p0))
                    pa_error("'async' functions cannot be methods");
            }
            /* 托管形参会在任务前缀里跨线程共享，必须写 `shared @T`
             * （tests/errors/gc_borrow.c6 的 test_async_plain）。 */
            {
                u32 pi4 = 0;

                for (pi4 = 0; pi4 < d->nparams && pi4 < 16; pi4++) {
                    if (d->pmgd[pi4] == 1 && !d->pshared[pi4] && in_c6_tu())
                        pa_error("passing a reference to 'async' requires 'shared'");
                    if (d->ptype[pi4] && ty_is_closure(d->ptype[pi4], NULL))
                        pa_error("a closure cannot cross a thread or a task: V2 "
                                 "closures are confined to the thread that creates "
                                 "them");
                }
            }
            if (was_inline)
                pa_error("'async' 不能和 'inline' 一起用");
        }
    }
    CUR_RET_TY = ty_target(fn->type);
    CUR_TASK_TY = 0;
    CUR_TASK_VAL = 0;
    CUR_UNWIND_LBL = 0;
    if (PA_ASYNC) {
        /* `async T f(…)`：建 `struct f_task { T val; }` 并登记成普通 tag，
         * 函数的返回类型改成指向它的指针。调用方拿到任务结构地址，
         * `await t` 就是 `t->val`。 */
        char tnm[256] = {0};
        u32 tty = 0;
        u32 tag = 0;
        const char *fnm[8] = {0};
        u32 flen[8] = {0};
        u32 ftys[8] = {0};
        u32 rty0 = CUR_RET_TY;
        u32 ps[TY_PARAM_MAX] = {0};
        u32 np = 0;
        u32 pi = 0;
        Sym *tsym = NULL;

        snprintf(tnm, sizeof(tnm), "%.*s_task", (int)fn->len, fn->name);
        tag = 1u + (u32)(sym_hash_str(tnm, (u32)strlen(tnm)) & 0x7FFFFFFFu);
        ftys[0] = ty_ptr(ty_void());    /* m0..m3：托管形参的引用前缀 */
        ftys[1] = ftys[0];
        ftys[2] = ftys[0];
        ftys[3] = ftys[0];
        ftys[4] = ty_long();            /* kind：0 = 成功，1 = 出错 */
        ftys[5] = ty_long();            /* state：0 = NEW，-1 = DONE */
        ftys[6] = ty_long();            /* nmgd：前缀里填了几个 */
        ftys[7] = rty0;
        tty = ty_agg(ftys, NULL, 8, 0, tag);
        fnm[0] = "m0";
        flen[0] = 2;
        fnm[1] = "m1";
        flen[1] = 2;
        fnm[2] = "m2";
        flen[2] = 2;
        fnm[3] = "m3";
        flen[3] = 2;
        fnm[4] = "kind";
        flen[4] = 4;
        fnm[5] = "state";
        flen[5] = 5;
        fnm[6] = "nmgd";
        flen[6] = 4;
        fnm[7] = "val";
        flen[7] = 3;
        agg_names_set(tty, fnm, flen, 8);
        /* 和 `struct X` 一样：标签符号的 val 才是类型 id（漏了这步查不到） */
        tsym = sym_add_tag(tnm, (u32)strlen(tnm), tty);
        tsym->val = (i64)tty;
        np = ty_func_nparams(fn->type);
        if (np > TY_PARAM_MAX)
            np = TY_PARAM_MAX;
        for (pi = 0; pi < np; pi++) {
            ps[pi] = ty_func_param(fn->type, pi);
            if (ty_is_func(ps[pi])
                || (ty_is_ptr(ps[pi]) && ty_is_func(ty_target(ps[pi]))))
                pa_error("'async' 不支持函数指针参数（任务结构写不回去）");
        }
        fn->type = ty_func(ty_ptr(tty), ps, np, ty_func_variadic(fn->type));
        CUR_RET_TY = ty_ptr(tty);
        if (NTASKTY < TASK_TY_MAX)
            TASK_TY[NTASKTY++] = tty;
        if (getenv("C6C_DBG_TASK"))
            fprintf(stderr, "[reg] tty=%u n=%d\n", tty, (int)NTASKTY);
        if (CUR_FALLIBLE) {
            u32 e1 = irfn_vreg(&FN);
            u32 e3 = irfn_vreg(&FN);

            TASK_ERR_SLOT = frame_slots_for(8);
            irfn_push(&FN, IR_CALL, IRT_I64, (u16)e1, 0, 0, 0,
                      x64_sym(&X64, "__tcc_err_flag_get"));
            FN.ops[FN.n - 1].narg = 0;
            irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)e3, 0, 0, 0,
                      X64_SLOT(TASK_ERR_SLOT));
            irfn_push(&FN, IR_STORE, IRT_U64, (u16)e3, (u16)e1, 0, 0, 0);
        } else {
            TASK_ERR_SLOT = 0;
        }
        CUR_TASK_TY = tty;
        task_new();
        CUR_TASK_VAL = rty0;
        PA_ASYNC = 0;
    }
    /* 函数字面量的 `...` 只在声明符里记着（它的符号类型是先造出来的），
     * 两处都看，别让闭包体把自己当成定参函数——那样 rdi..r9 不进 va 区，
     * 体里的 va_arg 全读到 0。 */
    FN.is_variadic = (int)(ty_func_variadic(fn->type) || d->variadic);
    NLOOP = 0;
    NSW = 0;
    NGLBL = 0;
    scope_enter();
    /* 闭包体：捕获变量登记成"在环境对象里"的形参（slot 带标记位） */
    for (i = 0; i < FLCAP_N && i < FL_CAP_MAX; i++) {
        Sym *cp = sym_add(FLCAP_NAME[i], FLCAP_LEN[i], FLCAP_TY[i], SC_PARAM);

        cp->slot = CAP_SLOT_BIT | i;
    }
    if (METHOD_SELF_TY) {
        u32 s0 = irfn_vreg(&FN);
        Sym *ps = sym_add("self", 4, ty_ptr(METHOD_SELF_TY), SC_PARAM);

        FN.params[FN.nparams++] = s0;
        ps->slot = s0;
    }
    for (i = 0; i < d->nparams; i++) {
        u32 slot = irfn_vreg(&FN);
        Sym *p = NULL;

        FN.params[FN.nparams++] = slot;
        /* 形参声明成数组（典型：va_list ap）时，C 语义是"退化成指针"，
         * 槽里存的是指针本身——不退化的话 ap 会变成"槽的地址"（踩过一次）。 */
        {
            u32 pty = d->ptype[i];

            if (!pty)
                pty = ty_int();          /* K&R 参数默认 int */
            if (d->knr_conv && d->pknr[i]) {
                /* 旧式定义：实参是按**默认提升**传进来的（float→double、
                 * char/short→int），入口处要按赋值转换回来 */
                u32 from = 0;

                if (ty_is_float(pty) && ty_size(pty) < 8)
                    from = ty_double();
                else if (ty_is_int(pty) && ty_size(pty) < 4)
                    from = ty_int();
                if (from) {
                    u32 cv = gen_convert(slot, from, pty);

                    irfn_push(&FN, IR_MOV, ir_ty_of(pty), (u16)slot, (u16)cv, 0, 0, 0);
                }
            }
            if (ty_is_array(pty))
                pty = ty_ptr(ty_target(pty));
            if (d->pname[i])
                p = sym_add(d->pname[i], d->plen[i], pty, SC_PARAM);
            else
                p = sym_add("", 0, pty, SC_PARAM);
            if (d->pmgd[i])
                p->is_mgd = (u8)(d->pmgd[i] == 2 ? 2 : 1);
            if (d->pshared[i] && d->pmgd[i])
                p->is_shared = 1;
            /* `int *const p`：形参对象本身只读，赋值要报"只读位置" */
            if (d->pconst[i])
                p->is_const = 1;
                /* 托管形参是借来的：返回时才加计数；weak 形参要先升级 */
            if (ty_is_agg(pty) && ty_size(pty) > 0) {
                /* 聚合形参：收到的其实是个地址。给它一个真正的局部对象槽，
                 * 函数入口处把对象整块拷进来（和调用方的约定配套，见 gen_call）。 */
                u32 osz = ty_size(pty);
                u32 obj = frame_slots_for(osz);
                u32 addr = irfn_vreg(&FN);

                irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)addr, 0, 0, 0, X64_SLOT(obj));
                irfn_push(&FN, IR_COPY, IRT_U8, (u16)addr, (u16)slot, 0, 0, osz);
                slot = obj;
            }
        }
        p->slot = slot;
        /* 托管形参：任务自己持有一份引用（形参本身照旧是借来的）。
         * 这样创建者随后放手，任务也不会立刻断掉（tests/gc_async.c6）。 */
        if (CUR_TASK_TY && p->is_mgd && TASK_MG_N < TASK_MG_CAP) {
            u32 pa = irfn_vreg(&FN);
            u32 pv = irfn_vreg(&FN);
            u32 tk = task_get();
            u32 ma = irfn_vreg(&FN);

            irfn_push(&FN, IR_ADDR, IRT_PTR, (u16)pa, 0, 0, 0, X64_SLOT(slot));
            irfn_push(&FN, IR_LOAD, IRT_PTR, (u16)pv, (u16)pa, 0, 0, 0);
            mgd_retain(pv);
            irfn_push(&FN, IR_LEA, IRT_PTR, (u16)ma, (u16)tk, 0, 0,
                      task_off("m0", 2) + 8 * TASK_MG_N);
            irfn_push(&FN, IR_STORE, IRT_U64, (u16)ma, (u16)pv, 0, 0, 0);
            TASK_MG_N++;
        }
    }
    if (CUR_TASK_TY && TASK_MG_N) {
        u32 nv = irfn_vreg(&FN);
        u32 na = irfn_vreg(&FN);
        u32 tk = task_get();

        irfn_push(&FN, IR_CONST, IRT_U64, (u16)nv, 0, 0, 0, TASK_MG_N);
        irfn_push(&FN, IR_LEA, IRT_PTR, (u16)na, (u16)tk, 0, 0, task_off("nmgd", 4));
        irfn_push(&FN, IR_STORE, IRT_U64, (u16)na, (u16)nv, 0, 0, 0);
    }
    if (CUR_TASK_TY) {
        /* 起点闸门：任务结构和托管实参前缀都备好了，先把句柄交回创建者 */
        u32 gv = irfn_vreg(&FN);

        irfn_push(&FN, IR_CALL, IRT_VOID, (u16)gv, 0, 0, 0,
                  x64_sym(&X64, "__c6_co_gate"));
        FN.ops[FN.n - 1].narg = 0;
    }
    gen_block();
    /* 函数末尾没有 return 也要有出口（C 里 main 隐式 return 0，其它是 UB） */
    if (CUR_TASK_TY) {
        /* `async void f() { … }` 掉到末尾：也得交出一个任务结构，不然调用方
         * 拿到 NULL（`await fire()` 直接崩）。 */
        u32 dt = task_get();

        task_seal(dt);
        irfn_push(&FN, IR_RET, IRT_PTR, 0, (u16)dt, 0, 0, 0);
    } else {
        u32 zero = irfn_vreg(&FN);

        irfn_push(&FN, IR_CONST, IRT_I64, (u16)zero, 0, 0, 0, 0);
        irfn_push(&FN, IR_RET, IRT_I64, 0, (u16)zero, 0, 0, 0);
    }
    scope_leave();
    if (C99_MODE || llvm_mode()) {
        be_emit_fn(&FN, (u32)fn->val);
        return;
    }
    if (NFL > 0) {
        TmplSaved sv = {0};
        u32 n0 = FN.n;
        IrOp *bak = arena_alloc(&A_main, (size_t)(n0 ? n0 : 1) * sizeof(IrOp));

        if (n0)
            memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
        tmpl_save_state(&sv);
        fnlit_drain();
        tmpl_restore_state(&sv);
        if (n0)
            memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
    }
    x64_compile(&X64, &FN, (u32)fn->val);
    if (fn->alias) {
        /* 别名就是另一个名字指向同一份代码（PA 用的镜像里没有符号表，
         * 所以这只是"名字 → 偏移"表里再加一条）。 */
        u32 to = x64_sym(&X64, emit_name(fn->alias));

        if (!X64.sym[to].defined)
            x64_alias_idx(&X64, to, (u32)fn->val);
        fn->alias = NULL;
    }
}


/* 只有 `test "…" { }` 块、没有 main 的源文件（tests/ 下大多数就是这种）：
 * 合成一个入口，把每个 c6test_N() 跑一遍，**失败数当返回值**。
 * 这样 `c6c x.c6 -o x && ./x` 就能直接跑那 1157 个 test 块，
 * 不用等外部驱动。 */
static void synth_test_main(void)
{
    u32 i = 0;
    u32 acc = 0;
    u32 zero = 0;
    Sym *s = NULL;

    if (PA_MAIN || NTESTS == 0 || PA_SYNTAX_ONLY || PA_ERRS || DG.errors)
        return;
    irfn_reset(&FN, "main");
    memset(FSTR_SLOT, 0, sizeof(FSTR_SLOT));
    FSTR_DEPTH = 0;
    CUR_RET_TY = ty_int();
    FN.is_variadic = 0;
    zero = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_I64, (u16)zero, 0, 0, 0, 0);
    acc = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_I64, (u16)acc, 0, 0, 0, 0);
    for (i = 0; i < NTESTS; i++) {
        u32 r = irfn_vreg(&FN);
        u32 pf = 0;
        u32 msg = 0;
        u32 arg = 0;
        char line[160] = {0};
        u32 ln = 0;
        Sym *ps = sym_find("printf", 6);

        irfn_push(&FN, IR_CALL, IRT_I64, (u16)r, 0, 0, 0, TESTS[i]);
        /* 失败计数按"非 0 记 1"，不把返回值加起来（err() 的返回值大小没意义） */
        {
            u32 cc0 = irfn_vreg(&FN);

            /* 条件码放在 flags 域（irfn_push 的最后一个参数是 imm，不是 cc） */
            irfn_push(&FN, IR_CMP, IRT_I64, (u16)cc0, (u16)r, (u16)zero, 0, 0);
            FN.ops[FN.n - 1].flags = (u8)IRCC_NE;
            irfn_push(&FN, IR_ADD, IRT_I64, (u16)acc, (u16)acc, (u16)cc0, 0, 0);
        }
        if (!ps)
            goto acc_only;
        /* 哪条挂了要看得见：if (r) printf("FAIL %s\n", "test:…") */
        {
            u32 cc = irfn_vreg(&FN);
            u32 lp = irfn_label(&FN);
            u32 le = irfn_label(&FN);

            irfn_push(&FN, IR_CMP, IRT_I64, (u16)cc, (u16)r, (u16)zero, 0, 0);
            FN.ops[FN.n - 1].flags = (u8)IRCC_NE;
            irfn_push(&FN, IR_BR, IRT_VOID, 0, (u16)cc, (u16)lp, (u16)le, 0);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)lp, 0, 0, 0);
            ln = (u32)snprintf(line, sizeof(line), "FAIL %s\n",
                               TEST_NAMES[i] ? TEST_NAMES[i] : "?");
            if (getenv("C6C_DBG_TESTS"))
                fprintf(stderr, "[test] %s\n", TEST_NAMES[i] ? TEST_NAMES[i] : "?");
            msg = gen_str_from(line, ln);
            arg = irfn_vreg(&FN);
            irfn_push(&FN, IR_ARG, IRT_VOID, 0, (u16)msg, 0, 0, 0);
            pf = irfn_vreg(&FN);
            irfn_push(&FN, IR_CALL, IRT_I64, (u16)pf, 0, 0, 0, (u32)ps->val);
            irfn_push(&FN, IR_LABEL, IRT_VOID, 0, (u16)le, 0, 0, 0);
        }
    acc_only:
        ;
    }
    irfn_push(&FN, IR_RET, IRT_I64, 0, (u16)acc, 0, 0, 0);
    s = sym_add("main", 4, ty_func(ty_int(), NULL, 0, 0), SC_GLOBAL);
    s->is_func = 1;
    s->val = (i64)x64_sym(&X64, "main");
    PA_MAIN = s;
    if (C99_MODE || llvm_mode()) {
        be_emit_fn(&FN, (u32)s->val);
        return;
    }
    x64_compile(&X64, &FN, (u32)s->val);
}

/* ---------- 数据段重定位 ----------
 * 全局指针初始化器可能是"某个函数/全局的地址"，解析到这里时它的 VA 还没定
 * （函数甚至还没编译），所以先记 (数据偏移, 符号) 的对，等布局完成再回填。 */
#define DFIX_MAX 4096
static u32 DFIX_OFF[DFIX_MAX];
static u32 DFIX_SYM[DFIX_MAX];
static u32 NDFIX;

/* 数据段里 `&&label` 的重定位：地址要等代码段起点定下来才能算，所以先记
 * （数据段偏移，函数序号，标签 id），最后统一补。 */
#define CODE_LBL_MAX 4096
static u32 CLBL_OFF[CODE_LBL_MAX];
static u32 CLBL_FN[CODE_LBL_MAX];
static u32 CLBL_LBL[CODE_LBL_MAX];
static u32 NCLBL;

static void code_lbl_fixup_add(u32 data_off, u32 fnseq, u32 lbl)
{
    if (NCLBL >= CODE_LBL_MAX) {
        pa_error("数据段里的 &&标号 太多（上限 %d）", CODE_LBL_MAX);
        return;
    }
    CLBL_OFF[NCLBL] = data_off;
    CLBL_FN[NCLBL] = fnseq;
    CLBL_LBL[NCLBL] = lbl;
    NCLBL++;
}

static void data_fixup_drop_range(u32 lo, u32 hi)
{
    u32 i = 0;
    u32 k = 0;

    for (i = 0; i < NDFIX; i++) {
        if (DFIX_OFF[i] >= lo && DFIX_OFF[i] < hi)
            continue;
        DFIX_OFF[k] = DFIX_OFF[i];
        DFIX_SYM[k] = DFIX_SYM[i];
        k++;
    }
    NDFIX = k;
}

static void data_fixup_add(u32 data_off, u32 sym)
{
    if (NDFIX >= DFIX_MAX) {
        pa_error("数据段重定位太多（上限 %d）", DFIX_MAX);
        return;
    }
    DFIX_OFF[NDFIX] = data_off;
    DFIX_SYM[NDFIX] = sym;
    NDFIX++;
}

/* C99 后端的数据段：一块字节数组 + 初始化函数里补重定位 */
static void c99_emit_data(void)
{
    FILE *f = C99_OUT;
    u32 i = 0;
    u32 last = 0;

    for (i = 0; i < DATA_IMG.n; i++)
        if (DATA_IMG.p[i])
            last = i + 1;
    fprintf(f, "static void c6c_init_data(void)\n{\n");
    for (i = 0; i < last; i++)
        if (DATA_IMG.p[i])
            fprintf(f, "  D[%u] = %u;\n", i, (unsigned)DATA_IMG.p[i]);
    for (i = 0; i < NDFIX; i++) {
        char sn[256] = {0};

        c99_sym(DFIX_SYM[i], sn, sizeof(sn));
        if (X64.sym[DFIX_SYM[i]].is_data)
            fprintf(f, "  c6_st8(D + %u, (uint64_t)(uintptr_t)(D + %d));\n",
                    DFIX_OFF[i], (int)(X64.sym[DFIX_SYM[i]].off - (u32)ELF_HDR));
        else
            fprintf(f, "  c6_st8(D + %u, (uint64_t)(uintptr_t)&%s);\n", DFIX_OFF[i], sn);
    }
    for (i = 0; i < C99_NRL; i++)
        fprintf(f, "  c6_st8(D + %u, (uint64_t)(uintptr_t)(D + %u));\n", C99_RLOFF[i],
                C99_RLTGT[i]);
    fprintf(f, "}\n\n");
}

static void data_fixups_apply(void)
{
    u32 i = 0;

    for (i = 0; i < NDFIX; i++) {
        u64 va = (u64)X64.sym[DFIX_SYM[i]].va;
        u32 k = 0;

        for (k = 0; k < 8; k++)
            DATA_IMG.p[DFIX_OFF[i] + k] = (u8)(va >> (8 * k));
    }
}

/* 一个全局变量（声明已解析完类型和名字） */
static void gen_one_global(u32 ty, Declarator *d)
{
    Sym *s = NULL;
    u32 sz = 0;
    int was_inc = 0;
    int was_big = 0;
    int ate_eq = 0;      /* `[] = {…}` 那条路已经把 `=` 吃掉、把体重新压回源栈了 */
    u32 was_min = 0;     /* 收缩时不许低于这个长度（前面那条声明写死了长度时用） */

    if (!d->name)
        return;
    /* c6：文件作用域的对象也是"定义"，一样要写初始化器。`static`/`extern`
     * 例外：前者本来就落在数据段里（0），后者只是引用。 */
    if (in_c6_tu() && !PA_TMPL_BODY && !PA_SIG_ONLY && !PA_STATIC && !PA_EXTERN && !ty_is_func(ty)
        && !pa_is_ch('=') && !pa_is_ch('{'))
        pa_error("variable '%s' must be initialized",
                 arena_strndup(&A_main, d->name, d->nlen));
    if (ty_is_array(ty) && ty_array_n(ty) == 0 && pa_is_ch('=')
        && pa_peek(1)->kind == TK_STR) {
        /* `char s[] = "…"`（可能带相邻字面量拼接）：先把数据段写出来才知道
         * 元素个数，所以顺序反过来——先取字符串，再定类型、再登记符号。 */
        u32 off = 0;
        u32 n = 0;

        pa_advance();                  /* 吃掉 '=' */
        off = str_lit_data();
        n = STR_LIT_N + 1;
        ty = ty_array(ty_target(ty), n);
        s = sym_add(d->name, d->nlen, ty, SC_GLOBAL);
        s->goff = data_alloc(ty_size(ty), ty_align_of(ty));
        s->val = (i64)x64_data_sym(&X64, s->name, ELF_HDR + s->goff);
        memcpy(DATA_IMG.p + s->goff, DATA_IMG.p + off,
               (size_t)ty_size(ty) < (size_t)(WIDE_LIT ? n * 4 : n)
               ? (size_t)ty_size(ty) : (size_t)(WIDE_LIT ? n * 4 : n));
        return;
    }
    if (ty_is_array(ty) && ty_array_n(ty) == 0 && pa_is_ch('=')) {
        was_inc = 1;
        Tok *nx = pa_peek(1);

        if (nx->kind == TK_STR)
            ty = ty_array(ty_target(ty), (u32)(nx->len > 1 ? nx->len - 1 : 1));
        else if (nx->kind == TK_PUNCT && TOK_EQ(nx, "{")) {
            u32 esz = ty_size(ty_target(ty)) ? ty_size(ty_target(ty)) : 1;
            /* 以设计符开头的初始化器可能直接用很大的下标（`{[127] = …}`、
             * `{[0 ... 255] = …}`），按 1 KB 留地方会不够——够不着元素就只能
             * 把游标卡在末尾，数组长度和内容全错。这种给 64 KB 的余量，
             * 填完再把尾巴收回去（见下面 was_inc 那段）。 */
            Tok *a2 = pa_peek(2);

            if (a2 && a2->kind == TK_PUNCT && (TOK_EQ(a2, "[") || TOK_EQ(a2, "."))) {
                /* 8 KB 的余量：够 `{[0 ... 255] = …}` 这种（指针 2 KB、char 256 B），
                 * 又不至于把叶子数顶过 INIT_LF_MAX（16384）——顶过去会整块退回旧
                 * 实现，那边不认设计符，长度会算成 0。 */
                ty = ty_array(ty_target(ty), 8192u / esz);
                was_big = 1;
            } else {
                /* 顺序初始化：先把整个花括号体抓下来数顶层逗号，按数出来的
                 * 条数开数组，再放回去正常解析。前瞻窗口只有 16 个 token，
                 * 边解析边看是看不到头的；早先按 1 KB 估，元素一多就静默
                 * 截断（`struct S a[] = {…}` 只要 28 字节一条，36 条就满）。 */
                u32 ncap = 0;
                u32 bound = 0;
                Tok *body = arena_alloc(&A_main, (size_t)CAP_MAX * sizeof(Tok));

                pa_advance();              /* 吃掉 `=`，游标停到 `{` */
                ncap = body_capture(body, CAP_MAX);
                if (ncap >= CAP_MAX)
                    pa_error("初始化器太大（超过 token 上限）");
                bound = CAP_BOUND;
                /* `extern int a[10]; int a[] = {1, 2};`：长度按**前面那条
                 * 声明**走（C11 6.7.6.2p5），不能按初始化器的条数缩成 2。 */
                {
                    Sym *prev = sym_find(d->name, d->nlen);

                    if (prev && prev->kind == SC_GLOBAL && ty_is_array(prev->type)
                        && ty_array_n(prev->type) > bound) {
                        bound = ty_array_n(prev->type);
                        was_min = bound;
                    }
                }
                ty = ty_array(ty_target(ty), bound > 0 ? bound : 1);
                /* 预留按数出来的上界开（不再截断），最终长度仍按 INIT_COUNT
                 * 收——用实际写进去的元素数，才不会出现"声明得比写得多、
                 * 尾巴是垃圾"的情况。 */
                was_big = 1;
                ate_eq = 1;
                pa_src_push_back(body, ncap);
            }
        }
    }
    /* `extern int math__counter;`（纯 C 一侧引用模块全局）：符号已经有了，
     * 绑定过去就行，别再给它另开一段存储——另开的话读到的是 0（tests/abi/
     * module.c6 的 `math__counter != 7` 就是这么来的）。`sym_find` 里带着
     * "剥模块前缀再查一遍"的回退，所以 `math__counter` 会落到 `counter` 上。 */
    if (PA_EXTERN) {
        Sym *ex = sym_find(d->name, d->nlen);

        if (ex && ex->kind == SC_GLOBAL && ex->goff) {
            ex->is_extern = 1;
            return;
        }
    }
    s = sym_add(d->name, d->nlen, ty, SC_GLOBAL);
    sz = ty_size(ty) ? ty_size(ty) : 8;
    s->goff = data_alloc(sz, ty_align_of(ty));
    s->val = (i64)x64_data_sym(&X64, s->name, ELF_HDR + s->goff);
    /* `__thread`：存储照旧在数据段里（初始化器一条都不用改），只是访问换成
     * `%fs + goff`，并把 [goff, goff+sz) 记进 TLS 影像范围。 */
    if (PA_TLS) {
        s->is_tls = 1;
        tls_note(s->goff, sz);
    }
    if (d->mgd)
        s->is_mgd = (u8)(d->mgd_kind == 1 ? 2 : 1);
    if (ty == ty_thread() && PA_TASK_KW == 1)
        pa_error("task 只能在函数里声明");   /* 全局托管量：2 = 弱 */
    if (!ate_eq && !pa_accept_ch('='))
        return;
    if (pa_is_ch('{')) {
        u32 et = ty_is_array(ty) ? ty_target(ty) : 0;
        u32 end_alloc = DATA_IMG.n;

        gen_glob_braced_new(s->goff, ty, 0);
        if (was_inc && et && ty_is_array(s->type)) {
            u32 real = INIT_CNT_OK ? INIT_COUNT : 1;

            if (real < was_min)
                real = was_min;
            s->type = ty_array(et, real);
            /* 预留的尾巴收回来。只有当它仍是数据段末尾时才安全（初始化器里
             * 要是有字符串字面量，字面量已经排在后面了，那就留着这块空地）。 */
            if (was_big && DATA_IMG.n == end_alloc) {
                u32 real = s->goff + ty_size(s->type);

                if (real < DATA_IMG.n)
                    DATA_IMG.n = real;
            }
        }
        return;
    }
    if ((ty_is_agg(ty) || ty_is_array(ty)) && pa_is_compound_lit()) {
        /* `struct P g = (struct P){ 1, 2 };` —— 数据段也吃复合字面量 */
        u32 ex = pa_take_paren_type();

        gen_glob_braced_new(s->goff, ty, 0);
        while (ex--)
            pa_expect_ch(')');
        return;
    }
    if (pa_cur()->kind == TK_STR) {
        u32 off = str_lit_data();
        u32 n = 0;

        while (DATA_IMG.p[off + n] && n < sz)
            n++;
        if (ty_is_array(ty)) {
            u32 k = n + 1 < sz ? n + 1 : sz;

            memcpy(DATA_IMG.p + s->goff, DATA_IMG.p + off, k);
        } else if (ty_is_ptr(ty)) {
            u64 va = (u64)DATA_VA(off);
            u32 i2 = 0;

            for (i2 = 0; i2 < 8; i2++)
                DATA_IMG.p[s->goff + i2] = (u8)(va >> (8 * i2));
            c99_reloc_add(s->goff, off);
        } else {
            pa_error("字符串初始化器只能给数组或指针");
        }
        return;
    }
    /* 文件作用域的函数字面量：`static int (*f)(int) = int(int v) { … };`
     * 数据段里存的就是那个隐藏函数的地址（和 `&func` 同一套重定位）。 */
    if (ty_is_ptr(ty) && pa_at_typename() && pa_peek(1)->kind == TK_PUNCT
        && tok_eq(pa_peek(1), "(")) {
        int ldep = 0;
        int lq = 0;
        int lhit = 0;

        for (lq = 1; lq < PA_LOOK; lq++) {
            Tok *t2 = pa_peek(lq);

            if (t2->kind != TK_PUNCT)
                continue;
            if (tok_eq(t2, "(")) {
                ldep++;
            } else if (tok_eq(t2, ")")) {
                ldep--;
                if (ldep == 0) {
                    Tok *nx = pa_peek(lq + 1);

                    lhit = (nx->kind == TK_PUNCT && TOK_EQ(nx, "{"));
                    break;
                }
            }
        }
        if (lhit) {
            Sym *fs = fnlit_parse_sym();

            if (fs)
                data_fixup_add(s->goff, (u32)fs->val);
            return;
        }
    }
    /* `&&label`：计算 goto 的标号地址（数据段里也照样支持） */
    if (ty_is_ptr(ty) && pa_is_punct("&&") && pa_peek(1)->kind == TK_IDENT) {
        u32 l = goto_label(tok_data(pa_peek(1)), pa_peek(1)->len);

        pa_advance();
        pa_advance();
        code_lbl_fixup_add(s->goff, x64_cur_fnseq(&X64), l);
        return;
    }
    /* `&x` / 函数名 / `&arr[0]` 这类地址常量：留给布局后回填 */
    if (ty_is_ptr(ty)) {
        int took = 0;
        int amp = pa_accept_ch('&');

        if (amp && gen_glob_compound_addr(s->goff))
            return;
        if (pa_cur()->kind == TK_IDENT) {
            Sym *t = sym_find(tok_data(pa_cur()), pa_cur()->len);

            if (t && (t->kind == SC_GLOBAL || t->is_func)) {
                u32 sym = (u32)t->val;

                if (t->is_func)
                    sym = x64_sym(&X64, arena_strndup(&A_main, tok_data(pa_cur()), pa_cur()->len));
                pa_advance();
                if (!pa_is_ch('[') && !pa_is_ch('.') && !pa_is_ch('+')
                    && !pa_is_ch('-')) {
                    data_fixup_add(s->goff, sym);
                    took = 1;
                }
            }
        }
        if (took)
            return;
        if (amp)
            pa_error("全局地址初始化器只支持 &全局/函数");
    }
    /* 文件作用域切片的初始化器：`{ data, len }` 才对，拿数组/指针直接初始化
     * 只会把符号索引当 data、len 留 0（静默错）。两条诊断分开报：
     * 长度未知的数组根本切不了，其他情况是"静态初始化器要写成两个字"。
     * （tests/errors/slice.c6 的 test_file_scope_array / test_unknown_length） */
    /* 静态存储期的闭包（文件作用域或块作用域的 `static`）：闭包对象是运行期
     * 现开的，不是常量表达式，只能用 NULL 起步
     * （tests/errors/closure_convert.c6 的 test_static / test_static_local）。 */
    if (ty_is_closure(ty, NULL) && in_c6_tu()) {
        Tok *c0 = pa_cur();
        int cnull = 0;

        if (c0 && c0->kind == TK_NUM && tok_data(c0)[0] == '0')
            cnull = 1;
        if (c0 && c0->kind == TK_IDENT
            && (TOK_EQ(c0, "NULL") || TOK_EQ(c0, "nullptr")))
            cnull = 1;
        /* `((void *)0)` 这种（NULL 的展开）也算空值 */
        if (c0 && c0->kind == TK_PUNCT && tok_eq(c0, "("))
            cnull = 1;
        if (!cnull)
            pa_error("a closure is not a constant expression: initialize it at run "
                     "time ('NULL' is fine at file scope)");
    }
    if (ty_is_slice(ty) && in_c6_tu()) {
        Tok *t0 = pa_cur();
        int unknown_len = 0;

        if (t0 && t0->kind == TK_IDENT) {
            Sym *is = sym_find(tok_data(t0), t0->len);

            if (is && ty_is_array(is->type) && ty_array_n(is->type) == 0)
                unknown_len = 1;
        }
        if (unknown_len)
            pa_error("cannot slice an array of unknown length");
        else
            pa_error("a slice cannot be initialized from an array in a static "
                     "initializer; use '{ data, len }'");
    }
    if (ty_is_float(ty)) {
        /* 全局浮点初始化器：字面量（或整型常量）→ IEEE-754 位模式。
         * 以前这里走整型的 const_expr，`double x = 0.1;` 直接变成 0。 */
        u64 bits = 0;
        int neg = 0;

        (void)neg;
        {
            double dv = 0;

            if (pa_cur()->kind == TK_NUM || pa_is_ch('-') || pa_is_ch('+')
                || pa_is_ch('(')) {
                int ok = 1;

                dv = const_fexpr(&ok);
                if (!ok)
                    dv = 0;
            } else {
                dv = (double)const_expr();
            }
            if (ty_size(ty) == 4) {
                u32 b32 = 0;
                float fv = (float)dv;

                *(float *)&b32 = fv;
                bits = (u64)b32;
            } else {
                *(double *)&bits = dv;
            }
        }
        glob_store(s->goff, 0, ty, bits);
        return;
    }
    {
        i64 v = 0;

        v = const_expr();
        glob_store(s->goff, 0, ty, (u64)v);
    }
}

/* 引用环：托管字段（`@T` / `@T[]`，不含 `own`/`weak`）连起来的图里如果有环，
 * 对象永远退不到 0，等于泄漏。从每个类型出发做一遍 DFS，回到自己就报
 * （tests/errors/gc_cycle.c6）。
 *
 * 检查在**所有翻译单元都解析完之后**跑一次（pa_compile_ex 里 pa_parse_tu()
 * 之后）：命令行上的多个源文件是接连压进预处理器文件栈、当成一个 TU 解析的
 * （main.c6），所以第二个单元定义的结构体也在同一张类型/MGDST 表里。环上
 * 的节点定义在不同文件时报「跨翻译单元」的形状
 * （tests/errors/gc_cycle_cross_tu.c6 + tests/tu/gc_cycle_cross_tu.c6）。 */
#define CYC_STACK 16
static u32 CYC_PATH[CYC_STACK];
static int CYC_N;
static int CYC_ERR_SEEN;

static int cyc_edges(u32 ty, u32 *out, int cap)
{
    u32 k = mgdst_find(ty);
    int n = 0;
    u32 j = 0;

    if (k == 0xFFFFFFFFu)
        return 0;
    for (j = 0; j < MGDST_N[k] && n < cap; j++) {
        u32 idx = (u32)MGDST_IDX[k][j];
        u8 kind = MGDST_KIND[k][j];
        u32 mty = 0;

        if (kind == 2 || kind == 4)
            continue;                   /* 弱引用 / own 都不是强边 */
        if (idx >= ty_member_n(ty))
            continue;
        mty = ty_member(ty, idx);
        /* `@T[]` 字段：先看元素类型 */
        if (ty_is_array(mty))
            mty = ty_target(mty);
        if (ty_is_ptr(mty))
            mty = ty_target(mty);
        if (ty_is_agg(mty))
            out[n++] = mty;
    }
    return n;
}

/* 往诊断文案里拼一节：snprintf 返回的是"本该写多长"，缓冲区满了还按它
 * 累加偏移就越界了（16 层的环配上 "struct XXX" 比 512 字节长）。 */
static u32 cyc_put(char *buf, u32 cap, u32 o, const char *fmt, const char *s)
{
    if (o + 1 < cap)
        o += (u32)snprintf(buf + o, (size_t)(cap - o), fmt, s);
    return o < cap ? o : cap - 1;
}

static void cyc_dfs(u32 start, u32 ty, int depth)
{
    u32 nxt[16] = {0};
    int n = 0;
    int i = 0;

    if (depth > CYC_STACK - 2 || CYC_ERR_SEEN)
        return;
    n = cyc_edges(ty, nxt, 16);
    for (i = 0; i < n; i++) {
        if (nxt[i] == start) {
            char chain[512] = {0};
            u32 q = 0;
            u32 o = 0;
            int cross = 0;
            u32 f0 = mgd_file(start);

            /* 环上的节点是不是都定义在同一个翻译单元里？不是就是跨 TU 的
             * 环：这次编译把命令行上的所有 TU 接连编在一起（main.c6），
             * 所以类型表里看得见第二个 TU 定义的结构体
             * （tests/errors/gc_cycle_cross_tu.c6）。 */
            for (q = 0; q < (u32)CYC_N; q++)
                if (mgd_file(CYC_PATH[q]) != f0)
                    cross = 1;
            if (cross) {
                const char *tn = sym_tag_name(start);

                /* 跨 TU 的文案跟上游一致：不带字段名，节点用裸标签名。 */
                o = cyc_put(chain, (u32)sizeof(chain), o, "%s",
                            tn ? tn : ty_disp(start));
                for (q = 0; q < (u32)CYC_N; q++) {
                    const char *tq = sym_tag_name(CYC_PATH[q]);

                    o = cyc_put(chain, (u32)sizeof(chain), o, " -> %s",
                                tq ? tq : ty_disp(CYC_PATH[q]));
                }
                o = cyc_put(chain, (u32)sizeof(chain), o, " -> %s",
                            tn ? tn : ty_disp(start));
                pa_error("reference cycle across translation units: %s; "
                         "break it with 'weak' or 'own'", chain);
                CYC_ERR_SEEN = 1;
                return;
            }
            o = cyc_put(chain, (u32)sizeof(chain), o, "%s", ty_disp(start));
            for (q = 0; q < (u32)CYC_N; q++)
                o = cyc_put(chain, (u32)sizeof(chain), o, " -> %s",
                            ty_disp(CYC_PATH[q]));
            o = cyc_put(chain, (u32)sizeof(chain), o, " -> %s", ty_disp(start));
            pa_error("reference cycle: %s; break it with 'weak' or 'own'", chain);
            CYC_ERR_SEEN = 1;
            return;
        }
        {
            int seen = 0;
            u32 q2 = 0;
            int d2 = depth;

            for (q2 = 0; q2 < (u32)CYC_N; q2++)
                if (CYC_PATH[q2] == nxt[i])
                    seen = 1;
            if (seen || nxt[i] == start)
                continue;
            CYC_PATH[CYC_N++] = nxt[i];
            cyc_dfs(start, nxt[i], d2 + 1);
            CYC_N--;
        }
    }
}

static void gc_cycle_check(void)
{
    u32 k = 0;

    CYC_ERR_SEEN = 0;
    for (k = 0; k < NMGDST; k++) {
        u32 ty = MGDST_TY[k];

        CYC_N = 0;
        cyc_dfs(ty, ty, 0);
        if (CYC_ERR_SEEN)
            return;
    }
}

static void pa_parse_tu(void)
{
    u16 decl_file = 0xFFFF;      /* 上一个顶层声明在哪个文件里（MODFIRST 用） */
    int any_decl = 0;

    while (pa_cur()->kind != TK_EOF) {
        u32 base = 0;
        Declarator d = {0};
        u32 ty = 0;
        Sym *s = NULL;

        if (pa_accept_ch(';'))
            continue;
        /* 文件作用域 asm（定义符号用）：必须在 parse_typespec 之前认——
         * 那边 skip_attributes 会把 `asm` 当属性关键字默默吃掉。 */
        if (try_toplevel_asm())
            continue;
        if (PA_IS_IDENT("foreach") && c6_kw())
            pa_error("'foreach' can only be used inside a function");
        /* 模块声明（改写阶段把 `module a.b;` 换成了这条）：
         *   - 必须是本文件里的第一个声明；
         *   - 同一个文件不许写两次；
         *   - 模块里不许有 `main`（见下面定义处）。
         * 判定放在这儿才看得见 `#if` 之后剩下的那份文本
         * （tests/errors/module.c6）。 */
        if (PA_IS_IDENT("__c6_module_decl") && pa_peek(1)
            && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")) {
            char mnm[200] = {0};
            u32 ml = 0;
            u16 mfile = pa_cur()->file;   /* CUR_FILE 在解析期是 NULL，用 token 的 */

            pa_advance();
            pa_advance();
            if (pa_cur()->kind == TK_STR) {
                const char *sd = tok_data(pa_cur());
                u32 sl = pa_cur()->len;

                /* 字符串 token 的文本带引号，去掉 */
                if (sl >= 2 && sd[0] == '"') {
                    sd++;
                    sl -= 2;
                }
                ml = sl < sizeof(mnm) - 1 ? sl : sizeof(mnm) - 1;
                memcpy(mnm, sd, ml);
                mnm[ml] = 0;
                pa_advance();
            }
            pa_expect_ch(')');
            (void)pa_accept_ch(';');
            if (ml) {
                if (mod_of_file((u32)mfile))
                    pa_error("module '%s' already declared in this file", mnm);
                else if (any_decl && decl_file == mfile)
                    pa_error("'module' must be the first declaration in the file");
                else
                    mod_set_file((u32)mfile, mod_intern(mnm));
            }
            continue;
        }
        decl_file = pa_cur()->file;
        any_decl = 1;
        /* `co f();` 是语句，文件作用域上没有意义（软关键字：后面跟
         * `标识符 (` 才算，`co` 自己也还能是普通名字）。 */
        if (PA_IS_IDENT("co") && c6_kw() && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
            && pa_peek(2) && pa_peek(2)->kind == TK_PUNCT && tok_eq(pa_peek(2), "(")
            && !sym_find(tok_data(pa_cur()), pa_cur()->len))
            pa_error("'co' 只能在函数里用");
        /* c6 角色宏定义：`stmt swap(expr a, expr b) { … }` */
        if (cm_try_define())
            continue;
        /* 文件作用域上也能用宏展开出声明：展开了就重来一轮 */
        if (cm_expand(-1))
            continue;
        /* c6 的 `test "名字" { … }` 块：当函数编，失败返回非 0 */
        if (PA_IS_IDENT("test") && c6_kw()
            && (pa_peek(1)->kind == TK_STR || TOK_EQ(pa_peek(1), "{"))) {
            char nm[128] = {0};
            Declarator td = {0};

            pa_advance();
            if (pa_cur()->kind == TK_STR) {
                /* 名字太长就截断，但别把 UTF-8 多字节字符从中间切开——
                 * 中文名 3 字节一个字，卡在中间就输出半个字符（报告里全是
                 * "失败样例：…任务前缀持有"这种断尾巴）。 */
                u32 nl0 = pa_cur()->len > 100 ? 100 : pa_cur()->len;
                const char *nd0 = tok_data(pa_cur());

                while (nl0 > 0 && nl0 < pa_cur()->len && ((u8)nd0[nl0] & 0xC0) == 0x80)
                    nl0--;
                snprintf(nm, sizeof(nm), "test:%.*s", (int)nl0, nd0);
                pa_advance();
            } else {
                snprintf(nm, sizeof(nm), "test#%u", NTESTS);
            }
            {
                char fn[64] = {0};

                snprintf(fn, sizeof(fn), "c6test_%u", NTESTS);
                td.name = arena_strdup(&A_main, fn);
                td.nlen = (u32)strlen(fn);
                td.is_func = 1;
                td.type = ty_func(ty_int(), NULL, 0, 0);
                PA_FALLIBLE = 1;    /* test 块可以把错误往上报（try/catch） */
                s = sym_add(td.name, td.nlen, td.type, SC_GLOBAL);
                s->is_func = 1;
                s->val = (i64)x64_sym(&X64, emit_name(td.name));
                if (NTESTS < 512) {
                    TESTS[NTESTS] = (u32)s->val;
                    TEST_NAMES[NTESTS] = arena_strdup(&A_main, nm);
                    NTESTS++;
                }
                pa_func_def(s, &td);
            }
            continue;
        }
        /* c6 的模块头：`module a.b.c;` / `import a.b.c;`（可能带 `as x`）。
         * c6c 是 C 前端，模块/导入暂不作语义处理——先把它们当"声明"吃掉，
         * 这样一个模块文件本身就能按 C 编译（c6 的扩展语法另算）。 */
        if (c6_kw() && (PA_IS_IDENT("module") || PA_IS_IDENT("import"))) {
            int is_mod = PA_IS_IDENT("module");
            char path[256] = {0};
            int pn = 0;

            pa_advance();
            /* `import a.b.c;` → 模块文件 a/b/c.c6。单 TU 口径：把模块源码
             * 文本内联进来（模块系统真正的导出改名/pic 还没做，见 todo）。 */
            while (pa_cur()->kind != TK_EOF && !pa_is_ch(';')) {
                if (pa_cur()->kind == TK_IDENT && pn < 240) {
                    u32 k = 0;

                    for (k = 0; k < pa_cur()->len && pn < 240; k++)
                        path[pn++] = tok_data(pa_cur())[k];
                } else if (pa_is_ch('.') && pn < 240) {
                    path[pn++] = '/';
                } else if (pa_is_ch('{')) {
                    skip_paren_group();
                    continue;
                }
                pa_advance();
            }
            if (pa_is_ch(';'))
                pa_advance();
            if (pn + 4 < 250) {
                path[pn] = 0;
                path[pn] = '.';
                path[pn + 1] = 'c';
                path[pn + 2] = '6';
                path[pn + 3] = 0;
                /* TODO(modules)：这里应该把模块源码内联进来。先把语法吃掉，
                 * 真导入等 pp 栈与解析器当前 token 的同步理清（见 todo P6-1b）。 */
                (void)is_mod;
            }
            continue;
        }
        if (try_pack_directive())
            continue;
        if (PA_ACCEPT_IDENT("_Static_assert") || PA_ACCEPT_IDENT("static_assert")) {
            parse_static_assert_rest();
            continue;
        }
        if (c6_kw() && PA_ACCEPT_IDENT("interface")) {
            const char *inm = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : "";
            u32 iln = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
            u32 idx = NIFACE;

            if (pa_cur()->kind == TK_IDENT)
                pa_advance();
            if (NIFACE < IFACE_MAX && iln) {
                IFACE_NAME[NIFACE] = arena_strndup(&A_main, inm, iln);
                IFACE_NLEN[NIFACE] = iln;
                IFACE_NM[NIFACE] = 0;
                IFACE_TY[NIFACE] = 0;
                NIFACE++;
            } else {
                idx = IFACE_MAX;
            }
            pa_expect_ch('{');
            PA_IN_PROTO = 1;
            while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF) {
                u32 rty = parse_typespec();

                while (pa_accept_ch('*'))
                    rty = ty_ptr(rty);
                if (pa_cur()->kind == TK_IDENT) {
                    if (idx < IFACE_MAX && IFACE_NM[idx] < IFACE_NMET) {
                        u32 k = IFACE_NM[idx];

                        IFACE_RET[idx][k] = rty;

                        IFACE_MET[idx][k] = arena_strndup(&A_main, tok_data(pa_cur()),
                                                          pa_cur()->len);
                        IFACE_MLEN[idx][k] = pa_cur()->len;
                        IFACE_NM[idx] = k + 1;
                    }
                    pa_advance();
                }
                /* 形参类型要记下来：判断"某个类型实现了这个接口"时要逐个比 */
                if (pa_is_ch('(') && idx < IFACE_MAX && IFACE_NM[idx] > 0) {
                    u32 kk = IFACE_NM[idx] - 1;
                    u32 npf = 0;

                    pa_advance();
                    if (!pa_accept_ch(')')) {
                        for (;;) {
                            Declarator pd2 = {0};
                            int new_tag = 0;
                            u32 pt2 = 0;

                            if ((PA_IS_IDENT("struct") || PA_IS_IDENT("union")
                                 || PA_IS_IDENT("enum"))
                                && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
                                && !sym_find_tag(tok_data(pa_peek(1)), pa_peek(1)->len))
                                new_tag = 1;
                            pt2 = parse_typespec();
                            if (new_tag && ty_is_agg(pt2))
                                proto_tag_mark(pt2);

                            (void)parse_declarator(pt2, &pd2);
                            if (pd2.type)
                                pt2 = pd2.type;
                            if (npf < IFACE_NPARAM)
                                IFACE_PTY[idx][kk][npf] = pt2;
                            npf++;
                            if (!pa_accept_ch(','))
                                break;
                        }
                        pa_expect_ch(')');
                    }
                    IFACE_NP[idx][kk] = npf;
                }
                if (!pa_accept_ch(';'))
                    break;
            }
            PA_IN_PROTO = 0;
            pa_expect_ch('}');
            (void)pa_accept_ch(';');
            if (idx < IFACE_MAX) {
                (void)ty_iface(idx);
            }
            continue;
        }
        if (PA_ACCEPT_IDENT("typedef")) {
            Declarator d2 = {0};
            u32 b2 = parse_typespec();
            u32 t2 = parse_declarator(b2, &d2);

            if (d2.name)
                sym_add(d2.name, d2.nlen, t2, SC_TYPEDEF);
            pa_expect_ch(';');
            continue;
        }
        SAW_CTOR = 0;
        SAW_DTOR = 0;
        PA_STATIC = 0;
        PA_EXTERN = 0;
        /* 函数模板定义：`|T| T f(…) { … }`——只捕获 token，调用点再重放 */
        if (pa_is_ch('|')) {
            const char *pn[4] = {0};
            u32 pl[4] = {0};
            int pk[4] = {0};
            u32 pvty[4] = {0};
            u32 np = 0;
            u32 ntok = 0;
            u32 i2 = 0;
            u32 name_i = 0;
            u32 body_i = 0;
            int found_name = 0;
            int found_body = 0;

            pa_advance();
            while (np < 4 && pa_cur()->kind == TK_IDENT) {
                /* `|T|` 类型形参；`|int N|` 值形参（按常量绑定） */
                if (pa_peek(1)->kind == TK_IDENT) {
                    u32 vpty = parse_typespec();

                    /* 值形参按常量绑定，比 int 宽的整型搬不动
                     * （tests/errors/generic.c6 的 test_value_param_type）。 */
                    if (vpty && ty_size(vpty) > 4)
                        pa_error("a value parameter must be an integer type no wider "
                                 "than 'int'");
                    if (pa_cur()->kind != TK_IDENT)
                        break;
                    pn[np] = tok_data(pa_cur());
                    pl[np] = pa_cur()->len;
                    pk[np] = 1;
                } else if (is_typename_tok(pa_cur())) {
                    /* `|int| void f(void);`：值形参得写 `<类型> 名字>` */
                    pa_error("a value parameter is written '<type> NAME'");
                    pn[np] = tok_data(pa_cur());
                    pl[np] = pa_cur()->len;
                    pk[np] = 0;
                } else {
                    u32 dj = 0;

                    for (dj = 0; dj < np; dj++)
                        if (pl[dj] == pa_cur()->len
                            && memcmp(pn[dj], tok_data(pa_cur()), pl[dj]) == 0)
                            pa_error("duplicate type parameter '%.*s'",
                                     (int)pl[dj], pn[dj]);
                    /* 形参名和已有模板同名：`|Vect| … Vect@…` 里那个 Vect 到底
                     * 是形参还是模板看不出来（tests/errors/generic.c6 的
                     * test_same_name）。 */
                    if (tmpl_find(tok_data(pa_cur()), pa_cur()->len))
                        pa_error("a type parameter cannot have the same name as its "
                                 "template");
                    pn[np] = tok_data(pa_cur());
                    pl[np] = pa_cur()->len;
                    pk[np] = 0;
                }
                np++;
                pa_advance();
                if (!pa_accept_ch(','))
                    break;
            }
            pa_expect_ch('|');
            ntok = tmpl_capture_body();
            /* `|T| typedef <spec> <名字>;`：typedef 模板。体里没有 `{`，
             * 实例化时按 `typedef` 后面那段重新解析一遍。 */
            if (ntok >= 3 && CAP_TOK[0].kind == TK_IDENT
                && TOK_EQ(&CAP_TOK[0], "typedef")) {
                u32 lastid = ntok;
                u32 q3 = 0;
                int has_brace = 0;

                for (q3 = 0; q3 < ntok; q3++)
                    if (CAP_TOK[q3].kind == TK_PUNCT && TOK_EQ(&CAP_TOK[q3], "{"))
                        has_brace = 1;
                if (!has_brace) {
                    /* `|T| typedef T *Ptr;`：体里没有花括号，`tmpl_capture_body`
                     * 一直吃到了文件尾，这里截到第一个 `;`。 */
                    for (q3 = 0; q3 < ntok; q3++)
                        if (CAP_TOK[q3].kind == TK_PUNCT && TOK_EQ(&CAP_TOK[q3], ";")) {
                            ntok = q3 + 1;
                            break;
                        }
                } else {
                    /* 有花括号时捕捉停在 `}`，后面的 `<名字> ;` 还没吃到——
                     * 解析器正好停在那里，接着收。 */
                    while (ntok < CAP_MAX && pa_cur()->kind != TK_EOF) {
                        int done = pa_is_ch(';');

                        CAP_TOK[ntok++] = *pa_cur();
                        pa_advance();
                        if (done)
                            break;
                    }
                }
                for (q3 = ntok; q3 > 0; q3--)
                    if (CAP_TOK[q3 - 1].kind == TK_IDENT
                        && !TOK_EQ(&CAP_TOK[q3 - 1], "typedef")) {
                        lastid = q3 - 1;
                        break;
                    }
                if (lastid < ntok && NTMPL < TMPL_MAX) {
                    Tmpl *t2 = &TMPL[NTMPL++];

                    memset(t2, 0, sizeof(*t2));
                    t2->name = arena_strndup(&A_main, tok_data(&CAP_TOK[lastid]),
                                             CAP_TOK[lastid].len);
                    t2->nlen = CAP_TOK[lastid].len;
                    t2->nparam = np;
                    for (q3 = 0; q3 < np; q3++) {
                        t2->param[q3] = arena_strndup(&A_main, pn[q3], pl[q3]);
                        t2->plen[q3] = pl[q3];
                        t2->pkind[q3] = pk[q3];
                    }
                    t2->is_typedef = 1;
                    t2->n = ntok - 1;
                    t2->toks = arena_alloc(&A_main,
                                           (size_t)(t2->n ? t2->n : 1) * sizeof(Tok));
                    if (t2->n)
                        memcpy(t2->toks, &CAP_TOK[1], (size_t)t2->n * sizeof(Tok));
                    continue;
                }
            }
            for (i2 = 0; i2 < ntok; i2++) {
                Tok *q = &CAP_TOK[i2];

                if (!found_body && q->kind == TK_PUNCT && TOK_EQ(q, "{")) {
                    body_i = i2;
                    found_body = 1;
                }
            }
            /* 没有体（前置声明）时名字仍要找到，所以扫到 `ntok` 为止。 */
            for (i2 = 0; i2 < (found_body ? body_i : ntok); i2++) {
                Tok *q = &CAP_TOK[i2];

                /* 函数名 = 紧挨在 `(` 前面的**标识符**。`Map@(K, V)` 里的
                 * `@` 也是紧挨着 `(` 的，那不是名字。 */
                if (q->kind == TK_PUNCT && tok_eq(q, "(") && i2 > 0
                    && CAP_TOK[i2 - 1].kind == TK_IDENT) {
                    name_i = i2 - 1;
                    found_name = 1;
                    break;
                }
            }
            /* 只有名字、没有体：那是**前置声明**（`|K, V| V second(Map@… *m);`），
             * 登记一个 `n == 0` 的模板，实例化时按"没有体"处理即可。 */
            if (!found_name) {
                pa_error("函数模板：找不到函数名");
                continue;
            }
            /* 前置声明：同名的模板已经有**带体**的登记就直接跳过——后面那个
             * 才是能实例化出函数体的那个（`tmpl_find` 只返回第一个）。 */
            if (!found_body) {
                Tmpl *ex = tmpl_find(tok_data(&CAP_TOK[name_i]), CAP_TOK[name_i].len);

                if (ex)
                    continue;
            }
            if (NTMPL < TMPL_MAX) {
                Tmpl *t = &TMPL[NTMPL++];
                u32 q2 = 0;

                /* 带体的定义来了：如果同名模板只有**前置声明**（n == 0），
                 * 就地替换掉它——`tmpl_find` 只返回第一个，留着声明就永远
                 * 实例化不出函数体。 */
                if (found_body && t > TMPL) {
                    Tmpl *old_t = tmpl_find(tok_data(&CAP_TOK[name_i]),
                                            CAP_TOK[name_i].len);

                    if (old_t && old_t->n == 0) {
                        t = old_t;
                        NTMPL--;
                    }
                }
                memset(t, 0, sizeof(*t));
                t->name = arena_strndup(&A_main, tok_data(&CAP_TOK[name_i]),
                                        CAP_TOK[name_i].len);
                t->nlen = CAP_TOK[name_i].len;
                t->nparam = np;
                for (q2 = 0; q2 < np; q2++) {
                    t->param[q2] = arena_strndup(&A_main, pn[q2], pl[q2]);
                    t->plen[q2] = pl[q2];
                    t->pkind[q2] = pk[q2];
                }
                t->is_func = 1;
                t->name_i = name_i;
                t->body_i = body_i;
                t->n = found_body ? ntok : 0;
                t->toks = arena_alloc(&A_main, (size_t)(ntok ? ntok : 1) * sizeof(Tok));
                if (ntok)
                    memcpy(t->toks, CAP_TOK, (size_t)ntok * sizeof(Tok));
            }
            continue;
        }
        base = parse_typespec();
        if (ty_is_taskh(base))
            pa_error("'task' can only be used inside a function");
        gen_decl_from_spec(base);
        tmpl_drain();
    }
    /* 最后一次顶层声明里登记的模板实例化（以及函数字面量）还要再排空一次，
     * 否则它们只在符号表里有个名字、没有函数体，链接时才报"未定义的符号"。 */
    tmpl_drain();
}
static void tmpl_save_state(TmplSaved *sv)
{
    sv->fn = FN;
    sv->ret = CUR_RET_TY;
    sv->self_ty = METHOD_SELF_TY;
    sv->loop = NLOOP;
    sv->sw = NSW;
    sv->nglbl = NGLBL;
    sv->dd = DEF_DEPTH;
    sv->ndf = NDF;
}

static void tmpl_restore_state(TmplSaved *sv)
{
    FN = sv->fn;
    CUR_RET_TY = sv->ret;
    METHOD_SELF_TY = sv->self_ty;
    NLOOP = sv->loop;
    NSW = sv->sw;
    NGLBL = sv->nglbl;
    DEF_DEPTH = sv->dd;
    NDF = sv->ndf;
}

/* 一条普通的外部声明（从类型说明符之后开始）：函数定义走 pa_func_def，其它是
 * 全局变量。顶层循环和**函数模板实例化**共用这一段。 */
static void gen_decl_from_spec(u32 base)
{
    Declarator d = {0};
    Sym *s = NULL;
    u32 ty = 0;
    int base_mgd_ptr = PA_MGD_PTR;      /* `@T a, b;` 的 @ 要给每个声明符 */
    int base_mgd_kind = PA_MGD_KIND;
    int base_tls = PA_TLS;              /* `__thread a, b;` 每个声明符都要 */

    /* 注意：**不要**在这里重置 SAW_CTOR / SAW_DTOR / PA_STATIC——它们是
     * parse_typespec() 在解析 `__attribute__((constructor))` 和 `static` 时
     * 置上的，调用方已经在调 parse_typespec 之前清过了。 */
    for (;;) {
        memset(&d, 0, sizeof(d));
        PA_MGD_PTR = base_mgd_ptr;
        PA_MGD_KIND = base_mgd_kind;
        PA_TLS = base_tls;
        ty = parse_declarator(base, &d);
        /* `int!error x = 1;`：`!error` 只挂在函数声明符上
         * （tests/errors/try.c6 的 test_fallible_not_a_function）。 */
        if (PA_FALLIBLE && !d.is_func) {
            pa_error("'!error' requires a function declarator");
            PA_FALLIBLE = 0;
        }
        if (!d.name) {
            /* `struct S { ... };` / `enum { ... };`：定义本身就是全部内容 */
            if (!pa_accept_ch(';'))
                pa_error("顶层声明缺名字");
            break;
        }
        if (d.is_func) {
            const char *nm = arena_strndup(&A_main, d.name, d.nlen);
            int had_proto = 0;

            s = sym_find(nm, d.nlen);
            if (s && s->is_func && ty_func_nparams(s->type) > 0)
                had_proto = 1;
            /* 同名但首形参不同 = 另一个"方法"（`int abs(int)` 之外又有
             * `Fix abs(Fix *self)`）。当成新符号登记，否则返回类型和元数都
             * 还是那个旧的（std/core/fixed.c6 的 abs / neg 就这样丢了）。 */
            /* 同名但签名不同的，是**另一个**函数（方法重载）：形参个数不同
             * 也算。`plain_area()` 与 `plain_area(struct Box *)`、libc 的
             * `getpid()` 与 `getpid(struct Pid *)` 都是这种，不分开的话第二个
             * 定义会把第一个的符号槽改掉（tests/method.c6 的两组断言）。 */
            if (s && s->is_func
                && (ty_func_nparams(s->type) != ty_func_nparams(ty)
                    || (ty_func_nparams(ty) > 0
                        && ty_func_param(s->type, 0) != ty_func_param(ty, 0))))
                s = NULL;
            {
                const char *tin = NULL;

                if (!s || !s->is_func) {
                    s = sym_add(nm, d.nlen, ty, SC_GLOBAL);
                    s->is_func = 1;
                    /* 首形参是指针的普通函数也进方法表：`int port(Tcp *self)`
                     * 这种"显式接收者"风格的方法调用糖要靠它挑对重载。 */
                    if (ty_func_nparams(ty) > 0 && ty_is_ptr(ty_func_param(ty, 0))) {
                        u32 self_ty2 = ty_target(ty_func_param(ty, 0));

                        tin = tmpl_inst_name(self_ty2);
                        if (!tin)
                            tin = sym_tag_name(self_ty2);
                        meth_add(s, self_ty2);
                    }
                    s->val = (i64)x64_sym(&X64, nm);
                }
                /* `!error` 是这一条声明上的事实：立刻落到符号上。原型没有
                 * 函数体、走不到 pa_func_def，留着会把标记传给下一条声明
                 * （`tests/errors/drop_bad.c6` 顶上那条 `int!error boom(void);`）。 */
                if (PA_FALLIBLE && s) {
                    s->fallible = 1;
                    PA_FALLIBLE = 0;
                }
                if (pa_is_ch(';')) {
                    pa_advance();
                    break;
                }
                /* `int f(int a), g(int a), x;`：函数声明符后面跟 ','，这一条是
                 * **声明**而不是定义（C99 6.7 的 init-declarator-list）。以前
                 * 这里直接掉进 pa_func_def，于是报"这里要 '{'"。剩下的声明符和
                 * 本条共用同一个基础类型，递归回去接着按声明表处理。 */
                if (pa_is_ch(',')) {
                    pa_advance();
                    gen_decl_from_spec(base);
                    break;
                }
                /* 首形参是"有名字的结构体指针"时，**再补一个**
                 * `<结构体>_<函数名>` 的符号指向同一份代码（模板实例叫
                 * `<实例名>_<函数名>`，比如 `Vect_int_vect_sum`）。C 层面
                 * 方法就是这么命名的，纯 C 的 TU 按那个名字调；c6 这边照旧
                 * 用短名（源码名相当于弱别名）。只改名不行——同一个名字在
                 * 别处还按短名被调用着（`tests/generic.c6`、
                 * `tests/generic_fn.c6`，以及 tests/abi/method.c6 里纯 C
                 * 按原名调 `c6_area` 那种）。 */
                /* 注意这里不能复用上面那个 `tin`：它只在**新建符号**那条
                 * 分支里赋值，而"c6 先声明、纯 C 文件再定义"时符号已经存在
                 * （tests/abi/method.c6 的 `plain_area`），那条分支根本不走。 */
                if (ty_func_nparams(ty) > 0 && ty_is_ptr(ty_func_param(ty, 0))) {
                    u32 st = ty_target(ty_func_param(ty, 0));
                    const char *tn2 = tmpl_inst_name(st);

                    PA_IN_DROP = 0;     /* 每条声明重新判定 */

                    if (!tn2)
                        tn2 = sym_tag_name(st);
                    if (tn2) {
                        char mn[320] = {0};
                        /* 真符号是 `<结构体>_<方法>`（c6 的 C 层面命名），
                         * 源码名当弱别名：纯 C 的 TU 才写得出的那个名字，
                         * 和"同名方法按接收者区分"靠的都是它。 */
                        snprintf(mn, sizeof(mn), "%s_%s", tn2, s->name);
                        s->val = (i64)x64_sym(&X64, emit_name(mn));
                        if (s->len == 4 && memcmp(s->name, "drop", 4) == 0
                            && ty_func_nparams(ty) == 1) {
                            if (ty_func_ret(ty) != ty_void())
                                pa_error("'drop' 必须返回 void：它在对象释放时跑，返回值没处去");
                            if (s->fallible)
                                pa_error("'drop' 不能失败（'!error'）：它在释放时跑，错误没处去");
                            if (drop_of(st))
                                pa_error("重复定义了析构函数");
                            if (CUR_ASYNC_DEF || PA_ASYNC)
                                pa_error("'async' 函数不能做方法：'drop'");
                            /* 体还没解析，先把"这是析构函数体"记下来 */
                            PA_IN_DROP = 1;
                            drop_reg(st, (u32)s->val);
                        }
                        if (!fn_overload_taken(s->name, s->len, s->type))
                            s->alias = s->name;
                    }
                }
            }
            if (d.nlen == 4 && memcmp(d.name, "main", 4) == 0)
                PA_MAIN = s;
            if (SAW_CTOR && NCTOR < 256)
                CTORS[NCTOR++] = (u32)s->val;
            if (SAW_DTOR && NDTOR < 256)
                DTORS[NDTOR++] = (u32)s->val;
            /* K&R 旧式定义：`int f(a, b) float a; float b; { … }`
             * 参数表里只有名字（类型默认 int），真正的类型写在 `{` 前面的
             * 声明列表里。这里把声明里的类型回填到参数上。 */
            while (d.knr && !pa_is_ch('{') && pa_cur()->kind != TK_EOF) {
                u32 b2 = parse_typespec();

                for (;;) {
                    Declarator dd = {0};
                    u32 t2 = parse_declarator(b2, &dd);
                    int k = 0;

                    if (dd.name) {
                        for (k = 0; k < (int)d.nparams; k++)
                            if (d.plen[k] == dd.nlen && d.pname[k]
                                && memcmp(d.pname[k], dd.name, dd.nlen) == 0) {
                                d.ptype[k] = t2;
                                d.pknr[k] = 1;
                            }
                    }
                    if (!pa_accept_ch(','))
                        break;
                }
                pa_expect_ch(';');
            }
            d.knr_conv = (u8)(d.knr && !had_proto);
            pa_func_def(s, &d);
            /* 旧式（K&R）定义对**调用方**来说没有原型：实参按默认提升传，
             * 被调方入口再转回来。所以函数体生成完再把符号类型换成无原型。 */
            if (d.knr && !had_proto)
                s->type = ty_func(ty_target(ty), NULL, 0, 0);
            break;
        }
        gen_one_global(ty, &d);
        if (!pa_accept_ch(','))
            break;
    }
}

/* 找到自带运行时。部署形态不同，搜索顺序也就不同：
 * 1) $C6C_RT；2) <编译器目录>/lib/rt.c6；3) <编译器目录>/../lib/rt.c6；
 * 4) <编译器目录>/../c6c/lib/rt.c6（源码树里 build/c6c 的位置）；5) ./lib/rt.c6 */
static const char *find_runtime(const char *argv0)
{
    static const char *cand[] = {"/lib/rt.c6", "/../lib/rt.c6", "/../c6c/lib/rt.c6",
                                 "/../../c6c/lib/rt.c6"};
    char buf[1024] = {0};
    char dir[512] = {0};
    const char *slash = argv0 ? strrchr(argv0, '/') : NULL;
    size_t dn = 0;
    u32 i = 0;

    {
        const char *env = getenv("C6C_RT");

        if (env && src_load(env))
            return arena_strdup(&A_main, env);
    }
    if (slash) {
        dn = (size_t)(slash - argv0);
        if (dn < sizeof(dir)) {
            memcpy(dir, argv0, dn);
            dir[dn] = 0;
            for (i = 0; i < 4; i++) {
                snprintf(buf, sizeof(buf), "%s%s", dir, cand[i]);
                if (src_load(buf))
                    return arena_strdup(&A_main, buf);
            }
        }
    }
    if (src_load("lib/rt.c6"))
        return "lib/rt.c6";
    return NULL;
}

/* 三个交接量本身也是数据段里的全局量：**永远**定义（哪怕这次编译没有
 * 任何 `__thread`），因为 lib/rt.c6 无条件引用它们。偏移 0 留空——符号表里
 * goff==0 的意思是"还没有存储"，占着它会让 rt.c6 里的 `extern` 声明再开一份。 */
static void tls_globals_init(void)
{
    (void)data_alloc(8, 8);
    SYM_TLS_IMG = sym_add("__c6_tls_img", 12, ty_ptr(ty_void()), SC_GLOBAL);
    SYM_TLS_IMG->goff = data_alloc(8, 8);
    SYM_TLS_IMG->val = (i64)x64_data_sym(&X64, "__c6_tls_img", ELF_HDR + SYM_TLS_IMG->goff);
    SYM_TLS_LEN = sym_add("__c6_tls_len", 12, ty_ulong(), SC_GLOBAL);
    SYM_TLS_LEN->goff = data_alloc(8, 8);
    SYM_TLS_LEN->val = (i64)x64_data_sym(&X64, "__c6_tls_len", ELF_HDR + SYM_TLS_LEN->goff);
    SYM_TLS_DELTA = sym_add("__c6_tls_delta", 14, ty_ulong(), SC_GLOBAL);
    SYM_TLS_DELTA->goff = data_alloc(8, 8);
    SYM_TLS_DELTA->val = (i64)x64_data_sym(&X64, "__c6_tls_delta",
                                           ELF_HDR + SYM_TLS_DELTA->goff);
}

/* 解析完再回填：影像范围只有全部声明过完才知道。 */
static void tls_finish(void)
{
    if (NTLS == 0) {
        glob_store(SYM_TLS_IMG->goff, 0, ty_ptr(ty_void()), 0);
        glob_store(SYM_TLS_LEN->goff, 0, ty_ulong(), 0);
        glob_store(SYM_TLS_DELTA->goff, 0, ty_ulong(), 0);
        return;
    }
    glob_store(SYM_TLS_IMG->goff, 0, ty_ptr(ty_void()), (u64)DATA_VA(TLS_LO));
    glob_store(SYM_TLS_LEN->goff, 0, ty_ulong(), (u64)(TLS_HI - TLS_LO));
    glob_store(SYM_TLS_DELTA->goff, 0, ty_ulong(), (u64)TLS_LO);
}

/* vreg/label 是 16 位的（见 src/ir.c6 的说明）：用超了以前是静默绕回、算错结果，
 * 现在由 ir.c6 回调到这里报一条明确的编译错误。 */
static void ir_overflow_error(void)
{
    pa_error("函数太大：虚拟寄存器/标号超过 16 位上限（65535）");
}

static int pa_compile_ex(const char *out, const char *argv0, int with_rt)
{
    int rc = 0;
    u32 code_len = 0;       /* 报"字节数"用的是纯代码长度（不含回填期补的跳板） */

    sym_init();
    tt_init();
    tykw_init();
    ir_set_overflow_hook(ir_overflow_error);
    memset(&FN, 0, sizeof(FN));
    memset(&X64, 0, sizeof(X64));
    img_init(&CODE_IMG, 8192);
    X64.im = &CODE_IMG;
    TLS_LO = 0;
    TLS_HI = 0;
    NTLS = 0;
    PA_TLS = 0;
    tls_globals_init();
    NLOOP = 0;
    PA_MAIN = NULL;
    scope_enter();
    PP_SKIP_NL = 1;
    if (c99_mode()) {
        C99_OUT = fopen(out, "w");

        if (!C99_OUT) {
            fprintf(stderr, "c6c: 写不了 %s\n", out);
            return 1;
        }
        /* 函数体先写进临时文件：前向声明要排在所有函数体前面，而函数体是
         * 流式发出去的，没法回头补。 */
        snprintf(C99_TMP, sizeof(C99_TMP), "%s.fn", out);
        C99_FNOUT = fopen(C99_TMP, "w");
        if (!C99_FNOUT) {
            fprintf(stderr, "c6c: 写不了 %s\n", C99_TMP);
            return 1;
        }
    }
    if (llvm_mode() && !llvm_open(out))
        return 1;
    if (with_rt) {
        const char *rt = find_runtime(argv0);

        if (!rt) {
            fprintf(stderr, "c6c: 找不到自带运行时 lib/rt.c6（可用 $C6C_RT 指定，"
                            "或用 -nostdlib 关掉）\n");
            return 1;
        }
        {
            SrcFile *rf = src_load(rt);

            if (rf)
                pp_push_file(rf, -1);
        }
    }
    pa_parse_tu();
    tls_finish();
    gc_cycle_check();
    synth_test_main();          /* 全局作用域还在，才能找到 printf */
    scope_leave();
    if (PA_ERRS || DG.errors) {
        fprintf(stderr, "c6c: %d 个错误，不写输出\n", PA_ERRS + DG.errors);
        return 1;
    }
    if (!PA_MAIN && !PA_SYNTAX_ONLY) {
        fprintf(stderr, "c6c: 没有 main（可执行文件需要入口）\n");
        return 1;
    }
    if (PA_SYNTAX_ONLY)
        return 0;               /* -fsyntax-only：前端跑完就算过 */
    if (c99_mode()) {
        FILE *cf = C99_OUT;
        char mn[256] = {0};
        u32 i = 0;

        if (!cf) {
            fprintf(stderr, "c6c: 写不了 %s\n", out);
            return 1;
        }
        c99_prologue();
        /* 先补所有函数的前向声明（函数体是流式发的，调用点可能在前） */
        for (i = 0; i < C99_NFN; i++) {
            u32 k2 = 0;

            fprintf(cf, "uint64_t %s(", C99_FNNAME[i]);
            for (k2 = 0; k2 < C99_FNNP[i]; k2++)
                fprintf(cf, "%suint64_t", k2 ? ", " : "");
            if (C99_FNNP[i] == 0)
                fprintf(cf, "uint64_t");
            fprintf(cf, ", ...);\n");
        }
        fprintf(cf, "\n");
        {
            char buf[65536] = {0};
            FILE *in = NULL;
            size_t got = 0;

            fclose(C99_FNOUT);
            C99_FNOUT = NULL;
            in = fopen(C99_TMP, "r");
            if (in) {
                while ((got = fread(buf, 1, sizeof(buf), in)) > 0)
                    fwrite(buf, 1, got, cf);
                fclose(in);
            }
            remove(C99_TMP);
        }
        c99_emit_data();
        c99_sym((u32)PA_MAIN->val, mn, sizeof(mn));
        fprintf(cf, "int main(int argc, char **argv)\n{\n  uint64_t r = 0;\n  c6c_init_data();\n");
        for (i = 0; i < NCTOR; i++) {
            char cn[256] = {0};

            c99_sym(CTORS[i], cn, sizeof(cn));
            fprintf(cf, "  ((uint64_t(*)(void))%s)();\n", cn);
        }
        fprintf(cf, "  {\n    r = ((uint64_t(*)(uint64_t, uint64_t))%s)"
                    "((uint64_t)argc, (uint64_t)(uintptr_t)argv);\n", mn);
        for (i = 0; i < NDTOR; i++) {
            char dn[256] = {0};

            c99_sym(DTORS[i], dn, sizeof(dn));
            fprintf(cf, "    (void)r;\n  }\n  ((uint64_t(*)(void))%s)();\n", dn);
        }
        if (NDTOR == 0)
            fprintf(cf, "    (void)r;\n  }\n");
        fprintf(cf, "  return (int)r;\n}\n");
        fclose(cf);
        printf("c6c: %s（C99 后端，%u 个符号）\n", out, X64.nsym);
        return 0;
    }
    if (llvm_mode())
        return llvm_finish(out);
    {
        /* 布局：[ELF 头 120][数据段][代码]。
         * 代码发在 CODE_IMG 里，**就地**回填、就地写出——不再把它和数据段
         * memcpy 进一份新的连续镜像：那份镜像自编译时 10.6 MB，纯属中间产物，
         * 峰值 RSS 里有一整个它（外加 1.5 倍增长时的 5 MB 余量）。
         * 补丁偏移仍留在 CODE_IMG 坐标里，相对位移的基准交给 X64.im_base。 */
        u32 code_off = 0;
        u32 entry_off = 0;
        u32 main_sym = (u32)PA_MAIN->val;
        u32 i = 0;

        entry_off = CODE_IMG.n;
        x64_emit_start(&X64, main_sym, CTORS, NCTOR, DTORS, NDTOR);

        /* 顺序要卡准：先算出代码段偏移 → 平移符号 VA → 回填数据段里的
         * 地址常量 → 最后才回填代码（否则补丁白打）。 */
        code_off = ELF_HDR + DATA_IMG.n;
        x64_finish_label_addrs(&X64, (u64)ELF_BASE_VA + (u64)code_off);
        for (i = 0; i < NCLBL; i++) {
            u64 va = (u64)ELF_BASE_VA + (u64)code_off
                     + (u64)x64_lbl_off(&X64, CLBL_FN[i], CLBL_LBL[i]);
            u32 k = 0;

            for (k = 0; k < 8; k++)
                DATA_IMG.p[CLBL_OFF[i] + k] = (u8)(va >> (8 * k));
        }
        for (i = 0; i < X64.nsym; i++) {
            if (X64.sym[i].defined && !X64.sym[i].is_data)
                X64.sym[i].off += code_off;
            if (X64.sym[i].defined)
                X64.sym[i].va = ELF_BASE_VA + X64.sym[i].off;   /* VA 跟着偏移走 */
        }
        data_fixups_apply();
        /* asmblob 跳板是回填阶段才追加到代码尾的（自编译时 144 字节）。
         * 先留死 64 KB 余量，免得 1.5 倍增长为这 144 字节多清 1.4 MB 的页。 */
        img_slack(&CODE_IMG, 64u * 1024u);
        code_len = CODE_IMG.n;      /* 报告的是"源码编出来的代码"，不含跳板 */
        X64.im_base = code_off;
        x64_resolve(&X64);
        x64_report_undef();
        {
            /* 头单独放栈上：120 字节 vs 10 MB，这就是整个改动的意思 */
            u8 hdr[ELF_HDR] = {0};

            elf_write_parts(out, hdr, &DATA_IMG, &CODE_IMG, entry_off + code_off);
        }
    }
    if (!PA_QUIET_OUT)
        printf("c6c: %s（%u 字节，%u 个符号）\n", out, code_len, X64.nsym);
    return rc;
}

static int pa_compile(const char *out)
{
    return pa_compile_ex(out, NULL, 0);
}
