-{
-    while (*s && blen < (int)sizeof(buf) - 2)
-        buf[blen++] = *s++;
-    buf[blen] = '\0';
-}
-
-/* a fallible function: 'err()' behaves like 'return err()' */
-static int!error fetch(int n)
-{
-    if (n < 0)
-        err(100, "negative");
-    if (n == 0)
-        err(101, "zero");
