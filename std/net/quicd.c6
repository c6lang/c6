/* std/net/quicd：在一个 UDP 端口上按连接 ID 分流多个 QUIC 连接。
 *
 *     import std.net.quicd;
 *
 *     QuicDaemon d = { 0 };
 *     d.init(16);
 *     d.add(&client_a);
 *     d.add(&client_b);
 *     ...
 *     -- 收到一个数据报：看 CID 决定给谁
 *     if (d.deliver(buf, n, now_us) < 0)
 *         ...             -- 不认识的 CID，按 RFC 9000 §5.2 丢掉即可
 *
 * 一个 QUIC 服务器只有**一个** UDP 端口，所有连接共用它。识别办法只有一个：
 * 看包里写着谁选的连接 ID——
 *
 * - 短包头：首字节之后就是 DCID，但长度不在包里，所以只能拿每个已登记连接
 *   自己的 CID 长度去比前缀（`1 + scid_len` 字节）；
 * - 长包头：版本号（4 字节）之后是 1 字节 DCID 长度 + DCID，长度自带。
 *
 * 这个模块只管「哪个包给谁」和统计，不碰 socket：收发由调用方用
 * `std.net.udp` + `std.os.poll` 做，发的时候调对应连接的
 * `quicconn.flush()`。这样同一份分流逻辑既能跑在阻塞 socket 上，也能跑在
 * 事件循环里，还不用在自测里起真端口。
 *
 * 连接本身的生命周期归调用方：`add`/`remove` 只是登记一个指针，不复制、也
 * 不释放。
 */
#include <string.h>

module std.net.quicd;
import std.core.types;
import std.net.quic;
import std.net.quicconn;

enum Error { OK = 0, INVAL = 1, FULL = 2, DUPLICATE = 3, NOT_FOUND = 4,
             PARSE = 5 };

#define QD_MAX_CONNS 16
#define QD_MAX_DGRAM 1200

struct QuicDaemon {
    QConn *conns[QD_MAX_CONNS];
    int count;
    int max;
    int err;
    u64 pkts_in;
    u64 bytes_in;
    u64 pkts_out;
    u64 bytes_out;
    u64 dropped;                /* 找不到归属的包 */
};

int init(QuicDaemon *d, int max_conns)
{
    if (!d)
        return -INVAL;
    memset(d, 0, sizeof *d);
    if (max_conns <= 0 || max_conns > QD_MAX_CONNS)
        max_conns = QD_MAX_CONNS;
    d->max = max_conns;
    return 0;
}

int count_of(QuicDaemon *d) { return d ? d->count : 0; }
int max_of(QuicDaemon *d) { return d ? d->max : 0; }
int err_of(QuicDaemon *d) { return d ? d->err : 0; }
u64 pkts_in_of(QuicDaemon *d) { return d ? d->pkts_in : 0; }
u64 bytes_in_of(QuicDaemon *d) { return d ? d->bytes_in : 0; }
u64 pkts_out_of(QuicDaemon *d) { return d ? d->pkts_out : 0; }
u64 bytes_out_of(QuicDaemon *d) { return d ? d->bytes_out : 0; }
u64 dropped_of(QuicDaemon *d) { return d ? d->dropped : 0; }

QConn *at(QuicDaemon *d, int i)
{
    if (!d || i < 0 || i >= d->count)
        return 0;
    return d->conns[i];
}

/* 登记一条连接。同一个 CID 不能登记两次。 */
int add(QuicDaemon *d, QConn *c)
{
    int i = 0;

    if (!d || !c || c->scid_len <= 0)
        return -INVAL;
    if (d->count >= d->max) {
        d->err = FULL;
        return -FULL;
    }
    for (i = 0; i < d->count; i++) {
        QConn *o = d->conns[i];

        if (o == c || (o->scid_len == c->scid_len
                       && memcmp(o->scid, c->scid, (size_t)o->scid_len) == 0)) {
            d->err = DUPLICATE;
            return -DUPLICATE;
        }
    }
    d->conns[d->count++] = c;
    return 0;
}

/* 按对象指针移除。 */
int remove(QuicDaemon *d, QConn *c)
{
    int i = 0;
    int j = 0;

    if (!d || !c)
        return -INVAL;
    for (i = 0; i < d->count; i++) {
        if (d->conns[i] != c)
            continue;
        for (j = i; j + 1 < d->count; j++)
            d->conns[j] = d->conns[j + 1];
        d->count--;
        return 0;
    }
    d->err = NOT_FOUND;
    return -NOT_FOUND;
}

/* 按连接 ID 找连接；找不到返回 0。 */
QConn *find(QuicDaemon *d, const void *cid, int cid_len)
{
    const u8 *p = (const u8 *)cid;
    int i = 0;

    if (!d || !cid || cid_len <= 0)
        return 0;
    for (i = 0; i < d->count; i++) {
        QConn *c = d->conns[i];

        if (c->scid_len != cid_len)
            continue;
        if (memcmp(c->scid, p, (size_t)cid_len) == 0)
            return c;
    }
    return 0;
}

/* 从一个数据报里取出 DCID：返回长度，写进 `out`；格式不对返回 -1。
 * 短包头没法知道 DCID 长度，只能借「最长能匹配上」的规则，所以这里对短包头
 * 返回 -2，由 `deliver` 用逐个前缀比较的办法处理。 */
static int qd_dcid(const u8 *buf, int len, u8 *out, int cap)
{
    int dlen = 0;

    if (!buf || !out || len < 1)
        return -1;
    if ((buf[0] & 0x80) == 0)
        return -2;              /* 短包头：长度不在包里 */
    if (len < 7)
        return -1;
    dlen = buf[5];
    if (dlen > QUIC_CID_MAX || dlen > cap || 6 + dlen > len)
        return -1;
    memcpy(out, buf + 6, (size_t)dlen);
    return dlen;
}

/* 短包头按前缀匹配：谁登记过这个 CID 前缀就是谁的。 */
static QConn *qd_match_short(QuicDaemon *d, const u8 *buf, int len)
{
    int i = 0;

    for (i = 0; i < d->count; i++) {
        QConn *c = d->conns[i];

        if (c->scid_len <= 0 || 1 + c->scid_len > len)
            continue;
        if (memcmp(buf + 1, c->scid, (size_t)c->scid_len) == 0)
            return c;
    }
    return 0;
}

/* 把一个数据报交给它所属的连接。返回交给的连接；没有归属返回 0。 */
QConn *deliver(QuicDaemon *d, const void *pkt, int len, i64 now)
{
    const u8 *buf = (const u8 *)pkt;
    u8 cid[QUIC_CID_MAX] = { 0 };
    QConn *c = 0;
    int dlen = 0;
    int rc = 0;

    if (!d || !pkt || len <= 0 || now < 0)
        return 0;
    dlen = qd_dcid(buf, len, cid, (int)sizeof cid);
    if (dlen == -2) {
        c = qd_match_short(d, buf, len);
    } else if (dlen > 0) {
        c = d->find(cid, dlen);
    }
    if (!c) {
        d->dropped++;
        d->err = NOT_FOUND;
        return 0;
    }
    rc = c->on_packet(pkt, len, now);
    d->pkts_in++;
    d->bytes_in += (u64)len;
    if (rc < 0) {
        /* 包进了连接但被拒（解密失败、状态不对）：也算收过，只是不计成功 */
        d->err = rc;
        return 0;
    }
    return c;
}

/* 让所有连接各发一个包：每发一个就调一次 `sink`。
 *
 * 这里不直接写 socket，是为了让调用方能自己决定用 sendto、用队列还是直接
 * 丢掉；`sink` 返回负数表示发失败，循环马上停。 */
int flush_all(QuicDaemon *d, int (*sink)(void *ctx, const u8 *pkt,
                                              int n), void *ctx, i64 now)
{
    u8 pkt[QD_MAX_DGRAM] = { 0 };
    int i = 0;
    int total = 0;

    if (!d || !sink || now < 0)
        return -INVAL;
    for (i = 0; i < d->count; i++) {
        QConn *c = d->conns[i];
        int n = 0;

        while ((n = c->flush(pkt, (int)sizeof pkt, now)) > 0) {
            if (sink(ctx, pkt, n) < 0)
                return -PARSE;
            d->pkts_out++;
            d->bytes_out += (u64)n;
            total++;
            if (total > 64)
                return total;   /* 防呆：一次最多刷 64 个包 */
        }
    }
    return total;
}

/* ---- 自测 ---- */

static const u8 qd_scid_c[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };
static const u8 qd_scid_s[8] = { 9, 10, 11, 12, 13, 14, 15, 16 };

/* 给服务端换一个 CID：重新初始化会把「对端 CID」一起清掉，所以要补回来。 */
static void qd_server_cid(QConn *s, const u8 *scid)
{
    s->init(1, scid, 8);
    s->set_dcid(qd_scid_c, 8);
}

/* 给一对连接装好交叉的密钥（CID 由调用方另外设定）。 */
static void qd_keys(QConn *c, QConn *s)
{
    u8 c_ap[32] = { 0 };
    u8 s_ap[32] = { 0 };
    int i = 0;

    for (i = 0; i < 32; i++) {
        c_ap[i] = (u8)(0x10 + i);
        s_ap[i] = (u8)(0x80 + i);
    }
    c->set_keys(TLS13_AES_128_GCM_SHA256, s_ap, c_ap);
    s->set_keys(TLS13_AES_128_GCM_SHA256, c_ap, s_ap);
}

static void qd_pair(QConn *c, QConn *s)
{
    c->init(0, qd_scid_c, 8);
    s->init(1, qd_scid_s, 8);
    c->set_dcid(qd_scid_s, 8);
    s->set_dcid(qd_scid_c, 8);
    qd_keys(c, s);
}

struct SinkCtx {
    int count;
    int bytes;
    int fail_at;
};

static int qd_sink(void *ctx, const u8 *pkt, int n)
{
    struct SinkCtx *s = (struct SinkCtx *)ctx;

    (void)pkt;
    if (s->fail_at > 0 && s->count + 1 >= s->fail_at)
        return -1;
    s->count++;
    s->bytes += n;
    return 0;
}

test "QUIC 分流：登记、查找与移除" {
    QuicDaemon d = { 0 };
    QConn a = { 0 };
    QConn b = { 0 };
    QConn c = { 0 };
    u8 sc[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };
    u8 sb[4] = { 20, 21, 22, 23 };
    u8 cid[8] = { 0 };

    d.init(2);
    if (d.max_of() != 2)
        return err(1, "登记的容量应是 2");
    a.init(0, sc, 8);
    b.init(0, sb, 4);
    c.init(0, sc, 8);
    if (d.add(&a) != 0 || d.count_of() != 1)
        return err(2, "登记第一个连接失败");
    if (d.add(&b) != 0 || d.count_of() != 2)
        return err(3, "登记第二个连接失败");
    /* 容量满了 */
    if (d.add(&c) != -FULL || d.err_of() != FULL)
        return err(4, "超出容量应报 FULL");
    /* 同一个 CID 不能登记两次 */
    {
        QuicDaemon e = { 0 };
        QConn dup = { 0 };

        e.init(4);
        dup.init(0, sc, 8);
        e.add(&a);
        if (e.add(&dup) != -DUPLICATE)
            return err(5, "重复的 CID 应报 DUPLICATE");
    }
    /* 按 CID 查找（长度不同的也能分开） */
    memcpy(cid, sc, 8);
    if (d.find(cid, 8) != &a)
        return err(6, "8 字节 CID 应找到 a");
    if (d.find(sb, 4) != &b)
        return err(7, "4 字节 CID 应找到 b");
    if (d.find(cid, 4) != 0)
        return err(8, "长度不匹配时不应找到");
    if (d.at(0) != &a || d.at(1) != &b || d.at(2) != 0)
        return err(9, "下标访问不对");
    /* 移除之后查不到 */
    if (d.remove(&a) != 0 || d.count_of() != 1)
        return err(10, "移除失败");
    if (d.find(cid, 8) != 0)
        return err(11, "移除之后不应还能查到");
    if (d.remove(&a) != -NOT_FOUND)
        return err(12, "重复移除应报 NOT_FOUND");
    /* 参数错误 */
    if (d.add(0) != -INVAL || d.remove(0) != -INVAL)
        return err(13, "空指针应报 INVAL");
}

test "QUIC 分流：按 CID 投递数据报" {
    QuicDaemon d = { 0 };
    QConn c1 = { 0 };
    QConn s1 = { 0 };
    QConn c2 = { 0 };
    QConn s2 = { 0 };
    u8 pkt[1200] = { 0 };
    int n = 0;

    qd_pair(&c1, &s1);
    qd_pair(&c2, &s2);
    /* 两条连接用不同的 CID：把 s2 的 CID 改掉，避免和 s1 撞上 */
    {
        u8 other[8] = { 30, 31, 32, 33, 34, 35, 36, 37 };

        qd_server_cid(&s2, other);
        c2.set_dcid(other, 8);
        qd_keys(&c2, &s2);
    }
    d.init(4);
    if (d.add(&s1) != 0 || d.add(&s2) != 0)
        return err(1, "登记两条服务端连接失败");
    /* 客户端 1 发一个包：应当落到 s1 上 */
    c1.write_stream(0, "one", 3);
    n = c1.flush(pkt, (int)sizeof pkt, 1000);
    if (n <= 0)
        return err(2, "客户端 1 应当有包");
    if (d.deliver(pkt, n, 1000) != &s1)
        return err(3, "包应交给 s1");
    if (s1.stream_readable(0) != 3 || s2.stream_readable(0) != 0)
        return err(4, "数据只该进 s1");
    /* 客户端 2 的包落到 s2 上 */
    c2.write_stream(0, "two!", 4);
    n = c2.flush(pkt, (int)sizeof pkt, 1000);
    if (d.deliver(pkt, n, 1000) != &s2)
        return err(5, "包应交给 s2");
    if (s2.stream_readable(0) != 4)
        return err(6, "数据应进 s2");
    if (pkts_in_of(&d) != 2 || dropped_of(&d) != 0)
        return err(7, "统计不对");
    /* 不认识的 CID：丢掉并计数 */
    {
        u8 bogus[64] = { 0 };

        bogus[0] = 0x40;        /* 短包头 */
        memset(bogus + 1, 0xee, 8);
        if (d.deliver(bogus, 32, 1000) != 0)
            return err(8, "不认识的 CID 不该有归属");
        if (dropped_of(&d) != 1)
            return err(9, "丢掉的包要计数");
        /* 长包头也一样：DCID 长度自带 */
        bogus[0] = 0xc0;
        bogus[5] = 8;
        memset(bogus + 6, 0xee, 8);
        if (d.deliver(bogus, 32, 1000) != 0 || dropped_of(&d) != 2)
            return err(10, "长包头的不认识 CID 也要丢掉");
        /* 太短的包直接不认 */
        if (d.deliver(bogus, 2, 1000) != 0)
            return err(11, "畸形包不该有归属");
    }
    /* 解密失败的包：算收过，但不交给上层 */
    {
        QConn c3 = { 0 };
        QConn s3 = { 0 };
        u8 other[8] = { 40, 41, 42, 43, 44, 45, 46, 47 };

        qd_pair(&c3, &s3);
        qd_server_cid(&s3, other);
        c3.set_dcid(other, 8);
        qd_keys(&c3, &s3);
        /* 换个 CID 登记：容量 4 还够 */
        if (d.add(&s3) != 0)
            return err(12, "登记第三条连接失败");
        c3.write_stream(0, "x", 1);
        n = c3.flush(pkt, (int)sizeof pkt, 1000);
        pkt[n - 2] ^= 0xff;     /* 弄坏 tag */
        if (d.deliver(pkt, n, 1000) != 0)
            return err(13, "解密失败的包不该交给上层");
        if (pkts_in_of(&d) != 3)
            return err(14, "解密失败的包也要计入收包数");
    }
}

test "QUIC 分流：批量发包与停止条件" {
    QuicDaemon d = { 0 };
    QConn c1 = { 0 };
    QConn s1 = { 0 };
    QConn c2 = { 0 };
    QConn s2 = { 0 };
    struct SinkCtx sink = { 0, 0, 0 };
    u8 other[8] = { 30, 31, 32, 33, 34, 35, 36, 37 };

    qd_pair(&c1, &s1);
    qd_pair(&c2, &s2);
    qd_server_cid(&s2, other);
    c2.set_dcid(other, 8);
    qd_keys(&c2, &s2);
    d.init(4);
    d.add(&s1);
    d.add(&s2);
    /* 没有数据时一个包都不该发 */
    if (d.flush_all(qd_sink, &sink, 1000) != 0)
        return err(1, "没有输出时不该发包");
    if (sink.count != 0)
        return err(2, "sink 不该被调用");
    /* 两条连接各写点东西，各发一个 */
    s1.write_stream(0, "a", 1);
    s2.write_stream(0, "bb", 2);
    if (d.flush_all(qd_sink, &sink, 1000) != 2)
        return err(3, "应有两条连接各发一个包");
    if (sink.count != 2 || sink.bytes <= 0)
        return err(4, "sink 统计不对");
    if (pkts_out_of(&d) != 2 || bytes_out_of(&d) != (u64)sink.bytes)
        return err(5, "发包统计不对");
    /* 写完就没有可发的了 */
    sink.count = 0;
    sink.bytes = 0;
    if (d.flush_all(qd_sink, &sink, 2000) != 0)
        return err(6, "发完之后不该再有输出");
    /* sink 报错时立刻停 */
    s1.write_stream(0, "c", 1);
    sink.count = 0;
    sink.fail_at = 1;
    if (d.flush_all(qd_sink, &sink, 3000) != -PARSE)
        return err(7, "sink 失败应报 PARSE");
    /* 参数检查 */
    if (d.flush_all(0, &sink, 3000) != -INVAL)
        return err(8, "空 sink 应报 INVAL");
}
