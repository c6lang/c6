# tcc/ 是本仓库的源码：上游 TinyCC 基线 + 每个 c6 补丁一个提交。
# 它的构建产物由 tcc/.gitignore 忽略。

# 环境/工具产生的临时文件
/.marker-test
*.o
*.a
*.exe
*.core

# 自举产物（cmake --build build --target selfhost / c99selfhost）
/build/
# CPack 打包产物（cpack -B packages）
/packages/
# tokio 基准的 cargo 产物
bench/async/tokio_bench/target/
# uya 构建缓存（bench/async/run.sh 会建）
.uyacache/
