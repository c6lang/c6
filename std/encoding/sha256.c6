/* std/encoding/sha256：SHA-256（FIPS 180-4）与 HMAC-SHA-256（RFC 2104）。
 *
 *     import std.encoding.sha256;
 *
 *     u8 d[32] = { 0 };
 *     sha256("abc", 3, d);                  // 一次性，摘要 32 字节
 *     char hex[65] = { 0 };
 *     sha256_hex("abc", 3, hex);            // 64 个小写十六进制 + NUL
 *
 *     Sha256 st = { { 0 }, 0, { 0 }, 0 };   // 流式：任意切分得到同一个结果
 *     sha256_init(&st);
 *     sha256_update(&st, "a", 1);
 *     sha256_update(&st, "bc", 2);
 *     sha256_final(&st, d);                 // 之后状态失效，要再 init 才能复用
 *
 *     u8 mac[32] = { 0 };                   // HMAC-SHA-256
 *     hmac_sha256(key, klen, msg, mlen, mac);
 *     if (sha256_eq(mac, want)) ...         // 32 字节常数时间比较
 *
 * 为什么手写而不包宿主的加密库：标准库要给的是「同一份输入在任何平台给出同一
 * 串字节」，而且不分配、不链 libm、不依赖 libc 的加密函数。实现只用 32 位
 * 加/异或/循环右移，旋转借 `std.core.bits` 的 `rotr32`（链接时把 std/core/bits.c6 放上
 * 命令行）；`<string.h>` 只用到 memcpy / memset。
 *
 * 空指针约定：`p == 0` 一律当「0 字节输入」（n 被忽略），`out == 0` 直接返回，
 * 所以「还没拿到数据」不需要调用方先判空。HMAC 的长 key（> 64 字节）先
 * sha256 压成 32 字节，ipad 0x36 / opad 0x5c，全程栈上 64 字节块，不 malloc。
 *
 * `enum Error` 只是和 std.core.err 的错误码语义对齐（本模块自己不返回错误）：
 * `INVAL = 1`、`NOMEM = 3` 对得上 std.core.err 的同名成员，上层可以混着用。
 */
#include <string.h>

module std.encoding.sha256;
import std.core.types;
import std.core.err;
import std.core.bits;

enum Error { INVAL = 1, NOMEM = 3 };

struct Sha256 {
    u32 h[8];
    u64 n;        /* 已喂入的字节数 */
    u8  buf[64];  /* 未满一块的尾巴 */
    u32 used;     /* buf 里已有多少字节 */
};

/* 流式 hex 输出的便捷句柄：喂完之后 sha256hex_final 交出 out（65 字节） */
struct Sha256Hex {
    Sha256 st;
    char out[65];
};

/* 内层压缩函数：吃满 64 字节一块，就地推进 h */
static void sha256_block(Sha256 *self, const u8 *p)
{
    /* FIPS 180-4 §4.2.2：前 64 个素数立方根小数部分的前 32 位 */
    static const u32 k[64] = {
        0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
        0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
        0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
        0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
        0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
        0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
        0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
        0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
        0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
        0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
        0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
        0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
        0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
        0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
        0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
        0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u,
    };
    u32 w[64] = { 0 };
    u32 a = 0u, b = 0u, c = 0u, d = 0u, e = 0u, f = 0u, g = 0u, h = 0u;
    int i = 0;

    /* 消息块按大端读成 16 个 32 位字（不靠主机字节序） */
    for (i = 0; i < 16; i++) {
        w[i] = ((u32)p[i * 4] << 24) | ((u32)p[i * 4 + 1] << 16)
             | ((u32)p[i * 4 + 2] << 8) | (u32)p[i * 4 + 3];
    }
    for (i = 16; i < 64; i++) {
        u32 s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
        u32 s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);

        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    a = self->h[0];
    b = self->h[1];
    c = self->h[2];
    d = self->h[3];
    e = self->h[4];
    f = self->h[5];
    g = self->h[6];
    h = self->h[7];
    for (i = 0; i < 64; i++) {
        u32 s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
        u32 ch = (e & f) ^ (~e & g);
        u32 t1 = h + s1 + ch + k[i] + w[i];
        u32 s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
        u32 maj = (a & b) ^ (a & c) ^ (b & c);
        u32 t2 = s0 + maj;

        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }
    self->h[0] += a;
    self->h[1] += b;
    self->h[2] += c;
    self->h[3] += d;
    self->h[4] += e;
    self->h[5] += f;
    self->h[6] += g;
    self->h[7] += h;
}

/* 复位到一个新的哈希（同一个结构体可以反复用） */
void sha256_init(Sha256 *self)
{
    /* §5.3.3：前 8 个素数平方根小数部分的前 32 位 */
    static const u32 iv[8] = {
        0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au,
        0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u,
    };
    int i = 0;

    if (!self)
        return;
    for (i = 0; i < 8; i++)
        self->h[i] = iv[i];
    self->n = 0ull;
    self->used = 0u;
    memset(self->buf, 0, sizeof self->buf);
}

/* 喂数据：任意切分（1 字节一喂、63/64/65 跨块）都给同一个结果 */
void sha256_update(Sha256 *self, const void *p, usize n)
{
    const u8 *b = (const u8 *)p;
    usize i = 0;

    if (!self)
        return;
    if (!b)
        return;                 /* NULL 当空输入，n 被忽略 */
    self->n += (u64)n;
    if (self->used != 0u) {
        /* 先把上次剩下的尾巴填满一块 */
        while (self->used < 64u && i < n)
            self->buf[self->used++] = b[i++];
        if (self->used < 64u)
            return;
        sha256_block(self, self->buf);
        self->used = 0u;
    }
    /* 整块直接压缩，不再经过 buf */
    for (; i + 64 <= n; i += 64)
        sha256_block(self, b + i);
    while (i < n)
        self->buf[self->used++] = b[i++];
}

/* 收尾：0x80 填充 + 比特长度大端追加，交出 32 字节摘要 */
void sha256_final(Sha256 *self, u8 *out32)
{
    u64 bits = 0ull;
    int i = 0;

    if (!self || !out32)
        return;
    bits = self->n * 8ull;      /* 长度按比特算 */
    self->buf[self->used++] = 0x80;
    if (self->used > 56u) {
        /* 这条尾巴塞不下 8 字节长度，补零后再压一块 */
        while (self->used < 64u)
            self->buf[self->used++] = 0;
        sha256_block(self, self->buf);
        self->used = 0u;
    }
    while (self->used < 56u)
        self->buf[self->used++] = 0;
    for (i = 0; i < 8; i++)
        self->buf[56 + i] = (u8)(bits >> (56 - i * 8));
    sha256_block(self, self->buf);
    for (i = 0; i < 8; i++) {
        out32[i * 4]     = (u8)(self->h[i] >> 24);
        out32[i * 4 + 1] = (u8)(self->h[i] >> 16);
        out32[i * 4 + 2] = (u8)(self->h[i] >> 8);
        out32[i * 4 + 3] = (u8)self->h[i];
    }
    /* 中间状态和密钥材料一样敏感：用完就抹掉，要再用请 sha256_init */
    memset(self, 0, sizeof(Sha256));
}

/* 一次性 SHA-256 */
void sha256(const void *p, usize n, u8 *out32)
{
    Sha256 st = { 0 };

    if (!out32)
        return;
    sha256_init(&st);
    sha256_update(&st, p, n);
    sha256_final(&st, out32);
}

static const char sha256_hex_digits[] = "0123456789abcdef";

/* 32 字节摘要 → 64 个小写十六进制 + NUL（调用方给 65 字节） */
static void sha256_to_hex(const u8 *d, char *out65)
{
    int i = 0;

    for (i = 0; i < 32; i++) {
        out65[i * 2]     = sha256_hex_digits[(d[i] >> 4) & 0xf];
        out65[i * 2 + 1] = sha256_hex_digits[d[i] & 0xf];
    }
    out65[64] = 0;
}

/* 一次性 SHA-256 的小写 hex（out65 至少 65 字节） */
void sha256_hex(const void *p, usize n, char *out65)
{
    u8 d[32] = { 0 };

    if (!out65)
        return;
    sha256(p, n, d);
    sha256_to_hex(d, out65);
    memset(d, 0, sizeof d);
}

/* HMAC-SHA-256（RFC 2104）：key > 64 字节先 sha256，ipad 0x36 / opad 0x5c */
void hmac_sha256(const void *key, usize klen, const void *msg, usize mlen,
                 u8 *out32)
{
    u8 kblock[64] = { 0 };
    u8 pad[64] = { 0 };
    u8 inner[32] = { 0 };
    Sha256 st = { 0 };
    int i = 0;

    if (!out32)
        return;
    if (key) {
        if (klen > sizeof kblock)
            sha256(key, klen, kblock);      /* 长的 key 先压成 32 字节 */
        else if (klen > 0)
            memcpy(kblock, key, klen);
    }
    for (i = 0; i < 64; i++)
        pad[i] = (u8)(kblock[i] ^ 0x36);
    sha256_init(&st);
    sha256_update(&st, pad, sizeof pad);
    sha256_update(&st, msg, mlen);
    sha256_final(&st, inner);
    for (i = 0; i < 64; i++)
        pad[i] = (u8)(kblock[i] ^ 0x5c);
    sha256_init(&st);
    sha256_update(&st, pad, sizeof pad);
    sha256_update(&st, inner, sizeof inner);
    sha256_final(&st, out32);
    memset(kblock, 0, sizeof kblock);
    memset(pad, 0, sizeof pad);
    memset(inner, 0, sizeof inner);
}

/* HMAC-SHA-256 的小写 hex（out65 至少 65 字节） */
void hmac_sha256_hex(const void *key, usize klen, const void *msg, usize mlen,
                     char *out65)
{
    u8 d[32] = { 0 };

    if (!out65)
        return;
    hmac_sha256(key, klen, msg, mlen, d);
    sha256_to_hex(d, out65);
    memset(d, 0, sizeof d);
}

/* 32 字节常数时间比较：相等 1，否则 0（不短路，空指针一律 0） */
int sha256_eq(const u8 *a, const u8 *b)
{
    u32 diff = 0u;
    int i = 0;

    if (!a || !b)
        return 0;
    for (i = 0; i < 32; i++)
        diff |= (u32)(a[i] ^ b[i]);
    return diff == 0u ? 1 : 0;
}

/* ---- 流式 hex 句柄 ---- */

void sha256hex_init(Sha256Hex *self)
{
    if (!self)
        return;
    sha256_init(&self->st);
    self->out[0] = 0;
}

void sha256hex_update(Sha256Hex *self, const void *p, usize n)
{
    if (!self)
        return;
    sha256_update(&self->st, p, n);
}

/* 收尾并返回内部 65 字节缓冲（空句柄给 NULL） */
const char *sha256hex_final(Sha256Hex *self)
{
    u8 d[32] = { 0 };

    if (!self)
        return (const char *)0;
    sha256_final(&self->st, d);
    sha256_to_hex(d, self->out);
    memset(d, 0, sizeof d);
    return self->out;
}

/* ---- 自测 ---- */

test "空串的已知向量" {
    char hex[65] = { 0 };

    sha256_hex((const void *)0, 0, hex);
    if (strcmp(hex, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") != 0)
        return err(1, "空串摘要不对");
}

test "abc 的已知向量" {
    char hex[65] = { 0 };

    sha256_hex("abc", 3, hex);
    if (strcmp(hex, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") != 0)
        return err(2, "abc 摘要不对");
}

test "两块消息（448 位）的已知向量" {
    const char *msg = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    char hex[65] = { 0 };

    sha256_hex(msg, strlen(msg), hex);
    if (strcmp(hex, "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1") != 0)
        return err(3, "448 位消息摘要不对");
}

test "填充边界 55/56/63/64 字节" {
    u8 buf[64] = { 0 };
    char hex[65] = { 0 };

    memset(buf, 'x', sizeof buf);
    sha256_hex(buf, 55, hex);
    if (strcmp(hex, "d5e285683cd4efc02d021a5c62014694958901005d6f71e89e0989fac77e4072") != 0)
        return err(4, "55 字节摘要不对（0x80 刚好放得下）");
    sha256_hex(buf, 56, hex);
    if (strcmp(hex, "04c26261370ee7541549d16dee320c723e3fd14671e66a099afe0a377c16888e") != 0)
        return err(5, "56 字节摘要不对（长度要挤到下一块）");
    sha256_hex(buf, 63, hex);
    if (strcmp(hex, "75220b47218278e656f2013bb8f0c455a25eaf01e86c64924e9d48d89776d6f2") != 0)
        return err(6, "63 字节摘要不对");
    sha256_hex(buf, 64, hex);
    if (strcmp(hex, "7ce100971f64e7001e8fe5a51973ecdfe1ced42befe7ee8d5fd6219506b5393c") != 0)
        return err(7, "64 字节摘要不对（整块 + 一块填充）");
}

test "一百万个小写 a" {
    Sha256Hex hx = { { 0 }, { 0 } };
    u8 chunk[1000] = { 0 };
    int i = 0;

    memset(chunk, 'a', sizeof chunk);
    sha256hex_init(&hx);
    for (i = 0; i < 1000; i++)
        sha256hex_update(&hx, chunk, sizeof chunk);
    if (strcmp(sha256hex_final(&hx),
               "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0") != 0)
        return err(8, "一百万 a 的摘要不对");
}

test "分片喂入与一次喂完结果一致" {
    u8 data[1000] = { 0 };
    u8 want[32] = { 0 };
    usize cuts[6] = { 1, 7, 63, 64, 65, 1000 };
    int i = 0, j = 0;

    for (i = 0; i < 1000; i++)
        data[i] = (u8)(i * 7 + 3);
    sha256(data, sizeof data, want);
    for (j = 0; j < 6; j++) {
        Sha256 st = { 0 };
        u8 got[32] = { 0 };
        usize off = 0;

        sha256_init(&st);
        while (off < sizeof data) {
            usize take = cuts[j];

            if (take > sizeof data - off)
                take = sizeof data - off;
            sha256_update(&st, data + off, take);
            off += take;
        }
        sha256_final(&st, got);
        if (!sha256_eq(got, want))
            return err(9, "切分大小不同就给了不同摘要");
    }
}

test "init 之后直接 final 等于空串，final 之后状态失效" {
    Sha256 st = { 0 };
    u8 d[32] = { 0 };
    char hex[65] = { 0 };

    sha256_init(&st);
    sha256_final(&st, d);
    sha256_to_hex(d, hex);
    if (strcmp(hex, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") != 0)
        return err(10, "空输入的流式摘要不对");
    if (st.n != 0ull || st.used != 0u || st.h[3] != 0u || st.h[7] != 0u)
        return err(11, "final 之后状态没有被抹掉");
    /* 再 init 一次应当完全复位 */
    sha256_init(&st);
    sha256_update(&st, "abc", 3);
    sha256_final(&st, d);
    sha256_to_hex(d, hex);
    if (strcmp(hex, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") != 0)
        return err(12, "同一个结构体二次使用结果不对");
}

test "sha256_eq 相等、不等与空指针" {
    u8 a[32] = { 0 };
    u8 b[32] = { 0 };

    sha256("abc", 3, a);
    sha256("abc", 3, b);
    if (!sha256_eq(a, b))
        return err(13, "相同摘要被判不等");
    b[31] ^= 1;
    if (sha256_eq(a, b))
        return err(14, "末位差一的摘要被判相等");
    b[31] ^= 1;
    a[0] ^= 0x80;
    if (sha256_eq(a, b))
        return err(15, "首字节不同的摘要被判相等");
    if (sha256_eq((const u8 *)0, b) || sha256_eq(a, (const u8 *)0))
        return err(16, "空指针没有被拒绝");
}

test "hex 输出是 64 个小写十六进制加 NUL" {
    char hex[66] = { 0 };
    int i = 0;

    memset(hex, 'Z', sizeof hex);
    sha256_hex("hello", 5, hex);
    if (hex[64] != 0)
        return err(17, "没有在第 64 个字节写 NUL");
    if (hex[65] != 'Z')
        return err(18, "hex 输出多写了一字节");
    for (i = 0; i < 64; i++) {
        int c = (int)(u8)hex[i];

        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
            return err(19, "出现了非小写十六进制字符");
    }
}

test "空指针当空输入，输出指针为空直接返回" {
    Sha256 st = { 0 };
    char hex[65] = { 0 };

    sha256_init(&st);
    sha256_update(&st, (const void *)0, 0);
    sha256_update(&st, (const void *)0, 77);    /* n 被忽略 */
    sha256_update(&st, "", 0);
    sha256_final(&st, (u8 *)0);                 /* 应当什么都不做 */
    sha256_hex((const void *)0, 123, hex);      /* 只喂了 0 字节 */
    if (strcmp(hex, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") != 0)
        return err(20, "空指针改动了摘要");
    sha256((const void *)0, 9, (u8 *)0);
    sha256_hex((const void *)0, 9, (char *)0);
    hmac_sha256((const void *)0, 0, (const void *)0, 0, (u8 *)0);
    hmac_sha256_hex((const void *)0, 0, (const void *)0, 0, (char *)0);
    hmac_sha256((const void *)0, 5, (const void *)0, 5, (u8 *)0);
}

test "Sha256Hex 句柄可以分段喂、可以复位" {
    Sha256Hex hx = { { 0 }, { 0 } };
    const char *r = (const char *)0;

    sha256hex_init(&hx);
    sha256hex_update(&hx, "ab", 2);
    sha256hex_update(&hx, "c", 1);
    if (strcmp(sha256hex_final(&hx),
               "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") != 0)
        return err(21, "句柄分段喂 abc 的摘要不对");
    sha256hex_init(&hx);
    if (strcmp(sha256hex_final(&hx),
               "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") != 0)
        return err(22, "句柄复位后不是空串摘要");
    sha256hex_update((Sha256Hex *)0, "x", 1);
    r = sha256hex_final((Sha256Hex *)0);
    if (r != (const char *)0)
        return err(23, "空句柄应当返回 NULL");
}

test "HMAC RFC 4231 用例 1：20 字节 0x0b 的 key" {
    u8 key[20] = { 0 };
    char hex[65] = { 0 };

    memset(key, 0x0b, sizeof key);
    hmac_sha256_hex(key, sizeof key, "Hi There", 8, hex);
    if (strcmp(hex, "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7") != 0)
        return err(24, "用例 1 的 HMAC 不对");
}

test "HMAC RFC 4231 用例 2：key \"Jefe\"" {
    const char *msg = "what do ya want for nothing?";
    char hex[65] = { 0 };

    hmac_sha256_hex("Jefe", 4, msg, strlen(msg), hex);
    if (strcmp(hex, "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843") != 0)
        return err(25, "用例 2 的 HMAC 不对");
}

test "HMAC RFC 4231 用例 6：131 字节长 key" {
    /* 标准用例 6 的 key 是 131 个 0xaa（超过一块，必须先 sha256） */
    const char *msg = "Test Using Larger Than Block-Size Key - Hash Key First";
    u8 key[131] = { 0 };
    char hex[65] = { 0 };

    memset(key, 0xaa, sizeof key);
    hmac_sha256_hex(key, sizeof key, msg, strlen(msg), hex);
    if (strcmp(hex, "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54") != 0)
        return err(26, "用例 6 的 HMAC 不对");
}

test "HMAC 的 key 边界：63/64/65/96 字节" {
    const char *msg = "Test Using Larger Than Block-Size Key - Hash Key First";
    u8 key[96] = { 0 };
    char hex[65] = { 0 };

    memset(key, 0xaa, sizeof key);
    hmac_sha256_hex(key, 63, msg, strlen(msg), hex);
    if (strcmp(hex, "b9f6d3205603dddcfb871b8132f698f2fc3b0cf9765fed0113231d1e6739d728") != 0)
        return err(27, "63 字节 key 不对");
    hmac_sha256_hex(key, 64, msg, strlen(msg), hex);
    if (strcmp(hex, "84332a7580ed3cf75de83c644c8d2c1c262ad90e0190e5c5ae4b82b2102e8e75") != 0)
        return err(28, "64 字节 key 不对");
    hmac_sha256_hex(key, 65, msg, strlen(msg), hex);
    if (strcmp(hex, "c62955a96944ff68deabbc0eab6192065c1c55bb8ddee16151ed5337f911eab9") != 0)
        return err(29, "65 字节 key 不对（该走 sha256(key) 这条路）");
    hmac_sha256_hex(key, 96, msg, strlen(msg), hex);
    if (strcmp(hex, "62bd79bafd458854d6577552bc799781a2f5b2c1acf1f89fb0c9c2e08f503a04") != 0)
        return err(30, "96 字节 key 不对");
}

test "HMAC 的空 key 与字节/hex 两种出口" {
    u8 mac[32] = { 0 };
    char hex[65] = { 0 };
    char hex2[65] = { 0 };

    /* 空 key + 空消息的规范值 */
    hmac_sha256_hex((const void *)0, 0, (const void *)0, 0, hex);
    if (strcmp(hex, "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad") != 0)
        return err(31, "空 key/空消息的 HMAC 不对");
    hmac_sha256_hex("", 0, "abc", 3, hex);
    if (strcmp(hex, "fd7adb152c05ef80dccf50a1fa4c05d5a3ec6da95575fc312ae7c5d091836351") != 0)
        return err(32, "空 key 的 HMAC 不对");
    /* 字节出口与 hex 出口必须一致 */
    hmac_sha256("Jefe", 4, "what do ya want for nothing?", 28, mac);
    sha256_to_hex(mac, hex2);
    hmac_sha256_hex("Jefe", 4, "what do ya want for nothing?", 28, hex);
    if (strcmp(hex, hex2) != 0)
        return err(33, "hmac_sha256 与 hmac_sha256_hex 不一致");
    if (!sha256_eq(mac, mac))
        return err(34, "自己和自己比较也不等");
}

test "错误码与 std.core.err 的语义对齐" {
    if (INVAL == NOMEM || INVAL == 0 || NOMEM == 0)
        return err(35, "错误码重复或为 0");
}
