/* std/net/uds：AF_UNIX 本地套接字（同一台机器上的字节流，路径就是地址）。
 *
 *     import std.net.uds;
 *
 *     Uds srv = uds_listen("build/echo.sock", 8);   // 调用方先确保路径不存在
 *     Uds cli = uds_connect("build/echo.sock", 1000);
 *     Uds peer = srv.accept_client();
 *     cli.write_all("ping", 4);
 *     char buf[8] = { 0 };
 *     peer.read_all(buf, 4);                        // "ping"
 *
 *   不需要地址、只要一对连好的 fd：
 *     UdsPair p = uds_pair();
 *     p.a.send_bytes("hi", 2);
 *     p.b.read_bytes(buf, (int)sizeof buf);         // 2
 *
 * 本地套接字和 TCP 的用法几乎一样（都有 listen/connect/accept 和按字节读写），
 * 区别只有三处：地址是文件系统里的路径（或抽象命名空间）、内核不做校验和与
 * 重传（本机内存拷贝）、`sun_path` 只有 108 字节。需要「同一台机器上两个
 * 进程/两个线程传字节、又要消息边界」时用它；管道（`std.os.pipe`）只能连
 * 有亲缘关系的进程，UDP（`std.net.udp`）不保证顺序。
 *
 * 约定：
 *
 * - 工厂返回 `Uds`，失败时 `fd = -1`，用 `ok()` 判断；其它方法对 `fd = -1`
 *   返回 -1/0，不会崩。`uds_pair()` 的两个端都是 -1 时 `ok()` 为 0。
 * - `uds_listen` **不删除**已存在的路径（可能是别的进程还在用的 socket），
 *   重复 bind 会失败并返回 `fd = -1`；要复用路径就调用方自己 `unlink`。
 *   路径长度必须小于 `sun_path`（108 字节，含结尾 NUL），超了直接失败。
 * - `uds_connect` 的 `timeout_ms >= 0` 用非阻塞 connect + `poll` 实现超时，
 *   `< 0` 是普通阻塞 connect。路径不存在/没有监听者会立刻失败。
 * - `read_bytes` 返回读到的字节数，`0` 是 EOF（对端 `close_socket` 或
 *   `shutdown_write`），`-1` 是错误或超时；`write_bytes` 返回实际写进去的
 *   字节数（流式，可能只写一部分），要发完整用 `write_all`。
 * - 所有读写都自己重试 `EINTR`；不做凭证传递（SO_PEERCRED）、不做抽象
 *   命名空间（`@name` 形式）的跨平台封装。
 */
#include <string.h>
#include <unistd.h>
#include <errno.h>
#include <fcntl.h>
#include <poll.h>
#include <sys/socket.h>
#include <sys/un.h>

module std.net.uds;
import std.core.types;

struct Uds {
    int fd;
};

/* socketpair 的两端（没有地址，天生连好） */
struct UdsPair {
    Uds a;
    Uds b;
};

static Uds uds_bad(void)
{
    Uds u = { -1 };

    return u;
}

int ok(Uds *self) { return self && self->fd >= 0; }

int ok_pair(UdsPair *self)
{
    return self && ok(&self->a) && ok(&self->b);
}

/* 路径能塞进 sockaddr_un 吗（含结尾 NUL） */
static int uds_path_ok(const char *path)
{
    return path && path[0]
        && strlen(path) < sizeof(((struct sockaddr_un *)0)->sun_path);
}

static void uds_fill(struct sockaddr_un *sa, const char *path)
{
    memset(sa, 0, sizeof *sa);
    sa->sun_family = AF_UNIX;
    strncpy(sa->sun_path, path, sizeof sa->sun_path - 1);
}

/* 开一对已经连好的本地 socket；失败两端都是 -1 */
UdsPair uds_pair(void)
{
    UdsPair out = { { -1 }, { -1 } };
    int fds[2] = { -1, -1 };

    if (socketpair(AF_UNIX, SOCK_STREAM, 0, fds) != 0)
        return out;
    out.a.fd = fds[0];
    out.b.fd = fds[1];
    return out;
}

/* 监听：路径必须不存在（或已经 unlink）；失败 fd = -1 */
Uds uds_listen(const char *path, int backlog)
{
    struct sockaddr_un sa = { 0 };
    Uds out = uds_bad();
    int fd = 0;

    if (!uds_path_ok(path))
        return out;
    if (backlog <= 0)
        backlog = 8;
    fd = socket(AF_UNIX, SOCK_STREAM, 0);
    if (fd < 0)
        return out;
    uds_fill(&sa, path);
    if (bind(fd, (struct sockaddr *)&sa, (socklen_t)sizeof sa) != 0
        || listen(fd, backlog) != 0) {
        close(fd);
        return out;
    }
    out.fd = fd;
    return out;
}

/* 连接：timeout_ms >= 0 时带超时；失败 fd = -1 */
Uds uds_connect(const char *path, int timeout_ms)
{
    struct sockaddr_un sa = { 0 };
    Uds out = uds_bad();
    int fd = 0;
    int rc = 0;

    if (!uds_path_ok(path))
        return out;
    fd = socket(AF_UNIX, SOCK_STREAM, 0);
    if (fd < 0)
        return out;
    uds_fill(&sa, path);
    if (timeout_ms < 0) {
        do {
            rc = connect(fd, (struct sockaddr *)&sa, (socklen_t)sizeof sa);
        } while (rc != 0 && errno == EINTR);
        if (rc == 0) {
            out.fd = fd;
            return out;
        }
        close(fd);
        return out;
    }
    {
        int flags = fcntl(fd, F_GETFL, 0);
        struct pollfd pfd = { 0 };
        int soerr = 0;
        socklen_t elen = sizeof soerr;

        fcntl(fd, F_SETFL, flags | O_NONBLOCK);
        do {
            rc = connect(fd, (struct sockaddr *)&sa, (socklen_t)sizeof sa);
        } while (rc != 0 && errno == EINTR);
        if (rc != 0 && errno != EINPROGRESS && errno != EAGAIN) {
            close(fd);
            return out;
        }
        if (rc != 0) {
            pfd.fd = fd;
            pfd.events = POLLOUT;
            rc = poll(&pfd, 1, timeout_ms);
            if (rc <= 0
                || getsockopt(fd, SOL_SOCKET, SO_ERROR, &soerr, &elen) != 0
                || soerr != 0) {
                close(fd);
                return out;
            }
        }
        fcntl(fd, F_SETFL, flags);
        out.fd = fd;
    }
    return out;
}

/* 接受一个连接；失败 fd = -1（不会阻塞在无效 fd 上） */
Uds accept_client(Uds *self)
{
    Uds out = uds_bad();
    int fd = 0;

    if (!ok(self))
        return out;
    do {
        fd = accept(self->fd, (struct sockaddr *)0, (socklen_t *)0);
    } while (fd < 0 && errno == EINTR);
    if (fd >= 0)
        out.fd = fd;
    return out;
}

/* 设置收发超时（毫秒）；0 表示取消超时 */
int set_timeout(Uds *self, int ms)
{
    struct timeval tv = { 0 };

    if (!ok(self) || ms < 0)
        return 0;
    tv.tv_sec = ms / 1000;
    tv.tv_usec = (ms % 1000) * 1000;
    if (setsockopt(self->fd, SOL_SOCKET, SO_RCVTIMEO, &tv,
                   (socklen_t)sizeof tv) != 0)
        return 0;
    if (setsockopt(self->fd, SOL_SOCKET, SO_SNDTIMEO, &tv,
                   (socklen_t)sizeof tv) != 0)
        return 0;
    return 1;
}

/* 发一段（可能只发一部分）；返回发送字节数或 -1 */
int write_bytes(Uds *self, const void *p, int n)
{
    const char *b = (const char *)p;
    int sent = 0;

    if (!ok(self) || n < 0 || (n > 0 && !p))
        return -1;
    while (sent < n) {
        ssize_t k = send(self->fd, b + sent, (size_t)(n - sent), 0);

        if (k < 0) {
            if (errno == EINTR)
                continue;
            return sent > 0 ? sent : -1;
        }
        if (k == 0)
            break;
        sent += (int)k;
    }
    return sent;
}

/* 发完整 n 字节；成功返回 n，失败 -1 */
int write_all(Uds *self, const void *p, int n)
{
    if (!ok(self) || n < 0)
        return -1;
    if (write_bytes(self, p, n) != n)
        return -1;
    return n;
}

/* 收一段：返回字节数；0 = 对端关闭；-1 = 错误/超时 */
int read_bytes(Uds *self, void *p, int cap)
{
    char *b = (char *)p;

    if (!ok(self) || cap <= 0 || !p)
        return -1;
    for (;;) {
        ssize_t k = recv(self->fd, b, (size_t)cap, 0);

        if (k < 0) {
            if (errno == EINTR)
                continue;
            return -1;
        }
        return (int)k;
    }
}

/* 收满 n 字节；返回实际读到的字节数（< n 表示 EOF/错误/超时） */
int read_all(Uds *self, void *p, int n)
{
    char *b = (char *)p;
    int got = 0;

    if (!ok(self) || n < 0)
        return -1;
    while (got < n) {
        int k = read_bytes(self, b + got, n - got);

        if (k <= 0)
            break;
        got += k;
    }
    return got;
}

/* 半关闭（发 FIN），还能继续收 */
int shutdown_write(Uds *self)
{
    if (!ok(self))
        return 0;
    return shutdown(self->fd, SHUT_WR) == 0;
}

/* 关闭；重复调用安全（名字避开 libc 的 close） */
void close_socket(Uds *self)
{
    if (!self || self->fd < 0)
        return;
    close(self->fd);
    self->fd = -1;
}

/* 一次关掉 pair 的两端 */
void close_pair(UdsPair *self)
{
    if (!self)
        return;
    close_socket(&self->a);
    close_socket(&self->b);
}

/* ---- 自测 ---- */

test "socketpair 双向收发与 EOF" {
    UdsPair p = uds_pair();
    char buf[8] = { 0 };
    Uds bad = uds_bad();

    if (!p.ok_pair())
        return err(1, "uds_pair 失败");
    if (!p.b.set_timeout(2000))
        return err(2, "set_timeout 失败");
    if (p.a.write_all("ping", 4) != 4)
        return err(3, "a 没有发全");
    if (p.b.read_all(buf, 4) != 4 || memcmp(buf, "ping", 4) != 0)
        return err(4, "b 收到的内容不对");
    if (!p.a.shutdown_write())
        return err(5, "shutdown_write 失败");
    if (p.b.read_bytes(buf, (int)sizeof buf) != 0)
        return err(6, "半关闭之后读端应该看到 EOF");
    if (p.b.write_all("pong", 4) != 4)
        return err(7, "半关闭只关写方向，反方向还能写");
    if (p.a.read_all(buf, 4) != 4 || memcmp(buf, "pong", 4) != 0)
        return err(8, "反方向的数据不对");
    p.close_pair();
    if (p.a.ok() || p.b.ok() || p.ok_pair())
        return err(9, "close_pair 之后应该都是 fd=-1");
    if (bad.write_all("x", 1) != -1 || bad.read_bytes(buf, 4) != -1)
        return err(10, "fd=-1 的读写应该失败");
    if (bad.accept_client().ok() || bad.shutdown_write())
        return err(11, "fd=-1 的 accept/shutdown 应该失败");
    if (bad.set_timeout(10) != 0)
        return err(12, "fd=-1 的 set_timeout 应该失败");
}

test "路径监听、连接与错误路径" {
    char *path = (char *)"build/std-uds-test.sock";
    char long_path[160] = { 0 };
    Uds srv = uds_bad(), cli = uds_bad(), peer = uds_bad();
    char buf[8] = { 0 };

    unlink(path);
    srv = uds_listen(path, 4);
    if (!srv.ok())
        return err(13, "uds_listen 失败");
    cli = uds_connect(path, 2000);
    if (!cli.ok())
        return err(14, "uds_connect 失败");
    peer = srv.accept_client();
    if (!peer.ok())
        return err(15, "accept_client 失败");
    if (!cli.set_timeout(2000))
        return err(16, "set_timeout 失败");
    if (cli.write_all("ping", 4) != 4)
        return err(17, "cli 发不出去");
    if (peer.read_all(buf, 4) != 4 || memcmp(buf, "ping", 4) != 0)
        return err(18, "peer 收到的内容不对");
    if (peer.write_all("pong", 4) != 4)
        return err(19, "peer 发不出去");
    if (cli.read_all(buf, 4) != 4 || memcmp(buf, "pong", 4) != 0)
        return err(20, "cli 收到的内容不对");
    /* 同一个路径再 bind 一次必须失败（不替调用方删别人的 socket） */
    if (uds_listen(path, 4).ok())
        return err(21, "重复 bind 应该失败");
    peer.close_socket();
    cli.close_socket();
    srv.close_socket();
    unlink(path);
    /* 路径不存在 / 太长 / 空的失败路径 */
    if (uds_connect(path, 100).ok())
        return err(22, "不存在的路径应该连不上");
    memset(long_path, 'a', (int)sizeof long_path - 1);
    if (uds_listen(long_path, 4).ok() || uds_connect(long_path, 10).ok())
        return err(23, "超长路径应该失败");
    if (uds_listen("", 4).ok() || uds_connect("", 10).ok())
        return err(24, "空路径应该失败");
}
