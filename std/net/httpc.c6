/* std/net/httpc：HTTP/1.1 客户端（构建请求、解析响应、chunked 解码、发一次请求）。
 *
 *     import std.net.httpc;
 *     import std.net.url;
 *
 *     char raw[8192] = { 0 };
 *     char body[8192] = { 0 };
 *     Response res = { 0 };
 *     int rc = fetch(SS("GET"), SS("http://example.com/"), SS(""), SS(""),
 *                    3000, raw, (int)sizeof raw, &res, body, (int)sizeof body);
 *     // rc == 1：res.status == 200，res.body 是 body（chunked）或 raw 上的视图
 *
 * `std.net.http` 只解析**已经收完**的字节（服务端/代理用），`std.net.tcp` 只
 * 搬字节。这里把两端接起来：用 `std.net.url` 拆 URL、`std.net.tcp` 连接、
 * 拼出请求行与必需的头、收响应并把 `Transfer-Encoding: chunked` 的 body 解到
 * 调用方缓冲。零分配：请求缓冲、响应缓冲、body 缓冲都由调用方给。
 *
 * 约定：
 *
 * - 只做 `http://`（不链 TLS）；`https://` 在 `fetch` 里直接失败，别指望它
 *   悄悄降级成明文。
 * - `fetch` 的请求（含 body）必须放得进 4 KiB 的内部缓冲，放不下返回 -1；
 *   大 body 用 `build_request` + `std.net.tcp` 自己分两段写。
 * - 请求默认带 `Host`、`User-Agent: c6-stdlib/1.0`、`Accept`（星号斜杠星号）、
 *   `Connection: close`；body 非空且调用方没给 `Content-Length` 时自动补。
 *   调用方给的额外头**原样**拼在自动头之后（约定是 `Name: value\r\n` 序列，
 *   末尾没有空行）；自己写了 `Host`/`Connection`/`Content-Length` 时对应的
 *   自动头就不再加。
 * - `build_request` 是**先量再写**：容量不够返回 -1，`dst` 一个字节都不动。
 * - `parse_response` 返回 1（完整）/ 0（数据还不够，`incomplete = 1`）/
 *   -1（格式错，`msg` 是静态原因）。响应按以下顺序定 body：204/304/1xx 无
 *   body → `chunked` 解到调用方缓冲 → `Content-Length` 截取 → 其余以连接
 *   关闭为界（`needs_close = 1`，`fetch` 会读到 EOF 再收）。
 * - 头字段名大小写不敏感，值去掉两端 SP/HTAB；重复的 `Content-Length` 值不
 *   一致按格式错处理；不接受 obs-fold 续行。
 * - 不做重定向、不做 100-continue、不做 HEAD 的特殊处理（服务器对 HEAD 仍
 *   可能给 Content-Length 但没有 body，`fetch` 会等到超时——HEAD 请用
 *   `build_request` 自己发、只解析头部）、不缓存、不重试。
 */
#include <string.h>

module std.net.httpc;
import std.core.types;
import std.net.tcp;
import std.net.url;
import std.text.str;

/* 字面量 -> 视图（宏不随 import 传递，每个模块自己定义一次） */
#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })
#define SS(lit) ((Str){ S(lit) })

enum Error {
    OK = 0,
    INVAL = 1,      /* 参数/URL 不合法 */
    PARSE = 2,      /* 报文格式错 */
    IO = 3,         /* 连接/读写失败 */
    UNSUPP = 4,     /* 不支持的 scheme 或特性 */
};

struct Response {
    int status;         /* 状态码 */
    Str reason;         /* 状态行的 reason（可能为空） */
    Str raw;            /* 完整响应（视图，指向调用方缓冲） */
    Str body;           /* 解码后的 body */
    int header_end;     /* body 在 raw 里的起点 */
    int chunked;        /* 1 = Transfer-Encoding: chunked */
    int content_length; /* -1 = 没有 Content-Length */
    int needs_close;    /* 1 = body 以连接关闭为界 */
    int ok;             /* 1 = 解析成功 */
    int incomplete;     /* 1 = 数据还不够（parse_response 返回 0） */
    const char *msg;    /* 失败原因（静态字符串） */
};

static Str str_empty(void)
{
    Str s = { { (char *)0, 0 } };

    return s;
}

static Str str_view(char *p, int n)
{
    Str s = { { p, n } };

    return s;
}

static int lower(int c)
{
    return (c >= 'A' && c <= 'Z') ? c + 32 : c;
}

/* 两个视图都转小写比较 */
static int ieq_str(Str *a, Str *b)
{
    int i = 0;

    if (!a || !b || a->s.len != b->s.len)
        return 0;
    for (i = 0; i < a->s.len; i++)
        if (lower((int)(u8)a->s.data[i]) != lower((int)(u8)b->s.data[i]))
            return 0;
    return 1;
}

/* 视图和 C 字面量比较（忽略大小写） */
static int ieq_char(Str *a, char *z)
{
    int i = 0, n = (int)strlen(z);

    if (!a || a->s.len != n)
        return 0;
    for (i = 0; i < n; i++)
        if (lower((int)(u8)a->s.data[i]) != lower((int)(u8)z[i]))
            return 0;
    return 1;
}

static int contains_i(Str *s, char *needle)
{
    int n = (int)strlen(needle);
    int i = 0, j = 0;

    if (!s || n <= 0 || s->s.len < n)
        return 0;
    for (i = 0; i + n <= s->s.len; i++) {
        for (j = 0; j < n; j++)
            if (lower((int)(u8)s->s.data[i + j])
                != lower((int)(u8)needle[j]))
                break;
        if (j == n)
            return 1;
    }
    return 0;
}

static Str trim_view(char *p, int n)
{
    int a = 0, b = n;

    while (a < b && (p[a] == ' ' || p[a] == '\t' || p[a] == '\r'))
        a++;
    while (b > a && (p[b - 1] == ' ' || p[b - 1] == '\t' || p[b - 1] == '\r'))
        b--;
    return str_view(p + a, b - a);
}

static int find_nl(char *p, int n, int from, int *nl)
{
    int i = 0;

    for (i = from; i < n; i++) {
        if (p[i] == '\n') {
            *nl = i;
            return 1;
        }
    }
    return 0;
}

/* 头字段迭代器：pos 从状态行之后开始，到 header_end 结束 */
struct HdrIter {
    char *p;
    int n;
    int pos;
};

/* 1 = 取到一对，0 = 结束，-1 = 坏行（没有冒号/空名字） */
static int hdr_next(HdrIter *it, Str *name, Str *value)
{
    int nl = 0, le = 0, colon = 0;

    if (it->pos >= it->n)
        return 0;
    if (!find_nl(it->p, it->n, it->pos, &nl))
        return 0;
    le = nl;
    if (le > it->pos && it->p[le - 1] == '\r')
        le--;
    if (le == it->pos) {
        it->pos = nl + 1;
        return 0;
    }
    for (colon = it->pos; colon < le && it->p[colon] != ':'; colon++)
        ;
    if (colon >= le)
        return -1;
    *name = trim_view(it->p + it->pos, colon - it->pos);
    *value = trim_view(it->p + colon + 1, le - colon - 1);
    it->pos = nl + 1;
    if (name->s.len <= 0)
        return -1;
    return 1;
}

/* 状态行：HTTP/1.x SP 3 位状态码 [SP reason]；1 成功 / 0 还不够 / -1 坏 */
static int parse_status(Str raw, int *status, Str *reason, int *eol)
{
    int nl = 0, le = 0, i = 0, st = 0;

    if (!find_nl(raw.s.data, raw.s.len, 0, &nl))
        return 0;
    le = nl;
    if (le > 0 && raw.s.data[le - 1] == '\r')
        le--;
    if (le < 12 || memcmp(raw.s.data, "HTTP/1.", 7) != 0
        || raw.s.data[7] < '0' || raw.s.data[7] > '9'
        || raw.s.data[8] != ' ')
        return -1;
    for (i = 9; i < 12; i++) {
        if (raw.s.data[i] < '0' || raw.s.data[i] > '9')
            return -1;
        st = st * 10 + (raw.s.data[i] - '0');
    }
    if (le > 12 && raw.s.data[12] != ' ')
        return -1;
    *status = st;
    *reason = (le > 13) ? trim_view(raw.s.data + 13, le - 13) : str_empty();
    *eol = nl + 1;
    return 1;
}

/* 头结束的位置：空行之后；1 成功 / 0 还不够 / -1 坏（不可能出现，留给将来） */
static int find_header_end(Str raw, int from, int *end)
{
    int pos = from, nl = 0, le = 0;

    for (;;) {
        if (!find_nl(raw.s.data, raw.s.len, pos, &nl))
            return 0;
        le = nl;
        if (le > pos && raw.s.data[le - 1] == '\r')
            le--;
        if (le == pos) {
            *end = nl + 1;
            return 1;
        }
        pos = nl + 1;
    }
}

/* 扫头里的 Content-Length / Transfer-Encoding；1 成功，-1 有坏行/坏值 */
static int scan_meta(Str raw, int eol, int hend, int *cl, int *chunked)
{
    HdrIter it = { 0 };
    Str name = str_empty(), value = str_empty();
    int rc = 0;

    it.p = raw.s.data;
    it.n = hend;
    it.pos = eol;
    while ((rc = hdr_next(&it, &name, &value)) == 1) {
        if (ieq_char(&name, "content-length")) {
            i64 v = 0;
            int i = 0;

            if (value.s.len <= 0)
                return -1;
            for (i = 0; i < value.s.len; i++) {
                int c = value.s.data[i];

                if (c < '0' || c > '9')
                    return -1;
                if (v > 0x7fffffffll / 10)
                    return -1;
                v = v * 10 + (c - '0');
                if (v > 0x7fffffffll)
                    return -1;
            }
            if (*cl >= 0 && *cl != (int)v)
                return -1;
            *cl = (int)v;
        } else if (ieq_char(&name, "transfer-encoding")) {
            if (contains_i(&value, "chunked"))
                *chunked = 1;
        }
    }
    return rc < 0 ? -1 : 1;
}

/* chunked 解码到 dst：1 完成 / 0 还不够 / -1 坏报文或 dst 太小 */
static int decode_chunked(Str raw, int start, char *dst, int cap, int *outlen)
{
    int pos = start, total = 0, nl = 0, le = 0, i = 0;

    for (;;) {
        i64 size = 0;
        int digits = 0;

        if (!find_nl(raw.s.data, raw.s.len, pos, &nl))
            return 0;
        le = nl;
        if (le > pos && raw.s.data[le - 1] == '\r')
            le--;
        for (i = pos; i < le; i++) {
            int c = (int)(u8)raw.s.data[i];
            int v = -1;

            if (c >= '0' && c <= '9')
                v = c - '0';
            else if (c >= 'a' && c <= 'f')
                v = c - 'a' + 10;
            else if (c >= 'A' && c <= 'F')
                v = c - 'A' + 10;
            else if (c == ';' || c == ' ' || c == '\t')
                break;
            else
                return -1;
            if (digits >= 15 || size > 0x7fffffffll / 16)
                return -1;
            size = size * 16 + v;
            digits++;
        }
        if (digits == 0)
            return -1;
        pos = nl + 1;
        if (size == 0) {
            /* 最后一个 chunk 之后是可选 trailer，最后跟一个空行 */
            for (;;) {
                int ls = pos;

                if (!find_nl(raw.s.data, raw.s.len, pos, &nl))
                    return 0;
                le = nl;
                if (le > ls && raw.s.data[le - 1] == '\r')
                    le--;
                pos = nl + 1;
                if (le == ls)
                    break;
            }
            *outlen = total;
            return 1;
        }
        if (pos + (int)size + 1 > raw.s.len)
            return 0;
        if (total + (int)size > cap)
            return -1;
        if (size > 0)
            memcpy(dst + total, raw.s.data + pos, (size_t)size);
        total += (int)size;
        pos += (int)size;
        if (pos < raw.s.len && raw.s.data[pos] == '\r')
            pos++;
        if (pos >= raw.s.len || raw.s.data[pos] != '\n')
            return -1;
        pos++;
    }
}

/* 解析完整响应：1 完整 / 0 还不够 / -1 坏报文 */
int parse_response(Str raw, Response *out, char *body, int cap)
{
    int eol = 0, hend = 0, status = 0, cl = -1, chunked = 0, rc = 0;
    int avail = 0, blen = 0;
    Str reason = str_empty();

    if (!out)
        return -1;
    out->status = 0;
    out->reason = str_empty();
    out->raw = raw;
    out->body = str_empty();
    out->header_end = 0;
    out->chunked = 0;
    out->content_length = -1;
    out->needs_close = 0;
    out->ok = 0;
    out->incomplete = 1;
    out->msg = "incomplete response";
    if (!raw.s.data || raw.s.len <= 0)
        return 0;
    rc = parse_status(raw, &status, &reason, &eol);
    if (rc == 0)
        return 0;
    if (rc < 0) {
        out->incomplete = 0;
        out->msg = "bad status line";
        return -1;
    }
    out->status = status;
    out->reason = reason;
    rc = find_header_end(raw, eol, &hend);
    if (rc == 0)
        return 0;
    out->header_end = hend;
    rc = scan_meta(raw, eol, hend, &cl, &chunked);
    if (rc < 0) {
        out->incomplete = 0;
        out->msg = "bad header";
        return -1;
    }
    out->chunked = chunked;
    out->content_length = cl;
    out->incomplete = 0;
    avail = raw.s.len - hend;
    if (status == 204 || status == 304 || (status >= 100 && status < 200)) {
        out->ok = 1;
        out->msg = "ok";
        return 1;
    }
    if (chunked) {
        rc = decode_chunked(raw, hend, body, cap, &blen);
        if (rc == 0) {
            out->incomplete = 1;
            out->msg = "incomplete chunked body";
            return 0;
        }
        if (rc < 0) {
            out->msg = "bad chunked body";
            return -1;
        }
        out->body = str_view(body, blen);
        out->ok = 1;
        out->msg = "ok";
        return 1;
    }
    if (cl >= 0) {
        if (cl > avail) {
            out->incomplete = 1;
            out->msg = "incomplete body";
            return 0;
        }
        out->body = str_view(raw.s.data + hend, cl);
        out->ok = 1;
        out->msg = "ok";
        return 1;
    }
    out->body = str_view(raw.s.data + hend, avail);
    out->needs_close = 1;
    out->ok = 1;
    out->msg = "ok";
    return 1;
}

int is_ok(Response *self)
{
    return self && self->ok && self->status >= 200 && self->status < 300;
}

/* 头字段值（大小写不敏感）；没有就给空视图 */
Str header(Response *self, Str name)
{
    HdrIter it = { 0 };
    Str hn = str_empty(), hv = str_empty();
    int st = 0, eol = 0;
    Str reason = str_empty();

    if (!self || !self->ok || !self->raw.s.data)
        return str_empty();
    if (parse_status(self->raw, &st, &reason, &eol) != 1)
        return str_empty();
    it.p = self->raw.s.data;
    it.n = self->header_end;
    it.pos = eol;
    while (hdr_next(&it, &hn, &hv) == 1)
        if (ieq_str(&hn, &name))
            return hv;
    return str_empty();
}

/* 头字段的十进制值：1 成功，0 没有/不是十进制 */
int header_int(Response *self, Str name, i64 *out)
{
    Str v = header(self, name);
    i64 n = 0;
    int i = 0;

    if (!out || v.s.len <= 0)
        return 0;
    for (i = 0; i < v.s.len; i++) {
        int c = v.s.data[i];

        if (c < '0' || c > '9')
            return 0;
        if (n > 0x7fffffffffffffffll / 10)
            return 0;
        n = n * 10 + (c - '0');
    }
    *out = n;
    return 1;
}

/* ---- 请求构建 ---- */

struct Rw {
    char *dst;      /* 0 = 只量长度 */
    int cap;
    int n;
    int bad;
};

static void rw_bytes(Rw *w, const char *p, int n)
{
    if (w->bad)
        return;
    if (n < 0 || w->n + n > w->cap) {
        w->bad = 1;
        return;
    }
    if (w->dst && n > 0)
        memcpy(w->dst + w->n, p, (size_t)n);
    w->n += n;
}

static void rw_cstr(Rw *w, char *z) { rw_bytes(w, z, (int)strlen(z)); }

static void rw_str(Rw *w, Str *s)
{
    if (s && s->s.data && s->s.len > 0)
        rw_bytes(w, s->s.data, s->s.len);
}

static void rw_int(Rw *w, i64 v)
{
    char tmp[24] = { 0 };
    u64 u = 0;
    int n = 0, i = 0;

    if (v < 0) {
        rw_bytes(w, "-", 1);
        u = (u64)(-(v + 1)) + 1;
    } else {
        u = (u64)v;
    }
    do {
        tmp[n++] = (char)('0' + (int)(u % 10));
        u /= 10;
    } while (u > 0 && n < (int)sizeof tmp);
    for (i = n - 1; i >= 0; i--)
        rw_bytes(w, tmp + i, 1);
}

/* 头块里有没有这个名字（按行扫，大小写不敏感） */
static int has_header(Str headers, char *name)
{
    int pos = 0, nl = 0, le = 0, colon = 0, start = 0;

    if (!headers.s.data || headers.s.len <= 0)
        return 0;
    while (pos < headers.s.len) {
        Str hn = str_empty();

        if (!find_nl(headers.s.data, headers.s.len, pos, &nl)) {
            nl = headers.s.len;
            le = nl;
        } else {
            le = nl;
        }
        if (le > pos && headers.s.data[le - 1] == '\r')
            le--;
        start = pos;
        while (start < le && (headers.s.data[start] == ' '
                              || headers.s.data[start] == '\t'))
            start++;
        for (colon = start; colon < le && headers.s.data[colon] != ':'; colon++)
            ;
        if (colon < le) {
            hn = trim_view(headers.s.data + start, colon - start);
            if (ieq_char(&hn, name))
                return 1;
        }
        if (nl >= headers.s.len)
            break;
        pos = nl + 1;
    }
    return 0;
}

static int ends_with_newline(Str s)
{
    if (!s.s.data || s.s.len <= 0)
        return 1;
    return s.s.data[s.s.len - 1] == '\n';
}

/* 拼请求；dst 为 0 时只量长度。返回长度或 -1 */
static int emit_request(char *dst, int cap, Str method, Url *u, Str headers,
                        Str body)
{
    Rw w = { dst, cap, 0, 0 };
    int port = 0;
    int host_v6 = 0;
    int i = 0;

    port = u->effective_port();
    for (i = 0; i < u->host.s.len; i++)
        if (u->host.s.data[i] == ':')
            host_v6 = 1;
    rw_str(&w, &method);
    rw_cstr(&w, " ");
    if (u->path.s.len > 0)
        rw_str(&w, &u->path);
    else
        rw_cstr(&w, "/");
    if (u->query.s.len > 0) {
        rw_cstr(&w, "?");
        rw_str(&w, &u->query);
    }
    rw_cstr(&w, " HTTP/1.1\r\n");
    if (!has_header(headers, "host")) {
        rw_cstr(&w, "Host: ");
        if (host_v6)
            rw_cstr(&w, "[");
        rw_str(&w, &u->host);
        if (host_v6)
            rw_cstr(&w, "]");
        if (port > 0 && port != 80) {
            rw_cstr(&w, ":");
            rw_int(&w, port);
        }
        rw_cstr(&w, "\r\n");
    }
    rw_cstr(&w, "User-Agent: c6-stdlib/1.0\r\nAccept: */*\r\n");
    if (!has_header(headers, "connection"))
        rw_cstr(&w, "Connection: close\r\n");
    if (body.s.len > 0 && !has_header(headers, "content-length")) {
        rw_cstr(&w, "Content-Length: ");
        rw_int(&w, body.s.len);
        rw_cstr(&w, "\r\n");
    }
    if (headers.s.len > 0) {
        rw_str(&w, &headers);
        if (!ends_with_newline(headers))
            rw_cstr(&w, "\r\n");
    }
    rw_cstr(&w, "\r\n");
    rw_str(&w, &body);
    return w.bad ? -1 : w.n;
}

/* 构建一个请求：先量长度再落笔；放不下返回 -1 且 dst 不动 */
int build_request(Str method, Url *u, Str headers, Str body, char *dst, int cap)
{
    int need = 0, n = 0;

    if (!u || !dst || cap <= 0 || !method.s.data || method.s.len <= 0)
        return -1;
    need = emit_request(0, 0x7fffffff, method, u, headers, body);
    if (need < 0 || need + 1 > cap)
        return -1;
    n = emit_request(dst, cap - 1, method, u, headers, body);
    if (n != need)
        return -1;
    dst[n] = 0;
    return n;
}

/* 发一次请求并收响应：1 成功 / -1 失败（out->msg 是原因） */
int fetch(Str method, Str url, Str headers, Str body, int timeout_ms,
          char *raw, int raw_cap, Response *out, char *body_buf, int body_cap)
{
    Url u = url_parse(url.s);
    char host[256] = { 0 };
    char req[4096] = { 0 };
    Tcp sock = { -1 };
    int rn = 0, got = 0, rc = 0, k = 0, port = 0;

    if (!out || !raw || raw_cap < 2 || !body_buf || body_cap < 0)
        return -1;
    out->msg = "bad url";
    out->ok = 0;
    if (!u.ok || !u.is_absolute() || !u.has_host())
        return -1;
    if (!ieq_char(&u.scheme, "http")) {
        out->msg = "unsupported scheme (no TLS in std.net.httpc)";
        return -1;
    }
    if (u.host.s.len <= 0 || u.host.s.len >= (int)sizeof host)
        return -1;
    memcpy(host, u.host.s.data, (size_t)u.host.s.len);
    host[u.host.s.len] = 0;
    port = u.effective_port();
    if (port <= 0 || port > 65535)
        return -1;
    out->msg = "request too large";
    rn = build_request(method, &u, headers, body, req, (int)sizeof req);
    if (rn <= 0)
        return -1;
    out->msg = "connect failed";
    sock = tcp_connect(host, port, timeout_ms);
    if (!sock.ok())
        return -1;
    if (timeout_ms >= 0)
        sock.set_timeout(timeout_ms);
    out->msg = "write failed";
    if (sock.write_all(req, rn) != rn) {
        sock.close_socket();
        return -1;
    }
    out->msg = "read failed";
    raw[0] = 0;
    for (;;) {
        rc = parse_response((Str){ (char[:]){ raw, got } }, out, body_buf,
                            body_cap);
        if (rc == 1 && !out->needs_close)
            break;
        if (rc < 0) {
            sock.close_socket();
            return -1;
        }
        if (got >= raw_cap - 1) {
            sock.close_socket();
            out->msg = "response too large";
            return -1;
        }
        k = sock.read_bytes(raw + got, raw_cap - 1 - got);
        if (k < 0) {
            sock.close_socket();
            out->msg = "read timeout";
            return -1;
        }
        if (k == 0) {
            if (rc == 1)
                break;          /* 以连接关闭为界的 body 到此完整 */
            sock.close_socket();
            out->msg = "incomplete response";
            return -1;
        }
        got += k;
        raw[got] = 0;
    }
    sock.close_socket();
    return 1;
}

/* ---- 自测 ---- */

#define RESP_FIXED \
    "HTTP/1.1 404 Not Found\r\n" \
    "Content-Length: 3\r\n" \
    "X-Test:  a b \r\n" \
    "\r\n" \
    "bad"

#define RESP_CHUNKED \
    "HTTP/1.1 200 OK\r\n" \
    "Transfer-Encoding: chunked\r\n" \
    "X-Empty:\r\n" \
    "\r\n" \
    "5;ext=1\r\nhello\r\n6\r\n world\r\n0\r\nX-Trailer: 1\r\n\r\n"

test "构建请求：GET / POST / 额外头 / 容量" {
    Url u = url_parse(S("http://example.com/a/b?q=1"));
    Url post = url_parse(S("http://127.0.0.1:8080/x"));
    char req[512] = { 0 };
    char small[8] = { 'a', 'b', 'c', 0, 0, 0, 0, 0 };
    int n = 0;

    n = build_request(SS("GET"), &u, SS(""), SS(""), req, (int)sizeof req);
    if (n != (int)strlen("GET /a/b?q=1 HTTP/1.1\r\n"
                         "Host: example.com\r\n"
                         "User-Agent: c6-stdlib/1.0\r\n"
                         "Accept: */*\r\n"
                         "Connection: close\r\n"
                         "\r\n")
        || strstr(req, "GET /a/b?q=1 HTTP/1.1\r\n") != req)
        return err(1, "GET 请求字节不对");
    if (build_request(SS("GET"), &u, SS(""), SS(""), small, (int)sizeof small)
        != -1 || small[0] != 'a')
        return err(2, "容量不够应该给 -1 且不动缓冲");
    n = build_request(SS("POST"), &post, SS("X-Test: 1\r\n"), SS("hi"), req,
                      (int)sizeof req);
    if (n <= 0)
        return err(3, "POST 构建失败");
    if (!strstr(req, "Host: 127.0.0.1:8080\r\n")
        || !strstr(req, "Content-Length: 2\r\n")
        || !strstr(req, "X-Test: 1\r\n\r\nhi"))
        return err(4, "POST 请求缺少端口/长度/额外头");
    /* 调用方自己给 Host / Content-Length 时不再重复 */
    n = build_request(SS("PUT"), &u, SS("Host: h\r\nContent-Length: 1\r\n"),
                      SS("z"), req, (int)sizeof req);
    if (n <= 0 || strstr(req, "Host: example.com") || strstr(req, "Content-Length: 1\r\nContent-Length"))
        return err(5, "调用方的 Host/Content-Length 被重复添加");
    if (build_request(SS(""), &u, SS(""), SS(""), req, (int)sizeof req) != -1)
        return err(6, "空方法应该失败");
    if (build_request(SS("GET"), 0, SS(""), SS(""), req, (int)sizeof req) != -1)
        return err(7, "空 Url 应该失败");
}

test "解析固定长度响应与头字段" {
    Str raw = { S(RESP_FIXED) };
    Response r = { 0 };
    char body[64] = { 0 };
    i64 cl = 0;

    if (parse_response(raw, &r, body, (int)sizeof body) != 1)
        return err(8, "固定长度响应没解析成功");
    if (r.status != 404 || !r.raw.s.data || r.ok != 1 || r.incomplete)
        return err(9, "状态/字段不对");
    if (r.reason.s.len != 9 || memcmp(r.reason.s.data, "Not Found", 9) != 0)
        return err(10, "reason 不对");
    if (r.body.s.len != 3 || memcmp(r.body.s.data, "bad", 3) != 0)
        return err(11, "body 不对");
    if (r.chunked || r.needs_close || r.content_length != 3)
        return err(12, "body 分界标志不对");
    if (r.is_ok())
        return err(13, "404 不该 is_ok");
    if (!r.header_int(SS("content-length"), &cl) || cl != 3)
        return err(14, "header_int 不对");
    if (!r.header_int(SS("Content-Length"), &cl))
        return err(15, "头名字应该大小写不敏感");
    if (r.header(SS("X-Test")).s.len != 3
        || memcmp(r.header(SS("x-test")).s.data, "a b", 3) != 0)
        return err(16, "头值两端的空白没去掉");
    if (r.header(SS("X-Missing")).s.len != 0)
        return err(17, "不存在的头应该给空视图");
    if (r.header_int(SS("X-Test"), &cl))
        return err(18, "非十进制头不该给数字");
    /* incomplete：只给一半 body */
    if (parse_response((Str){ S("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nab") },
                       &r, body, (int)sizeof body) != 0
        || !r.incomplete || r.ok)
        return err(19, "body 不够时应该是 0 + incomplete");
    /* 坏行 / 坏状态行 */
    if (parse_response((Str){ S("HTTP/1.1 200 OK\r\nBadHeader\r\n\r\n") }, &r,
                       body, (int)sizeof body) != -1)
        return err(20, "没有冒号的头应该失败");
    if (parse_response((Str){ S("NOPE\r\n\r\n") }, &r, body, (int)sizeof body)
        != -1)
        return err(21, "坏状态行应该失败");
    if (parse_response((Str){ S("HTTP/1.1 20 OK\r\n\r\n") }, &r, body,
                       (int)sizeof body) != -1)
        return err(22, "状态码不是 3 位应该失败");
    /* 空输入 / 只有状态行 */
    if (parse_response((Str){ S("") }, &r, body, (int)sizeof body) != 0)
        return err(23, "空输入应该是 0");
    if (parse_response((Str){ S("HTTP/1.1 200 OK\r\n") }, &r, body,
                       (int)sizeof body) != 0)
        return err(24, "只有状态行应该是 0");
    /* 204 / 304 没有 body */
    if (parse_response((Str){ S("HTTP/1.1 204 No Content\r\n\r\n") }, &r, body,
                       (int)sizeof body) != 1
        || r.body.s.len != 0 || !r.ok)
        return err(25, "204 应该没有 body");
    /* 没有 CL 也没 chunked：以连接关闭为界 */
    if (parse_response((Str){ S("HTTP/1.0 200 OK\r\nServer: x\r\n\r\nabc") }, &r,
                       body, (int)sizeof body) != 1
        || !r.needs_close || r.body.s.len != 3)
        return err(26, "close 分界的 body 不对");
}

test "chunked 解码与坏报文" {
    Str raw = { S(RESP_CHUNKED) };
    Response r = { 0 };
    char body[64] = { 0 };
    int rc = 0;

    rc = parse_response(raw, &r, body, (int)sizeof body);
    if (rc != 1)
        return err(28, "chunked 响应没解出来");
    if (!r.chunked || r.body.s.len != 11
        || memcmp(r.body.s.data, "hello world", 11) != 0)
        return err(29, "chunked body 不对");
    if (r.needs_close || r.content_length != -1 || !r.is_ok())
        return err(30, "chunked 的标志/状态不对");
    /* body 缓冲太小 */
    if (parse_response(raw, &r, body, 4) != -1 || r.msg == 0)
        return err(31, "body 缓冲太小应该失败");
    /* 截断：只到第一个 chunk 的数据 */
    if (parse_response((Str){ S("HTTP/1.1 200 OK\r\n"
                               "Transfer-Encoding: chunked\r\n\r\n"
                               "5\r\nhello\r\n") },
                       &r, body, (int)sizeof body) != 0
        || !r.incomplete)
        return err(32, "chunked 截断应该是 0");
    /* 坏 chunk 长度 */
    if (parse_response((Str){ S("HTTP/1.1 200 OK\r\n"
                               "Transfer-Encoding: chunked\r\n\r\n"
                               "zz\r\nhello\r\n") },
                       &r, body, (int)sizeof body) != -1)
        return err(33, "非十六进制 chunk 长度应该失败");
    /* chunk 数据后面的 CRLF 不对 */
    if (parse_response((Str){ S("HTTP/1.1 200 OK\r\n"
                               "Transfer-Encoding: chunked\r\n\r\n"
                               "1\r\nxX\r\n0\r\n\r\n") },
                       &r, body, (int)sizeof body) != -1)
        return err(34, "chunk 后没有 CRLF 应该失败");
    /* 空 chunk（只有结尾） */
    if (parse_response((Str){ S("HTTP/1.1 200 OK\r\n"
                               "Transfer-Encoding: chunked\r\n\r\n0\r\n\r\n") },
                       &r, body, (int)sizeof body) != 1
        || r.body.s.len != 0)
        return err(35, "0 长度的 chunked 应该是空 body");
}

test "socket 往返与 fetch 的失败路径" {
    Tcp srv = tcp_listen("127.0.0.1", 0, 4);
    int p = srv.port();
    Tcp cli = { -1 }, peer = { -1 };
    Url u = url_parse(S("http://127.0.0.1/x"));
    char req[256] = { 0 }, buf[256] = { 0 }, body[64] = { 0 };
    Response r = { 0 };
    int n = 0, got = 0, rc = 0;
    char *resp = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok";

    if (!srv.ok() || p <= 0)
        return err(36, "监听失败");
    cli = tcp_connect("127.0.0.1", p, 1000);
    peer = srv.accept_client();
    if (!cli.ok() || !peer.ok())
        return err(37, "连接/接受失败");
    n = build_request(SS("GET"), &u, SS(""), SS(""), req, (int)sizeof req);
    if (n <= 0 || cli.write_all(req, n) != n)
        return err(38, "请求发不出去");
    if (peer.read_all(buf, n) != n || memcmp(buf, req, (size_t)n) != 0)
        return err(39, "服务端收到的请求字节不对");
    if (peer.write_all(resp, (int)strlen(resp)) != (int)strlen(resp))
        return err(40, "响应发不出去");
    for (;;) {
        rc = cli.read_bytes(buf + got, (int)sizeof buf - got);
        if (rc <= 0)
            break;
        got += rc;
        rc = parse_response((Str){ (char[:]){ buf, got } }, &r, body,
                            (int)sizeof body);
        if (rc == 1)
            break;
    }
    if (rc != 1 || r.status != 200 || r.body.s.len != 2
        || memcmp(r.body.s.data, "ok", 2) != 0)
        return err(41, "socket 往返之后解析不对");
    cli.close_socket();
    peer.close_socket();
    srv.close_socket();
    /* https 直接失败；连不上的端口也失败 */
    {
        char raw[64] = { 0 };
        Response bad = { 0 };
        char bb[16] = { 0 };

        if (fetch(SS("GET"), SS("https://example.com/"), SS(""), SS(""), 100,
                  raw, (int)sizeof raw, &bad, bb, (int)sizeof bb) != -1)
            return err(42, "https 应该失败（不做 TLS）");
        if (fetch(SS("GET"), SS("http://127.0.0.1:1/"), SS(""), SS(""), 100,
                  raw, (int)sizeof raw, &bad, bb, (int)sizeof bb) != -1)
            return err(43, "连不上的端口应该失败");
    }
}
