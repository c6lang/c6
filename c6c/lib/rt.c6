/* c6c 自带运行时（freestanding）。
 *
 * 被自动 include 到用户 TU 的最前面（`-nostdlib` 关掉这一行为）。
 * 只用系统调用 + 编译器内建，**不依赖任何 libc**，也不假设动态链接器存在。
 * 约定：文件系统/进程相关的极端细节走 Linux x86-64 的裸调用号。
 */
#ifndef _C6C_RT_C6
#define _C6C_RT_C6

#include <stddef.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>

/* `errno` 是每进程一个整数（<errno.h> 里是 `extern int errno;`）。rt.c6 是
 * 被塞进每个 TU 最前面的前置代码，所以这里给一个 weak 定义：单 TU 程序只有
 * 一份，多 TU 链接时也不会撞成"重复定义"。
 *
 * 为什么需要它：裸 syscall 包装一直只返回 -errno、**不设 errno**，于是按
 * `errno == EINPROGRESS` / `EAGAIN` / `EINTR` 分支的代码（std/net/tcp.c6 的
 * 非阻塞 connect 就是）永远走"失败"那条路。现在 c6c_sys* 在返回负数时顺手把
 * errno 设成同一个值——返回值口径不变（仍是 -errno），errno 也终于是对的。 */
#ifdef errno
/* 系统的 <errno.h>（glibc / musl）把 errno 做成了宏 `(*__errno_location())`：
 * 那种情况下用系统那份线程安全的 errno，这里不要再定义第二个。tcc 那套
 * 构建走的就是这条路，定义重复会直接编不过。 */
#else
__attribute__((weak)) int errno = 0;
#endif

static long c6c_sys_errno(long r)
{
    if (r < 0 && r > -4096)
        errno = (int)(-r);
    return r;
}

/* ---------- 系统调用 ---------- */
#define C6C_SYS_READ 0
#define C6C_SYS_WRITE 1
#define C6C_SYS_OPEN 2
#define C6C_SYS_CLOSE 3
#define C6C_SYS_STAT 4
#define C6C_SYS_FSTAT 5
#define C6C_SYS_LSTAT 6
#define C6C_SYS_LSEEK 8
#define C6C_SYS_MMAP 9
#define C6C_SYS_BRK 12
#define C6C_SYS_EXIT 60
#define C6C_SYS_EXIT_GROUP 231
#define C6C_SYS_MPROTECT 10
#define C6C_SYS_MUNMAP 11
#define C6C_SYS_MKDIR 83
#define C6C_SYS_CHMOD 90
#define C6C_SYS_TIME 201
#define C6C_SYS_GETPID 39
#define C6C_SYS_CLOCK_GETTIME 228
#define C6C_SYS_NANOSLEEP 35
#define C6C_SYS_OPENAT 257
#define C6C_SYS_FORK 57
#define C6C_SYS_WAIT4 61
#define C6C_SYS_IOCTL 16
#define C6C_SYS_GETPID2 39
#define C6C_SYS_GETUID 102
#define C6C_SYS_GETEUID 107
#define C6C_SYS_SETSID 112
#define C6C_SYS_NICE 34
#define C6C_SYS_DUP 32
#define C6C_SYS_DUP2 33

static long c6c_sys1(long nr, long a)
{
    return c6c_sys_errno(__builtin_syscall(nr, a));
}

static long c6c_sys2(long nr, long a, long b)
{
    return c6c_sys_errno(__builtin_syscall(nr, a, b));
}

static long c6c_sys3(long nr, long a, long b, long c)
{
    return c6c_sys_errno(__builtin_syscall(nr, a, b, c));
}

static long c6c_sys4(long nr, long a, long b, long c, long d)
{
    return c6c_sys_errno(__builtin_syscall(nr, a, b, c, d));
}

static long c6c_sys6(long nr, long a, long b, long c, long d, long e, long f)
{
    return c6c_sys_errno(__builtin_syscall(nr, a, b, c, d, e, f));
}

/* ---------- 基本 I/O ---------- */
static long c6c_strlen(const char *s)
{
    long n = 0;

    while (s[n])
        n++;
    return n;
}

long write(long fd, const void *buf, unsigned long n)
{
    return c6c_sys3(C6C_SYS_WRITE, fd, (long)buf, (long)n);
}

long read(long fd, void *buf, unsigned long n)
{
    return c6c_sys3(C6C_SYS_READ, fd, (long)buf, (long)n);
}

long close(long fd)
{
    return c6c_sys1(C6C_SYS_CLOSE, fd);
}

/* `pipe(int fds[2])`：系统调用 22 */
long pipe(int *fds)
{
    return c6c_sys1(22, (long)fds);
}

long lseek(long fd, long off, long whence)
{
    return c6c_sys3(C6C_SYS_LSEEK, fd, off, whence);
}

long open(const char *path, long flags, long mode)
{
    return c6c_sys3(C6C_SYS_OPEN, (long)path, flags, mode);
}

/* 文件系统元信息：struct stat 的布局在 include/sys/stat.h 里，按内核那份抄 */
struct stat;

int stat(const char *path, struct stat *st)
{
    return (int)c6c_sys2(C6C_SYS_STAT, (long)path, (long)st);
}

int fstat(int fd, struct stat *st)
{
    return (int)c6c_sys2(C6C_SYS_FSTAT, fd, (long)st);
}

int lstat(const char *path, struct stat *st)
{
    return (int)c6c_sys2(C6C_SYS_LSTAT, (long)path, (long)st);
}

int mkdir(const char *path, unsigned int mode)
{
    return (int)c6c_sys2(C6C_SYS_MKDIR, (long)path, (long)mode);
}

int chmod(const char *path, unsigned int mode)
{
    return (int)c6c_sys2(C6C_SYS_CHMOD, (long)path, (long)mode);
}

/* mmap 按 POSIX 的约定返回：出错给 MAP_FAILED（(void *)-1），**不是**内核
 * 那句 -errno。直接透传负数会让 `mmap(...) != MAP_FAILED` 这种判断误判成成功，
 * 接着去写那块没映射的地址（tests2/119_random_stuff.c 的 tst_const_addr 就是
 * 这么段错误的：`MAP_FIXED` 在 0x20000000 上被内核拒了，拿回来 -EINVAL）。 */
void *mmap(void *addr, unsigned long len, long prot, long flags, long fd, long off)
{
    long r = c6c_sys6(C6C_SYS_MMAP, (long)addr, (long)len, prot, flags, fd, off);

    if (r < 0 && r > -4096)
        return (void *)-1;
    return (void *)r;
}

int munmap(void *addr, unsigned long len)
{
    long r = c6c_sys2(C6C_SYS_MUNMAP, (long)addr, (long)len);

    return (int)((r < 0 && r > -4096) ? -1 : r);
}

int mprotect(void *addr, unsigned long len, long prot)
{
    return (int)c6c_sys3(C6C_SYS_MPROTECT, (long)addr, (long)len, prot);
}

void exit(int code)
{
    c6c_sys1(C6C_SYS_EXIT_GROUP, (long)code);
    c6c_sys1(C6C_SYS_EXIT, (long)code);
}

void _exit(int code)
{
    c6c_sys1(C6C_SYS_EXIT_GROUP, (long)code);
    c6c_sys1(C6C_SYS_EXIT, (long)code);
}

void abort(void)
{
    c6c_sys1(C6C_SYS_EXIT_GROUP, 134);
    c6c_sys1(C6C_SYS_EXIT, 134);
}

/* ---------- 信号 ---------- */
/* tests2/114_bound_signal.c 要按 pid 发信号（tcc 的 libc 有这两个）。 */
int kill(int pid, int sig)
{
    return (int)c6c_sys2(62 /* kill */, (long)pid, (long)sig);
}

int raise(int sig)
{
    return (int)c6c_sys2(62 /* kill */, c6c_sys1(39 /* getpid */, 0), (long)sig);
}

/* ---------- 资源限制 ---------- */
/* tests/async_highfd.c6 这些用例要探 fd 上限（c6 的 `await c6_io` 支持高 fd）。
 * 真实现走 prlimit64（老 getrlimit 在内核里也是它），拿不到就编不过。 */
struct c6c_rlimit {
    unsigned long cur;
    unsigned long max;
};

int getrlimit(int res, struct c6c_rlimit *rl)
{
    if (!rl)
        return -1;
    if (c6c_sys4(302 /* prlimit64 */, 0, (long)res, 0, (long)rl) == 0)
        return 0;
    return (int)c6c_sys2(97 /* getrlimit */, (long)res, (long)rl);
}

int setrlimit(int res, const struct c6c_rlimit *rl)
{
    if (!rl)
        return -1;
    if (c6c_sys4(302 /* prlimit64 */, 0, (long)res, (long)rl, 0) == 0)
        return 0;
    return (int)c6c_sys2(160 /* setrlimit */, (long)res, (long)rl);
}

/* ---------- 内存 ---------- */
static char *c6c_brk_cur = 0;
static long c6c_brk_left = 0;

static void *c6c_mem_zero(void *p, long n)
{
    char *q = (char *)p;
    long i = 0;

    for (i = 0; i < n; i++)
        q[i] = 0;
    return p;
}

static void c6c_mem_copy(void *dst, const void *src, long n)
{
    char *d = (char *)dst;
    const char *s = (const char *)src;
    long i = 0;

    for (i = 0; i < n; i++)
        d[i] = s[i];
}

/* 最近一次 err(id, msg) 的消息指针。`catch e { e.msg }` 从这里取。 */
char *c6c_err_msg = 0;

/* 错误槽的读写口子：c6 的 err()/try/catch 是前端直接发的，但"当前有没有
 * 错误"这件事得有地方存，测试和用户代码都按 __tcc_err_* 这组名字访问。 */
/* spawn 起的线程入口：参数块的头两个字是 { 代码指针, 目标 }, 代码按
 * "void (*)(void *env)" 的约定接收整个参数块。 */
void c6c_th_join_all(void);

/* 源码里显式调用的 `__c6_th_join_all()`：等所有 spawn 出去的线程。 */
void __c6_th_join_all(void)
{
    c6c_th_join_all();
}

/* 进程收尾：把 spawn 出去还活着的线程等回来。_start 在 main 之后、真正
 * 退进程之前跑析构函数，所以挂在这里正好（tests/exit/go_join.c6 期望
 * main 的 defer 先跑、线程的输出再出现，退出码还是 main 的 7）。 */
__attribute__((destructor)) static void c6c_th_drain_dtor(void)
{
    c6c_th_join_all();
}

/* ---------- GC / 协程的内建（目前是"如实报告未跟踪"的桩） ----------
 * c6c 的 `@T` 现在就是 `T *`：没有对象头、没有引用计数、没有协程调度。
 * 这几组名字是 c6 源码（tests/、std/）直接调用的内建，先提供出来让程序
 * 能编、能跑，并且**语义上和实现一致**：
 *   - `__c6_gc_live()`         → 当前跟踪的对象数 = 0（本来就没跟踪）
 *   - `__c6_gc_refcount(p)`    → 非空指针给 1（一个引用），空给 0
 *   - `__c6_gc_shutdown()`     → 无事可做
 *   - `__c6_gc_drain_budget(n)`→ 返回 0（没有待回收的）
 * 协程那组（`__c6_co_*`）同理：没有调度器，run/wait 就是同步跑一次。
 * 真正实现 GC 和协程时，替换这一整段即可（见 docs/todo.md 的"接手先看"）。 */
/* 托管字符串的字节长度（不含结尾 NUL）。c6c 的 `@char` 就是 `char *`，
 * 没有额外头部，所以直接量。 */
long __c6_str_len(const char *s)
{
    return s ? (long)strlen(s) : 0;
}

/* ---------- 引用计数 GC（阶段 P1：分配、计数、释放） ----------
 * 对象头紧挨在负载前面（16 字节）：`{ 引用计数, 字节数 }`。负载指针就是
 * `new T` 的返回值，也是 `@T` 的表示——所以 `@T` 和 `T *` 在机器层面仍然
 * 是同一个东西，区别只在前端给不给它插 retain/release。
 * `__c6_gc_live()` 是活对象数，测试拿它断言"没有泄漏"。 */
/* 类型描述符：编译器给每个 `new T` 用到的结构体类型发一份。
 * `drop` 是 T 的析构（`void drop(struct T *self)`），没有就是空；
 * `foff` 是 T 里所有 `@U` 字段的偏移表，释放到零时按表逐个放下层引用。 */
typedef struct C6GcDesc {
    void (*drop)(void *self);
    const long *foff;
    long nfoff;
} C6GcDesc;

typedef struct C6GcHdr {
    long rc;
    long sz;
    const C6GcDesc *desc;
    long esz;                    /* 数组元素大小（0 = 单个对象） */
    long nel;                    /* 数组元素个数 */
} C6GcHdr;

static long c6_gc_live_n;

/* 待销毁队列（见下面的 __c6_gc_release）：命中 rc==0 的对象先入队，再由
 * 一个循环逐个销毁。队列自己用 rt 的 malloc/realloc，容量按需翻倍。 */
static void **c6_gc_pending;
static long c6_gc_pending_n;
static long c6_gc_pending_cap;
static int c6_gc_draining;

/* 弱引用登记表：对象真正释放时把指向它的弱槽写成空。
 * 槽是栈上的托管量，所以只在"对象还活着"的这段时间里有效。 */
#define C6_WEAK_MAX 4096
static void **c6_weak_slot[C6_WEAK_MAX];
static void *c6_weak_obj[C6_WEAK_MAX];
static long c6_weak_n;

void __c6_gc_weak(void **slot, void *p)
{
    long i = 0;

    if (!slot)
        return;
    /* 同一个槽只留一条登记（重新绑定就换对象） */
    for (i = 0; i < c6_weak_n; i++)
        if (c6_weak_slot[i] == slot) {
            c6_weak_obj[i] = p;
            *slot = p;
            return;
        }
    if (!p) {
        *slot = NULL;
        return;
    }
    if (c6_weak_n < C6_WEAK_MAX) {
        c6_weak_slot[c6_weak_n] = slot;
        c6_weak_obj[c6_weak_n] = p;
        c6_weak_n++;
    }
    *slot = p;
}

static void c6_weak_clear(void *p)
{
    long i = 0;

    for (i = 0; i < c6_weak_n; ) {
        if (c6_weak_obj[i] == p) {
            if (c6_weak_slot[i])
                *c6_weak_slot[i] = NULL;
            c6_weak_n--;
            c6_weak_slot[i] = c6_weak_slot[c6_weak_n];
            c6_weak_obj[i] = c6_weak_obj[c6_weak_n];
            continue;
        }
        i++;
    }
}

static void *c6_gc_alloc(long sz, const C6GcDesc *desc, long esz, long nel)
{
    C6GcHdr *h = malloc((size_t)sz + sizeof(C6GcHdr));

    if (!h)
        return NULL;
    h->rc = 1;
    h->sz = sz;
    h->desc = desc;
    h->esz = esz;
    h->nel = nel;
    memset((char *)h + sizeof(C6GcHdr), 0, (size_t)sz);
    c6_gc_live_n++;
    return (char *)h + sizeof(C6GcHdr);
}

void *__c6_gc_new(long sz, const C6GcDesc *desc)
{
    return c6_gc_alloc(sz, desc, 0, 0);
}

/* `new T[n]`：元素析构/字段释放按 esz 步进逐个跑 */
void *__c6_gc_new_arr(long n, long esz, const C6GcDesc *desc)
{
    return c6_gc_alloc(n * esz, desc, esz, n);
}

/* 引用计数是原子的：`shared @T` 的计数可以从一个线程转到另一个线程，两个
 * 线程同时对同一个对象加减也不能丢更新（tests/gc_thread.c6）。这俩是编译器
 * 自带的汇编跳板（lock xadd），见 src/asmblob.c6。 */
long __c6_atomic_inc(void *p);
long __c6_atomic_dec(void *p);

void __c6_gc_retain(void *p)
{
    if (p)
        __c6_atomic_inc(&((C6GcHdr *)((char *)p - sizeof(C6GcHdr)))->rc);
}

void __c6_gc_release(void *p);

/* 一个对象（或一个数组元素）的销毁：先析构，再放托管字段。
 * 注意里面的 `__c6_gc_release` 只会**入队**（销毁循环里 c6_gc_draining=1），
 * 所以这条路径的栈深是常数，跟链长无关。 */
static void c6_gc_destroy(void *p, const C6GcDesc *d)
{
    long i = 0;

    if (d && d->drop)
        d->drop(p);
    if (d && d->foff)
        for (i = 0; i < d->nfoff; i++) {
            void **fp = (void **)((char *)p + d->foff[i]);

            __c6_gc_release(*fp);
            *fp = NULL;
        }
}

/* 对象入队：返回 0 表示队列开不出内存（只在 OOM 时发生）。 */
static int c6_gc_pend(void *p)
{
    if (c6_gc_pending_n == c6_gc_pending_cap) {
        long cap = c6_gc_pending_cap ? c6_gc_pending_cap * 2 : 256;
        void **q = (void **)realloc(c6_gc_pending, cap * (long)sizeof(void *));

        if (!q)
            return 0;
        c6_gc_pending = q;
        c6_gc_pending_cap = cap;
    }
    c6_gc_pending[c6_gc_pending_n++] = p;
    return 1;
}

/* 把队列跑空：先销毁一个对象（它的托管字段只会再入队），再 free 它自己。
 * 析构里再 release、或者递归调用进来，都只会入队后就返回。 */
static void c6_gc_drain_queue(void)
{
    if (c6_gc_draining)
        return;                     /* 已经有一个循环在跑了 */
    c6_gc_draining = 1;
    while (c6_gc_pending_n > 0) {
        void *p = c6_gc_pending[--c6_gc_pending_n];
        C6GcHdr *h = (C6GcHdr *)((char *)p - sizeof(C6GcHdr));

        if (h->nel > 1 || (h->nel == 1 && h->esz)) {
            long k = 0;

            for (k = 0; k < h->nel; k++)
                c6_gc_destroy((char *)p + k * h->esz, h->desc);
        } else {
            c6_gc_destroy(p, h->desc);
        }
        /* 指向它的弱引用变空，最后才真正 free */
        c6_weak_clear(p);
        free(h);
    }
    c6_gc_draining = 0;
}

/* 释放一个引用。计数归零**不在这里递归销毁**：长链（tests/gc_field.c6 的
 * 20001 个节点）走递归要几千帧，8 MB 的默认栈直接段错误；入队 + 循环以后
 * 栈深跟链长无关，和 tcc 侧 libtcc1.c 的 drain 队列同一个口径。 */
void __c6_gc_release(void *p)
{
    C6GcHdr *h = NULL;

    if (!p)
        return;
    h = (C6GcHdr *)((char *)p - sizeof(C6GcHdr));
    if (__c6_atomic_dec(&h->rc) > 0)
        return;
    c6_gc_live_n--;
    if (!c6_gc_pend(p)) {
        /* 队列都开不出来（OOM）：就地销毁，宁可这时候冒点栈风险也别漏对象 */
        if (h->nel > 1 || (h->nel == 1 && h->esz)) {
            long k = 0;

            for (k = 0; k < h->nel; k++)
                c6_gc_destroy((char *)p + k * h->esz, h->desc);
        } else {
            c6_gc_destroy(p, h->desc);
        }
        c6_weak_clear(p);
        free(h);
        return;
    }
    c6_gc_drain_queue();
}

long __c6_gc_live(void)
{
    return c6_gc_live_n;
}

long __c6_gc_refcount(const void *p)
{
    if (!p)
        return 0;
    return ((C6GcHdr *)((char *)p - sizeof(C6GcHdr)))->rc;
}

void __c6_gc_shutdown(void)
{
}

long __c6_gc_drain_budget(long n)
{
    (void)n;
    /* 队列是边放边跑的（__c6_gc_release 收尾就把队列跑空），所以这里正常情况
     * 无事可做；只有在析构体里再进来时才可能还剩几条。返回值口径不变：0。 */
    c6_gc_drain_queue();
    return 0;
}

/* 协程内建：c6c 没有协程调度器，任务就是同步跑完的函数。所以
 * `__c6_co_wait()` 永远返回 0（已完成）、`destroy` 无事可做、`kind` 报 0。
 * 语义和实现一致：`async` 函数现在就是普通函数。 */
/* 协程状态/事件码（c6 源码里按名字用）。任务同步跑完，所以 kind 只可能
 * 是 DONE 或 ERR；事件码目前没有真正的等待。 */
enum {
    C6_CO_KIND_DONE = 0,
    C6_CO_KIND_ERR = 1,
    C6_CO_KIND_RUNNING = 2,   /* `start()` 之后还挂着（既没结束也没出错） */
    C6_CO_STATE_NEW = 0,
    C6_CO_STATE_DONE = -1,
    C6_CO_EV_READ = 1,      /* 见 docs/reference/grammar.md：READ=1 / WRITE=2 */
    C6_CO_EV_WRITE = 2
};

/* 任务结构的头两个字段是编译器织进去的：
 *     long kind;   0 = 成功，1 = 出错（async 函数收尾时按错误标志写）
 *     long state;  0 = C6_CO_STATE_NEW，-1 = C6_CO_STATE_DONE
 * 第三个字段才是返回值 val。c6c 没有调度器，任务体在创建时同步跑完，
 * 所以 `wait()` 做的只是"把它标成已结束"；`done()` 之前是 0，之后是 1，
 * 这正是句柄方法的可观察语义。 */
/* 任务结构的布局由编译器织出来（parse.c6 里的合成），固定是
 *     { void *m0..m3; long kind; long state; long nmgd; T val; }
 * 前 32 字节是托管实参的引用前缀，nmgd 说明填了几个。 */
#define C6_TASK_M0_OFF    0
#define C6_TASK_MG_CAP    4
#define C6_TASK_KIND_OFF  32
#define C6_TASK_STATE_OFF 40
#define C6_TASK_NMGD_OFF  48
#define C6_TASK_VAL_OFF   56

#define C6C_SYS_FUTEX_ 202
#define C6C_SYS_GETTID_ 186
#define C6C_CLONE_VM 0x00000100l
#define C6C_CLONE_FS 0x00000200l
#define C6C_CLONE_FILES 0x00000400l
#define C6C_CLONE_SIGHAND 0x00000800l
#define C6C_CLONE_THREAD 0x00010000l
#define C6C_CLONE_SYSVSEM 0x00040000l
#define C6C_CLONE_CHILD_SETTID 0x01000000l
#define C6C_CLONE_CHILD_CLEARTID 0x00200000l
#define C6C_FUTEX_WAIT_ 0
#define C6C_FUTEX_WAKE_ 1

static void c6c_th_lock(void);          /* 分槽位用（定义在下面线程那节） */
static void c6c_th_unlock(void);

struct c6c_pollfd {
    int fd;
    short events;
    short revents;
};

/* ---------- 协程调度器（`async` / `await` / `co`） ----------
 *
 * 每个任务有自己的栈，但**任何时刻只有一个在跑**：谁跑由一对计数器交接决定
 * （in = 允许跑的格数，out = 交回控制权的次数）。
 *
 *   co_resume(c)：c->in++、唤醒 in，然后阻塞等 c->out 涨一格；
 *   co_yield(c) ：c->out++、唤醒 out，然后等 c->in 涨一格。
 *
 * 于是"挂起"就是把控制权交回调度侧。`await t` 在 t 还没结束时把当前协程标成
 * `blocked_on = t`、让出；调度侧（c6c_co_pump）顺着等待链挑下一个能跑的推进。
 *
 * 没有对应 C6Co 的任务（老口径：任务体在创建时同步跑完）照旧按"已结束"处理。
 */
#define C6_CO_STACK (64 * 1024)

typedef struct C6Co {
    struct C6Co *resumer;       /* 谁把我恢复起来的（让出时交回给它） */
    void *(*fn)(void *);
    void *arg;
    void *task;                 /* 任务结构（函数体的返回值 / publish） */
    long done;
    long state;                 /* 0 new 1 running 2 blocked 3 done */
    void *blocked_on;
    int wait_fd;                /* `await c6_io(fd, ev)`：挂在哪个 fd 上 */
    int wait_ev;
    int waiting;
    int detached;               /* `co f()`：跑完由调度侧自动回收 */
    int poisoned;               /* 撞上"永不就绪"的等待点：任务按失败结 */
    int unwind;                 /* 销毁挂起的任务：下次恢复就回卷 */
    int val_mgd;                /* 任务的 val 槽持有一份托管引用 */
    int nogate;                 /* `co f()`：语句处就直接跑，不停在起点闸门上 */
    int exited;                 /* 线程已经走到 epilogue 了（退役判据看 tid，见 c6c_co_retire） */
    void *stack;
    long tid;
    struct C6Co *next;
} C6Co;

static C6Co *C6_CO_ALL;         /* 还活着的协程 */
static C6Co *C6_CO_IDLE;        /* 跑完了、栈还能再用的槽 */
static C6Co *C6_CO_CUR;         /* 当前在跑的那个（同一时刻只有一个） */

long __c6_co_spawn(unsigned long flags, void *sp, void *slot, void *ctid);

/* 执行权令牌：同一时刻只有 TURN 指向的那个在跑，NULL 表示主线程在跑。
 *
 *   co_give(to)      ：把令牌交出去（TURN = to，序号 +1，唤醒所有等待者）
 *   co_await_turn(me)：等到令牌指向 me
 *
 * 用一根令牌而不是给每对线程记交接计数：计数要在"查值 → 进内核"之间取期望值，
 * 嵌套 resume（协程里再起协程）时很容易错一拍就卡死（踩过）。令牌只有一个
 * 变量，谁醒来谁重查，错了最多多醒一次。 */
static C6Co *C6_CO_TURN;
static long C6_CO_SEQ;

static void c6c_co_give(C6Co *to)
{
    C6_CO_TURN = to;
    __c6_atomic_inc(&C6_CO_SEQ);
    c6c_sys6(C6C_SYS_FUTEX_, (long)&C6_CO_SEQ, C6C_FUTEX_WAKE_, 0x7fffffff, 0, 0, 0);
}

static void c6c_co_await_turn(C6Co *me)
{
    while (C6_CO_TURN != me) {
        long seen = C6_CO_SEQ;

        if (C6_CO_TURN == me)
            break;
        c6c_sys6(C6C_SYS_FUTEX_, (long)&C6_CO_SEQ, C6C_FUTEX_WAIT_, seen, 0, 0, 0);
    }
}

/* 协程入口：由 __c6_co_spawn 在新线程上调用。永不返回。 */
void __c6_co_entry(void *slot)
{
    C6Co *c = (C6Co *)slot;
    void *r = 0;

    c6c_co_await_turn(c);               /* 等第一次 resume */
    C6_CO_CUR = c;
    c->state = 1;
    r = c->fn ? c->fn(c->arg) : 0;
    if (r)
        c->task = r;
    /* 撞过"永不就绪"的等待点（`await c6_io(-1, …)`）：任务按失败结 */
    if (c->poisoned && r)
        *(long *)((char *)r + C6_TASK_KIND_OFF) = C6_CO_KIND_ERR;
    c->done = 1;
    c->state = 3;
    C6_CO_CUR = 0;
    /* 交出控制权之前把 resumer 存进本地：进了 c6c_co_give 之后这一槽随时可能
     * 被下一个协程复用（槽里的字段会被改写），再去读 c->resumer 就晚了。 */
    {
        C6Co *back = c->resumer;

        c->exited = 1;
        c6c_co_give(back);              /* 交回控制权，之后不再醒来 */
    }
    c6c_sys1(C6C_SYS_EXIT, 0);
    for (;;)
        ;
}

/* 协程侧让出（被再次 resume 时从这里继续） */
static void c6c_co_yield(C6Co *c)
{
    C6Co *back = c->resumer;

    /* 交令牌之前先把"谁在跑"清掉：不然恢复方醒来时读到的是**上一个**跑过的
     * 协程，resume 就会把它当成自己的调用者（resumer 变成自己 → 自己给自己
     * 令牌 → 死循环，踩过）。 */
    C6_CO_CUR = 0;
    c6c_co_give(back);
    c6c_co_await_turn(c);
    C6_CO_CUR = c;
    c->state = 1;
}

/* 调度侧：把 c 推进一格（跑到下一个挂起点或结束） */
static void c6c_co_resume(C6Co *c)
{
    C6Co *save = C6_CO_CUR;

    /* 协程不能恢复自己（resumer 变成自己就是一个死循环：给自己令牌、
     * 立刻又拿回来）。调度侧挑错了对象时退回"主线程"。 */
    if (save == c)
        save = 0;
    c->resumer = save;
    C6_CO_CUR = c;
    c6c_co_give(c);
    c6c_co_await_turn(save);
    /* 恢复"谁在跑"：从协程里起协程（`co` 写在 async 体里）时，回来的是那个
     * 协程自己，不是调度侧。 */
    C6_CO_CUR = save;
}

static C6Co *c6c_co_find(void *task)
{
    C6Co *c = C6_CO_ALL;

    if (!task)
        return 0;
    for (; c; c = c->next)
        if (c->task == task)
            return c;
    return 0;
}

/* 一次 poll：把在等 fd 的协程里**已经就绪**的放行（清 waiting）。timeout < 0
 * 表示阻塞等（没有等待者时立刻返回 0）。返回就绪的个数。 */
static long c6c_co_poll_ready(long timeout)
{
    struct c6c_pollfd pf[64] = {0};
    long np = 0;
    long r = 0;
    C6Co *c = 0;
    long k = 0;

    for (c = C6_CO_ALL; c; c = c->next) {
        int seen = 0;

        if (c->done || !c->waiting || c->wait_fd < 0)
            continue;
        for (k = 0; k < np; k++)
            if (pf[k].fd == c->wait_fd)
                seen = 1;
        if (seen || np >= 64)
            continue;
        pf[np].fd = c->wait_fd;
        pf[np].events = (short)c->wait_ev;
        pf[np].revents = 0;
        np++;
    }
    if (np == 0)
        return 0;
    r = c6c_sys3(7 /* poll */, (long)pf, np, timeout);
    if (r <= 0)
        return 0;
    for (c = C6_CO_ALL; c; c = c->next) {
        if (c->done || !c->waiting || c->wait_fd < 0)
            continue;
        for (k = 0; k < np; k++)
            if (pf[k].fd == c->wait_fd && pf[k].revents) {
                c->waiting = 0;
                break;
            }
    }
    return r;
}

/* 推进一格：等待点已经放行的直接恢复；还在等 fd 的就单独 poll 到就绪。 */
static void c6c_co_step(C6Co *c)
{
    long r = 0;

    if (!c || c->done)
        return;
    if (c->waiting) {
        struct c6c_pollfd p[1] = {0};

        p[0].fd = c->wait_fd;
        p[0].events = (short)c->wait_ev;
        p[0].revents = 0;
        r = c6c_sys3(7 /* poll */, (long)p, 1, -1);
        if (r < 0)
            return;
        c->waiting = 0;
    }
    c6c_co_resume(c);
}

/* 把 target 推到结束。路上顺手推进别的协程（"co 出去的顶层任务"不能被外层的
 * 挂起冻住）：先非阻塞 poll 把就绪的等待者放行，再在"别人"里挑一个能跑的，
 * 没有才顺着 target 的等待链走，实在都在等 fd 才阻塞。 */
static void c6c_co_pump(C6Co *target)
{
    long guard = 0;

    while (target && !target->done && guard++ < 1000000) {
        C6Co *c = 0;
        C6Co *nx = 0;
        C6Co *chain = 0;
        int depth = 0;

        (void)c6c_co_poll_ready(0);
        for (nx = C6_CO_ALL; nx; nx = nx->next)
            if (nx != target && nx != C6_CO_CUR && !nx->done && !nx->waiting
                && !nx->blocked_on) {
                c = nx;
                break;
            }
        if (!c) {
            chain = target;
            while (chain && !chain->done && chain->blocked_on && depth++ < 64) {
                C6Co *n = c6c_co_find(chain->blocked_on);

                if (!n || n->done)
                    break;
                chain = n;
            }
            if (chain && chain != target && !chain->done && !chain->waiting)
                c = chain;
        }
        if (!c && !target->waiting)
            c = target;
        if (!c) {
            if (c6c_co_poll_ready(-1) <= 0)
                break;              /* 没有等待者了也没得跑 */
            continue;
        }
        c6c_co_resume(c);
    }
}

/* 分一个协程槽：空闲链表里有就复用（栈留着给下一个），没有就新开一个 */
static C6Co *c6c_co_alloc(void)
{
    C6Co *c = C6_CO_IDLE;

    if (c) {
        C6_CO_IDLE = c->next;
    } else {
        c = (C6Co *)calloc(1, sizeof(C6Co));
        if (!c)
            return 0;
        c->stack = (void *)c6c_sys6(C6C_SYS_MMAP, 0, C6_CO_STACK, 3,
                                    0x22 /* MAP_PRIVATE|MAP_ANONYMOUS */, -1, 0);
        if ((long)c->stack < 0 && (long)c->stack > -4096) {
            free(c);
            return 0;
        }
    }
    c->next = C6_CO_ALL;
    C6_CO_ALL = c;
    c->resumer = 0;
    c->fn = 0;
    c->arg = 0;
    c->task = 0;
    c->done = 0;
    c->state = 0;
    c->blocked_on = 0;
    c->wait_fd = -1;
    c->wait_ev = 0;
    c->waiting = 0;
    c->detached = 0;
    c->poisoned = 0;
    c->unwind = 0;
    c->val_mgd = 0;
    c->nogate = 0;
    c->exited = 0;
    c->tid = 0;
    return c;
}

/* 退役：从"活着"的链表摘下来，挂回空闲链表（栈跟着槽复用）。
 *
 * 挂回之前必须等**线程真的退出**。exited 标志是线程自己在 epilogue 里置的，
 * 置完它还站在自己的栈上跑 c6c_co_give() 和 exit 那几条指令；这时候把栈交给
 * 下一个协程，新线程一 push 就把旧线程的返回地址踩成垃圾，旧线程 ret 到地址 0
 * （CI 上 async 用例偶发段错误就是这个）。线程退出时内核把 CLONE_CHILD_CLEARTID
 * 指的那个字清零并 futex 唤醒，所以这里等 c->tid 变 0 就够了——不用自旋，
 * 也不用赌调度。等不到（这个槽的线程还活着）就不挂回空闲链：漏一个槽也比
 * 两个线程共用一份栈强。 */
static void c6c_co_retire(C6Co *c)
{
    C6Co **pp = &C6_CO_ALL;
    long spins = 0;

    for (; *pp; pp = &(*pp)->next)
        if (*pp == c) {
            *pp = c->next;
            break;
        }
    /* 等线程退出：每轮最多睡 10ms，上限 200 轮（正常情况第一次就醒）。 */
    while (c->tid && spins++ < 200) {
        struct timespec ts = {0};
        long tid = c->tid;

        if (!tid)
            break;                      /* 已经退干净了 */
        ts.tv_sec = 0;
        ts.tv_nsec = 10000000l;
        c6c_sys6(C6C_SYS_FUTEX_, (long)&c->tid, C6C_FUTEX_WAIT_, tid,
                 (long)&ts, 0, 0);
    }
    if (c->tid) {
        /* 等了 2 秒还没退：说明这个槽的线程还活着（被退休的协程卡在挂起点上
         * 之类）。这份栈**绝对不能**再给别人——宁可漏掉一个槽，也不能让两个
         * 线程踩同一份栈。 */
        return;
    }
    c->next = C6_CO_IDLE;
    C6_CO_IDLE = c;
}

/* 编译器把 `async f(a)` 编成：__c6_co_new(实参块) →
 * __c6_co_launch(co)。launch 里起线程并**立刻恢复一次**，于是 `co f()` 的
 * 语义就是"语句处先跑到第一个挂起点"。（名字不能叫 __c6_co_start：那是个
 * 老的汇编跳板名，重名会让调用点落到 1 字节的 ret 上，返回垃圾。） */
void *__c6_co_new(void *env, long nogate)
{
    C6Co *c = 0;

    c = c6c_co_alloc();

    if (!c)
        return 0;
    c->nogate = nogate ? 1 : 0;
    /* 实参块的头两个字是 { 代码指针, 目标 }，代码按 `void *(*)(void *env)` 的
     * 约定接收整块（和 spawn 的线程入口一个口径，见 __c6_thr_start）。 */
    c->fn = *(void *(**)(void *))env;
    c->arg = env;
    return c;
}

void *__c6_co_launch(void *h)
{
    C6Co *c = (C6Co *)h;
    unsigned long sp = 0;
    long tid = 0;

    if (!c)
        return 0;
    sp = ((unsigned long)c->stack + C6_CO_STACK) / 16ul * 16ul - 16ul;
    /* SETTID + CLEARTID 指向同一个字 c->tid：线程一退出，内核把它清零并 futex
     * 唤醒，c6c_co_retire() 就靠这个字判断"栈能不能给别人了"。 */
    tid = __c6_co_spawn(C6C_CLONE_VM | C6C_CLONE_FS | C6C_CLONE_FILES
                        | C6C_CLONE_SIGHAND | C6C_CLONE_THREAD | C6C_CLONE_SYSVSEM
                        | C6C_CLONE_CHILD_SETTID | C6C_CLONE_CHILD_CLEARTID,
                        (void *)sp, c, (void *)&c->tid);
    if (tid < 0)
        return 0;
    c->tid = tid;
    c6c_co_resume(c);                  /* 立刻跑到第一个挂起点 */
    return c->task;
}

/* 协程体里拿到任务结构之后回填（编译器在 task_new 末尾发这条） */
void __c6_co_publish(void *task)
{
    if (C6_CO_CUR && task)
        C6_CO_CUR->task = task;
}

void *__c6_co_task(void *h)
{
    C6Co *c = (C6Co *)h;

    return c ? c->task : 0;
}

/* `co f()`：跑完由调度侧自动回收（不产生句柄）。参数是任务指针（`co` 那一侧
 * 拿到的是表达式值，也就是任务结构），按任务反查协程。 */
void __c6_co_detach(void *task)
{
    C6Co *c = c6c_co_find(task);

    if (c)
        c->detached = 1;
}

/* `await t`：t 还没跑完就把自己挂到它上面，一直让到它结束。返回 kind。 */
/* 起点闸门：`task t = f(a);` 建完就该把句柄交回去，函数体等第一次驱动
 * （`__c6_co_wait` / `await` / `__c6_co_run`）才开始跑。闸门放在任务结构
 * （含托管实参前缀）都准备好之后，所以创建者立刻就能看到 +1 的计数。
 * `co f(a);` 是同步起点，跳过闸门直接跑到第一个挂起点。 */
void __c6_co_gate(void)
{
    C6Co *self = C6_CO_CUR;

    if (!self || self->nogate)
        return;
    self->state = 2;
    c6c_co_yield(self);           /* 只停一轮：下一次驱动就直接进函数体 */
    self->state = 1;
}

/* 体里每个挂起点之后都会问一句：正被回卷吗？（编译器发的检查） */
int __c6_co_unwind_pending(void)
{
    return (C6_CO_CUR && C6_CO_CUR->unwind) ? 1 : 0;
}

/* `async @T f()` 的返回值由任务的 val 槽持有一份，销毁时放掉 */
void __c6_co_ownval(void *task)
{
    C6Co *c = c6c_co_find(task);

    if (c)
        c->val_mgd = 1;
}

long __c6_co_await(void *task)
{
    C6Co *self = C6_CO_CUR;
    C6Co *c = 0;
    long guard = 0;

    if (!task)
        return 0;
    if (!self)
        return *(long *)((char *)task + C6_TASK_KIND_OFF);
    for (;;) {
        c = c6c_co_find(task);
        if (!c || c->done)
            break;
        if (guard++ > 1000000 || self->unwind)
            break;                      /* 被销毁：别等一个永远不结束的任务 */
        self->blocked_on = task;
        self->state = 2;
        c6c_co_yield(self);
    }
    self->blocked_on = 0;
    self->state = 1;
    return *(long *)((char *)task + C6_TASK_KIND_OFF);
}

static long c6c_co_reap_done(void);
void __c6_co_destroy(void *task);

/* 事件循环（`__c6_co_run()`）：把还活着的协程都推到结束——有能跑的就先跑
 * 一格（链表头是最后建的，也就是 LIFO 轮转），都在等 fd 才阻塞 poll。
 * 返回这一轮里失败的 detached 任务数。 */
long __c6_co_run(void)
{
    long bad = 0;
    long guard = 0;


    for (;;) {
        C6Co *c = 0;

        bad += c6c_co_reap_done();      /* 跑完的 `co` 任务就地回收并计数 */
        if (guard++ > 1000000)
            break;
        for (c = C6_CO_ALL; c; c = c->next)
            if (!c->done && !c->waiting) {
                c6c_co_resume(c);
                break;
            }
        if (c)
            continue;
        if (c6c_co_poll_ready(-1) <= 0)
            break;                      /* 没人等了也没得跑：收工 */
    }
    bad += c6c_co_reap_done();
    return bad;
}

/* 收掉跑完的 detached 协程（`co f()` 没有句柄），返回其中失败的个数 */
static long c6c_co_reap_done(void)
{
    long bad = 0;
    C6Co *c = C6_CO_ALL;

    while (c) {
        C6Co *nx = c->next;

        if (c->detached && (c->done || c->poisoned)) {
            if (c->poisoned
                || (c->task && *(long *)((char *)c->task + C6_TASK_KIND_OFF) == C6_CO_KIND_ERR))
                bad++;
            if (c->poisoned && c->task)
                *(long *)((char *)c->task + C6_TASK_KIND_OFF) = C6_CO_KIND_ERR;
            if (c->task)
                __c6_co_destroy(c->task);
            else
                c6c_co_retire(c);
        }
        c = nx;
    }
    return bad;
}

long __c6_co_wait(void *task)
{
    C6Co *c = 0;

    if (!task)
        return -1;
    c = c6c_co_find(task);
    /* 挂在"永不就绪"的等待点（`await c6_io(-1, …)`）上的任务：帧留在原地等
     * destroy 来回卷，wait 直接报失败，不能傻等（约束 C32）。 */
    if (c && !c->done && c->poisoned)
        return -1;
    if (c && !c->done)
        c6c_co_pump(c);
    /* 挂在"永不就绪"的等待点上的：按失败报，别谎报成功。等真 fd 的
     * 继续往下推（poll 到就绪就接着跑），有上限免得死循环。 */
    if (c && !c->done && c->poisoned && c->waiting)
        return -1;
    {
        long rounds = 0;

        while (c && !c->done && rounds++ < 1000) {
            if (c->poisoned && c->waiting)
                return -1;
            if (!c6c_co_pump(c))
                break;
        }
    }
    *(long *)((char *)task + C6_TASK_STATE_OFF) = C6_CO_STATE_DONE;
    return *(long *)((char *)task + C6_TASK_KIND_OFF) == C6_CO_KIND_ERR ? -1 : 0;
}

/* 回收：挂起的任务先驱动到结束（这样帧里的托管引用会照常按作用域放掉，
 * "销毁挂起的任务会回卷"就是这条），再放手任务结构的引用前缀，最后 free。
 * 协程槽退役回 C6_CO_IDLE，栈留着给下一个协程用。 */
void __c6_co_destroy(void *task)
{
    long n = 0;
    long i = 0;
    C6Co *c = 0;

    if (!task)
        return;
    c = c6c_co_find(task);
    if (c) {
        if (!c->done && (c->waiting || c->poisoned)) {
            /* 挂着：别硬推（它等的 fd 永远不会就绪）。设 unwind 再恢复一次，
             * 体里挂起点的检查会跳到回卷出口，把 defer/errdefer 和栈上那些
             * 托管局部量都收拾干净，然后正常结束。 */
            c->waiting = 0;
            c->unwind = 1;
            c6c_co_resume(c);
            c->unwind = 0;
        }
        if (!c->done)
            c6c_co_pump(c);
        if (c->val_mgd)
            __c6_gc_release(*(void **)((char *)task + C6_TASK_VAL_OFF));
        c6c_co_retire(c);
    }
    n = *(long *)((char *)task + C6_TASK_NMGD_OFF);
    if (n > C6_TASK_MG_CAP)
        n = C6_TASK_MG_CAP;
    for (i = 0; i < n; i++)
        __c6_gc_release(*(void **)((char *)task + C6_TASK_M0_OFF + i * 8));
    free(task);
}

long __c6_co_kind(void *task)
{
    return task ? *(long *)((char *)task + C6_TASK_KIND_OFF) : C6_CO_KIND_DONE;
}

/* `t->start()`：把任务跑到第一个挂起点（或者跑完），返回 kind。
 * `task t = f(a);` 只是建任务（体停在起点闸门上），`start()` 才真正跑；
 * 跑完返回 C6_CO_KIND_DONE(0)，挂在等待点上返回 C6_CO_KIND_RUNNING(2)。 */
long __c6_co_start(void *task)
{
    C6Co *c = 0;

    if (!task)
        return C6_CO_KIND_DONE;
    c = c6c_co_find(task);
    if (!c)
        return C6_CO_KIND_DONE;
    if (!c->done && !c->unwind)
        c6c_co_resume(c);
    if (c->done)
        return *(long *)((char *)task + C6_TASK_KIND_OFF);
    return c->poisoned ? C6_CO_KIND_ERR : C6_CO_KIND_RUNNING;
}

long __c6_co_kind(void *task);

long __c6_co_state(void *task)
{
    if (!task)
        return C6_CO_STATE_DONE;
    return *(long *)((char *)task + C6_TASK_STATE_OFF);
}

/* `await c6_io(fd, ev)`：c6 里这是"挂起到 fd 就绪"。c6c 没有协程调度器，
 * 任务都是同步跑完的，所以这里退化成一次**非阻塞** poll：立刻就绪返回 1，
 * 否则返回 0（不会挂起）。fd < 0 一律报 0（永不就绪）。 */
int c6_io(int fd, int ev)
{
    struct c6c_pollfd p[1] = {0};
    long r = 0;
    long g = 0;
    short want = (short)(ev == C6_CO_EV_WRITE ? 4 : 1);   /* POLLOUT : POLLIN */

    if (fd < 0) {
        /* 永不就绪（约束 C32）：任务按失败结，协程**挂在这里**——帧不散，
         * 等 `__c6_co_destroy()` 来回收（那时会设 unwind，醒过来走回卷）。 */
        C6Co *self = C6_CO_CUR;

        if (!self)
            return -1;
        self->poisoned = 1;
        self->state = 2;
        self->wait_fd = -1;
        self->wait_ev = 0;
        self->waiting = 1;
        while (self->waiting && !self->unwind && g++ < 1000000)
            c6c_co_yield(self);
        self->waiting = 0;
        self->state = 1;
        return -1;
    }
    if (!C6_CO_CUR) {              /* 不在协程里：退化成一次非阻塞 poll */
        p[0].fd = fd;
        p[0].events = want;
        p[0].revents = 0;
        r = c6c_sys3(7 /* poll */, (long)p, 1, 0);
        return r > 0 ? 1 : 0;
    }
    /* 在协程里：挂到 (fd, ev) 上**停一轮**（即使已经就绪也停，约束 C31），
     * 由调度器（__c6_co_run）poll 到就绪后再恢复。 */
    C6_CO_CUR->wait_fd = fd;
    C6_CO_CUR->wait_ev = (int)want;
    C6_CO_CUR->waiting = 1;
    C6_CO_CUR->state = 2;
    while (C6_CO_CUR->waiting && !C6_CO_CUR->unwind && g++ < 1000000)
        c6c_co_yield(C6_CO_CUR);
    C6_CO_CUR->state = 1;
    return 1;
}



/* ---------- 真线程（clone 系统调用 + 编译器自带的汇编跳板） ----------
 *
 * 之前这里是一组"同步跑一遍就返回"的 pthread 桩，所以 spawn/thread 的用例
 * 全都过不了：它们要的是"spawn 立刻返回、线程真的并发"。
 *
 * 起线程的那几步（clone 的 syscall、子线程第一句 `mov rbp,rsp`）在 C 层面
 * 表达不出来——子线程是从 syscall 返回进来的，rsp 已经换到新栈，rbp 还指在
 * 父线程的帧上，任何 rbp 相对寻址都会踩错。所以这一段是编译器自带的汇编
 * 跳板 `__c6_th_spawn()`（见 src/asmblob.c6）：父线程拿 tid，子线程在新栈上
 * 直接进 `__c6_th_entry()`。
 *
 * 限制：`C6C_TH_CUR`（子线程要接手哪个槽位）是一个全局，所以并发地
 * pthread_create 需要自己串行化；tests/ 里的用法（主线程 spawn）没有这个
 * 问题，写在这里免得踩坑。
 */

/* 编译器自带的汇编跳板（src/asmblob.c6）：父线程返回 tid，子线程在新栈上
 * 进 __c6_th_entry()。 */
long __c6_th_spawn(unsigned long flags, void *sp, void *slot);
int __c6_tsl(void *p);                 /* 自旋锁（编译器自带的汇编跳板） */
void __c6_unlock_(void *p);

#define C6C_TH_MAX 128
#define C6C_TH_STACK (256 * 1024)

typedef struct C6CTh {
    unsigned long tid;
    void *(*fn)(void *);
    void *arg;
    void *ret;
    long done;
    void *stack;
} C6CTh;

static C6CTh C6C_THS[C6C_TH_MAX];
static int C6C_THN;
static int C6C_TH_LOCK;                 /* 保护"分槽位"这一段 */

static void c6c_th_lock(void)
{
    while (!__c6_tsl(&C6C_TH_LOCK))
        ;
}

static void c6c_th_unlock(void)
{
    __c6_unlock_(&C6C_TH_LOCK);
}

static int c6c_th_new(void)
{
    int i = 0;

    for (i = 0; i < C6C_THN; i++)
        if (!C6C_THS[i].stack)
            return i;
    if (C6C_THN >= C6C_TH_MAX)
        return -1;
    return C6C_THN++;
}

static void c6c_th_wait_done(long *p)
{
    while (!*p)
        c6c_sys6(C6C_SYS_FUTEX_, (long)p, C6C_FUTEX_WAIT_, 0, 0, 0, 0);
}

/* ---------- 线程局部存储（__thread / _Thread_local） ----------
 *
 * 编译期把每个 `__thread` 全局量照常摆在数据段里（初始化器也照常写进去），
 * 同时给出三个量：影像地址 __c6_tls_img、长度 __c6_tls_len、以及影像相对
 * 数据段起点的偏移 __c6_tls_delta。变量本身的寻址在代码里已经编成
 * `%fs + 数据段偏移`（见 src/parse.c6 的 ident_addr）。
 *
 * 运行期要做的事：给**每个线程**开一块、把影像拷到 `块首 + delta` 上，然后把
 * %fs 设成块首——于是编译期那个常量偏移正好落进拷贝里的变量上。
 * 主线程在 c6c_tls_init（构造函数，_start 调 main 之前跑）里做一次，
 * 子线程在 __c6_th_entry 里做一次。
 *
 * 没有 `__thread` 的程序：__c6_tls_len 是 0，这里什么都不做（只多一次比较）。
 */
extern void *__c6_tls_img;
extern unsigned long __c6_tls_len;
extern unsigned long __c6_tls_delta;

long __c6_fsbase(void);                 /* 编译器自带的汇编跳板 */

/* 每个线程一份 TLS 块。布局（M = mmap 的块首，也就是 %fs）：
 *
 *   M            : M 自己（自指针，`%fs:0` 就读到基址）
 *   M + delta    : 数据段里 [TLS_LO, TLS_HI) 那一小段的拷贝
 *
 * delta 是影像相对数据段起点的偏移，所以拷贝里第 goff 个字节就在
 * M + goff 上——正好和编译期生成的 `%fs:goff` 对齐，编译期不用知道
 * 任何运行期常量。 */
void c6c_tls_setup(void)
{
    unsigned long n = __c6_tls_len;
    unsigned long delta = __c6_tls_delta;
    void *m = 0;

    if (n == 0)
        return;
    m = (void *)c6c_sys6(C6C_SYS_MMAP, 0, delta + n + 64, 3,
                         0x22 /* MAP_PRIVATE|MAP_ANONYMOUS */, -1, 0);
    if (!m || (long)m <= 0)             /* mmap 出错按 POSIX 给 MAP_FAILED */
        return;
    memcpy((char *)m + delta, __c6_tls_img, n);
    *(void **)m = m;
    /* arch_prctl(ARCH_SET_FS = 0x1002, 基址)：只换段基址，不动线程栈 */
    c6c_sys2(158 /* arch_prctl */, 0x1002, (long)m);
}

/* 构造函数：_start 在 main 之前按源码顺序调用（见 src/x64.c6 的
 * x64_emit_start）。主线程的线程块必须在这之前就位，否则 main 里第一次
 * 读 `__thread` 变量就是 `%fs:偏移` 而 %fs 还是 0——直接段错误。 */
__attribute__((constructor)) static void c6c_tls_init(void)
{
    c6c_tls_setup();
}

/* 子线程入口：由跳板在新栈上调用。**只用全局**，永不返回。 */
void __c6_th_entry(void *slot)
{
    int i = (int)(long)slot;
    void *(*fn)(void *) = C6C_THS[i].fn;
    void *arg = C6C_THS[i].arg;
    void *r = 0;

    /* 线程局部量：子线程要自己一份（%fs 是从父线程继承来的，直接写会踩
     * 主线程的值——tests2/144_tls 第 40 行起的整段就是查这个）。 */
    c6c_tls_setup();
    r = fn ? fn(arg) : 0;

    C6C_THS[i].ret = r;
    C6C_THS[i].done = 1;
    c6c_sys6(C6C_SYS_FUTEX_, (long)&C6C_THS[i].done, C6C_FUTEX_WAKE_, 1, 0, 0, 0);
    c6c_sys1(C6C_SYS_EXIT, 0);
    for (;;)
        ;
}

int pthread_create(unsigned long *th, const void *attr, void *(*fn)(void *), void *arg)
{
    int i = 0;
    void *st = 0;
    unsigned long sp = 0;
    long tid = 0;

    (void)attr;
    c6c_th_lock();                     /* 分槽位 + 起线程：别的线程也在 spawn */
    i = c6c_th_new();
    if (i < 0) {
        c6c_th_unlock();
        return -1;
    }
    st = (void *)c6c_sys6(C6C_SYS_MMAP, 0, C6C_TH_STACK, 3,
                          0x22 /* MAP_PRIVATE|MAP_ANONYMOUS */, -1, 0);
    if ((long)st < 0 && (long)st > -4096)
        return -1;
    sp = ((unsigned long)st + C6C_TH_STACK) / 16ul * 16ul - 16ul;
    C6C_THS[i].fn = fn;
    C6C_THS[i].arg = arg;
    C6C_THS[i].ret = 0;
    C6C_THS[i].done = 0;
    C6C_THS[i].stack = st;
    C6C_THS[i].tid = 0;
    tid = __c6_th_spawn(C6C_CLONE_VM | C6C_CLONE_FS | C6C_CLONE_FILES
                        | C6C_CLONE_SIGHAND | C6C_CLONE_THREAD | C6C_CLONE_SYSVSEM,
                        (void *)sp, (void *)(long)i);
    if (tid < 0)
        return -1;
    C6C_THS[i].tid = (unsigned long)tid;
    if (th)
        *th = (unsigned long)&C6C_THS[i];
    c6c_th_unlock();
    return 0;
}

/* 句柄的三个方法（编译器把 h->done()/h->value() 编成对这三个的调用） */
int __c6_th_done(void *h)
{
    C6CTh *t = (C6CTh *)h;

    return t && t->done ? 1 : 0;
}

void *__c6_th_value(void *h)
{
    C6CTh *t = (C6CTh *)h;

    return t ? t->ret : 0;
}

int pthread_join(unsigned long th, void **ret)
{
    C6CTh *t = (C6CTh *)th;

    if (!t)
        return -1;
    c6c_th_wait_done(&t->done);
    if (ret)
        *ret = t->ret;
    return 0;
}

/* 等所有还活着的线程（main 退出前、以及 __c6_th_join_all() 用） */
void c6c_th_join_all(void)
{
    int i = 0;

    for (i = 0; i < C6C_THN; i++)
        if (C6C_THS[i].stack && !C6C_THS[i].done)
            c6c_th_wait_done(&C6C_THS[i].done);
}

void *__c6_thr_start(void *env)
{
    void *(*code)(void *) = *(void *(**)(void *))env;

    return code(env);            /* 返回值给句柄的 h->value() */
}

/* ---------- 原子读改写（`__atomic_*` 内建的后端） ----------
 *
 * 前端把 `__atomic_fetch_add(p, v, order)` 之类翻成对这些函数的调用：整套
 * 「读 → 算 → 写」在锁里做完，中间别的线程插不进来。以前前端直接发
 * 「load; 算; store」三条 IR，16 个真线程各加一万次就丢更新
 * （tests2/124_atomic_counter 三行全 FAILURE）。
 *
 * 实现是一把全局自旋锁（__c6_tsl，汇编跳板里就是 xchg）：宽度只分 1/2/4/8
 * 四档，按宽度手工读写。锁里只有几条指令，争用下吞吐比 lock 前缀指令差，
 * 但语义是原子的——这些用例要的是正确性，不是吞吐。
 *
 * 没走内建的普通读改写（`++counter->uc`）仍然不原子：那是普通对象，
 * gcc 也只在 _Atomic / volatile 上发 lock。
 */
static volatile int C6C_AT_LOCK = 0;

#define C6C_AT_ADD 0
#define C6C_AT_SUB 1
#define C6C_AT_AND 2
#define C6C_AT_OR  3
#define C6C_AT_XOR 4

/* 抢锁用 test-and-test-and-set：先**只读**地等（等待者共享一条缓存行，不
 * 互相抢），看到空了再 xchg 抢。直接 xchg 重试的话 16 个线程互相把缓存行
 * 打来打去，tests2/124 的 16×10000×4 次要跑成分钟级。 */
static void c6c_at_lock(void)
{
    for (;;) {
        if (!C6C_AT_LOCK && __c6_tsl((int *)&C6C_AT_LOCK))
            return;
        while (C6C_AT_LOCK)
            ;
    }
}

static unsigned long c6c_at_get(void *p, long sz)
{
    if (sz == 1)
        return *(unsigned char *)p;
    if (sz == 2)
        return *(unsigned short *)p;
    if (sz == 4)
        return *(unsigned int *)p;
    return *(unsigned long *)p;
}

static void c6c_at_put(void *p, unsigned long v, long sz)
{
    if (sz == 1) {
        *(unsigned char *)p = (unsigned char)v;
        return;
    }
    if (sz == 2) {
        *(unsigned short *)p = (unsigned short)v;
        return;
    }
    if (sz == 4) {
        *(unsigned int *)p = (unsigned int)v;
        return;
    }
    *(unsigned long *)p = v;
}

/* fetch 系列：返回**改之前**的值 */
unsigned long __c6_at_rmw(void *p, unsigned long v, long op, long sz)
{
    unsigned long old = 0;
    unsigned long nv = 0;

    c6c_at_lock();
    old = c6c_at_get(p, sz);
    if (op == C6C_AT_ADD)
        nv = old + v;
    else if (op == C6C_AT_SUB)
        nv = old - v;
    else if (op == C6C_AT_AND)
        nv = old & v;
    else if (op == C6C_AT_OR)
        nv = old | v;
    else
        nv = old ^ v;
    c6c_at_put(p, nv, sz);
    __c6_unlock_((int *)&C6C_AT_LOCK);
    return old;
}

unsigned long __c6_at_xchg(void *p, unsigned long v, long sz)
{
    unsigned long old = 0;

    c6c_at_lock();
    old = c6c_at_get(p, sz);
    c6c_at_put(p, v, sz);
    __c6_unlock_((int *)&C6C_AT_LOCK);
    return old;
}

/* 比较交换：成功返回 1；失败把**实际值**写回 *expected（C11 的语义） */
int __c6_at_cas(void *p, void *expected, unsigned long desired, long sz)
{
    unsigned long exp = 0;
    unsigned long cur = 0;

    c6c_at_lock();
    exp = c6c_at_get(expected, sz);
    cur = c6c_at_get(p, sz);
    if (cur == exp) {
        c6c_at_put(p, desired, sz);
        __c6_unlock_((int *)&C6C_AT_LOCK);
        return 1;
    }
    c6c_at_put(expected, cur, sz);
    __c6_unlock_((int *)&C6C_AT_LOCK);
    return 0;
}

/* atomic_flag：走 __c6_xchg8（xchg 指令，真原子、不用全局锁）。
 * 这个典型用法 `while (atomic_flag_test_and_set(&f)); ... ; atomic_flag_clear(&f);`
 * 是个自旋锁，等待者每圈都要抢一次——套上全局锁的话等待者把持有者饿死，
 * tests2/124 的第三个用例 4 线程 2000 步就要 8 秒多。 */
long __c6_xchg8(void *p, long v);

_Bool atomic_flag_test_and_set(void *object)
{
    return __c6_xchg8(object, 1) ? 1 : 0;
}

void atomic_flag_clear(void *object)
{
    *(unsigned char *)object = 0;      /* store 后 xchg 的等待者立刻可见 */
}

static int c6c_err_flag;
static int c6c_err_id;

int __tcc_err_flag_get(void)
{
    return c6c_err_flag;
}

int __tcc_err_id_get(void)
{
    return c6c_err_id;
}

const char *__tcc_err_msg_get(void)
{
    return c6c_err_msg;
}

void __tcc_err_clear(void)
{
    c6c_err_flag = 0;
    c6c_err_id = 0;
    c6c_err_msg = 0;
}

void __tcc_err_set(int id, const char *msg)
{
    c6c_err_flag = 1;
    c6c_err_id = id;
    c6c_err_msg = (char *)msg;
}

void *malloc(long n)
{
    char *p = 0;
    long need = (n + 15) & ~15L;

    if (need <= 0)
        need = 16;
    if (need > c6c_brk_left) {
        long cur = c6c_sys1(C6C_SYS_BRK, 0);
        long want = need + 1048576;
        long got = c6c_sys1(C6C_SYS_BRK, cur + want);

        if (got < cur + need)
            return 0;
        c6c_brk_cur = (char *)cur;
        c6c_brk_left = got - cur;
    }
    p = c6c_brk_cur;
    c6c_brk_cur = p + need;
    c6c_brk_left = c6c_brk_left - need;
    return p;
}

/* calloc：malloc 那块 brk 内存本来就是零，但语义上还是要清零（复用的槽） */
void *calloc(long n, long sz)
{
    long total = n * sz;
    char *p = 0;
    long i = 0;

    if (n == 0 || sz == 0)
        total = 1;
    p = (char *)malloc(total);
    if (!p)
        return 0;
    for (i = 0; i < total; i++)
        p[i] = 0;
    return p;
}

void free(void *p)
{
    (void)p;   /* 复用先不做：c6c 的运行时够用就行 */
}

void *realloc(void *old, long n)
{
    void *p = malloc(n);

    if (!p)
        return 0;
    if (old)
        c6c_mem_copy(p, old, n);
    return p;
}

/* ---------- string.h ---------- */
void *memcpy(void *dst, const void *src, long n)
{
    c6c_mem_copy(dst, src, n);
    return dst;
}

void *memmove(void *dst, const void *src, long n)
{
    char *d = (char *)dst;
    const char *s = (const char *)src;
    long i = 0;

    if (d <= s) {
        for (i = 0; i < n; i++)
            d[i] = s[i];
    } else {
        for (i = n - 1; i >= 0; i--)
            d[i] = s[i];
    }
    return dst;
}

void *memset(void *dst, int c, long n)
{
    char *d = (char *)dst;
    long i = 0;

    for (i = 0; i < n; i++)
        d[i] = (char)c;
    return dst;
}

int memcmp(const void *a, const void *b, long n)
{
    const unsigned char *x = (const unsigned char *)a;
    const unsigned char *y = (const unsigned char *)b;
    long i = 0;

    for (i = 0; i < n; i++) {
        if (x[i] != y[i])
            return (int)x[i] - (int)y[i];
    }
    return 0;
}

long strlen(const char *s)
{
    return c6c_strlen(s);
}

char *strcpy(char *dst, const char *src)
{
    long i = 0;

    while (src[i]) {
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
    return dst;
}

char *strncpy(char *dst, const char *src, long n)
{
    long i = 0;

    while (i < n && src[i]) {
        dst[i] = src[i];
        i++;
    }
    while (i < n) {
        dst[i] = 0;
        i++;
    }
    return dst;
}

char *strcat(char *dst, const char *src)
{
    long i = c6c_strlen(dst);
    long j = 0;

    while (src[j]) {
        dst[i + j] = src[j];
        j++;
    }
    dst[i + j] = 0;
    return dst;
}

char *strncat(char *dst, const char *src, long n)
{
    long i = c6c_strlen(dst);
    long j = 0;

    while (j < n && src[j]) {
        dst[i + j] = src[j];
        j++;
    }
    dst[i + j] = 0;
    return dst;
}

int strcmp(const char *a, const char *b)
{
    long i = 0;

    while (a[i] && a[i] == b[i])
        i++;
    return (int)(unsigned char)a[i] - (int)(unsigned char)b[i];
}

int strncmp(const char *a, const char *b, long n)
{
    long i = 0;

    while (i < n && a[i] && a[i] == b[i])
        i++;
    if (i >= n)
        return 0;
    return (int)(unsigned char)a[i] - (int)(unsigned char)b[i];
}

char *strchr(const char *s, int c)
{
    long i = 0;

    while (s[i]) {
        if ((unsigned char)s[i] == (unsigned char)c)
            return (char *)s + i;
        i++;
    }
    if ((unsigned char)c == 0)
        return (char *)s + i;
    return 0;
}

char *strrchr(const char *s, int c)
{
    long i = c6c_strlen(s);

    /* 从尾部往回找，**找到就返回**。以前把匹配结果一路覆盖下去，最后留下的是
     * 最靠前的那个——正好和 strrchr 的语义相反（tcc tests2 28_strings 踩到）。 */
    while (i >= 0) {
        if ((unsigned char)s[i] == (unsigned char)c)
            return (char *)s + i;
        i--;
    }
    return 0;
}

char *strstr(const char *hay, const char *needle)
{
    long i = 0;
    long j = 0;
    long n = c6c_strlen(needle);

    if (n == 0)
        return (char *)hay;
    while (hay[i]) {
        j = 0;
        while (j < n && hay[i + j] == needle[j])
            j++;
        if (j == n)
            return (char *)hay + i;
        i++;
    }
    return 0;
}

char *strdup(const char *s)
{
    long n = c6c_strlen(s);
    char *p = (char *)malloc(n + 1);

    if (!p)
        return 0;
    c6c_mem_copy(p, s, n + 1);
    return p;
}

/* ---------- 数字 → 字符串 ---------- */
static long c6c_utoa(char *buf, unsigned long v, long base, long upper, long prec)
{
    char tmp[32] = {0};
    long n = 0;
    long i = 0;
    const char *dig_lo = "0123456789abcdef";
    const char *dig_hi = "0123456789ABCDEF";
    const char *dig = upper ? dig_hi : dig_lo;

    do {
        tmp[n] = dig[v % (unsigned long)base];
        n++;
        v = v / (unsigned long)base;
    } while (v != 0);
    while ((n + 0) < prec) {
        tmp[n] = '0';
        n++;
    }
    for (i = 0; i < n; i++)
        buf[i] = tmp[n - 1 - i];
    return n;
}

/* -b 的下标越界处理（parse.c6 的 pa_bound_check 会 call 到这里）。
 *
 * 只做一件事：往 stderr 打一行"谁越界了"，然后以退出码 2 结束。不尝试恢复
 * ——越界写过的内存状态已经不可信，接着跑只会把损坏摊得更开。用 write(2)
 * 直发而不是 stdio：越界之后连 stdio 自己的状态都不敢信。 */
static void c6c_err_str(const char *s)
{
    c6c_sys3(C6C_SYS_WRITE, 2, (long)s, strlen(s));
}

long c6c_bound_fail(long idx, long bound)
{
    char buf[64] = {0};
    long n = 0;

    /* 负下标要带负号：按无符号打印会是一串天文数字 */
    if (idx < 0) {
        buf[0] = '-';
        n = 1 + c6c_utoa(buf + 1, (unsigned long)(-idx), 10, 0, 1);
    } else {
        n = c6c_utoa(buf, (unsigned long)idx, 10, 0, 1);
    }
    buf[n] = 0;
    c6c_err_str("c6c: 下标越界：index ");
    c6c_err_str(buf);
    c6c_err_str(" 不在 [0, ");
    n = c6c_utoa(buf, (unsigned long)bound, 10, 0, 1);
    buf[n] = 0;
    c6c_err_str(buf);
    c6c_err_str(") 之内\n");
    c6c_sys3(C6C_SYS_EXIT, 2, 0, 0);
    return 0;
}

/* ---------- 格式化 ---------- */
static void c6c_out(char *out, long cap, long *n, const char *s, long len)
{
    long k = 0;

    for (k = 0; k < len; k++) {
        if (*n < cap - 1)
            out[*n] = s[k];
        (*n)++;
    }
}

static void c6c_pad(char *out, long cap, long *n, long width, char pc)
{
    long k = 0;

    for (k = 0; k < width; k++) {
        if (*n < cap - 1)
            out[*n] = pc;
        (*n)++;
    }
}

/* 四舍五入到整数，但**正好 .5 时取偶**——glibc 的默认舍入口径（printf("%.0f", 2.5)
 * 印 "2"，printf("%.1f", 2.25) 印 "2.2"）。用 (long)(t + 0.5) 会一路进位到 3 / 2.3，
 * 和 glibc 对不上。 */
static double c6c_round_even(double t)
{
    unsigned long fl = (unsigned long)t;      /* 调用方保证 t < 2^64 */
    double frac = t - (double)fl;

    if (frac > 0.5)
        return (double)fl + 1.0;
    if (frac < 0.5)
        return (double)fl;
    if (fl != (fl / 2ul) * 2ul)               /* 正好 .5：取偶 */
        return (double)fl + 1.0;
    return (double)fl;
}

/* 整数部分的精确展开（1e19 以上 u64 装不下）。double 的整数部分就是
 * `尾数 << 指数`，最多一千来位，用 10^9 进制的小 bignum 反复乘 2 就能算全——
 * `printf("%f", 1e300)` 在 glibc 下就是把这 300 位一位不差地印出来。 */
#define C6C_BIG_LIMB 40
static long c6c_fmt_big(char *buf, double dv)
{
    unsigned long bits = *(unsigned long *)&dv;
    long be = (long)((bits >> 52) & 0x7ffl);
    unsigned long m = bits & 0xffffffffffffful;
    long e = 0;
    unsigned int limb[C6C_BIG_LIMB] = {0};
    long nl = 1;
    long i = 0;
    long n = 0;
    char tmp[16] = {0};
    unsigned long v = 0;

    if (be == 0)
        return 0;                          /* 次正规数：整数部分就是 0 */
    m = m | 0x10000000000000ul;            /* 补上隐含的 1 */
    e = be - 1075;                         /* value = m * 2^e */
    if (e < 0) {                           /* 整数部分 = m >> -e */
        long sh = -e;

        if (sh >= 53)
            return 0;
        m = m >> sh;
        e = 0;
    }
    v = m % 1000000000ul;
    limb[0] = (unsigned int)v;
    m = m / 1000000000ul;
    while (m) {
        limb[nl] = (unsigned int)(m % 1000000000ul);
        nl++;
        m = m / 1000000000ul;
    }
    while (e > 0) {
        unsigned long carry = 0;

        for (i = 0; i < nl; i++) {
            unsigned long t = (unsigned long)limb[i] * 2ul + carry;

            limb[i] = (unsigned int)(t % 1000000000ul);
            carry = t / 1000000000ul;
        }
        if (carry && nl < C6C_BIG_LIMB) {
            limb[nl] = (unsigned int)carry;
            nl++;
        }
        e--;
    }
    for (i = nl - 1; i >= 0; i--) {
        long fl = 0;
        long k = 0;

        if (i == nl - 1) {
            fl = c6c_utoa(tmp, (unsigned long)limb[i], 10, 0, 1);
        } else {
            fl = c6c_utoa(tmp, (unsigned long)limb[i], 10, 0, 9);
        }
        for (k = 0; k < fl; k++)
            buf[n + k] = tmp[k];
        n = n + fl;
    }
    return n;
}

/* 浮点 → 文本：%f/%e/%g（conv 只收小写）。返回值是 body 的长度，*sign 是符号字符
 * （0 表示不需要符号）。dv 的位模式从 va_arg 按 8 字节整型取出——本地约定里
 * double 就是走整型寄存器传的，所以变参函数里也能拿到。 */
static long c6c_fmt_double(char *body, double dv, long conv, long p, long alt, char *sign)
{
    unsigned long sc = 1;
    unsigned long uval = 0;
    unsigned long ip = 0;
    unsigned long fp = 0;
    long exp10 = 0;
    long k = 0;
    long len = 0;
    long is_g = conv == 'g';
    double orig = 0;
    char frac[40] = {0};

    *sign = 0;
    if (dv != dv) {                    /* NaN：自己不等于自己 */
        body[0] = 'n';
        body[1] = 'a';
        body[2] = 'n';
        return 3;
    }
    /* -0.0：`dv < 0` 对它为假，但符号位是 1（glibc 印的是 -0.000000） */
    if (dv < 0 || (dv == 0.0 && ((*(unsigned long *)&dv) >> 63) != 0)) {
        *sign = '-';
        dv = -dv;
    }
    orig = dv;
    if (dv >= 1.8e308) {
        body[0] = 'i';
        body[1] = 'n';
        body[2] = 'f';
        return 3;
    }
    if (conv == 'e' || conv == 'g') {
        if (dv != 0) {
            while (dv >= 10.0) {
                dv = dv / 10.0;
                exp10++;
            }
            while (dv < 1.0) {
                dv = dv * 10.0;
                exp10--;
            }
        }
    }
    if (conv == 'g') {
        long sig = p == 0 ? 1 : p;

        if (exp10 < -4 || exp10 >= sig) {
            conv = 'e';
            p = sig - 1;
        } else {
            conv = 'f';
            p = sig - 1 - exp10;
            if (p < 0)
                p = 0;
            dv = orig;                    /* 还原量级：上面只是借归一化算指数 */
        }
    }
    for (k = 0; k < p; k++)
        sc = sc * 10;
    if (conv == 'f' && dv >= 18446744073709551616.0) {
        /* 2^64 以上：u64 装不下整数部分，改走精确展开。这个量级的 double 步长
         * 已经大于 1，小数部分恒为 0，按精度补零即可。 */
        len = c6c_fmt_big(body, dv);
        if (p > 0) {
            body[len] = '.';
            len++;
            for (k = 0; k < p; k++)
                body[len + k] = '0';
            len = len + p;
        } else if (alt) {
            body[len] = '.';
            len++;
        }
    } else {
    /* 整数部分和小数部分分开算：整体乘 10^p 会超 53 位精度，
     * 1234567890123.0 会印成 ...000064（踩过） */
    if (dv < 18446744073709551616.0) {        /* 2^64：u64 装得下的都要取整数部分 */
        ip = (unsigned long)dv;
    } else {
        ip = 0;
    }
    {
        double t = (dv - (double)ip) * (double)sc;

        if (t < 18446744073709551615.0)
            uval = (unsigned long)c6c_round_even(t);
        else
            uval = 0;
    }
    if (uval >= sc) {                             /* 小数进位到整数部分 */
        uval = uval - sc;
        ip++;
    }
    fp = uval;
    if (conv == 'e' && ip >= 10) {                /* 9.999 → 10.00：指数进位 */
        ip = ip / 10;
        exp10++;
    }
    len = c6c_utoa(body, ip, 10, 0, 1);
    if (p > 0) {
        long fl = 0;

        body[len] = '.';
        len++;
        fl = c6c_utoa(frac, fp, 10, 0, p);
        for (k = 0; k < fl; k++)
            body[len + k] = frac[k];
        len = len + fl;
    } else if (alt) {
        body[len] = '.';
        len++;
    }
    }
    if (is_g && !alt) {                           /* %g 去掉**小数部分**的尾零 */
        long dot = -1;

        /* 只在小数点存在时才剥——否则 100000 会被剥成 "1"（踩过） */
        for (k = 0; k < len; k++)
            if (body[k] == '.')
                dot = k;
        if (dot >= 0) {
            while (len > dot + 1 && body[len - 1] == '0')
                len--;
            if (len == dot + 1)
                len--;                            /* 去掉孤零零的小数点 */
        }
    }
    if (conv == 'e') {
        long e2 = exp10 < 0 ? -exp10 : exp10;
        long fl = 0;

        body[len] = 'e';
        len++;
        body[len] = exp10 < 0 ? '-' : '+';
        len++;
        fl = c6c_utoa(frac, (unsigned long)e2, 10, 0, 2);
        for (k = 0; k < fl; k++)
            body[len + k] = frac[k];
        len = len + fl;
    }
    return len;
}

long c6c_vfmt(char *out, long cap, const char *fmt, va_list ap)
{
    long n = 0;
    long i = 0;
    char body[512] = {0};

    while (fmt[i]) {
        char c = fmt[i];
        long bodylen = 0;
        long j = 0;
        long ljust = 0;
        long zero = 0;
        long plus = 0;
        long space = 0;
        long alt = 0;
        long width = 0;
        long prec = -1;
        long longs = 0;
        char conv = 0;
        char sign = 0;
        char prefix[3] = {0};
        long plen = 0;
        long pad = 0;
        long k = 0;

        if (c != '%') {
            if (n < cap - 1)
                out[n] = c;
            n++;
            i++;
            continue;
        }
        i++;
        while (fmt[i]) {
            char f = fmt[i];
            long hit = 1;

            if (f == '-')
                ljust = 1;
            else if (f == '0')
                zero = 1;
            else if (f == '+')
                plus = 1;
            else if (f == ' ')
                space = 1;
            else if (f == '#')
                alt = 1;
            else
                hit = 0;
            if (!hit)
                break;
            i++;
        }
        if (fmt[i] == '*') {
            long w = (long)va_arg(ap, int);

            i++;
            if (w < 0) {
                ljust = 1;
                w = -w;
            }
            width = w;
        } else {
            while (fmt[i] >= '0' && fmt[i] <= '9') {
                width = width * 10 + (long)(fmt[i] - '0');
                i++;
            }
        }
        if (fmt[i] == '.') {
            i++;
            if (fmt[i] == '*') {
                prec = (long)va_arg(ap, int);
                i++;
            } else {
                prec = 0;
                while (fmt[i] >= '0' && fmt[i] <= '9') {
                    prec = prec * 10 + (long)(fmt[i] - '0');
                    i++;
                }
            }
        }
        while (fmt[i] == 'l' || fmt[i] == 'h' || fmt[i] == 'z' || fmt[i] == 't'
               || fmt[i] == 'j' || fmt[i] == 'L') {
            if (fmt[i] == 'l' || fmt[i] == 'z' || fmt[i] == 't' || fmt[i] == 'j')
                longs = 1;
            i++;
        }
        conv = fmt[i];
        if (conv)
            i++;
        if (conv == 0)
            break;
        if (conv == '%') {
            if (n < cap - 1)
                out[n] = '%';
            n++;
            continue;
        }
        if (conv == 'c') {
            long v = (long)va_arg(ap, int);

            body[0] = (char)v;
            bodylen = 1;
            pad = width - bodylen;
            if (!ljust)
                c6c_pad(out, cap, &n, pad, ' ');
            c6c_out(out, cap, &n, body, bodylen);
            if (ljust)
                c6c_pad(out, cap, &n, pad, ' ');
            continue;
        }
        if (conv == 's') {
            char *s = (char *)va_arg(ap, char *);

            if (!s)
                s = "(null)";
            bodylen = c6c_strlen(s);
            if (prec >= 0 && bodylen > prec)
                bodylen = prec;
            pad = width - bodylen;
            if (!ljust)
                c6c_pad(out, cap, &n, pad, ' ');
            c6c_out(out, cap, &n, s, bodylen);
            if (ljust)
                c6c_pad(out, cap, &n, pad, ' ');
            continue;
        }
        if (conv == 'f' || conv == 'F' || conv == 'e' || conv == 'E'
            || conv == 'g' || conv == 'G') {
            unsigned long raw = (unsigned long)va_arg(ap, unsigned long);
            double dv = 0;
            long lc = (conv >= 'A' && conv <= 'Z') ? conv + 32 : conv;

            *(unsigned long *)&dv = raw;
            bodylen = c6c_fmt_double(body, dv, lc, prec < 0 ? 6 : prec, alt, &sign);
            if (!sign && plus)
                sign = '+';               /* %+f：glibc 也这么印 */
            else if (!sign && space)
                sign = ' ';
            if (conv >= 'A' && conv <= 'Z') {
                /* %E / %G：小写生成，最后整段转大写 */
                for (k = 0; k < bodylen; k++)
                    if (body[k] >= 'a' && body[k] <= 'z')
                        body[k] = (char)(body[k] - 32);
            }
            pad = width - bodylen - (sign ? 1 : 0);
            if (zero && !ljust) {
                if (sign) {
                    c6c_out(out, cap, &n, &sign, 1);
                    sign = 0;
                }
                c6c_pad(out, cap, &n, pad, '0');
            } else if (!ljust) {
                c6c_pad(out, cap, &n, pad, ' ');
            }
            if (sign)
                c6c_out(out, cap, &n, &sign, 1);
            c6c_out(out, cap, &n, body, bodylen);
            if (ljust)
                c6c_pad(out, cap, &n, pad, ' ');
            continue;
        }
        if (conv == 'd' || conv == 'i' || conv == 'u' || conv == 'x' || conv == 'X'
            || conv == 'o' || conv == 'p') {
            unsigned long v = 0;
            long base = 10;
            long upper = 0;
            long neg = 0;

            if (conv == 'p') {
                v = (unsigned long)va_arg(ap, void *);
                base = 16;
                alt = 1;
            } else if (conv == 'u') {
                v = longs ? (unsigned long)va_arg(ap, unsigned long)
                          : (unsigned long)va_arg(ap, unsigned int);
            } else if (conv == 'd' || conv == 'i') {
                long sv = longs ? (long)va_arg(ap, long) : (long)va_arg(ap, int);

                if (sv < 0) {
                    neg = 1;
                    v = (unsigned long)(-sv);
                } else {
                    v = (unsigned long)sv;
                }
            } else {
                v = longs ? (unsigned long)va_arg(ap, unsigned long)
                          : (unsigned long)va_arg(ap, unsigned int);
                base = (conv == 'o') ? 8 : 16;
                upper = (conv == 'X');
            }
            if (prec < 0)
                prec = 1;
            if (prec == 0 && v == 0)
                bodylen = 0;              /* %.0d 的 0 什么都不印（glibc 口径） */
            else
                bodylen = c6c_utoa(body, v, base, upper, prec);
            if (neg)
                sign = '-';
            else if (plus)
                sign = '+';
            else if (space)
                sign = ' ';
            if (alt && base == 16 && v != 0) {   /* %#x 的 0 也不加 0x */
                prefix[0] = '0';
                prefix[1] = upper ? 'X' : 'x';
                plen = 2;
            } else if (alt && base == 8 && body[0] != '0') {
                prefix[0] = '0';
                plen = 1;
            }
            pad = width - bodylen - plen - (sign ? 1 : 0);
            if (zero && !ljust && prec == 1) {
                if (sign) {
                    c6c_out(out, cap, &n, &sign, 1);
                    sign = 0;
                }
                c6c_out(out, cap, &n, prefix, plen);
                plen = 0;
                c6c_pad(out, cap, &n, pad, '0');
            } else if (!ljust) {
                c6c_pad(out, cap, &n, pad, ' ');
            }
            if (sign)
                c6c_out(out, cap, &n, &sign, 1);
            if (plen)
                c6c_out(out, cap, &n, prefix, plen);
            c6c_out(out, cap, &n, body, bodylen);
            if (ljust)
                c6c_pad(out, cap, &n, pad, ' ');
            continue;
        }
        /* 不认识的转换就原样印出来，方便定位 */
        body[0] = '%';
        body[1] = conv;
        bodylen = 2;
        if (prec >= 0) {
            for (k = 0; k < 0; k++)
                j = j;
        }
        c6c_out(out, cap, &n, body, bodylen);
    }
    if (cap > 0) {
        if (n < cap)
            out[n] = 0;
        else
            out[cap - 1] = 0;
    }
    return n;
}

/* ---------- stdio ---------- */
static char c6c_obuf[8192] = {0};

int printf(const char *fmt, ...)
{
    va_list ap = {0};
    long n = 0;

    va_start(ap, fmt);
    n = c6c_vfmt(c6c_obuf, (long)sizeof(c6c_obuf), fmt, ap);
    va_end(ap);
    if (n > (long)sizeof(c6c_obuf) - 1)
        n = (long)sizeof(c6c_obuf) - 1;
    c6c_sys3(C6C_SYS_WRITE, 1, (long)c6c_obuf, n);
    return (int)n;
}

int vfprintf(void *f, const char *fmt, va_list ap)
{
    long n = 0;
    long fd = (long)f;

    n = c6c_vfmt(c6c_obuf, (long)sizeof(c6c_obuf), fmt, ap);
    if (n > (long)sizeof(c6c_obuf) - 1)
        n = (long)sizeof(c6c_obuf) - 1;
    c6c_sys3(C6C_SYS_WRITE, fd, (long)c6c_obuf, n);
    return (int)n;
}

int vprintf(const char *fmt, va_list ap)
{
    return vfprintf((void *)1, fmt, ap);
}

int fprintf(void *f, const char *fmt, ...)
{
    va_list ap = {0};
    long n = 0;
    long fd = (long)f;

    va_start(ap, fmt);
    n = c6c_vfmt(c6c_obuf, (long)sizeof(c6c_obuf), fmt, ap);
    va_end(ap);
    if (n > (long)sizeof(c6c_obuf) - 1)
        n = (long)sizeof(c6c_obuf) - 1;
    c6c_sys3(C6C_SYS_WRITE, fd, (long)c6c_obuf, n);
    return (int)n;
}

int sprintf(char *dst, const char *fmt, ...)
{
    va_list ap = {0};
    long n = 0;

    va_start(ap, fmt);
    n = c6c_vfmt(dst, 0x7FFFFFFF, fmt, ap);
    va_end(ap);
    return (int)n;
}

/* f-string 的 `{x;b}`：printf 没有二进制转换，编译器为它调这个。
 * 写进调用者给的缓冲（够 72 字节），返回同一个指针。 */
char *__c6_fmt_bin(char *buf, unsigned long long v, int alt)
{
    char tmp[72] = {0};
    int n = 0;
    int i = 0;

    while (v != 0 && n < 64) {
        tmp[n++] = (char)('0' + (int)(v & 1u));
        v = v >> 1;
    }
    if (n == 0)
        tmp[n++] = '0';
    if (alt) {
        buf[i++] = '0';
        buf[i++] = 'b';
    }
    while (n > 0)
        buf[i++] = tmp[--n];
    buf[i] = 0;
    return buf;
}

int snprintf(char *dst, long cap, const char *fmt, ...)
{
    va_list ap = {0};
    long n = 0;

    va_start(ap, fmt);
    n = c6c_vfmt(dst, cap, fmt, ap);
    va_end(ap);
    return (int)n;
}

int vsnprintf(char *dst, long cap, const char *fmt, va_list ap)
{
    return (int)c6c_vfmt(dst, cap, fmt, ap);
}

int puts(const char *s)
{
    long n = c6c_strlen(s);

    c6c_sys3(C6C_SYS_WRITE, 1, (long)s, n);
    c6c_sys3(C6C_SYS_WRITE, 1, (long)"\n", 1);
    return (int)n + 1;
}

int putchar(int c)
{
    char b[1] = {0};

    b[0] = (char)c;
    c6c_sys3(C6C_SYS_WRITE, 1, (long)b, 1);
    return (int)(unsigned char)c;
}

int fputs(const char *s, void *f)
{
    long fd = (long)f;

    return (int)c6c_sys3(C6C_SYS_WRITE, fd, (long)s, c6c_strlen(s));
}

int fgetc(void *f)
{
    char b[1] = {0};

    if (c6c_sys3(C6C_SYS_READ, (long)f, (long)b, 1) != 1)
        return -1;
    return (int)(unsigned char)b[0];
}

int getc(void *f)
{
    return fgetc(f);
}

int fputc(int c, void *f)
{
    char b[1] = {0};

    b[0] = (char)c;
    if (c6c_sys3(C6C_SYS_WRITE, (long)f, (long)b, 1) != 1)
        return -1;
    return (int)(unsigned char)c;
}

int putc(int c, void *f)
{
    return fputc(c, f);
}

char *fgets(char *buf, int n, void *f)
{
    int i = 0;
    char ch[1] = {0};

    while (i < n - 1) {
        if (c6c_sys3(C6C_SYS_READ, (long)f, (long)ch, 1) != 1)
            break;
        buf[i] = ch[0];
        i++;
        if (ch[0] == '\n')
            break;
    }
    buf[i] = 0;
    if (i == 0)
        return 0;
    return buf;
}

int remove(const char *path)
{
    return (int)c6c_sys1(87, (long)path);   /* SYS_unlink */
}

int rename(const char *a, const char *b)
{
    return (int)c6c_sys2(82, (long)a, (long)b);   /* SYS_rename */
}

int getchar(void)
{
    char b[1] = {0};

    if (c6c_sys3(C6C_SYS_READ, 0, (long)b, 1) != 1)
        return -1;
    return (int)(unsigned char)b[0];
}

void *fopen(const char *path, const char *mode)
{
    long flags = 0;
    long fd = 0;

    if (mode[0] == 'r')
        flags = 0;
    else if (mode[0] == 'w')
        flags = 0x241;      /* O_WRONLY|O_CREAT|O_TRUNC */
    else if (mode[0] == 'a')
        flags = 0x441;      /* O_WRONLY|O_CREAT|O_APPEND */
    fd = c6c_sys3(C6C_SYS_OPEN, (long)path, flags, 0666);
    if (fd < 0)
        return 0;
    return (void *)fd;
}

int fclose(void *f)
{
    return (int)c6c_sys1(C6C_SYS_CLOSE, (long)f);
}

long fread(void *buf, long size, long n, void *f)
{
    long want = size * n;
    long got = c6c_sys3(C6C_SYS_READ, (long)f, (long)buf, want);

    if (got <= 0)
        return 0;
    return got / size;
}

long fwrite(const void *buf, long size, long n, void *f)
{
    long want = size * n;
    long got = c6c_sys3(C6C_SYS_WRITE, (long)f, (long)buf, want);

    if (got <= 0)
        return 0;
    return got / size;
}

int fflush(void *f)
{
    (void)f;
    return 0;
}

int atoi(const char *s)
{
    long v = 0;
    long neg = 0;
    long i = 0;

    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n')
        i++;
    if (s[i] == '-') {
        neg = 1;
        i++;
    } else if (s[i] == '+') {
        i++;
    }
    while (s[i] >= '0' && s[i] <= '9') {
        v = v * 10 + (long)(s[i] - '0');
        i++;
    }
    return (int)(neg ? -v : v);
}

long strtol(const char *s, char **end, int base)
{
    long v = 0;
    long neg = 0;
    long i = 0;
    long d = 0;

    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n')
        i++;
    if (s[i] == '-') {
        neg = 1;
        i++;
    } else if (s[i] == '+') {
        i++;
    }
    if (base == 0) {
        base = 10;
        if (s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
            base = 16;
            i = i + 2;
        } else if (s[i] == '0') {
            base = 8;
        }
    } else if (base == 16 && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
        i = i + 2;
    }
    while (1) {
        char c = s[i];

        d = -1;
        if (c >= '0' && c <= '9')
            d = (long)(c - '0');
        else if (c >= 'a' && c <= 'z')
            d = (long)(c - 'a') + 10;
        else if (c >= 'A' && c <= 'Z')
            d = (long)(c - 'A') + 10;
        if (d < 0 || d >= base)
            break;
        v = v * base + d;
        i++;
    }
    if (end)
        *end = (char *)s + i;
    return neg ? -v : v;
}

long strtoul(const char *s, char **end, int base)
{
    return strtol(s, end, base);
}

unsigned long long strtoull(const char *s, char **end, int base)
{
    return (unsigned long long)strtol(s, end, base);
}

long long strtoll(const char *s, char **end, int base)
{
    return (long long)strtol(s, end, base);
}

/* ctype（只做 ASCII） */
int isdigit(int c) { return c >= '0' && c <= '9'; }
int isalpha(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
int isalnum(int c) { return isdigit(c) || isalpha(c); }
int isspace(int c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'; }
int isupper(int c) { return c >= 'A' && c <= 'Z'; }
int islower(int c) { return c >= 'a' && c <= 'z'; }
int isprint(int c) { return c >= 0x20 && c < 0x7F; }
int isxdigit(int c) { return isdigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'); }
int toupper(int c) { return islower(c) ? c - 32 : c; }
int tolower(int c) { return isupper(c) ? c + 32 : c; }


/* ---------- 环境变量 ----------
 * 入口只在 rdx 里给了 envp，运行时这边拿不到寄存器，所以直接读
 * /proc/self/environ（NUL 分隔的 NAME=VALUE 串）。第一次调用时读进一块
 * 静态缓冲，之后只做扫描。 */
/* 64 KB：/proc/self/environ 里放的是整份环境，8 KB 的缓冲会截断尾巴
 * （踩过：C6C_RT 恰好在末尾，于是 getenv 永远找不到） */
static char c6c_envbuf[65536] = {0};
static long c6c_envlen;

static void c6c_env_load(void)
{
    long fd = 0;
    long n = 0;

    if (c6c_envlen)
        return;
    fd = open("/proc/self/environ", 0, 0);
    if (fd < 0) {
        c6c_envlen = -1;
        return;
    }
    for (;;) {
        long got = read(fd, c6c_envbuf + n, (long)sizeof(c6c_envbuf) - 1 - n);

        if (got <= 0)
            break;
        n += got;
        if (n >= (long)sizeof(c6c_envbuf) - 1)
            break;
    }
    close(fd);
    c6c_envbuf[n] = 0;
    c6c_envlen = n ? n : -1;
}

/* _SC_* 名字（和 Linux 的编号一致，include/unistd.h 里写的是同一套） */
#define C6C_SC_ARG_MAX              0
#define C6C_SC_CLK_TCK              2
#define C6C_SC_OPEN_MAX             4
#define C6C_SC_PAGESIZE             30
#define C6C_SC_NPROCESSORS_CONF     83
#define C6C_SC_NPROCESSORS_ONLN     84

/* 在线 CPU 个数：读 /sys/devices/system/cpu/online 的 "0-N" 形式，
 * 读不到就给 1（宁可少开线程，也不要算错）。 */
static long c6c_ncpu(void)
{
    char b[128] = {0};
    long fd = 0;
    long n = 0;
    long i = 0;
    long lo = -1;
    long hi = -1;
    int dash = 0;

    fd = open("/sys/devices/system/cpu/online", 0, 0);
    if (fd < 0)
        return 1;
    n = read(fd, b, (long)sizeof(b) - 1);
    close(fd);
    if (n <= 0)
        return 1;
    b[n] = 0;
    for (i = 0; i < n; i++) {
        char c = b[i];

        if (c >= '0' && c <= '9') {
            long v = (long)(c - '0');

            if (dash) {
                hi = (hi < 0 ? 0 : hi) * 10 + v;
            } else {
                lo = (lo < 0 ? 0 : lo) * 10 + v;
            }
        } else if (c == '-') {
            dash = 1;
        } else if (c == ',') {
            break;
        }
    }
    if (dash == 0)
        hi = lo;
    if (lo < 0 || hi < 0 || hi < lo)
        return 1;
    return hi - lo + 1;
}

long sysconf(int name)
{
    switch (name) {
    case C6C_SC_PAGESIZE:
        return 4096;
    case C6C_SC_NPROCESSORS_ONLN:
    case C6C_SC_NPROCESSORS_CONF:
        return c6c_ncpu();
    case C6C_SC_CLK_TCK:
        return 100;
    case C6C_SC_OPEN_MAX:
        return 1024;
    case C6C_SC_ARG_MAX:
        return 131072;
    }
    return -1;
}

/* 临时名里那 6 位随机数的计数器（mkstemp/mkdtemp 共用） */
static unsigned int c6c_mktemp_n;

/* `mkdtemp`：把模板的 XXXXXX 换掉再 mkdir */
char *mkdtemp(char *tmpl)
{
    long n = strlen(tmpl);
    unsigned int v = 0;
    int i = 0;

    if (n < 6)
        return NULL;
    v = (unsigned int)getpid() * 2246822519u + c6c_mktemp_n * 2654435761u + 7919u;
    c6c_mktemp_n++;
    for (i = 0; i < 6; i++) {
        long k = n - 6 + i;
        unsigned int d = v % 36u;

        tmpl[k] = (char)(d < 10 ? '0' + d : 'a' + (d - 10));
        v /= 36u;
    }
    if (mkdir(tmpl, 0700) != 0)
        return NULL;
    return tmpl;
}

/* `access`：用 faccessat(AT_FDCWD, path, mode, 0)（269 号） */
#define C6C_SYS_FACCESSAT 269
#define C6C_AT_FDCWD (-100)

int access(const char *path, int mode)
{
    return (int)c6c_sys4(C6C_SYS_FACCESSAT, C6C_AT_FDCWD, (long)path, mode, 0);
}

/* pty：`posix_openpt` 就是开 /dev/ptmx，剩下几个是 ioctl 封装。 */
int posix_openpt(int flags)
{
    return (int)open("/dev/ptmx", O_RDWR | (flags & O_NONBLOCK), 0);
}

int grantpt(int fd)
{
    (void)fd;
    return 0;
}

int unlockpt(int fd)
{
    int zero = 0;
    /* TIOCSPTLCK = 0x40045431 */
    return (int)ioctl(fd, 0x40045431ul, &zero);
}

char *ptsname(int fd)
{
    int n = -1;
    static char buf[64];
    int i = 0;

    /* TIOCGPTN = 0x80045430 */
    if (ioctl(fd, 0x80045430ul, &n) != 0)
        return NULL;
    for (i = 0; i < 64; i++)
        buf[i] = 0;
    {
        const char *pre = "/dev/pts/";
        int k = 0;

        while (pre[k]) {
            buf[k] = pre[k];
            k++;
        }
        /* 十进制 */
        if (n == 0) {
            buf[k++] = '0';
        } else {
            char tmp[16] = {0};
            int t = 0;

            while (n > 0) {
                tmp[t++] = (char)('0' + n % 10);
                n /= 10;
            }
            while (t > 0)
                buf[k++] = tmp[--t];
        }
        buf[k] = 0;
    }
    return buf;
}

/* setenv/unsetenv：改不了内核给的那块 environ，所以在运行时这边维护一张
 * 覆盖表，getenv 先查它。表和比较函数要排在 getenv 前面。 */
#define C6C_SETENV_MAX 32
static const char *c6c_setenv_k[C6C_SETENV_MAX];
static const char *c6c_setenv_v[C6C_SETENV_MAX];
static int c6c_setenv_n;

static int c6c_streq_n(const char *a, const char *b, long n)
{
    long i = 0;

    for (i = 0; i < n; i++)
        if (a[i] != b[i])
            return 0;
    return 1;
}

char *getenv(const char *name)
{
    long nl = strlen(name);
    long i = 0;
    int k = 0;

    for (k = 0; k < c6c_setenv_n; k++)
        if (c6c_streq_n(c6c_setenv_k[k], name, nl) && c6c_setenv_k[k][nl] == 0)
            return (char *)c6c_setenv_v[k];
    c6c_env_load();
    if (c6c_envlen < 0)
        return NULL;
    while (i < c6c_envlen) {
        const char *e = c6c_envbuf + i;
        long el = strlen(e);
        long k = 0;

        for (k = 0; k < nl; k++)
            if (e[k] != name[k])
                break;
        if (k == nl && e[nl] == '=')
            return (char *)e + nl + 1;
        i += el + 1;
    }
    return NULL;
}

void *memchr(const void *s, int c, unsigned long n)
{
    const unsigned char *p = (const unsigned char *)s;
    unsigned long i = 0;

    for (i = 0; i < n; i++)
        if (p[i] == (unsigned char)c)
            return (void *)(p + i);
    return NULL;
}

unsigned long strspn(const char *s, const char *accept)
{
    unsigned long n = 0;

    while (s[n] && strchr(accept, s[n]))
        n++;
    return n;
}

unsigned long strcspn(const char *s, const char *reject)
{
    unsigned long n = 0;

    while (s[n] && !strchr(reject, s[n]))
        n++;
    return n;
}

char *strpbrk(const char *s, const char *accept)
{
    while (*s) {
        if (strchr(accept, *s))
            return (char *)s;
        s++;
    }
    return NULL;
}

/* qsort：堆排 + 手写交换（不额外要内存，元素大小任意） */
static void c6c_swap(char *a, char *b, unsigned long n)
{
    unsigned long i = 0;

    for (i = 0; i < n; i++) {
        char t = a[i];

        a[i] = b[i];
        b[i] = t;
    }
}

static void c6c_sift(char *base, unsigned long start, unsigned long n, unsigned long sz,
                     int (*cmp)(const void *, const void *))
{
    unsigned long root = start;

    for (;;) {
        unsigned long child = root * 2 + 1;
        unsigned long sw = root;

        if (child < n
            && cmp(base + sw * sz, base + child * sz) < 0)
            sw = child;
        if (child + 1 < n
            && cmp(base + sw * sz, base + (child + 1) * sz) < 0)
            sw = child + 1;
        if (sw == root)
            return;
        c6c_swap(base + root * sz, base + sw * sz, sz);
        root = sw;
    }
}

void qsort(void *base, unsigned long n, unsigned long sz,
           int (*cmp)(const void *, const void *))
{
    char *b = (char *)base;
    unsigned long i = 0;

    if (n < 2 || !sz)
        return;
    i = n / 2;
    while (i > 0) {
        i--;
        c6c_sift(b, i, n, sz, cmp);
    }
    i = n - 1;
    while (i > 0) {
        c6c_swap(b, b + i * sz, sz);
        c6c_sift(b, 0, i, sz, cmp);
        i--;
    }
}

void *bsearch(const void *key, const void *base, unsigned long n, unsigned long sz,
              int (*cmp)(const void *, const void *))
{
    const char *b = (const char *)base;
    unsigned long lo = 0;
    unsigned long hi = n;

    while (lo < hi) {
        unsigned long mid = lo + (hi - lo) / 2;
        int c = cmp(key, b + mid * sz);

        if (c == 0)
            return (void *)(b + mid * sz);
        if (c < 0)
            hi = mid;
        else
            lo = mid + 1;
    }
    return NULL;
}

long time(long *t)
{
    long v = c6c_sys1(C6C_SYS_TIME, 0);

    if (t)
        *t = v;
    return v;
}

int getpid(void)
{
    return (int)c6c_sys1(C6C_SYS_GETPID, 0);
}

int getuid(void)
{
    return (int)c6c_sys1(C6C_SYS_GETUID, 0);
}

int geteuid(void)
{
    return (int)c6c_sys1(C6C_SYS_GETEUID, 0);
}

int setsid(void)
{
    return (int)c6c_sys1(C6C_SYS_SETSID, 0);
}

int dup(int fd)
{
    return (int)c6c_sys1(C6C_SYS_DUP, fd);
}

int dup2(int oldfd, int newfd)
{
    return (int)c6c_sys2(C6C_SYS_DUP2, oldfd, newfd);
}

/* nice()：成功返回**新的** nice 值（syscall 就是这么报的） */
int nice(int inc)
{
    return (int)c6c_sys1(C6C_SYS_NICE, inc);
}

/* ---------- 进程 / 终端 / 临时文件 ---------- */

int wait(int *status)
{
    return waitpid(-1, status, 0);
}

int fork(void)
{
    return (int)c6c_sys1(C6C_SYS_FORK, 0);
}

int waitpid(int pid, int *status, int options)
{
    return (int)c6c_sys4(C6C_SYS_WAIT4, pid, (long)status, options, 0);
}

long ioctl(int fd, unsigned long req, void *arg)
{
    return c6c_sys3(C6C_SYS_IOCTL, fd, (long)req, (long)arg);
}

/* `isatty(fd)` 就是 ioctl(TCGETS)：能拿到终端参数就是 tty。 */
#define C6C_TCGETS 0x5401

int usleep(unsigned int usec)
{
    struct timespec ts = {0};

    ts.tv_sec = (long)(usec / 1000000u);
    ts.tv_nsec = (long)((usec % 1000000u) * 1000u);
    return (int)c6c_sys2(C6C_SYS_NANOSLEEP, (long)&ts, 0);
}

int isatty(int fd)
{
    char buf[64] = {0};
    long r = ioctl(fd, C6C_TCGETS, buf);

    return r == 0 ? 1 : 0;
}

/* 模板里的 `XXXXXX` 换成"pid + 递增计数"，O_CREAT|O_EXCL 保证不撞。 */
int mkstemp(char *tmpl)
{
    long n = strlen(tmpl);
    unsigned int v = 0;
    int i = 0;
    int fd = 0;

    if (n < 6)
        return -1;
    v = (unsigned int)getpid() * 2654435761u + c6c_mktemp_n * 40503u + 12345u;
    c6c_mktemp_n++;
    for (i = 0; i < 6; i++) {
        long k = n - 6 + i;
        unsigned int d = v % 36u;

        tmpl[k] = (char)(d < 10 ? '0' + d : 'a' + (d - 10));
        v /= 36u;
    }
    fd = (int)open(tmpl, O_CREAT | O_EXCL | O_RDWR, 0600);
    return fd < 0 ? -1 : fd;
}

/* ---------- 网络 / 等待：socket 家族、poll、uname、rmdir、tcgetattr ----------
 *
 * 这几个名字以前是 tcc 链的 libc 给的；c6c 自带运行时顶上去之后，std/net、
 * std/async、std/term、std/sys、std/fsx 那几组用例编译到链接期就报「未定义的
 * 符号」。实现都是薄壳：系统调用号 + 内核结构体的布局（Linux x86-64 那份），
 * 和别处的 syscall 包装一个口径——原样返回内核的返回值（负数就是 -errno），
 * 不做 errno 转换（rt.c6 没有全局 errno）。
 *
 * **全部 `weak`**：std 里 `Chan.send` / `ACancel.poll` 那种同名全局函数是
 * 程序自己的强定义，链接时该盖掉这里的弱定义（tcc 走 libc.so.6 时靠的是
 * ELF 符号覆盖，效果一样）。没被覆盖时，这里的实现兜住 libc 那一侧。
 */
#define C6C_SYS_POLL        7
#define C6C_SYS_SOCKET      41
#define C6C_SYS_CONNECT     42
#define C6C_SYS_ACCEPT      43
#define C6C_SYS_SENDTO      44
#define C6C_SYS_RECVFROM    45
#define C6C_SYS_SHUTDOWN    48
#define C6C_SYS_BIND        49
#define C6C_SYS_LISTEN      50
#define C6C_SYS_GETSOCKNAME 51
#define C6C_SYS_GETPEERNAME 52
#define C6C_SYS_SOCKETPAIR  53
#define C6C_SYS_SETSOCKOPT  54
#define C6C_SYS_GETSOCKOPT  55
#define C6C_SYS_UNAME       63
#define C6C_SYS_RMDIR       84

__attribute__((weak)) int poll(void *fds, unsigned long nfds, int timeout)
{
    return (int)c6c_sys3(C6C_SYS_POLL, (long)fds, (long)nfds, (long)timeout);
}

__attribute__((weak)) int nanosleep(const void *req, void *rem)
{
    return (int)c6c_sys2(C6C_SYS_NANOSLEEP, (long)req, (long)rem);
}

__attribute__((weak)) int rmdir(const char *path)
{
    return (int)c6c_sys1(C6C_SYS_RMDIR, (long)path);
}

/* 内核的 struct utsname：6 个 65 字节的字段，顺序固定 */
__attribute__((weak)) int uname(void *buf)
{
    return (int)c6c_sys1(C6C_SYS_UNAME, (long)buf);
}

/* 终端属性：TCGETS 原样交给 ioctl（调用方给 struct termios *，这一层不看内容） */
__attribute__((weak)) int tcgetattr(int fd, void *t)
{
    return (int)ioctl(fd, C6C_TCGETS, t);
}

__attribute__((weak)) int socket(int domain, int type, int proto)
{
    return (int)c6c_sys3(C6C_SYS_SOCKET, domain, type, proto);
}

__attribute__((weak)) int bind(int fd, const void *addr, unsigned int len)
{
    return (int)c6c_sys3(C6C_SYS_BIND, fd, (long)addr, (long)len);
}

__attribute__((weak)) int listen(int fd, int backlog)
{
    return (int)c6c_sys2(C6C_SYS_LISTEN, fd, backlog);
}

__attribute__((weak)) int accept(int fd, void *addr, unsigned int *len)
{
    return (int)c6c_sys3(C6C_SYS_ACCEPT, fd, (long)addr, (long)len);
}

__attribute__((weak)) int connect(int fd, const void *addr, unsigned int len)
{
    return (int)c6c_sys3(C6C_SYS_CONNECT, fd, (long)addr, (long)len);
}

/* send / recv 就是 sendto / recvfrom 去掉地址那一半 */
__attribute__((weak)) long send(int fd, const void *buf, unsigned long n, int flags)
{
    return c6c_sys4(C6C_SYS_SENDTO, fd, (long)buf, (long)n, (long)flags);
}

__attribute__((weak)) long recv(int fd, void *buf, unsigned long n, int flags)
{
    return c6c_sys4(C6C_SYS_RECVFROM, fd, (long)buf, (long)n, (long)flags);
}

__attribute__((weak)) long sendto(int fd, const void *buf, unsigned long n, int flags,
                                 const void *addr, unsigned int len)
{
    return c6c_sys6(C6C_SYS_SENDTO, fd, (long)buf, (long)n, (long)flags, (long)addr,
                    (long)len);
}

__attribute__((weak)) long recvfrom(int fd, void *buf, unsigned long n, int flags,
                                   void *addr, unsigned int *len)
{
    return c6c_sys6(C6C_SYS_RECVFROM, fd, (long)buf, (long)n, (long)flags, (long)addr,
                    (long)len);
}

__attribute__((weak)) int setsockopt(int fd, int level, int opt, const void *val,
                                     unsigned int len)
{
    /* 没有 c6c_sys5，用 6 参那个补一个 0：内核只读它定义的参数个数，多余的不看 */
    return (int)c6c_sys6(C6C_SYS_SETSOCKOPT, fd, level, opt, (long)val, (long)len, 0);
}

__attribute__((weak)) int getsockopt(int fd, int level, int opt, void *val,
                                     unsigned int *len)
{
    return (int)c6c_sys6(C6C_SYS_GETSOCKOPT, fd, level, opt, (long)val, (long)len, 0);
}

__attribute__((weak)) int getsockname(int fd, void *addr, unsigned int *len)
{
    return (int)c6c_sys3(C6C_SYS_GETSOCKNAME, fd, (long)addr, (long)len);
}

__attribute__((weak)) int getpeername(int fd, void *addr, unsigned int *len)
{
    return (int)c6c_sys3(C6C_SYS_GETPEERNAME, fd, (long)addr, (long)len);
}

__attribute__((weak)) int socketpair(int domain, int type, int proto, int *sv)
{
    return (int)c6c_sys4(C6C_SYS_SOCKETPAIR, domain, type, proto, (long)sv);
}

__attribute__((weak)) int shutdown(int fd, int how)
{
    return (int)c6c_sys2(C6C_SYS_SHUTDOWN, fd, how);
}

static int c6c_setenv_find(const char *name, long nl)
{
    int i = 0;

    for (i = 0; i < c6c_setenv_n; i++)
        if (c6c_streq_n(c6c_setenv_k[i], name, nl) && c6c_setenv_k[i][nl] == 0)
            return i;
    return -1;
}

int setenv(const char *name, const char *val, int overwrite)
{
    long nl = strlen(name);
    int i = c6c_setenv_find(name, nl);

    if (i >= 0) {
        if (!overwrite)
            return 0;
        c6c_setenv_v[i] = val;
        return 0;
    }
    if (c6c_setenv_n >= C6C_SETENV_MAX)
        return -1;
    c6c_setenv_k[c6c_setenv_n] = name;
    c6c_setenv_v[c6c_setenv_n] = val;
    c6c_setenv_n++;
    return 0;
}

int unsetenv(const char *name)
{
    long nl = strlen(name);
    int i = c6c_setenv_find(name, nl);

    if (i < 0)
        return 0;
    for (; i + 1 < c6c_setenv_n; i++) {
        c6c_setenv_k[i] = c6c_setenv_k[i + 1];
        c6c_setenv_v[i] = c6c_setenv_v[i + 1];
    }
    c6c_setenv_n--;
    return 0;
}

int clock_gettime(int clk, struct timespec *ts)
{
    return (int)c6c_sys2(C6C_SYS_CLOCK_GETTIME, clk, (long)ts);
}

/* struct tm 的布局（glibc：9 个 int + long + 指针），用私有镜像结构写，
 * 免得和 <time.h> 的定义撞车 */
struct tm;

typedef struct C6CTm {
    int tm_sec;
    int tm_min;
    int tm_hour;
    int tm_mday;
    int tm_mon;
    int tm_year;
    int tm_wday;
    int tm_yday;
    int tm_isdst;
    long tm_gmtoff;
    const char *tm_zone;
} C6CTm;

static C6CTm c6c_tm;

static void c6c_tm_fill(C6CTm *t, long tt)
{
    long days = tt / 86400;
    long rem = tt % 86400;
    long z = days + 719468;
    long era = (z >= 0 ? z : z - 146096) / 146097;
    long doe = z - era * 146097;
    long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    long y = yoe + era * 400;
    long doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    long mp = (5 * doy + 2) / 153;

    if (rem < 0) {
        rem += 86400;
        days--;
    }
    t->tm_hour = (int)(rem / 3600);
    t->tm_min = (int)((rem % 3600) / 60);
    t->tm_sec = (int)(rem % 60);
    t->tm_mday = (int)(doy - (153 * mp + 2) / 5 + 1);
    t->tm_mon = (int)(mp < 10 ? mp + 2 : mp - 10);
    t->tm_year = (int)(y + (t->tm_mon <= 1) - 1900);
    t->tm_wday = (int)((days + 4) % 7);
    if (t->tm_wday < 0)
        t->tm_wday += 7;
    t->tm_yday = (int)doy;
    t->tm_isdst = 0;
    t->tm_gmtoff = 0;
    t->tm_zone = "UTC";
}

struct tm *gmtime(const long *tt)
{
    if (!tt)
        return NULL;
    c6c_tm_fill(&c6c_tm, *tt);
    return (struct tm *)&c6c_tm;
}

struct tm *localtime(const long *tt)
{
    return gmtime(tt);          /* 不做时区换算：先按 UTC 用 */
}

long mktime(struct tm *t)
{
    C6CTm *m = (C6CTm *)t;
    long y = m->tm_year + 1900;
    long mo = m->tm_mon;
    long days = 0;
    long era = 0;
    long yoe = 0;
    long doy = 0;
    long doe = 0;
    long z = 0;

    y -= mo <= 1;
    era = (y >= 0 ? y : y - 399) / 400;
    yoe = y - era * 400;
    doy = (153 * (mo > 1 ? mo - 2 : mo + 10) + 2) / 5 + m->tm_mday - 1;
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    z = era * 146097 + doe - 719468;
    days = z;
    return days * 86400 + m->tm_hour * 3600 + m->tm_min * 60 + m->tm_sec;
}

double difftime(long a, long b)
{
    return (double)(a - b);
}

static void c6c_tm_pad2(char *out, long *n, int v)
{
    out[(*n)++] = (char)('0' + (v / 10) % 10);
    out[(*n)++] = (char)('0' + v % 10);
}

unsigned long strftime(char *out, unsigned long cap, const char *fmt, struct tm *t)
{
    C6CTm *m = (C6CTm *)t;
    long n = 0;
    long i = 0;

    if (!cap)
        return 0;
    while (fmt[i] && n + 8 < (long)cap) {
        if (fmt[i] != '%') {
            out[n++] = fmt[i++];
            continue;
        }
        i++;
        switch (fmt[i]) {
        case 'Y': n += (long)snprintf(out + n, cap - (unsigned long)n, "%d", m->tm_year + 1900); i++; break;
        case 'm': c6c_tm_pad2(out, &n, m->tm_mon + 1); i++; break;
        case 'd': c6c_tm_pad2(out, &n, m->tm_mday); i++; break;
        case 'H': c6c_tm_pad2(out, &n, m->tm_hour); i++; break;
        case 'M': c6c_tm_pad2(out, &n, m->tm_min); i++; break;
        case 'S': c6c_tm_pad2(out, &n, m->tm_sec); i++; break;
        case '%': out[n++] = '%'; i++; break;
        default: out[n++] = '%'; break;
        }
    }
    out[n < (long)cap ? n : (long)cap - 1] = 0;
    return (unsigned long)n;
}

char *strerror(int e)
{
    (void)e;
    return (char *)"error";
}

static unsigned long c6c_rand_state = 12345;

int rand(void)
{
    c6c_rand_state = c6c_rand_state * 1103515245UL + 12345UL;

    return (int)((c6c_rand_state >> 16) & 0x7FFFFFFF);
}

void srand(unsigned int seed)
{
    c6c_rand_state = seed;
}

long long llabs(long long v)
{
    return v < 0 ? -v : v;
}

long labs(long v)
{
    return v < 0 ? -v : v;
}

int abs(int v)
{
    return v < 0 ? -v : v;
}

long long atoll(const char *s)
{
    return (long long)strtol(s, NULL, 10);
}

double strtod(const char *s, char **end)
{
    double v = 0.0;
    double scale = 0.1;
    int neg = 0;
    long i = 0;
    int frac = 0;

    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n')
        i++;
    if (s[i] == '-') {
        neg = 1;
        i++;
    } else if (s[i] == '+') {
        i++;
    }
    while (s[i] >= '0' && s[i] <= '9') {
        v = v * 10.0 + (double)(s[i] - '0');
        i++;
    }
    if (s[i] == '.') {
        i++;
        frac = 1;
        while (s[i] >= '0' && s[i] <= '9') {
            v += scale * (double)(s[i] - '0');
            scale *= 0.1;
            i++;
        }
    }
    (void)frac;
    /* 指数部分：以前完全没处理，于是 `.123E12` 只解析出 0.123、`1e19` 只解析出
     * 1——用 c6c 编出来的 tcc 因此把浮点字面量算错（tcc tests2 的
     * 70_floating_point_literals、134_double_to_signed 就是这么挂的）。 */
    if (s[i] == 'e' || s[i] == 'E') {
        int eneg = 0;
        long e = 0;
        long k = i + 1;
        int any = 0;

        if (s[k] == '-') {
            eneg = 1;
            k++;
        } else if (s[k] == '+') {
            k++;
        }
        while (s[k] >= '0' && s[k] <= '9') {
            any = 1;
            if (e < 400)
                e = e * 10 + (s[k] - '0');
            k++;
        }
        if (any) {
            while (e-- > 0) {
                if (eneg)
                    v /= 10.0;
                else
                    v *= 10.0;
            }
            i = k;
        }
    }
    if (end)
        *end = (char *)s + i;
    return neg ? -v : v;
}

double atof(const char *s)
{
    return strtod(s, NULL);
}

/* getloadavg()：读 /proc/loadavg 的前三个数。c6c 没有 libc，自己解析。 */
int getloadavg(double *av, int n)
{
    char buf[128] = {0};
    long fd = -1;
    long r = 0;
    int i = 0;
    char *p = buf;

    if (n <= 0 || !av)
        return -1;
    fd = open("/proc/loadavg", 0, 0);
    if (fd < 0)
        return -1;
    r = read(fd, buf, (long)sizeof(buf) - 1);
    close(fd);
    if (r <= 0)
        return -1;
    buf[r] = 0;
    for (i = 0; i < n && i < 3; i++) {
        av[i] = strtod(p, &p);
        while (*p == ' ')
            p++;
    }
    return i;
}

/* memmem()：找子串（找不到返回 NULL） */
void *memmem(const void *hay, size_t hn, const void *needle, size_t nn)
{
    const char *h = (const char *)hay;
    const char *nd = (const char *)needle;
    size_t i = 0;

    if (nn == 0)
        return (void *)h;
    if (hn < nn)
        return 0;
    for (i = 0; i + nn <= hn; i++)
        if (h[i] == nd[0] && !memcmp(h + i, nd, nn))
            return (void *)(h + i);
    return 0;
}

/* ---------- 断言 / 线程桩 ----------
 * 真实代码（包括 tcc 的测试）会直接引用 glibc 的这些符号。c6c 的运行时是单线程
 * 的，所以线程相关的都做成"同步执行 + 立即返回"的桩：语义上退化成串行，
 * 但不静默——注释在这里写清楚。 */
void __assert_fail(const char *expr, const char *file, unsigned int line, const char *func)
{
    printf("%s:%u: %s: Assertion `%s' failed.\n", file, (unsigned long)line, func, expr);
    exit(1);
}

/* pthread_create / pthread_join：真线程，见下面的 c6c_th_*（clone + 汇编写跳板）。 */

int pthread_condattr_init(void *a) { (void)a; return 0; }
int pthread_condattr_destroy(void *a) { (void)a; return 0; }
int pthread_condattr_setpshared(void *a, int v) { (void)a; (void)v; return 0; }
int pthread_cond_init(void *c, const void *a) { (void)c; (void)a; return 0; }
int pthread_cond_destroy(void *c) { (void)c; return 0; }
int pthread_cond_wait(void *c, void *m) { (void)c; (void)m; return 0; }
int pthread_cond_signal(void *c) { (void)c; return 0; }
int pthread_cond_broadcast(void *c) { (void)c; return 0; }
int pthread_mutex_init(void *m, const void *a) { (void)m; (void)a; return 0; }
int pthread_mutex_destroy(void *m) { (void)m; return 0; }
int pthread_mutex_lock(void *m) { (void)m; return 0; }
int pthread_mutex_unlock(void *m) { (void)m; return 0; }
int pthread_attr_init(void *a) { (void)a; return 0; }
int pthread_attr_destroy(void *a) { (void)a; return 0; }


/* ---------- 给 tcc 这类"真程序"补的运行时 ----------
 * 目标是让 c6c 编出来的 tcc 能链接。语义上能做的就做（getcwd/unlink/文件定位），
 * 做不了或没有意义的明确退化：没有动态链接（dlopen 一律 NULL）、没有信号
 * （sigaction 返回 0）、没有真线程（sem_* 是空操作）、没有真正的 longjmp
 * （直接退出，避免静默走错路）。每一条都在这里写清楚。 */
char *getcwd(char *buf, size_t size)
{
    long r = c6c_sys2(79 /* getcwd */, (long)buf, (long)size);

    if (r < 0)
        return 0;
    return buf;
}

int unlink(const char *path)
{
    long r = c6c_sys1(87 /* unlink */, (long)path);

    return (int)r;
}

/* chdir：一条 syscall（80）。getcwd 在上面那条 syscall（79）里。 */
int chdir(const char *path)
{
    return (int)c6c_sys1(80 /* chdir */, (long)path);
}

/* 字节序：x86-64 是小端，所以 ntoh* / hton* 就是字节交换。
 * 它们平时是 <arpa/inet.h> 里的宏，但 std/net 那几个模块是按**函数**调用的
 * （tcc 链的 libc 里有同名符号），所以这里给真函数。 */
unsigned short ntohs(unsigned short v)
{
    return (unsigned short)(((v >> 8) & 0xffu) | ((v << 8) & 0xff00u));
}

unsigned short htons(unsigned short v)
{
    return ntohs(v);
}

unsigned int ntohl(unsigned int v)
{
    return ((v >> 24) & 0xffu) | ((v >> 8) & 0xff00u) | ((v << 8) & 0xff0000u)
           | ((v << 24) & 0xff000000u);
}

unsigned int htonl(unsigned int v)
{
    return ntohl(v);
}

/* struct termios（Linux x86-64）：4 个 unsigned + c_line + c_cc[32]（一共 60 字节）。
 * 只在 cfmakeraw 里用到，所以用一个私有镜像结构，免得和 <termios.h> 的定义撞车。 */
typedef struct C6CTermios {
    unsigned int c_iflag;
    unsigned int c_oflag;
    unsigned int c_cflag;
    unsigned int c_lflag;
    unsigned char c_line;
    unsigned char c_cc[32];
} C6CTermios;

/* cfmakeraw：glibc 那套位掩码的等价值（std/term 的 raw 模式要靠它） */
void cfmakeraw(void *t)
{
    C6CTermios *tt = (C6CTermios *)t;

    if (!tt)
        return;
    tt->c_iflag &= ~(0x1u | 0x2u | 0x8u | 0x20u | 0x40u | 0x80u | 0x100u | 0x400u);
    tt->c_oflag &= ~0x1u;                   /* OPOST */
    tt->c_lflag &= ~(0x1u | 0x2u | 0x8u | 0x40u | 0x8000u);
    tt->c_cflag &= ~(0x30u | 0x100u);       /* CSIZE | PARENB */
    tt->c_cflag |= 0x30u;                   /* CS8 */
    tt->c_cc[6] = 1;                        /* VMIN */
    tt->c_cc[5] = 0;                        /* VTIME */
}

int sysinfo(void *info)
{
    return (int)c6c_sys1(99 /* sysinfo */, (long)info);
}

/* mkfifo：x86-64 上没有独立的 syscall，走 mknod(133)。 */
int mkfifo(const char *path, unsigned int mode)
{
    return (int)c6c_sys3(133 /* mknod */, (long)path, (long)0x1000u, (long)mode);
}

int fsync(int fd)
{
    return (int)c6c_sys1(74 /* fsync */, fd);
}

int ftruncate(int fd, long len)
{
    return (int)c6c_sys2(77 /* ftruncate */, fd, len);
}


/* ---------- 第二批：目录、资源用量、终端设置、线程身份、名字解析 ----------
 *
 * 和上一批一个口径：薄壳 + 原样返回内核的返回值（负数就是 -errno）。凡是
 * 「进程里可能已经有同名强定义」的（pthread_*、getaddrinfo 家族）都标 weak。
 * 这一批点的是 std/fsx、std/ub、std/sys、std/term、std/thread、std/wire 那几组
 * 用例——它们的 test 块以前全靠 tcc 链的 libc 提供这些符号。
 */

/* 目录：自己 decode getdents64（217）。内核的记录布局正好是 glibc
 * `struct dirent` 的前 19 字节（ino 8 / off 8 / reclen 2 / type 1）+ 名字，
 * 所以把一条记录拷进静态缓冲就能原样交给调用方。`DIR *` 出去的其实是
 * 下面这个 C6CDir（rt.c6 不 include <dirent.h>：系统头里那个 DIR 是不透明的，
 * 跟自己定义的会撞名，而链接器只看符号名，类型不一致无所谓）。 */
#define C6C_SYS_GETDENTS64 217
#define C6C_O_DIRECTORY 0x10000
#define C6C_O_CLOEXEC 0x80000

typedef struct C6CDirEnt {
    unsigned long d_ino;
    long d_off;
    unsigned short d_reclen;
    unsigned char d_type;
    char d_name[256];
} C6CDirEnt;

typedef struct C6CDir {
    int fd;
    long pos;
    long len;
    char buf[4096];
} C6CDir;

static C6CDirEnt C6C_DE;

void *opendir(const char *path)
{
    C6CDir *d = 0;
    int fd = (int)open(path, C6C_O_DIRECTORY | C6C_O_CLOEXEC, 0);

    if (fd < 0)
        return 0;
    d = (C6CDir *)malloc(sizeof(C6CDir));
    if (!d) {
        close(fd);
        return 0;
    }
    d->fd = fd;
    d->pos = 0;
    d->len = 0;
    return (void *)d;
}

/* 一次 getdents64 读 4 KiB，逐条解码；`.` 与 `..` 照常返回（glibc 也返回） */
void *readdir(void *dir)
{
    C6CDir *d = (C6CDir *)dir;
    unsigned char *rec = 0;
    long r = 0;
    long i = 0;
    unsigned short rl = 0;

    if (!d)
        return 0;
    for (;;) {
        if (d->pos >= d->len) {
            r = c6c_sys3(C6C_SYS_GETDENTS64, d->fd, (long)d->buf, (long)sizeof(d->buf));
            if (r <= 0)
                return 0;
            d->pos = 0;
            d->len = r;
        }
        rec = (unsigned char *)d->buf + d->pos;
        rl = *(unsigned short *)(rec + 16);
        if (rl == 0) {
            d->pos = d->len;
            return 0;
        }
        d->pos += (long)rl;
        C6C_DE.d_ino = *(unsigned long *)rec;
        C6C_DE.d_off = *(long *)(rec + 8);
        C6C_DE.d_reclen = rl;
        C6C_DE.d_type = rec[18];
        i = 0;
        while (i < 255 && rec[19 + i]) {
            C6C_DE.d_name[i] = (char)rec[19 + i];
            i++;
        }
        C6C_DE.d_name[i] = 0;
        return (void *)&C6C_DE;
    }
}

int closedir(void *dir)
{
    C6CDir *d = (C6CDir *)dir;

    if (!d)
        return -1;
    close(d->fd);
    free(d);
    return 0;
}

void rewinddir(void *dir)
{
    C6CDir *d = (C6CDir *)dir;

    if (!d)
        return;
    d->pos = 0;
    d->len = 0;
    (void)c6c_sys3(8 /* lseek */, d->fd, 0, 0);
}

int getrusage(int who, void *usage)
{
    return (int)c6c_sys2(98 /* getrusage */, who, (long)usage);
}

/* tcsetattr：TCSANOW / TCSADRAIN / TCSAFLUSH 就是 TCGETS 之后的三个请求号 */
int tcsetattr(int fd, int actions, const void *t)
{
    unsigned long req = C6C_TCGETS + 1u;

    if (actions == 1)
        req = C6C_TCGETS + 2u;          /* TCSETSW */
    else if (actions == 2)
        req = C6C_TCGETS + 3u;          /* TCSETSF */
    return (int)ioctl(fd, req, (void *)t);
}

int tcflush(int fd, int queue)
{
    return (int)ioctl(fd, 0x540Bu + (unsigned long)(queue & 3), 0);
}

int tcdrain(int fd)
{
    return (int)ioctl(fd, 0x5409u, 0);
}

/* 线程身份：gettid（186）。pthread_create 建的线程有自己的 tid，返回它就和
 * /proc/self/task/<tid>/ 对得上（`pthread_setname_np` 走的就是那条路）。 */
unsigned long pthread_self(void)
{
    return (unsigned long)c6c_sys1(186 /* gettid */, 0);
}

int pthread_equal(unsigned long a, unsigned long b)
{
    return a == b;
}

int pthread_detach(unsigned long th)
{
    (void)th;
    return 0;
}

int pthread_mutex_trylock(void *m)
{
    (void)m;
    return 0;
}

int pthread_mutex_timedlock(void *m, const void *abstime)
{
    (void)m;
    (void)abstime;
    return 0;
}

int pthread_once(void *once, void (*fn)(void))
{
    static int done = 0;

    if (!once)
        return -1;
    if (done)
        return 0;
    done = 1;
    if (fn)
        fn();
    return 0;
}

int pthread_key_create(unsigned int *key, void (*dtor)(void *))
{
    static unsigned int next = 1;

    (void)dtor;
    if (!key)
        return -1;
    *key = next++;
    return 0;
}

int pthread_setspecific(unsigned int key, const void *val)
{
    (void)key;
    (void)val;
    return 0;
}

void *pthread_getspecific(unsigned int key)
{
    (void)key;
    return 0;
}

/* 线程名：自己的线程走 prctl(PR_SET_NAME=15)；别的线程写
 * /proc/self/task/<tid>/comm（glibc 也是这么干的）。写不成返回 -1。 */
int pthread_setname_np(unsigned long th, const char *name)
{
    char path[64] = { 0 };
    int fd = 0;
    int r = 0;

    if (!name)
        return -1;
    if (th == 0 || th == pthread_self())
        return (int)c6c_sys6(157 /* prctl */, 15, (long)name, 0, 0, 0, 0) < 0 ? -1 : 0;
    snprintf(path, sizeof(path), "/proc/self/task/%lu/comm", th);
    fd = (int)open(path, 1 /* O_WRONLY */, 0);
    if (fd < 0)
        return -1;
    r = (int)write(fd, name, strlen(name));
    close(fd);
    return r < 0 ? -1 : 0;
}

int pthread_getname_np(unsigned long th, char *buf, unsigned long len)
{
    char path[64] = { 0 };
    int fd = 0;
    long r = 0;

    if (!buf || len == 0)
        return -1;
    if (th == 0 || th == pthread_self())
        return (int)c6c_sys6(157 /* prctl */, 16 /* PR_GET_NAME */, (long)buf, 0, 0, 0, 0)
                       < 0
                   ? -1
                   : 0;
    snprintf(path, sizeof(path), "/proc/self/task/%lu/comm", th);
    fd = (int)open(path, 0 /* O_RDONLY */, 0);
    if (fd < 0)
        return -1;
    r = (long)read(fd, buf, (long)len - 1);
    close(fd);
    if (r < 0)
        return -1;
    buf[r] = 0;
    while (r > 0 && (buf[r - 1] == '\n' || buf[r - 1] == '\r'))
        buf[--r] = 0;
    return 0;
}

int sched_yield(void)
{
    return (int)c6c_sys1(24 /* sched_yield */, 0);
}

/* ---------- 名字解析：getaddrinfo 家族 ----------
 *
 * **只做能离线做对的部分**：数字点分 IPv4、`localhost`、以及数字或常见名字的
 * 端口（http/https/ssh/domain）。真的域名不走 DNS——返回 `EAI_NONAME(-2)`，
 * 让调用方拿到明确的失败，而不是假装解析出一个地址。结构体按 glibc 的 ABI
 * 摆（`struct addrinfo` 48 字节、`struct sockaddr_in` 16 字节）：调用方包含的
 * 是系统 <netdb.h>，布局必须一致。 */
#define C6C_AF_INET 2
#define C6C_AF_INET6 10
#define C6C_AF_UNSPEC 0
#define C6C_SOCK_STREAM 1
#define C6C_SOCK_DGRAM 2
#define C6C_IPPROTO_TCP 6
#define C6C_IPPROTO_UDP 17
#define C6C_AI_PASSIVE 1
#define C6C_AI_CANONNAME 2
#define C6C_AI_NUMERICHOST 4
#define C6C_EAI_NONAME (-2)
#define C6C_EAI_MEMORY (-10)
#define C6C_EAI_SERVICE (-8)
#define C6C_EAI_FAMILY (-6)

typedef struct C6CAddrInfo {
    int ai_flags;
    int ai_family;
    int ai_socktype;
    int ai_protocol;
    unsigned int ai_addrlen;
    void *ai_addr;
    char *ai_canonname;
    struct C6CAddrInfo *ai_next;
} C6CAddrInfo;

static int c6c_parse_ipv4(const char *s, unsigned long *out)
{
    unsigned long v = 0;
    int part = 0;
    int digits = 0;
    int i = 0;

    if (!s)
        return 0;
    while (part < 4) {
        unsigned long b = 0;

        digits = 0;
        while (s[i] >= '0' && s[i] <= '9') {
            b = b * 10 + (unsigned long)(s[i] - '0');
            if (b > 255)
                return 0;
            i++;
            digits++;
        }
        if (digits == 0)
            return 0;
        v = (v << 8) | b;
        part++;
        if (part < 4) {
            if (s[i] != '.')
                return 0;
            i++;
        }
    }
    if (s[i] != 0)
        return 0;
    *out = v;
    return 1;
}

static int c6c_parse_port(const char *s, unsigned int *out)
{
    static const char *names[4] = { "http", "https", "ssh", "domain" };
    static const unsigned int ports[4] = { 80u, 443u, 22u, 53u };
    int i = 0;
    int k = 0;
    unsigned long v = 0;

    if (!s || !*s)
        return 0;
    while (s[i] >= '0' && s[i] <= '9') {
        v = v * 10 + (unsigned long)(s[i] - '0');
        if (v > 65535ul)
            return 0;
        i++;
    }
    if (s[i] != 0) {
        /* 名字端口：只认这几个常见的，别的一律算"服务不存在" */
        for (k = 0; k < 4; k++)
            if (strcmp(s, names[k]) == 0)
                v = (unsigned long)ports[k];
        if (v == 0)
            return 0;
    }
    *out = (unsigned int)v;
    return 1;
}

int getaddrinfo(const char *node, const char *service, const void *hints, void **res)
{
    const C6CAddrInfo *h = (const C6CAddrInfo *)hints;
    C6CAddrInfo *ai = 0;
    unsigned char *sin = 0;
    unsigned long addr = 0;
    unsigned int port = 0;
    int family = C6C_AF_UNSPEC;
    int socktype = 0;
    int flags = 0;
    int is_any = 0;

    if (!res)
        return C6C_EAI_NONAME;
    *res = 0;
    if (h) {
        family = h->ai_family;
        socktype = h->ai_socktype;
        flags = h->ai_flags;
    }
    if (family != C6C_AF_UNSPEC && family != C6C_AF_INET)
        return C6C_EAI_FAMILY;
    if (service && !c6c_parse_port(service, &port))
        return C6C_EAI_SERVICE;
    if (!node || !*node) {
        is_any = 1;
        addr = 0;
    } else if (c6c_parse_ipv4(node, &addr)) {
        /* 数字地址：直接用 */
    } else if (strcmp(node, "localhost") == 0) {
        addr = 0x7f000001ul;
    } else {
        return C6C_EAI_NONAME;
    }
    if (is_any && (flags & C6C_AI_PASSIVE) == 0)
        addr = 0x7f000001ul;            /* 没给 node 又要主动连接 → 回环 */
    ai = (C6CAddrInfo *)calloc(sizeof(C6CAddrInfo) + 16, 1);
    if (!ai)
        return C6C_EAI_MEMORY;
    sin = (unsigned char *)ai + sizeof(C6CAddrInfo);
    *(unsigned short *)(sin + 0) = (unsigned short)C6C_AF_INET;   /* sin_family */
    *(unsigned short *)(sin + 2) = (unsigned short)((port >> 8) | ((port & 0xffu) << 8));
    *(unsigned int *)(sin + 4) = (unsigned int)ntohl((unsigned int)addr);
    if (socktype == 0 || socktype == C6C_SOCK_STREAM) {
        ai->ai_socktype = C6C_SOCK_STREAM;
        ai->ai_protocol = C6C_IPPROTO_TCP;
    } else if (socktype == C6C_SOCK_DGRAM) {
        ai->ai_socktype = C6C_SOCK_DGRAM;
        ai->ai_protocol = C6C_IPPROTO_UDP;
    } else {
        free(ai);
        return C6C_EAI_SERVICE;
    }
    ai->ai_flags = flags;
    ai->ai_family = C6C_AF_INET;
    ai->ai_addrlen = 16;
    ai->ai_addr = sin;
    ai->ai_next = 0;
    *res = (void *)ai;
    return 0;
}

void freeaddrinfo(void *res)
{
    C6CAddrInfo *ai = (C6CAddrInfo *)res;

    while (ai) {
        C6CAddrInfo *n = ai->ai_next;

        free(ai);
        ai = n;
    }
}

const char *gai_strerror(int e)
{
    if (e == 0)
        return "no error";
    if (e == C6C_EAI_NONAME)
        return "name not known（c6c 的 getaddrinfo 只认数字地址与 localhost）";
    if (e == C6C_EAI_MEMORY)
        return "out of memory";
    if (e == C6C_EAI_SERVICE)
        return "service not supported";
    if (e == C6C_EAI_FAMILY)
        return "address family not supported";
    return "unknown error";
}

unsigned int inet_addr(const char *s)
{
    unsigned long v = 0;

    if (!c6c_parse_ipv4(s, &v))
        return 0xffffffffu;
    return ntohl((unsigned int)v);
}

char *inet_ntoa(unsigned int addr)
{
    static char buf[16];
    unsigned char *p = (unsigned char *)&addr;

    snprintf(buf, sizeof(buf), "%u.%u.%u.%u", (unsigned int)p[0], (unsigned int)p[1],
             (unsigned int)p[2], (unsigned int)p[3]);
    return buf;
}

int inet_pton(int af, const char *src, void *dst)
{
    unsigned long v = 0;

    if (af != C6C_AF_INET || !dst)
        return 0;
    if (!c6c_parse_ipv4(src, &v))
        return 0;
    *(unsigned int *)dst = ntohl((unsigned int)v);
    return 1;
}

const char *inet_ntop(int af, const void *src, char *dst, unsigned int size)
{
    unsigned int addr = 0;
    char tmp[16] = { 0 };
    int n = 0;

    if (af != C6C_AF_INET || !src || !dst)
        return 0;
    addr = *(const unsigned int *)src;
    snprintf(tmp, sizeof(tmp), "%u.%u.%u.%u", (unsigned int)(addr & 0xffu),
             (unsigned int)((addr >> 8) & 0xffu), (unsigned int)((addr >> 16) & 0xffu),
             (unsigned int)((addr >> 24) & 0xffu));
    n = (int)strlen(tmp) + 1;
    if (size < (unsigned int)n)
        return 0;
    memcpy(dst, tmp, (unsigned long)n);
    return dst;
}

/* 第二批发现在链文件、fcntl、口令库、信号集上的那几条：同一批用例（std/fsx、
 * std/ub、std/sys、std/term、std/wire）下一层缺的符号。 */
int symlink(const char *target, const char *path)
{
    return (int)c6c_sys2(88 /* symlink */, (long)target, (long)path);
}

int link(const char *old_path, const char *new_path)
{
    return (int)c6c_sys2(86 /* link */, (long)old_path, (long)new_path);
}

long readlink(const char *path, char *buf, unsigned long size)
{
    return c6c_sys3(89 /* readlink */, (long)path, (long)buf, (long)size);
}

/* fcntl：三个参数的内核接口（fcntl(fd, cmd, arg)）。声明成定参而不是
 * `...`：调用方多传的那个参数照样落在同一个寄存器里，而 c6c 的 rt.c6 不需要
 * 为了一个可变形参去动 ABI。 */
long fcntl(int fd, int cmd, long arg)
{
    return c6c_sys3(72 /* fcntl */, fd, cmd, arg);
}

/* 口令库：解析 /etc/passwd 的一行。只认 uid 这一个入口（getpwuid），
 * 找到就填静态结构体里的几个指针（都指向静态缓冲），找不到返回 0。 */
typedef struct C6CPasswd {
    char *pw_name;
    char *pw_passwd;
    unsigned int pw_uid;
    unsigned int pw_gid;
    char *pw_gecos;
    char *pw_dir;
    char *pw_shell;
} C6CPasswd;

static C6CPasswd C6C_PW;
static char C6C_PWBUF[1024];


static char *c6c_pw_field(char *line, int *pos)
{
    char *start = line + *pos;
    int i = *pos;

    while (line[i] && line[i] != ':' && line[i] != '\n')
        i++;
    if (line[i])
        line[i++] = 0;
    *pos = i;
    return start;
}

/* 组库：/etc/group 的一行 = name:passwd:gid:member1,member2,...。
 * `struct group` 按 glibc 的 ABI 摆（两个指针 + 32 位 gid + char **gr_mem），
 * gr_mem 指进静态数组，成员名就地切开。 */
typedef struct C6CGroup {
    char *gr_name;
    char *gr_passwd;
    unsigned int gr_gid;
    char **gr_mem;
} C6CGroup;

static C6CGroup C6C_GR;
static char C6C_GRBUF[1024];
static char *C6C_GRMEM[33];

/* 切成员列表：逗号分隔，就地写 0，最多 32 个（glibc 也是这么多） */
static void c6c_gr_mem(char *list)
{
    int n = 0;
    int i = 0;

    while (list[i] && n < 32) {
        C6C_GRMEM[n++] = list + i;
        while (list[i] && list[i] != ',' && list[i] != '\n')
            i++;
        if (list[i])
            list[i++] = 0;
    }
    C6C_GRMEM[n] = 0;
    C6C_GR.gr_mem = C6C_GRMEM;
}

void *getgrgid(unsigned int gid)
{
    FILE *f = fopen("/etc/group", "r");
    char line[512] = { 0 };

    if (!f)
        return 0;
    while (fgets(line, (int)sizeof(line), f)) {
        int pos = 0;
        char *p = 0;
        char *sgid = 0;
        unsigned long v = 0;
        int i = 0;

        snprintf(C6C_GRBUF, sizeof(C6C_GRBUF), "%s", line);
        p = C6C_GRBUF;
        while (*p && *p != '\n')
            p++;
        *p = 0;
        C6C_GR.gr_name = c6c_pw_field(C6C_GRBUF, &pos);
        C6C_GR.gr_passwd = c6c_pw_field(C6C_GRBUF, &pos);
        sgid = c6c_pw_field(C6C_GRBUF, &pos);
        while (sgid[i] >= '0' && sgid[i] <= '9') {
            v = v * 10 + (unsigned long)(sgid[i] - '0');
            i++;
        }
        if (i == 0 || v != (unsigned long)gid)
            continue;
        C6C_GR.gr_gid = gid;
        c6c_gr_mem(C6C_GRBUF + pos);
        fclose(f);
        return (void *)&C6C_GR;
    }
    fclose(f);
    return 0;
}

/* 把 C6C_PWBUF 里那条（已经被 c6c_pw_field 切开的）记录填进 C6C_PW */
static void *c6c_pw_fill(void)
{
    int pos = 0;
    char *name = c6c_pw_field(C6C_PWBUF, &pos);
    char *pass = c6c_pw_field(C6C_PWBUF, &pos);
    char *suid = c6c_pw_field(C6C_PWBUF, &pos);
    char *sgid = c6c_pw_field(C6C_PWBUF, &pos);

    C6C_PW.pw_name = name;
    C6C_PW.pw_passwd = pass;
    C6C_PW.pw_uid = (unsigned int)strtoul(suid, 0, 10);
    C6C_PW.pw_gid = (unsigned int)strtoul(sgid, 0, 10);
    C6C_PW.pw_gecos = c6c_pw_field(C6C_PWBUF, &pos);
    C6C_PW.pw_dir = c6c_pw_field(C6C_PWBUF, &pos);
    C6C_PW.pw_shell = c6c_pw_field(C6C_PWBUF, &pos);
    return (void *)&C6C_PW;
}

/* 返回 struct passwd *（按 glibc 的 ABI 摆：两个指针 + 两个 32 位 id +
 * 三个指针）。字段都指进静态缓冲，下一次调用会覆盖上一次的结果——glibc 也是
 * 这个口径。找不到返回 0。 */
void *getpwuid(unsigned int uid)
{
    FILE *f = fopen("/etc/passwd", "r");
    char line[512] = { 0 };

    if (!f)
        return 0;
    while (fgets(line, (int)sizeof(line), f)) {
        int pos = 0;
        unsigned long v = 0;
        int i = 0;
        char *p = 0;
        char *suid = 0;

        snprintf(C6C_PWBUF, sizeof(C6C_PWBUF), "%s", line);
        p = C6C_PWBUF;
        while (*p && *p != '\n')
            p++;
        *p = 0;
        (void)c6c_pw_field(C6C_PWBUF, &pos);           /* name */
        (void)c6c_pw_field(C6C_PWBUF, &pos);           /* passwd */
        suid = c6c_pw_field(C6C_PWBUF, &pos);
        while (suid[i] >= '0' && suid[i] <= '9') {
            v = v * 10 + (unsigned long)(suid[i] - '0');
            i++;
        }
        if (i == 0 || v != (unsigned long)uid)
            continue;
        fclose(f);
        return c6c_pw_fill();
    }
    fclose(f);
    return 0;
}

/* 按名字查（getpwnam）：同一份 /etc/passwd，只是比较第一栏 */
void *getpwnam(const char *name)
{
    FILE *f = fopen("/etc/passwd", "r");
    char line[512] = { 0 };

    if (!f || !name)
        return 0;
    while (fgets(line, (int)sizeof(line), f)) {
        int pos = 0;
        char *p = 0;
        char *n = 0;

        snprintf(C6C_PWBUF, sizeof(C6C_PWBUF), "%s", line);
        p = C6C_PWBUF;
        while (*p && *p != '\n')
            p++;
        *p = 0;
        n = c6c_pw_field(C6C_PWBUF, &pos);
        if (strcmp(n, name) != 0)
            continue;
        fclose(f);
        return c6c_pw_fill();
    }
    fclose(f);
    return 0;
}

/* 信号集：glibc 的 sigset_t 是 1024 位的位图（128 字节），这几个就是位操作。
 * 注意 sigprocmask / sigaction 仍是空操作（rt.c6 没有信号投递），所以
 * "集合里有没有这一位"能被如实回答，但屏蔽/处理动作不会真生效。 */
int sigemptyset(void *set)
{
    if (!set)
        return -1;
    memset(set, 0, 128);
    return 0;
}

int sigfillset(void *set)
{
    if (!set)
        return -1;
    memset(set, 0xff, 128);
    return 0;
}

int sigaddset(void *set, int s)
{
    if (!set || s < 1 || s > 1024)
        return -1;
    ((unsigned char *)set)[(s - 1) >> 3] |= (unsigned char)(1u << ((s - 1) & 7));
    return 0;
}

int sigdelset(void *set, int s)
{
    if (!set || s < 1 || s > 1024)
        return -1;
    ((unsigned char *)set)[(s - 1) >> 3] &= (unsigned char)~(1u << ((s - 1) & 7));
    return 0;
}

int sigismember(const void *set, int s)
{
    if (!set || s < 1 || s > 1024)
        return -1;
    return (((const unsigned char *)set)[(s - 1) >> 3] >> ((s - 1) & 7)) & 1;
}

int pthread_cond_timedwait(void *c, void *m, const void *abstime)
{
