/* std/encoding/snappy：Snappy 块格式（Google 的快速压缩）编码与解码（零分配）。
 *
 *     import std.encoding.snappy;
 *
 *     SnappyScratch scratch = { 0 };
 *     int n = snappy_encode(src, len, out, (int)sizeof out, &scratch);
 *     int m = snappy_decode(out, n, back, (int)sizeof back);
 *
 * 块格式（不是 framed 格式，也不带校验和）：开头一个变长整数写解压后长度，
 * 后面是一串元素：
 *
 * - `00` 字面量：长度 1..60 直接编在 tag 里，更长则用 1..4 字节写「长度 - 1」；
 * - `01` 复制：长度 4..11（tag 里 3 位）+ 1 字节偏移的高 3 位 + 1 字节，偏移
 *   最大 2047；
 * - `10` 复制：长度 1..64 + 2 字节小端偏移；
 * - `11` 复制：长度 1..64 + 4 字节小端偏移。
 *
 * 复制可以重叠（`offset < length`），解码必须逐字节搬。
 *
 * 约定：
 *
 * - `snappy_encode` 的哈希表（16 KB）由调用方给，函数本身不分配；想省内存就
 *   传 `0`，那样退化成「整块字面量」——仍然是合法 Snappy 流，只是不压；
 * - `snappy_decode` 严格校验：长度前缀不符、tag 类型越界、复制越过已写出区、
 *   剩余字节不够都返回 -1；
 * - 编码结果最坏情况 `32 + n + n/6`，`snappy_max_encoded` 给这个上界；
 * - 只做块格式；framed（`sNaPpY` 魔数分帧）与 CRC-32C 校验在调用方那层。
 */
#include <string.h>

module std.encoding.snappy;
import std.core.types;

#define SNAPPY_HASH_BITS 12
#define SNAPPY_HASH_SIZE (1 << SNAPPY_HASH_BITS)

struct SnappyScratch {
    int table[SNAPPY_HASH_SIZE];
};

int snappy_max_encoded(int n)
{
    if (n < 0)
        return -1;
    return 32 + n + n / 6;
}

static int snappy_put_varint(char *out, int cap, int off, u64 v)
{
    while (v >= 0x80) {
        if (off >= cap)
            return -1;
        out[off++] = (char)((v & 0x7F) | 0x80);
        v >>= 7;
    }
    if (off >= cap)
        return -1;
    out[off++] = (char)v;
    return off;
}

static int snappy_get_varint(const u8 *p, int n, int *used, u64 *out)
{
    u64 v = 0;
    int shift = 0, i = 0;

    for (i = 0; i < 10; i++) {
        u8 b = 0;

        if (i >= n)
            return -1;
        b = p[i];
        v |= (u64)(b & 0x7F) << shift;
        shift += 7;
        if ((b & 0x80) == 0) {
            *used = i + 1;
            *out = v;
            return 1;
        }
    }
    return -1;
}

/* 写一段字面量 */
static int snappy_emit_literal(char *out, int cap, int off, const u8 *src,
                               int n)
{
    if (n <= 0)
        return off;
    if (n <= 60) {
        if (off + 1 + n > cap)
            return -1;
        out[off++] = (char)((n - 1) << 2);
    } else {
        int bytes = n <= 0x100 ? 1 : n <= 0x10000 ? 2 : n <= 0x1000000 ? 3 : 4;
        int i = 0;

        if (off + 1 + bytes + n > cap)
            return -1;
        out[off++] = (char)((59 + bytes) << 2);
        for (i = 0; i < bytes; i++)
            out[off++] = (char)(((n - 1) >> (8 * i)) & 0xFF);
    }
    memcpy(out + off, src, (size_t)n);
    return off + n;
}

/* 写一段复制（自动挑最短的 tag 形式） */
static int snappy_emit_copy(char *out, int cap, int off, int offset, int len)
{
    while (len > 0) {
        int take = len > 64 ? 64 : len;

        if (offset < 2048 && take >= 4 && take <= 11) {
            if (off + 2 > cap)
                return -1;
            out[off++] = (char)(((offset >> 8) << 5) | ((take - 4) << 2) | 1);
            out[off++] = (char)(offset & 0xFF);
        } else if (offset < 65536) {
            if (off + 3 > cap)
                return -1;
            out[off++] = (char)(((take - 1) << 2) | 2);
            out[off++] = (char)(offset & 0xFF);
            out[off++] = (char)((offset >> 8) & 0xFF);
        } else {
            if (off + 5 > cap)
                return -1;
            out[off++] = (char)(((take - 1) << 2) | 3);
            out[off++] = (char)(offset & 0xFF);
            out[off++] = (char)((offset >> 8) & 0xFF);
            out[off++] = (char)((offset >> 16) & 0xFF);
            out[off++] = (char)((offset >> 24) & 0xFF);
        }
        len -= take;
    }
    return off;
}

static u32 snappy_load32(const u8 *p)
{
    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16)
           | ((u32)p[3] << 24);
}

static u32 snappy_hash(u32 v)
{
    return (v * 0x1E35A7BDu) >> (32 - SNAPPY_HASH_BITS);
}

int snappy_encode(const void *src, int n, char *out, int cap,
                  SnappyScratch *scratch)
{
    const u8 *s = (const u8 *)src;
    int off = 0, i = 0, lit = 0;

    if (!src || !out || n < 0 || cap <= 0)
        return -1;
    off = snappy_put_varint(out, cap, 0, (u64)n);
    if (off < 0)
        return -1;
    if (scratch) {
        int k = 0;

        for (k = 0; k < SNAPPY_HASH_SIZE; k++)
            scratch->table[k] = -1;
    }
    while (i < n) {
        int matched = 0;

        if (scratch && i + 4 <= n) {
            u32 h = snappy_hash(snappy_load32(s + i));
            int cand = scratch->table[h];

            scratch->table[h] = i;
            if (cand >= 0 && i - cand < 65536 && cand + 4 <= n
                && memcmp(s + cand, s + i, 4) == 0) {
                int len = 4;

                while (i + len < n && s[cand + len] == s[i + len]
                       && len < 64)
                    len++;
                /* 先把挂起的字面量吐掉 */
                if (i > lit) {
                    off = snappy_emit_literal(out, cap, off, s + lit, i - lit);
                    if (off < 0)
                        return -1;
                }
                off = snappy_emit_copy(out, cap, off, i - cand, len);
                if (off < 0)
                    return -1;
                i += len;
                lit = i;
                matched = 1;
            }
        }
        if (!matched)
            i++;
    }
    if (i > lit) {
        off = snappy_emit_literal(out, cap, off, s + lit, i - lit);
        if (off < 0)
            return -1;
    }
    return off;
}

int snappy_decode(const void *src, int n, char *out, int cap)
{
    const u8 *p = (const u8 *)src;
    int used = 0, off = 0, i = 0;
    u64 want = 0;

    if (!src || !out || n <= 0 || cap < 0)
        return -1;
    if (snappy_get_varint(p, n, &used, &want) != 1)
        return -1;
    if (want > (u64)cap)
        return -1;
    i = used;
    while (i < n) {
        u8 tag = p[i++];
        int type = tag & 3;

        if (type == 0) {
            int len = (tag >> 2) + 1;

            if (len > 60) {
                int extra = len - 60, k = 0;
                int v = 0;

                if (i + extra > n)
                    return -1;
                for (k = 0; k < extra; k++)
                    v |= (int)p[i + k] << (8 * k);
                i += extra;
                len = v + 1;
            }
            if (i + len > n || off + len > (int)want)
                return -1;
            memcpy(out + off, p + i, (size_t)len);
            i += len;
            off += len;
            continue;
        }
        {
            int len = 0, offset = 0, k = 0;

            if (type == 1) {
                if (i >= n)
                    return -1;
                len = ((tag >> 2) & 7) + 4;
                offset = ((int)(tag >> 5) << 8) | (int)p[i];
                i += 1;
            } else if (type == 2) {
                if (i + 2 > n)
                    return -1;
                len = (tag >> 2) + 1;
                offset = (int)p[i] | ((int)p[i + 1] << 8);
                i += 2;
            } else {
                if (i + 4 > n)
                    return -1;
                len = (tag >> 2) + 1;
                offset = (int)p[i] | ((int)p[i + 1] << 8)
                         | ((int)p[i + 2] << 16);
                i += 4;
            }
            if (offset <= 0 || offset > off || off + len > (int)want)
                return -1;
            for (k = 0; k < len; k++) {
                out[off] = out[off - offset];
                off++;
            }
        }
    }
    if ((u64)off != want)
        return -1;
    return off;
}

/* ---- 自测 ---- */

test "Snappy：往返与最坏情况上界" {
    static const char *text =
        "the quick brown fox jumps over the lazy dog; "
        "the quick brown fox jumps over the lazy dog; "
        "the quick brown fox jumps over the lazy dog";
    char enc[512] = { 0 };
    char dec[512] = { 0 };
    SnappyScratch scratch = { 0 };
    int n = (int)strlen(text), e = 0, d = 0;
    char lit[64] = { 0 };

    if (snappy_max_encoded(0) != 32 || snappy_max_encoded(60) != 102)
        return err(1, "上界公式不对");
    e = snappy_encode(text, n, enc, (int)sizeof enc, &scratch);
    if (e <= 0)
        return err(2, "编码失败");
    if (e >= n)
        return err(3, "重复文本应该能压");
    d = snappy_decode(enc, e, dec, (int)sizeof dec);
    if (d != n || memcmp(dec, text, (size_t)n) != 0)
        return err(4, "往返不一致");
    /* 不给哈希表：整块字面量，仍然合法 */
    e = snappy_encode(text, n, enc, (int)sizeof enc, 0);
    if (e <= 0)
        return err(5, "字面量编码失败");
    d = snappy_decode(enc, e, dec, (int)sizeof dec);
    if (d != n || memcmp(dec, text, (size_t)n) != 0)
        return err(6, "字面量往返不一致");
    if (e < n)
        return err(7, "字面量模式不该比原文短");
    /* 长短不一的输入都往返一次（含空与单字节） */
    {
        int sizes[5] = { 0, 1, 2, 3, 60 };
        int k = 0;

        for (k = 0; k < 5; k++) {
            int len = sizes[k], j = 0;

            for (j = 0; j < len; j++)
                lit[j] = (char)(j % 7);
            e = snappy_encode(lit, len, enc, (int)sizeof enc, &scratch);
            if (e <= 0)
                return err(8, "小输入编码失败");
            d = snappy_decode(enc, e, dec, (int)sizeof dec);
            if (d != len || (len > 0 && memcmp(dec, lit, (size_t)len) != 0))
                return err(9, "小输入往返不一致");
        }
    }
    /* 重叠复制：offset=1、长度 10 的 `10` 与 3 字节字面量 */
    {
        static char stream[16] = { (char)13, (char)((3 - 1) << 2), 'a', 'b', 'c',
                                   (char)(((10 - 4) << 2) | 1), 1 };
        char o[16] = { 0 };

        if (snappy_decode(stream, 7, o, (int)sizeof o) != 13)
            return err(10, "重叠复制长度不对");
        if (memcmp(o, "abccccccccccc", 13) != 0)
            return err(11, "重叠复制字节不对");
    }
}

test "Snappy：截断、越界与坏流" {
    static const char *text = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    char enc[128] = { 0 };
    char dec[128] = { 0 };
    SnappyScratch scratch = { 0 };
    int e = 0;

    e = snappy_encode(text, 32, enc, (int)sizeof enc, &scratch);
    if (e <= 0)
        return err(13, "编码失败");
    /* 每一个前缀截断都必须 -1 或给出正确结果，不能越界写 */
    {
        int k = 0;

        for (k = 0; k < e; k++) {
            int r = snappy_decode(enc, k, dec, (int)sizeof dec);

            if (k == 0 && r != -1)
                return err(14, "空输入应该 -1");
            if (r >= 0 && r != 32)
                return err(15, "截断却给出了别的长度");
        }
    }
    /* 解压长度超出缓冲 */
    if (snappy_decode(enc, e, dec, 8) != -1)
        return err(16, "目标缓冲不够应该 -1");
    /* 长度前缀与内容不符 */
    enc[e - 1] = 0;
    if (snappy_decode(enc, e - 1, dec, (int)sizeof dec) != -1)
        return err(17, "内容被截应该 -1");
    /* 复制偏移为 0 */
    {
        static char bad[8] = { 4, (char)(((4 - 1) << 2) | 2), 0, 0 };
        char o[8] = { 0 };

        if (snappy_decode(bad, 4, o, (int)sizeof o) != -1)
            return err(18, "偏移 0 应该 -1");
    }
    /* 空指针 */
    if (snappy_encode(0, 4, dec, 8, 0) != -1
        || snappy_decode(0, 4, dec, 8) != -1
        || snappy_encode(text, -1, dec, 8, 0) != -1)
        return err(19, "空指针/负长度应该 -1");
}
