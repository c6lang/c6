/* std/core/polygon：简单多边形（面积/周长/凸性/点内判断/形心/边游标）。
 *
 *     import std.core.polygon;
 *
 *     PolyPt pts[4] = { { 0, 0 }, { 4, 0 }, { 4, 4 }, { 0, 4 } };
 *     PolyPt buf[4] = { { 0, 0 } };
 *     Poly p = { 0 };
 *     p.init(pts, 4, buf);            // 方法：init / area / perimeter / contains
 *     p.area();                        // 16
 *     p.signed_area();                 // +16（逆时针为正）
 *     p.contains(2, 2);                // 1
 *
 * 顶点点列可以是顺时针也可以是逆时针（`signed_area` 的符号会告诉你），首尾**不要**
 * 重复（重复了 `init` 会帮你去掉）。多边形不要求凸，但要求**简单**（边不自交）。
 *
 * 约定：
 *
 * - `p.init(pts, n, buf)`：`buf` 是 `n` 个 `PolyPt`（内部拷贝），返回顶点数；
 *   顶点不足 3 个或参数错返回 -1；
 * - `p.count()` 顶点数，`p.at(i, &x, &y)` 取第 i 个顶点，`p.edge(i, &x1,&y1,&x2,&y2)`
 *   取第 i 条边（游标式：`i` 从 0 到 `count()-1`，最后一条接回首点）；
 * - `p.signed_area()` 有向面积（逆时针正、顺指针负），`p.area()` 绝对值，
 *   `p.perimeter()` 周长，`p.is_clockwise()`；
 * - `p.is_convex()` 是否凸（严格：共线顶点算不凸），`p.contains(x, y)` 射线法判断点
 *   是否在内部或边界上；
 * - `p.centroid(&cx, &cy)` 面积加权形心（退化多边形按顶点平均），`p.bbox(...)` 包围盒；
 * - 需要 `-lm`（`Makefile` 的 `std-*` 目标已经带上）。
 */
#include <math.h>
#include <string.h>

module std.core.polygon;
import std.core.types;
import std.text.str;

struct PolyPt {
    double x;
    double y;
};

struct Poly {
    PolyPt *pts;
    int n;
};

static double pg_cross(PolyPt a, PolyPt b, PolyPt c)
{
    return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
}

int init(Poly *p, const PolyPt *pts, int n, void *buf)
{
    int i = 0, m = n;

    if (!p || !pts || n < 3 || !buf)
        return -1;
    /* 去掉重复的首尾点 */
    if (pts[0].x == pts[n - 1].x && pts[0].y == pts[n - 1].y)
        m = n - 1;
    if (m < 3)
        return -1;
    memset(buf, 0, sizeof(PolyPt) * (size_t)n);
    memcpy(buf, pts, sizeof(PolyPt) * (size_t)m);
    p->pts = (PolyPt *)buf;
    p->n = m;
    return m;
}

int count(Poly *p)
{
    return p ? p->n : 0;
}

int at(Poly *p, int i, double *x, double *y)
{
    if (!p || !p->pts || i < 0 || i >= p->n)
        return 0;
    if (x)
        *x = p->pts[i].x;
    if (y)
        *y = p->pts[i].y;
    return 1;
}

int edge(Poly *p, int i, double *x1, double *y1, double *x2, double *y2)
{
    int j = 0;

    if (!p || !p->pts || i < 0 || i >= p->n)
        return 0;
    j = (i + 1) % p->n;
    if (x1)
        *x1 = p->pts[i].x;
    if (y1)
        *y1 = p->pts[i].y;
    if (x2)
        *x2 = p->pts[j].x;
    if (y2)
        *y2 = p->pts[j].y;
    return 1;
}

double signed_area(Poly *p)
{
    double s = 0.0;
    int i = 0;

    if (!p || !p->pts || p->n < 3)
        return 0.0;
    for (i = 0; i < p->n; i++) {
        int j = (i + 1) % p->n;

        s += p->pts[i].x * p->pts[j].y - p->pts[j].x * p->pts[i].y;
    }
    return 0.5 * s;
}

double area(Poly *p)
{
    double s = signed_area(p);

    return s < 0.0 ? -s : s;
}

int is_clockwise(Poly *p)
{
    return signed_area(p) < 0.0 ? 1 : 0;
}

double perimeter(Poly *p)
{
    double s = 0.0;
    int i = 0;

    if (!p || !p->pts || p->n < 2)
        return 0.0;
    for (i = 0; i < p->n; i++) {
        int j = (i + 1) % p->n;
        double dx = p->pts[j].x - p->pts[i].x;
        double dy = p->pts[j].y - p->pts[i].y;

        s += sqrt(dx * dx + dy * dy);
    }
    return s;
}

int is_convex(Poly *p)
{
    int sign = 0, i = 0;

    if (!p || !p->pts || p->n < 3)
        return 0;
    for (i = 0; i < p->n; i++) {
        double c = pg_cross(p->pts[i], p->pts[(i + 1) % p->n],
                            p->pts[(i + 2) % p->n]);

        if (fabs(c) < 1e-12)
            return 0;                   /* 共线：按不凸处理 */
        if (sign == 0)
            sign = c > 0.0 ? 1 : -1;
        else if ((c > 0.0 ? 1 : -1) != sign)
            return 0;
    }
    return 1;
}

int contains(Poly *p, double x, double y)
{
    int inside = 0, i = 0;

    if (!p || !p->pts || p->n < 3)
        return 0;
    for (i = 0; i < p->n; i++) {
        PolyPt a = p->pts[i];
        PolyPt b = p->pts[(i + 1) % p->n];

        /* 边界上也算包含 */
        if (fabs(pg_cross(a, b, (PolyPt){ x, y })) < 1e-12
            && x >= fmin(a.x, b.x) - 1e-12 && x <= fmax(a.x, b.x) + 1e-12
            && y >= fmin(a.y, b.y) - 1e-12 && y <= fmax(a.y, b.y) + 1e-12)
            return 1;
        if ((a.y > y) != (b.y > y)) {
            double xt = a.x + (y - a.y) * (b.x - a.x) / (b.y - a.y);

            if (x < xt)
                inside = !inside;
        }
    }
    return inside;
}

int centroid(Poly *p, double *cx, double *cy)
{
    double a = 0.0, sx = 0.0, sy = 0.0, mx = 0.0, my = 0.0;
    int i = 0;

    if (!p || !p->pts || p->n < 3 || !cx || !cy)
        return -1;
    for (i = 0; i < p->n; i++) {
        int j = (i + 1) % p->n;
        double cr = p->pts[i].x * p->pts[j].y - p->pts[j].x * p->pts[i].y;

        a += cr;
        sx += (p->pts[i].x + p->pts[j].x) * cr;
        sy += (p->pts[i].y + p->pts[j].y) * cr;
    }
    a *= 0.5;
    if (fabs(a) < 1e-12) {
        /* 退化：按顶点平均 */
        for (i = 0; i < p->n; i++) {
            mx += p->pts[i].x;
            my += p->pts[i].y;
        }
        *cx = mx / (double)p->n;
        *cy = my / (double)p->n;
        return 1;
    }
    *cx = sx / (6.0 * a);
    *cy = sy / (6.0 * a);
    return 1;
}

int bbox(Poly *p, double *minx, double *miny, double *maxx, double *maxy)
{
    int i = 0;

    if (!p || !p->pts || p->n <= 0)
        return -1;
    if (minx)
        *minx = p->pts[0].x;
    if (maxx)
        *maxx = p->pts[0].x;
    if (miny)
        *miny = p->pts[0].y;
    if (maxy)
        *maxy = p->pts[0].y;
    for (i = 1; i < p->n; i++) {
        if (minx && p->pts[i].x < *minx)
            *minx = p->pts[i].x;
        if (maxx && p->pts[i].x > *maxx)
            *maxx = p->pts[i].x;
        if (miny && p->pts[i].y < *miny)
            *miny = p->pts[i].y;
        if (maxy && p->pts[i].y > *maxy)
            *maxy = p->pts[i].y;
    }
    return 1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "polygon：正方形与边游标" {
    PolyPt pts[4] = { { 0, 0 }, { 4, 0 }, { 4, 4 }, { 0, 4 } };
    PolyPt buf[4] = { { 0, 0 } };
    Poly p = { 0 };
    double x = 0.0, y = 0.0, cx = 0.0, cy = 0.0;
    double x1 = 0.0, y1 = 0.0, x2 = 0.0, y2 = 0.0;

    if (p.init(pts, 4, buf) != 4)
        return err(1, "init 失败");
    if (p.count() != 4)
        return err(2, "顶点数不对");
    if (fabs(p.area() - 16.0) > 1e-9 || fabs(p.signed_area() - 16.0) > 1e-9)
        return err(3, "面积应该是 16（逆时针为正）");
    if (p.is_clockwise() != 0)
        return err(4, "这组点应该是逆时针");
    if (fabs(p.perimeter() - 16.0) > 1e-9)
        return err(5, "周长应该是 16");
    if (p.is_convex() != 1)
        return err(6, "正方形是凸的");
    if (p.contains(2, 2) != 1 || p.contains(0, 2) != 1 || p.contains(5, 2) != 0)
        return err(7, "点内判断不对");
    if (p.centroid(&cx, &cy) != 1 || fabs(cx - 2.0) > 1e-12
        || fabs(cy - 2.0) > 1e-12)
        return err(8, "形心应该是 (2,2)");
    if (p.edge(0, &x1, &y1, &x2, &y2) != 1 || x1 != 0.0 || y1 != 0.0
        || x2 != 4.0 || y2 != 0.0)
        return err(9, "第 0 条边应该是 (0,0)-(4,0)");
    if (p.edge(3, &x1, &y1, &x2, &y2) != 1 || x1 != 0.0 || y1 != 4.0
        || x2 != 0.0 || y2 != 0.0)
        return err(10, "最后一条边应该接回首点");
    if (p.at(9, &x, &y) != 0 || p.edge(9, &x1, &y1, &x2, &y2) != 0)
        return err(11, "越界应该 0");
}

test "polygon：凹多边形、顺时针与包围盒" {
    /* 凹的 L 形（逆时针）：(0,0) (4,0) (4,2) (2,2) (2,4) (0,4) */
    PolyPt pts[6] = { { 0, 0 }, { 4, 0 }, { 4, 2 }, { 2, 2 }, { 2, 4 },
                      { 0, 4 } };
    PolyPt buf[6] = { { 0, 0 } };
    Poly p = { 0 };
    double cx = 0.0, cy = 0.0;
    double minx = 0.0, miny = 0.0, maxx = 0.0, maxy = 0.0;

    if (p.init(pts, 6, buf) != 6)
        return err(12, "L 形 init 失败");
    if (fabs(p.area() - 12.0) > 1e-9)
        return err(13, "L 形面积 4*2 + 2*2 = 12");
    if (p.is_convex() != 0)
        return err(14, "L 形不凸");
    if (p.contains(1, 1) != 1 || p.contains(3, 3) != 0)
        return err(15, "凹口外的点不该包含");
    if (p.contains(15, 1) != 0 || p.contains(-1, -1) != 0)
        return err(16, "外面的点不该包含");
    p.centroid(&cx, &cy);
    if (cx <= 0.0 || cx >= 4.0 || cy <= 0.0 || cy >= 4.0)
        return err(17, "形心应该落在包围盒里");
    if (p.bbox(&minx, &miny, &maxx, &maxy) != 1 || minx != 0.0 || maxx != 4.0
        || miny != 0.0 || maxy != 4.0)
        return err(18, "包围盒不对");
    /* 顺时针写法：面积变负，is_clockwise 为 1 */
    {
        PolyPt cw[4] = { { 0, 0 }, { 0, 4 }, { 4, 4 }, { 4, 0 } };
        PolyPt cbuf[4] = { { 0, 0 } };
        Poly q = { 0 };

        if (q.init(cw, 4, cbuf) != 4)
            return err(19, "顺时针 init 失败");
        if (q.signed_area() >= 0.0 || q.is_clockwise() != 1)
            return err(20, "顺时针的有向面积应该为负");
        if (fabs(q.area() - 16.0) > 1e-9)
            return err(21, "绝对面积还是 16");
    }
    /* 首尾重复会被去掉 */
    {
        PolyPt dup[5] = { { 0, 0 }, { 4, 0 }, { 4, 4 }, { 0, 4 }, { 0, 0 } };
        PolyPt dbuf[5] = { { 0, 0 } };
        Poly q = { 0 };

        if (q.init(dup, 5, dbuf) != 4)
            return err(22, "重复首尾应该去掉");
        if (fabs(q.area() - 16.0) > 1e-9)
            return err(23, "去重后面积仍是 16");
    }
    if (p.init(pts, 2, buf) != -1)
        return err(24, "顶点不足 3 个应该 -1");
}
