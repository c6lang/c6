From 261f9fc7ff7c77ddc0e95513e0b9d64edf9ba5f2 Mon Sep 17 00:00:00 2001
From: c6 <c6@localhost>
Date: Sat, 7 Nov 2026 06:19:57 +0800
Subject: [PATCH] c6: tuples '(T1, T2, ...)' for returning several values

A tuple is a fixed-layout value type written as a parenthesized type
list:

    (int, int) divmod(int a, int b) { return {a / b, a % b}; }
    (int q, int r) = divmod(17, 5);     -- destructuring declaration
    (a, b) = divmod(100, 7);            -- destructuring assignment
    (int high, _) = divmod(100, 7);     -- '_' discards the element
    (int, int) t = {1, 2};  t[0]        -- constant index access

No new keyword: parse_btype() speculates on '(' by replaying the already
recorded group as a token stream (c6_tuple_speculate: begin_macro() +
next() + parse_btype()/type_decl(), nothing diagnosed) and rolls back
when it is not a type list, so '(void)printf(...)', '(int)x', '(T)(x)',
'(struct S){...}', '({...})' and the comma expression '(a, b)' keep
their old meaning.  A tuple is a VT_STRUCT with one internal tag per
element-type list, so argument passing, return values, sizeof, struct
members, array elements, typedefs and '!error' all reuse existing paths
-- not a single new symbol in libtcc1.c.  The equivalent struct is the
same ABI (tests/abi/tuple.c + tests/abi/tuple_plain.c compile the two
spellings in two translation units and call each other).

The layout is computed when the type is built ('off = (off + align - 1)
& -align' over the elements, the tag gets the max alignment) and never
reads pack_stack_ptr, so '#pragma pack' cannot make two translation
units disagree about the ABI -- the same rule slices follow.

The internal tag is named ('__c6_tuple_N') and the signature serializer
spells a tuple back as '(T1, T2)' instead of the tag name: async/go
trampolines replay a signature into a synthetic token stream, and
replaying the tag would declare a fresh struct with sym_scope = 1 that
is not compatible with the tuple.

Destructuring is statement-only.  c6_tuple_lead_kind() replays the group
and classifies it as expression / type / pattern / assignment, then
c6_tuple_destructure() spills the value into a hidden local and emits
one ordinary assignment per element, so targets may be any lvalue
(variable, array element, '->'/'.' member).  '_' creates no symbol and
generates no load; it stays an ordinary identifier everywhere else
('int _ = 5;' and '(int, int) _ = f();' still work), and a pattern that
discards every element is rejected.

'!error' now accepts struct, union and tuple return types: failure is
decided by the error slot only, and C15 forces every 'T!error' value to
be consumed by 'try'/'catch', so the failure-path value is never
observable and is simply zeroed (memset) instead of being forced to
represent a '-1' sentinel.  float/double still cannot be annotated.

'n' consecutive '_' placeholders reuse the foreach convention (no
symbol, no store), which is why the two features agree on what a bare
'_' means.
---
 tccgen.c | 865 +++++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 834 insertions(+), 31 deletions(-)

diff --git a/tccgen.c b/tccgen.c
index cce627c..40d41a8 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -204,6 +204,57 @@ static C6Slice *c6_slice_of_type(CType *type)
             return sl;
     return NULL;
 }
+/* '(T1, T2, ...)' tuples: one internal struct per element-type list, with a
+   fixed natural layout (offsets are computed when the type is built, so
+   '#pragma pack' cannot change it).  The layout is the ABI shared by the
+   whole translation unit and by other translation units, so it must not
+   depend on where the type happens to be written.  The tag is *named*
+   ('__c6_tuple_N'): the async/go signature serializer spells types back into
+   source tokens, so a named tag makes a tuple reusable there with no special
+   case at all.  Tuples live as long as the unit, hence the global stack. */
+typedef struct C6Tuple {
+    int n;                /* element count (>= 2) */
+    CType *elem;          /* element types, top level qualifiers dropped */
+    int *off;             /* element offsets in the internal struct */
+    Sym *tag;             /* the internal struct tag */
+    struct C6Tuple *next;
+} C6Tuple;
+static C6Tuple *c6_tuples;
+/* set when a tuple type specifier consumed the ')' of its own group, so the
+   cast path in unary() knows not to expect a second one */
+static int c6_tuple_ate_paren;
+static int c6_tuple_seq;
+static int c6_tuple_tmp_seq;
+static C6Tuple *c6_tuple_of_type(CType *type);
+static CType c6_tuple_ctype(C6Tuple *tp);
+static C6Tuple *c6_tuple_get(CType *elems, int n);
+static int c6_tuple_btype(CType *type);
+static int c6_tuple_subscript(void);
+static int c6_tuple_lead_kind(void);
+
+/* the tuple whose tag is TYPE's tag, or NULL */
+static C6Tuple *c6_tuple_of_type(CType *type)
+{
+    C6Tuple *tp;
+    if (!tcc_state->c6_ext)
+        return NULL;
+    if ((type->t & VT_BTYPE) != VT_STRUCT || !type->ref)
+        return NULL;
+    for (tp = c6_tuples; tp; tp = tp->next)
+        if (tp->tag == type->ref)
+            return tp;
+    return NULL;
+}
+
+/* the value type of tuple TP */
+static CType c6_tuple_ctype(C6Tuple *tp)
+{
+    CType t;
+    t.t = VT_STRUCT;
+    t.ref = tp->tag;
+    return t;
+}
+
