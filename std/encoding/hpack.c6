/* std/encoding/hpack：HTTP/2 的 HPACK 头压缩（RFC 7541）——静态表、动态表、
 * 整数、字符串与 Huffman，零分配。
 *
 *     import std.encoding.hpack;
 *
 *     Hpack h = { 0 };
 *     char tbuf[4096] = { 0 };           // 动态表字节区
 *     char arena[1024] = { 0 };          // Huffman 解出来的字符串落地
 *     hpack_init(&h, tbuf, (int)sizeof tbuf, 4096, arena, (int)sizeof arena);
 *
 *     HpackField f[1] = { 0 };
 *     f[0].name = (Str){ S(":method") };
 *     f[0].value = (Str){ S("GET") };
 *     char blk[256] = { 0 };
 *     int n = hpack_put_block(&h, f, 1, blk, (int)sizeof blk);   // 0x82
 *
 *     HpackField out[16] = { 0 };
 *     int k = 0;
 *     hpack_decode_block(&h, blk, n, out, 16, &k);
 *
 * 头块的两个方向都在这一个模块里：发的一方把 `HpackField` 数组压成字节
 * （`hpack_put_block`），收的一方把字节解成 `HpackField` 数组并**同步维护动态表**
 * （`hpack_decode_block`）。`std.net.http2` / `http2c` / `http2d` 直接用这一层，
 * 不需要自己关心 HPACK 的位级格式。
 *
 * 约定：
 *
 * - **编码侧不往动态表里插条目**：只引用静态表和「对端插进来、我们镜像着」的动态表
 *   项（全匹配就走索引，否则逐字面量）。所以同一个 `Hpack` 可以同时收发两个方向，
 *   编码不会打乱解码镜像，代价是重复的长值（cookie 之类）不会越压越小；
 * - `authorization` / `cookie` / `set-cookie` / `proxy-authorization` 自动用
 *   never-indexed 编码（不让中间代理把它们塞进动态表）；
 * - 头字段名按 HTTP/2 要求自动转小写；超过 `HPACK_NAME_MAX` 的名字拒绝；
 * - `Huffman` 只在编码后更短时用；解码按 RFC 的**规范码**查表（码长 1..30），
 *   结尾的填充必须是全 1 且不足 8 位，EOS 出现在数据里算格式错；
 * - 头字段的 `Str` 是视图，分三种来源：明文串指向输入头块，Huffman 串指向
 *   `arena`，动态表项指向动态表字节区。**表里的视图会在下次解码/插入时失效**；
 *   本模块在把表里的名字/值交出去之前会先拷进 `arena`，所以出参视图只受
 *   「下次 `hpack_decode_block` 调用」影响；
 * - `arena` 只在下一次 `hpack_decode_block` 开头重置；容量不够返回 -1（`why()` 解释），
 *   不会截断；
 * - 动态表上限 `max_size` 不能超过表字节区容量（`hpack_init` 会按容量收窄）；
 *   对端发来的 table size update 立即生效并淘汰条目。
 */
#include <string.h>

module std.encoding.hpack;
import std.core.types;
import std.text.str;

/* 字面量 -> 视图（宏不随 import 传递，每个模块自己定义一次） */
#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

#define HPACK_STATIC_N 61
#define HPACK_ENT_MAX 128       /* 4096 字节的表塞满 33 字节的条目也放得下 */
#define HPACK_NAME_MAX 256
#define HPACK_HUFF_MAXLEN 30
#define HPACK_HUFF_N 257        /* 0..255 是字节，256 是 EOS */

enum Error {
    OK = 0,
    INVAL = 1,      /* 参数不合法 */
    BLOCK = 2,      /* 头块格式错 */
    HUFF = 3,       /* Huffman 数据非法 */
    SPACE = 4,      /* 调用方缓冲不够 */
    INDEX = 5,      /* 索引越界 / 0 号索引 */
};

/* 编码策略：能索引就索引（只查表）/ 逐字面量不插表 / never-indexed */
enum Policy {
    HPACK_AUTO = 0,
    HPACK_NO_INDEX = 1,
    HPACK_NEVER = 2,
};

struct HpackField {
    Str name;
    Str value;
};

struct HpackEnt {
    int off;            /* 在动态表字节区里的起点 */
    int nl;
    int vl;
    int size;           /* nl + vl + 32 */
};

struct Hpack {
    char *buf;          /* 动态表字节区（调用方给） */
    int cap;
    int used;           /* 已用字节（含还没回收的淘汰区） */
    int head;           /* ent 环里最老条目 */
    int nent;
    HpackEnt ent[HPACK_ENT_MAX];
    int size;           /* 当前动态表尺寸（RFC 7230 那套算法） */
    int max_size;
    char *arena;        /* Huffman 解出来的字符串落地 */
    int acap;
    int aused;
    int err;
    const char *why;
};

/* ---- 以下四张表与下面的 Huffman 码表由参考实现生成后写死 ---- */


