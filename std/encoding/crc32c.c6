/* std/encoding/crc32c：CRC-32C（Castagnoli，多项式 0x1EDC6F41）。
 *
 *     import std.encoding.crc32c;
 *
 *     u32 c = crc32c("123456789", 9);      // 0xE3069283
 *
 *     分段算：初值 0xFFFFFFFF，最后再取反
 *     u32 r = 0xFFFFFFFF;
 *     r = crc32c_update(r, "1234", 4);
 *     r = crc32c_update(r, "56789", 5);
 *     c = r ^ 0xFFFFFFFF;
 *
 * 约定：
 *
 * - `crc32c` 一次算完（内部已经处理初值与末取反），空数据返回 0；
 * - `crc32c_update` 是裸寄存器接口：调用方自己给初值 `0xFFFFFFFF`、自己末取反，
 *   这样才能和 `crc32c` 对上；
 * - 表在第一次调用时惰性生成（256 项，静态），线程安全靠调用方保证——多线程
 *   首次并发调用前请先热一下（`crc32c("", 0)`）；
 * - 和 CRC-32（zlib 的 0x04C11DB7）不是一个东西，别混用。
 */
#include <string.h>

module std.encoding.crc32c;
import std.core.types;
import std.text.str;

static u32 crc32c_tab[256] = { 0 };
static int crc32c_ready = 0;

#define CRC32C_POLY 0x82F63B78u        /* 0x1EDC6F41 的反射 */

static void crc32c_init(void)
{
    u32 i = 0;

    if (crc32c_ready)
        return;
    for (i = 0; i < 256; i++) {
        u32 c = i;
        int k = 0;

        for (k = 0; k < 8; k++)
            c = (c & 1) ? (c >> 1) ^ CRC32C_POLY : c >> 1;
        crc32c_tab[i] = c;
    }
    crc32c_ready = 1;
}

u32 crc32c_update(u32 crc, const void *src, int n)
{
    const u8 *p = (const u8 *)src;
    int i = 0;

    crc32c_init();
    if (!src || n <= 0)
        return crc;
    for (i = 0; i < n; i++)
        crc = crc32c_tab[(crc ^ p[i]) & 0xFF] ^ (crc >> 8);
    return crc;
}

u32 crc32c(const void *src, int n)
{
    if (n <= 0 || !src)
        return 0;
    return crc32c_update(0xFFFFFFFFu, src, n) ^ 0xFFFFFFFFu;
}

u32 crc32c_str(Str s)
{
    return crc32c(s.s.data, s.s.len);
}

/* ---- 自测 ---- */

test "crc32c：标准向量与分段一致" {
    u32 c = 0, r = 0;

    if (crc32c("123456789", 9) != 0xE3069283u)
        return err(1, "标准向量不对");
    if (crc32c("", 0) != 0)
        return err(2, "空数据应该 0");
    if (crc32c(0, 5) != 0)
        return err(3, "空指针应该 0");
    if (crc32c_str((Str){ S("123456789") }) != 0xE3069283u)
        return err(4, "Str 版不对");
    /* 分段 */
    r = 0xFFFFFFFFu;
    r = crc32c_update(r, "1234", 4);
    r = crc32c_update(r, "56789", 5);
    c = r ^ 0xFFFFFFFFu;
    if (c != 0xE3069283u)
        return err(5, "分段结果不对");
    /* 单字节 0x00 的 CRC32C 是 0x527D5351 */
    {
        u8 z = 0;

        if (crc32c(&z, 1) != 0x527D5351u)
            return err(6, "单字节 0x00 不对");
    }
    /* update 传 0 长度时原样返回 */
    if (crc32c_update(0x1234, 0, 10) != 0x1234)
        return err(7, "空指针 update 应该原样返回");
}

test "crc32c：翻一位就变、长数据稳定" {
    char buf[1024] = { 0 };
    u32 a = 0, b = 0;
    int i = 0;

    for (i = 0; i < 1024; i++)
        buf[i] = (char)(i & 0xFF);
    a = crc32c(buf, 1024);
    b = crc32c(buf, 1024);
    if (a != b)
        return err(8, "同样输入该得到同样结果");
    buf[500] = (char)(buf[500] ^ 1);
    if (crc32c(buf, 1024) == a)
        return err(9, "翻一位应该改变结果");
    /* 全零 1024 字节 */
    memset(buf, 0, sizeof buf);
    if (crc32c(buf, 1024) == 0)
        return err(10, "全零数据不该是 0");
    /* 前后缀拼接：crc(prefix+suffix) 不等于两者相减，只验证长度影响结果 */
    if (crc32c(buf, 1023) == crc32c(buf, 1024))
        return err(11, "不同长度结果不该相同");
}
