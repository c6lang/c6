/* std/os/duration：时长字符串的解析与格式化（毫秒为单位）。
 *
 *     import std.os.duration;
 *
 *     int ok = 0;
 *     long long ms = dur_parse(S("1h30m"), &ok);        // 5400000
 *     char out[32] = { 0 };
 *     dur_format(5400000, out, (int)sizeof out);        // "1h30m"
 *
 * 解析规则：
 *
 * - 单位：`d` 天、`h` 小时、`m` 分钟、`s` 秒、`ms` 毫秒，可连写（`1h30m`）、
 *   中间允许空格；没有单位的纯数字按**秒**算；
 * - 数字支持小数（`1.5h`、`0.25s`），结果四舍五入到毫秒；
 * - 负数前缀 `-` 表示负时长；
 * - `dur_parse_clock` 认 `H:MM:SS` / `M:SS` 这种冒号写法（也允许 `1:30` 当 1 分 30 秒，
 *   与 `date`/`ffmpeg` 的习惯一致）。
 *
 * 约定：
 *
 * - 解析失败时 `*ok` 置 0 并返回 0；成功时 `*ok` 置 1；
 * - `dur_format` 只输出最大的两个非零单位（`1h30m`、`2m5s`、`500ms`），
 *   四舍五入到毫秒；
 * - 不处理年月（月长不定），也不做本地化。
 */
#include <string.h>

module std.os.duration;
import std.core.types;
import std.text.str;

static i64 dur_unit_ms(const char *p, int n)
{
    if (n == 2 && p[0] == 'm' && p[1] == 's')
        return 1;
    if (n == 1 && p[0] == 's')
        return 1000;
    if (n == 1 && p[0] == 'm')
        return 60 * 1000;
    if (n == 1 && p[0] == 'h')
        return 60 * 60 * 1000;
    if (n == 1 && p[0] == 'd')
        return 24 * 60 * 60 * 1000;
    return -1;
}

i64 dur_parse(char[:] src, int *ok)
{
    const char *p = src.data;
    int n = src.len, i = 0, any = 0, neg = 0;
    i64 total = 0;

    if (ok)
        *ok = 0;
    if (!src.data || n <= 0)
        return 0;
    if (p[0] == '-') {
        neg = 1;
        i = 1;
    }
    while (i < n) {
        i64 whole = 0;
        double frac = 0, scale = 0.1;
        int digits = 0, has_dot = 0;
        int unit_start = 0;
        i64 unit = 0;

        while (i < n && (p[i] == ' ' || p[i] == '\t'))
            i++;
        if (i >= n)
            break;
        while (i < n && p[i] >= '0' && p[i] <= '9') {
            whole = whole * 10 + (p[i] - '0');
            digits++;
            i++;
            if (whole > 1000000000000LL)
                return 0;
        }
        if (i < n && p[i] == '.') {
            has_dot = 1;
            i++;
            while (i < n && p[i] >= '0' && p[i] <= '9') {
                frac += (p[i] - '0') * scale;
                scale /= 10;
                digits++;
                i++;
            }
        }
        if (!digits)
            return 0;
        unit_start = i;
        while (i < n && p[i] >= 'a' && p[i] <= 'z')
            i++;
        unit = unit_start == i ? 1000 : dur_unit_ms(p + unit_start, i - unit_start);
        if (unit < 0)
            return 0;
        total += whole * unit;
        if (has_dot)
            total += (i64)(frac * (double)unit + 0.5);
        any = 1;
        while (i < n && (p[i] == ' ' || p[i] == '\t'))
            i++;
        if (i < n && p[i] != '-' && (p[i] < '0' || p[i] > '9'))
            return 0;
    }
    if (!any)
        return 0;
    if (ok)
        *ok = 1;
    return neg ? -total : total;
}

i64 dur_parse_clock(char[:] src, int *ok)
{
    const char *p = src.data;
    int n = src.len, i = 0, fields = 0;
    i64 parts[3] = { 0, 0, 0 };
    int neg = 0;

    if (ok)
        *ok = 0;
    if (!src.data || n <= 0)
        return 0;
    if (p[0] == '-') {
        neg = 1;
        i = 1;
    }
    while (i < n) {
        i64 v = 0;
        int digits = 0;

        while (i < n && p[i] >= '0' && p[i] <= '9') {
            v = v * 10 + (p[i] - '0');
            digits++;
            i++;
        }
        if (!digits || fields > 2)
            return 0;
        parts[fields++] = v;
        if (i < n) {
            if (p[i] != ':')
                return 0;
            i++;
        }
    }
    if (fields == 0)
        return 0;
    if (ok)
        *ok = 1;
    if (fields == 1)
        return (neg ? -1 : 1) * parts[0] * 1000;
    if (fields == 2)
        return (neg ? -1 : 1) * (parts[0] * 60000 + parts[1] * 1000);
    return (neg ? -1 : 1) * (parts[0] * 3600000 + parts[1] * 60000
                             + parts[2] * 1000);
}

static int dur_put(char *dst, int cap, int o, const char *s)
{
    int i = 0;

    for (i = 0; s[i]; i++) {
        if (o + 1 > cap)
            return -1;
        dst[o++] = s[i];
    }
    return o;
}

static int dur_putnum(char *dst, int cap, int o, i64 v)
{
    char buf[24] = { 0 };
    int k = 0, i = 0;

    if (v == 0) {
        buf[0] = '0';
        k = 1;
    }
    while (v > 0 && k < 22) {
        buf[k++] = (char)('0' + (int)(v % 10));
        v /= 10;
    }
    for (i = k - 1; i >= 0; i--) {
        if (o + 1 > cap)
            return -1;
        dst[o++] = buf[i];
    }
    return o;
}

int dur_format(i64 ms, char *dst, int cap)
{
    i64 v = ms < 0 ? -ms : ms;
    i64 unit[4] = { 86400000, 3600000, 60000, 1000 };
    const char *suffix[4] = { "d", "h", "m", "s" };
    int printed = 0, o = 0, i = 0;

    if (!dst || cap <= 0)
        return -1;
    if (ms < 0) {
        o = dur_put(dst, cap, o, "-");
        if (o < 0)
            return -1;
    }
    for (i = 0; i < 4 && printed < 2; i++) {
        if (v >= unit[i]) {
            i64 q = v / unit[i];

            o = dur_putnum(dst, cap, o, q);
            if (o < 0)
                return -1;
            o = dur_put(dst, cap, o, suffix[i]);
            if (o < 0)
                return -1;
            v -= q * unit[i];
            printed++;
        }
    }
    if (printed == 0) {
        o = dur_putnum(dst, cap, o, v);
        if (o < 0)
            return -1;
        o = dur_put(dst, cap, o, "ms");
        if (o < 0)
            return -1;
    }
    if (o < cap)
        dst[o] = 0;
    return o;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "duration：解析" {
    int ok = 0;
    i64 ms = 0;

    ms = dur_parse(S("1h30m"), &ok);
    if (ok != 1 || ms != 5400000)
        return err(1, "1h30m 应该是 5400000 毫秒");
    ms = dur_parse(S("500ms"), &ok);
    if (ok != 1 || ms != 500)
        return err(2, "500ms 不对");
    ms = dur_parse(S("2d"), &ok);
    if (ok != 1 || ms != 172800000)
        return err(3, "2d 不对");
    ms = dur_parse(S("42"), &ok);
    if (ok != 1 || ms != 42000)
        return err(4, "纯数字应该按秒算");
    ms = dur_parse(S("1.5h"), &ok);
    if (ok != 1 || ms != 5400000)
        return err(5, "小数小时不对");
    ms = dur_parse(S("-2m30s"), &ok);
    if (ok != 1 || ms != -150000)
        return err(6, "负时长不对");
    ms = dur_parse(S("1h 30m"), &ok);
    if (ok != 1 || ms != 5400000)
        return err(7, "带空格的连写不对");
    ms = dur_parse(S("abc"), &ok);
    if (ok != 0 || ms != 0)
        return err(8, "非法输入应该 ok=0");
    ms = dur_parse(S("1q"), &ok);
    if (ok != 0)
        return err(9, "未知单位应该 ok=0");
}

test "duration：时钟写法与格式化" {
    char out[32] = { 0 };
    int ok = 0;

    if (dur_parse_clock(S("1:30"), &ok) != 90000 || ok != 1)
        return err(10, "1:30 应该是 90 秒");
    if (dur_parse_clock(S("1:00:00"), &ok) != 3600000)
        return err(11, "1:00:00 不对");
    if (dur_parse_clock(S("0:00:05"), &ok) != 5000)
        return err(12, "0:00:05 不对");
    if (dur_parse_clock(S("90"), &ok) != 90000)
        return err(13, "单字段按秒");
    if (dur_parse_clock(S("1:2:3:4"), &ok) != 0 || ok != 0)
        return err(14, "四个字段应该失败");
    if (dur_format(5400000, out, (int)sizeof out) != 5
        || memcmp(out, "1h30m", 5) != 0)
        return err(15, "格式化 1h30m 不对");
    if (dur_format(125000, out, (int)sizeof out) != 4
        || memcmp(out, "2m5s", 4) != 0)
        return err(16, "格式化 2m5s 不对");
    if (dur_format(500, out, (int)sizeof out) != 5
        || memcmp(out, "500ms", 5) != 0)
        return err(17, "格式化毫秒不对");
    if (dur_format(0, out, (int)sizeof out) != 3
        || memcmp(out, "0ms", 3) != 0)
        return err(18, "格式化 0 不对");
    if (dur_format(-90000, out, (int)sizeof out) != 6
        || memcmp(out, "-1m30s", 6) != 0)
        return err(19, "格式化负时长不对");
}
