    if (TOK_EQ(t, "__builtin_offsetof")) {
        u32 ty = 0;
        u32 off = 0;
        u32 d = 0;
        u32 acc = 0;     /* 非常量下标折算出来的运行期偏移；0 = 全是常量 */

        pa_advance();
        pa_expect_ch('(');
        ty = parse_typename();
        pa_expect_ch(',');
        {
            int first = 1;

            for (;;) {
                const char *mn = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
                u32 ml = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
                u32 mo = 0;

                if (!mn)
                    break;
                pa_advance();
                if (!agg_find_promoted(ty, mn, ml, &ty, &mo))
                    break;
                off += mo;
                first = 0;
                /* 成员后可能跟下标：`offsetof(T, node[idx])`
                 * （内核 include/linux/rbtree_latch.h:72 的 container_of）。
                 *
                 * 下标**不一定是常量**：`__lt_from_rb(struct rb_node *node, int idx)`
                 * 里 idx 是函数参数，偏移要在运行期算。所以这里走 IR：
                 * 常量部分累进 off，非常量部分乘元素大小加到 acc 上。 */
                while (pa_is_ch('[')) {
                    u32 et = 0;
                    u32 ixv = 0;
                    u32 esz = 0;

                    pa_advance();
                    ixv = value_of(gen_expr());
                    pa_expect_ch(']');
                    if (!ty_is_array(ty))
                        break;
                    et = ty_target(ty);
                    esz = ty_size(et);
                    if (acc == 0) {
                        acc = irfn_vreg(&FN);
                        irfn_push(&FN, IR_CONST, IRT_U64, acc, 0, 0, 0, 0);
                    }
                    if (esz != 1) {
                        u32 szv = irfn_vreg(&FN);
                        u32 t2 = irfn_vreg(&FN);

                        irfn_push(&FN, IR_CONST, IRT_U64, szv, 0, 0, 0, esz);
                        irfn_push(&FN, IR_MUL, IRT_U64, t2, ixv, szv, 0, 0);
                        ixv = t2;
                    }
                    {
                        u32 t3 = irfn_vreg(&FN);

                        irfn_push(&FN, IR_ADD, IRT_U64, t3, acc, ixv, 0, 0);
                        acc = t3;
                    }
                    ty = et;
                }
                if (!pa_accept_ch('.'))
                    break;
            }
            (void)first;
        }
        pa_expect_ch(')');
        if (acc) {
            /* 有非常量下标：off + acc */
            u32 ov = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, ov, 0, 0, 0, off);
            d = irfn_vreg(&FN);
            irfn_push(&FN, IR_ADD, IRT_U64, d, ov, acc, 0, 0);
        } else {
            d = irfn_vreg(&FN);
            irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, off);
        }
        GEN_TY = ty_ulong();
        return gen_postfix_ops(d);
    }
    if (TOK_EQ(t, "__builtin_choose_expr")) {
        /* `__builtin_choose_expr(const_expr, a, b)`：按常量条件取一支。
         *
         * 两支都必须**语法合法**，但只有选中的那支会被求值——所以没选中的
         * 那支在这里只是个表达式，副作用不该发。做法是：条件先在常量求值里
         * 算出，再记下当前表达式流的位置、把两支都解析出来，最后只留下选中
         * 那支的结果。
