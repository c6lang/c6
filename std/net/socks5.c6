/* std/net/socks5：SOCKS5（RFC 1928 / 1929）报文编解码（零分配，不含套接字）。
 *
 *     import std.net.socks5;
 *
 *     char buf[64];
 *     u8 methods[2] = { 0x00, 0x02 };            // 无认证、用户名口令
 *     int n = socks5_greeting(buf, (int)sizeof buf, methods, 2);
 *     // ... 发出去，读回两个字节
 *     int method = 0;
 *     if (socks5_parse_method(reply, rn, &method) < 0 || method != 0x00) ...
 *     // CONNECT example.test:443
 *     Socks5Addr a = socks5_addr_host("example.test", 443);
 *     n = socks5_request(buf, (int)sizeof buf, SOCKS5_CMD_CONNECT, &a);
 *     // ... 读回应答
 *     int rep = 0, used = 0;
 *     if (socks5_parse_reply(resp, rn, &rep, 0, &used) < 0 || rep != 0) ...
 *
 * 只做字节层：怎么收发由 `std.net.tcp` 或调用方决定，所以这些函数没有
 * 套接字参数，全部是「填缓冲 / 解析缓冲」的纯函数。
 *
 * 约定：
 *
 * - 地址用 `Socks5Addr` 表示：`atyp` 是 `SOCKS5_ATYP_*`，域名超长（>255）
 *   在 `socks5_addr_host` 里返回无效地址（`atyp=0`）；
 * - 端口一律网络序（大端）落字节，结构里存主机序；
 * - `socks5_parse_*` 拿到的数据不够（半包）返回 0 让调用方再读，格式坏返回 -1，
 *   解析成功返回消耗的字节数（>0）；`used` 可空；
 * - 用户名/口令长度上限 255（协议就是单字节长度）；
 * - 只支持 CONNECT/BIND/UDP ASSOCIATE 的报文构造与 REP 码解析，不做域名解析、
 *   不做 UDP 封装（那是 `std.net.udp` 的事）。
 */
#include <string.h>

module std.net.socks5;
import std.core.types;
import std.text.str;
import std.net.inet;

enum Socks5Const {
    SOCKS5_VERSION = 5,
    SOCKS5_CMD_CONNECT = 1,
    SOCKS5_CMD_BIND = 2,
    SOCKS5_CMD_UDP = 3,
    SOCKS5_ATYP_IPV4 = 1,
    SOCKS5_ATYP_DOMAIN = 3,
    SOCKS5_ATYP_IPV6 = 4,
    SOCKS5_AUTH_NONE = 0,
    SOCKS5_AUTH_USERPASS = 2,
    SOCKS5_AUTH_NO_ACCEPTABLE = 0xFF,
};

struct Socks5Addr {
    int atyp;           /* SOCKS5_ATYP_*，0 表示无效 */
    u8 b[16];           /* IPv4 用前 4 字节，IPv6 用 16 字节 */
    Str domain;         /* atyp == DOMAIN 时有效，指向调用方给的字符串 */
    int port;           /* 主机序 */
};

Socks5Addr socks5_addr_host(const char *host, int port)
{
    Socks5Addr a = { 0 };
    Ip ip = { 0 };

    if (!host)
        return a;
    if (inet_parse((char[:]){ (char *)host, (int)strlen(host) }, &ip) != 0) {
        if (ip.family == IP_V4) {
            a.atyp = SOCKS5_ATYP_IPV4;
            memcpy(a.b, ip.b, 4);
            a.port = port;
            return a;
        }
        if (ip.family == IP_V6) {
            a.atyp = SOCKS5_ATYP_IPV6;
            memcpy(a.b, ip.b, 16);
            a.port = port;
            return a;
        }
    }
    {
        int n = (int)strlen(host);

        if (n <= 0 || n > 255)
            return a;
        a.atyp = SOCKS5_ATYP_DOMAIN;
        a.domain.s = (char[:]){ (char *)host, n };
        a.port = port;
    }
    return a;
}

static void socks5_put_port(u8 *out, int port)
{
    out[0] = (u8)((port >> 8) & 0xFF);
    out[1] = (u8)(port & 0xFF);
}

int socks5_greeting(char *out, int cap, const u8 *methods, int n)
{
    int i = 0;

    if (!out || !methods || n <= 0 || n > 255 || cap < n + 2)
        return -1;
    out[0] = SOCKS5_VERSION;
    out[1] = (u8)n;
    for (i = 0; i < n; i++)
        out[2 + i] = (char)methods[i];
    return n + 2;
}

int socks5_userpass(char *out, int cap, Str user, Str pass)
{
    if (!out || user.s.len > 255 || pass.s.len > 255 || user.s.len <= 0
        || pass.s.len <= 0)
        return -1;
    if (cap < 3 + user.s.len + pass.s.len)
        return -1;
    out[0] = 1;                         /* 子协商版本 */
    out[1] = (u8)user.s.len;
    memcpy(out + 2, user.s.data, (size_t)user.s.len);
    out[2 + user.s.len] = (u8)pass.s.len;
    memcpy(out + 3 + user.s.len, pass.s.data, (size_t)pass.s.len);
    return 3 + user.s.len + pass.s.len;
}

int socks5_request(char *out, int cap, int cmd, const Socks5Addr *addr)
{
    int need = 0, i = 0;

    if (!out || !addr || addr->atyp == 0)
        return -1;
    if (cmd != SOCKS5_CMD_CONNECT && cmd != SOCKS5_CMD_BIND
        && cmd != SOCKS5_CMD_UDP)
        return -1;
    switch (addr->atyp) {
    case SOCKS5_ATYP_IPV4: need = 4 + 4 + 2; break;
    case SOCKS5_ATYP_IPV6: need = 4 + 16 + 2; break;
    case SOCKS5_ATYP_DOMAIN: need = 4 + 1 + addr->domain.s.len + 2; break;
    default:
        return -1;
    }
    if (cap < need)
        return -1;
    out[0] = SOCKS5_VERSION;
    out[1] = (char)cmd;
    out[2] = 0;                         /* RSV */
    out[3] = (char)addr->atyp;
    i = 4;
    if (addr->atyp == SOCKS5_ATYP_IPV4) {
        memcpy(out + i, addr->b, 4);
        i += 4;
    } else if (addr->atyp == SOCKS5_ATYP_IPV6) {
        memcpy(out + i, addr->b, 16);
        i += 16;
    } else {
        out[i++] = (char)addr->domain.s.len;
        memcpy(out + i, addr->domain.s.data, (size_t)addr->domain.s.len);
        i += addr->domain.s.len;
    }
    socks5_put_port((u8 *)out + i, addr->port);
    return i + 2;
}

/* 解析 atyp + 地址 + 端口；返回消耗字节数 / 0 数据不够 / -1 坏 */
int socks5_parse_addr(const void *src, int n, Socks5Addr *out, int *used)
{
    const u8 *p = (const u8 *)src;
    int i = 0, need = 0;

    if (!src || !out || n <= 0)
        return -1;
    memset(out, 0, sizeof *out);
    out->atyp = p[0];
    i = 1;
    switch (out->atyp) {
    case SOCKS5_ATYP_IPV4:
        need = 4;
        if (n < i + need + 2)
            return 0;
        memcpy(out->b, p + i, 4);
        i += need;
        break;
    case SOCKS5_ATYP_IPV6:
        need = 16;
        if (n < i + need + 2)
            return 0;
        memcpy(out->b, p + i, 16);
        i += need;
        break;
    case SOCKS5_ATYP_DOMAIN:
        if (n < i + 1)
            return 0;
        need = p[i];
        if (need <= 0)
            return -1;
        if (n < i + 1 + need + 2)
            return 0;
        /* 域名视图指向输入缓冲，调用方要保证它活着 */
        out->domain.s = (char[:]){ (char *)p + i + 1, need };
        i += 1 + need;
        break;
    default:
        return -1;
    }
    out->port = ((int)p[i] << 8) | (int)p[i + 1];
    i += 2;
    if (used)
        *used = i;
    return i;
}

/* 方法协商应答：05 00 → 返回 2；05 FF → 返回 2；不够返回 0；坏返回 -1 */
int socks5_parse_method(const void *src, int n, int *method)
{
    const u8 *p = (const u8 *)src;

    if (!src || n <= 0)
        return -1;
    if (n < 2)
        return 0;
    if (p[0] != SOCKS5_VERSION)
        return -1;
    if (method)
        *method = p[1];
    return 2;
}

/* 用户名口令子协商应答：01 status → 返回 2；不够 0；坏 -1 */
int socks5_parse_userpass(const void *src, int n, int *status)
{
    const u8 *p = (const u8 *)src;

    if (!src || n <= 0)
        return -1;
    if (n < 2)
        return 0;
    if (p[0] != 1)
        return -1;
    if (status)
        *status = p[1];
    return 2;
}

/* 请求应答：05 REP 00 ATYP addr port；返回总字节数 / 0 不够 / -1 坏 */
int socks5_parse_reply(const void *src, int n, int *rep, Socks5Addr *bound,
                       int *used)
{
    const u8 *p = (const u8 *)src;
    int r = 0;

    if (!src || n <= 0)
        return -1;
    if (n < 4)
        return 0;
    if (p[0] != SOCKS5_VERSION || p[2] != 0)
        return -1;
    if (rep)
        *rep = p[1];
    if (bound) {
        r = socks5_parse_addr(p + 3, n - 3, bound, 0);
        if (r <= 0)
            return r;
        if (used)
            *used = 3 + r;
        return 3 + r;
    }
    if (used)
        *used = 4;
    return 4;
}

/* ---- 自测 ---- */

test "SOCKS5：问候、认证与请求报文" {
    char buf[128] = { 0 };
    u8 methods[2] = { 0x00, 0x02 };
    int n = 0;
    Socks5Addr a = { 0 };
    Str user = { S("alice") };
    Str pass = { S("s3cret") };

    n = socks5_greeting(buf, (int)sizeof buf, methods, 2);
    if (n != 4 || buf[0] != 5 || (u8)buf[1] != 2 || (u8)buf[2] != 0
        || (u8)buf[3] != 2)
        return err(1, "问候报文不对");
    if (socks5_greeting(buf, 3, methods, 2) != -1)
        return err(2, "问候缓冲不够应该 -1");
    n = socks5_userpass(buf, (int)sizeof buf, user, pass);
    if (n != 14 || (u8)buf[0] != 1 || (u8)buf[1] != 5
        || memcmp(buf + 2, "alice", 5) != 0 || (u8)buf[7] != 6
        || memcmp(buf + 8, "s3cret", 6) != 0)
        return err(3, "用户名口令报文不对");
    if (socks5_userpass(buf, (int)sizeof buf, (Str){ S("") }, pass) != -1)
        return err(4, "空用户名应该 -1");
    /* IPv4 目标 */
    a = socks5_addr_host("192.0.2.7", 8080);
    if (a.atyp != SOCKS5_ATYP_IPV4 || a.b[0] != 192 || a.b[3] != 7)
        return err(5, "IPv4 地址构造不对");
    n = socks5_request(buf, (int)sizeof buf, SOCKS5_CMD_CONNECT, &a);
    if (n != 10 || buf[0] != 5 || buf[1] != SOCKS5_CMD_CONNECT
        || (u8)buf[3] != SOCKS5_ATYP_IPV4 || (u8)buf[8] != 0x1F
        || (u8)buf[9] != 0x90)
        return err(6, "IPv4 请求报文不对");
    /* 域名目标 */
    a = socks5_addr_host("example.test", 443);
    if (a.atyp != SOCKS5_ATYP_DOMAIN || a.domain.s.len != 12)
        return err(7, "域名地址构造不对");
    n = socks5_request(buf, (int)sizeof buf, SOCKS5_CMD_CONNECT, &a);
    if (n != 19 || (u8)buf[3] != SOCKS5_ATYP_DOMAIN || (u8)buf[4] != 12
        || memcmp(buf + 5, "example.test", 12) != 0
        || (u8)buf[17] != 0x01 || (u8)buf[18] != 0xBB)
        return err(8, "域名请求报文不对");
    /* IPv6 目标 */
    a = socks5_addr_host("2001:db8::1", 53);
    if (a.atyp != SOCKS5_ATYP_IPV6 || a.b[0] != 0x20 || a.b[15] != 1)
        return err(9, "IPv6 地址构造不对");
    n = socks5_request(buf, (int)sizeof buf, SOCKS5_CMD_UDP, &a);
    if (n != 22 || (u8)buf[3] != SOCKS5_ATYP_IPV6 || (u8)buf[20] != 0
        || (u8)buf[21] != 53)
        return err(10, "IPv6 请求报文不对");
    if (socks5_request(buf, (int)sizeof buf, 9, &a) != -1)
        return err(11, "非法命令应该 -1");
    if (socks5_addr_host("", 80).atyp != 0)
        return err(12, "空主机应该无效");
}

test "SOCKS5：应答解析、半包与坏包" {
    static u8 reply1[10] = { 5, 0, 0, 1, 203, 0, 113, 5, 0x04, 0x38 };
    static u8 upbad[2] = { 2, 0 };
    static u8 meth[2] = { 5, 0 };
    static u8 up[2] = { 1, 0 };
    static u8 badver[2] = { 4, 0 };
    static u8 repbad[4] = { 4, 0, 0, 1 };
    static u8 rep5[4] = { 5, 5, 0, 1 };
    static u8 atyp2[2] = { 2, 0 };
    static u8 dom[16] = { 3, 3, 'a', 'b', 'c', 0x01, 0xBB };
    int method = 0, status = 0, rep = 0, used = 0, r = 0;
    Socks5Addr b = { 0 };

    if (socks5_parse_method(meth, 2, &method) != 2 || method != 0)
        return err(13, "方法协商应答不对");
    if (socks5_parse_method(meth, 1, &method) != 0)
        return err(14, "半包应该 0");
    if (socks5_parse_method(badver, 2, &method) != -1)
        return err(15, "版本不对应该 -1");
    if (socks5_parse_userpass(up, 2, &status) != 2 || status != 0)
        return err(16, "认证应答不对");
    if (socks5_parse_userpass(upbad, 2, &status) != -1)
        return err(17, "认证版本不对应该 -1");
    r = socks5_parse_reply(reply1, 10, &rep, &b, &used);
    if (r != 10 || rep != 0 || used != 10 || b.atyp != SOCKS5_ATYP_IPV4
        || b.port != 1080 || b.b[1] != 0)
        return err(18, "应答解析不对");
    if (socks5_parse_reply(reply1, 7, &rep, &b, 0) != 0)
        return err(19, "应答半包应该 0");
    if (socks5_parse_reply(repbad, 4, &rep, 0, 0) != -1)
        return err(20, "应答版本不对应该 -1");
    if (socks5_parse_reply(rep5, 4, &rep, 0, &used) != 4
        || rep != 5 || used != 4)
        return err(21, "带拒绝码的应答不对");
    /* 地址：域名 + 半包 + 坏 atyp */
    {
        if (socks5_parse_addr(dom, 7, &b, &used) != 7 || used != 7
            || b.atyp != SOCKS5_ATYP_DOMAIN || b.domain.s.len != 3
            || b.port != 443)
            return err(22, "域名地址解析不对");
        if (socks5_parse_addr(dom, 5, &b, 0) != 0)
            return err(23, "地址半包应该 0");
        if (socks5_parse_addr(atyp2, 2, &b, 0) != -1)
            return err(24, "未知 atyp 应该 -1");
    }
    if (socks5_parse_addr(0, 4, &b, 0) != -1 || socks5_parse_method(0, 2, &method) != -1
        || socks5_parse_reply(0, 4, &rep, 0, 0) != -1)
        return err(25, "空指针应该 -1");
    /* 请求缓冲不够 */
    {
        Socks5Addr v6 = socks5_addr_host("2001:db8::1", 53);
        char small[8] = { 0 };

        if (socks5_request(small, (int)sizeof small, SOCKS5_CMD_CONNECT, &v6) != -1)
            return err(26, "请求缓冲不够应该 -1");
    }
}
