                    u32 mm = irfn_vreg(&FN);

                    irfn_push(&FN, IR_CONST, IRT_U64, kk, 0, 0, 0, se);
                    irfn_push(&FN, IR_MUL, IRT_U64, mm, lo, kk, 0, 0);
                    irfn_push(&FN, IR_ADD, IRT_PTR, pv, base, mm, 0, 0);
