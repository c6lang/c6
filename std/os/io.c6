/* std/os/io：文件和标准流的读写帮手。
 *
 *     import std.os.io;
 *
 *     Reader r = reader_open("input.txt");       // 失败时打开标记为 0
 *     Reader *pr = &r;
 *     char line[256] = { 0 };
 *     while (pr->read_line(line, sizeof(line)) > 0)
 *         printf("%s\n", line);
 *     pr->close();
 *
 * 为什么用 `FILE *` 而不是裸 fd：`libtcc1` 的弱依赖里没有 `read`/`write`，
 * 但 `fopen`/`fread`/`fwrite` 在宿主 libc 上到处都有，tcc 自己的 C 运行时
 * 也给 stdio（freestanding 目标才需要自己实现）。用 `FILE *` 还能顺带
 * 拿到带缓冲的行读取，语义和 C 程序员的直觉一致。
 *
 * 设计要点：
 * - `Reader`/`Writer` 是普通结构体：方法写成文件作用域函数、接收者是指针，
 *   调用写 `pr->read_line()`。方法名直接用 `read_line`/`write_line`/`flush`/
 *   `close`：模块里的裸名弱别名带模块前缀，和别的模块同名方法不会互相顶掉；
 *   同一模块里 `Reader`/`Writer` 都叫 `close`/`ok` 也没关系，编译器按接收者
 *   选符号。标准库里请一律用方法语法，别依赖裸名别名；
 * - 所有读操作 EOF 返回 0、出错返回 -1（**不会只是 0 和 -1 混在一起**）：
 *   返回值 > 0 才是读到的字节数，调用方据此区分「读完了」和「出错了」；
 * - `read_line` 会削掉行尾的 `\n` 与 `\r`（CRLF 文本也能直接用），
 *   超长行**读满就返回**并把剩余部分留给下一次调用（不丢数据）；
 * - `CFile` 是零分配的按行迭代器：只包一个 `FILE *` 和一块调用方给的
 *   buffer，`while ((&it)->has()) { char[:] line = (&it)->next(); ... }`。
 */
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

module std.os.io;
import std.core.types;
import std.core.err;

/* ---- 读 ---- */

struct Reader {
    FILE *f;
};

/* 打开文件读；失败返回的 Reader 的 f 为 0（用 ok 查） */
Reader reader_open(char *path)
{
    Reader r = { 0 };

    if (path)
        r.f = fopen(path, "rb");
    return r;
}

/* 包一个已有的 FILE（stdin 等）；不接管所有权时 close 要由调用方决定 */
Reader reader_wrap(FILE *f)
{
    Reader r = { 0 };

    r.f = f;
    return r;
}

int ok(Reader *self) { return self->f != 0; }

FILE *file(Reader *self) { return self->f; }

/* 从当前 **fd** 读一段，返回读到的字节数；EOF 返回 0，出错返回 -1。
   注意：这里走 fread，所以和用同一个 FILE 的其它函数共享缓冲位置。 */
int read_bytes(Reader *self, void *buf, int n)
{
    usize got = 0;

    if (!self->f || n <= 0)
        return 0;
    got = fread(buf, 1, (usize)n, self->f);
    if (got > 0)
        return (int)got;
    if (ferror(self->f))
        return -1;
    return 0;
}

/* 读一行到 buf（cap 含结尾 NUL）；行尾的 \n 和 \r 被削掉。
   返回读到的字节数（不含 NUL），EOF 且没读到东西返回 0，出错返回 -1。
   一行比 cap 长时：读满 cap-1 个字节就返回，剩下的下次再读。 */
int read_line(Reader *self, char *buf, int cap)
{
    int n = 0;
    int c = 0;

    if (!self->f || cap <= 1)
        return 0;
    while (n < cap - 1) {
        c = fgetc(self->f);
        if (c == EOF) {
            if (ferror(self->f))
                return -1;
            break;
        }
        if (c == '\n')
            break;
        buf[n++] = (char)c;
    }
    /* 只有「真的读到行尾」才削 \r；读满截断时保留原字节 */
    if (n > 0 && buf[n - 1] == '\r' && c != EOF && c != '\n')
        n--;
    else if (n > 0 && buf[n - 1] == '\r')
        n--;
    buf[n] = 0;
    return n;
}

/* 一次读完整个文件到 dst（cap 含 NUL）：返回字节数，放不下返回 -1
   （不写半截）；出错返回 -1。读完后调用方自己 NUL 结尾（这里会写）。 */
int read_all(Reader *self, char *dst, int cap)
{
    int total = 0;
    usize got = 0;

    if (!self->f || cap <= 0)
        return -1;
    while (total < cap - 1) {
        got = fread(dst + total, 1, (usize)(cap - 1 - total), self->f);
        if (got == 0)
            break;
        total += (int)got;
    }
    dst[total] = 0;
    if (ferror(self->f))
        return -1;
    /* 还有剩余说明放不下 */
    if (total == cap - 1 && fgetc(self->f) != EOF)
        return -1;
    return total;
}

/* 跳到指定绝对偏移（成功返回 0）；只对可 seek 的流有意义 */
int seek_to(Reader *self, long off)
{
    if (!self->f)
        return -1;
    return fseek(self->f, off, SEEK_SET) == 0 ? 0 : -1;
}

/* 当前绝对偏移，出错返回 -1 */
long tell(Reader *self)
{
    if (!self->f)
        return -1;
    return ftell(self->f);
}

int eof(Reader *self) { return self->f ? feof(self->f) != 0 : 1; }

int error(Reader *self) { return self->f ? ferror(self->f) != 0 : 1; }

/* 关掉；已经关过（f 为 0）时什么都不做 */
void close(Reader *self)
{
    if (self->f) {
        fclose(self->f);
        self->f = 0;
    }
}

/* ---- 写 ---- */

struct Writer {
    FILE *f;
};

/* 打开文件写（覆盖）；失败返回 f 为 0 的 Writer */
Writer writer_open(char *path)
{
    Writer w = { 0 };

    if (path)
        w.f = fopen(path, "wb");
    return w;
}

/* 追加打开；文件不存在则创建 */
Writer writer_append(char *path)
{
    Writer w = { 0 };

    if (path)
        w.f = fopen(path, "ab");
    return w;
}

Writer writer_wrap(FILE *f)
{
    Writer w = { 0 };

    w.f = f;
    return w;
}

int ok(Writer *self) { return self->f != 0; }

FILE *file(Writer *self) { return self->f; }

/* 写 n 个字节：全写成功返回 n，出错返回 -1 */
int write_bytes(Writer *self, const void *buf, int n)
{
    usize put = 0;

    if (!self->f || n <= 0)
        return 0;
    put = fwrite(buf, 1, (usize)n, self->f);
    if (put != (usize)n)
        return -1;
    return (int)put;
}

/* 写一个字节 */
int write_char(Writer *self, char c)
{
    return self->write_bytes(&c, 1);
}

/* 写一段字节视图（char[:]，含 Str 内容），不用自己给长度 */
int write_slice(Writer *self, char[:] s)
{
    if (!s.data || s.len <= 0)
        return 0;
    return self->write_bytes(s.data, s.len);
}

/* 写一行：内容 + '\n'。返回写入的总字节数，出错 -1 */
int write_line(Writer *self, char *z)
{
    int n = 0;

    if (!self->f || !z)
        return -1;
    n = (int)strlen(z);
    if (self->write_bytes(z, n) < 0)
        return -1;
    if (self->write_char((char)0x0a) < 0)
        return -1;
    return n + 1;
}

/* 刷新缓冲区；成功返回 0 */
int flush(Writer *self)
{
    if (!self->f)
        return -1;
    return fflush(self->f) == 0 ? 0 : -1;
}

void close(Writer *self)
{
    if (self->f) {
        fclose(self->f);
        self->f = 0;
    }
}

/* ---- 零分配的按行迭代器 ---- */

struct CFile {
    FILE *f;
    char *buf;
    int cap;
    int n;      /* 当前行长度 */
    int ok;     /* 还有没有行 */
};

/* 工厂：buf/cap 是调用方给的暂存区，必须活得比迭代器久 */
CFile cfile_iter(FILE *f, char *buf, int cap)
{
    CFile it = { 0, 0, 0, 0, 0 };

    it.f = f;
    it.buf = buf;
    it.cap = cap;
    it.n = 0;
    it.ok = f != 0 && buf != 0 && cap > 1;
    return it;
}

int has(CFile *self)
{
    Reader r = { 0 };
    int k = 0;

    if (!self->ok)
        return 0;
    r.f = self->f;
    k = r.read_line( self->buf, self->cap);
    if (k <= 0) {
        self->ok = 0;
        self->n = 0;
        return 0;
    }
    self->n = k;
    return 1;
}

/* 当前行的视图（不含 \n，指向调用方给的 buffer）。
   返回 char[:] 而不是 Str：io 这一层不依赖 std.text.str 的实体（stdtest 逐个文件
   单独链接），调用方要 Str 时自己包一层 `Str s = { line };`。 */
char[:] next(CFile *self)
{
    return (char[:]){ self->buf, self->n };
}

/* ---- 自测 ---- */

/* 临时文件：写到系统的临时目录，跑完删掉。测试里只用标准 C 的 tmpfile
   会拿不到路径，所以这里固定用 build/ 下的名字（make stdtest 之前会建）。 */
static char *tmp_path(void) { return (char *)"build/std-io-test.txt"; }

test "写文件再读回来" {
    Writer w = writer_open(tmp_path());
    Writer *pw = &w;
    Reader r = reader_open(tmp_path());
    Reader *pr = &r;
    char buf[64] = { 0 };
    int n = 0;

    if (!pw->ok())
        return err(1, "写打开失败");
    if (pw->write_line((char *)"hello") != 6)
        return err(2, "write_line 返回值不对");
    if (pw->write_bytes("world", 5) != 5)
        return err(3, "write_bytes 不对");
    if (pw->flush() != 0)
        return err(4, "flush 失败");
    pw->close();

    if (!pr->ok())
        return err(5, "读打开失败");
    n = pr->read_line(buf, sizeof(buf));
    if (n != 5 || strcmp(buf, "hello") != 0)
        return err(6, "第一行不对");
    n = pr->read_all(buf, sizeof(buf));
    if (n != 5 || strcmp(buf, "world") != 0)
        return err(7, "剩余内容不对");
    if (pr->read_line(buf, sizeof(buf)) != 0)
        return err(8, "EOF 应返回 0");
    pr->close();
    pr->close();   /* 关两次是安全的 */
}

test "read_line 削掉 CRLF 的行尾" {
    Writer w = writer_open(tmp_path());
    Writer *pw = &w;
    Reader r = { 0 };
    Reader *pr = &r;
    char buf[32] = { 0 };

    pw->write_bytes("a\r\nb\r\n", 6);
    pw->close();
    pr->f = fopen(tmp_path(), "rb");
    if (!pr->f)
        return err(9, "重新打开失败");
    if (pr->read_line(buf, sizeof(buf)) != 1 || strcmp(buf, "a") != 0)
        return err(10, "CRLF 第一行没削干净");
    if (pr->read_line(buf, sizeof(buf)) != 1 || strcmp(buf, "b") != 0)
        return err(11, "CRLF 第二行没削干净");
    pr->close();
}

test "read_line 遇到超长行截断但不丢数据" {
    Writer w = writer_open(tmp_path());
    Writer *pw = &w;
    Reader r = { 0 };
    Reader *pr = &r;
    char buf[5] = { 0 };

    pw->write_bytes("abcdefgh\n", 9);
    pw->close();
    pr->f = fopen(tmp_path(), "rb");
    if (!pr->f)
        return err(12, "重新打开失败");
    if (pr->read_line(buf, 5) != 4 || strcmp(buf, "abcd") != 0)
        return err(13, "截断部分不对");
    if (pr->read_line(buf, 5) != 4 || strcmp(buf, "efgh") != 0)
        return err(14, "剩余部分丢了");
    if (pr->read_line(buf, 5) != 0)
        return err(15, "应当已经到 EOF");
    pr->close();
}

test "打开不存在的文件不崩" {
    Reader r = reader_open((char *)"build/definitely-not-here-xyz.txt");
    Reader *pr = &r;

    if (pr->ok() != 0)
        return err(16, "不存在的文件不该打开成功");
    if (pr->read_bytes((char *)0, 0) != 0)
        return err(17, "空读应当返回 0");
    pr->close();
}

test "CFile 迭代器零分配按行读" {
    Writer w = writer_open(tmp_path());
    Writer *pw = &w;
    FILE *f = 0;
    char buf[32] = { 0 };
    CFile it = { 0 };
    CFile *pit = &it;
    int lines = 0, total = 0;

    pw->write_line((char *)"one");
    pw->write_line((char *)"two");
    pw->write_line((char *)"three");
    pw->close();
    f = fopen(tmp_path(), "rb");
    if (!f)
        return err(18, "重新打开失败");
    it = cfile_iter(f, buf, sizeof(buf));
    while (pit->has()) {
        char[:] line = pit->next();

        lines++;
        total += line.len;
    }
    fclose(f);
    if (lines != 3 || total != 11)
        return err(19, "CFile 迭代结果不对");
}
