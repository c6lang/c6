/* safegate 的运行时探针：这里的越界**静态**判不出来（下标来自参数），
 * 只有运行时检查（`c6 -b`）能当场抓住。make safegate 用它证明第二层是活的。 */
#include <stdio.h>

int pick(int *a, int i) { return a[i]; }

int main(void)
{
    int a[4] = { 1, 2, 3, 4 };
    int i = 0;

    for (i = 0; i < 4; i++)
        printf("%d\n", pick(a, i));   /* 界内：正常路径 */
    printf("%d\n", pick(a, 7));       /* 越界：-b 必须在这里炸 */
    return 0;
}
