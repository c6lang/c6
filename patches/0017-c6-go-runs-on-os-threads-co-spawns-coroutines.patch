 tccgen.c      | 379 ++++++++++++++++++++++++++++++++++++++++++++++----
 tccpp.c       |   6 +-
 tccrun.c      |   5 +
 tcctok.h      |   2 -
 5 files changed, 464 insertions(+), 30 deletions(-)

