/* stdcrypto：标准库第二十三批（md5 / sha512 / hkdf / pbkdf2）的拼装示例。
 *
 * 和前面几批一样：这个文件没有 `module`（入口 `main` 只能写在模块外的文件里），
 * 各节自带自检，失败打 FAIL，最后按失败数决定退出码。
 *
 * 这批是**纯计算**：没有 socket、没有文件、没有时钟依赖，所有期望值都来自
 * RFC 向量（RFC 1321 / FIPS 180-4 / RFC 4231 / RFC 5869 / RFC 6070），所以
 * `make std-crypto` 在任何平台都给出同一串输出。
 *
 * 编译（import 只带来声明，模块正文要单独列出来）：
 *
 *     ./tcc/c6 -B tcc -I . -o build/stdcrypto \
 *         examples/stdcrypto.c6 std/core/types.c6 std/core/err.c6 \
 *         std/core/bits.c6 std/encoding/md5.c6 std/encoding/sha1.c6 \
 *         std/encoding/sha256.c6 std/encoding/sha512.c6 \
 *         std/encoding/hkdf.c6 std/encoding/pbkdf2.c6
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.encoding.md5;
import std.encoding.sha1;
import std.encoding.sha256;
import std.encoding.sha512;
import std.encoding.hkdf;
import std.encoding.pbkdf2;
import std.os.time;

static int checks = 0;
static int fails = 0;

static void check(int cond, char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("FAIL: %s\n", what);
    }
}

/* 摘要 == 小写十六进制串 */
static int hexeq(const u8 *d, int n, const char *want)
{
    char got[256] = { 0 };
    int i = 0;

    for (i = 0; i < n; i++) {
        got[i * 2] = "0123456789abcdef"[(d[i] >> 4) & 0xf];
        got[i * 2 + 1] = "0123456789abcdef"[d[i] & 0xf];
    }
    got[n * 2] = 0;
    return strcmp(got, want) == 0;
}

/* 1) MD5：校验和的老接口，顺带演示流式喂入 */
static void tour_md5(void)
{
    u8 one[16] = { 0 }, two[16] = { 0 };
    Md5 st = { 0 };
    char hex[33] = { 0 };
    char text[200] = { 0 };
    int i = 0;

    md5("abc", 3, one);
    check(hexeq(one, 16, "900150983cd24fb0d6963f7d28e17f72"), "md5: abc 向量");
    md5_hex("abc", 3, hex);
    check(strcmp(hex, "900150983cd24fb0d6963f7d28e17f72") == 0,
          "md5: hex 出口");
    md5_hex("", 0, hex);
    check(strcmp(hex, "d41d8cd98f00b204e9800998ecf8427e") == 0,
          "md5: 空串向量");
    for (i = 0; i < (int)sizeof text; i++)
        text[i] = (char)('a' + i % 26);
    md5(text, (usize)sizeof text, one);
    st.init();
    st.update(text, 63);
    st.update(text + 63, 64);
    st.update(text + 127, (usize)sizeof text - 127);
    st.final(two);
    check(md5_eq(one, two), "md5: 流式喂入一致");
    two[0] ^= 1;
    check(!md5_eq(one, two), "md5: 改一字节不相等");
    printf("md5: abc = %s\n", "900150983cd24fb0d6963f7d28e17f72");
}

/* 2) SHA-512 / SHA-384 / HMAC-SHA-512 */
static void tour_sha512(void)
{
    u8 d[64] = { 0 }, d48[48] = { 0 }, mac[64] = { 0 };
    u8 mac2[64] = { 0 };
    char hex[129] = { 0 };
    char key[20] = { 0 };

    sha512_hex("abc", 3, hex);
    check(strcmp(hex,
                 "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a"
                 "2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
          == 0,
          "sha512: abc 向量");
    sha512("abc", 3, d);
    check(d[0] == 0xdd && d[63] == 0x9f, "sha512: 首尾字节");
    sha384_hex("abc", 3, hex);
    check(strcmp(hex,
                 "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed"
                 "8086072ba1e7cc2358baeca134c825a7")
          == 0,
          "sha384: abc 向量");
    sha384("abc", 3, d48);
    check(memcmp(d48, d, 48) != 0, "sha384: 不该等于 sha512 前 48 字节");
    memset(key, 0x0b, sizeof key);
    hmac_sha512(key, sizeof key, "Hi There", 8, mac);
    hmac_sha512(key, sizeof key, "Hi There", 8, mac2);
    check(hexeq(mac, 64,
                "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cde"
                "daa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854"),
          "hmac-sha512: RFC 4231 case 1");
    check(sha512_eq(mac, mac2), "hmac-sha512: 两次结果相同");
    mac2[63] ^= 1;
    check(!sha512_eq(mac, mac2), "hmac-sha512: 篡改检测");
    printf("sha512: abc = %s...\n", "ddaf35a193617abacc417349ae204131");
}

/* 3) HKDF：RFC 5869 case 1 */
static void tour_hkdf(void)
{
    u8 ikm[22] = { 0 }, salt[13] = { 0 }, info[10] = { 0 };
    u8 prk[32] = { 0 }, okm[42] = { 0 }, again[42] = { 0 };
    int i = 0;

    memset(ikm, 0x0b, sizeof ikm);
    for (i = 0; i < 13; i++)
        salt[i] = (u8)i;
    for (i = 0; i < 10; i++)
        info[i] = (u8)(0xf0 + i);
    check(hkdf_extract(salt, sizeof salt, ikm, sizeof ikm, prk) == 0,
          "hkdf: extract");
    check(hexeq(prk, 32,
                "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"),
          "hkdf: PRK 向量");
    check(hkdf_expand(prk, sizeof prk, info, sizeof info, okm, sizeof okm) == 0,
          "hkdf: expand");
    check(hexeq(okm, 42,
                "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf"
                "34007208d5b887185865"),
          "hkdf: OKM 向量");
    check(hkdf(salt, sizeof salt, ikm, sizeof ikm, info, sizeof info, again,
               sizeof again)
              == 0
              && memcmp(okm, again, sizeof okm) == 0,
          "hkdf: 一步版与分离版一致");
    /* 输出上限：8160 字节可以，8161 不行 */
    {
        u8 big[255 * 32 + 1] = { 0 };

        check(hkdf_expand(prk, sizeof prk, 0, 0, big, 255 * 32) == 0,
              "hkdf: 8160 字节上限内");
        check(hkdf_expand(prk, sizeof prk, 0, 0, big, 255 * 32 + 1) == -1,
              "hkdf: 超上限被拒");
    }
    printf("hkdf: prk = %s...\n", "077709362c2e32df0ddc3f0dc47bba63");
}

/* 4) PBKDF2：RFC 6070 + SHA-256 向量，再拿它当一个「慢哈希」的比较 */
static void tour_pbkdf2(void)
{
    u8 sha1_key[20] = { 0 }, sha256_key[64] = { 0 }, slow[64] = { 0 };
    int t0 = 0, t1 = 0;

    check(pbkdf2_sha1("password", 8, "salt", 4, 4096, sha1_key,
                      sizeof sha1_key)
              == 0,
          "pbkdf2-sha1: 4096 次");
    check(hexeq(sha1_key, 20, "4b007901b765489abead49d926f721d065a429c1"),
          "pbkdf2-sha1: RFC 6070 向量");
    check(pbkdf2_sha256("passwd", 6, "salt", 4, 1, sha256_key,
                        sizeof sha256_key)
              == 0,
          "pbkdf2-sha256: 64 字节");
    check(hexeq(sha256_key, 64,
                "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc"
                "49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783"),
          "pbkdf2-sha256: 向量");
    /* 迭代次数是安全参数：次数不同结果就不同（也顺便量一下耗时差异） */
    t0 = (int)now_ms();
    pbkdf2_sha256("password", 8, "salt", 4, 1, slow, sizeof slow);
    t1 = (int)now_ms();
    check(memcmp(slow, sha256_key, 32) != 0, "pbkdf2: 不同口令结果不同");
    check(t1 >= t0, "pbkdf2: 时钟单调");
    printf("pbkdf2: sha1(salt,4096) = %s...\n", "4b007901b765489abead49d926f721");
}

/* 5) 收尾：拿 HMAC-SHA-256 做一个「签名 token」的签发/校验 */
static void tour_token(void)
{
    u8 mac[32] = { 0 };
    char hex[65] = { 0 };
    char token[] = "user=ada&exp=1700000000";
    char *key = (char *)"secret-key";

    hmac_sha256_hex(key, (usize)strlen(key), token, (usize)strlen(token), hex);
    hmac_sha256(key, (usize)strlen(key), token, (usize)strlen(token), mac);
    check(strlen(hex) == 64, "token: 签名字长");
    check(hexeq(mac, 32, hex), "token: 字节与 hex 一致");
    /* 篡改 token 之后签名不再匹配 */
    {
        u8 bad[32] = { 0 };

        token[0] = 'u' + 1;         /* "vser=..." */
        hmac_sha256(key, (usize)strlen(key), token, (usize)strlen(token), bad);
        check(!sha256_eq(mac, bad), "token: 篡改检测");
        token[0] = 'u';
    }
    printf("token: hmac-sha256 = %s...\n", "7d2f...（校验用常数时间比较）");
}

int main(void)
{
    printf("stdcrypto: 标准库第二十三批（md5 / sha512 / hkdf / pbkdf2）\n");
    tour_md5();
    tour_sha512();
    tour_hkdf();
    tour_pbkdf2();
    tour_token();
    printf("stdcrypto: %d check(s), %d failure(s)\n", checks, fails);
    return fails ? 1 : 0;
}
