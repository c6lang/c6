/* std/data/ext2：ext2/ext3/ext4 的超级块、块组描述符与 inode。
 *
 *     import std.data.ext2;
 *
 *     Ext2Super sb = { 0 };
 *     Ext2Inode in = { 0 };
 *     if (ext2_super(buf, n, &sb) == 1
 *         && ext2_inode(buf, n, &sb, 2, &in) == 1)
 *         // 2 号 inode 一般是根目录：in.mode 的 S_IFDIR 位、in.size、in.first_block
 *
 * 超级块在字节偏移 1024（块大小 1024 时是块 1），关键字段：inode 总数(0)、块总数
 * (4)、空闲块(12)、首个数据块(20)、`log_block_size`(24)、每块组块数(32)、
 * 每块组 inode 数(40)、魔数 `0xEF53`(56)、状态(58)、修订(76)、inode 大小(88)、
 * 兼容特性(92)、卷名(120, 16 字节)、最后挂载点(136, 64 字节)。
 *
 * 块组描述符表在「首个数据块 + 1」个块处，每项 32 字节：块位图(0)、inode 位图(4)、
 * inode 表(8)、空闲块(12)、空闲 inode(14)、已用目录(16)。
 *
 * inode：模式(0)、大小(4)、时间(8/12/16)、链接数(26)、块指针(40 起 15 个 u32)。
 *
 * 约定：
 *
 * - 块大小 = `1024 << log_block_size`，只接受 1024/2048/4096/8192/16384；
 * - `ext2_group` 序号从 0 开始；`ext2_inode` 序号按 ext2 惯例**从 1 开始**
 *   （1 号是坏块 inode，2 号通常是根目录），所以传 2 取根目录；
 * - 只读不写：不解析目录项内容、不跟间接块、不认 ext4 的 64 位块组描述符
 *   （`64bit` 特性置位时 desc_size 会变大，这里仍按 32 字节走）；
 * - 卷名/最后挂载点是定长字符串，未终止时补 0。
 */
#include <string.h>

module std.data.ext2;
import std.core.types;
import std.text.str;

struct Ext2Super {
    u32 inodes_count;
    u32 blocks_count;
    u32 free_blocks;
    u32 first_data_block;
    u32 block_size;
    u32 blocks_per_group;
    u32 inodes_per_group;
    u32 inode_size;
    int state;
    int rev_level;
    u32 feature_compat;
    u32 feature_incompat;
    char volume_name[17];
    char last_mounted[65];
};

struct Ext2Group {
    u32 block_bitmap;
    u32 inode_bitmap;
    u32 inode_table;
    int free_blocks;
    int free_inodes;
    int used_dirs;
};

struct Ext2Inode {
    int mode;
    u32 size;
    u32 atime;
    u32 mtime;
    u32 ctime;
    int nlink;
    u32 first_block;
    u32 dir_acl_block;
};

static u32 e2_le32(const u8 *p)
{
    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16)
           | ((u32)p[3] << 24);
}

static u32 e2_le16(const u8 *p)
{
    return (u32)p[0] | ((u32)p[1] << 8);
}

static void e2_copy(char *dst, int cap, const u8 *src, int len)
{
    int i = 0;

    for (i = 0; i < len && i + 1 < cap; i++) {
        if (src[i] == 0)
            break;
        dst[i] = (char)src[i];
    }
    dst[i] = 0;
}

int ext2_super(const void *src, int n, Ext2Super *out)
{
    const u8 *p = (const u8 *)src;
    const u8 *s = 0;

    if (!src || !out || n < 1024 + 256)
        return -1;
    s = p + 1024;
    if (e2_le16(s + 56) != 0xEF53)
        return -1;
    memset(out, 0, sizeof *out);
    out->inodes_count = e2_le32(s + 0);
    out->blocks_count = e2_le32(s + 4);
    out->free_blocks = e2_le32(s + 12);
    out->first_data_block = e2_le32(s + 20);
    out->block_size = 1024u << e2_le32(s + 24);
    out->blocks_per_group = e2_le32(s + 32);
    out->inodes_per_group = e2_le32(s + 40);
    out->state = (int)e2_le16(s + 58);
    out->rev_level = (int)e2_le32(s + 76);
    out->inode_size = e2_le16(s + 88);
    out->feature_compat = e2_le32(s + 92);
    out->feature_incompat = e2_le32(s + 96);
    e2_copy(out->volume_name, (int)sizeof out->volume_name, s + 120, 16);
    e2_copy(out->last_mounted, (int)sizeof out->last_mounted, s + 136, 64);
    if (out->block_size < 1024 || out->block_size > 16384)
        return -1;
    if (out->inode_size == 0)
        out->inode_size = 128;          /* rev 0 的隐式值 */
    if (out->inode_size < 128 || out->inode_size > 1024)
        return -1;
    if (out->inodes_count == 0 || out->blocks_count == 0)
        return -1;
    if (out->blocks_per_group == 0 || out->inodes_per_group == 0)
        return -1;
    return 1;
}

static u64 ext2_gdt_off(const Ext2Super *sb)
{
    return ((u64)sb->first_data_block + 1u) * (u64)sb->block_size;
}

int ext2_group(const void *src, int n, const Ext2Super *sb, int idx,
               Ext2Group *out)
{
    const u8 *p = (const u8 *)src;
    u64 off = 0;
    const u8 *g = 0;

    if (!src || !sb || !out || idx < 0)
        return -1;
    off = ext2_gdt_off(sb) + (u64)idx * 32u;
    if (off + 32u > (u64)n)
        return -1;
    g = p + (int)off;
    out->block_bitmap = e2_le32(g + 0);
    out->inode_bitmap = e2_le32(g + 4);
    out->inode_table = e2_le32(g + 8);
    out->free_blocks = (int)e2_le16(g + 12);
    out->free_inodes = (int)e2_le16(g + 14);
    out->used_dirs = (int)e2_le16(g + 16);
    if (out->inode_table == 0)
        return -1;
    return 1;
}

int ext2_inode(const void *src, int n, const Ext2Super *sb, int ino,
               Ext2Inode *out)
{
    const u8 *p = (const u8 *)src;
    Ext2Group g = { 0 };
    int group = 0, local = 0;
    u64 off = 0;
    const u8 *i = 0;

    if (!src || !sb || !out || ino <= 0)
        return -1;
    if (ino > (int)sb->inodes_count)
        return -1;
    group = (ino - 1) / (int)sb->inodes_per_group;
    local = (ino - 1) % (int)sb->inodes_per_group;
    if (ext2_group(src, n, sb, group, &g) != 1)
        return -1;
    off = (u64)g.inode_table * (u64)sb->block_size
          + (u64)local * (u64)sb->inode_size;
    if (off + 128u > (u64)n)
        return -1;
    i = p + (int)off;
    out->mode = (int)e2_le16(i + 0);
    out->size = e2_le32(i + 4);
    out->atime = e2_le32(i + 8);
    out->ctime = e2_le32(i + 12);
    out->mtime = e2_le32(i + 16);
    out->nlink = (int)e2_le16(i + 26);
    out->first_block = e2_le32(i + 40);
    out->dir_acl_block = e2_le32(i + 104);
    return 1;
}

/* ---- 自测 ---- */

static void e2_put32(u8 *p, u32 v)
{
    p[0] = (u8)(v & 0xFF);
    p[1] = (u8)((v >> 8) & 0xFF);
    p[2] = (u8)((v >> 16) & 0xFF);
    p[3] = (u8)((v >> 24) & 0xFF);
}

static void e2_put16(u8 *p, int v)
{
    p[0] = (u8)(v & 0xFF);
    p[1] = (u8)((v >> 8) & 0xFF);
}

/* 1024 字节块、8192 块、2 个块组、inode 128 字节 */
static void mk_ext2(u8 *buf)
{
    u8 *s = buf + 1024;

    memset(buf, 0, 32768);
    e2_put32(s + 0, 256);               /* inodes_count */
    e2_put32(s + 4, 8192);              /* blocks_count */
    e2_put32(s + 12, 7000);             /* free_blocks */
    e2_put32(s + 20, 1);                /* first_data_block */
    e2_put32(s + 24, 0);                /* 1024 字节块 */
    e2_put32(s + 32, 8192);             /* blocks_per_group */
    e2_put32(s + 40, 128);              /* inodes_per_group */
    e2_put16(s + 56, 0xEF53);
    e2_put16(s + 58, 1);                /* clean */
    e2_put32(s + 76, 1);                /* rev_level */
    e2_put16(s + 88, 128);
    memcpy(s + 120, "TESTFS", 6);
    memcpy(s + 136, "/mnt/test", 9);
    /* 块组描述符表在块 2（偏移 2048） */
    e2_put32(buf + 2048 + 0, 3);        /* block_bitmap */
    e2_put32(buf + 2048 + 4, 4);        /* inode_bitmap */
    e2_put32(buf + 2048 + 8, 10);       /* inode_table */
    e2_put16(buf + 2048 + 12, 3500);
    e2_put16(buf + 2048 + 14, 60);
    e2_put16(buf + 2048 + 16, 3);
    e2_put32(buf + 2048 + 32, 5);
    e2_put32(buf + 2048 + 36, 6);
    e2_put32(buf + 2048 + 40, 200);
    /* inode 表在块 10（偏移 10240）：1 号在 +0，2 号在 +128 */
    e2_put16(buf + 10240 + 0, 0x8000);  /* 坏块 inode */
    e2_put16(buf + 10240 + 128 + 0, 0x41ED);   /* 根目录 */
    e2_put32(buf + 10240 + 128 + 4, 4096);
    e2_put32(buf + 10240 + 128 + 16, 1700000000);
    e2_put16(buf + 10240 + 128 + 26, 3);
    e2_put32(buf + 10240 + 128 + 40, 11);
}

test "ext2：超级块与块组描述符" {
    static u8 buf[32768] = { 0 };
    Ext2Super sb = { 0 };
    Ext2Group g = { 0 };

    mk_ext2(buf);
    if (ext2_super(buf, (int)sizeof buf, &sb) != 1)
        return err(1, "超级块解析失败");
    if (sb.inodes_count != 256 || sb.blocks_count != 8192
        || sb.free_blocks != 7000)
        return err(2, "计数不对");
    if (sb.block_size != 1024 || sb.first_data_block != 1)
        return err(3, "块大小或首个数据块不对");
    if (sb.blocks_per_group != 8192 || sb.inodes_per_group != 128
        || sb.inode_size != 128)
        return err(4, "每组参数不对");
    if (sb.state != 1 || sb.rev_level != 1)
        return err(5, "状态或修订号不对");
    if (memcmp(sb.volume_name, "TESTFS", 6) != 0 || sb.volume_name[6] != 0)
        return err(6, "卷名不对");
    if (memcmp(sb.last_mounted, "/mnt/test", 9) != 0)
        return err(7, "挂载点不对");
    if (ext2_group(buf, (int)sizeof buf, &sb, 0, &g) != 1)
        return err(8, "块组 0 取不到");
    if (g.block_bitmap != 3 || g.inode_bitmap != 4 || g.inode_table != 10)
        return err(9, "块组 0 的表位置不对");
    if (g.free_blocks != 3500 || g.free_inodes != 60 || g.used_dirs != 3)
        return err(10, "块组 0 的统计不对");
    if (ext2_group(buf, (int)sizeof buf, &sb, 1, &g) != 1
        || g.inode_table != 200)
        return err(11, "块组 1 取不到");
}

test "ext2：inode 与坏数据" {
    static u8 buf[32768] = { 0 };
    Ext2Super sb = { 0 };
    Ext2Inode in = { 0 };

    mk_ext2(buf);
    if (ext2_super(buf, (int)sizeof buf, &sb) != 1)
        return err(12, "超级块解析失败");
    if (ext2_inode(buf, (int)sizeof buf, &sb, 2, &in) != 1)
        return err(13, "根目录 inode 取不到");
    if (in.mode != 0x41ED || in.size != 4096)
        return err(14, "根目录 inode 模式/大小不对");
    if (in.nlink != 3 || in.first_block != 11 || in.mtime != 1700000000)
        return err(15, "根目录 inode 链接/块/时间不对");
    if (ext2_inode(buf, (int)sizeof buf, &sb, 1, &in) != 1
        || in.mode != 0x8000)
        return err(16, "1 号 inode 应该是坏块 inode");
    if (ext2_inode(buf, (int)sizeof buf, &sb, 0, &in) != -1)
        return err(17, "0 号 inode 应该 -1");
    if (ext2_inode(buf, (int)sizeof buf, &sb, 9999, &in) != -1)
        return err(18, "超界 inode 应该 -1");
    /* 魔数不对 */
    buf[1024 + 56] = 0;
    if (ext2_super(buf, (int)sizeof buf, &sb) != -1)
        return err(19, "魔数不对应该 -1");
    /* 块大小越界 */
    mk_ext2(buf);
    e2_put32(buf + 1024 + 24, 9);
    if (ext2_super(buf, (int)sizeof buf, &sb) != -1)
        return err(20, "块大小 512KB 应该 -1");
}
