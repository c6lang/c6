/* examples/stdlegacy.c6 —— 第三十九批（老图形格式）的集成示例。
 *
 *     cmake --build build --target std-legacy
 *
 * 四节：PCX（8 位调色板 + RLE）、Radiance HDR（RGBE）、XBM（C 源码位图）、
 * XPM（C 源码彩图）。四种数据都在内存里现场拼，不依赖外部文件。
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.text.str;
import std.data.pcx;
import std.data.hdr;
import std.data.xbm;
import std.data.xpm;

static int checks = 0;
static int fails = 0;

static void check(int cond, const char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("   ✗ %s\n", what);
    }
}

static void w16(char *p, int v)
{
    p[0] = (char)(v & 0xFF);
    p[1] = (char)((v >> 8) & 0xFF);
}

static void do_pcx(void)
{
    static char buf[2048] = { 0 };
    static u32 px[16] = { 0 };
    PcxInfo info = { 0 };
    int off = 0, i = 0, n = 0;

    printf("== pcx\n");
    buf[0] = 0x0A;
    buf[1] = 5;
    buf[2] = 1;                        /* RLE */
    buf[3] = 8;
    w16(buf + 8, 3);                   /* 宽 4 */
    w16(buf + 10, 1);                  /* 高 2 */
    buf[65] = 1;
    w16(buf + 66, 4);
    buf[68] = 2;
    off = 128;
    buf[off++] = 1;
    buf[off++] = 2;
    buf[off++] = 3;
    buf[off++] = 4;
    buf[off++] = (char)0xC4;           /* 四个 5 */
    buf[off++] = 5;
    buf[off++] = 0x0C;
    for (i = 0; i < 256; i++) {
        buf[off++] = (char)i;
        buf[off++] = (char)(255 - i);
        buf[off++] = (char)(i / 2);
    }
    n = off;
    check(pcx_info(buf, n, &info) == 1, "头解析");
    printf("   %dx%d，%d 位，%d 平面\n", info.width, info.height, info.bpp,
           info.planes);
    check(info.width == 4 && info.height == 2, "尺寸");
    check(pcx_decode(buf, n, px, 8) == 8, "解码像素数");
    printf("   第一行色号：%d %d %d %d\n", (int)((px[0] >> 24) & 0xFF),
           (int)((px[1] >> 24) & 0xFF), (int)((px[2] >> 24) & 0xFF),
           (int)((px[3] >> 24) & 0xFF));
    check(((px[0] >> 24) & 0xFF) == 1 && ((px[3] >> 24) & 0xFF) == 4,
          "第一行像素");
    check(px[4] == px[7], "RLE 行四像素相同");
}

static void do_hdr(void)
{
    static char buf[512] = { 0 };
    static u8 rgbe[16] = { 0 };
    static u8 rgb[12] = { 0 };
    HdrInfo info = { 0 };
    int off = 0, n = 0;

    printf("== hdr\n");
    {
        static const char *h = "#?RADIANCE\nFORMAT=32-bit_rle_rgbe\n\n-Y 2 +X 1\n";

        off = (int)strlen(h);
        memcpy(buf, h, (size_t)off);
    }
    {
        u8 px[8] = { 200, 100, 50, 129, 128, 128, 128, 128 };
        int i = 0;

        for (i = 0; i < 8; i++)
            buf[off++] = (char)px[i];
    }
    n = off;
    check(hdr_info(buf, n, &info) == 1, "头解析");
    printf("   %dx%d\n", info.width, info.height);
    check(info.width == 1 && info.height == 2, "尺寸");
    check(hdr_decode(buf, n, rgbe, (int)sizeof rgbe) == 8, "解码");
    check(rgbe[0] == 200 && rgbe[3] == 129, "第一个像素 RGBE");
    check(hdr_to_rgb(rgbe, 2, rgb, 1.0) == 2, "转 RGB");
    printf("   转成 RGB：(%d,%d,%d) 与 (%d,%d,%d)\n", rgb[0], rgb[1], rgb[2],
           rgb[3], rgb[4], rgb[5]);
    check(rgb[0] == 255 && rgb[1] == 200 && rgb[2] == 100, "色调映射夹到 255");
    check(rgb[3] == 128, "E=128 时 R=128 保持 128");
}

static void do_xbm(void)
{
    static const char *src =
        "#define icon_width 10\n"
        "#define icon_height 2\n"
        "static unsigned char icon_bits[] = {\n"
        "   0x55, 0x01, 0xaa, 0x02 };\n";
    static unsigned char bits[8] = { 0 };
    XbmInfo info = { 0 };
    int n = (int)strlen(src);

    printf("== xbm\n");
    check(xbm_info(src, n, &info) == 1, "头解析");
    printf("   %dx%d，每行 %d 字节\n", info.width, info.height, info.stride);
    check(info.width == 10 && info.height == 2 && info.stride == 2,
          "尺寸与 stride");
    check(xbm_decode(src, n, bits, (int)sizeof bits) == 4, "解码字节数");
    check(xbm_pixel(bits, 10, 0, 0) == 1 && xbm_pixel(bits, 10, 1, 0) == 0,
          "位序：低位在左");
    check(xbm_pixel(bits, 10, 8, 0) == 1 && xbm_pixel(bits, 10, 9, 0) == 0,
          "跨字节的第二字节");
    check(xbm_pixel(bits, 10, 0, 1) == 0 && xbm_pixel(bits, 10, 1, 1) == 1,
          "第二行");
}

static void do_xpm(void)
{
    static const char *src =
        "/* XPM */\n"
        "static char *p[] = {\n"
        "\"3 2 3 1\",\n"
        "\"  c None\",\n"
        "\"r c #FF0000\",\n"
        "\"g c #00FF00\",\n"
        "\"r g\",\n"
        "\"  r\"};\n";
    static u32 px[8] = { 0 };
    XpmInfo info = { 0 };
    int n = (int)strlen(src);

    printf("== xpm\n");
    check(xpm_info(src, n, &info) == 1, "头解析");
    printf("   %dx%d，%d 色，每像素 %d 字符\n", info.width, info.height,
           info.ncolors, info.cpp);
    check(info.width == 3 && info.height == 2 && info.ncolors == 3,
          "头字段");
    check(xpm_decode(src, n, px, 8) == 6, "解码像素数");
    check(px[0] == 0xFF0000FFu && px[1] == 0 && px[2] == 0x00FF00FFu,
          "第一行像素");
    check(px[3] == 0 && px[4] == 0 && px[5] == 0xFF0000FFu, "第二行像素");
    check((px[0] & 0xFF) == 0xFF && (px[1] & 0xFF) == 0, "alpha 正确");
}

int main(void)
{
    do_pcx();
    do_hdr();
    do_xbm();
    do_xpm();
    printf("\n%d check(s), %d failure(s)\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
