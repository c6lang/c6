/* diag.c6 —— 诊断器（design.md §12：带列号与源码片段，不像 tcc 只有行号）
 *
 * 位置一律是 (SrcFile, off)：行号由行号表二分算出，列号 = off - 行首 + 1。
 * 输出格式与 gcc/tcc 一致（path:line:col: error: msg），编辑器与 CI 都能直接解析。
 */

typedef struct Diag {
    int errors;
    int warnings;
} Diag;

static Diag DG;

/* 一行已经拼好的诊断打到 stderr。解析器（parse.c6 的 pa_error /
 * pa_warn_tcc）也走这里；计数留在各自的调用方（diag_vreport 数 DG，
 * pa_error 数 PA_ERRS），两边口径不混。 */
static void diag_emit(const char *line)
{
    fprintf(stderr, "%s\n", line);
}

static void diag_vreport(int is_err, SrcFile *f, u32 off, const char *fmt, va_list ap)
{
    char msg[1024] = {0};
    int n = 0;

    if (f) {
        u32 line = src_line_of(f, off);
        /* 列号必须按**物理**行走：`#line` 之后报出来的行号已经重映射过，
         * 拿它去查行首表会取错（甚至越界）。 */
        u32 col = off - f->lines[src_phys_line_of(f, off) - 1] + 1;
        n = snprintf(msg, sizeof(msg), "%s:%u:%u: %s: ", src_path_of(f), line, col,
                     is_err ? "error" : "warning");
    } else {
        n = snprintf(msg, sizeof(msg), "c6c: %s: ", is_err ? "error" : "warning");
    }
    /* snprintf 截断时返回的是"本来要写多少"：夹到缓冲区里再拼正文，
     * 免得 msg + n 越过末尾。 */
    if (n < 0)
        n = 0;
    if (n > (int)sizeof(msg) - 2)
        n = (int)sizeof(msg) - 2;
    vsnprintf(msg + n, sizeof(msg) - (size_t)n, fmt, ap);
    msg[sizeof(msg) - 1] = 0;
    diag_emit(msg);
    if (is_err)
        DG.errors++;
    else
        DG.warnings++;
}

static void diag_error(SrcFile *f, u32 off, const char *fmt, ...)
{
    va_list ap = {0};
    va_start(ap, fmt);
    diag_vreport(1, f, off, fmt, ap);
    va_end(ap);
}

static void diag_warn(SrcFile *f, u32 off, const char *fmt, ...)
{
    va_list ap = {0};
    va_start(ap, fmt);
    diag_vreport(0, f, off, fmt, ap);
    va_end(ap);
}

/* 驱动层面的错误（参数不对、找不到文件）：没有源码位置 */
static void diag_error_plain(const char *fmt, ...)
{
    va_list ap = {0};
    va_start(ap, fmt);
    diag_vreport(1, NULL, 0, fmt, ap);
    va_end(ap);
}
