            || TOK_EQ(bt, "__builtin_clzl") || TOK_EQ(bt, "__builtin_ctzl")
            || TOK_EQ(bt, "__builtin_ffs") || TOK_EQ(bt, "__builtin_ffsl")
            || TOK_EQ(bt, "__builtin_popcount"))
