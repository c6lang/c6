/* std/text/aho：Aho-Corasick 多模式匹配（一次扫描找出所有模式的所有出现）。
 *
 *     import std.text.aho;
 *
 *     AhoNode pool[256] = { { 0, 0, 0, 0, 0, 0 } };
 *     Aho a = { 0 };
 *     AhoHit hits[8] = { { 0, 0, 0 } };
 *     Str pats[3] = { S("he"), S("she"), S("hers") };
 *     a.build(pool, 256, pats, 3);            // 方法：build / scan / node_count
 *     int n = a.scan(S("ushers"), hits, 8);   // she@1、he@2、hers@2
 *
 * 节点由调用方给（`AhoNode` 数组、`cap` 个），每个节点存「第一个孩子 + 兄弟链 +
 * 失败指针 + 命中的模式编号与长度」，内存是 O(模式总长度)。兄弟链查找是线性扫描
 * （最坏每步 256 次比较），模式总长度在几千字节内够用。
 *
 * 约定：
 *
 * - `a.build(nodes, cap, pats, npats)` 构造自动机并返回节点数，失败返回 -1；
 *   空模式被跳过，`pattern_count()` 只数非空模式；
 * - `a.scan(text, hits, maxhits)` 返回**实际写入**的命中条数（超过 `maxhits` 截断）；
 *   命中按「结束位置从左到右、同一结束位置短的先」给出，`hit.start` 是起始字节；
 * - `a.node_count()` 是节点数，`a.pattern_count()` 是非空模式数；
 * - 重复模式只保留第一次的 `id`；
 * - 按字节匹配，UTF-8 文本上安全。
 */
#include <string.h>

module std.text.aho;
import std.core.types;
import std.text.str;

struct AhoNode {
    int ch;
    int child;
    int sibling;
    int fail;
    int id;
    int len;
};

struct AhoHit {
    int id;
    int start;
    int len;
};

struct Aho {
    AhoNode *nodes;
    int n;
    int cap;
    int npat;
};

static int ah_new_node(Aho *a)
{
    AhoNode *nd = 0;

    if (a->n >= a->cap)
        return -1;
    nd = &a->nodes[a->n];
    memset(nd, 0, sizeof *nd);
    nd->child = -1;
    nd->sibling = -1;
    nd->id = -1;
    a->n++;
    return a->n - 1;
}

static int ah_child(Aho *a, int node, int ch)
{
    int c = a->nodes[node].child;

    while (c >= 0) {
        if (a->nodes[c].ch == ch)
            return c;
        c = a->nodes[c].sibling;
    }
    return -1;
}

static int ah_add_child(Aho *a, int node, int ch)
{
    int c = ah_new_node(a);

    if (c < 0)
        return -1;
    a->nodes[c].ch = ch;
    a->nodes[c].sibling = a->nodes[node].child;
    a->nodes[node].child = c;
    return c;
}

/* 从 node 沿失败链走一步字符 ch，返回新状态 */
static int ah_step(Aho *a, int node, int ch)
{
    int s = node;

    while (1) {
        int c = ah_child(a, s, ch);

        if (c >= 0)
            return c;
        if (s == 0)
            return 0;
        s = a->nodes[s].fail;
    }
}

int build(Aho *a, void *nodes, int cap, Str *pats, int npats)
{
    static int queue[8192];
    int i = 0, k = 0;

    if (!a || !nodes || cap <= 0 || !pats || npats < 0)
        return -1;
    memset(a, 0, sizeof *a);
    a->nodes = (AhoNode *)nodes;
    a->cap = cap;
    a->n = 0;
    memset(nodes, 0, sizeof(AhoNode) * (size_t)cap);
    if (ah_new_node(a) < 0)
        return -1;
    for (i = 0; i < npats; i++) {
        int node = 0;

        if (!pats[i].s.data || pats[i].s.len <= 0)
            continue;
        for (k = 0; k < pats[i].s.len; k++) {
            int ch = (unsigned char)pats[i].s.data[k];
            int c = ah_child(a, node, ch);

            if (c < 0) {
                c = ah_add_child(a, node, ch);
                if (c < 0)
                    return -1;
            }
            node = c;
        }
        if (a->nodes[node].id < 0) {
            a->nodes[node].id = i;
            a->nodes[node].len = pats[i].s.len;
            a->npat++;
        }
    }
    /* 广度优先算失败指针（孩子下标一定大于父下标） */
    {
        int front = 0, end = 0;

        queue[0] = 0;
        end = 1;
        while (front < end) {
            int node = queue[front++];
            int c = a->nodes[node].child;

            while (c >= 0) {
                if (node == 0) {
                    a->nodes[c].fail = 0;
                } else {
                    int f = ah_step(a, a->nodes[node].fail, a->nodes[c].ch);

                    if (f == c)
                        f = 0;
                    a->nodes[c].fail = f;
                }
                if (end < 8192)
                    queue[end++] = c;
                c = a->nodes[c].sibling;
            }
        }
    }
    return a->n;
}

int node_count(Aho *a)
{
    return a ? a->n : 0;
}

int pattern_count(Aho *a)
{
    return a ? a->npat : 0;
}

int scan(Aho *a, char[:] text, AhoHit *hits, int maxhits)
{
    int state = 0, i = 0, n = 0;

    if (!a || !a->nodes || !text.data || !hits || maxhits <= 0)
        return -1;
    for (i = 0; i < text.len; i++) {
        int ch = (unsigned char)text.data[i];
        int s = 0;

        state = ah_step(a, state, ch);
        s = state;
        while (1) {
            if (a->nodes[s].id >= 0 && n < maxhits) {
                hits[n].id = a->nodes[s].id;
                hits[n].len = a->nodes[s].len;
                hits[n].start = i - a->nodes[s].len + 1;
                n++;
            }
            if (s == 0)
                break;
            s = a->nodes[s].fail;
        }
    }
    return n;
}

/* 命中里模式 id 为 want 的条数 */
int count_id(AhoHit *hits, int n, int want)
{
    int i = 0, k = 0;

    if (!hits || n <= 0)
        return 0;
    for (i = 0; i < n; i++) {
        if (hits[i].id == want)
            k++;
    }
    return k;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "aho：多模式扫描" {
    static AhoNode pool[64] = { { 0, 0, 0, 0, 0, 0 } };
    Aho a = { 0 };
    AhoHit hits[16] = { { 0, 0, 0 } };
    Str pats[3] = { (Str){ (char[:]){ 0, 0 } }, (Str){ (char[:]){ 0, 0 } },
                    (Str){ (char[:]){ 0, 0 } } };
    int n = 0;

    pats[0] = (Str){ S("he") };
    pats[1] = (Str){ S("she") };
    pats[2] = (Str){ S("hers") };
    if (a.build(pool, 64, pats, 3) < 4)
        return err(1, "build 失败");
    if (a.pattern_count() != 3)
        return err(2, "模式数不对");
    n = a.scan(S("ushers"), hits, 16);
    if (n != 3)
        return err(3, "ushers 里应该有 3 条命中（she/he/hers）");
    if (hits[0].id != 1 || hits[0].start != 1 || hits[0].len != 3)
        return err(4, "第一条应该是 she@1");
    if (hits[1].id != 0 || hits[1].start != 2)
        return err(5, "第二条应该是 he@2");
    if (hits[2].id != 2 || hits[2].start != 2 || hits[2].len != 4)
        return err(6, "第三条应该是 hers@2");
    if (count_id(hits, n, 0) != 1 || count_id(hits, n, 1) != 1)
        return err(7, "按 id 统计不对");
}

test "aho：重叠、空模式与截断" {
    static AhoNode pool[64] = { { 0, 0, 0, 0, 0, 0 } };
    Aho a = { 0 };
    AhoHit hits[16] = { { 0, 0, 0 } };
    Str pats[3] = { (Str){ (char[:]){ 0, 0 } }, (Str){ (char[:]){ 0, 0 } },
                    (Str){ (char[:]){ 0, 0 } } };
    int n = 0;

    pats[0] = (Str){ S("aa") };
    pats[1] = (Str){ S("aaa") };
    pats[2] = (Str){ (char[:]){ 0, 0 } };
    if (a.build(pool, 64, pats, 3) < 0)
        return err(8, "build 失败");
    if (a.pattern_count() != 2)
        return err(9, "空模式应该被跳过");
    n = a.scan(S("aaaa"), hits, 16);
    if (n != 5)
        return err(10, "aaaa 应该有 5 条命中（aa×3 + aaa×2）");
    if (count_id(hits, n, 0) != 3 || count_id(hits, n, 1) != 2)
        return err(11, "aa/aaa 的命中数不对");
    if (a.scan(S("aaaa"), hits, 2) != 2)
        return err(12, "maxhits=2 时应该只写入 2 条");
    if (a.scan(S("xyz"), hits, 16) != 0)
        return err(13, "没有命中应该返回 0");
    {
        Str one[1] = { (Str){ (char[:]){ 0, 0 } } };

        one[0] = (Str){ S("z") };
        a.build(pool, 64, one, 1);
        if (a.scan(S("azaz"), hits, 16) != 2)
            return err(14, "单模式计数不对");
        if (hits[0].start != 1 || hits[1].start != 3)
            return err(15, "单模式的位置不对");
    }
    if (a.build(0, 64, pats, 2) != -1 || a.build(pool, 0, pats, 2) != -1)
        return err(16, "空指针或 0 容量应该 -1");
}
