/* std/data/ply：PLY 网格（ASCII 格式，游标式取顶点与面）。
 *
 *     import std.data.ply;
 *
 *     PlyDoc d = { 0 };
 *     d.load(text, len);              // 方法：解析头 + 统计
 *     double x = 0, y = 0, z = 0;
 *     while (d.next_vertex(&x, &y, &z)) { … }
 *     d.restart();
 *     int a = 0, b = 0, c = 0, n = 0;
 *     while (d.next_face(&a, &b, &c, &n)) { … }   // n = 顶点数
 *
 * 只支持 `format ascii 1.0`。头里的 `element vertex <n>` / `element face <m>` 与
 * `property` 会真的被解析：顶点的 `x`/`y`/`z` 可以不在前三列（记列号），面用
 * `property list uchar int vertex_indices` 那种「先个数再下标」的写法。其它
 * element（`edge`、`material`…）整段跳过。
 *
 * 约定：
 *
 * - `d.load(src, len)`：成功返回 1；不是 PLY / 不是 ASCII / 缺 `end_header`
 *   返回 -1；`src` 必须比解析周期活得久（只记指针）；
 * - `d.next_vertex(&x,&y,&z)` / `d.next_face(&a,&b,&c,&n)` 推进游标，取完返回 0；
 * - `d.vertex(i, …)` / `d.face(i, …)` 随机访问（内部重扫，O(n)），越界 -1；
 * - `d.restart()` 两个游标一起归零（顶点游标在前，面游标接着往后走）；
 * - `d.count_vertices()`/`d.count_faces()` 头里的数字，`d.prop_count()` 顶点属性列数，
 *   `d.xyz_columns(&ix,&iy,&iz)` 这三列在顶点行里的列号（从 0 起）；
 * - `d.is_ascii()` 恒为 1（二进制 PLY 直接 `load` 失败，返回 -1）。
 */
#include <stdlib.h>
#include <string.h>

module std.data.ply;
import std.core.types;
import std.text.str;

struct PlyDoc {
    const char *src;
    int len;
    int nv;
    int nf;
    int nprop;
    int xi;
    int yi;
    int zi;
    int dstart;     /* 数据区起点（end_header 之后） */
    int vpos;
    int fpos;
    int vidx;
    int fidx;
};

static int ply_sep(char c)
{
    return c == ' ' || c == '\t' || c == '\r';
}

static const char *ply_eol(const char *p, const char *end)
{
    while (p < end && *p != '\n')
        p++;
    return p;
}

static int ply_word(const char *p, const char *end, char *buf, int cap)
{
    int n = 0;

    while (p < end && ply_sep(*p))
        p++;
    while (p < end && !ply_sep(*p) && *p != '\n') {
        if (n < cap - 1)
            buf[n] = *p;
        n++;
        p++;
    }
    if (n < cap)
        buf[n] = '\0';
    else
        buf[cap - 1] = '\0';
    return n;
}

/* 在 p 起的一行里跳过前 k 个词，返回第 k+1 个词的起点 */
static const char *ply_skip_words(const char *p, const char *end, int k)
{
    int i = 0;

    for (i = 0; i < k; i++) {
        while (p < end && ply_sep(*p))
            p++;
        while (p < end && !ply_sep(*p) && *p != '\n')
            p++;
    }
    while (p < end && ply_sep(*p))
        p++;
    return p;
}

int load(PlyDoc *d, const char *src, int len)
{
    const char *p = 0;
    const char *end = 0;
    char key[32] = { 0 };
    int in_vertex = 0;
    int in_face = 0;
    int ascii = 0;

    if (!d || !src || len <= 0)
        return -1;
    memset(d, 0, sizeof *d);
    d->src = src;
    d->len = len;
    d->xi = 0;
    d->yi = 1;
    d->zi = 2;
    end = src + len;
    p = src;
    /* 第一行必须是 ply */
    ply_word(p, end, key, (int)sizeof key);
    if (strcmp(key, "ply") != 0)
        return -1;
    p = ply_eol(p, end);
    if (p < end)
        p++;
    while (p < end) {
        const char *nl = ply_eol(p, end);

        ply_word(p, end, key, (int)sizeof key);
        if (strcmp(key, "format") == 0) {
            char fmt[32] = { 0 };

            ply_word(ply_skip_words(p, end, 1), end, fmt, (int)sizeof fmt);
            if (strcmp(fmt, "ascii") != 0)
                return -1;
            ascii = 1;
        } else if (strcmp(key, "element") == 0) {
            char name[32] = { 0 };
            char num[32] = { 0 };

            ply_word(ply_skip_words(p, end, 1), end, name, (int)sizeof name);
            ply_word(ply_skip_words(p, end, 2), end, num, (int)sizeof num);
            in_vertex = strcmp(name, "vertex") == 0;
            in_face = strcmp(name, "face") == 0;
            if (in_vertex)
                d->nv = (int)strtol(num, 0, 10);
            else if (in_face)
                d->nf = (int)strtol(num, 0, 10);
        } else if (strcmp(key, "property") == 0) {
            if (in_vertex) {
                char pname[32] = { 0 };

                /* property <type> <name> 或 property list … */
                ply_word(ply_skip_words(p, end, 1), end, pname, (int)sizeof pname);
                if (strcmp(pname, "list") == 0)
                    ply_word(ply_skip_words(p, end, 3), end, pname,
                             (int)sizeof pname);
                else
                    ply_word(ply_skip_words(p, end, 2), end, pname,
                             (int)sizeof pname);
                if (strcmp(pname, "x") == 0)
                    d->xi = d->nprop;
                else if (strcmp(pname, "y") == 0)
                    d->yi = d->nprop;
                else if (strcmp(pname, "z") == 0)
                    d->zi = d->nprop;
                d->nprop++;
            }
        } else if (strcmp(key, "end_header") == 0) {
            p = nl;
            if (p < end)
                p++;
            d->dstart = (int)(p - src);
            d->vpos = d->dstart;
            d->fpos = d->dstart;
            return ascii && d->nv >= 0 && d->nprop > 0 ? 1 : -1;
        }
        p = nl;
        if (p < end)
            p++;
    }
    return -1;
}

int count_vertices(PlyDoc *d)
{
    return d ? d->nv : 0;
}

int count_faces(PlyDoc *d)
{
    return d ? d->nf : 0;
}

int prop_count(PlyDoc *d)
{
    return d ? d->nprop : 0;
}

int xyz_columns(PlyDoc *d, int *ix, int *iy, int *iz)
{
    if (!d || !ix || !iy || !iz)
        return -1;
    *ix = d->xi;
    *iy = d->yi;
    *iz = d->zi;
    return 1;
}

int is_ascii(PlyDoc *d)
{
    return d && d->src ? 1 : 0;
}

void restart(PlyDoc *d)
{
    if (d) {
        d->vidx = 0;
        d->fidx = 0;
        d->vpos = d->dstart;
        d->fpos = d->dstart;
    }
}

/* 顶点游标：从 (d->vpos) 往后读第 vidx 行；读完 nv 行就停在顶点区末尾 */
static int ply_read_vertex_row(PlyDoc *d, const char **out_start)
{
    const char *p = 0;
    const char *end = 0;

    end = d->src + d->len;
    p = d->src + d->vpos;
    if (d->vidx >= d->nv)
        return 0;
    if (!out_start)
        return 1;
    *out_start = p;
    return 1;
}

int next_vertex(PlyDoc *d, double *x, double *y, double *z)
{
    const char *p = 0;
    const char *end = 0;
    char *stop = 0;
    int i = 0;
    double cols[32] = { 0 };
    int want = 0;

    if (!d || !x || !y || !z || d->vidx >= d->nv)
        return 0;
    if (!ply_read_vertex_row(d, &p))
        return 0;
    end = d->src + d->len;
    want = d->nprop < 32 ? d->nprop : 32;
    for (i = 0; i < want; i++) {
        cols[i] = strtod(p, &stop);
        if (stop == p)
            return 0;
        p = stop;
    }
    if (d->xi >= want || d->yi >= want || d->zi >= want)
        return 0;
    *x = cols[d->xi];
    *y = cols[d->yi];
    *z = cols[d->zi];
    d->vidx++;
    /* 记录下一行起点（跳过行尾空白） */
    while (p < end && (*p == '\r' || *p == ' ' || *p == '\t'))
        p++;
    if (p < end && *p == '\n')
        p++;
    d->vpos = (int)(p - d->src);
    if (d->fpos < d->vpos)
        d->fpos = d->vpos;
    return 1;
}

int next_face(PlyDoc *d, int *a, int *b, int *c, int *n)
{
    const char *p = 0;
    const char *end = 0;
    char *stop = 0;
    int cnt = 0;
    int i = 0;
    int idx[3] = { -1, -1, -1 };

    if (!d || !a || !b || !c || !n || d->fidx >= d->nf)
        return 0;
    if (d->fpos < d->vpos)
        d->fpos = d->vpos;
    p = d->src + d->fpos;
    end = d->src + d->len;
    cnt = (int)strtol(p, &stop, 10);
    if (stop == p)
        return 0;
    p = stop;
    if (cnt < 3)
        return 0;
    for (i = 0; i < cnt; i++) {
        int v = (int)strtol(p, &stop, 10);

        if (stop == p)
            return 0;
        p = stop;
        if (i < 3)
            idx[i] = v;
    }
    *a = idx[0];
    *b = idx[1];
    *c = idx[2];
    *n = cnt;
    d->fidx++;
    /* 下一行 */
    while (p < end && (*p == '\r' || *p == ' ' || *p == '\t'))
        p++;
    if (p < end && *p == '\n')
        p++;
    d->fpos = (int)(p - d->src);
    return 1;
}

int vertex(PlyDoc *d, int i, double *x, double *y, double *z)
{
    int k = 0;

    if (!d || i < 0 || i >= d->nv)
        return -1;
    d->vidx = 0;
    d->vpos = d->fpos = d->dstart;
    for (k = 0; k <= i; k++) {
        if (!next_vertex(d, x, y, z))
            return -1;
    }
    return 1;
}

int face(PlyDoc *d, int i, int *a, int *b, int *c, int *n)
{
    int k = 0;

    if (!d || i < 0 || i >= d->nf)
        return -1;
    /* 先把顶点区整段走完，再逐面取 */
    {
        double x = 0, y = 0, z = 0;

        d->vidx = 0;
        d->vpos = d->fpos = d->dstart;
        while (next_vertex(d, &x, &y, &z))
            ;
    }
    d->fidx = 0;
    for (k = 0; k <= i; k++) {
        if (!next_face(d, a, b, c, n))
            return -1;
    }
    return 1;
}

/* ---- 自测 ---- */

static const char *ply_demo =
    "ply\n"
    "format ascii 1.0\n"
    "comment 一个单位正方形\n"
    "element vertex 4\n"
    "property float x\n"
    "property float y\n"
    "property float z\n"
    "property uchar red\n"
    "element face 2\n"
    "property list uchar int vertex_indices\n"
    "end_header\n"
    "0 0 0 255\n"
    "1 0 0 128\n"
    "1 1 0 64\n"
    "0 1 0 0\n"
    "3 0 1 2\n"
    "3 0 2 3\n";

test "ply：头解析与游标取顶点" {
    PlyDoc d = { 0 };
    double x = 0.0, y = 0.0, z = 0.0;
    int ix = -1, iy = -1, iz = -1;
    int n = 0;

    if (d.load(ply_demo, (int)strlen(ply_demo)) != 1)
        return err(1, "load 失败");
    if (d.count_vertices() != 4 || d.count_faces() != 2)
        return err(2, "顶点/面计数不对");
    if (d.prop_count() != 4)
        return err(3, "顶点属性应该是 4 列");
    if (d.xyz_columns(&ix, &iy, &iz) != 1 || ix != 0 || iy != 1 || iz != 2)
        return err(4, "x/y/z 列号不对");
    while (d.next_vertex(&x, &y, &z))
        n++;
    if (n != 4)
        return err(5, "游标应该走 4 个顶点");
    d.restart();
    if (!d.next_vertex(&x, &y, &z) || x != 0.0 || y != 0.0 || z != 0.0)
        return err(6, "第一个顶点不对");
    d.next_vertex(&x, &y, &z);
    d.next_vertex(&x, &y, &z);
    if (!d.next_vertex(&x, &y, &z) || x != 0.0 || y != 1.0)
        return err(7, "第四个顶点应该是 (0,1,0)");
    if (d.next_vertex(&x, &y, &z) != 0)
        return err(8, "取完应该返回 0");
}

test "ply：面、随机访问与格式判断" {
    PlyDoc d = { 0 };
    int a = 0, b = 0, c = 0, n = 0;
    double x = 0.0, y = 0.0, z = 0.0;

    d.load(ply_demo, (int)strlen(ply_demo));
    /* 先走完顶点区，再逐面取 */
    while (d.next_vertex(&x, &y, &z))
        ;
    if (!d.next_face(&a, &b, &c, &n) || n != 3)
        return err(9, "第一个面应该是三角形");
    if (a != 0 || b != 1 || c != 2)
        return err(10, "第一个面的索引不对");
    if (!d.next_face(&a, &b, &c, &n) || a != 0 || b != 2 || c != 3)
        return err(11, "第二个面的索引不对");
    if (d.next_face(&a, &b, &c, &n) != 0)
        return err(12, "取完应该返回 0");
    if (d.face(1, &a, &b, &c, &n) != 1 || b != 2 || c != 3)
        return err(13, "face(1) 不对");
    if (d.face(5, &a, &b, &c, &n) != -1 || d.vertex(9, &x, &y, &z) != -1)
        return err(14, "越界应该 -1");
    if (d.vertex(2, &x, &y, &z) != 1 || x != 1.0 || y != 1.0)
        return err(15, "vertex(2) 应该是 (1,1,0)");
    if (d.is_ascii() != 1)
        return err(16, "ASCII 标记不对");
    /* 非 PLY / 二进制 PLY */
    {
        PlyDoc e = { 0 };

        if (e.load("not a ply\n", 10) != -1)
            return err(17, "非 PLY 应该 -1");
        if (e.load("ply\nformat binary_little_endian 1.0\n", 34) != -1)
            return err(18, "二进制 PLY 应该 -1");
        if (e.load("ply\nformat ascii 1.0\nelement vertex 1\nproperty float x\n",
                   52) != -1)
            return err(19, "缺 end_header 应该 -1");
    }
}
