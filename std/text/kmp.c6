/* std/text/kmp：Knuth-Morris-Pratt 子串查找（失败函数 + O(n+m) 扫描）。
 *
 *     import std.text.kmp;
 *
 *     int fail[16] = { 0 };
 *     Kmp k = { 0 };
 *     k.init(S("abab"), fail, 16);       // 方法：init / find / count / match_at
 *     k.find(S("xxababab")) ;            // 2
 *     k.count(S("abab abab"));           // 2（可重叠）
 *
 * `Kmp` 里存模式串（视图）与失败函数（调用方给的 `int` 数组）。
 *
 * 约定：
 *
 * - `init(pattern, fail, cap)` 计算失败函数，`cap < pattern.len` 返回 -1，
 *   返回模式长度；空模式返回 -1；
 * - `find(text)` 返回第一次出现的下标，找不到返回 -1；
 * - `count(text)` 数**可重叠**的出现次数（`abab` 在 `ababab` 里算 2 次）；
 * - `match_at(text, i)` 判断从 i 开始是否匹配，返回 1/0（要求 i 处有足够字节）；
 * - `fail_len()` 返回失败函数数组长度（= 模式长度），`pattern_len()` 同义；
 * - 匹配按**字节**比较，UTF-8 文本上多字节字符也安全（不会被拆开误匹配）。
 */
#include <string.h>

module std.text.kmp;
import std.core.types;
import std.text.str;

struct Kmp {
    Str pat;
    int *fail;
    int m;
};

int init(Kmp *k, char[:] pattern, int *fail, int cap)
{
    int i = 0, j = 0;

    if (!k || !pattern.data || !fail || pattern.len <= 0)
        return -1;
    if (cap < pattern.len)
        return -1;
    k->pat = (Str){ (char[:]){ pattern.data, pattern.len } };
    k->fail = fail;
    k->m = pattern.len;
    fail[0] = 0;
    for (i = 1; i < k->m; i++) {
        j = fail[i - 1];
        while (j > 0 && pattern.data[i] != pattern.data[j])
            j = fail[j - 1];
        if (pattern.data[i] == pattern.data[j])
            j++;
        fail[i] = j;
    }
    return k->m;
}

int pattern_len(Kmp *k)
{
    return k ? k->m : 0;
}

int fail_len(Kmp *k)
{
    return k ? k->m : 0;
}

int find(Kmp *k, char[:] text)
{
    int i = 0, j = 0;

    if (!k || !k->pat.s.data || !k->fail || !text.data)
        return -1;
    for (i = 0; i < text.len; i++) {
        while (j > 0 && text.data[i] != k->pat.s.data[j])
            j = k->fail[j - 1];
        if (text.data[i] == k->pat.s.data[j])
            j++;
        if (j == k->m) {
            return i - j + 1;
        }
    }
    return -1;
}

int count(Kmp *k, char[:] text)
{
    int i = 0, j = 0, n = 0;

    if (!k || !k->pat.s.data || !k->fail || !text.data)
        return -1;
    for (i = 0; i < text.len; i++) {
        while (j > 0 && text.data[i] != k->pat.s.data[j])
            j = k->fail[j - 1];
        if (text.data[i] == k->pat.s.data[j])
            j++;
        if (j == k->m) {
            n++;
            j = k->fail[j - 1];         /* 允许重叠 */
        }
    }
    return n;
}

int match_at(Kmp *k, char[:] text, int i)
{
    if (!k || !text.data || i < 0 || i + k->m > text.len)
        return 0;
    return memcmp(text.data + i, k->pat.s.data, (size_t)k->m) == 0;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "kmp：失败函数与查找" {
    int fail[16] = { 0 };
    Kmp k = { 0 };

    if (k.init(S("abab"), fail, 16) != 4)
        return err(1, "init 失败");
    if (fail[0] != 0 || fail[1] != 0 || fail[2] != 1 || fail[3] != 2)
        return err(2, "abab 的失败函数应该是 0,0,1,2");
    if (k.pattern_len() != 4 || k.fail_len() != 4)
        return err(3, "长度方法不对");
    if (k.find(S("xxababab")) != 2)
        return err(4, "第一次出现在下标 2");
    if (k.find(S("ababab")) != 0)
        return err(5, "从 0 开始出现");
    if (k.find(S("nope")) != -1)
        return err(6, "找不到应该 -1");
    if (k.count(S("ababab")) != 2)
        return err(7, "可重叠计数应该是 2");
    if (k.match_at(S("xxabab"), 2) != 1 || k.match_at(S("xxabab"), 1) != 0)
        return err(8, "match_at 不对");
    if (k.match_at(S("abab"), 3) != 0)
        return err(9, "尾部越界应该 0");
}

test "kmp：边界" {
    int fail[8] = { 0 };
    Kmp k = { 0 };

    if (k.init(S("aaa"), fail, 8) != 3)
        return err(10, "init 失败");
    if (fail[1] != 1 || fail[2] != 2)
        return err(11, "aaa 的失败函数应该是 0,1,2");
    if (k.count(S("aaaaa")) != 3)
        return err(12, "aaa 在 aaaaa 里应该出现 3 次");
    if (k.find(S("")) != -1)
        return err(13, "空文本找不到");
    if (k.init(S(""), fail, 8) != -1)
        return err(14, "空模式应该 -1");
    if (k.init(S("abc"), fail, 2) != -1)
        return err(15, "失败函数数组太小应该 -1");
    if (k.init(S("abc"), 0, 8) != -1)
        return err(16, "空数组指针应该 -1");
    /* 单字节模式 */
    {
        int f1[2] = { 0 };
        Kmp k1 = { 0 };

        k1.init(S("z"), f1, 2);
        if (k1.count(S("zazzz")) != 4)
            return err(17, "单字节模式的计数不对");
    }
}
