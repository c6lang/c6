/* std/net/cookie：HTTP Cookie / Set-Cookie 的零分配解析。
 *
 *     import std.net.cookie;
 *
 *     Cookie c = cookie_parse_set(
 *         S("sid=abc; Path=/; Max-Age=3600; Secure; HttpOnly; SameSite=Lax"));
 *     c.name;  c.value;                 // "sid", "abc"
 *     c.path();                         // "/"
 *     c.is_secure();  c.is_http_only(); // 1, 1
 *     c.same_site();                    // "Lax"
 *
 * `Cookie` 只包输入上的视图：第一段 `name=value` 和后面用 `;` 分隔的属性都
 * 不复制。属性名大小写不敏感；`Secure`/`HttpOnly` 这种没有值的旗标也算存在。
 * 需要任意属性时用 `attribute(S("Domain"))`，已知的 `path`/`domain`/`expires`/
 * `same_site` 只是薄包装。`max_age(&out)` 把 `Max-Age` 解析成 int，返回 1/0
 * （0 表示没有或不是十进制）。
 *
 * 不处理引号里的分号（`value="a;b"` 会被当成两段）——这一层刻意做小，需要
 * 完整 RFC 6265 引号语法时先自己拆好再传进来。
 */
#include <string.h>

module std.net.cookie;
import std.core.types;
import std.text.str;

enum Error { OK = 0, PARSE = 1, INVAL = 2 };

struct Cookie {
    Str raw;
    Str name;
    Str value;
    int attr_start;     /* 第一个 ';' 之后的偏移 */
    int ok;
    int err;
};

static Str ck_empty(void)
{
    return (Str){ { (char *)0, 0 } };
}

static int ck_space(int c) { return c == ' ' || c == '\t'; }

static int ck_token_char(int c)
{
    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
        || (c >= '0' && c <= '9'))
        return 1;
    return c == '!' || c == '#' || c == '$' || c == '%' || c == '&'
        || c == '\'' || c == '*' || c == '+' || c == '-' || c == '.'
        || c == '^' || c == '_' || c == '`' || c == '|' || c == '~';
}

static int ck_token(Str s)
{
    int i = 0;

    if (s.s.len <= 0)
        return 0;
    for (i = 0; i < s.s.len; i++)
        if (!ck_token_char((u8)s.s.data[i]))
            return 0;
    return 1;
}

static int ck_ctl(Str s)
{
    int i = 0;

    for (i = 0; i < s.s.len; i++) {
        int c = (u8)s.s.data[i];

        if (c < 0x20 && c != '\t')
            return 1;
    }
    return 0;
}

static Str ck_trim(Str s)
{
    int a = 0;
    int b = s.s.len;

    while (a < b && ck_space((u8)s.s.data[a]))
        a++;
    while (b > a && ck_space((u8)s.s.data[b - 1]))
        b--;
    s.s = (char[:]){ s.s.data + a, b - a };
    return s;
}

static int ck_ieq(Str a, Str b)
{
    int i = 0;

    if (a.s.len != b.s.len)
        return 0;
    for (i = 0; i < a.s.len; i++) {
        int ca = (u8)a.s.data[i];
        int cb = (u8)b.s.data[i];

        if (ca >= 'A' && ca <= 'Z')
            ca += 'a' - 'A';
        if (cb >= 'A' && cb <= 'Z')
            cb += 'a' - 'A';
        if (ca != cb)
            return 0;
    }
    return 1;
}

/* 第一段 name=value：名字必须是 token，值去掉首尾空白，不能有控制字符。 */
static int ck_pair(Str s, Str *name, Str *value)
{
    int i = 0;
    int eq = -1;

    for (i = 0; i < s.s.len; i++) {
        if (s.s.data[i] == '=') {
            eq = i;
            break;
        }
    }
    if (eq <= 0)
        return 0;
    name->s = (char[:]){ s.s.data, eq };
    *name = ck_trim(*name);
    if (!ck_token(*name))
        return 0;
    value->s = (char[:]){ s.s.data + eq + 1, s.s.len - eq - 1 };
    *value = ck_trim(*value);
    if (ck_ctl(*value))
        return 0;
    return 1;
}

/* 属性段：有 '=' 分开，没有 '=' 当旗标（value 是空视图）。 */
static int ck_attr(Str s, Str *name, Str *value, int *has_value)
{
    int i = 0;
    int eq = -1;

    for (i = 0; i < s.s.len; i++) {
        if (s.s.data[i] == '=') {
            eq = i;
            break;
        }
    }
    if (eq < 0) {
        *name = ck_trim(s);
        *value = ck_empty();
        *has_value = 0;
        return ck_token(*name);
    }
    name->s = (char[:]){ s.s.data, eq };
    *name = ck_trim(*name);
    value->s = (char[:]){ s.s.data + eq + 1, s.s.len - eq - 1 };
    *value = ck_trim(*value);
    *has_value = 1;
    return ck_token(*name) && !ck_ctl(*value);
}

static Cookie ck_fail(int ecode)
{
    Cookie c = { 0 };

    c.err = ecode;
    return c;
}

Cookie cookie_parse_set(Str header)
{
    Cookie c = { 0 };
    Str seg = { 0 };
    Str name = { 0 };
    Str value = { 0 };
    int p = 0;
    int i = 0;
    int semi = -1;

    if (!header.s.data || header.s.len <= 0)
        return ck_fail(INVAL);
    c.raw = header;
    for (i = 0; i < header.s.len; i++)
        if (header.s.data[i] == '\r' || header.s.data[i] == '\n')
            return ck_fail(PARSE);
    for (i = 0; i < header.s.len; i++) {
        if (header.s.data[i] == ';') {
            semi = i;
            break;
        }
    }
    seg.s = (char[:]){ header.s.data, semi < 0 ? header.s.len : semi };
    if (!ck_pair(ck_trim(seg), &name, &value))
        return ck_fail(PARSE);
    c.name = name;
    c.value = value;
    c.attr_start = semi < 0 ? header.s.len : semi + 1;

    p = c.attr_start;
    while (p < header.s.len) {
        int start = p;
        int hv = 0;

        while (p < header.s.len && header.s.data[p] != ';')
            p++;
        seg.s = (char[:]){ header.s.data + start, p - start };
        seg = ck_trim(seg);
        if (seg.s.len > 0) {
            if (!ck_attr(seg, &name, &value, &hv))
                return ck_fail(PARSE);
        }
        if (p < header.s.len)
            p++;
    }
    c.ok = 1;
    return c;
}

/* Cookie: 头里的一段（第一个 ';' 之前）。 */
int cookie_parse_pair(Str header, Str *name, Str *value)
{
    int i = 0;
    int semi = -1;

    if (!name || !value || !header.s.data || header.s.len <= 0)
        return 0;
    for (i = 0; i < header.s.len; i++) {
        if (header.s.data[i] == ';') {
            semi = i;
            break;
        }
    }
    if (semi < 0)
        semi = header.s.len;
    return ck_pair(ck_trim((Str){ (char[:]){ header.s.data, semi } }),
                   name, value);
}

/* 按属性名取第一个值；旗标属性给空视图，找不到也给空视图。 */
Str attribute(Cookie *self, Str name)
{
    Str seg = { 0 };
    Str an = { 0 };
    Str av = { 0 };
    int p = 0;
    int hv = 0;

    if (!self || !self->ok)
        return ck_empty();
    p = self->attr_start;
    while (p < self->raw.s.len) {
        int start = p;

        while (p < self->raw.s.len && self->raw.s.data[p] != ';')
            p++;
        seg.s = (char[:]){ self->raw.s.data + start, p - start };
        seg = ck_trim(seg);
        if (seg.s.len > 0 && ck_attr(seg, &an, &av, &hv)
            && ck_ieq(an, name))
            return av;
        if (p < self->raw.s.len)
            p++;
    }
    return ck_empty();
}

int has_attribute(Cookie *self, Str name)
{
    Str seg = { 0 };
    Str an = { 0 };
    Str av = { 0 };
    int p = 0;
    int hv = 0;

    if (!self || !self->ok)
        return 0;
    p = self->attr_start;
    while (p < self->raw.s.len) {
        int start = p;

        while (p < self->raw.s.len && self->raw.s.data[p] != ';')
            p++;
        seg.s = (char[:]){ self->raw.s.data + start, p - start };
        seg = ck_trim(seg);
        if (seg.s.len > 0 && ck_attr(seg, &an, &av, &hv)
            && ck_ieq(an, name))
            return 1;
        if (p < self->raw.s.len)
            p++;
    }
    return 0;
}

Str path(Cookie *self) { return self->attribute((Str){ (char[:]){ (char *)"Path", 4 } }); }

Str domain(Cookie *self) { return self->attribute((Str){ (char[:]){ (char *)"Domain", 6 } }); }

Str expires(Cookie *self)
{
    return self->attribute((Str){ (char[:]){ (char *)"Expires", 7 } });
}

Str same_site(Cookie *self)
{
    return self->attribute((Str){ (char[:]){ (char *)"SameSite", 8 } });
}

int is_secure(Cookie *self)
{
    return self->has_attribute((Str){ (char[:]){ (char *)"Secure", 6 } });
}

int is_http_only(Cookie *self)
{
    return self->has_attribute((Str){ (char[:]){ (char *)"HttpOnly", 8 } });
}

/* Max-Age：十进制（可带负号）；没有或语法错给 0。 */
int max_age(Cookie *self, int *out)
{
    Str v = { 0 };
    i64 n = 0;
    int i = 0;
    int neg = 0;

    if (!self || !out || !self->ok)
        return 0;
    v = self->attribute((Str){ (char[:]){ (char *)"Max-Age", 7 } });
    if (v.s.len <= 0)
        return 0;
    if (v.s.data[0] == '-') {
        neg = 1;
        i = 1;
    }
    if (i >= v.s.len)
        return 0;
    for (; i < v.s.len; i++) {
        int d = 0;

        if (v.s.data[i] < '0' || v.s.data[i] > '9')
            return 0;
        d = v.s.data[i] - '0';
        if (n > (2147483647ll - d) / 10)
            return 0;
        n = n * 10 + d;
    }
    *out = (int)(neg ? -n : n);
    return 1;
}

/* 写 `name=value`；cap 不够返回 -1 且不写半截。 */
int cookie_write_pair(Str name, Str value, char *dst, int cap)
{
    int need = name.s.len + 1 + value.s.len;

    if (need > cap || (need > 0 && !dst))
        return -1;
    memcpy(dst, name.s.data, name.s.len);
    dst[name.s.len] = '=';
    memcpy(dst + name.s.len + 1, value.s.data, value.s.len);
    return need;
}

/* ---- 自测 ---- */

static Str cs(const char *s)
{
    return (Str){ (char[:]){ (char *)s, (int)strlen(s) } };
}

test "Set-Cookie 的 name/value 与属性" {
    Cookie c = cookie_parse_set(cs("sid=abc123; Path=/app; Domain=example.com; "
                                   "Max-Age=3600; Secure; HttpOnly; SameSite=Lax"));
    char buf[32] = { 0 };
    int age = 0;

    if (!c.ok || c.err != 0)
        return err(1, "合法 Set-Cookie 没有解析成功");
    if (c.name.s.len != 3 || memcmp(c.name.s.data, "sid", 3) != 0
        || c.value.s.len != 6 || memcmp(c.value.s.data, "abc123", 6) != 0)
        return err(2, "name/value 不对");
    if (c.path().s.len != 4 || memcmp(c.path().s.data, "/app", 4) != 0)
        return err(3, "Path 不对");
    if (c.domain().s.len != 11 || memcmp(c.domain().s.data, "example.com", 11) != 0)
        return err(4, "Domain 不对");
    if (c.same_site().s.len != 3 || memcmp(c.same_site().s.data, "Lax", 3) != 0)
        return err(5, "SameSite 不对");
    if (!c.is_secure() || !c.is_http_only())
        return err(6, "Secure/HttpOnly 旗标不对");
    if (!c.max_age(&age) || age != 3600)
        return err(7, "Max-Age 不对");
    if (!c.has_attribute(cs("path")) || c.has_attribute(cs("Partitioned")))
        return err(8, "has_attribute 或大小写不对");
    if (cookie_write_pair(c.name, c.value, buf, sizeof buf) != 10
        || strcmp(buf, "sid=abc123") != 0)
        return err(9, "cookie_write_pair 不对");
}

test "Cookie 头的一段与重复 = " {
    Str name = { 0 };
    Str value = { 0 };
    Cookie c = cookie_parse_set(cs("x=a=b=c; Path=/"));

    if (!c.ok || c.value.s.len != 5 || memcmp(c.value.s.data, "a=b=c", 5) != 0)
        return err(10, "第一个 = 之后的值不对");
    if (!cookie_parse_pair(cs("  token = v = 2 ; next=3"), &name, &value))
        return err(11, "cookie_parse_pair 失败");
    if (name.s.len != 5 || memcmp(name.s.data, "token", 5) != 0
        || value.s.len != 5 || memcmp(value.s.data, "v = 2", 5) != 0)
        return err(12, "cookie_parse_pair 的 trim/切分不对");
}

test "非法输入与空指针" {
    Cookie a = cookie_parse_set(cs("no-equals; Path=/"));
    Cookie b = cookie_parse_set(cs("x=1; bad name"));
    Cookie c = cookie_parse_set(cs("x=1; =bad"));
    Cookie e = cookie_parse_set(cs("x=1\r\nPath=/"));
    Cookie empty = cookie_parse_set(cs(""));
    Cookie *np = 0;
    int age = 0;

    if (a.ok || a.err != PARSE || b.ok || c.ok || e.ok)
        return err(13, "非法 Set-Cookie 没有被拒绝");
    if (empty.ok || empty.err != INVAL)
        return err(14, "空输入没有给 INVAL");
    if (np->has_attribute(cs("Path")) || np->is_secure()
        || np->path().s.len != 0 || np->max_age(&age))
        return err(15, "空指针方法没有兜住");
    if (cookie_write_pair(cs("a"), cs("b"), 0, 4) != -1)
        return err(16, "空缓冲没有返回 -1");
}

test "Max-Age 边界与缺省属性" {
    Cookie c = cookie_parse_set(cs("k=v"));
    Cookie d = cookie_parse_set(cs("k=v; Max-Age=-5"));
    Cookie e = cookie_parse_set(cs("k=v; Max-Age=nope"));
    int age = 0;

    if (!c.ok || c.name.s.len != 1 || c.value.s.len != 1)
        return err(17, "最小 cookie 不对");
    if (c.has_attribute(cs("Path")) || c.path().s.len != 0
        || c.max_age(&age))
        return err(18, "缺省属性不该存在");
    if (!d.max_age(&age) || age != -5)
        return err(19, "负 Max-Age 不对");
    if (e.max_age(&age))
        return err(20, "非法 Max-Age 没有给 0");
}
