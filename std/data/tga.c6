/* std/data/tga：Truevision TGA 解码（未压缩/RLE 真彩，零分配）。
 *
 *     import std.data.tga;
 *
 *     TgaInfo t = tga_parse(buf, n);
 *     if (t.valid) {
 *         unsigned char rgba[4096];
 *         int px = tga_decode(buf, n, rgba, (int)sizeof rgba);
 *     }
 *
 * 支持：类型 2（未压缩真彩）与类型 10（RLE 真彩），24/32 位，左下/左上/
 * 右下/右上四种原点（`origin`），解成 RGBA8888。TGA 的像素在文件里是
 * **BGR(A)** 顺序，`decode` 会换回 RGB。
 *
 * 不支持：调色板类型（1/9）、灰度（3/11）、16 位、类型 0 的 RLE 包跨行
 * 约束之外的变体（RLE 包可以跨行，解码时按一维像素流处理，符合规范）。
 *
 * 约定：`tga_parse` 的 `valid=0` 表示头/长度不对；`tga_decode` 返回像素数
 * （w*h），失败 -1。
 */
#include <string.h>

module std.data.tga;
import std.core.types;

struct TgaInfo {
    int valid;
    int width;
    int height;
    int bpp;
    int type;
    int top_origin;
    int right_origin;
    i64 data_offset;
};

static TgaInfo tga_bad(void)
{
    TgaInfo t = { 0, 0, 0, 0, 0, 0, 0, 0 };

    return t;
}

static int tga_rd16(const u8 *p) { return (int)p[0] | ((int)p[1] << 8); }

TgaInfo tga_parse(const void *p, int n)
{
    TgaInfo t = { 0, 0, 0, 0, 0, 0, 0, 0 };
    const u8 *h = (const u8 *)p;
    int id_len = 0, cmap = 0, cmap_bits = 0;

    if (!p || n < 18)
        return tga_bad();
    id_len = h[0];
    cmap = h[1];
    t.type = h[2];
    cmap_bits = h[7];
    t.width = tga_rd16(h + 12);
    t.height = tga_rd16(h + 14);
    t.bpp = h[16];
    if (t.type != 2 && t.type != 10)
        return tga_bad();
    if (cmap != 0 || cmap_bits != 0)
        return tga_bad();
    if (t.bpp != 24 && t.bpp != 32)
        return tga_bad();
    if (t.width <= 0 || t.height <= 0)
        return tga_bad();
    t.top_origin = (h[17] & 0x20) ? 1 : 0;
    t.right_origin = (h[17] & 0x10) ? 1 : 0;
    t.data_offset = 18 + (i64)id_len;
    if (t.data_offset > (i64)n)
        return tga_bad();
    if (t.type == 2
        && t.data_offset + (i64)t.width * t.height * (t.bpp / 8) > (i64)n)
        return tga_bad();
    t.valid = 1;
    return t;
}

int tga_decode(const void *p, int n, void *rgba, int cap)
{
    TgaInfo t = tga_parse(p, n);
    const u8 *src = 0;
    u8 *dst = (u8 *)rgba;
    int total = 0, done = 0, pos = 0, bpp = 0;

    if (!t.valid || !rgba || cap < t.width * t.height * 4)
        return -1;
    bpp = t.bpp / 8;
    total = t.width * t.height;
    src = (const u8 *)p;
    pos = (int)t.data_offset;
    while (done < total) {
        int count = 1, rle = 0;

        if (t.type == 10) {
            if (pos >= n)
                return -1;
            count = (src[pos] & 0x7f) + 1;
            rle = (src[pos] & 0x80) ? 1 : 0;
            pos++;
            if (done + count > total)
                return -1;
        }
        {
            int k = 0;
            u8 px[4] = { 0, 0, 0, 255 };

            for (k = 0; k < count && done < total; k++) {
                u8 *o = 0;

                if (rle) {
                    if (pos + bpp > n)
                        return -1;
                    px[0] = src[pos + 2];
                    px[1] = src[pos + 1];
                    px[2] = src[pos + 0];
                    px[3] = (bpp == 4) ? src[pos + 3] : 255;
                } else {
                    if (pos + bpp > n)
                        return -1;
                    px[0] = src[pos + 2];
                    px[1] = src[pos + 1];
                    px[2] = src[pos + 0];
                    px[3] = (bpp == 4) ? src[pos + 3] : 255;
                    pos += bpp;
                }
                /* 文件里的像素顺序：左下（默认）或左上 */
                {
                    int idx = done + k;
                    int row = idx / t.width;
                    int col = idx % t.width;
                    int y = t.top_origin ? row : (t.height - 1 - row);
                    int x = t.right_origin ? (t.width - 1 - col) : col;

                    o = dst + ((i64)y * t.width + x) * 4;
                    o[0] = px[0];
                    o[1] = px[1];
                    o[2] = px[2];
                    o[3] = px[3];
                }
            }
            done += count;
            if (rle)
                pos += bpp;
        }
    }
    return total;
}

/* ---- 自测 ---- */

static int hexval(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    return -1;
}

static int unhex(const char *s, u8 *dst, int cap)
{
    int n = 0;

    while (s[0] && s[1] && n < cap) {
        int hi = hexval(s[0]), lo = hexval(s[1]);

        if (hi < 0 || lo < 0)
            return -1;
        dst[n++] = (u8)(hi * 16 + lo);
        s += 2;
    }
    return n;
}

/* 2x2 RLE 真彩 24 位、左下原点；文件顺序 = 底行（蓝、白）→ 顶行（红、绿） */
static const char *TGA_RLE =
    "00000a00000000000000000002000200180003ff0000ffffff0000ff00ff00";

test "RLE 真彩 TGA 解码" {
    u8 buf[64] = { 0 };
    u8 rgba[64] = { 0 };
    int n = unhex(TGA_RLE, buf, (int)sizeof buf);
    TgaInfo t = tga_parse(buf, n);

    if (!t.valid || t.width != 2 || t.height != 2 || t.bpp != 24)
        return err(1, "TGA 头不对");
    if (t.type != 10 || t.top_origin || t.right_origin)
        return err(2, "类型/原点不对");
    if (tga_decode(buf, n, rgba, (int)sizeof rgba) != 4)
        return err(3, "应该解出 4 个像素");
    if (rgba[0] != 255 || rgba[1] != 0 || rgba[2] != 0)
        return err(4, "左上角应该是红色");
    if (rgba[4] != 0 || rgba[5] != 255 || rgba[6] != 0)
        return err(5, "右上角应该是绿色");
    if (rgba[8] != 0 || rgba[9] != 0 || rgba[10] != 255)
        return err(6, "左下角应该是蓝色");
    if (rgba[12] != 255 || rgba[13] != 255 || rgba[14] != 255)
        return err(7, "右下角应该是白色");
}

test "未压缩 32 位、左上原点与错误路径" {
    u8 buf[128] = { 0 };
    u8 rgba[64] = { 0 };
    int m = 0;

    /* 头 18 字节：type 2、2x2、32 位、origin 0x28（左上 + 8 位 alpha） */
    m = unhex("000002000000000000000000020002002028", buf, (int)sizeof buf);
    /* 像素按左上原点顺序：红、绿 / 蓝、半透明白 */
    {
        static const u8 px[16] = {
            0, 0, 255, 255,     /* BGR = 红 */
            0, 255, 0, 255,     /* 绿 */
            255, 0, 0, 255,     /* 蓝 */
            255, 255, 255, 128, /* 半透明白 */
        };

        memcpy(buf + m, px, sizeof px);
        m += (int)sizeof px;
    }
    {
        TgaInfo t = tga_parse(buf, m);

        if (!t.valid || !t.top_origin || t.type != 2)
            return err(8, "未压缩 TGA 头不对");
        if (tga_decode(buf, m, rgba, (int)sizeof rgba) != 4)
            return err(9, "未压缩解码失败");
        if (rgba[0] != 255 || rgba[1] != 0 || rgba[2] != 0
            || rgba[3] != 255)
            return err(10, "左上像素不对");
        if (rgba[8] != 0 || rgba[9] != 0 || rgba[10] != 255)
            return err(11, "左下像素不对");
        if (rgba[12] != 255 || rgba[13] != 255 || rgba[14] != 255
            || rgba[15] != 128)
            return err(12, "右下像素的 alpha 不对");
    }
    /* 坏类型 / 调色板 / 位宽 / 截断 */
    {
        u8 bad[128] = { 0 };

        memcpy(bad, buf, (size_t)m);
        bad[2] = 3;
        if (tga_parse(bad, m).valid)
            return err(13, "灰度类型不该有效");
        memcpy(bad, buf, (size_t)m);
        bad[1] = 1;
        if (tga_parse(bad, m).valid)
            return err(14, "调色板类型不该有效");
        memcpy(bad, buf, (size_t)m);
        bad[16] = 16;
        if (tga_parse(bad, m).valid)
            return err(15, "16 位不该有效");
    }
    if (tga_parse(buf, m - 1).valid)
        return err(16, "未压缩数据截断不该有效");
    if (tga_parse(buf, 10).valid || tga_parse(0, 40).valid)
        return err(17, "短输入/空指针不该有效");
    if (tga_decode(buf, m, rgba, 8) != -1)
        return err(18, "缓冲不够应该 -1");
    if (tga_decode(buf, m, 0, 64) != -1)
        return err(19, "空输出应该 -1");
    /* RLE 包超出像素数 */
    {
        u8 bad[64] = { 0 };
        int n = unhex(TGA_RLE, bad, (int)sizeof bad);

        bad[18] = 0x7f;         /* 128 个像素，但只有 4 个 */
        if (tga_decode(bad, n, rgba, (int)sizeof rgba) != -1)
            return err(20, "RLE 包越界应该 -1");
    }
}
