/* std/core/tridiag：三对角线性方程组（Thomas 算法：一次前代，多次回代）。
 *
 *     import std.core.tridiag;
 *
 *     double lo[3] = { 0, -1, -1 };      // 下对角线（lo[0] 不用）
 *     double di[3] = { 2, 2, 2 };        // 主对角线
 *     double up[3] = { -1, -1, 0 };      // 上对角线（up[n-1] 不用）
 *     double buf[15] = { 0 };            // 5n：lo/di/up 副本 + 2n 工作区
 *     Tridiag t = { 0 };
 *     t.init(lo, di, up, 3, buf);        // 方法：init / solve / det / diag_at
 *     double b[3] = { 1, 0, 1 }, x[3] = { 0 };
 *     t.solve(b, x);                     // x = (1, 1, 1)
 *
 * 三对角系统在数值计算里到处都是（隐式差分、样条、弹簧网格），Thomas 算法是
 * O(n) 的直接解法，比通用高斯消元快一个量级。
 *
 * 约定：
 *
 * - `t.init(lower, diag, upper, n, buf)`：`buf` 是 `5n` 个 `double`（内部会拷贝
 *   lo/di/up，剩下 `2n` 做工作区），主元为 0（退化）时返回 0 且 `t.degenerate() == 1`，
 *   参数错返回 -1；
 * - `t.solve(rhs, x)` 解一遍并把结果写进 `x`，返回 1；退化返回 -1；
 * - `t.det()` 行列式（= 前代主元之积），`t.diag_at(i)` 读原始主对角线元素；
 * - `t.dim()` 阶数，`t.degenerate()` 是否退化；
 * - 一次 `init` 可以反复 `solve`（前代系数只算一次）；
 * - 需要 `-lm`（`Makefile` 的 `std-*` 目标已经带上）。
 */
#include <math.h>
#include <string.h>

module std.core.tridiag;
import std.core.types;
import std.text.str;

struct Tridiag {
    int n;
    double *lo;
    double *di;
    double *up;
    double *cc;     /* 前代系数 */
    double *dd;     /* 前代右端 */
    int degen;
};

int init(Tridiag *t, const double *lower, const double *diag, const double *upper,
         int n, void *buf)
{
    int i = 0;

    if (!t || !lower || !diag || !upper || n <= 0 || !buf)
        return -1;
    memset(t, 0, sizeof *t);
    t->n = n;
    t->lo = (double *)buf;
    t->di = t->lo + n;
    t->up = t->di + n;
    t->cc = t->up + n;
    t->dd = t->cc + n;
    memset(buf, 0, sizeof(double) * (size_t)(5 * n));
    for (i = 0; i < n; i++) {
        t->lo[i] = lower[i];
        t->di[i] = diag[i];
        t->up[i] = upper[i];
    }
    /* 前代：cc[i] = up[i] / m[i]，m[i] = di[i] - lo[i]·cc[i-1] */
    if (fabs(t->di[0]) < 1e-300) {
        t->degen = 1;
        return 0;
    }
    t->cc[0] = t->up[0] / t->di[0];
    for (i = 1; i < n; i++) {
        double m = t->di[i] - t->lo[i] * t->cc[i - 1];

        if (fabs(m) < 1e-300) {
            t->degen = 1;
            return 0;
        }
        t->cc[i] = (i + 1 < n) ? t->up[i] / m : 0.0;
    }
    return 1;
}

int dim(Tridiag *t)
{
    return t ? t->n : 0;
}

int degenerate(Tridiag *t)
{
    return t ? t->degen : 1;
}

double diag_at(Tridiag *t, int i)
{
    if (!t || !t->di || i < 0 || i >= t->n)
        return 0.0;
    return t->di[i];
}

double det(Tridiag *t)
{
    double d = 1.0;
    int i = 0;

    if (!t || !t->di || t->degen)
        return 0.0;
    d = t->di[0];
    for (i = 1; i < t->n; i++)
        d *= t->di[i] - t->lo[i] * t->cc[i - 1];
    return d;
}

int solve(Tridiag *t, const double *rhs, double *x)
{
    int i = 0;

    if (!t || !t->di || !rhs || !x)
        return -1;
    if (t->degen)
        return -1;
    t->dd[0] = rhs[0] / t->di[0];
    for (i = 1; i < t->n; i++) {
        double m = t->di[i] - t->lo[i] * t->cc[i - 1];

        t->dd[i] = (rhs[i] - t->lo[i] * t->dd[i - 1]) / m;
    }
    x[t->n - 1] = t->dd[t->n - 1];
    for (i = t->n - 2; i >= 0; i--)
        x[i] = t->dd[i] - t->cc[i] * x[i + 1];
    return 1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "tridiag：Thomas 求解" {
    double lo[3] = { 0, -1, -1 };
    double di[3] = { 2, 2, 2 };
    double up[3] = { -1, -1, 0 };
    double buf[15] = { 0 };
    Tridiag t = { 0 };
    double b[3] = { 1, 0, 1 };
    double x[3] = { 0, 0, 0 };

    if (t.init(lo, di, up, 3, buf) != 1)
        return err(1, "init 失败");
    if (t.dim() != 3 || t.degenerate() != 0)
        return err(2, "维数/退化标志不对");
    if (fabs(t.det() - 4.0) > 1e-9)
        return err(3, "行列式应该是 4");
    if (t.solve(b, x) != 1)
        return err(4, "求解失败");
    if (fabs(x[0] - 1.0) > 1e-9 || fabs(x[1] - 1.0) > 1e-9
        || fabs(x[2] - 1.0) > 1e-9)
        return err(5, "解应该是 (1,1,1)");
    if (fabs(t.diag_at(2) - 2.0) > 1e-9 || t.diag_at(9) != 0.0)
        return err(6, "diag_at 不对");
    /* 同一分解解另一组右端 */
    {
        double b2[3] = { 0, 0, 0 };

        if (t.solve(b2, x) != 1 || fabs(x[0]) > 1e-12 || fabs(x[2]) > 1e-12)
            return err(7, "零右端应该解出零向量");
    }
}

test "tridiag：退化、大 n 与边界" {
    double lo[3] = { 0, 1, 0 };
    double di[3] = { 1, 1, 1 };
    double up[3] = { 1, 0, 0 };
    double buf[15] = { 0 };
    Tridiag t = { 0 };
    double x[3] = { 0, 0, 0 };

    if (t.init(lo, di, up, 3, buf) != 0 || t.degenerate() != 1)
        return err(8, "退化矩阵应该返回 0");
    if (t.det() != 0.0)
        return err(9, "退化矩阵行列式应该是 0");
    {
        double b[3] = { 1, 2, 3 };

        if (t.solve(b, x) != -1)
            return err(10, "退化矩阵求解应该 -1");
    }
    /* 大一点的系统：一维 Poisson（n=8，解全是 1） */
    {
        double l[8] = { 0, -1, -1, -1, -1, -1, -1, -1 };
        double d[8] = { 2, 2, 2, 2, 2, 2, 2, 2 };
        double u[8] = { -1, -1, -1, -1, -1, -1, -1, 0 };
        double bf[40] = { 0 };
        double b[8] = { 0 }, xx[8] = { 0 };
        int i = 0;
        Tridiag q = { 0 };

        for (i = 0; i < 8; i++)
            b[i] = (i == 0 || i == 7) ? 1.0 : 0.0;
        if (q.init(l, d, u, 8, bf) != 1)
            return err(11, "8 阶 init 失败");
        if (q.solve(b, xx) != 1)
            return err(12, "8 阶求解失败");
        if (fabs(xx[0] - 1.0) > 1e-9 || fabs(xx[4] - 1.0) > 1e-9)
            return err(13, "8 阶解应该全 1");
    }
    if (t.init(lo, di, up, 0, buf) != -1)
        return err(14, "n=0 应该 -1");
}
