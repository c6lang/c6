/* std/container/graph：邻接表图的遍历与最短路（借用调用方数组，零分配）。
 *
 *     import std.container.graph;
 *
 *     int head[5] = { 0 }, next[8] = { 0 }, to[8] = { 0 }, w[8] = { 0 };
 *     Graph g = { 0 };
 *     graph_init(&g, 5, head, next, to, w, 8);
 *     g.add_edge(0, 1, 4);
 *
 *     int dist[5] = { 0 }, prev[5] = { 0 }, heap[5] = { 0 }, pos[5] = { 0 };
 *     g.dijkstra(0, dist, heap, pos, prev);
 *
 * 图用**前向星**表示：每个顶点一条链表（`head[u]` 是第一条边，`next[e]` 指向
 * 同起点的下一条边），所以 `add_edge` 是 O(1)、遍历一个顶点的邻居是沿着链表走。
 * 所有数组都由调用方给，模块本身不分配。
 *
 * 提供的算法：
 *
 * - `bfs`：无权最短路（每条边算 1），`dist` 里不可达是 `GRAPH_INF`。
 * - `dfs`：迭代式前序，避免深图递归爆栈（栈也由调用方给）。
 * - `toposort`：Kahn 算法；有环返回 0（`order` 内容未定义）。
 * - `components`：按「无向」算弱连通分量（并查集）。
 * - `dijkstra`：非负权最短路 + `prev` 回溯链；有负权返回 -1。
 *
 * 约定：所有 `*_init` 返回 1/0；`add_edge` 满了返回 0；遍历函数参数非法或
 * 调用方数组不够放返回 -1；`n = 0` 的图是合法的（所有算法都返回 0）。
 */
#include <string.h>

module std.container.graph;
import std.core.types;

enum GraphLimits {
    GRAPH_INF = 0x3fffffff,      /* 「不可达」的哨兵（加上权重也不溢出） */
};

struct Graph {
    int n;                       /* 顶点数 */
    int m;                       /* 边数 */
    int cap;                     /* 边容量 */
    int *head;                   /* n 个：每个顶点的第一条边下标，-1 = 无边 */
    int *next;                   /* cap 个：同起点的下一条边 */
    int *to;                     /* cap 个：终点 */
    int *w;                      /* cap 个：权重（可为 0/空） */
};

/* 初始化：head 必须能放 n 个 int；next/to（和可选的 w）能放 cap 个 */
int graph_init(Graph *g, int n, int *head, int *next, int *to, int *w, int cap)
{
    int i = 0;

    if (!g || n < 0 || cap < 0)
        return 0;
    if ((n > 0 && !head) || (cap > 0 && (!next || !to)))
        return 0;
    g->n = n;
    g->m = 0;
    g->cap = cap;
    g->head = head;
    g->next = next;
    g->to = to;
    g->w = w;
    for (i = 0; i < n; i++)
        head[i] = -1;
    return 1;
}

int edge_count(Graph *self) { return self ? self->m : 0; }

int vertex_count(Graph *self) { return self ? self->n : 0; }

/* 加一条 u -> v 的边；满了/顶点越界返回 0 */
int add_edge(Graph *self, int u, int v, int weight)
{
    int e = 0;

    if (!self || u < 0 || u >= self->n || v < 0 || v >= self->n)
        return 0;
    if (self->m >= self->cap)
        return 0;
    e = self->m;
    self->to[e] = v;
    if (self->w)
        self->w[e] = weight;
    self->next[e] = self->head[u];
    self->head[u] = e;
    self->m = e + 1;
    return 1;
}

/* 无权 BFS：dist 由调用方给 n 个 int（会被写成距离或 GRAPH_INF）；
 * queue 给 n 个 int。返回可达顶点数，参数错/队列不够返回 -1。 */
int bfs(Graph *self, int src, int *dist, int *queue, int qcap)
{
    int qh = 0, qt = 0, count = 0, i = 0;

    if (!self || !dist || !queue || src < 0 || src >= self->n || qcap <= 0)
        return -1;
    for (i = 0; i < self->n; i++)
        dist[i] = GRAPH_INF;
    dist[src] = 0;
    if (qt >= qcap)
        return -1;
    queue[qt++] = src;
    count = 1;
    while (qh < qt) {
        int u = queue[qh++];
        int e = self->head[u];

        while (e >= 0) {
            int v = self->to[e];

            if (dist[v] == GRAPH_INF) {
                if (qt >= qcap)
                    return -1;
                dist[v] = dist[u] + 1;
                queue[qt++] = v;
                count++;
            }
            e = self->next[e];
        }
    }
    return count;
}

/* 迭代式 DFS 前序：order 写访问顺序（n 个 int），mark 是 n 个 int 的工作区，
 * stack 是 n 个 int 的显式栈；返回访问到的顶点数，参数错返回 -1。 */
int dfs(Graph *self, int src, int *order, int *mark, int *stack, int scap)
{
    int sp = 0, count = 0, i = 0;

    if (!self || !order || !mark || !stack || src < 0 || src >= self->n
        || scap <= 0)
        return -1;
    for (i = 0; i < self->n; i++)
        mark[i] = 0;
    if (sp >= scap)
        return -1;
    stack[sp++] = src;
    while (sp > 0) {
        int u = stack[--sp];
        int e = 0;

        if (mark[u])
            continue;
        mark[u] = 1;
        order[count++] = u;
        /* 邻接链表是头插的；为了按「边的加入顺序」访问，这里把邻居压栈即可
         *（顺序不保证，DFS 的语义只要求先深后广） */
        e = self->head[u];
        while (e >= 0) {
            int v = self->to[e];

            if (!mark[v]) {
                if (sp >= scap)
                    return -1;
                stack[sp++] = v;
            }
            e = self->next[e];
        }
    }
    return count;
}

/* 拓扑排序（Kahn）：order 写 n 个顶点的顺序，indeg/queue 是 n 个 int 的工作区。
 * 返回 1 = 无环（order 有效），0 = 有环，-1 = 参数错。 */
int toposort(Graph *self, int *order, int *indeg, int *queue, int qcap)
{
    int i = 0, qh = 0, qt = 0, n = 0;

    if (!self || !order || !indeg || !queue || qcap < self->n)
        return -1;
    n = self->n;
    for (i = 0; i < n; i++)
        indeg[i] = 0;
    for (i = 0; i < self->m; i++)
        indeg[self->to[i]]++;
    for (i = 0; i < n; i++) {
        if (indeg[i] == 0) {
            if (qt >= qcap)
                return -1;
            queue[qt++] = i;
        }
    }
    {
        int k = 0;

        while (qh < qt) {
            int u = queue[qh++];
            int e = self->head[u];

            order[k++] = u;
            while (e >= 0) {
                int v = self->to[e];

                if (--indeg[v] == 0) {
                    if (qt >= qcap)
                        return -1;
                    queue[qt++] = v;
                }
                e = self->next[e];
            }
        }
        return k == n ? 1 : 0;
    }
}

static int graph_find(int *parent, int x)
{
    while (parent[x] != x) {
        parent[x] = parent[parent[x]];      /* 路径压缩 */
        x = parent[x];
    }
    return x;
}

/* 弱连通分量：parent 是 n 个 int 的工作区；返回分量个数，参数错返回 -1。
 * 结果可以用 parent 的根判断（根的 parent[root] == root）。 */
int components(Graph *self, int *parent)
{
    int i = 0, count = 0;

    if (!self || (self->n > 0 && !parent))
        return -1;
    for (i = 0; i < self->n; i++)
        parent[i] = i;
    /* 用出边遍历：对每个 u，把它和邻居合并 */
    for (i = 0; i < self->n; i++) {
        int e = self->head[i];

        while (e >= 0) {
            int ru = graph_find(parent, i);
            int rv = graph_find(parent, self->to[e]);

            if (ru != rv)
                parent[ru] = rv;
            e = self->next[e];
        }
    }
    for (i = 0; i < self->n; i++) {
        if (graph_find(parent, i) == i)
            count++;
    }
    return count;
}

/* ---- Dijkstra 的二叉堆（按 dist 排） ---- */

static void graph_heap_swap(int *heap, int *pos, int i, int j)
{
    int a = heap[i], b = heap[j];

    heap[i] = b;
    heap[j] = a;
    pos[b] = i;
    pos[a] = j;
}

static void graph_sift_up(int *heap, int *pos, int *dist, int i)
{
    while (i > 0) {
        int p = (i - 1) / 2;

        if (dist[heap[p]] <= dist[heap[i]])
            break;
        graph_heap_swap(heap, pos, i, p);
        i = p;
    }
}

static void graph_sift_down(int *heap, int *pos, int *dist, int n, int i)
{
    for (;;) {
        int l = i * 2 + 1, r = l + 1, best = i;

        if (l < n && dist[heap[l]] < dist[heap[best]])
            best = l;
        if (r < n && dist[heap[r]] < dist[heap[best]])
            best = r;
        if (best == i)
            break;
        graph_heap_swap(heap, pos, i, best);
        i = best;
    }
}

/* 非负权最短路：dist/prev 是 n 个 int 的输出，heap/pos 是 n 个 int 的工作区。
 * 返回 1（dist/prev 有效，不可达是 GRAPH_INF），负权/参数错返回 -1。 */
int dijkstra(Graph *self, int src, int *dist, int *heap, int *pos, int *prev)
{
    int i = 0, hn = 0;

    if (!self || !dist || !heap || !pos || !prev || src < 0 || src >= self->n)
        return -1;
    for (i = 0; i < self->n; i++) {
        dist[i] = GRAPH_INF;
        prev[i] = -1;
        pos[i] = -1;
    }
    dist[src] = 0;
    heap[hn] = src;
    pos[src] = 0;
    hn++;
    while (hn > 0) {
        int u = heap[0];
        int e = 0;

        /* 弹出堆顶 */
        hn--;
        if (hn > 0) {
            heap[0] = heap[hn];
            pos[heap[0]] = 0;
            graph_sift_down(heap, pos, dist, hn, 0);
        }
        pos[u] = -1;
        e = self->head[u];
        while (e >= 0) {
            int v = self->to[e];
            int w = self->w ? self->w[e] : 1;

            if (w < 0)
                return -1;              /* 负权不在 Dijkstra 的适用范围 */
            if (dist[u] < GRAPH_INF && w < GRAPH_INF - dist[u]
                && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                prev[v] = u;
                if (pos[v] < 0) {
                    pos[v] = hn;
                    heap[hn++] = v;
                    graph_sift_up(heap, pos, dist, pos[v]);
                } else {
                    graph_sift_up(heap, pos, dist, pos[v]);
                }
            }
            e = self->next[e];
        }
    }
    return 1;
}

/* ---- 自测 ---- */

struct GTest {
    Graph g;
    int head[8];
    int next[16];
    int to[16];
    int w[16];
    int dist[8];
    int prev[8];
    int heap[8];
    int pos[8];
    int queue[8];
    int order[8];
    int mark[8];
    int stack[8];
    int parent[8];
};

static void gt_init(struct GTest *t, int n, int cap)
{
    memset(t, 0, sizeof *t);
    graph_init(&t->g, n, t->head, t->next, t->to, t->w, cap);
}

test "BFS 与 DFS" {
    struct GTest t = { 0 };

    gt_init(&t, 5, 8);
    if (!t.g.add_edge(0, 1, 1) || !t.g.add_edge(0, 2, 1)
        || !t.g.add_edge(1, 3, 1) || !t.g.add_edge(2, 3, 1)
        || !t.g.add_edge(3, 4, 1))
        return err(1, "建图");
    if (t.g.vertex_count() != 5 || t.g.edge_count() != 5)
        return err(2, "顶点/边计数");
    /* BFS 距离 */
    if (t.g.bfs(0, t.dist, t.queue, 8) != 5)
        return err(3, "BFS 可达数");
    if (t.dist[0] != 0 || t.dist[1] != 1 || t.dist[2] != 1 || t.dist[3] != 2
        || t.dist[4] != 3)
        return err(4, "BFS 距离");
    /* 不可达顶点 */
    {
        struct GTest u = { 0 };

        gt_init(&u, 3, 2);
        u.g.add_edge(0, 1, 1);
        if (u.g.bfs(0, u.dist, u.queue, 8) != 2 || u.dist[2] != GRAPH_INF)
            return err(5, "不可达");
    }
    /* DFS：前序里每个顶点恰好一次，且从 0 能到 5 个 */
    {
        int n = t.g.dfs(0, t.order, t.mark, t.stack, 8);
        int seen[8] = { 0 };
        int i = 0;

        if (n != 5)
            return err(6, "DFS 访问数");
        if (t.order[0] != 0)
            return err(7, "DFS 从源点开始");
        for (i = 0; i < n; i++) {
            if (seen[t.order[i]])
                return err(8, "DFS 重复访问");
            seen[t.order[i]] = 1;
        }
    }
    /* 队列/栈不够 */
    {
        struct GTest v = { 0 };

        gt_init(&v, 4, 3);
        v.g.add_edge(0, 1, 1);
        v.g.add_edge(0, 2, 1);
        v.g.add_edge(0, 3, 1);
        if (v.g.bfs(0, v.dist, v.queue, 2) != -1)
            return err(9, "BFS 队列不够");
        if (v.g.dfs(0, v.order, v.mark, v.stack, 1) != -1)
            return err(10, "DFS 栈不够");
    }
}

test "拓扑排序与连通分量" {
    struct GTest t = { 0 };
    int i = 0, k = 0;

    gt_init(&t, 4, 4);
    /* 0 -> 1 -> 3, 0 -> 2 -> 3 */
    t.g.add_edge(0, 1, 1);
    t.g.add_edge(1, 3, 1);
    t.g.add_edge(0, 2, 1);
    t.g.add_edge(2, 3, 1);
    if (t.g.toposort(t.order, t.mark, t.queue, 8) != 1)
        return err(11, "DAG 拓扑排序");
    /* 检查每条边都满足 order[u] < order[v] */
    {
        int rank[8] = { 0 };

        for (i = 0; i < 4; i++)
            rank[t.order[i]] = i;
        if (!(rank[0] < rank[1] && rank[1] < rank[3]
              && rank[0] < rank[2] && rank[2] < rank[3]))
            return err(12, "拓扑序不满足边方向");
    }
    /* 有环 */
    {
        struct GTest c = { 0 };

        gt_init(&c, 3, 3);
        c.g.add_edge(0, 1, 1);
        c.g.add_edge(1, 2, 1);
        c.g.add_edge(2, 0, 1);
        if (c.g.toposort(c.order, c.mark, c.queue, 8) != 0)
            return err(13, "有环要返回 0");
    }
    /* 弱连通分量 */
    if (t.g.components(t.parent) != 1)
        return err(14, "一个连通块");
    {
        struct GTest d = { 0 };

        gt_init(&d, 4, 2);
        d.g.add_edge(0, 1, 1);
        /* 2、3 孤立 */
        if (d.g.components(d.parent) != 3)
            return err(15, "三个连通块");
        (void)k;
    }
}

test "Dijkstra" {
    struct GTest t = { 0 };

    gt_init(&t, 4, 6);
    t.g.add_edge(0, 1, 4);
    t.g.add_edge(0, 2, 1);
    t.g.add_edge(2, 1, 2);
    t.g.add_edge(1, 3, 1);
    t.g.add_edge(2, 3, 5);
    if (t.g.dijkstra(0, t.dist, t.heap, t.pos, t.prev) != 1)
        return err(16, "Dijkstra 失败");
    if (t.dist[0] != 0 || t.dist[1] != 3 || t.dist[2] != 1 || t.dist[3] != 4)
        return err(17, "最短路距离");
    if (t.prev[1] != 2 || t.prev[2] != 0 || t.prev[3] != 1)
        return err(18, "前驱链");
    /* 从 3 出发只有它自己可达 */
    if (t.g.dijkstra(3, t.dist, t.heap, t.pos, t.prev) != 1
        || t.dist[3] != 0 || t.dist[0] != GRAPH_INF)
        return err(19, "反向不可达");
    /* 负权要拒绝 */
    {
        struct GTest n = { 0 };

        gt_init(&n, 2, 1);
        n.g.add_edge(0, 1, -5);
        if (n.g.dijkstra(0, n.dist, n.heap, n.pos, n.prev) != -1)
            return err(20, "负权");
    }
    /* 参数与容量 */
    {
        struct GTest e = { 0 };

        gt_init(&e, 2, 1);
        if (e.g.add_edge(0, 1, 1) != 1 || e.g.add_edge(0, 1, 1) != 0)
            return err(21, "边容量");
        if (e.g.add_edge(0, 2, 1) != 0 || e.g.add_edge(-1, 0, 1) != 0)
            return err(22, "顶点越界");
        if (e.g.dijkstra(0, (int *)0, e.heap, e.pos, e.prev) != -1)
            return err(23, "空指针");
        if (graph_init((Graph *)0, 1, e.head, e.next, e.to, e.w, 1) != 0)
            return err(24, "空 graph");
    }
    /* 零顶点图 */
    {
        struct GTest z = { 0 };

        gt_init(&z, 0, 0);
        if (z.g.components(z.parent) != 0)
            return err(25, "零顶点分量");
        if (z.g.toposort(z.order, z.mark, z.queue, 8) != 1)
            return err(26, "零顶点拓扑");
    }
}
