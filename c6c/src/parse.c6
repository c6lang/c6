            continue;
        }
        /* `h->join()`：thread 句柄的 join 走 pthread_join */
        if (pa_is_punct("->") && ty_is_thread(GEN_TY) && pa_peek(1)->kind == TK_IDENT
            && TOK_EQ(pa_peek(1), "join") && pa_peek(2)->kind == TK_PUNCT
            && tok_eq(pa_peek(2), "(")) {
            u32 hv = value_of(v);
            u32 pj = x64_sym(&X64, "pthread_join");
            u32 a0 = irfn_vreg(&FN);
            u32 zz = irfn_vreg(&FN);
            u32 dd = irfn_vreg(&FN);

            pa_advance();                    /* -> */
            pa_advance();                    /* join */
            pa_advance();                    /* ( */
            pa_expect_ch(')');
            irfn_push(&FN, IR_LOAD, IRT_PTR, a0, hv, 0, 0, 0);
            irfn_push(&FN, IR_CONST, IRT_U64, zz, 0, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, a0, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, zz, 0, 0, 1);
            irfn_push(&FN, IR_CALL, IRT_I64, dd, 0, 0, 0, pj);
            FN.ops[FN.n - 1].narg = 2;
            GEN_TY = ty_int();
            PEND_LVAL = 0;
            v = dd;
            continue;
        }
        if (pa_is_ch('.') || pa_is_punct("->")) {
            int is_arrow = pa_is_punct("->");
            u32 base = 0;

            u32 bty = 0;
            u32 addr = 0;
            Tok *mt = NULL;
            const char *mname = NULL;
            u32 mlen = 0;
            int idx = -1;
            u32 off = 0;
            u32 mty = 0;
            u32 a2 = 0;

            pa_advance();
            if (E_WEAK && in_c6_tu()) {
                char dnm[160] = {0};

                agg_disp_name(ty_target(GEN_TY), dnm, sizeof(dnm));
                pa_error("cannot use a 'weak @%s' directly: upgrade it first "
                         "('@T q = w;')", dnm);
                E_WEAK = 0;
            }
            if (is_arrow) {
                /* p->m：先取值（指针），对象类型是它的元类型 */
                base = value_of(v);
                bty = ty_target(GEN_TY);
                addr = base;
            } else {
                /* s.m：左值就取地址；聚合**值**（函数返回的结构体、复合字面量）
                 * 在我们的约定里本来就是"用地址代表值"，直接当基址用。 */
                if (!PEND_LVAL && ty_is_agg(GEN_TY)) {
                    /* 聚合值按约定"用地址代表"，但**函数返回的结构体**那个地址
                     * 在**被调方的栈帧里**：方法调用糖把它当接收者指针传出去，
                     * 被调方一进栈就把那块内存盖掉（`mkp().get()` 拿到垃圾，
                     * 而 `mkp().x` 立刻读还是对的）。先拷进调用者的临时槽，
                     * 再用它的地址。 */
                    u32 asz = ty_size(GEN_TY);

                    if (asz > 0 && asz <= 4096) {
                        u32 aslot = frame_slots_for(asz);
                        u32 aaddr = irfn_vreg(&FN);

                        irfn_push(&FN, IR_ADDR, IRT_PTR, aaddr, 0, 0, 0, X64_SLOT(aslot));
                        irfn_push(&FN, IR_COPY, IRT_U8, aaddr, v, 0, 0, asz);
                        addr = aaddr;
                    } else {
                        addr = v;
                    }
                    bty = GEN_TY;
                } else if (!PEND_LVAL) {
                    /* 标量上的方法调用：`dec_parse(...).round(2)` 里接收者是个
                     * 值。先记下来，等会儿成员找不到时按方法糖处理（把值本身
                     * 当接收者传），找不到方法才报错。 */
                    addr = v;
                    bty = GEN_TY;
                } else {
                    addr = PEND_ADDR;
                    bty = PEND_TY;
                    PEND_LVAL = 0;
                }
            }
            /* 注意：pa_cur() 指向前瞻窗口，advance 会把窗口左移，
             * 所以必须**先按值拷出来**再 advance，否则读到的名字是下一个 token。 */
            mname = pa_cur()->kind == TK_IDENT ? tok_data(pa_cur()) : NULL;
            mlen = pa_cur()->kind == TK_IDENT ? pa_cur()->len : 0;
            mt = pa_cur();
            if (mt->kind != TK_IDENT) {
                pa_error("'.' 后面要成员名");
                GEN_TY = ty_int();
                continue;
            }
            pa_advance();
            /* 接口值：`s.f(args)` → `vt[idx](self, args)`（胖指针在 addr） */
            {
                u32 ifix = 0;

                if (NIFACE > 0 && ty_is_iface(bty, &ifix)) {
                    u32 k = 0;
                    u32 mi = IFACE_NM[ifix];
                    u32 fnv = 0;
                    u32 selfv = 0;
                    u32 avs[16] = {0};
                    u32 narg = 0;
                    u32 dst3 = 0;

                    for (k = 0; k < IFACE_NM[ifix]; k++)
                        if (IFACE_MLEN[ifix][k] == mlen
                            && memcmp(IFACE_MET[ifix][k], mname, mlen) == 0) {
                            mi = k;
                            break;
                        }
                    if (mi >= IFACE_NM[ifix]) {
                        pa_error("接口 '%.*s' 没有方法 '%.*s'",
                                 (int)IFACE_NLEN[ifix], IFACE_NAME[ifix],
                                 (int)mlen, mname);
                        GEN_TY = ty_int();
                        continue;
                    }
                    selfv = irfn_vreg(&FN);
                    irfn_push(&FN, IR_LOAD, IRT_PTR, selfv, addr, 0, 0, 0);
                    {
                        u32 a8 = gen_addr_off(addr, 8);
                        u32 vtv = irfn_vreg(&FN);

                        irfn_push(&FN, IR_LOAD, IRT_PTR, vtv, a8, 0, 0, 0);
                        fnv = irfn_vreg(&FN);
                        irfn_push(&FN, IR_LEA, IRT_PTR, fnv, vtv, 0, 0, mi * 8);
                        irfn_push(&FN, IR_LOAD, IRT_PTR, fnv, fnv, 0, 0, 0);
                    }
                    avs[narg++] = selfv;
                    if (pa_accept_ch('(')) {
                        if (!pa_accept_ch(')')) {
                            for (;;) {
                                if (narg < 16)
                                    avs[narg++] = value_of(gen_assign());
                                if (!pa_accept_ch(','))
                                    break;
                            }
                            pa_expect_ch(')');
                        }
                    }
                    {
                        u32 irt = IFACE_RET[ifix][mi] ? IFACE_RET[ifix][mi] : ty_int();
                        u32 sv = sret_slot(irt);

                        if (sv && narg < 16)
                            avs[narg++] = sv;
                    }
                    for (k = 0; k < narg; k++)
                        irfn_push(&FN, IR_ARG, IRT_U64, 0, avs[k], 0, 0, k);
                    dst3 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CALLI, IRT_I64, dst3, fnv, 0, 0, 0);
                    FN.ops[FN.n - 1].narg = (u8)narg;
                    GEN_TY = IFACE_RET[ifix][mi] ? IFACE_RET[ifix][mi] : ty_int();
                    PEND_LVAL = 0;
                    v = dst3;
                    continue;
                }
            }
            if (!ty_is_agg(bty) || !agg_find_promoted(bty, mname, mlen, &mty, &off)) {
                /* c6 方法调用语法糖：`x->cmp(a)` / `x.cmp(a)` == `cmp(x, a)`
                 * （第一个形参是接收者）。找不到同名函数才报错。 */
                /* 先按接收者类型找（同名函数可能有多个重载/被全局变量遮住），
                 * 找不到再退回普通查名 */
                Sym *ms = meth_find(bty, mname, mlen);

                if (!ms)
                    ms = sym_find(mname, mlen);
                if (ms && ms->is_func) {
                    u32 avs[16] = {0};
                    u32 narg = 0;
                    u32 k2 = 0;
                    u32 dst2 = 0;

                    /* 只有"正好一个接收者参数"的 drop 才是析构；同名但带
                     * 别的参数的是普通方法（`std/container/span.c6` 的
                     * `Span drop(Span *self, int n)`）。 */
                    if (!pa_is_ch('('))
                        pa_error("method '%.*s' must be called", (int)mlen, mname);
                    if (ms->len == 4 && memcmp(ms->name, "drop", 4) == 0
                        && ty_func_nparams(ms->type) == 1 && drop_is_sym((u32)ms->val))
                        pa_error("析构函数不能直接调用：最后一个引用放掉时它自己会跑（`p = NULL` 就够了）");
                    avs[narg++] = is_arrow ? base : addr;
                    if (pa_accept_ch('(')) {
                        if (!pa_accept_ch(')')) {
                            for (;;) {
                                u32 av3 = gen_assign();
                                u32 aty3 = cur_op_ty();
                                u32 pty3 = ty_func_param(ms->type, narg);

                                /* 实参按形参类型转换：`m.push(10)` 里 10 是 int、
                                 * 形参是 double，不转就进通用寄存器，被调方从
                                 * xmm0 读到的是 0（同一个调用写 `m.push(10.0)`
                                 * 却完全正确，所以很难看出来）。 */
                                if (pty3 && !ty_is_agg(pty3) && aty3 != pty3)
                                    av3 = gen_convert(av3, aty3, pty3);
                                /* 聚合实参要先落到自己的帧槽里再传。方法糖这条
                                 * 路的实参是"先全求值、最后统一 IR_ARG"，聚合临时
                                 * 量就活在被调用的实参暂存区上——外层的 CALL 一
                                 * 铺参数就把它盖掉了（`b.f(str(t))` 里 f 读到
                                 * 的 Str.data 是栈上垃圾，json/xml 就是这么坏的）。
                                 * 普通调用是边求值边 IR_ARG，所以不受影响。 */
                                if (pty3 && ty_is_agg(pty3) && ty_size(pty3) > 0) {
                                    u32 sl3 = frame_slots_for(ty_size(pty3));
                                    u32 sa3 = irfn_vreg(&FN);

                                    irfn_push(&FN, IR_ADDR, IRT_PTR, sa3, 0, 0, 0,
                                              X64_SLOT(sl3));
                                    irfn_push(&FN, IR_COPY, IRT_U8, sa3, av3, 0, 0,
                                              ty_size(pty3));
                                    av3 = sa3;
                                }
                                if (narg < 16)
                                    avs[narg++] = value_of(av3);
                                if (!pa_accept_ch(','))
                                    break;
                            }
                            pa_expect_ch(')');
                        }
                    }
                    (void)sret_pass(avs, &narg, ms->type);
                    for (k2 = 0; k2 < narg; k2++)
                        irfn_push(&FN, IR_ARG, IRT_U64, 0, avs[k2], 0, 0, k2);
                    dst2 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CALL, ir_ty_of(ty_target(ms->type)), dst2,
                              0, 0, 0, (u32)ms->val);
                    FN.ops[FN.n - 1].narg = (u8)narg;
                    GEN_TY = ty_target(ms->type);
                    PEND_LVAL = 0;
                    v = dst2;
                    continue;
                }
                /* 接收者是模板实例时，方法可能是**函数模板**
                 * （`|T| T vat(Vect@T *self, int i)`）：按实例的实参把它
                 * 实例化出来再调。注意实例化会就地发射函数体，所以外层函数
                 * 的指令要连内容一起备份。 */
                if (!ms) {
                    u32 targs[TMPL_NPARAM] = {0};
                    u32 tna = 0;
                    int ti = tmpl_args_of_ty(bty, targs, &tna);

                    if (ti >= 0) {
                        Tmpl *tp = tmpl_find(mname, mlen);

                        if (tp && tp->is_func && tna == tp->nparam) {
                            u32 n0 = FN.n;
                            IrOp *bak = arena_alloc(&A_main,
                                                    (size_t)(n0 ? n0 : 1) * sizeof(IrOp));
                            TmplSaved sv2 = {0};
                            u32 fsid = 0;
                            u32 k3 = 0;
                            int dup = 0;

                            if (n0)
                                memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
                            tmpl_save_state(&sv2);
                            fsid = tmpl_func_sig(tp, targs, tna);
                            tmpl_restore_state(&sv2);
                            if (n0)
                                memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
                            if (fsid) {
                                char nm2[320] = {0};

                                tmpl_mangle_name(tp, targs, tna, nm2, sizeof(nm2));
                                ms = sym_find(nm2, (u32)strlen(nm2));
                                for (k3 = 0; k3 < NFW; k3++) {
                                    u32 j3 = 0;
                                    int same = (FW_T[k3] == tp);

                                    if (same) {
                                        for (j3 = 0; j3 < TMPL_NPARAM; j3++)
                                            if (FW_A[k3][j3] != targs[j3])
                                                same = 0;
                                    }
                                    if (same)
                                        dup = 1;
                                }
                                if (!dup && NFW < FW_MAX) {
                                    for (k3 = 0; k3 < TMPL_NPARAM; k3++)
                                        FW_A[NFW][k3] = targs[k3];
                                    FW_T[NFW] = tp;
                                    NFW++;
                                }
                            }
                        }
                    }
                }
                if (ms && ms->is_func) {
                    u32 avs[16] = {0};
                    u32 narg = 0;
                    u32 k2 = 0;
                    u32 dst3 = 0;

                    /* 方法只能**调用**：写成值（`p->vec_sum`）拿到的是把
                     * 接收者当唯一实参的一次调用，语义完全不同
                     * （tests/errors/method.c6 的两条 without_call）。 */
                    if (!pa_is_ch('('))
                        pa_error("method '%.*s' must be called", (int)mlen, mname);
                    avs[narg++] = is_arrow ? base : addr;
                    if (pa_accept_ch('(')) {
                        if (!pa_accept_ch(')')) {
                            for (;;) {
                                if (narg < 16)
                                    avs[narg++] = value_of(gen_assign());
                                if (!pa_accept_ch(','))
                                    break;
                            }
                            pa_expect_ch(')');
                        }
                    }
                    (void)sret_pass(avs, &narg, ms->type);
                    for (k2 = 0; k2 < narg; k2++)
                        irfn_push(&FN, IR_ARG, IRT_U64, 0, avs[k2], 0, 0, k2);
                    dst3 = irfn_vreg(&FN);
                    irfn_push(&FN, IR_CALL, ir_ty_of(ty_target(ms->type)), dst3,
                              0, 0, 0, (u32)ms->val);
                    FN.ops[FN.n - 1].narg = (u8)narg;
                    GEN_TY = ty_target(ms->type);
                    PEND_LVAL = 0;
                    v = dst3;
                    continue;
                }
                pa_error("结构体没有成员 '%.*s'", (int)mlen, mname);
                GEN_TY = ty_int();
                v = addr;
                continue;
            }

            a2 = addr;
            if (off) {
                a2 = irfn_vreg(&FN);
                irfn_push(&FN, IR_LEA, IRT_PTR, a2, addr, 0, 0, off);
            }
            mark_lval(a2, mty);
            if (mgdst_kind(bty, AGG_FOUND_IDX))
                /* 1 = 托管引用，2 = 弱引用（赋值走登记，读走升级） */
                PEND_MGD = mgdst_kind(bty, AGG_FOUND_IDX);
            PEND_BITS = AGG_FOUND_BITS;     /* 位域整型提升交给 cur_op_ty */
            PEND_BITOFF = AGG_FOUND_BITOFF;
            PEND_BF_ENUM = AGG_FOUND_ENUMBF;
            v = a2;
            continue;
        }
        if (pa_is_punct("++") || pa_is_punct("--")) {
            int inc = pa_is_punct("++");
            u32 addr = 0;
            u32 ty = 0;
            u32 old_v = 0;
            u32 one = 0;
            u32 nv = 0;

            pa_advance();
            if (!PEND_LVAL) {
                pa_error("++/-- 需要一个左值");
                continue;
            }
            {
                u32 bb = PEND_BITS;
                u32 bb_off = PEND_BITOFF;

                addr = PEND_ADDR;
                ty = PEND_TY;
                PEND_LVAL = 0;
                /* 位域要按字段取值/写回，不能整单元读改写 */
                old_v = bb ? load_bf(addr, ty, bb, bb_off, ty_is_signed(ty), PEND_BF_ENUM)
                           : load_lval(addr, ty);
                one = irfn_vreg(&FN);
                /* 指针的 ++/-- 要按**元素大小**步进（`struct R *q; q++` 加的是 24） */
                irfn_push(&FN, IR_CONST, IRT_U64, one, 0, 0, 0,
                          ty_is_ptr(ty) ? (ty_size(ty_target(ty)) ? ty_size(ty_target(ty)) : 1) : 1);
                nv = irfn_vreg(&FN);
                irfn_push(&FN, inc ? IR_ADD : IR_SUB, ir_ty_of(ty), nv, old_v,
                          one, 0, 0);
                if (bb)
                    store_lval_bits(addr, ty, bb, bb_off, nv);
                else
                    store_lval(addr, ty, nv);
            }
            GEN_TY = ty;
            v = old_v;
            continue;
        }
        break;
    }
    return v;
}


/* 整数字面量的"值 + 类型"：C 的规则简化版。
 * v 已经无符号解析出来；base 用来区分十进制/八进制十六进制的提升顺序，
 * uns/lng 是后缀的 U 与 L 个数（lng=2 表示 LL）。 */
static u32 lit_type(u64 v, int uns, int lng, int base)
{
    if (lng >= 2) {
        if (uns)
            return ty_ullong();
        return v <= 0x7FFFFFFFFFFFFFFFULL ? ty_llong() : ty_ullong();
    }
    if (uns) {
        /* 有后缀就按后缀定，**不看值大小**（C99 6.4.4.1）：`1UL` 是
         * unsigned long（8 字节），不是"值塞得进 32 位就降成 unsigned int"。
         * 少了这一条，`1UL << 40` 会按 32 位算成 0——`BIT(40)`、
         * `1UL << PAGE_SHIFT` 这类全变 0，是整个内核 bitops 塌掉的根因
         * （实测：`sizeof(1UL)` 给 4，`1UL<<32`、`1UL<<33`、`1UL<<40` 全给 0，
         * 而 `1L<<40`、`1ULL<<40` 正确）。 */
        if (lng >= 1)
            return ty_ulong();
        return v <= 0xFFFFFFFFULL ? ty_uint() : ty_ulong();
    }
    if (lng >= 1) {
        if (v <= 0x7FFFFFFFFFFFFFFFULL)
            return ty_long();
        return ty_ulong();
    }
    if (base == 10) {
        if (v <= 0x7FFFFFFFULL)
            return ty_int();
        if (v <= 0x7FFFFFFFFFFFFFFFULL)
            return ty_long();
        return ty_ullong();
    }
    if (v <= 0x7FFFFFFFULL)
        return ty_int();
    if (v <= 0xFFFFFFFFULL)
        return ty_uint();
    if (v <= 0x7FFFFFFFFFFFFFFFULL)
        return ty_long();
    return ty_ulong();
}

/* 后缀扫描：U/u 一个、L/l 一到两个（大小写混写也认） */
static void lit_suffix(const char *s, u32 len, int *uns, int *lng, int *nbase)
{
    u32 i = len;
    int nl = 0;

    *uns = 0;
    *lng = 0;
    while (i > 0) {
        char c = s[i - 1];

        if (c == 'u' || c == 'U') {
            *uns = 1;
            i--;
        } else if (c == 'l' || c == 'L') {
            nl++;
            i--;
        } else {
            break;
        }
    }
    *lng = nl >= 2 ? 2 : (nl == 1 ? 1 : 0);
    /* 进制：0x/0X 开头是 16，0 开头是 8，否则 10 */
    *nbase = 10;
    if (i >= 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
        *nbase = 16;
    else if (i >= 2 && s[0] == '0' && (s[1] == 'b' || s[1] == 'B'))
        *nbase = 2;
    else if (i >= 2 && s[0] == '0')
        *nbase = 8;
}

/* 整数字面量 → vreg：类型按值/后缀定，超出 32 位的值走常量池 */
static u32 gen_int_lit(u64 c, u32 ty)
{
    u32 d = irfn_vreg(&FN);
    u32 irt = ir_ty_of(ty);


    if (c <= 0xFFFFFFFFULL)
        irfn_push(&FN, IR_CONST, irt, d, 0, 0, 0, (u32)c);
    else
        irfn_push(&FN, IR_CONSTK, irt, d, 0, 0, 0, irfn_kconst(&FN, c));
    if (ty_is_int(ty))
        cv_set(d, cv_fit(c, ty));   /* 见 CV_* 那张表的注释 */
    GEN_TY = ty;
    return d;
}


/* 浮点字面量的**数值**（float 字面量也按 double 返回，别拿 float 的位模式
 * 去当 double 用——踩过：`float x = 12.5f;` 存进去是 5e-324）。 */
static double float_lit_d(const char *s, u32 n)
{
    int is32 = 0;
    u64 b = float_lit_bits(s, n, &is32);
    double dv = 0;

    if (is32) {
        u32 b32 = (u32)b;
        float fv = 0;

        *(u32 *)&fv = b32;
        return (double)fv;
    }
    *(u64 *)&dv = b;
    return dv;
}

/* 数据段初始化器里的浮点常量表达式：字面量、整数、括号、+ - * /。
 * 别的（标识符、cast、函数调用）一律 ok=0，由调用方决定怎么兜底。 */
static double const_fexpr(int *ok);

static double const_fprim(int *ok)
{
    Tok *t = pa_cur();
    double v = 0;

    if (pa_accept_ch('(')) {
        v = const_fexpr(ok);
        if (pa_is_ch(')'))
            pa_advance();
        else
            *ok = 0;
        return v;
    }
    if (pa_accept_ch('-'))
        return -const_fprim(ok);
    if (pa_accept_ch('+'))
        return const_fprim(ok);
    if (t->kind == TK_NUM) {
        if (is_float_lit(tok_data(t), t->len)) {
            v = float_lit_d(tok_data(t), t->len);
            pa_advance();
            return v;
        }
        v = (double)(i64)int_lit_val(tok_data(t), t->len);
        pa_advance();
        return v;
    }
    *ok = 0;
    return 0;
}

static double const_fmul(int *ok)
{
    double v = const_fprim(ok);

    for (;;) {
        if (pa_accept_ch('*')) {
            v = v * const_fprim(ok);
        } else if (pa_accept_ch('/')) {
            double r = const_fprim(ok);

            if (r == 0) {
                *ok = 0;
                return 0;
            }
            v = v / r;
        } else {
            return v;
        }
    }
}

static double const_fexpr(int *ok)
{
    double v = const_fmul(ok);

    for (;;) {
        if (pa_accept_ch('+'))
            v = v + const_fmul(ok);
        else if (pa_accept_ch('-'))
            v = v - const_fmul(ok);
        else
            return v;
    }
}

static u32 gen_postfix(void)
{
    Tok *t = pa_cur();
    u32 v = 0;

    /* 默认不是空指针常量：只有字面量 0（和它的指针强转）会重新置 1 */
    E_NPC = 0;

    if (t->kind == TK_NUM && is_float_lit(tok_data(t), t->len)) {
        int is32 = 0;
        u64 bits = float_lit_bits(tok_data(t), t->len, &is32);
        u32 fty = is32 ? ty_float() : ty_double();
        u32 d = irfn_vreg(&FN);

        pa_advance();
        irfn_push(&FN, IR_CONSTK, ir_ty_of(fty), d, 0, 0, 0,
                  irfn_kconst(&FN, bits));
        GEN_TY = fty;
        return gen_postfix_ops(d);
    }
    if (t->kind == TK_NUM) {
        u64 c = int_lit_val(tok_data(t), t->len);
        int uns = 0;
        int lng = 0;
        int nbase = 10;
        u32 d = 0;

        lit_suffix(tok_data(t), t->len, &uns, &lng, &nbase);
        pa_advance();
        E_NPC = (c == 0);      /* 字面量 0 是空指针常量 */
        d = gen_int_lit(c, lit_type(c, uns, lng, nbase));
        return gen_postfix_ops(d);
    }
    if (t->kind == TK_CHAR) {
        u64 c = (u64)char_lit_val(t);
        u32 d = 0;

        pa_advance();
        d = gen_int_lit(c, ty_int());
        return gen_postfix_ops(d);
    }
    if (t->kind == TK_STR)
        return gen_postfix_ops(gen_string());
    /* c6 的 `err(id, msg)`：错误通道的构造子。完整语义（T!error 返回类型、
     * catch、or 默认值）还没做，这里先当"值 = id"的 int 表达式，测试块能跑。 */
    /* `c6_io(fd, ev)` 只有在 `await` 的操作数位置才合法：挂起点必须写成
     * `await c6_io(…)`，别的地方调用它等于"要看一眼就绪、不用挂起"。 */
    if (t->kind == TK_IDENT && TOK_EQ(t, "c6_io") && pa_peek(1)
        && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(") && !PA_AWAIT_IO)
        pa_error("c6_io 只能写成 'await c6_io(fd, ev)'");
    if (t->kind == TK_IDENT && TOK_EQ(t, "err") && pa_peek(1)
        && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")) {
        u32 d = 0;

        /* 错误只走"返回"这一条路：`err(..)` 写在语句/条件/初始化器里都拦下来
         * （tests/errors/err_usage.c6）。 */
        if (!PA_RET_EXPR)
            pa_error("'err' can only be used as 'return err(id, msg)'");

        pa_advance();
        pa_advance();
        d = value_of(gen_assign());
        if (pa_accept_ch(',')) {
            /* 消息存进运行时的全局，`catch e { e.msg }` 从那里取 */
            u32 mv = value_of(gen_assign());
            Sym *g = sym_find("c6c_err_msg", 11);

            if (g) {
                u32 a = ident_addr(g);

                store_conv(a, ty_ptr(ty_char()), mv, cur_op_ty());
            }
        }
        pa_expect_ch(')');
        /* 同时把运行时的错误状态置上：`T!error` 函数的调用方靠它判断
         * （值本身仍是 id，测试块 `return err(N, …)` 的约定不变）。 */
        {
            u32 idv = irfn_vreg(&FN);
            u32 msv = irfn_vreg(&FN);
            u32 ign = irfn_vreg(&FN);
            Sym *gm2 = sym_find("c6c_err_msg", 11);

            if (gm2) {
                irfn_push(&FN, IR_LOAD, IRT_PTR, msv, ident_addr(gm2), 0, 0, 0);
            } else {
                irfn_push(&FN, IR_CONST, IRT_U64, msv, 0, 0, 0, 0);
            }
            /* id 是运行期算出来的 vreg，不是常量——以前这里把 vreg 号当成立即数
             * 塞进 IR_CONST，`__tcc_err_set` 收到的 id 全是错的。 */
            irfn_push(&FN, IR_ARG, IRT_U64, 0, d, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, msv, 0, 0, 1);
            irfn_push(&FN, IR_CALL, IRT_VOID, ign, 0, 0, 0,
                      x64_sym(&X64, "__tcc_err_set"));
            FN.ops[FN.n - 1].narg = 2;
        }
        GEN_TY = ty_int();
        return gen_postfix_ops(d);
    }
    /* `move(x)`：c6 的"交出所有权"。值原样给出（不加计数），但**源槽必须
     * 清零**——不然源槽退出作用域时会再放一次，被交出去的对象就到 0 又被
     * 摘掉（踩过：own 树测试里 gc_live 一路减到 -2）。 */
    if (t->kind == TK_IDENT && TOK_EQ(t, "move") && pa_peek(1)
        && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")) {
        u32 mv2 = 0;
        u32 mty2 = 0;
        u32 maddr = 0;
        int mlval = 0;
        u32 mty3 = 0;

        pa_advance();
        pa_advance();
        PA_MOVE_OPERAND = 1;
        mv2 = gen_assign();
        PA_MOVE_OPERAND = 0;
        mty2 = GEN_TY;
        mlval = PEND_LVAL;
        maddr = PEND_ADDR;
        mty3 = PEND_TY;
        mv2 = value_of(mv2);
        pa_expect_ch(')');
        if (!mlval)
            pa_error("'move' 需要一个左值（要能把源槽清零）");
        /* 只接受"槽里的托管引用"：`move(3)` / `move(s.p)` 这种没有源槽可清零 */
        if (!PEND_MGD_SYM || PEND_MGD_SYM->is_mgd != 1) {
            char tnb[96] = {0};

            agg_disp_name(mty3, tnb, sizeof(tnb));
            pa_error("'move' needs a managed reference held in a slot, not a '%s'",
                     tnb[0] ? tnb : "?");
        } else {
            if (mv_has(PEND_MGD_SYM->slot))
                pa_error("'%s' was moved: assign a new reference before using it",
                         PEND_MGD_SYM->name ? PEND_MGD_SYM->name : "?");
            mv_set(PEND_MGD_SYM->slot);
        }
        /* 交出去的值是"一份新所有权"：没人接手（`move(a);` 这种光秃秃的
         * 语句）就在语句末尾放掉，被赋值/传参接走了就从待释放表里摘掉。 */
        mgd_tmp_take(mv2);
        mgd_tmp_add(mv2);
        if (ty_is_ptr(mty3)) {
            u32 z0 = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, z0, 0, 0, 0, 0);
            store_lval(maddr, mty3, z0);
        }
        GEN_TY = mty2;
        PEND_MGD = 0;
        PEND_MGD_SYM = NULL;
        return gen_postfix_ops(mv2);
    }
    if (t->kind == TK_IDENT && (TOK_EQ(t, "alloca") || TOK_EQ(t, "__builtin_alloca"))) {
        if (CUR_TASK_TY)
            pa_error("async 函数里不能用 alloca");
        /* alloca/__builtin_alloca：两条路。
         *   - 大小是**字面量**：直接开一个帧槽（不碰 rsp，函数尾声自然回收）；
         *   - 大小是运行期表达式（`alloca(strlen(s)+1)`、`alloca(n*2)`）：走
         *     VLA 那条 IR_ALLOCA（`rsp - align16(字节数)`），三个后端都已经
         *     实现了。以前这里报"必须是编译期常量"，tcc 上游的 boundtest.c
         *     正是拿它当标准用法。 */
        u64 n = 0;
        u32 addr = 0;

        pa_advance();
        pa_expect_ch('(');
        if (pa_cur()->kind == TK_NUM && parse_const_u64(&n)) {
            pa_expect_ch(')');
            {
                u32 slot = frame_slots_for((u32)n);

                addr = irfn_vreg(&FN);
                irfn_push(&FN, IR_ADDR, IRT_PTR, addr, 0, 0, 0, X64_SLOT(slot));
            }
        } else {
            u32 cnt = value_of(gen_assign());

            pa_expect_ch(')');
            addr = irfn_vreg(&FN);
            /* imm = 1：a 直接就是字节数 */
            irfn_push(&FN, IR_ALLOCA, IRT_PTR, addr, cnt, 0, 0, 1);
        }
        GEN_TY = ty_ptr(ty_void());
        return gen_postfix_ops(addr);
    }
    if (TOK_EQ(t, "__builtin_syscall")) {
        /* __builtin_syscall(nr, a1..a6)：FreeBSD 风格，最多 6 个参数 */
        u32 d = 0;
        u32 k = 0;

        pa_advance();
        pa_expect_ch('(');
        for (k = 0; k < 7; k++) {
            u32 a = value_of(gen_assign());

            irfn_push(&FN, IR_ARG, IRT_VOID, 0, a, 0, 0, k);
            if (!pa_accept_ch(','))
                break;
        }
        pa_expect_ch(')');
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_I64, d, 0, 0, 0, 0);
        FN.ops[FN.n - 1].flags |= 2;
        GEN_TY = ty_long();
        return d;
    }
    if (t->kind == TK_IDENT && TOK_EQ(t, "__builtin_va_copy")) {
        /* `__builtin_va_copy(dst, src)`：把整个 va_list 结构拷过去。
         * 内核 include/linux/stdarg.h:9 的 va_copy 就是它。SysV x86-64 下
         * va_list 是 24 字节的 {gp_offset, fp_offset, overflow_arg_area,
         * reg_save_area} 结构，`IR_COPY` 按字节拷正合适（两边都是左值）。 */
        u32 dst = 0;
        u32 src = 0;
        u32 d = 0;
        u32 n = (u32)(VA_LIST_TY ? ty_size(VA_LIST_TY) : 24);

        pa_advance();
        pa_expect_ch('(');
        dst = value_of(gen_assign());
        pa_expect_ch(',');
        src = value_of(gen_assign());
        pa_expect_ch(')');
        if (n == 0)
            n = 24;
        irfn_push(&FN, IR_COPY, IRT_VOID, dst, src, 0, 0, n);
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, 0);
        GEN_TY = ty_int();
        return d;
    }
    if (t->kind == TK_IDENT &&
        (TOK_EQ(t, "__builtin_va_start") || TOK_EQ(t, "__builtin_va_arg") ||
         TOK_EQ(t, "__builtin_va_end"))) {
        int kind = TOK_EQ(t, "__builtin_va_start") ? 0
                   : TOK_EQ(t, "__builtin_va_arg") ? 1 : 2;
        u32 ap = 0;
        u32 ty = 0;
        u32 d = 0;

        pa_advance();
        pa_expect_ch('(');
        ap = value_of(gen_assign());
        if (kind == 0) {
            /* `__builtin_va_start(ap)` 是 c6c 自带头文件的写法，GCC 与内核
             * 的头文件是 `__builtin_va_start(ap, last)`——第二个实参（最后
             * 一个具名参数）在 SysV ABI 下不用：具名参数个数出码时从
             * FN.nparams 取（见 x64.c6 的 IR_VASTART）。所以收下、丢掉。 */
            if (pa_is_ch(',')) {
                pa_advance();
                value_of(gen_assign());
            }
            pa_expect_ch(')');
            irfn_push(&FN, IR_VASTART, IRT_VOID, 0, ap, 0, 0, FN.nparams * 8);
            d = irfn_vreg(&FN);
            irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, 0);
            GEN_TY = ty_int();
            return d;
        }
        if (kind == 1) {
            pa_expect_ch(',');
            ty = parse_typename();
            pa_expect_ch(')');
            d = irfn_vreg(&FN);
            irfn_push(&FN, IR_VAARG, ir_ty_of(ty), d, ap, 0, 0, 0);
            if (ty_size(ty) < 8 && ty_size(ty) > 0) {
                u32 t2 = irfn_vreg(&FN);

                irfn_push(&FN, IR_TRUNC, ir_ty_of(ty), t2, d, 0, 0, 0);
                d = t2;
            }
            GEN_TY = ty;
            return d;
        }
        pa_expect_ch(')');
        irfn_push(&FN, IR_VAEND, IRT_VOID, 0, ap, 0, 0, 0);
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, 0);
        GEN_TY = ty_int();        return d;
    }
    /* _Generic(控制表达式, 类型: 表达式, …, default: 表达式)
     * 每个分支都照常生成 IR，记下各自的区间；选中的那一段搬到结果位置，
     * 其余丢掉。vreg 编号互不冲突，搬动是安全的。 */
    if (TOK_EQ(t, "_Generic")) {
        u32 cty = 0;
        u32 sel = 0;
        u32 k = 0;
        u32 nassoc = 0;
        u32 aty[32] = {0};
        u32 ast[32] = {0};
        u32 aen[32] = {0};
        u32 avl[32] = {0};
        u32 res = 0;
        u32 rty = 0;
        int pick = -1;
        int def = -1;

        pa_advance();
        pa_expect_ch('(');
        {
            u32 save0 = FN.n;

            (void)gen_assign();
            cty = generic_ctl_ty(GEN_TY);
            FN.n = save0;
            PEND_LVAL = 0;
        }
        sel = FN.n;
        while (pa_accept_ch(',')) {
            u32 at = 0;
            u32 st = 0;
            u32 v2 = 0;

            skip_attributes();
            if (PA_IS_IDENT("default")) {
                pa_advance();
                at = 0;
            } else {
                at = parse_typename();
            }
            pa_expect_ch(':');
            st = FN.n;
            v2 = value_of(gen_assign());
            if (nassoc < 32) {
                aty[nassoc] = at;
                ast[nassoc] = st;
                aen[nassoc] = FN.n;
                avl[nassoc] = v2;
                nassoc++;
            }
        }
        pa_expect_ch(')');
        for (k = 0; k < nassoc; k++) {
            if (aty[k] == 0) {
                if (def < 0)
                    def = (int)k;
            } else if (aty[k] == cty && pick < 0) {
                pick = (int)k;
            }
        }
        if (pick < 0)
            pick = def;
        if (pick < 0) {
            pa_error("_Generic 没有匹配的类型分支");
            GEN_TY = ty_int();
            return 0;
        }
        k = (u32)pick;
        if (aen[k] > ast[k]) {
            memmove(&FN.ops[sel], &FN.ops[ast[k]], (size_t)(aen[k] - ast[k]) * sizeof(IrOp));
            FN.n = sel + (aen[k] - ast[k]);
        } else {
            FN.n = sel;
        }
        res = avl[k];
        rty = ty_int();
        {
            /* 分支类型：再看一眼它的表达式类型（上面记录时已算过） */
            rty = GEN_TY;
        }
        GEN_TY = rty;
        return gen_postfix_ops(res);
    }
    /* 内建函数：能直接映射的就地映射，其余按恒等/常量处理 */
    /* `__atomic_*` 内建：读改写走运行期的 __c6_at_*（lib/rt.c6，自旋锁里
     * 一起做完「读→算→写」）。以前这里是「load; 算; store」三条 IR，
     * 单线程看不出问题，16 个真线程并发就丢更新（tests2/124_atomic_counter）。
     * 注意 tcc 的 stdatomic.h 用的是**泛型**形式（第二个参数是 &值），
     * 不是 _n 形式，两种都要认。 */
    if (TOK_EQ(t, "__atomic_load_n") || TOK_EQ(t, "__atomic_load")) {
        int generic = TOK_EQ(t, "__atomic_load");
        u32 p = 0;
        u32 pty = 0;
        u32 d = 0;
        u32 rp = 0;

        pa_advance();
        pa_expect_ch('(');
        p = value_of(gen_assign());
        pty = ty_is_ptr(GEN_TY) ? ty_target(GEN_TY) : ty_int();
        if (generic) {
            pa_expect_ch(',');
            rp = value_of(gen_assign());     /* &结果 */
        }
        while (pa_accept_ch(','))
            (void)value_of(gen_assign());
        pa_expect_ch(')');
        d = load_lval(p, pty);
        if (generic && rp)
            store_conv(rp, pty, d, pty);
        GEN_TY = pty;
        return gen_postfix_ops(d);
    }
    if (TOK_EQ(t, "__atomic_store_n") || TOK_EQ(t, "__atomic_store")) {
        int generic = TOK_EQ(t, "__atomic_store");
        u32 p = 0;
        u32 pty = 0;
        u32 v2 = 0;

        pa_advance();
        pa_expect_ch('(');
        p = value_of(gen_assign());
        pty = ty_is_ptr(GEN_TY) ? ty_target(GEN_TY) : ty_int();
        pa_expect_ch(',');
        v2 = value_of(gen_assign());
        if (generic)
            v2 = load_lval(v2, pty);         /* 参数是 &值 */
        while (pa_accept_ch(','))
            (void)value_of(gen_assign());
        pa_expect_ch(')');
        store_conv(p, pty, v2, pty);
        GEN_TY = ty_void();
        return 0;
    }
    if (TOK_EQ(t, "__atomic_thread_fence") || TOK_EQ(t, "__atomic_signal_fence")
        || TOK_EQ(t, "__sync_synchronize")) {
        pa_advance();
        if (pa_accept_ch('(')) {
            while (!pa_is_ch(')') && pa_cur()->kind != TK_EOF)
                (void)value_of(gen_assign()), pa_accept_ch(',');
            pa_expect_ch(')');
        }
        GEN_TY = ty_void();
        return 0;
    }
    if (TOK_EQ(t, "__atomic_exchange_n") || TOK_EQ(t, "__atomic_exchange")
        || TOK_EQ(t, "__atomic_fetch_add")
        || TOK_EQ(t, "__atomic_fetch_sub") || TOK_EQ(t, "__atomic_fetch_and")
        || TOK_EQ(t, "__atomic_fetch_or") || TOK_EQ(t, "__atomic_fetch_xor")
        || TOK_EQ(t, "__atomic_add_fetch") || TOK_EQ(t, "__atomic_sub_fetch")) {
        int xchg = 0;
        int generic = 0;         /* 泛型形式：值/返回值都是指针 */
        int aop = 0;             /* 0=加 1=减 2=与 3=或 4=异或（和 rt.c6 对齐） */
        int ret_new = 0;
        u32 p = 0;
        u32 pty = 0;
        u32 v2 = 0;
        u32 rp = 0;
        u32 old = 0;
        u32 nv = 0;
        u32 fn = 0;

        xchg = TOK_EQ(t, "__atomic_exchange_n") || TOK_EQ(t, "__atomic_exchange");
        generic = TOK_EQ(t, "__atomic_exchange");
        aop = TOK_EQ(t, "__atomic_fetch_add") || TOK_EQ(t, "__atomic_add_fetch") ? 0
            : TOK_EQ(t, "__atomic_fetch_sub") || TOK_EQ(t, "__atomic_sub_fetch") ? 1
            : TOK_EQ(t, "__atomic_fetch_and") ? 2
            : TOK_EQ(t, "__atomic_fetch_or") ? 3 : 4;
        ret_new = TOK_EQ(t, "__atomic_add_fetch") || TOK_EQ(t, "__atomic_sub_fetch");
        pa_advance();
        pa_expect_ch('(');
        p = value_of(gen_assign());
        pty = ty_is_ptr(GEN_TY) ? ty_target(GEN_TY) : ty_int();
        pa_expect_ch(',');
        v2 = value_of(gen_assign());
        if (generic) {
            /* __atomic_exchange(ptr, &值, &旧值, order)：两个都是指针 */
            v2 = load_lval(v2, pty);
            pa_expect_ch(',');
            rp = value_of(gen_assign());
        }
        while (pa_accept_ch(','))
            (void)value_of(gen_assign());
        pa_expect_ch(')');
        if (xchg) {
            fn = x64_sym(&X64, "__c6_at_xchg");
            irfn_push(&FN, IR_ARG, IRT_U64, 0, p, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, v2, 0, 0, 1);
            {
                u32 sz = irfn_vreg(&FN);

                irfn_push(&FN, IR_CONST, IRT_U64, sz, 0, 0, 0, ty_size(pty));
                irfn_push(&FN, IR_ARG, IRT_U64, 0, sz, 0, 0, 2);
            }
            old = irfn_vreg(&FN);
            irfn_push(&FN, IR_CALL, IRT_U64, old, 0, 0, 0, fn);
            FN.ops[FN.n - 1].narg = 3;
            if (rp)
                store_conv(rp, pty, old, pty);
            GEN_TY = pty;
            return gen_postfix_ops(old);
        }
        /* fetch_add/sub/and/or/xor：__c6_at_rmw(p, v, op, 宽度) 返回旧值 */
        fn = x64_sym(&X64, "__c6_at_rmw");
        irfn_push(&FN, IR_ARG, IRT_U64, 0, p, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, v2, 0, 0, 1);
        {
            u32 opv = irfn_vreg(&FN);
            u32 sz = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, opv, 0, 0, 0, (u32)aop);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, opv, 0, 0, 2);
            irfn_push(&FN, IR_CONST, IRT_U64, sz, 0, 0, 0, ty_size(pty));
            irfn_push(&FN, IR_ARG, IRT_U64, 0, sz, 0, 0, 3);
        }
        old = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_U64, old, 0, 0, 0, fn);
        FN.ops[FN.n - 1].narg = 4;
        if (!ret_new) {
            GEN_TY = pty;
            return gen_postfix_ops(old);
        }
        /* add_fetch / sub_fetch：新值 = 旧值 ± v（这些不成对使用，够用） */
        nv = irfn_vreg(&FN);
        irfn_push(&FN, aop == 0 ? IR_ADD : IR_SUB, ir_ty_of(pty), nv, old,
                  v2, 0, 0);
        GEN_TY = pty;
        return gen_postfix_ops(nv);
    }
    if (TOK_EQ(t, "__atomic_compare_exchange_n") || TOK_EQ(t, "__atomic_compare_exchange")) {
        int generic = TOK_EQ(t, "__atomic_compare_exchange");
        u32 p = 0;
        u32 pty = 0;
        u32 pe = 0;
        u32 pd = 0;
        u32 r = 0;
        u32 sz = 0;

        pa_advance();
        pa_expect_ch('(');
        p = value_of(gen_assign());
        pty = ty_is_ptr(GEN_TY) ? ty_target(GEN_TY) : ty_int();
        pa_expect_ch(',');
        pe = value_of(gen_assign());
        pa_expect_ch(',');
        pd = value_of(gen_assign());
        if (generic)
            pd = load_lval(pd, pty);        /* 参数是 &值 */
        while (pa_accept_ch(','))
            (void)value_of(gen_assign());
        pa_expect_ch(')');
        /* __c6_at_cas(p, &expected, desired, 宽度)：1 = 换成，0 = 没换成
         * （没换成时它已经把实际值写进 *expected 了） */
        irfn_push(&FN, IR_ARG, IRT_U64, 0, p, 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, pe, 0, 0, 1);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, pd, 0, 0, 2);
        sz = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, sz, 0, 0, 0, ty_size(pty));
        irfn_push(&FN, IR_ARG, IRT_U64, 0, sz, 0, 0, 3);
        r = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_U64, r, 0, 0, 0, x64_sym(&X64, "__c6_at_cas"));
        FN.ops[FN.n - 1].narg = 4;
        GEN_TY = ty_int();
        return gen_postfix_ops(r);
    }
    if (TOK_EQ(t, "__builtin_expect") || TOK_EQ(t, "__builtin_expect_with_probability")
        || TOK_EQ(t, "__builtin_assume_aligned")) {
        u32 v = 0;

        pa_advance();
        pa_expect_ch('(');
        v = value_of(gen_assign());
        while (pa_accept_ch(','))
            (void)value_of(gen_assign());
        pa_expect_ch(')');
        return gen_postfix_ops(v);
    }
    /* `__builtin_{add,sub,mul}_overflow(a, b, &out)`：算 a op b，把结果写进
     * `*out`，返回"是否溢出"（1 = 溢出，0 = 没溢出）。
     *
     * 内核 include/linux/overflow.h 的整族 check_*_overflow() 都压在这三个上，
     * 而 overflow.h 又被 kernel.h / minmax.h 一路带进几乎所有 TU——这是内核
     * 头链在 c6c 上的最后一个缺口（实测除它之外只剩生成头路径的问题）。
     *
     * 语义按 GCC 文档：三个实参的两个操作数按**整型提升后**的公共类型算，
     * 结果写回 `out` 指向的对象（按那个对象的宽度截断）。判溢出必须在
     * 提升后的宽度上做，否则 `int + int` 的溢出会被 64 位运算吞掉：
     *   - 加法（同号）：sum = a + b；溢出 ⇔ (a<0) == (b<0) && sum 与 a 异号
     *   - 减法：diff = a - b；溢出 ⇔ (a<0) != (b<0) && diff 与 a 异号
     *   - 乘法：prod = a * b；a != 0 && prod / a != b
     * 无符号三种都只要结果的位宽判断（加法 a > MAX - b 等），但统一走
     * "先按符号算，再按目标类型的有符号性选判据"最省事——符号性取**结果
     * 写回的目标类型**，那正是调用者在意的那个宽度。 */
    if (TOK_EQ(t, "__builtin_add_overflow") || TOK_EQ(t, "__builtin_sub_overflow")
        || TOK_EQ(t, "__builtin_mul_overflow")) {
        int is_add = TOK_EQ(t, "__builtin_add_overflow");
        int is_sub = !is_add && TOK_EQ(t, "__builtin_sub_overflow");
        u32 a = 0;
        u32 b = 0;
        u32 pa_ty = 0;
        u32 pb_ty = 0;
        u32 pty = 0;        /* 结果指针的类型（指向目标对象） */
        u32 out_ty = 0;
        u32 lty = 0;        /* 提升后的公共计算类型 */
        u32 r = 0;
        u32 prod = 0;
        u32 z = 0;
        u32 one = 0;
        u32 ov = 0;

        pa_advance();
        pa_expect_ch('(');
        a = value_of(gen_assign());
        pa_ty = GEN_TY;
        pa_expect_ch(',');
        b = value_of(gen_assign());
        pb_ty = GEN_TY;
        pa_expect_ch(',');
        {
            /* 第三个实参是"结果地址"：表达式位置上的**指针值**。必须先把它
             * 求出来（在下面重算 a/b 的转换**之前**取，位置才和源码一致），
             * 结果要靠它写回去——这不是可选的收尾，GCC 的语义就是
             * "算出来、存进去、返回是否溢出"。
             *
             * 类型只能从这个表达式自己身上取，不能走 parse_typename：
             * 实参是变量/形参的写法（内核 drivers/base/devres.c:108 的
             * `check_add_overflow(sizeof(struct devres), size, tot_size)`）
             * 在类型位置上会被当成类型名整个吃光，紧跟的 `)` 于是报
             * "这里要一个表达式（当前是 ')'）"；`&d` 那条路虽然能过，
             * 拿到的 pty 也不对——`unsigned long d; &d` 会按 int 判溢出，
             * 实测 0xFFFFFFFFUL + 1 被判溢出，而 gcc 判不溢出。 */
            u32 pv = value_of(gen_assign());

            pty = GEN_TY;

            pa_expect_ch(')');
            out_ty = ty_is_ptr(pty) ? ty_target(pty) : ty_int();
            /* 计算宽度：两个操作数按 C 的常用算术转换提升到 64 位有符号
             * ——够宽，不会在中间步骤丢位。但**判溢出必须在目标类型的宽度
             * 上做**：`int 2147483647 + 1` 在 64 位里算出来是 2147483648，
             * 一切正常，只有把它截回 32 位才看得出越界（实测：只在 64 位上
             * 判符号，六个用例的 ov 全是 0，而 gcc 三个是 1）。 */
            lty = ty_long();
            a = gen_convert(a, pa_ty, lty);
            b = gen_convert(b, pb_ty, lty);
            z = irfn_vreg(&FN);
            irfn_push(&FN, IR_CONST, IRT_I64, z, 0, 0, 0, 0);
            if (is_add || is_sub) {
                prod = irfn_vreg(&FN);
                irfn_push(&FN, is_add ? IR_ADD : IR_SUB, IRT_I64, prod, a, b, 0, 0);
                ov = irfn_vreg(&FN);
                /* 统一判据：把 64 位结果截到目标宽度，再**符号/零扩展回
                 * 64 位**；回来了等于原值就是不溢出，不等就是溢出。这一条
                 * 对加法、减法、乘法、有符号、无符号全通用，不必分五种情
                 * 形各写一遍位技巧。 */
                {
                    u32 t = irfn_vreg(&FN);
                    u32 back = irfn_vreg(&FN);

                    irfn_push(&FN, IR_TRUNC, ir_ty_of(out_ty), t, prod, 0, 0, 0);
                    irfn_push(&FN, ty_is_signed(out_ty) ? IR_SEXT : IR_ZEXT,
                              IRT_I64, back, t, 0, 0, 0);
                    irfn_push(&FN, IR_CMP, IRT_I64, ov, back, prod, 0, 0);
                    irfn_setcc(&FN, IRCC_NE);
                }
            } else {
                prod = irfn_vreg(&FN);
                irfn_push(&FN, IR_MUL, IRT_I64, prod, a, b, 0, 0);
                ov = irfn_vreg(&FN);
                {
                    u32 t = irfn_vreg(&FN);
                    u32 back = irfn_vreg(&FN);

                    irfn_push(&FN, IR_TRUNC, ir_ty_of(out_ty), t, prod, 0, 0, 0);
                    irfn_push(&FN, ty_is_signed(out_ty) ? IR_SEXT : IR_ZEXT,
                              IRT_I64, back, t, 0, 0, 0);
                    irfn_push(&FN, IR_CMP, IRT_I64, ov, back, prod, 0, 0);
                    irfn_setcc(&FN, IRCC_NE);
                }
            }
            /* 结果写回 `*out`：按目标类型的宽度截断后存进去。
             * 这一步不能省——`check_add_overflow(a,b,&d)` 的调用方在返回值
             * 为假时直接读 `d`，不存就是读未初始化。 */
            {
                u32 t2 = irfn_vreg(&FN);

                irfn_push(&FN, IR_TRUNC, ir_ty_of(out_ty), t2, prod, 0, 0, 0);
                store_lval(pv, out_ty, t2);
            }
            GEN_TY = ty_int();
            return gen_postfix_ops(ov);
        }
    }
    /* 字节序内建函数：`__builtin_bswap16/32/64`。
     *
     * 内核 include/uapi/linux/swab.h 的 __swab16/32/64 直接压在它们上，进而
     * 整个内核的字节序转换（网络栈、块层）都在这一组上。语义就是纯位重排，
     * 用移位 + 或逐字节拼出来，不新增 IR op。 */
    if (TOK_EQ(t, "__builtin_bswap16") || TOK_EQ(t, "__builtin_bswap32")
        || TOK_EQ(t, "__builtin_bswap64")) {
        u32 nbytes = TOK_EQ(t, "__builtin_bswap64") ? 8u
                     : (TOK_EQ(t, "__builtin_bswap32") ? 4u : 2u);
        u32 argv = 0;
        u32 aty = 0;
        u32 ty = 0;
        u32 acc = 0;
        u32 i = 0;

        pa_advance();
        pa_expect_ch('(');
        argv = value_of(gen_assign());
        aty = GEN_TY;
        pa_expect_ch(')');
        ty = (nbytes == 8) ? ty_ulong() : ty_uint();
        argv = gen_convert(argv, aty, ty);
        acc = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, acc, 0, 0, 0, 0);
        for (i = 0; i < nbytes; i++) {
            /* 取源里的第 i 个字节（从高位数），放到目标里的第 (nbytes-1-i) 个 */
            u32 sr = irfn_vreg(&FN);
            u32 sv = irfn_vreg(&FN);
            u32 m = irfn_vreg(&FN);
            u32 sl = irfn_vreg(&FN);
            u32 sh = irfn_vreg(&FN);
            u32 na = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, sr, 0, 0, 0, i * 8u);
            irfn_push(&FN, IR_SHR, IRT_U64, sv, argv, sr, 0, 0);
            irfn_push(&FN, IR_CONST, IRT_U64, m, 0, 0, 0, 0xFFu);
            {
                u32 bv = irfn_vreg(&FN);

                irfn_push(&FN, IR_AND, IRT_U64, bv, sv, m, 0, 0);
                m = bv;
            }
            irfn_push(&FN, IR_CONST, IRT_U64, sh, 0, 0, 0,
                      (nbytes - 1u - i) * 8u);
            irfn_push(&FN, IR_SHL, IRT_U64, sl, m, sh, 0, 0);
            irfn_push(&FN, IR_OR, IRT_U64, na, acc, sl, 0, 0);
            acc = na;
        }
        GEN_TY = ty;
        return gen_postfix_ops(acc);
    }
    /* 位运算内建函数族：`__builtin_{clz,ctz,ffs,popcount}{,l,ll}`。
     *
     * 内核 arch/x86/include/asm/bitops.h、include/linux/hweight.h 把它们当
     * 基础件，整片 bitops（进而 signal、sched、mm）都压在这一族上。
     *
     * 语义按 GCC：宽度由实参类型定（`__builtin_clz(int)` 至多 32，
     * `__builtin_clzl(long)` 至多 64）；`ffs` 是 1 基、且输入 0 给 0；
     * `clz/ctz` 输入 0 时 GCC 说"未定义"，这里给位宽（clz）和位宽（ctz），
     * 是安全的确定值，不会被内核依赖成别的。
     *
     * 实现只用现成的 IR（SHL/SHR/AND/ADD/CMP/BR）：这些函数在内核里几乎
     * 全是 `__always_inline` 的小函数，出码质量不是瓶颈，语义正确才是。
     *
     * clz 的循环用**左移**看最高位、ctz 用**右移**看最低位，两者都不需要
     * "位宽 - 计数器"这种减法，循环不变量只有"离要找的那端还有几步"，
     * 也就不会出现自减到负数导致的死循环。 */
    if (TOK_EQ(t, "__builtin_clz") || TOK_EQ(t, "__builtin_clzl")
        || TOK_EQ(t, "__builtin_clzll") || TOK_EQ(t, "__builtin_ctz")
        || TOK_EQ(t, "__builtin_ctzl") || TOK_EQ(t, "__builtin_ctzll")
        || TOK_EQ(t, "__builtin_ffs") || TOK_EQ(t, "__builtin_ffsl")
        || TOK_EQ(t, "__builtin_ffsll") || TOK_EQ(t, "__builtin_popcount")
        || TOK_EQ(t, "__builtin_popcountl") || TOK_EQ(t, "__builtin_popcountll")) {
        int is_clz = TOK_EQ(t, "__builtin_clz") || TOK_EQ(t, "__builtin_clzl")
                     || TOK_EQ(t, "__builtin_clzll");
        int is_ffs = TOK_EQ(t, "__builtin_ffs") || TOK_EQ(t, "__builtin_ffsl")
                     || TOK_EQ(t, "__builtin_ffsll");
        int is_popcount = TOK_EQ(t, "__builtin_popcount")
                          || TOK_EQ(t, "__builtin_popcountl")
                          || TOK_EQ(t, "__builtin_popcountll");
        /* 宽度后缀要在 pa_advance() **之前**读：advance 之后 t 指向的
         * token 缓冲可能已经随 lexer 推进而失效（踩过：`ctzl` 被当成 32 位，
         * 因为读 t->len 时 t 已经不可靠了）。 */
        int wide = (t->len > 0 && tok_data(t)[t->len - 1] == 'l');
        u32 argv = 0;
        u32 aty = 0;
        u32 bits = 0;
        u32 one = 0;
        u32 zero = 0;

        pa_advance();
        pa_expect_ch('(');
        argv = value_of(gen_assign());
        aty = GEN_TY;
        pa_expect_ch(')');
        bits = wide ? 64u : (u32)ty_size(aty) * 8u;
        if (bits == 0 || bits > 64)
            bits = 32;
        argv = gen_convert(argv, aty, wide ? ty_ulong() : ty_uint());
        one = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, one, 0, 0, 0, 1);
        zero = irfn_vreg(&FN);
        irfn_push(&FN, IR_CONST, IRT_U64, zero, 0, 0, 0, 0);
        if (is_popcount) {
            /* popcount：逐位累加 (x >> i) & 1 */
            u32 acc = irfn_vreg(&FN);
            u32 i = 0;

            irfn_push(&FN, IR_CONST, IRT_U64, acc, 0, 0, 0, 0);
            for (i = 0; i < bits; i++) {
                u32 sh = irfn_vreg(&FN);
                u32 bi = irfn_vreg(&FN);
                u32 m = irfn_vreg(&FN);
                u32 na = irfn_vreg(&FN);

                irfn_push(&FN, IR_CONST, IRT_U64, sh, 0, 0, 0, i);
                irfn_push(&FN, IR_SHR, IRT_U64, bi, argv, sh, 0, 0);
                irfn_push(&FN, IR_AND, IRT_U64, m, bi, one, 0, 0);
                irfn_push(&FN, IR_ADD, IRT_U64, na, acc, m, 0, 0);
                acc = na;
            }
            GEN_TY = ty_int();
            return gen_postfix_ops(acc);
        }
        {
            /* clz / ctz / ffs：**完全展开**，不留循环和回边。
             *
             * 展开而不是写循环，是因为这几个函数在内核里几乎全是
             * `__always_inline` 的小函数，位宽最多 64；而带着标签/回边的
             * 手写循环一旦某条分支的落点搞错就是死循环——实测第一版
             * clz/ctz/ffs 三个全挂死（跳回了本轮体开头，cnt 还没自增）。
             * 展开成"第 i 位是不是我们要找的那个 1"的直线代码，结构一目
             * 了然，并且能顺带做常量折叠。
             *
             * 语义：结果 = 第一个命中的下标；clz 从最高位数下来、ctz 从
             * 最低位数上去、ffs 就是 ctz+1 且输入 0 给 0。全部用
             * "逐个候选值相乘/相加累加"实现，不依赖 select 或短路。 */
            {
                u32 acc = irfn_vreg(&FN);
                u32 hit = irfn_vreg(&FN);
                u32 i = 0;

                irfn_push(&FN, IR_CONST, IRT_U64, acc, 0, 0, 0, 0);
                irfn_push(&FN, IR_CONST, IRT_U64, hit, 0, 0, 0, 0);
                for (i = 0; i < bits; i++) {
                    /* bit = (argv >> shift) & 1，shift 是"第 i 位在数本身上
                     * 的位置"：clz 从高位起，所以检查的是 bits-1-i；ctz/ffs
                     * 从低位起，检查 i。 */
                    u32 idx = is_clz ? (bits - 1 - i) : i;
                    u32 sh = irfn_vreg(&FN);
                    u32 bv = irfn_vreg(&FN);
                    u32 bi = irfn_vreg(&FN);
                    u32 na = irfn_vreg(&FN);
                    u32 nh = irfn_vreg(&FN);

                    irfn_push(&FN, IR_CONST, IRT_U64, sh, 0, 0, 0, idx);
                    irfn_push(&FN, IR_SHR, IRT_U64, bv, argv, sh, 0, 0);
                    irfn_push(&FN, IR_AND, IRT_U64, bi, bv, one, 0, 0);
                    /* 只在**还没命中**时记账：acc += bi * i * (1 - hit) */
                    {
                        u32 notyet = irfn_vreg(&FN);
                        u32 iv = irfn_vreg(&FN);
                        u32 term = irfn_vreg(&FN);
                        u32 m1 = irfn_vreg(&FN);

                        irfn_push(&FN, IR_XOR, IRT_U64, notyet, hit, one, 0, 0);
                        irfn_push(&FN, IR_CONST, IRT_U64, iv, 0, 0, 0, i);
                        irfn_push(&FN, IR_MUL, IRT_U64, m1, bi, iv, 0, 0);
                        irfn_push(&FN, IR_MUL, IRT_U64, term, m1, notyet, 0, 0);
                        irfn_push(&FN, IR_ADD, IRT_U64, na, acc, term, 0, 0);
                        acc = na;
                    }
                    irfn_push(&FN, IR_OR, IRT_U64, nh, hit, bi, 0, 0);
                    hit = nh;
                }
                GEN_TY = ty_int();
                if (is_ffs) {
                    /* ffs 是 1 基、且输入 0 给 0：结果是 acc + hit（全 0 时
                     * acc=0、hit=0 → 0；有 1 时 acc 是那个下标、hit=1）。 */
                    u32 r = irfn_vreg(&FN);

                    irfn_push(&FN, IR_ADD, IRT_U64, r, acc, hit, 0, 0);
                    return gen_postfix_ops(r);
                }
                return gen_postfix_ops(acc);
            }
        }
    }

    /* `__builtin_types_compatible_p(type, type)`：以前只有常量上下文（静态断言、
     * 枚举值）能用，写进普通表达式就报"未声明的标识符"。类型在解析期就定了，
     * 所以运行期这条路也只是发一条常量。 */
    if (TOK_EQ(t, "__builtin_types_compatible_p") && pa_peek(1)->kind == TK_PUNCT
        && TOK_EQ(pa_peek(1), "(")) {
        u32 a = 0;
        u32 b = 0;
        u32 d = 0;

        pa_advance();
        pa_advance();
        a = parse_typename();
        pa_expect_punct(",");
        b = parse_typename();
        pa_expect_punct(")");
        d = irfn_vreg(&FN);
        /* C11 6.2.7p1：**顶层**限定符不参与兼容性判断（`int *` 与 `int *const`
         * 兼容），嵌套层的参与（`int **` 与 `int *restrict *` 不兼容）。
         * 常量上下文那条路一直就是这么做的，这里对齐。 */
        irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0,
                  ty_unqual(a) == ty_unqual(b) ? 1 : 0);
        GEN_TY = ty_int();
        return gen_postfix_ops(d);
    }
    if (TOK_EQ(t, "__builtin_constant_p")) {
        /* 表达式层的 `__builtin_constant_p(x)`：**真的**判，不能恒给 1。
         * 恒 1 的话内核 `ilog2(变量)` 会被折成常量分支，算出 (uint)-1 之类的
         * 垃圾（ilog2 的常量支对非常数输入没有意义）。
         *
         * 判法同常量层：扫 token 种类，字面量/运算符/类型名/枚举常量算常量，
         * 出现普通变量或赋值就不算。保守判"非常量"是安全的——那只会走
         * 运行期分支。 */
        int depth0 = 0;
        int ok = 1;

        pa_advance();
        pa_expect_ch('(');
        while (pa_cur()->kind != TK_EOF) {
            Tok *tk = pa_cur();

            if (tk->kind == TK_PUNCT) {
                if (tok_eq(tk, "(") || TOK_EQ(tk, "["))
                    depth0++;
                else if (tok_eq(tk, ")") || TOK_EQ(tk, "]")) {
                    if (depth0 == 0 && tok_eq(tk, ")"))
                        break;
                    depth0--;
                } else if (tok_eq(tk, "=") || tok_eq(tk, ";") || tok_eq(tk, "{")
                           || tok_eq(tk, "}") || tok_eq(tk, "?")) {
                    ok = 0;
                }
                pa_advance();
                continue;
            }
            if (tk->kind == TK_NUM || tk->kind == TK_CHAR || tk->kind == TK_STR) {
                pa_advance();
                continue;
            }
            if (tk->kind == TK_IDENT) {
                Sym *cs = sym_find(tok_data(tk), tk->len);

                if ((cs && cs->kind == SC_TYPEDEF) || (cs && cs->kind == SC_ENUMC)
                    || is_typename_tok(tk) || TOK_EQ(tk, "sizeof")
                    || TOK_EQ(tk, "_Alignof") || TOK_EQ(tk, "alignof")
                    || TOK_EQ(tk, "typeof") || TOK_EQ(tk, "__typeof__")
                    || TOK_EQ(tk, "__typeof")) {
                    pa_advance();
                    continue;
                }
                ok = 0;
                pa_advance();
                continue;
            }
            pa_advance();
        }
        pa_expect_ch(')');
        {
            u32 d = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, d, 0, 0, 0, (u32)ok);
            GEN_TY = ty_int();
            return gen_postfix_ops(d);
        }
