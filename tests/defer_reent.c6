/* c6 自测：清理体的可重入性
 *
 * 每个函数帧自己带着两样东西：哪些清理点已经注册（帧里的位图），以及正在
 * 服务哪个清理请求（两个 int）。所以清理体里可以随便调用别的函数、递归调用
 * 自己、再退出一个作用域——对方帧里的清理状态碰不到这一帧的，这一帧的也
 * 碰不到对方的。
 *
 * 运行（仓库根目录）：
 *   make selftest
 * 或单个文件：
 *   ./tcc/tcc -B tcc -test tests/defer_reent.c6
 */
#include <stdio.h>
#include <string.h>

static char logbuf[128] = {0};
static int loglen = 0;

static void lg_reset(void)
{
    loglen = 0;
    logbuf[0] = '\0';
}

static void lg(const char *s)
{
    while (*s && loglen < (int)sizeof(logbuf) - 2)
        logbuf[loglen++] = *s++;
    logbuf[loglen] = '\0';
}

#define LG_IS(s) (0 == strcmp(logbuf, (s)))

/* ---- 1. 清理体里调用另一个带 defer 的函数 ---- */
static int g_inner = 0;

static void inner(void)
{
    defer lg("i");
    lg("I");
    g_inner += 1;
}

static void outer(void)
{
    defer {
        lg("O1");
        inner();                    /* 对方的清理点是它自己的 */
        lg("O2");
    }
    lg("m");
}

test "清理体里调用带 defer 的函数" {
    lg_reset();
    g_inner = 0;
    outer();
    if (!LG_IS("mO1IiO2"))
        err(1, "被调用函数的清理点影响了调用者的清理体");
    if (g_inner != 1)
        err(2, "被调用函数没有正常执行");
}

/* ---- 2. 清理体里递归调用同一个函数 ---- */
static int g_rec_calls = 0;

static int rec_cleanup(int n)
{
    defer {
        g_rec_calls += 1;
        if (n > 0)
            rec_cleanup(n - 1);     /* 从清理体里再进同一函数 */
        lg("r");
    }
    return n;
}

test "清理体里递归调用同一个函数" {
    lg_reset();
    g_rec_calls = 0;
    if (rec_cleanup(2) != 2)
        err(1, "返回值不对");
    /* 第 2 帧的清理体里进第 1 帧，再进第 0 帧：日志按进入顺序 */
    if (!LG_IS("rrr"))
        err(2, "清理体里的递归顺序不对");
    if (g_rec_calls != 3)
        err(3, "清理体里的递归次数不对");
}

/* ---- 3. 两个函数互相从清理体里调用 ---- */
static int g_ping = 0;
static int g_pong = 0;

static void ping(int n);
static void pong(int n);

static void ping(int n)
{
    defer {
        g_ping += 1;
        if (n > 0)
            pong(n - 1);
    }
}

static void pong(int n)
{
    defer {
        g_pong += 1;
        if (n > 0)
            ping(n - 1);
    }
}

test "互相从清理体里调用" {
    g_ping = 0;
    g_pong = 0;
    ping(3);
    /* ping(3) → pong(2) → ping(1) → pong(0) */
    if (g_ping != 2 || g_pong != 2)
        err(1, "交叉清理体的调用次数不对");
}

/* ---- 4. 清理体里的循环：每次迭代各自退出作用域 ---- */
static void loop_in_cleanup(void)
{
    defer {
        int i = 0;
        for (i = 0; i < 3; i++) {
            defer lg("x");         /* 循环体的作用域：每次迭代各跑一次 */
        }
        lg("d");
    }
    lg("m");
}

test "清理体里循环退出作用域" {
    lg_reset();
    loop_in_cleanup();
    if (!LG_IS("mxxxd"))
        err(1, "清理体里的循环没有每次迭代各跑一次清理");
}

/* ---- 5. 清理体里连续进出同一个块 ---- */
static int g_block = 0;

static void nested_blocks(void)
{
    int i = 0;

    defer {
        for (i = 0; i < 4; i++) {
            {
                defer g_block += 1;
                defer g_block += 10;
            }
        }
    }
    /* 函数体里也走几遍同样的块，检查两个位置的位图互不串 */
    for (i = 0; i < 2; i++) {
        {
            defer g_block += 1;
            defer g_block += 10;
        }
    }
}

test "同一个函数里两处相似的块各自注册" {
    g_block = 0;
    nested_blocks();
    /* 函数体 2 轮 + 清理体 4 轮，每轮 1 + 10 = 11 */
    if (g_block != 6 * 11)
        err(1, "不同位置的块共用了同一个清理位");
}
