/* std/core/eigen：对称矩阵特征分解（Jacobi 旋转）与主特征值迭代（幂法）。
 *
 *     import std.core.eigen;
 *
 *     double a[4] = { 2, 1, 1, 2 };
 *     double ab[4] = { 0 }, vb[4] = { 0 }, db[4] = { 0 };
 *     Eigen e = { 0 };
 *     e.init(a, 2, ab, vb, db);          // 方法：init / jacobi / value / vector_at
 *     e.jacobi(1e-12, 100);              // 对称矩阵：全部特征值与特征向量
 *     e.sorted();                        // 按特征值升序
 *     e.value(1);                        // 3
 *
 * Jacobi 方法用一串正交旋转把对称矩阵对角化，数值上很稳（不收敛的情况极少）；
 * 幂法只求**模最大**的那个特征值，但不需要对称性。
 *
 * 约定：
 *
 * - `e.init(a, n, abuf, vbuf, dbuf)`：`abuf` 是 `n*n` 工作副本，`vbuf` 是 `n*n`
 *   特征向量（按**列**存，第 i 列是第 i 个特征向量），`dbuf` 是 `2n`（前 n 个存
 *   特征值，后 n 个是临时空间）；返回 1；
 * - `e.jacobi(tol, maxsweeps)` 迭代到非对角元素平方和 ≤ `tol`，返回扫掠次数，
 *   未收敛时 `e.converged() == 0`；只对**对称矩阵**有效；
 * - `e.value(i)` 第 i 个特征值，`e.vector_at(i, j)` 第 i 个特征向量的第 j 个分量；
 * - `e.sorted()` 按特征值升序重排（特征向量跟着换列），返回 1；
 * - `e.power(x0, maxiter, tol, xout)` 幂法求主特征值并返回它（`xout` 是归一化后的
 *   特征向量，长度 n）；参数非法或迭代不收敛都返回 0；
 *   **注意**：幂法用的是 `a` 里的当前内容——`jacobi` 会把 `a` 就地旋转成对角/准对角，
 *   所以「先 jacobi 再 power」应该另建一个 `Eigen` 实例（`init` 会重新拷贝原矩阵），
 *   否则等于在对角阵上迭代，只会得到某个对角元的绝对值；
 * - `e.sweeps()` 扫掠次数，`e.dim()` 阶数，`e.converged()`；
 * - 需要 `-lm`（回归脚本的 `std-*` 用例已经带上）。
 */
#include <math.h>
#include <string.h>

module std.core.eigen;
import std.core.types;
import std.text.str;

struct Eigen {
    int n;
    double *a;      /* n*n 工作副本（会变成对角阵） */
    double *v;      /* n*n 特征向量（列） */
    double *d;      /* n 个特征值 */
    double *w;      /* n 个临时 */
    int nsweep;
    int conv;
};

int init(Eigen *e, const double *src, int n, void *a_buf, void *v_buf, void *d_buf)
{
    int i = 0;

    if (!e || !src || n <= 0 || !a_buf || !v_buf || !d_buf)
        return -1;
    memset(e, 0, sizeof *e);
    e->n = n;
    e->a = (double *)a_buf;
    e->v = (double *)v_buf;
    e->d = (double *)d_buf;
    e->w = e->d + n;
    memcpy(a_buf, src, sizeof(double) * (size_t)(n * n));
    memset(v_buf, 0, sizeof(double) * (size_t)(n * n));
    memset(d_buf, 0, sizeof(double) * (size_t)(2 * n));
    for (i = 0; i < n; i++)
        e->v[i * n + i] = 1.0;
    return 1;
}

int dim(Eigen *e)
{
    return e ? e->n : 0;
}

int sweeps(Eigen *e)
{
    return e ? e->nsweep : 0;
}

int converged(Eigen *e)
{
    return e ? e->conv : 0;
}

double value(Eigen *e, int i)
{
    if (!e || !e->d || i < 0 || i >= e->n)
        return 0.0;
    return e->d[i];
}

double vector_at(Eigen *e, int i, int j)
{
    if (!e || !e->v || i < 0 || i >= e->n || j < 0 || j >= e->n)
        return 0.0;
    return e->v[j * e->n + i];
}

static double eg_offdiag(Eigen *e)
{
    double s = 0.0;
    int i = 0, j = 0;

    for (i = 0; i < e->n; i++) {
        for (j = 0; j < e->n; j++) {
            if (i != j)
                s += e->a[i * e->n + j] * e->a[i * e->n + j];
        }
    }
    return s;
}

int jacobi(Eigen *e, double tol, int maxsweeps)
{
    int sweep = 0;

    if (!e || !e->a || !e->v)
        return -1;
    if (tol <= 0.0)
        tol = 1e-12;
    if (maxsweeps <= 0)
        maxsweeps = 100;
    e->conv = 0;
    for (sweep = 0; sweep < maxsweeps; sweep++) {
        int p = 0, q = 0, i = 0;
        double best = 0.0;

        /* 找最大的非对角元素 */
        for (i = 0; i < e->n; i++) {
            int j = 0;

            for (j = i + 1; j < e->n; j++) {
                double v = fabs(e->a[i * e->n + j]);

                if (v > best) {
                    best = v;
                    p = i;
                    q = j;
                }
            }
        }
        e->nsweep = sweep + 1;
        if (best <= tol || eg_offdiag(e) <= tol * tol) {
            e->conv = 1;
            break;
        }
        /* 在 (p,q) 平面做旋转 */
        {
            double app = e->a[p * e->n + p];
            double aqq = e->a[q * e->n + q];
            double apq = e->a[p * e->n + q];
            double theta = (aqq - app) / (2.0 * apq);
            double t = 0.0, c = 0.0, s = 0.0;

            if (theta >= 0.0)
                t = 1.0 / (theta + sqrt(1.0 + theta * theta));
            else
                t = -1.0 / (-theta + sqrt(1.0 + theta * theta));
            c = 1.0 / sqrt(1.0 + t * t);
            s = t * c;
            for (i = 0; i < e->n; i++) {
                double aip = e->a[i * e->n + p];
                double aiq = e->a[i * e->n + q];

                e->a[i * e->n + p] = c * aip - s * aiq;
                e->a[i * e->n + q] = s * aip + c * aiq;
            }
            for (i = 0; i < e->n; i++) {
                double api = e->a[p * e->n + i];
                double aqi = e->a[q * e->n + i];

                e->a[p * e->n + i] = c * api - s * aqi;
                e->a[q * e->n + i] = s * api + c * aqi;
            }
            for (i = 0; i < e->n; i++) {
                double vip = e->v[i * e->n + p];
                double viq = e->v[i * e->n + q];

                e->v[i * e->n + p] = c * vip - s * viq;
                e->v[i * e->n + q] = s * vip + c * viq;
            }
            e->a[p * e->n + q] = 0.0;
            e->a[q * e->n + p] = 0.0;
        }
    }
    for (sweep = 0; sweep < e->n; sweep++)
        e->d[sweep] = e->a[sweep * e->n + sweep];
    return e->nsweep;
}

int sorted(Eigen *e)
{
    int i = 0, j = 0, k = 0;

    if (!e || !e->d || !e->v)
        return -1;
    for (i = 0; i < e->n; i++) {
        for (j = i + 1; j < e->n; j++) {
            if (e->d[j] < e->d[i]) {
                double t = e->d[i];

                e->d[i] = e->d[j];
                e->d[j] = t;
                for (k = 0; k < e->n; k++) {
                    double tv = e->v[k * e->n + i];

                    e->v[k * e->n + i] = e->v[k * e->n + j];
                    e->v[k * e->n + j] = tv;
                }
            }
        }
    }
    return 1;
}

double power(Eigen *e, const double *x0, int maxiter, double tol, double *xout)
{
    int i = 0, j = 0, it = 0;
    double lambda = 0.0;

    if (!e || !e->a || !x0 || !xout || maxiter <= 0)
        return 0.0;
    if (tol <= 0.0)
        tol = 1e-10;
    for (i = 0; i < e->n; i++)
        xout[i] = x0[i];
    for (it = 0; it < maxiter; it++) {
        double norm = 0.0;
        double prev = lambda;

        for (i = 0; i < e->n; i++) {
            double s = 0.0;

            for (j = 0; j < e->n; j++)
                s += e->a[i * e->n + j] * xout[j];
            e->w[i] = s;
        }
        for (i = 0; i < e->n; i++)
            norm += e->w[i] * e->w[i];
        norm = sqrt(norm);
        if (norm == 0.0)
            return 0.0;
        for (i = 0; i < e->n; i++)
            xout[i] = e->w[i] / norm;
        lambda = 0.0;
        for (i = 0; i < e->n; i++) {
            double s = 0.0;

            for (j = 0; j < e->n; j++)
                s += e->a[i * e->n + j] * xout[j];
            lambda += xout[i] * s;
        }
        if (it > 0 && fabs(lambda - prev) <= tol * (fabs(lambda) + 1.0))
            break;
    }
    return lambda;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "eigen：2x2 对称矩阵" {
    double a[4] = { 2, 1, 1, 2 };
    double ab[4] = { 0 }, vb[4] = { 0 }, db[4] = { 0 };
    Eigen e = { 0 };
    int i = 0;

    if (e.init(a, 2, ab, vb, db) != 1)
        return err(1, "init 失败");
    if (e.dim() != 2)
        return err(2, "维数不对");
    if (e.jacobi(1e-12, 100) <= 0 || e.converged() != 1)
        return err(3, "Jacobi 应该收敛");
    e.sorted();
    if (fabs(e.value(0) - 1.0) > 1e-9 || fabs(e.value(1) - 3.0) > 1e-9)
        return err(4, "特征值应该是 1 和 3");
    /* A·v = λ·v（两个特征向量都验） */
    for (i = 0; i < 2; i++) {
        double v0 = e.vector_at(i, 0), v1 = e.vector_at(i, 1);
        double lam = e.value(i);

        if (fabs(2 * v0 + v1 - lam * v0) > 1e-8)
            return err(5, "A·v = λ·v 不成立");
        if (fabs(v0 * v0 + v1 * v1 - 1.0) > 1e-9)
            return err(6, "特征向量应该是单位向量");
    }
    if (fabs(e.vector_at(0, 0) * e.vector_at(1, 0)
             + e.vector_at(0, 1) * e.vector_at(1, 1))
        > 1e-9)
        return err(7, "不同特征向量应该正交");
}

test "eigen：对角阵、幂法与边界" {
    double a[9] = { 2, 0, 0, 0, 3, 0, 0, 0, 5 };
    double ab[9] = { 0 }, vb[9] = { 0 }, db[6] = { 0 };
    Eigen e = { 0 };
    double x0[3] = { 1, 1, 1 };
    double xo[3] = { 0, 0, 0 };
    double lam = 0.0;

    if (e.init(a, 3, ab, vb, db) != 1)
        return err(8, "init 失败");
    e.jacobi(1e-12, 100);
    e.sorted();
    if (fabs(e.value(0) - 2.0) > 1e-9 || fabs(e.value(1) - 3.0) > 1e-9
        || fabs(e.value(2) - 5.0) > 1e-9)
        return err(9, "对角阵的特征值应该是 2/3/5");
    /* 幂法：主特征值 5 */
    lam = e.power(x0, 500, 1e-12, xo);
    if (fabs(lam - 5.0) > 1e-6)
        return err(10, "幂法主特征值应该是 5");
    if (fabs(fabs(xo[2]) - 1.0) > 1e-6)
        return err(11, "主特征向量应该集中在第三个分量");
    /* 需要 2x2 的幂法检验 */
    {
        double b[4] = { 2, 1, 1, 2 };
        double bb[4] = { 0 }, bv[4] = { 0 }, bd[4] = { 0 };
        Eigen f = { 0 };
        double y0[2] = { 1, 0 };
        double yo[2] = { 0, 0 };

        f.init(b, 2, bb, bv, bd);
        if (fabs(f.power(y0, 200, 1e-12, yo) - 3.0) > 1e-8)
            return err(12, "2x2 主特征值应该是 3");
        if (fabs(yo[0] - yo[1]) > 1e-6)
            return err(13, "主特征向量两个分量应该相等");
    }
    /* 边界 */
    if (e.value(9) != 0.0 || e.vector_at(0, 9) != 0.0)
        return err(14, "越界应该返回 0");
    if (e.init(a, 0, ab, vb, db) != -1)
        return err(15, "n=0 应该 -1");
}
