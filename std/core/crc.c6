/* std/core/crc：嵌入式常见的 CRC 与简单校验和。
 *
 *     import std.core.crc;
 *
 *     u16 c = crc16_ccitt(frame, n);            // "123456789" -> 0x29b1
 *     u16 m = crc16_modbus(frame, n);           // Modbus RTU 的尾两字节
 *     u8  k = crc8_maxim(rom_id, 7);            // 1-Wire 的 ROM CRC
 *     u16 f = fletcher16(payload, n);           // 比 CRC 便宜、够用的场合
 *     u8  l = lrc8(line, n);                    // Modbus ASCII / NMEA 风格
 *
 * 分工：`std.core.hash` 的 `crc32_bytes` 是 CRC-32/IEEE（zlib 那个），这里是
 * 嵌入式链路上真正在用的短校验：CRC-8 的两种、CRC-16 的四种、CRC-32C，外加
 * Fletcher-16、LRC、XOR 和累加和。全部**逐位算、不建表**：一个 256 项的
 * u16 表就是 512 字节的 .rodata，很多小 MCU 上比这点 CPU 值钱。
 *
 * `*_update` 是流式的原语：`crc` 是上一次的结果（第一次传 init），`poly` 写
 * **正规形式**（比如 0x1021、0x8005），`refin` 非 0 时按反射（LSB 先）算，
 * 内部把 poly 反射一次。init / xorout 由调用方按算法自己加——一次性的
 * `crc16_*` 系列就是「init + update + xorout」的三行组合，分段收数据时照
 * 同样的顺序拼即可。
 *
 * 已知向量（"123456789"，CRC 目录里的 check 值）钉在 test 块里：
 * CRC-8/SMBUS 0xf4、CRC-8/MAXIM 0xa1、CRC-16/CCITT-FALSE 0x29b1、
 * CRC-16/XMODEM 0x31c3、CRC-16/MODBUS 0x4b37、CRC-16/ARC 0xbb3d、
 * CRC-32C 0xe3069283；Fletcher-16("abcde") 0xc8f0。
 */
module std.core.crc;
import std.core.types;

/* ---- 逐位原语 ---- */

static u32 reflect_bits(u32 v, int w)
{
    u32 r = 0;
    int i = 0;

    for (i = 0; i < w; i++)
        r = (r << 1) | ((v >> i) & 1u);
    return r;
}

/* CRC-8：poly 是正规形式（0x07 / 0x31），refin 非 0 用反射算法。
 * 一次只前进一个字节，分段调用时把上一段的结果当 crc 传回来。 */
u8 crc8_update(u8 crc, const void *p, usize n, u8 poly, int refin)
{
    const u8 *b = (const u8 *)p;
    u32 c = crc;
    usize i = 0;
    int k = 0;

    if (!p)
        return crc;
    if (refin) {
        u32 rp = reflect_bits(poly, 8);
        for (i = 0; i < n; i++) {
            c ^= b[i];
            for (k = 0; k < 8; k++)
                c = ((c & 1u) ? (c >> 1) ^ rp : c >> 1) & 0xffu;
        }
    } else {
        for (i = 0; i < n; i++) {
            c ^= b[i];
            for (k = 0; k < 8; k++)
                c = ((c & 0x80u) ? ((c << 1) ^ poly) : (c << 1)) & 0xffu;
        }
    }
    return (u8)c;
}

/* CRC-16：同上，poly 用正规形式（0x1021、0x8005），init/xorout 归调用方。 */
u16 crc16_update(u16 crc, const void *p, usize n, u16 poly, int refin)
{
    const u8 *b = (const u8 *)p;
    u32 c = crc;
    usize i = 0;
    int k = 0;

    if (!p)
        return crc;
    if (refin) {
        u32 rp = reflect_bits(poly, 16);
        for (i = 0; i < n; i++) {
            c ^= b[i];
            for (k = 0; k < 8; k++)
                c = ((c & 1u) ? (c >> 1) ^ rp : c >> 1) & 0xffffu;
        }
    } else {
        for (i = 0; i < n; i++) {
            c ^= (u32)b[i] << 8;
            for (k = 0; k < 8; k++)
                c = ((c & 0x8000u) ? ((c << 1) ^ poly) : (c << 1)) & 0xffffu;
        }
    }
    return (u16)c;
}

/* CRC-32：poly 正规形式；IEEE 是 0x04c11db7，Castagnoli 是 0x1edc6f41。 */
u32 crc32_update(u32 crc, const void *p, usize n, u32 poly, int refin)
{
    const u8 *b = (const u8 *)p;
    u32 c = crc;
    usize i = 0;
    int k = 0;

    if (!p)
        return crc;
    if (refin) {
        u32 rp = reflect_bits(poly, 32);
        for (i = 0; i < n; i++) {
            c ^= b[i];
            for (k = 0; k < 8; k++)
                c = (c & 1u) ? (c >> 1) ^ rp : c >> 1;
        }
    } else {
        for (i = 0; i < n; i++) {
            c ^= (u32)b[i] << 24;
            for (k = 0; k < 8; k++)
                c = (c & 0x80000000u) ? (c << 1) ^ poly : c << 1;
        }
    }
    return c;
}

/* ---- 一次性的具名算法 ---- */

/* CRC-8/SMBUS（聚 0x07、init 0x00） */
u8 crc8_smbus(const void *p, usize n)
{
    return crc8_update(0, p, n, 0x07u, 0);
}

/* CRC-8/MAXIM（1-Wire，poly 0x31 反射、init 0x00） */
u8 crc8_maxim(const void *p, usize n)
{
    return crc8_update(0, p, n, 0x31u, 1);
}

/* CRC-16/CCITT-FALSE（poly 0x1021、init 0xffff） */
u16 crc16_ccitt(const void *p, usize n)
{
    return crc16_update(0xffffu, p, n, 0x1021u, 0);
}

/* CRC-16/XMODEM（poly 0x1021、init 0x0000） */
u16 crc16_xmodem(const void *p, usize n)
{
    return crc16_update(0, p, n, 0x1021u, 0);
}

/* CRC-16/MODBUS（poly 0x8005 反射、init 0xffff，线上低字节先发） */
u16 crc16_modbus(const void *p, usize n)
{
    return crc16_update(0xffffu, p, n, 0x8005u, 1);
}

/* CRC-16/ARC（也叫 IBM，poly 0x8005 反射、init 0x0000） */
u16 crc16_ibm(const void *p, usize n)
{
    return crc16_update(0, p, n, 0x8005u, 1);
}

/* CRC-32C（Castagnoli，poly 0x1edc6f41 反射、init/xorout 0xffffffff） */
u32 crc32c(const void *p, usize n)
{
    return crc32_update(0xffffffffu, p, n, 0x1edc6f41u, 1) ^ 0xffffffffu;
}

/* ---- 非 CRC 的简单校验 ---- */

/* Fletcher-16（按字节、模 255）：比 CRC 便宜，能发现字节换位。
 * 规范的空输入是 0x0000。 */
u16 fletcher16(const void *p, usize n)
{
    const u8 *b = (const u8 *)p;
    u32 a = 0;
    u32 c = 0;
    usize i = 0;

    if (!p)
        return 0;
    for (i = 0; i < n; i++) {
        a = (a + b[i]) % 255u;
        c = (c + a) % 255u;
    }
    return (u16)((c << 8) | a);
}

/* LRC：所有字节相加取低 8 位，再取二进制补码（Modbus ASCII 的尾字节）。 */
u8 lrc8(const void *p, usize n)
{
    const u8 *b = (const u8 *)p;
    u32 s = 0;
    usize i = 0;

    if (!p)
        return 0;
    for (i = 0; i < n; i++)
        s += b[i];
    return (u8)((0x100u - (s & 0xffu)) & 0xffu);
}

/* NMEA 0183 的异或校验：`$` 与 `*` 之间的字节逐个 XOR。 */
u8 xor8(const void *p, usize n)
{
    const u8 *b = (const u8 *)p;
    u8 x = 0;
    usize i = 0;

    if (!p)
        return 0;
    for (i = 0; i < n; i++)
        x = (u8)(x ^ b[i]);
    return x;
}

/* 8 位累加和（模 256）。 */
u8 sum8(const void *p, usize n)
{
    const u8 *b = (const u8 *)p;
    u32 s = 0;
    usize i = 0;

    if (!p)
        return 0;
    for (i = 0; i < n; i++)
        s += b[i];
    return (u8)(s & 0xffu);
}

/* 16 位累加和（模 65536，不做反码折叠）。 */
u16 sum16(const void *p, usize n)
{
    const u8 *b = (const u8 *)p;
    u32 s = 0;
    usize i = 0;

    if (!p)
        return 0;
    for (i = 0; i < n; i++)
        s += b[i];
    return (u16)(s & 0xffffu);
}

/* ---- 自测 ---- */

test "CRC-8 / CRC-16 的 check 值与分块一致性" {
    const char *d = "123456789";
    u16 c = 0;

    if (crc8_smbus(d, 9) != 0xf4 || crc8_maxim(d, 9) != 0xa1)
        return err(1, "CRC-8 的已知向量不对");
    if (crc16_ccitt(d, 9) != 0x29b1u || crc16_xmodem(d, 9) != 0x31c3u)
        return err(2, "CRC-16 CCITT/XMODEM 不对");
    if (crc16_modbus(d, 9) != 0x4b37u || crc16_ibm(d, 9) != 0xbb3du)
        return err(3, "CRC-16 MODBUS/ARC 不对");

    /* 分三段喂，结果必须和一次喂完相同（流式更新就是为这个留的） */
    c = 0xffffu;
    c = crc16_update(c, d, 3, 0x1021u, 0);
    c = crc16_update(c, d + 3, 3, 0x1021u, 0);
    c = crc16_update(c, d + 6, 3, 0x1021u, 0);
    if (c != 0x29b1u)
        return err(4, "CRC-16 分块结果不一致");

    /* 空输入就是 init：update 不许把 crc 弄丢 */
    if (crc16_ccitt(0, 0) != 0xffffu || crc16_xmodem(d, 0) != 0)
        return err(5, "空输入没有返回 init");
    if (crc16_update(0x1234u, 0, 0, 0x1021u, 0) != 0x1234u)
        return err(6, "update(NULL, 0) 改了 crc");
}

test "CRC-32C 与 CRC-32/IEEE" {
    const char *d = "123456789";

    if (crc32c(d, 9) != 0xe3069283u)
        return err(7, "CRC-32C 的向量不对");
    if (crc32_update(0xffffffffu, d, 9, 0x04c11db7u, 1) != 0x340bc6d9u)
        return err(8, "CRC-32/IEEE 的向量不对");
    /* 与 std.core.hash 的 crc32_bytes 用同一个 check 值（那边是 zlib 版） */
    if ((crc32_update(0xffffffffu, d, 9, 0x04c11db7u, 1) ^ 0xffffffffu) != 0xcbf43926u)
        return err(9, "CRC-32 的 xorout 约定不对");
    if (crc32c(0, 0) != 0)
        return err(10, "空输入的 CRC-32C 不是 0");
}

test "Fletcher-16 / LRC / XOR / 累加和" {
    const char *d = "123456789";

    if (fletcher16("abcde", 5) != 0xc8f0u)
        return err(11, "Fletcher-16 的向量不对");
    if (fletcher16(0, 0) != 0 || fletcher16("abcdef", 6) != 0x2057u)
        return err(12, "Fletcher-16 的空输入/第二向量不对");
    if (lrc8(d, 9) != 0x23 || xor8(d, 9) != 0x31)
        return err(13, "LRC / XOR 不对");
    if (sum8(d, 9) != 0xdd || sum16(d, 9) != 0x01ddu)
        return err(14, "累加和不对");
    if (lrc8(0, 0) != 0 || xor8(0, 0) != 0 || sum8(0, 0) != 0 || sum16(0, 0) != 0)
        return err(15, "空输入的简单校验不是 0");
}
