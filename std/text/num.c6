/* std/text/num：浮点数的格式化与解析（不链 libm）。
 *
 *     import std.text.num;
 *
 *     char buf[64] = { 0 };
 *     fmt_f64(3.14159, buf, sizeof buf, 2);      // 5, "3.14"
 *     fmt_f64_sci(12345.678, buf, sizeof buf, 2); // 8, "1.23e+04"
 *     fmt_f64_g(1234567.0, buf, sizeof buf, 6);   // 11, "1.23457e+06"
 *
 *     f64 v = 0.0;
 *     parse_f64(S("3.25"), &v) catch e { return e.id; };
 *
 * 为什么标准库要自带这一层：`std.text.fmt` 只写整数，`printf("%f")` 在 freestanding
 * 目标上不存在；而浮点的解析/打印又最容易出现「平台相关」的差异（`%g` 的
 * 尾零、指数格式、`inf`/`nan` 的拼写）。这里把语义钉死：
 *
 * - `fmt_f64` 固定小数位（prec 0..9，超出夹住），|x| >= 1e18 时返回 -1
 *   （整数部分会超出 u64；要打印大数用 `fmt_f64_sci`）；
 * - `fmt_f64_sci` 是 `d.dddde±XX`，指数至少两位（"1.00e+05"、"1.00e-05"），
 *   和 C 的 `%e` 一致；
 * - `fmt_f64_g` 选固定/科学里较短的那个（阈值同 `%g`：指数 < -4 或 >= 有效
 *   位数就用科学计数法），并去掉尾零：`fmt_f64_g(1.0, buf, n, 6)` → `"1"`；
 * - 三个格式化函数都用**四舍五入（.5 远离零）**，不是银行家舍入；二进制表示
 *   本身有误差（`1.005` 实际略小于 1.005），所以 `fmt_f64(1.005, ..., 2)`
 *   给 `"1.00"`——这是 double 的事实，不是格式化器在偷懒；
 * - 解析不是「正确舍入」的实现：最多累积 19 位有效数字再乘/除 10 的幂，
 *   对常见输入（15 位以内）与 libc 一致；溢出返回 `RANGE`，下溢给 0。
 *
 * 所有格式化函数都**先量长度再落笔**：cap 不够返回 -1 且一个字节都不写。
 * `nan` / `inf` / `-inf` 是固定拼写，任何精度下都一样。
 */
#include <string.h>

module std.text.num;
import std.core.types;
import std.core.err;

/* ---- 小工具 ---- */

/* inf：不写 1.0 / 0.0（常量折叠可能报除零），用溢出得到 */
static f64 num_inf(void)
{
    f64 big = 1.0e308;

    return big * 10.0;
}

/* nan：inf - inf */
static f64 num_nan(void)
{
    f64 i = num_inf();

    return i - i;
}

int f64_is_nan(f64 x) { return x != x; }

/* inf * 0 是 nan，有限数 * 0 是 0：据此区分 inf 与「很大的有限数」 */
int f64_is_inf(f64 x)
{
    f64 z = 0.0;

    if (x != x)
        return 0;
    z = x * 0.0;
    return z != z;
}

static int num_put_lit(char *buf, int cap, char *s)
{
    int n = (int)strlen(s);

    if (n + 1 > cap)
        return -1;
    memcpy(buf, s, (size_t)n + 1);
    return n;
}

static int num_u64_digits(u64 v, char *buf)
{
    char tmp[24] = { 0 };
    int n = 0, i = 0;

    if (v == 0ull) {
        buf[0] = '0';
        return 1;
    }
    while (v) {
        tmp[n++] = (char)('0' + (int)(v % 10ull));
        v /= 10ull;
    }
    for (i = 0; i < n; i++)
        buf[i] = tmp[n - 1 - i];
    return n;
}

static int num_clamp_prec(int prec)
{
    if (prec < 0)
        return 0;
    if (prec > 9)
        return 9;
    return prec;
}

/* 非负定点的内核：不写符号，四舍五入（.5 进位），先量长度再写。
   要求 0 <= ax < 1e18；放不下返回 -1 且不写。 */
static int num_fixed_pos(f64 ax, char *buf, int cap, int prec)
{
    char ipart[24] = { 0 };
    char fpart[12] = { 0 };
    f64 f = 0.0;
    u64 ip = 0ull;
    int nip = 0, nf = 0, n = 0, i = 0, total = 0;

    if (!buf || cap <= 0 || ax < 0.0)
        return -1;
    if (ax >= 1.0e18)
        return -1;
    ip = (u64)ax;
    f = ax - (f64)ip;
    for (i = 0; i < prec; i++) {
        int d = 0;

        f *= 10.0;
        d = (int)f;
        if (d < 0)
            d = 0;
        if (d > 9)
            d = 9;
        fpart[nf++] = (char)('0' + d);
        f -= (f64)d;
    }
    if (f >= 0.5) {
        i = nf - 1;
        while (i >= 0 && fpart[i] == '9') {
            fpart[i] = '0';
            i--;
        }
        if (i >= 0)
            fpart[i]++;
        else
            ip++;
    }
    nip = num_u64_digits(ip, ipart);
    total = nip + (prec > 0 ? prec + 1 : 0);
    if (total + 1 > cap)
        return -1;
    n = 0;
    memcpy(buf + n, ipart, (size_t)nip);
    n += nip;
    if (prec > 0) {
        buf[n++] = '.';
        memcpy(buf + n, fpart, (size_t)prec);
        n += prec;
    }
    buf[n] = 0;
    return n;
}

/* ---- 格式化 ---- */

int fmt_f64(f64 x, char *buf, int cap, int prec)
{
    char tmp[64] = { 0 };
    f64 ax = 0.0;
    int n = 0, neg = 0;

    if (!buf || cap <= 0)
        return -1;
    prec = num_clamp_prec(prec);
    if (f64_is_nan(x))
        return num_put_lit(buf, cap, (char *)"nan");
    if (f64_is_inf(x))
        return num_put_lit(buf, cap, x < 0.0 ? (char *)"-inf" : (char *)"inf");
    neg = x < 0.0;
    ax = neg ? -x : x;
    n = num_fixed_pos(ax, tmp, sizeof tmp, prec);
    if (n < 0)
        return -1;
    if (neg) {
        if (n + 2 > cap)
            return -1;
        buf[0] = '-';
        memcpy(buf + 1, tmp, (size_t)n + 1);
        return n + 1;
    }
    if (n + 1 > cap)
        return -1;
    memcpy(buf, tmp, (size_t)n + 1);
    return n;
}

int fmt_f64_sci(f64 x, char *buf, int cap, int prec)
{
    char mant[64] = { 0 };
    char out[96] = { 0 };
    char eb[8] = { 0 };
    f64 ax = 0.0;
    int e = 0, n = 0, nm = 0, i = 0, ne = 0, neg = 0;

    if (!buf || cap <= 0)
        return -1;
    prec = num_clamp_prec(prec);
    if (f64_is_nan(x))
        return num_put_lit(buf, cap, (char *)"nan");
    if (f64_is_inf(x))
        return num_put_lit(buf, cap, x < 0.0 ? (char *)"-inf" : (char *)"inf");
    neg = x < 0.0;
    ax = neg ? -x : x;
    if (ax != 0.0) {
        while (ax >= 10.0) {
            ax /= 10.0;
            e++;
        }
        while (ax < 1.0) {
            ax *= 10.0;
            e--;
        }
    }
    nm = num_fixed_pos(ax, mant, sizeof mant, prec);
    if (nm < 0)
        return -1;
    /* 9.999 四舍五入成 10.00：归一化成 1.000e+01 */
    if (nm >= 2 && mant[0] == '1' && mant[1] == '0') {
        mant[0] = '1';
        if (prec > 0) {
            mant[1] = '.';
            for (i = 2; i <= prec + 1; i++)
                mant[i] = '0';
            mant[prec + 2] = 0;
            nm = prec + 2;
        } else {
            mant[1] = 0;
            nm = 1;
        }
        e++;
    }
    n = 0;
    if (neg)
        out[n++] = '-';
    memcpy(out + n, mant, (size_t)nm);
    n += nm;
    out[n++] = 'e';
    out[n++] = e < 0 ? '-' : '+';
    if (e < 0)
        e = -e;
    ne = num_u64_digits((u64)e, eb);
    if (ne < 2)
        out[n++] = '0';
    memcpy(out + n, eb, (size_t)ne);
    n += ne;
    out[n] = 0;
    if (n + 1 > cap)
        return -1;
    memcpy(buf, out, (size_t)n + 1);
    return n;
}

/* 二进制指数：ax 规范化到 [1, 10) 需要除/乘几次 10 */
static int num_dec_exp(f64 ax)
{
    int e = 0;

    if (ax <= 0.0)
        return 0;
    while (ax >= 10.0) {
        ax /= 10.0;
        e++;
    }
    while (ax < 1.0) {
        ax *= 10.0;
        e--;
    }
    return e;
}

/* 把 "1.2300" 这种尾零去掉（只在小数点之后动手） */
static int num_trim_zeros(char *s, int n, int stop)
{
    int dot = -1, i = 0, last = n - 1;

    for (i = 0; i < stop; i++)
        if (s[i] == '.')
            dot = i;
    if (dot < 0)
        return n;
    while (last > dot && s[last] == '0')
        last--;
    if (last == dot)
        last--;
    return last + 1;
}

/* %g 的科学计数分支：尾零去掉，符号补在最后 */
static int num_g_sci(f64 ax, char *buf, int cap, int sig, int neg)
{
    char tmp[96] = { 0 };
    char out[96] = { 0 };
    int n = 0, epos = 0, last = 0, m = 0, i = 0;

    n = fmt_f64_sci(ax, tmp, sizeof tmp, sig - 1);
    if (n < 0)
        return -1;
    for (i = 0; i < n; i++) {
        if (tmp[i] == 'e') {
            epos = i;
            break;
        }
    }
    last = num_trim_zeros(tmp, epos, epos);
    memcpy(out, tmp, (size_t)last);
    m = last;
    memcpy(out + m, tmp + epos, (size_t)(n - epos) + 1);
    m += n - epos;
    if (neg) {
        if (m + 2 > cap)
            return -1;
        buf[0] = '-';
        memcpy(buf + 1, out, (size_t)m + 1);
        return m + 1;
    }
    if (m + 1 > cap)
        return -1;
    memcpy(buf, out, (size_t)m + 1);
    return m;
}

int fmt_f64_g(f64 x, char *buf, int cap, int sig)
{
    char tmp[96] = { 0 };
    f64 ax = 0.0;
    int e = 0, prec = 0, n = 0, neg = 0, i = 0;

    if (!buf || cap <= 0)
        return -1;
    if (sig < 1)
        sig = 1;
    if (sig > 17)
        sig = 17;
    if (f64_is_nan(x))
        return num_put_lit(buf, cap, (char *)"nan");
    if (f64_is_inf(x))
        return num_put_lit(buf, cap, x < 0.0 ? (char *)"-inf" : (char *)"inf");
    if (x == 0.0)
        return num_put_lit(buf, cap, (char *)"0");
    neg = x < 0.0;
    ax = neg ? -x : x;
    e = num_dec_exp(ax);
    if (e < -4 || e >= sig)
        return num_g_sci(ax, buf, cap, sig, neg);
    prec = sig - 1 - e;
    if (prec < 0)
        prec = 0;
    n = num_fixed_pos(ax, tmp, sizeof tmp, prec);
    if (n < 0)
        return -1;
    n = num_trim_zeros(tmp, n, n);
    /* 舍入把整数部分顶到 sig + 1 位（999999.5 -> 1000000，sig = 6）：
       %g 的规矩是改用科学计数。进位后的固定串一定是「1 后面 dot-1 个 0」，
       指数就是 dot - 1——不能再拿 ax 归一化一次，9.999995 的二进制表示略小于
       10，会得到 9.99999e+05，反而丢了刚才的进位。 */
    {
        int dot = n;

        for (i = 0; i < n; i++) {
            if (tmp[i] == '.') {
                dot = i;
                break;
            }
        }
        if (dot > sig) {
            char eb[8] = { 0 };
            int ne = 0, m = 0, ex = dot - 1, aex = 0, o = 0;

            aex = ex < 0 ? -ex : ex;
            ne = num_u64_digits((u64)aex, eb);
            m = 1 + 1 + 1 + (ne < 2 ? 1 : 0) + ne + (neg ? 1 : 0);
            if (m + 1 > cap)
                return -1;
            if (neg)
                buf[o++] = '-';
            buf[o++] = '1';
            buf[o++] = 'e';
            buf[o++] = ex < 0 ? '-' : '+';
            if (ne < 2)
                buf[o++] = '0';
            memcpy(buf + o, eb, (size_t)ne);
            o += ne;
            buf[o] = 0;
            return o;
        }
    }
    if (neg) {
        if (n + 2 > cap)
            return -1;
        buf[0] = '-';
        memcpy(buf + 1, tmp, (size_t)n);
        buf[n + 1] = 0;
        return n + 1;
    }
    if (n + 1 > cap)
        return -1;
    memcpy(buf, tmp, (size_t)n);
    buf[n] = 0;
    return n;
}

/* 四舍五入到 prec 位小数（prec 0..9）。|x| >= 1e15 时原样返回：
   再乘 10 的幂会超出 i64，硬转没有意义。 */
f64 round_to(f64 x, int prec)
{
    f64 scale = 1.0, v = 0.0;
    int i = 0;

    prec = num_clamp_prec(prec);
    if (x != x || f64_is_inf(x) || x >= 1.0e15 || x <= -1.0e15)
        return x;
    for (i = 0; i < prec; i++)
        scale *= 10.0;
    v = x * scale;
    if (v >= 0.0)
        v = (f64)(i64)(v + 0.5);
    else
        v = -(f64)(i64)(0.5 - v);
    return v / scale;
}

/* ---- 解析 ---- */

static int num_is_space(int c)
{
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v'
        || c == '\f';
}

static int num_lower(int c)
{
    if (c >= 'A' && c <= 'Z')
        return c + ('a' - 'A');
    return c;
}

static int num_eq_nocase(char *p, int n, char *w)
{
    int i = 0;

    for (i = 0; i < n; i++) {
        if (!w[i] || num_lower((int)(u8)p[i]) != num_lower((int)(u8)w[i]))
            return 0;
    }
    return w[n] == 0;
}

/* 十进制浮点解析：成功返回 0，空/空白 → INVAL，语法错 → PARSE，
   溢出（结果 > DBL_MAX）→ RANGE；下溢给 0（不是错误）。 */
int!error parse_f64(char[:] s, f64 *out)
{
    int i = 0, n = 0, neg = 0, digits = 0, frac = 0, exp10 = 0;
    int esign = 0, en = 0, edigits = 0;
    u64 mant = 0ull;
    f64 v = 0.0;

    if (!s.data || !out)
        return err(std.core.err.INVAL, "num: null argument");
    n = (int)s.len;
    while (i < n && num_is_space((int)(u8)s.data[i]))
        i++;
    while (n > i && num_is_space((int)(u8)s.data[n - 1]))
        n--;
    if (i >= n)
        return err(std.core.err.INVAL, "num: empty number");
    if (s.data[i] == '+' || s.data[i] == '-') {
        neg = s.data[i] == '-';
        i++;
    }
    /* inf / infinity / nan（大小写不敏感），要求后面没有别的字符 */
    if (n - i >= 3) {
        if (num_eq_nocase(s.data + i, 3, (char *)"inf")) {
            if (i + 3 == n) {
                *out = neg ? -num_inf() : num_inf();
                return 0;
            }
            if (n - i == 8 && num_eq_nocase(s.data + i, 8, (char *)"infinity")) {
                *out = neg ? -num_inf() : num_inf();
                return 0;
            }
            return err(std.core.err.PARSE, "num: bad number");
        }
        if (i + 3 == n && num_eq_nocase(s.data + i, 3, (char *)"nan")) {
            *out = num_nan();
            return 0;
        }
    }
    for (; i < n; i++) {
        char c = s.data[i];

        if (c >= '0' && c <= '9') {
            digits++;
            if (mant <= 999999999999999999ull) {
                mant = mant * 10ull + (u64)(c - '0');
                if (frac)
                    exp10--;
            } else if (frac) {
                exp10--;        /* 超出 19 位的部分截断，不改变量级 */
            }
        } else if (c == '.') {
            if (frac)
                return err(std.core.err.PARSE, "num: two decimal points");
            frac = 1;
        } else {
            break;
        }
    }
    if (!digits)
        return err(std.core.err.PARSE, "num: no digits");
    if (i < n && (s.data[i] == 'e' || s.data[i] == 'E')) {
        i++;
        if (i < n && (s.data[i] == '+' || s.data[i] == '-')) {
            esign = s.data[i] == '-';
            i++;
        }
        for (; i < n; i++) {
            char c = s.data[i];

            if (c < '0' || c > '9')
                return err(std.core.err.PARSE, "num: bad exponent");
            if (en < 10000)
                en = en * 10 + (c - '0');
            edigits++;
        }
        if (!edigits)
            return err(std.core.err.PARSE, "num: empty exponent");
        if (esign)
            en = -en;
        exp10 += en;
    }
    if (i != n)
        return err(std.core.err.PARSE, "num: trailing garbage");
    if (mant == 0ull) {
        *out = neg ? -0.0 : 0.0;
        return 0;
    }
    v = (f64)mant;
    if (exp10 > 400)
        return err(std.core.err.RANGE, "num: number too large");
    if (exp10 < -400) {
        *out = neg ? -0.0 : 0.0;
        return 0;
    }
    if (exp10 > 0) {
        f64 base = 10.0;
        int k = exp10;

        while (k) {
            if (k & 1)
                v *= base;
            k >>= 1;
            if (k)
                base *= base;
        }
    } else if (exp10 < 0) {
        f64 base = 10.0;
        int k = -exp10;

        while (k) {
            if (k & 1)
                v /= base;
            k >>= 1;
            if (k)
                base *= base;
        }
    }
    if (f64_is_inf(v))
        return err(std.core.err.RANGE, "num: number too large");
    *out = neg ? -v : v;
    return 0;
}

/* C 字符串版本：z 为 0 时按参数错误处理 */
int!error parse_f64_cstr(char *z, f64 *out)
{
    char[:] s = { 0 };

    if (!z)
        return err(std.core.err.INVAL, "num: null string");
    s = (char[:]){ z, (int)strlen(z) };
    return (try parse_f64(s, out));
}

/* ---- 自测 ---- */

static int num_same(char *buf, char *want)
{
    return strcmp(buf, want) == 0;
}

test "固定小数位：舍入、符号、边界" {
    char buf[64] = { 0 };

    if (fmt_f64(3.14159, buf, sizeof buf, 2) != 4 || !num_same(buf, (char *)"3.14"))
        return err(1, "3.14159 两位不对");
    if (!num_same(buf, (char *)"3.14"))
        return err(2, "3.14159 内容不对");
    fmt_f64(1234.5678, buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"1234.57"))
        return err(3, "1234.5678 不对");
    fmt_f64(9.999, buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"10.00"))
        return err(4, "9.999 的进位不对");
    fmt_f64(0.0, buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"0.00"))
        return err(5, "0 不对");
    fmt_f64(1.5, buf, sizeof buf, 0);
    if (!num_same(buf, (char *)"2"))
        return err(6, "1.5 到整数不对");
    fmt_f64(2.5, buf, sizeof buf, 0);
    if (!num_same(buf, (char *)"3"))
        return err(7, "2.5 应当向上舍入");
    fmt_f64(-1.5, buf, sizeof buf, 0);
    if (!num_same(buf, (char *)"-2"))
        return err(8, "负数舍入不对");
    fmt_f64(-0.25, buf, sizeof buf, 1);
    if (!num_same(buf, (char *)"-0.3"))
        return err(9, "负小数舍入不对");
    fmt_f64(0.1, buf, sizeof buf, 9);
    if (!num_same(buf, (char *)"0.100000000"))
        return err(10, "0.1 的九位不对");
    fmt_f64(1.0e17, buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"100000000000000000.00"))
        return err(11, "1e17 不对");
    if (fmt_f64(1.0e18, buf, sizeof buf, 2) != -1)
        return err(12, "1e18 应当返回 -1");
}

test "固定小数位：nan / inf / 精度夹取" {
    char buf[64] = { 0 };

    if (fmt_f64(num_inf(), buf, sizeof buf, 2) != 3 || !num_same(buf, (char *)"inf"))
        return err(13, "inf 的拼写不对");
    if (fmt_f64(-num_inf(), buf, sizeof buf, 2) != 4
        || !num_same(buf, (char *)"-inf"))
        return err(14, "-inf 的拼写不对");
    if (fmt_f64(num_nan(), buf, sizeof buf, 2) != 3
        || !num_same(buf, (char *)"nan"))
        return err(15, "nan 的拼写不对");
    if (!f64_is_nan(num_nan()) || f64_is_nan(1.0))
        return err(16, "is_nan 不对");
    if (!f64_is_inf(num_inf()) || !f64_is_inf(-num_inf())
        || f64_is_inf(1.0) || f64_is_inf(1.0e308))
        return err(17, "is_inf 不对");
    fmt_f64(1.5, buf, sizeof buf, 99);          /* 夹到 9 位 */
    if (!num_same(buf, (char *)"1.500000000"))
        return err(18, "prec 上限没有夹住");
    fmt_f64(1.5, buf, sizeof buf, -3);          /* 夹到 0 位 */
    if (!num_same(buf, (char *)"2"))
        return err(19, "prec 下限没有夹住");
}

test "格式化放不下时一个字节都不写" {
    char buf[8] = { 0 };

    memset(buf, 'Z', sizeof buf);
    if (fmt_f64(123456.789, buf, sizeof buf, 6) != -1)
        return err(20, "固定格式应当放不下");
    if (buf[0] != 'Z' || buf[1] != 'Z')
        return err(21, "固定格式写了半截");
    if (fmt_f64(1.0, buf, 0, 2) != -1)
        return err(22, "cap = 0 应当失败");
    if (fmt_f64(1.0, (char *)0, 8, 2) != -1)
        return err(23, "buf = NULL 应当失败");
}

test "科学计数法：指数至少两位" {
    char buf[64] = { 0 };

    fmt_f64_sci(12345.678, buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"1.23e+04"))
        return err(24, "12345.678 的科学计数不对");
    fmt_f64_sci(0.000123, buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"1.23e-04"))
        return err(25, "0.000123 的科学计数不对");
    fmt_f64_sci(9.999, buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"1.00e+01"))
        return err(26, "9.999 的归一化不对");
    fmt_f64_sci(1.0, buf, sizeof buf, 0);
    if (!num_same(buf, (char *)"1e+00"))
        return err(27, "prec 0 的科学计数不对");
    fmt_f64_sci(-2.5, buf, sizeof buf, 1);
    if (!num_same(buf, (char *)"-2.5e+00"))
        return err(28, "负数的科学计数不对");
    fmt_f64_sci(0.0, buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"0.00e+00"))
        return err(29, "0 的科学计数不对");
    fmt_f64_sci(1.0e300, buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"1.00e+300"))
        return err(30, "1e300 的科学计数不对");
}

test "最短表示 %g：尾零、阈值、负零" {
    char buf[64] = { 0 };

    fmt_f64_g(3.14, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"3.14"))
        return err(31, "3.14 的 %g 不对");
    fmt_f64_g(1.0, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"1"))
        return err(32, "1.0 的尾零没去掉");
    fmt_f64_g(100.0, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"100"))
        return err(33, "100.0 被改坏了");
    fmt_f64_g(1234567.0, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"1.23457e+06"))
        return err(34, "大数的 %g 应当用科学计数");
    fmt_f64_g(0.0001234, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"0.0001234"))
        return err(35, "0.0001234 的 %g 不对");
    fmt_f64_g(0.00001234, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"1.234e-05"))
        return err(36, "小数的 %g 应当用科学计数");
    fmt_f64_g(0.0, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"0"))
        return err(37, "0 的 %g 不对");
    fmt_f64_g(-0.5, buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"-0.5"))
        return err(38, "负数的 %g 不对");
    fmt_f64_g(1.0e300, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"1e+300"))
        return err(39, "1e300 的 %g 不对");
    fmt_f64_g(1.5, buf, sizeof buf, 1);
    if (!num_same(buf, (char *)"2"))
        return err(40, "sig = 1 的舍入不对");
    /* 舍入把整数部分顶到 7 位：%g 应改用科学计数 */
    fmt_f64_g(999999.5, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"1e+06"))
        return err(80, "进位到 sig + 1 位时应当用科学计数");
    fmt_f64_g(999999.4, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"999999"))
        return err(81, "没有进位时应当保持固定表示");
    fmt_f64_g(-999999.5, buf, sizeof buf, 6);
    if (!num_same(buf, (char *)"-1e+06"))
        return err(82, "负数的进位边界不对");
}

test "round_to 与格式化一致" {
    char buf[64] = { 0 };

    if (round_to(1.25, 1) != 1.3)
        return err(41, "1.25 到一位不对");
    if (round_to(-1.25, 1) != -1.3)
        return err(42, "-1.25 到一位不对");
    fmt_f64(round_to(1234.5678, 2), buf, sizeof buf, 2);
    if (!num_same(buf, (char *)"1234.57"))
        return err(43, "round_to 与 fmt 不一致");
    if (round_to(1.0e20, 2) != 1.0e20)
        return err(44, "超大数应当原样返回");
    if (round_to(num_inf(), 2) != num_inf())
        return err(45, "inf 应当原样返回");
}

test "parse_f64：合法输入" {
    f64 v = 0.0;

    if ((try parse_f64((char[:]){ (char *)"3.25", 4 }, &v)) != 0 || v != 3.25)
        return err(46, "3.25 不对");
    if ((try parse_f64((char[:]){ (char *)"-2.5e3", 6 }, &v)) != 0 || v != -2500.0)
        return err(47, "-2.5e3 不对");
    if ((try parse_f64((char[:]){ (char *)"  1e-2  ", 8 }, &v)) != 0
        || v != 0.01)
        return err(48, "带空白的 1e-2 不对");
    if ((try parse_f64((char[:]){ (char *)"+0.5", 4 }, &v)) != 0 || v != 0.5)
        return err(49, "+0.5 不对");
    if ((try parse_f64((char[:]){ (char *)".5", 2 }, &v)) != 0 || v != 0.5)
        return err(50, ".5 不对");
    if ((try parse_f64((char[:]){ (char *)"5.", 2 }, &v)) != 0 || v != 5.0)
        return err(51, "5. 不对");
    if ((try parse_f64((char[:]){ (char *)"0", 1 }, &v)) != 0 || v != 0.0)
        return err(52, "0 不对");
    if ((try parse_f64((char[:]){ (char *)"100", 3 }, &v)) != 0 || v != 100.0)
        return err(53, "100 不对");
    if ((try parse_f64((char[:]){ (char *)"1.5e+2", 6 }, &v)) != 0 || v != 150.0)
        return err(54, "1.5e+2 不对");
    if ((try parse_f64((char[:]){ (char *)"1234567890123456789", 19 }, &v)) != 0)
        return err(55, "19 位整数不该失败");
    if (v < 1.2345678901234567e18 || v > 1.2345678901234568e18)
        return err(56, "19 位整数不对");
}

test "parse_f64：inf / nan / 错误码" {
    f64 v = 0.0;
    int id = 0;

    if ((try parse_f64((char[:]){ (char *)"inf", 3 }, &v)) != 0
        || !f64_is_inf(v) || v < 0.0)
        return err(57, "inf 不对");
    if ((try parse_f64((char[:]){ (char *)"-Infinity", 9 }, &v)) != 0
        || !f64_is_inf(v) || v > 0.0)
        return err(58, "-Infinity 不对");
    if ((try parse_f64((char[:]){ (char *)"NaN", 3 }, &v)) != 0
        || !f64_is_nan(v))
        return err(59, "NaN 不对");
    parse_f64((char[:]){ (char *)"", 0 }, &v) catch e {
        id = e.id;
        goto bad_empty;
    };
    return err(60, "空输入没有报错");
bad_empty:
    if (id != std.core.err.INVAL)
        return err(61, "空输入的错误码不是 INVAL");

    id = 0;
    parse_f64((char[:]){ (char *)"1.2.3", 5 }, &v) catch e {
        id = e.id;
        goto bad_syntax;
    };
    return err(62, "1.2.3 没有报错");
bad_syntax:
    if (id != std.core.err.PARSE)
        return err(63, "语法错误码不是 PARSE");

    id = 0;
    parse_f64((char[:]){ (char *)"1e400", 5 }, &v) catch e {
        id = e.id;
        goto bad_range;
    };
    return err(64, "1e400 没有报错");
bad_range:
    if (id != std.core.err.RANGE)
        return err(65, "溢出的错误码不是 RANGE");
}

test "parse_f64：拒绝语法垃圾" {
    char[:] bad[10] = { { (char *)"", 0 }, { (char *)"  ", 2 },
                        { (char *)"abc", 3 }, { (char *)"1.2.3", 5 },
                        { (char *)"1e", 2 }, { (char *)"1e+", 3 },
                        { (char *)"1.5x", 4 }, { (char *)"--1", 3 },
                        { (char *)"1..2", 4 }, { (char *)"+-1", 3 } };
    int i = 0;

    for (i = 0; i < 10; i++) {
        f64 v = 0.0;
        int id = 0;

        parse_f64(bad[i], &v) catch e {
            id = e.id;
            goto next;
        };
        return err(66, "垃圾输入没有报错");
next:
        if (id != std.core.err.PARSE && id != std.core.err.INVAL)
            return err(67, "垃圾输入的错误码不在 PARSE/INVAL 里");
    }
}

test "parse_f64：下溢给 0" {
    f64 v = 1.0;

    if ((try parse_f64((char[:]){ (char *)"1e-400", 6 }, &v)) != 0 || v != 0.0)
        return err(68, "下溢应当给 0");
    if ((try parse_f64((char[:]){ (char *)"-1e-400", 7 }, &v)) != 0
        || v != 0.0)
        return err(69, "负下溢应当给 0");
}

test "parse_f64 与 fmt_f64_g 往返" {
    char buf[64] = { 0 };
    f64 v = 0.0;

    fmt_f64_g(1234.5678, buf, sizeof buf, 15);
    if ((try parse_f64((char[:]){ buf, (int)strlen(buf) }, &v)) != 0)
        return err(70, "格式化结果解析失败");
    if (v < 1234.567799999 || v > 1234.567800001)
        return err(71, "往返之后数值变了");
    if ((try parse_f64_cstr((char *)"2.5", &v)) != 0 || v != 2.5)
        return err(72, "parse_f64_cstr 不对");
}
