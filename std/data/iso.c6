/* std/data/iso：ISO 9660 主卷描述符与目录记录。
 *
 *     import std.data.iso;
 *
 *     IsoVolume v = { 0 };
 *     IsoEntry e = { 0 };
 *     if (iso_volume(buf, n, &v) == 1
 *         && iso_find(buf, n, 20, 2048, v.block_size, "README.TXT", &e) == 1)
 *         // e.lba / e.size
 *
 * 主卷描述符在逻辑扇区 16（默认 2048 字节）：类型 1、标识 `CD001`、卷 ID 在
 * 偏移 40（32 字节，空格补齐）、卷空间大小 80（双端序）、逻辑块大小 128（双端序，
 * 两个 16 位）、根目录记录 156（34 字节）。
 *
 * 目录记录：长度(0)、扩展属性长度(1)、extent LBA(2, 双端序)、数据长度(10,
 * 双端序)、记录时间(18, 7 字节)、标志(25)、名字长度(32)、名字(33)。
 *
 * 约定：
 *
 * - 只认主卷描述符（类型 1）；Joliet（类型 2 的 `%/E` 转义）与 El Torito 不管；
 * - 名字去掉 `;N` 版本号与末尾的 `.`；标识 `0x00` 是 `.`、`0x01` 是 `..`；
 * - `flags & 2` 是目录；
 * - `iso_find` 按名字**原样**比较（ISO 通常大写，要大小写不敏感请自己转）；
 * - 目录里长度为 0 的记录表示本块用完了，跳到下一个逻辑块继续；
 * - 不读路径表、不跟多段 extent（`flags & 0x80`）、不校验 Rock Ridge。
 */
#include <string.h>

module std.data.iso;
import std.core.types;
import std.text.str;

struct IsoVolume {
    int block_size;
    u32 volume_blocks;
    int sys_id_len;
    int volume_id_len;
    char sys_id[33];
    char volume_id[33];
    u32 root_lba;
    u32 root_size;
};

struct IsoEntry {
    u32 lba;
    u32 size;
    int flags;
    int name_len;
    char name[64];
};

static u32 iso_le32(const u8 *p)
{
    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16)
           | (u32)p[3] << 24;
}

static u32 iso_be16(const u8 *p)
{
    return ((u32)p[0] << 8) | (u32)p[1];
}

static int iso_str(char *dst, int cap, const u8 *src, int len)
{
    int i = 0, k = 0;

    for (i = 0; i < len; i++) {
        if (src[i] == ' ' && k > 0)
            break;
        if (src[i] == ' ')
            continue;
        if (k + 1 < cap)
            dst[k++] = (char)src[i];
    }
    dst[k] = 0;
    return k;
}

int iso_volume(const void *src, int n, IsoVolume *out)
{
    const u8 *p = (const u8 *)src;
    const u8 *d = 0;

    if (!src || !out || n < 17 * 2048)
        return -1;
    d = p + 16 * 2048;
    if (d[0] != 1 || memcmp(d + 1, "CD001", 5) != 0 || d[6] != 1)
        return -1;
    memset(out, 0, sizeof *out);
    out->sys_id_len = iso_str(out->sys_id, (int)sizeof out->sys_id, d + 8, 32);
    out->volume_id_len = iso_str(out->volume_id, (int)sizeof out->volume_id,
                                 d + 40, 32);
    out->volume_blocks = iso_le32(d + 80);
    out->block_size = (int)iso_be16(d + 130);
    if (out->block_size != 512 && out->block_size != 1024
        && out->block_size != 2048 && out->block_size != 4096)
        return -1;
    if (out->volume_blocks == 0)
        return -1;
    if (d[156] < 34)
        return -1;
    out->root_lba = iso_le32(d + 156 + 2);
    out->root_size = iso_le32(d + 156 + 10);
    return 1;
}

int iso_record(const void *src, int n, int off, IsoEntry *out)
{
    const u8 *p = (const u8 *)src;
    const u8 *e = 0;
    int len = 0, nlen = 0, i = 0, k = 0;

    if (!src || !out || off < 0 || off >= n)
        return -1;
    e = p + off;
    len = (int)e[0];
    if (len == 0)
        return 0;
    if (off + len > n || len < 34)
        return -1;
    nlen = (int)e[32];
    if (33 + nlen > len)
        return -1;
    memset(out, 0, sizeof *out);
    out->lba = iso_le32(e + 2);
    out->size = iso_le32(e + 10);
    out->flags = (int)e[25];
    if (nlen == 1 && e[33] == 0) {
        out->name[0] = '.';
        out->name_len = 1;
        return 1;
    }
    if (nlen == 1 && e[33] == 1) {
        out->name[0] = '.';
        out->name[1] = '.';
        out->name_len = 2;
        return 1;
    }
    for (i = 0; i < nlen && k < 63; i++) {
        char c = (char)e[33 + i];

        if (c == ';')
            break;
        if (c == '.' && i + 1 == nlen)
            break;
        out->name[k++] = c;
    }
    out->name[k] = 0;
    out->name_len = k;
    if (out->lba == 0 || out->size == 0)
        return -1;
    return 1;
}

int iso_find(const void *src, int n, u32 dir_lba, u32 dir_size, int block_size,
             const char *name, IsoEntry *out)
{
    const u8 *p = (const u8 *)src;
    u64 base = (u64)dir_lba * (u64)block_size;
    u64 end = base + (u64)dir_size;
    int off = 0;
    IsoEntry e = { 0 };
    int wlen = 0;

    if (!src || !name || dir_size == 0 || block_size <= 0)
        return -1;
    if (end > (u64)n)
        return -1;
    wlen = (int)strlen(name);
    if (wlen <= 0 || wlen > 63)
        return -1;
    off = (int)base;
    while (off < (int)end) {
        int r = iso_record(src, n, off, &e);

        if (r < 0)
            return -1;
        if (r == 0) {
            /* 本块用完了：跳到下一个块边界 */
            off = (off / block_size + 1) * block_size;
            continue;
        }
        if (e.name_len == wlen && memcmp(e.name, name, (size_t)wlen) == 0) {
            if (out)
                *out = e;
            return 1;
        }
        off += (int)p[off];
    }
    return 0;
}

/* ---- 自测 ---- */

static void iso_put_le32(u8 *p, u32 v)
{
    p[0] = (u8)(v & 0xFF);
    p[1] = (u8)((v >> 8) & 0xFF);
    p[2] = (u8)((v >> 16) & 0xFF);
    p[3] = (u8)((v >> 24) & 0xFF);
}

static void iso_put_be32(u8 *p, u32 v)
{
    p[0] = (u8)((v >> 24) & 0xFF);
    p[1] = (u8)((v >> 16) & 0xFF);
    p[2] = (u8)((v >> 8) & 0xFF);
    p[3] = (u8)(v & 0xFF);
}

static void iso_both32(u8 *p, u32 v)
{
    iso_put_le32(p, v);
    iso_put_be32(p + 4, v);
}

static void iso_both16(u8 *p, int v)
{
    p[0] = (u8)(v & 0xFF);
    p[1] = (u8)((v >> 8) & 0xFF);
    p[2] = (u8)((v >> 8) & 0xFF);
    p[3] = (u8)(v & 0xFF);
}

/* 造 "." 或 ".." 记录（标识是单字节 0x00 / 0x01） */
static int mk_iso_dot(u8 *e, u32 lba, u32 size, int which)
{
    memset(e, 0, 34);
    e[0] = 34;
    iso_both32(e + 2, lba);
    iso_both32(e + 10, size);
    e[25] = 2;
    e[28] = 1;
    e[31] = 1;
    e[32] = 1;
    e[33] = (u8)which;
    return 34;
}

/* 造一条目录记录，返回长度 */
static int mk_iso_rec(u8 *e, u32 lba, u32 size, int flags, const char *name)
{
    int nlen = (int)strlen(name);
    int len = 33 + nlen;

    if ((nlen & 1) == 0)
        len++;                          /* 名字后补一个 0 使其偶数 */
    memset(e, 0, (size_t)len);
    e[0] = (u8)len;
    iso_both32(e + 2, lba);
    iso_both32(e + 10, size);
    e[25] = (u8)flags;
    e[28] = 1;
    e[29] = 0;
    e[30] = 0;
    e[31] = 1;
    e[32] = (u8)nlen;
    memcpy(e + 33, name, (size_t)nlen);
    return len;
}

test "iso：主卷描述符" {
    static u8 buf[24 * 2048] = { 0 };
    IsoVolume v = { 0 };
    u8 *d = buf + 16 * 2048;
    u8 rec[64] = { 0 };

    d[0] = 1;
    memcpy(d + 1, "CD001", 5);
    d[6] = 1;
    memcpy(d + 8, "LINUX                   ", 32);
    memcpy(d + 40, "TESTISO                 ", 32);
    iso_both32(d + 80, 1000);
    iso_both16(d + 128, 2048);
    mk_iso_dot(rec, 20, 2048, 0);
    memcpy(d + 156, rec, 34);
    if (iso_volume(buf, (int)sizeof buf, &v) != 1)
        return err(1, "PVD 解析失败");
    if (v.block_size != 2048 || v.volume_blocks != 1000)
        return err(2, "块大小或卷大小不对");
    if (v.volume_id_len != 7 || memcmp(v.volume_id, "TESTISO", 7) != 0)
        return err(3, "卷 ID 不对");
    if (v.sys_id_len != 5 || memcmp(v.sys_id, "LINUX", 5) != 0)
        return err(4, "系统 ID 不对");
    if (v.root_lba != 20 || v.root_size != 2048)
        return err(5, "根目录记录不对");
    if (iso_volume(buf, 8 * 2048, &v) != -1)
        return err(6, "太短应该 -1");
    buf[16 * 2048 + 1] = 'X';
    if (iso_volume(buf, (int)sizeof buf, &v) != -1)
        return err(7, "标识不对应该 -1");
}

test "iso：目录记录与按名查找" {
    static u8 buf[24 * 2048] = { 0 };
    u8 *dir = buf + 20 * 2048;
    IsoEntry e = { 0 };
    int off = 0, r = 0;

    off += mk_iso_dot(dir + off, 20, 2048, 0);
    off += mk_iso_dot(dir + off, 20, 2048, 1);
    off += mk_iso_rec(dir + off, 21, 100, 0, "README.TXT;1");
    off += mk_iso_rec(dir + off, 22, 4096, 2, "DOCS");
    if (iso_record(buf, (int)sizeof buf, 20 * 2048, &e) != 1)
        return err(8, "第一条记录失败");
    if (e.name_len != 1 || e.name[0] != '.')
        return err(9, "标识 0x00 应该是 .");
    if (e.flags != 2 || e.lba != 20)
        return err(10, "根目录记录字段不对");
    r = iso_find(buf, (int)sizeof buf, 20, 2048, 2048, "README.TXT", &e);
    if (r != 1)
        return err(11, "找不到 README.TXT");
    if (e.name_len != 10 || memcmp(e.name, "README.TXT", 10) != 0)
        return err(12, "名字应该去掉 ;1");
    if (e.lba != 21 || e.size != 100 || e.flags != 0)
        return err(13, "文件字段不对");
    if (iso_find(buf, (int)sizeof buf, 20, 2048, 2048, "DOCS", &e) != 1
        || e.size != 4096)
        return err(14, "找不到 DOCS 目录");
    if (iso_find(buf, (int)sizeof buf, 20, 2048, 2048, "NOPE", &e) != 0)
        return err(15, "不存在的名字应该 0");
    if (iso_find(buf, (int)sizeof buf, 20, 4096, 2048, "README.TXT", &e) != 1)
        return err(16, "跨块扫描失败");
    buf[21 * 2048] = 5;                 /* 记录长度 5 < 34 */
    if (iso_record(buf, (int)sizeof buf, 21 * 2048, &e) != -1)
        return err(17, "记录长度过小应该 -1");
}
