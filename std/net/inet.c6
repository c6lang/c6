/* std/net/inet：IP 地址、CIDR 前缀与端口的解析与格式化。
 *
 *     import std.net.inet;
 *
 *     Ip a = { 0 };
 *     inet_parse(S("192.168.0.1"), &a);            // 1；a.family == IP_V4
 *     inet_parse(S("2001:db8::1"), &a);            // 1；a.family == IP_V6
 *
 *     char buf[64] = { 0 };
 *     a.format( buf, sizeof buf);            // "2001:db8::1"
 *
 *     Ip net = { 0 };
 *     int prefix = 0;
 *     inet_parse_cidr(S("10.0.0.0/8"), &net, &prefix);   // 1，prefix = 8
 *     Ip host = { 0 };
 *     inet_parse(S("10.1.2.3"), &host);
 *     net.cidr_contains( prefix, &host);     // 1
 *
 * 这一层**零分配**（`Ip`/`Ipv4`/`Ipv6` 都是纯值），语义钉在三个标准上：
 *
 * - **IPv4** 是严格的点分十进制：四段、每段 0..255、**不接受前导零**
 *   （`010.0.0.1` 有八进制歧义，`inet_pton` 也拒），前后空白不跳过
 *   （调用方该先 trim——`std.text.str` 的 `trim`）；
 * - **IPv6** 是 RFC 4291 的文本形式：`::` 至多一次、每组 1..4 个十六进制位、
 *   末尾可以内嵌点分 IPv4（占两组）；输出按 **RFC 5952** 规范化——最长零段
 *   压成 `::`（长度相同时取**第一个**，单组零不压）、小写、无前导零，
 *   IPv4-mapped 一律写 `::ffff:a.b.c.d`；
 * - **端口**是纯十进制 0..65535（`65536`、`-1`、` 80` 都拒）。
 *
 * 分类函数（`is_private` 等）按地址族各看各的号段，v4-mapped 的 v6 地址
 * 先折回 v4 再判——`::ffff:127.0.0.1` 算回环，这是调用方最可能期待的行为。
 *
 * 所有 `*_format` 都**先量长度再落笔**：放不下返回 -1 且一个字节都不写（并且在
 * 成功时补结尾 NUL）。
 */
#include <string.h>
#include <stdio.h>

module std.net.inet;
import std.core.types;
import std.core.err;

enum Error { OK = 0, PARSE = 1, INVAL = 2, RANGE = 3 };

enum Family { IP_V4 = 4, IP_V6 = 6 };

struct Ipv4 {
    u8 b[4];
};

struct Ipv6 {
    u8 b[16];
};

/* 统一的地址：family 决定看 v4 那 4 字节还是 v6 那 16 字节 */
struct Ip {
    int family;
    u8 b[16];
};

static int inet_hex(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
        return c - 'A' + 10;
    return -1;
}

/* ---- IPv4 ---- */

/* 解析 [from, to) 这四点分十进制；成功写 4 字节。严格：无前导零、无空白。 */
static int inet_v4_range(char[:] s, int from, int to, Ipv4 *out)
{
    int part = 0;
    int i = from;

    while (part < 4) {
        int v = 0;
        int digits = 0;
        int start = i;

        while (i < to && s.data[i] != '.') {
            int c = (u8)s.data[i];

            if (c < '0' || c > '9')
                return 0;
            v = v * 10 + (c - '0');
            if (v > 255)
                return 0;
            digits++;
            if (digits > 3)
                return 0;
            i++;
        }
        if (digits == 0)
            return 0;
        if (digits > 1 && s.data[start] == '0')
            return 0;               /* 前导零有八进制歧义 */
        out->b[part] = (u8)v;
        part++;
        if (part < 4) {
            if (i >= to || s.data[i] != '.')
                return 0;           /* 少了一段 */
            i++;                    /* 跳过 '.' */
        } else if (i != to) {
            return 0;               /* 多了一段 */
        }
    }
    return 1;
}

int inet_parse_v4(char[:] s, Ipv4 *out)
{
    Ipv4 t = { { 0, 0, 0, 0 } };

    if (!out || s.len <= 0)
        return 0;
    if (!inet_v4_range(s, 0, s.len, &t))
        return 0;
    *out = t;
    return 1;
}

static int inet_v4_put(Ipv4 *a, char *dst, int cap)
{
    char tmp[16] = { 0 };
    int o = 0;
    int i = 0;

    for (i = 0; i < 4; i++) {
        u32 v = a->b[i];
        char num[4] = { 0 };
        int k = 0;

        if (v >= 100)
            num[k++] = (char)('0' + (int)(v / 100));
        if (v >= 10)
            num[k++] = (char)('0' + (int)((v / 10) % 10));
        num[k++] = (char)('0' + (int)(v % 10));
        if (i > 0)
            tmp[o++] = '.';
        memcpy(tmp + o, num, (size_t)k);
        o += k;
    }
    if (o + 1 > cap)
        return -1;
    memcpy(dst, tmp, (size_t)o);
    dst[o] = 0;
    return o;
}

int format(Ipv4 *a, char *dst, int cap)
{
    if (!a || !dst)
        return -1;
    return inet_v4_put(a, dst, cap);
}

/* 前 prefix 位的网络掩码（v4）：前 prefix 个 1 */
int inet_v4_mask(int prefix, Ipv4 *out)
{
    int i = 0;

    if (!out || prefix < 0 || prefix > 32)
        return 0;
    for (i = 0; i < 4; i++) {
        int bits = prefix - i * 8;

        if (bits >= 8)
            out->b[i] = 0xff;
        else if (bits <= 0)
            out->b[i] = 0;
        else
            out->b[i] = (u8)(0xff << (8 - bits));
    }
    return 1;
}

/* ---- IPv6 ---- */

/* 解析不含 "::" 的一段：组写进 g，返回组数；失败给 -1。
   末尾允许内嵌点分 IPv4（占两组），且它必须是最后一段。 */
static int inet_v6_seg(char[:] s, u16 *g, int max)
{
    int n = 0;
    int i = 0;

    if (s.len == 0)
        return 0;
    while (i < s.len) {
        int start = i;
        int v = 0;
        int digits = 0;
        int has_dot = 0;

        while (i < s.len && s.data[i] != ':') {
            if (s.data[i] == '.')
                has_dot = 1;
            i++;
        }
        if (has_dot) {
            /* 内嵌 IPv4：必须是最后一段 */
            Ipv4 a = { { 0, 0, 0, 0 } };

            if (i != s.len)
                return -1;
            if (!inet_v4_range(s, start, i, &a))
                return -1;
            if (n + 2 > max)
                return -1;
            g[n++] = (u16)(((u16)a.b[0] << 8) | (u16)a.b[1]);
            g[n++] = (u16)(((u16)a.b[2] << 8) | (u16)a.b[3]);
            return n;
        }
        if (i - start == 0 || i - start > 4)
            return -1;
        while (start < i) {
            int h = inet_hex((u8)s.data[start]);

            if (h < 0)
                return -1;
            v = v * 16 + h;
            start++;
        }
        if (n >= max)
            return -1;
        g[n++] = (u16)v;
        if (i < s.len) {
            i++;                    /* 跳过 ':' */
            if (i == s.len)
                return -1;          /* 结尾单个 ':' */
        }
    }
    return n;
}

int inet_parse_v6(char[:] s, Ipv6 *out)
{
    u16 left[8] = { 0 };
    u16 right[8] = { 0 };
    int nl = 0;
    int nr = 0;
    int dc = -1;
    int i = 0;
    int k = 0;
    Ipv6 t = { { 0 } };

    if (!out || s.len <= 0)
        return 0;
    for (i = 0; i + 1 < s.len; i++) {
        if (s.data[i] == ':' && s.data[i + 1] == ':') {
            dc = i;
            break;
        }
    }
    if (dc < 0) {
        nl = inet_v6_seg(s, left, 8);
        if (nl != 8)
            return 0;
        for (k = 0; k < 8; k++) {
            t.b[k * 2] = (u8)(left[k] >> 8);
            t.b[k * 2 + 1] = (u8)(left[k] & 0xff);
        }
        *out = t;
        return 1;
    }
    /* "::" 只能出现一次 */
    for (k = dc + 2; k + 1 < s.len; k++)
        if (s.data[k] == ':' && s.data[k + 1] == ':')
            return 0;
    nl = inet_v6_seg((char[:]){ s.data, dc }, left, 8);
    if (nl < 0)
        return 0;
    nr = inet_v6_seg((char[:]){ s.data + dc + 2, s.len - dc - 2 }, right, 8);
    if (nr < 0)
        return 0;
    if (nl + nr > 7)
        return 0;                   /* "::" 至少要代表一组零 */
    for (k = 0; k < nl; k++) {
        t.b[k * 2] = (u8)(left[k] >> 8);
        t.b[k * 2 + 1] = (u8)(left[k] & 0xff);
    }
    for (k = 0; k < nr; k++) {
        int at = (8 - nr + k) * 2;

        t.b[at] = (u8)(right[k] >> 8);
        t.b[at + 1] = (u8)(right[k] & 0xff);
    }
    *out = t;
    return 1;
}

/* 是不是 IPv4-mapped（::ffff:a.b.c.d） */
static int inet_v6_is_v4_mapped(Ipv6 *a)
{
    int i = 0;

    for (i = 0; i < 10; i++)
        if (a->b[i] != 0)
            return 0;
    return a->b[10] == 0xff && a->b[11] == 0xff;
}

/* RFC 5952：最长零段压成 "::"（≥2 组、同长取第一个）、小写、无前导零 */
static int inet_v6_put(Ipv6 *a, char *dst, int cap)
{
    char tmp[48] = { 0 };
    u16 g[8] = { 0 };
    int best_at = -1;
    int best_len = 0;
    int o = 0;
    int i = 0;

    /* 注意：IPv4-mapped 由 format 先接走，这里只处理普通十六进制形式 */
    for (i = 0; i < 8; i++)
        g[i] = (u16)(((u16)a->b[i * 2] << 8) | (u16)a->b[i * 2 + 1]);
    for (i = 0; i < 8;) {
        int j = i;

        while (j < 8 && g[j] == 0)
            j++;
        if (j - i > best_len && j - i >= 2) {
            best_at = i;
            best_len = j - i;
        }
        i = (j > i) ? j : i + 1;
    }
    for (i = 0; i < 8; i++) {
        if (i == best_at) {
            tmp[o++] = ':';
            tmp[o++] = ':';
            i += best_len - 1;
            continue;
        }
        if (o > 0 && tmp[o - 1] != ':')
            tmp[o++] = ':';
        {
            char hex[4] = { 0 };
            int k = 0;
            u16 v = g[i];

            if (v >= 0x1000)
                hex[k++] = (char)("0123456789abcdef"[(v >> 12) & 0xf]);
            if (v >= 0x0100)
                hex[k++] = (char)("0123456789abcdef"[(v >> 8) & 0xf]);
            if (v >= 0x0010)
                hex[k++] = (char)("0123456789abcdef"[(v >> 4) & 0xf]);
            hex[k++] = (char)("0123456789abcdef"[v & 0xf]);
            memcpy(tmp + o, hex, (size_t)k);
            o += k;
        }
    }
    if (o + 1 > cap)
        return -1;
    memcpy(dst, tmp, (size_t)o);
    dst[o] = 0;
    return o;
}

int format(Ipv6 *a, char *dst, int cap)
{
    char tmp[64] = { 0 };
    Ipv4 v4 = { { 0, 0, 0, 0 } };
    int n = 0;

    if (!a || !dst)
        return -1;
    if (inet_v6_is_v4_mapped(a)) {
        memcpy(v4.b, a->b + 12, 4);
        n = inet_v4_put(&v4, tmp, (int)sizeof tmp);
        if (n < 0)
            return -1;
        if (14 + n + 1 > cap)
            return -1;
        memcpy(dst, "::ffff:", 7);
        memcpy(dst + 7, tmp, (size_t)n);
        dst[7 + n] = 0;
        return 7 + n;
    }
    return inet_v6_put(a, dst, cap);
}

/* ---- 统一入口 ---- */

/* 自动识别 v4 / v6：含 ':' 当 v6，否则按 v4 */
int inet_parse(char[:] s, Ip *out)
{
    int i = 0;
    int has_colon = 0;

    if (!out || s.len <= 0)
        return 0;
    for (i = 0; i < s.len; i++)
        if (s.data[i] == ':')
            has_colon = 1;
    if (has_colon) {
        Ipv6 a = { { 0 } };

        if (!inet_parse_v6(s, &a))
            return 0;
        out->family = IP_V6;
        memcpy(out->b, a.b, 16);
        return 1;
    }
    {
        Ipv4 a = { { 0, 0, 0, 0 } };

        if (!inet_parse_v4(s, &a))
            return 0;
        out->family = IP_V4;
        memset(out->b, 0, 16);
        memcpy(out->b, a.b, 4);
        return 1;
    }
}

int format(Ip *a, char *dst, int cap)
{
    if (!a || !dst || cap <= 0)
        return -1;
    if (a->family == IP_V4) {
        Ipv4 v4 = { { 0, 0, 0, 0 } };

        memcpy(v4.b, a->b, 4);
        return v4.format( dst, cap);
    }
    if (a->family == IP_V6) {
        Ipv6 v6 = { { 0 } };

        memcpy(v6.b, a->b, 16);
        return v6.format( dst, cap);
    }
    return -1;
}

/* 两个地址同族且逐字节相同 */
int eq(Ip *self, Ip *other)
{
    if (!self || !other || self->family != other->family)
        return 0;
    return memcmp(self->b, other->b, 16) == 0;
}

/* ---- CIDR ---- */

/* 解析 "addr/prefix"；没有 '/' 时按主机前缀（v4 32 / v6 128）给 */
int inet_parse_cidr(char[:] s, Ip *net, int *prefix)
{
    int slash = -1;
    int i = 0;
    int p = 0;
    Ip a = { 0 };

    if (!net || !prefix || s.len <= 0)
        return 0;
    for (i = 0; i < s.len; i++) {
        if (s.data[i] == '/') {
            if (slash >= 0)
                return 0;
            slash = i;
        }
    }
    if (slash < 0) {
        if (!inet_parse(s, &a))
            return 0;
        *net = a;
        *prefix = (a.family == IP_V4) ? 32 : 128;
        return 1;
    }
    if (!inet_parse((char[:]){ s.data, slash }, &a))
        return 0;
    {
        char[:] ps = { s.data + slash + 1, s.len - slash - 1 };
        int digits = 0;

        if (ps.len == 0)
            return 0;
        for (i = 0; i < ps.len; i++) {
            int c = (u8)ps.data[i];

            if (c < '0' || c > '9')
                return 0;
            p = p * 10 + (c - '0');
            digits++;
            if (digits > 3)
                return 0;
        }
        if (digits > 1 && ps.data[0] == '0')
            return 0;
    }
    if (a.family == IP_V4 && p > 32)
        return 0;
    if (a.family == IP_V6 && p > 128)
        return 0;
    *net = a;
    *prefix = p;
    return 1;
}

/* addr 的前 prefix 位是不是和 net 一样（family 必须相同） */
int cidr_contains(Ip *net, int prefix, Ip *addr)
{
    int full = 0;
    int rest = 0;
    int i = 0;

    if (!net || !addr || net->family != addr->family)
        return 0;
    if (prefix < 0)
        return 0;
    if (net->family == IP_V4) {
        if (prefix > 32)
            return 0;
    } else if (prefix > 128) {
        return 0;
    }
    full = prefix / 8;
    rest = prefix % 8;
    for (i = 0; i < full; i++)
        if (net->b[i] != addr->b[i])
            return 0;
    if (rest > 0) {
        u8 m = (u8)(0xff << (8 - rest));

        if ((net->b[full] & m) != (addr->b[full] & m))
            return 0;
    }
    return 1;
}

/* 把地址的前 prefix 位以外清零（网络地址形式） */
int cidr_mask(Ip *addr, int prefix)
{
    int full = 0;
    int rest = 0;
    int i = 0;
    int total = 0;

    if (!addr || prefix < 0)
        return 0;
    total = (addr->family == IP_V4) ? 32 : 128;
    if (prefix > total)
        return 0;
    full = prefix / 8;
    rest = prefix % 8;
    for (i = full + ((rest > 0) ? 1 : 0); i < 16; i++)
        addr->b[i] = 0;
    if (rest > 0)
        addr->b[full] = (u8)(addr->b[full] & (u8)(0xff << (8 - rest)));
    return 1;
}

/* ---- 分类 ---- */

/* v4-mapped 的 v6 折回 v4 再判 */
static int inet_as_v4(Ip *a, Ipv4 *out)
{
    if (a->family == IP_V4) {
        memcpy(out->b, a->b, 4);
        return 1;
    }
    {
        Ipv6 v6 = { { 0 } };

        memcpy(v6.b, a->b, 16);
        if (!inet_v6_is_v4_mapped(&v6))
            return 0;
        memcpy(out->b, v6.b + 12, 4);
        return 1;
    }
}

int is_loopback(Ip *a)
{
    Ipv4 v4 = { { 0, 0, 0, 0 } };

    if (!a)
        return 0;
    if (inet_as_v4(a, &v4))
        return v4.b[0] == 127;
    /* ::1 */
    {
        int i = 0;

        for (i = 0; i < 15; i++)
            if (a->b[i] != 0)
                return 0;
        return a->b[15] == 1;
    }
}

int is_private(Ip *a)
{
    Ipv4 v4 = { { 0, 0, 0, 0 } };

    if (!a)
        return 0;
    if (inet_as_v4(a, &v4)) {
        if (v4.b[0] == 10)
            return 1;                       /* 10/8 */
        if (v4.b[0] == 172 && (v4.b[1] & 0xf0) == 16)
            return 1;                       /* 172.16/12 */
        if (v4.b[0] == 192 && v4.b[1] == 168)
            return 1;                       /* 192.168/16 */
        if (v4.b[0] == 100 && (v4.b[1] & 0xc0) == 64)
            return 1;                       /* 100.64/10（CGNAT） */
        return 0;
    }
    /* fc00::/7（ULA） */
    return (a->b[0] & 0xfe) == 0xfc;
}

int is_link_local(Ip *a)
{
    Ipv4 v4 = { { 0, 0, 0, 0 } };

    if (!a)
        return 0;
    if (inet_as_v4(a, &v4))
        return v4.b[0] == 169 && v4.b[1] == 254;   /* 169.254/16 */
    return a->b[0] == 0xfe && (a->b[1] & 0xc0) == 0x80;   /* fe80::/10 */
}

int is_multicast(Ip *a)
{
    Ipv4 v4 = { { 0, 0, 0, 0 } };

    if (!a)
        return 0;
    if (inet_as_v4(a, &v4))
        return (v4.b[0] & 0xf0) == 0xe0;   /* 224/4 */
    return a->b[0] == 0xff;                /* ff00::/8 */
}

int is_unspecified(Ip *a)
{
    int i = 0;

    if (!a)
        return 0;
    for (i = 0; i < 16; i++)
        if (a->b[i] != 0)
            return 0;
    return 1;
}

/* ---- 端口 ---- */

int inet_parse_port(char[:] s, u16 *out)
{
    int v = 0;
    int i = 0;

    if (!out || s.len <= 0 || s.len > 5)
        return 0;
    for (i = 0; i < s.len; i++) {
        int c = (u8)s.data[i];

        if (c < '0' || c > '9')
            return 0;
        v = v * 10 + (c - '0');
        if (v > 65535)
            return 0;
    }
    if (s.len > 1 && s.data[0] == '0')
        return 0;
    *out = (u16)v;
    return 1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int ip_is(Ip *a, char *lit)
{
    Ip b = { 0 };
    char buf[64] = { 0 };

    if (!inet_parse((char[:]){ lit, (int)strlen(lit) }, &b))
        return 0;
    if (!a->eq(&b))
        return 0;
    return a->format(buf, sizeof buf) > 0;
}

test "IPv4 解析：边界与严格性" {
    Ip a = { 0 };
    Ipv4 v4 = { { 0, 0, 0, 0 } };
    char buf[32] = { 0 };

    if (!inet_parse_v4(S("0.0.0.0"), &v4) || v4.b[0] != 0 || v4.b[3] != 0)
        return err(1, "全零地址解析不对");
    if (!inet_parse_v4(S("255.255.255.255"), &v4) || v4.b[0] != 255
        || v4.b[3] != 255)
        return err(2, "全 255 解析不对");
    if (!inet_parse_v4(S("192.168.0.1"), &v4) || v4.b[0] != 192
        || v4.b[1] != 168 || v4.b[3] != 1)
        return err(3, "常见地址解析不对");
    if (v4.format( buf, sizeof buf) != 11
        || strcmp(buf, "192.168.0.1") != 0)
        return err(4, "格式化不对");
    if (!inet_parse(S("10.1.2.3"), &a) || a.family != IP_V4)
        return err(5, "自动识别没判成 v4");
    if (!ip_is(&a, "10.1.2.3"))
        return err(6, "往返不一致");
}

test "IPv4 拒绝坏输入且不写 out" {
    char *bad[12] = {
        (char *)"", (char *)"1.2.3", (char *)"1.2.3.4.5", (char *)"256.0.0.1",
        (char *)"1.2.3.256", (char *)"01.2.3.4", (char *)"1.2.3.04",
        (char *)"1.2.3.", (char *)".1.2.3", (char *)"1..2.3",
        (char *)" 1.2.3.4", (char *)"1.2.3.4 ",
    };
    Ipv4 keep = { { 0xab, 0xab, 0xab, 0xab } };
    int i = 0;

    for (i = 0; i < 12; i++) {
        Ipv4 t = keep;

        if (inet_parse_v4((char[:]){ bad[i], (int)strlen(bad[i]) }, &t))
            return err(7, "坏输入被当成合法 IPv4");
        if (t.b[0] != 0xab)
            return err(8, "解析失败却改了 out");
    }
}

test "IPv6 解析：压缩、内嵌 IPv4、边界" {
    Ipv6 a = { { 0 } };
    char buf[64] = { 0 };

    if (!inet_parse_v6(S("::"), &a))
        return err(9, "全零 :: 解析失败");
    if (a.format( buf, sizeof buf) != 2 || strcmp(buf, "::") != 0)
        return err(10, ":: 格式化不对");
    if (!inet_parse_v6(S("::1"), &a) || a.b[15] != 1)
        return err(11, "::1 解析不对");
    if (!inet_parse_v6(S("2001:db8::1"), &a) || a.b[0] != 0x20
        || a.b[1] != 0x01 || a.b[15] != 1)
        return err(12, "2001:db8::1 解析不对");
    if (!inet_parse_v6(S("1:2:3:4:5:6:7:8"), &a) || a.b[0] != 0
        || a.b[1] != 1 || a.b[15] != 8)
        return err(13, "八组完整地址解析不对");
    if (!inet_parse_v6(S("::ffff:192.168.0.1"), &a))
        return err(14, "IPv4-mapped 解析失败");
    if (a.b[10] != 0xff || a.b[11] != 0xff || a.b[12] != 192 || a.b[15] != 1)
        return err(15, "IPv4-mapped 的字节不对");
    if (a.format( buf, sizeof buf) != 18
        || strcmp(buf, "::ffff:192.168.0.1") != 0)
        return err(16, "IPv4-mapped 格式化不对");
    if (!inet_parse_v6(S("fe80::1"), &a) || a.b[0] != 0xfe || a.b[1] != 0x80)
        return err(17, "fe80::1 解析不对");
    if (!inet_parse_v6(S("1:2:3:4:5:6:1.2.3.4"), &a) || a.b[12] != 1
        || a.b[15] != 4)
        return err(18, "内嵌 IPv4 的 8 组形式解析不对");
}

test "IPv6 拒绝坏输入" {
    char *bad[12] = {
        (char *)"", (char *)":", (char *)":::", (char *)"1::2::3",
        (char *)"12345::", (char *)"1:2:3:4:5:6:7", (char *)"::1:2:3:4:5:6:7:8",
        (char *)"1:2:3:4:5:6:7:8:9", (char *)"1:2:3:4:5:6:7:",
        (char *)"::1.2.3.256", (char *)"::1.2.3.4.5", (char *)"g::1",
    };
    Ipv6 keep = { { 0 } };
    int i = 0;

    memset(keep.b, 0xcd, 16);
    for (i = 0; i < 12; i++) {
        Ipv6 t = keep;

        if (inet_parse_v6((char[:]){ bad[i], (int)strlen(bad[i]) }, &t))
            return err(19, "坏输入被当成合法 IPv6");
        if (t.b[0] != 0xcd)
            return err(20, "解析失败却改了 out");
    }
}

test "IPv6 格式化：RFC 5952 的压缩规则" {
    struct V { char *in; char *want; };
    V v[10] = {
        { (char *)"2001:0db8:0000:0000:0000:ff00:0042:8329",
          (char *)"2001:db8::ff00:42:8329" },
        { (char *)"2001:db8:0:0:1:0:0:1", (char *)"2001:db8::1:0:0:1" },
        { (char *)"1:0:0:2:0:0:3:4", (char *)"1::2:0:0:3:4" },
        { (char *)"2001:db8:0:1:1:1:1:1", (char *)"2001:db8:0:1:1:1:1:1" },
        { (char *)"1:2:3:4:5:6:7:8", (char *)"1:2:3:4:5:6:7:8" },
        { (char *)"::", (char *)"::" },
        { (char *)"::1", (char *)"::1" },
        { (char *)"fe80::", (char *)"fe80::" },
        { (char *)"0:0:1:0:0:0:0:0", (char *)"0:0:1::" },
        { (char *)"ABCD:EF01:2345:6789:ABCD:EF01:2345:6789",
          (char *)"abcd:ef01:2345:6789:abcd:ef01:2345:6789" },
    };
    int i = 0;

    for (i = 0; i < 10; i++) {
        Ipv6 a = { { 0 } };
        char buf[64] = { 0 };

        if (!inet_parse_v6((char[:]){ v[i].in, (int)strlen(v[i].in) }, &a))
            return err(21, "用例输入解析失败");
        if (a.format( buf, sizeof buf) != (int)strlen(v[i].want)
            || strcmp(buf, v[i].want) != 0) {
            printf("case %d: got '%s' want '%s'\n", i, buf, v[i].want);
            return err(22, "RFC 5952 压缩结果不符");
        }
    }
    /* 放不下不写 */
    {
        Ipv6 a = { { 0 } };
        char small[4] = { 'Z', 'Z', 'Z', 0 };

        inet_parse_v6(S("2001:db8::1"), &a);
        if (a.format( small, sizeof small) != -1 || small[0] != 'Z')
            return err(23, "放不下时应当 -1 且不写");
    }
}

test "CIDR：解析、包含、掩码" {
    Ip net = { 0 };
    Ip host = { 0 };
    int prefix = 0;
    char buf[64] = { 0 };

    if (!inet_parse_cidr(S("10.0.0.0/8"), &net, &prefix) || prefix != 8)
        return err(24, "10.0.0.0/8 解析不对");
    if (!inet_parse(S("10.1.2.3"), &host))
        return err(25, "主机解析失败");
    if (!net.cidr_contains( prefix, &host))
        return err(26, "10/8 应当包含 10.1.2.3");
    if (!inet_parse(S("11.1.2.3"), &host))
        return err(27, "主机解析失败");
    if (net.cidr_contains( prefix, &host))
        return err(28, "10/8 不该包含 11.1.2.3");
    /* 没有 '/' 时按主机前缀 */
    if (!inet_parse_cidr(S("192.168.0.1"), &net, &prefix) || prefix != 32)
        return err(29, "无前缀应当按 /32");
    if (!inet_parse_cidr(S("2001:db8::/32"), &net, &prefix) || prefix != 32
        || net.family != IP_V6)
        return err(30, "v6 的 CIDR 解析不对");
    if (!inet_parse_cidr(S("::1"), &net, &prefix) || prefix != 128)
        return err(31, "v6 无前缀应当按 /128");
    if (inet_parse_cidr(S("10.0.0.0/33"), &net, &prefix))
        return err(32, "/33 对 v4 应当非法");
    if (inet_parse_cidr(S("10.0.0.0/-1"), &net, &prefix))
        return err(33, "负前缀应当非法");
    if (inet_parse_cidr(S("10.0.0.0/08"), &net, &prefix))
        return err(34, "前缀前导零应当非法");
    if (inet_parse_cidr(S("10.0.0.0/"), &net, &prefix))
        return err(35, "空前缀应当非法");
    /* 掩码 */
    {
        Ipv4 m = { { 0, 0, 0, 0 } };
        Ip n = { 0 };

        if (!inet_v4_mask(24, &m) || m.b[0] != 255 || m.b[1] != 255
            || m.b[2] != 255 || m.b[3] != 0)
            return err(36, "/24 掩码不对");
        inet_parse(S("10.1.2.3"), &n);
        n.cidr_mask( 8);
        n.format( buf, sizeof buf);
        if (strcmp(buf, "10.0.0.0") != 0)
            return err(37, "按 /8 清位不对");
        inet_parse(S("10.1.2.3"), &n);
        n.cidr_mask( 0);
        n.format( buf, sizeof buf);
        if (strcmp(buf, "0.0.0.0") != 0)
            return err(38, "/0 应当清成全零");
    }
    /* 混合族不包含 */
    {
        Ip v4net = { 0 };
        Ip v6host = { 0 };
        int p = 0;

        inet_parse_cidr(S("0.0.0.0/0"), &v4net, &p);
        inet_parse(S("::1"), &v6host);
        if (v4net.cidr_contains( 0, &v6host))
            return err(39, "不同地址族不该被判为包含");
    }
}

test "分类：私网、回环、链路本地、组播" {
    Ip a = { 0 };

    struct C { char *addr; int priv; int loop; int link; int multi; };
    C cs[10] = {
        { (char *)"10.1.2.3", 1, 0, 0, 0 },
        { (char *)"172.16.0.1", 1, 0, 0, 0 },
        { (char *)"172.32.0.1", 0, 0, 0, 0 },
        { (char *)"192.168.1.1", 1, 0, 0, 0 },
        { (char *)"127.0.0.1", 0, 1, 0, 0 },
        { (char *)"169.254.1.1", 0, 0, 1, 0 },
        { (char *)"224.0.0.1", 0, 0, 0, 1 },
        { (char *)"8.8.8.8", 0, 0, 0, 0 },
        { (char *)"::1", 0, 1, 0, 0 },
        { (char *)"fe80::1", 0, 0, 1, 0 },
    };
    int i = 0;

    for (i = 0; i < 10; i++) {
        if (!inet_parse((char[:]){ cs[i].addr, (int)strlen(cs[i].addr) }, &a))
            return err(40, "分类用例解析失败");
        if (a.is_private() != cs[i].priv)
            return err(41, "is_private 判错");
        if (a.is_loopback() != cs[i].loop)
            return err(42, "is_loopback 判错");
        if (a.is_link_local() != cs[i].link)
            return err(43, "is_link_local 判错");
        if (a.is_multicast() != cs[i].multi)
            return err(44, "is_multicast 判错");
    }
    /* v6 的 ULA 与组播 */
    if (!inet_parse(S("fd00::1"), &a) || !a.is_private())
        return err(45, "fc00::/7 应当算私网");
    if (!inet_parse(S("ff02::1"), &a) || !a.is_multicast())
        return err(46, "ff00::/8 应当算组播");
    /* v4-mapped 折回 v4 判 */
    if (!inet_parse(S("::ffff:127.0.0.1"), &a) || !a.is_loopback())
        return err(47, "::ffff:127.0.0.1 应当算回环");
    if (!inet_parse(S("::ffff:10.0.0.1"), &a) || !a.is_private())
        return err(48, "::ffff:10.0.0.1 应当算私网");
    /* 未指定地址 */
    if (!inet_parse(S("0.0.0.0"), &a) || !a.is_unspecified())
        return err(49, "0.0.0.0 应当是 unspecified");
    if (!inet_parse(S("::"), &a) || !a.is_unspecified())
        return err(50, ":: 应当是 unspecified");
}

test "端口解析" {
    u16 p = 0;

    if (!inet_parse_port(S("0"), &p) || p != 0)
        return err(51, "端口 0 应当合法");
    if (!inet_parse_port(S("80"), &p) || p != 80)
        return err(52, "端口 80 不对");
    if (!inet_parse_port(S("65535"), &p) || p != 65535)
        return err(53, "端口 65535 应当合法");
    if (inet_parse_port(S("65536"), &p))
        return err(54, "65536 应当非法");
    if (inet_parse_port(S(""), &p) || inet_parse_port(S("-1"), &p)
        || inet_parse_port(S(" 80"), &p) || inet_parse_port(S("80 "), &p)
        || inet_parse_port(S("+80"), &p) || inet_parse_port(S("8o"), &p))
        return err(55, "坏端口字符串被接受");
    if (inet_parse_port(S("080"), &p))
        return err(56, "端口前导零应当非法");
}
