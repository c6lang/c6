/* 由 c6c 的 C99 后端生成（不要手改） */
#include <stdint.h>
#include <string.h>
#include <stdarg.h>
#include <unistd.h>

typedef union { float f; uint32_t u; } c6_u32;
typedef union { double d; uint64_t u; } c6_u64;
static float c6_f32(uint64_t v) { c6_u32 x; x.u = (uint32_t)v; return x.f; }
static double c6_f64(uint64_t v) { c6_u64 x; x.u = v; return x.d; }
static uint64_t c6_b32(float f) { c6_u32 x; x.f = f; return (uint64_t)x.u; }
static uint64_t c6_b64(double d) { c6_u64 x; x.d = d; return x.u; }
static uint64_t c6_ld1(const void *p) { return *(const uint8_t*)p; }
static uint64_t c6_ld2(const void *p) { uint16_t v; memcpy(&v,p,2); return v; }
static uint64_t c6_ld4(const void *p) { uint32_t v; memcpy(&v,p,4); return v; }
static uint64_t c6_ld8(const void *p) { uint64_t v; memcpy(&v,p,8); return v; }
static uint64_t c6_ld1s(const void *p) { return (uint64_t)(int8_t)*(const uint8_t*)p; }
static uint64_t c6_ld2s(const void *p) { uint16_t v; memcpy(&v,p,2); return (uint64_t)(int16_t)v; }
static uint64_t c6_ld4s(const void *p) { uint32_t v; memcpy(&v,p,4); return (uint64_t)(int32_t)v; }
static void c6_st1(void *p, uint64_t v) { *(uint8_t*)p = (uint8_t)v; }
static void c6_st2(void *p, uint64_t v) { uint16_t x = (uint16_t)v; memcpy(p,&x,2); }
static void c6_st4(void *p, uint64_t v) { uint32_t x = (uint32_t)v; memcpy(p,&x,4); }
static void c6_st8(void *p, uint64_t v) { memcpy(p,&v,8); }
static uint64_t c6_narrow(uint64_t v, unsigned bits, int sgn)
{
    uint64_t m = (bits >= 64) ? ~(uint64_t)0 : (((uint64_t)1 << bits) - 1);
    uint64_t r = v & m;

    if (sgn && bits < 64 && (r >> (bits - 1)) & 1)
        r |= ~m;
    return r;
}
/* 虚拟寄存器的家就是帧槽：native 后端就是这么落的，
   变量被提升成 vreg 之后又会按槽号取地址，两边必须是同一块内存。 */
#define R(i) (*(uint64_t*)(rbp - 16 * (long)(i) - 16))
static unsigned char D[8u << 20];
static unsigned char c6_alloca_buf[4u << 20];
static unsigned long c6_alloca_at;
static void *c6_alloca(uint64_t n)
{
    unsigned long a = (c6_alloca_at + 15ul) & ~15ul;

    if (a + n > sizeof c6_alloca_buf)
        return c6_alloca_buf;
    c6_alloca_at = a + n;
    return c6_alloca_buf + a;
}


