/* tests/interface.c6 的第二个翻译单元：同一个结构体、同一个接口。
 *
 * 每个 TU 自己声明接口、自己做转换，因此各自生成一份 static vtable，
 * 两个 TU 同时转换同一个 (类型, 接口) 对不会有符号冲突。
 */
interface Size {
    int area();
}

struct Sq { int s; };

int area(struct Sq *self) { return self->s * self->s; }

int area_via_vt(struct Sq *c)
{
    Size z = { 0 };
    z = *c;
    return z.area();
}
