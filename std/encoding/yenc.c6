/* std/encoding/yenc：yEnc 编解码（Usenet 的二进制转文本编码，8 位直传）。
 *
 *     import std.encoding.yenc;
 *
 *     char out[256] = { 0 };
 *     int n = yenc_encode(S("Hello, yEnc!"), out, (int)sizeof out);
 *     int m = yenc_decode((char[:]){ out, n }, back, (int)sizeof back);
 *
 * 规则：每个字节先 `+42`；如果结果落在 `0x00`、`0x0A`、`0x0D`、`0x3D` 里，就先写
 * `=` 再写 `(结果 + 64)`。所以原始数据里不会出现裸的 CR/LF，换行可以随便插。
 *
 * 头部/尾部是普通文本行：
 *
 *     =ybegin line=128 size=1234 name=foo.bin
 *     …
 *     =yend size=1234
 *
 * 约定：
 *
 * - `*_encoded_len` 给的是最坏情况（每字节都可能转义成 2 个字符）；
 * - `yenc_encode` 只编码数据、不插换行、不加 `=ybegin`；完整块用 `yenc_encode_full`
 *   （固定 `line=128`，按 128 字节折行）；
 * - `yenc_decode` 跳过所有 `\r`/`\n`，跳过 `=ybegin`/`=yend` 整行；`=` 后面字符
 *   减 64、其它字符减 42；遇到截断的 `=` 返回 -1；
 * - `yenc_field` 在 `=ybegin` 行里找 `key=`（`name`、`size`、`line`），值写到
 *   `dst`（带结尾 0），返回长度；找不到返回 -1；
 * - 不支持多段（`part=`）拼接与 `pcrc32` 校验。
 */
#include <stdio.h>
#include <string.h>

module std.encoding.yenc;
import std.core.types;
import std.text.str;

static int yenc_escape(int v)
{
    return v == 0x00 || v == 0x0A || v == 0x0D || v == 0x3D;
}

int yenc_encoded_len(int n)
{
    if (n <= 0)
        return 0;
    return n * 2;
}

int yenc_encode(char[:] src, char *dst, int cap)
{
    int i = 0, o = 0;

    if (src.len < 0 || !dst || cap < 0)
        return -1;
    for (i = 0; i < src.len; i++) {
        int v = ((int)(unsigned char)src.data[i] + 42) & 0xFF;

        if (yenc_escape(v)) {
            if (o + 2 > cap)
                return -1;
            dst[o++] = '=';
            dst[o++] = (char)((v + 64) & 0xFF);
        } else {
            if (o + 1 > cap)
                return -1;
            dst[o++] = (char)v;
        }
    }
    if (o < cap)
        dst[o] = 0;
    return o;
}

int yenc_encode_full(char[:] src, const char *name, char *dst, int cap)
{
    char head[128] = { 0 };
    int o = 0, i = 0, hlen = 0, col = 0;

    if (!dst || cap < 0)
        return -1;
    hlen = snprintf(head, sizeof head, "=ybegin line=128 size=%d name=%s\n",
                    src.len, name ? name : "data");
    if (hlen <= 0 || hlen >= (int)sizeof head)
        return -1;
    for (i = 0; i < hlen; i++) {
        if (o >= cap)
            return -1;
        dst[o++] = head[i];
    }
    for (i = 0; i < src.len; i++) {
        int v = ((int)(unsigned char)src.data[i] + 42) & 0xFF;

        if (yenc_escape(v)) {
            if (o + 2 > cap)
                return -1;
            dst[o++] = '=';
            dst[o++] = (char)((v + 64) & 0xFF);
        } else {
            if (o + 1 > cap)
                return -1;
            dst[o++] = (char)v;
        }
        col++;
        if (col == 128 && i + 1 < src.len) {
            if (o + 1 > cap)
                return -1;
            dst[o++] = '\n';
            col = 0;
        }
    }
    hlen = snprintf(head, sizeof head, "\n=yend size=%d\n", src.len);
    if (hlen <= 0 || hlen >= (int)sizeof head)
        return -1;
    for (i = 0; i < hlen; i++) {
        if (o >= cap)
            return -1;
        dst[o++] = head[i];
    }
    if (o < cap)
        dst[o] = 0;
    return o;
}

static int yenc_line_is(const char *s, int n, int pos, const char *kw)
{
    int klen = (int)strlen(kw);

    if (pos + klen > n)
        return 0;
    return memcmp(s + pos, kw, (size_t)klen) == 0;
}

int yenc_decode(char[:] src, char *dst, int cap)
{
    int i = 0, o = 0;

    if (!dst || cap < 0 || src.len < 0)
        return -1;
    while (i < src.len) {
        char c = src.data[i];

        if (c == '\r' || c == '\n') {
            i++;
            continue;
        }
        if (c == '=' && i + 1 < src.len
            && (yenc_line_is(src.data, src.len, i, "=ybegin")
                || yenc_line_is(src.data, src.len, i, "=yend"))) {
            while (i < src.len && src.data[i] != '\n')
                i++;
            continue;
        }
        if (c == '=') {
            if (i + 1 >= src.len)
                return -1;
            if (o >= cap)
                return -1;
            dst[o++] = (char)(((int)(unsigned char)src.data[i + 1] - 106)
                              & 0xFF);
            i += 2;
            continue;
        }
        if (o >= cap)
            return -1;
        dst[o++] = (char)(((int)(unsigned char)c - 42) & 0xFF);
        i++;
    }
    return o;
}

int yenc_field(char[:] src, const char *key, char *dst, int cap)
{
    int i = 0, klen = 0, o = 0;

    if (!dst || !key || cap <= 0 || src.len < 0)
        return -1;
    klen = (int)strlen(key);
    for (i = 0; i + klen + 1 <= src.len; i++) {
        if (i > 0 && src.data[i - 1] != ' ' && src.data[i - 1] != '\t')
            continue;
        if (memcmp(src.data + i, key, (size_t)klen) != 0)
            continue;
        if (src.data[i + klen] != '=')
            continue;
        {
            int j = i + klen + 1;

            while (j < src.len && src.data[j] != ' ' && src.data[j] != '\n'
                   && src.data[j] != '\r' && src.data[j] != '\t') {
                if (o + 1 < cap)
                    dst[o++] = src.data[j];
                j++;
            }
            dst[o] = 0;
            return o;
        }
    }
    return -1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "yEnc：编码" {
    char out[64] = { 0 };
    static const unsigned char want[12] = {
        0x72, 0x8F, 0x96, 0x96, 0x99, 0x56, 0x4A, 0xA3, 0x6F, 0x98, 0x8D, 0x4B
    };
    unsigned char esc[4] = { 0xD6, 0xE0, 0xE3, 0x13 };
    int n = 0;

    n = yenc_encode(S("Hello, yEnc!"), out, (int)sizeof out);
    if (n != 12)
        return err(1, "编码长度不对");
    if (memcmp(out, want, 12) != 0)
        return err(2, "编码内容不对");
    n = yenc_encode((char[:]){ (char *)esc, 4 }, out, (int)sizeof out);
    if (n != 8 || memcmp(out, "=@=J=M=}", 8) != 0)
        return err(3, "转义序列不对");
    n = yenc_encode(S(""), out, (int)sizeof out);
    if (n != 0)
        return err(4, "空输入应该 0");
    if (yenc_encode(S("Hello, yEnc!"), out, 5) != -1)
        return err(5, "容量不够应该 -1");
    if (yenc_encoded_len(10) != 20)
        return err(6, "上界不对");
}

test "yEnc：解码、头部字段与往返" {
    char out[256] = { 0 };
    char back[256] = { 0 };
    unsigned char esc[4] = { 0 };
    int n = 0, m = 0;
    static const char *full =
        "=ybegin line=128 size=5 name=a.bin\n"
        "r\x8f\x96\x96\x99\n"
        "=yend size=5\n";

    n = yenc_decode(S("r\x8f\x96\x96\x99VJ\xa3o\x98\x8dK"), out,
                    (int)sizeof out);
    if (n != 12 || memcmp(out, "Hello, yEnc!", 12) != 0)
        return err(7, "Hello, yEnc! 解码不对");
    n = yenc_decode(S("=@=J=M=}"), (char *)esc, 4);
    if (n != 4 || esc[0] != 0xD6 || esc[1] != 0xE0 || esc[2] != 0xE3
        || esc[3] != 0x13)
        return err(8, "转义解码不对");
    /* 完整块：头部/尾部整行跳过，数据里的换行也跳过 */
    n = yenc_decode((char[:]){ (char *)full, (int)strlen(full) }, out,
                    (int)sizeof out);
    if (n != 5 || memcmp(out, "Hello", 5) != 0)
        return err(9, "完整块解码不对");
    if (yenc_field((char[:]){ (char *)full, (int)strlen(full) }, "name", back,
                   (int)sizeof back) != 5
        || memcmp(back, "a.bin", 5) != 0)
        return err(10, "name 字段不对");
    if (yenc_field((char[:]){ (char *)full, (int)strlen(full) }, "size", back,
                   (int)sizeof back) != 1
        || back[0] != '5')
        return err(11, "size 字段不对");
    if (yenc_field((char[:]){ (char *)full, (int)strlen(full) }, "part", back,
                   (int)sizeof back) != -1)
        return err(12, "不存在的字段应该 -1");
    /* 往返 */
    {
        int i = 0;
        char raw[200] = { 0 };

        for (i = 0; i < 200; i++)
            raw[i] = (char)(i * 13 + 1);
        n = yenc_encode((char[:]){ raw, 200 }, out, (int)sizeof out);
        if (n <= 0)
            return err(13, "往返编码失败");
        m = yenc_decode((char[:]){ out, n }, back, 256);
        if (m != 200)
            return err(14, "往返长度不对");
        if (memcmp(back, raw, 200) != 0)
            return err(15, "往返内容不一致");
    }
    if (yenc_decode(S("abc="), out, (int)sizeof out) != -1)
        return err(16, "截断的转义应该 -1");
}
