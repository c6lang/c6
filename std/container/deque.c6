/* std/container/deque：环形缓冲双端队列 Deque@T。
 *
 *     import std.container.deque;
 *
 *     @Deque@int d = new Deque@int;
 *     d->push_back(1) catch e { return e.id; };   // 两端进
 *     d->push_front(0) catch e { return e.id; };
 *     int v = 0;
 *     d->pop_front(&v);                            // 0
 *     d->pop_back(&v);                             // 1
 *
 * 与 std.container.vec 的分工：要连续内存（排序、切片、按字节搬）用 Vect；要两端进出
 * 用 Deque。这里不包装 Vect——`push_front` 在数组上只能是 O(n)，把 Deque 做成
 * 「带环形下标的数组」才是它存在的理由。
 *
 * 设计要点：
 * - 元素放在托管数组 `@T data` 里，下标是逻辑下标 `(head + i) % cap`；
 * - 含托管字段，只能 `new` 出来用 `@Deque@T` 持有；方法写在泛型结构体内；
 * - `at(i)` 和 Vect 一样是**前置条件**（0 <= i < count()）；要检查就读
 *   `get(i, &out)`；
 * - `push_*`/`reserve` 会分配，返回 `int!error`（失败不改状态）；`pop_*`
 *   空容器返回 0、不写 *out；
 * - 迭代器 `DIter@T` 存的是**借用指针** `Deque@T *d`（和 std.container.vec 的 Iter@T
 *   同一套）：含托管字段的结构体不能按值返回，迭代器必须保持纯值。
 */
module std.container.deque;
import std.core.types;
import std.core.err;

struct Deque@T {
    @T data;
    int cap;
    int head;
    int n;

    int count() { return n; }

    int capacity() { return cap; }

    int is_empty() { return n == 0; }

    /* 逻辑下标访问：要求 0 <= i < count() */
    T at(int i) { return data[(head + i) % cap]; }

    int get(int i, T *out)
    {
        if (!data || i < 0 || i >= n)
            return 0;
        *out = data[(head + i) % cap];
        return 1;
    }

    void set(int i, T v)
    {
        if (data && i >= 0 && i < n)
            data[(head + i) % cap] = v;
    }

    int first(T *out)
    {
        if (n == 0)
            return 0;
        *out = data[head];
        return 1;
    }

    int last(T *out)
    {
        if (n == 0)
            return 0;
        *out = data[(head + n - 1) % cap];
        return 1;
    }

    /* 预留容量：cap 只增不减；扩容后按逻辑顺序摊平（head = 0） */
    int!error reserve(int want)
    {
        @T nd = data;
        int ncap = cap > 0 ? cap : 8;
        int i = 0;

        if (want <= cap)
            return 0;
        if (want > 0x10000000)
            return err(std.core.err.NOMEM, "deque: too large");
        while (ncap < want)
            ncap *= 2;
        nd = new T[ncap];
        if (!nd)
            return err(std.core.err.NOMEM, "deque: out of memory");
        for (i = 0; i < n; i++)
            nd[i] = data[(head + i) % cap];
        data = nd;
        cap = ncap;
        head = 0;
        return 0;
    }

    int!error push_back(T v)
    {
        try reserve(n + 1);
        data[(head + n) % cap] = v;
        n++;
        return 0;
    }

    int!error push_front(T v)
    {
        try reserve(n + 1);
        head = (head + cap - 1) % cap;
        data[head] = v;
        n++;
        return 0;
    }

    int pop_back(T *out)
    {
        if (n == 0)
            return 0;
        *out = data[(head + n - 1) % cap];
        n--;
        return 1;
    }

    int pop_front(T *out)
    {
        if (n == 0)
            return 0;
        *out = data[head];
        head = (head + 1) % cap;
        n--;
        return 1;
    }

    void clear()
    {
        head = 0;
        n = 0;
    }

    DIter@T iter()
    {
        DIter@T it = { self, 0 };
        return it;
    }
};

struct DIter@T {
    Deque@T *d;    /* 借用，不计数：迭代器必须是纯值 */
    int i;

    int has() { return i < d->n; }

    T next()
    {
        T x = d->data[(d->head + i) % d->cap];

        i++;
        return x;
    }
};

/* ---- 自测 ---- */

test "空队列的 pop / first / last" {
    @Deque@int d = new Deque@int;
    int v = 0;

    if (d->count() != 0 || d->capacity() != 0 || !d->is_empty())
        return err(1, "空队列的计数不对");
    if (d->pop_front(&v) != 0 || d->pop_back(&v) != 0)
        return err(2, "空队列 pop 应返回 0");
    if (d->first(&v) != 0 || d->last(&v) != 0)
        return err(3, "空队列 first/last 应返回 0");
    if (d->get(0, &v) != 0)
        return err(4, "空队列 get 应返回 0");
    d->set(0, 7);   /* 越界：不动、不崩 */
    if (d->count() != 0)
        return err(5, "空队列被 set 改了");
}

test "FIFO：push_back / pop_front" {
    @Deque@int d = new Deque@int;
    int v = 0;

    d->push_back(1) catch e { return err(6, "push_back 失败"); };
    d->push_back(2) catch e { return err(7, "push_back 失败"); };
    d->push_back(3) catch e { return err(8, "push_back 失败"); };
    if (d->count() != 3)
        return err(9, "count 不是 3");
    if (d->pop_front(&v) != 1 || v != 1)
        return err(10, "第一个出队元素不对");
    if (d->pop_front(&v) != 1 || v != 2)
        return err(11, "第二个出队元素不对");
    if (d->pop_front(&v) != 1 || v != 3)
        return err(12, "第三个出队元素不对");
    if (d->pop_front(&v) != 0)
        return err(13, "空了还能出队");
}

test "LIFO：push_back / pop_back" {
    @Deque@int d = new Deque@int;
    int v = 0;

    d->push_back(10) catch e { return err(14, "push_back 失败"); };
    d->push_back(20) catch e { return err(15, "push_back 失败"); };
    if (d->pop_back(&v) != 1 || v != 20)
        return err(16, "pop_back 顺序不对");
    if (d->pop_back(&v) != 1 || v != 10)
        return err(17, "pop_back 顺序不对");
}

test "两端混用的顺序" {
    @Deque@int d = new Deque@int;
    int v = 0;

    d->push_back(2) catch e { return err(18, "push_back 失败"); };
    d->push_front(1) catch e { return err(19, "push_front 失败"); };
    d->push_back(3) catch e { return err(20, "push_back 失败"); };
    d->push_front(0) catch e { return err(21, "push_front 失败"); };
    if (d->count() != 4 || d->at(0) != 0 || d->at(1) != 1
        || d->at(2) != 2 || d->at(3) != 3)
        return err(22, "两端混用之后顺序不对");
    if (d->first(&v) != 1 || v != 0)
        return err(23, "first 不对");
    if (d->last(&v) != 1 || v != 3)
        return err(24, "last 不对");
    if (d->pop_back(&v) != 1 || v != 3)
        return err(25, "pop_back 不对");
    if (d->pop_front(&v) != 1 || v != 0)
        return err(26, "pop_front 不对");
}

test "绕圈（head != 0）之后 at / get 仍然正确" {
    @Deque@int d = new Deque@int;
    int i = 0, v = 0;

    for (i = 0; i < 8; i++)
        d->push_back(i) catch e { return err(27, "push_back 失败"); };
    for (i = 0; i < 4; i++) {
        if (d->pop_front(&v) != 1 || v != i)
            return err(28, "绕圈前的出队不对");
    }
    if (d->capacity() != 8)
        return err(29, "这个用例需要 cap == 8");
    for (i = 8; i < 12; i++)
        d->push_back(i) catch e { return err(30, "第二段 push_back 失败"); };
    for (i = 0; i < 8; i++) {
        if (d->at(i) != i + 4)
            return err(31, "绕圈之后 at 不对");
        if (d->get(i, &v) != 1 || v != i + 4)
            return err(32, "绕圈之后 get 不对");
    }
    d->set(0, 40);
    if (d->at(0) != 40)
        return err(33, "set 没生效");
}

test "扩容保序（head 重新归零）" {
    @Deque@int d = new Deque@int;
    int i = 0, v = 0;

    d->push_back(0) catch e { return err(34, "push 失败"); };
    d->pop_front(&v);                       /* head 前进一格 */
    for (i = 1; i < 20; i++)
        d->push_back(i) catch e { return err(35, "push 失败"); };
    if (d->capacity() < 20)
        return err(36, "没有扩容");
    if (d->count() != 19)
        return err(37, "扩容之后计数不对");
    for (i = 0; i < 19; i++)
        if (d->at(i) != i + 1)
            return err(38, "扩容之后顺序不对");
}

test "clear 保留容量，之后可重用" {
    @Deque@int d = new Deque@int;
    int cap0 = 0, v = 0;

    d->push_back(1) catch e { return err(38, "push 失败"); };
    d->push_back(2) catch e { return err(39, "push 失败"); };
    cap0 = d->capacity();
    d->clear();
    if (d->count() != 0 || d->capacity() != cap0)
        return err(40, "clear 丢了容量");
    if (d->pop_front(&v) != 0)
        return err(41, "clear 之后还能出队");
    d->push_front(9) catch e { return err(42, "重用失败"); };
    if (d->at(0) != 9)
        return err(43, "重用之后内容不对");
}

test "迭代器（含 head != 0 的情况）" {
    @Deque@int d = new Deque@int;
    int i = 0, sum = 0, n = 0;

    for (i = 0; i < 4; i++)
        d->push_back(i) catch e { return err(44, "push 失败"); };
    d->pop_front(&sum);
    d->push_back(4) catch e { return err(45, "push 失败"); };
    sum = 0;
    foreach (int x = d->iter()) {
        sum += x;
        n++;
    }
    if (n != 4 || sum != 1 + 2 + 3 + 4)
        return err(46, "迭代结果不对");
}

test "get / set 越界不动内容" {
    @Deque@int d = new Deque@int;
    int v = 0;

    d->push_back(5) catch e { return err(47, "push 失败"); };
    d->push_back(6) catch e { return err(48, "push 失败"); };
    if (d->get(-1, &v) != 0 || d->get(2, &v) != 0)
        return err(49, "越界 get 应返回 0");
    d->set(-1, 99);
    d->set(2, 99);
    if (d->at(0) != 5 || d->at(1) != 6)
        return err(50, "越界 set 改动了内容");
    if (d->get(1, &v) != 1 || v != 6)
        return err(51, "get 命中不对");
}
