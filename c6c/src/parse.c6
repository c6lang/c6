         *
         * 内核 include/linux/ucopysize.h:47 的 check_copy_size() 用它做
         * FORTIFY 边界检查。c6c 没有对象大小分析，一律返回 -1（"未知"）：
         * gcc 文档规定 type 的 bit1 为 0 时要返回 (size_t)-1 表示无法确定，
         * 于是 `sz >= 0` 恒假、FORTIFY 检查被跳过——和 -O0 下没有优化信息
         * 时 gcc 的行为一致，不会误报也绝不会漏检成错的。 */
        u32 d0 = 0;

        pa_advance();
        pa_expect_ch('(');
        {
            u32 save0 = FN.n;

            (void)gen_assign();
            FN.n = save0;
            PEND_LVAL = 0;
        }
        while (pa_accept_ch(',')) {
            u32 save1 = FN.n;

            (void)gen_assign();
            FN.n = save1;
            PEND_LVAL = 0;
        }
        pa_expect_ch(')');
        /* IR_CONST 的立即数只有 32 位，编不出 (size_t)-1，用 0-1 算出来。 */
        {
            u32 z0 = irfn_vreg(&FN);
            u32 o0 = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, z0, 0, 0, 0, 0);
            irfn_push(&FN, IR_CONST, IRT_U64, o0, 0, 0, 0, 1);
            d0 = irfn_vreg(&FN);
            irfn_push(&FN, IR_SUB, IRT_U64, d0, z0, o0, 0, 0);
        }
        GEN_TY = ty_ulong();
        return gen_postfix_ops(d0);
    }
    if (TOK_EQ(t, "__builtin_unreachable")) {
        /* `__builtin_unreachable()`：告诉编译器"走不到这儿"。语义上不是陷阱
         * （编译器可以据此做优化），但**真执行到**就是未定义行为——所以照
         * __builtin_trap 一样发 `ud2` 而不是静默什么都不做：内核
         * arch/x86/include/asm/bug.h 的 BUG()/unreachable() 正是靠它收尾，
         * 发空指令会让后面那条路径掉进下一段代码里静默跑下去。
         * 返回 void，不能当值用。 */
        pa_advance();
        pa_expect_ch('(');
        pa_expect_ch(')');
        {
            /* 直接发 ud2：之前这里用 IR_CALL imm=1 想做 tgkill 系统调用，
             * 但 IR_CALL 的 imm 是**符号 id**，1 号符号恰好是内核构建里的
             * __c6_tls_len（.data 里的零长对象），于是 BUG()/unreachable()
             * 全部变成 `call __c6_tls_len` —— 跳进 .data 的零字节里崩溃。
             * 陷阱语义用 IR_TRAP 表达，后端翻成 ud2。 */
            irfn_push(&FN, IR_TRAP, IRT_VOID, 0, 0, 0, 0, 0);
