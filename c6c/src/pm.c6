/* pm.c6 —— c6c 的工程管理子命令（P0/P1：清单 + 扫描 + build/test/run）
 *
 * 由 c6c.c6 在 main.c6 之前 #include：所有符号用 pm_ 前缀，保持单 TU 的
 * C6-BOOT 子集（宿主 cc -x c 与 c6c 自举都能编）。
 *
 * 清单是 c6c.yaml 的一个**受控子集**：
 *
 *   name: hello
 *   version: 0.1.0
 *   kind: app              # app / lib / firmware
 *   out: build/hello
 *   sources:
 *     - src/main.c6
 *   include:
 *     - .
 *   flags:
 *     - -b
 *
 * 这里不引 std/data/yaml.c6：那是有 import 的模块，单 TU 引导链里用不了。
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <dirent.h>
#include <sys/stat.h>

#define PM_NOT_SUB (-1234)
#define PM_MAX_SRCS 160
#define PM_MAX_IMPS 160
#define PM_MAX_INCS 32
#define PM_MAX_FLAGS 32
#define PM_MAX_ARGS 256
#define PM_PATH 512
#define PM_FILE_CAP (1024 * 1024)

typedef struct {
    char name[128];
    char version[64];
    char kind[32];              /* app / lib / firmware */
    char out[PM_PATH];
    char src[PM_MAX_SRCS][PM_PATH];
    int nsrc;
    char imp[PM_MAX_IMPS][128];
    int nimp;
    char inc[PM_MAX_INCS][PM_PATH];
    int ninc;
    char flag[PM_MAX_FLAGS][128];
    int nflag;
    int has_main;
    int has_start;
    int has_test;
} PmProject;

/* stage0（宿主 cc）没有 sys/wait.h 时不引整个头（c6c 自举的 #include 嵌套
 * 有 64 层上限，sys/wait.h → signal.h → ucontext.h 会踩到）；只补这几个宏。 */
#ifndef WIFEXITED
#define WIFEXITED(s) (((s) & 0x7f) == 0)
#define WEXITSTATUS(s) (((s) >> 8) & 0xff)
#define WIFSIGNALED(s) ((((s) & 0x7f) + 1) >> 1 > 0)
#define WTERMSIG(s) ((s) & 0x7f)
#endif
int waitpid(int pid, int *status, int options);

static void pm_zero_project(PmProject *p)
{
    memset(p, 0, sizeof(*p));
    strcpy(p->version, "0.1.0");
    strcpy(p->kind, "app");
    strcpy(p->out, "");
}

static const char *pm_rel(const char *path)
{
    if (path[0] == '.' && path[1] == '/')
        return path + 2;
    return path;
}

static void pm_trim(char *s)
{
    char *end = 0;
    char *p = s;
    while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')
        p++;
    if (p != s)
        memmove(s, p, strlen(p) + 1);
    end = s + strlen(s);
    while (end > s && (end[-1] == ' ' || end[-1] == '\t'
                       || end[-1] == '\r' || end[-1] == '\n'))
        *--end = 0;
    /* 行尾注释（清单里不写带 # 的值，这里只做最基本剥离） */
    p = s;
    while (*p) {
        if (*p == '#' && (p == s || p[-1] == ' ' || p[-1] == '\t')) {
            *p = 0;
            break;
        }
        p++;
    }
    end = s + strlen(s);
    while (end > s && (end[-1] == ' ' || end[-1] == '\t'))
        *--end = 0;
}

static int pm_read_file(const char *path, char *buf, size_t cap)
{
    FILE *fp = fopen(path, "rb");
    size_t n = 0;
    int c = 0;
    if (!fp)
        return -1;
    while (n + 1 < cap) {
        c = fgetc(fp);
        if (c == EOF)
            break;
        buf[n++] = (char)c;
    }
    fclose(fp);
    buf[n] = 0;
    return (int)n;
}

static int pm_ends(const char *s, const char *suf)
{
    size_t a = strlen(s), b = strlen(suf);
    if (b > a)
        return 0;
    return strcmp(s + a - b, suf) == 0;
}

static void pm_add_src(PmProject *p, const char *path)
{
    char buf[PM_FILE_CAP] = {0};
    int i = 0;
    if (p->nsrc >= PM_MAX_SRCS)
        return;
    for (i = 0; i < p->nsrc; i++) {
        if (strcmp(p->src[i], path) == 0)
            return;
    }
    strcpy(p->src[p->nsrc++], path);
    if (pm_read_file(path, buf, sizeof(buf)) < 0)
        return;
    if (strstr(buf, "int main(") || strstr(buf, "int main ("))
        p->has_main = 1;
    if (strstr(buf, "_start(") || strstr(buf, "_start ("))
        p->has_start = 1;
    if (strstr(buf, "test \""))
        p->has_test = 1;
    /* import NAME; → NAME，转换成 a.b 的点分形式 */
    {
        char *q = buf;
        while ((q = strstr(q, "import ")) != 0) {
            char *b = q + 7, *e = b;
            while (*e && *e != ';' && *e != ' ' && *e != '\t' && *e != '\n')
                e++;
            if (e > b && p->nimp < PM_MAX_IMPS) {
                int j = 0, dup = 0;
                size_t len = (size_t)(e - b);
                if (len >= sizeof(p->imp[0]))
                    len = sizeof(p->imp[0]) - 1;
                for (j = 0; j < p->nimp; j++) {
                    if (strlen(p->imp[j]) == len
                        && strncmp(p->imp[j], b, len) == 0) {
                        dup = 1;
                        break;
                    }
                }
                if (!dup) {
                    memcpy(p->imp[p->nimp], b, len);
                    p->imp[p->nimp][len] = 0;
                    p->nimp++;
                }
            }
            q = e;
            if (!*q)
                break;
        }
    }
}

static int pm_skip_dir(const char *name)
{
    if (name[0] == '.')
        return 1;
    if (strcmp(name, "build") == 0 || strcmp(name, "out") == 0
        || strcmp(name, "dist") == 0 || strcmp(name, "target") == 0
        || strcmp(name, "node_modules") == 0)
        return 1;
    return 0;
}

static void pm_scan_dir(PmProject *p, const char *dir, int depth)
{
    DIR *d = opendir(dir);
    struct dirent *e = (struct dirent *)0;
    if (!d || depth > 6)
        return;
    while ((e = readdir(d)) != (struct dirent *)0) {
        char path[PM_PATH] = {0};
        struct stat st = {0};
        if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0)
            continue;
        if (pm_skip_dir(e->d_name))
            continue;
        snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
        if (stat(path, &st) != 0)
            continue;
        if (S_ISDIR(st.st_mode)) {
            pm_scan_dir(p, path, depth + 1);
        } else if (S_ISREG(st.st_mode)) {
            if (pm_ends(e->d_name, ".c6") || pm_ends(e->d_name, ".c"))
                pm_add_src(p, path);
        }
    }
    closedir(d);
}

static void pm_scan(PmProject *p)
{
    char cwd[PM_PATH] = {0};
    char ver[PM_PATH] = {0};
    char *slash = (char *)0;
    pm_zero_project(p);
    if (getcwd(cwd, sizeof(cwd)))
        strcpy(p->name, cwd);
    slash = strrchr(p->name, '/');
    if (slash)
        memmove(p->name, slash + 1, strlen(slash + 1) + 1);
    pm_scan_dir(p, ".", 0);
    if (pm_read_file("VERSION", ver, sizeof(ver)) > 0) {
        char t[64] = {0};
        size_t n = strlen(ver);
        if (n > 0 && ver[n - 1] == '\n')
            ver[n - 1] = 0;
        if (strlen(ver) < sizeof(t)) {
            strcpy(t, ver);
            pm_trim(t);
            if (t[0])
                strcpy(p->version, t);
        }
    }
    if (p->has_start && !p->has_main)
        strcpy(p->kind, "firmware");
    else if (p->has_test && !p->has_main)
        strcpy(p->kind, "lib");
    else
        strcpy(p->kind, "app");
    if (p->has_start && !p->has_main) {
        strcpy(p->flag[0], "-nostdlib");
        p->nflag = 1;
    }
    snprintf(p->out, sizeof(p->out), "build/%s", p->name);
}

static void pm_check_imports(const PmProject *p)
{
    int i = 0, j = 0, found = 0;
    for (i = 0; i < p->nimp; i++) {
        char want[PM_PATH] = {0};
        size_t k = 0;
        for (k = 0; k < strlen(p->imp[i]); k++)
            want[k] = p->imp[i][k] == '.' ? '/' : p->imp[i][k];
        found = 0;
        for (j = 0; j < p->nsrc; j++) {
            char rel[PM_PATH] = {0};
            const char *s = pm_rel(p->src[j]);
            snprintf(rel, sizeof(rel), "%s.c6", want);
            if (strcmp(s, rel) == 0 || pm_ends(s, rel)) {
                found = 1;
                break;
            }
            snprintf(rel, sizeof(rel), "%s.c", want);
            if (strcmp(s, rel) == 0 || pm_ends(s, rel)) {
                found = 1;
                break;
            }
        }
        if (!found)
            fprintf(stderr, "c6c: init: import %s 没有在仓库里找到对应源文件（请用 -I 或补源文件）\n",
                    p->imp[i]);
    }
}

static void pm_print_scan(const PmProject *p)
{
    int i = 0;
    printf("c6c: 扫描结果：name=%s version=%s kind=%s out=%s\n",
           p->name, p->version, p->kind, p->out);
    printf("c6c: 源文件 %d 个：\n", p->nsrc);
    for (i = 0; i < p->nsrc && i < 30; i++)
        printf("  - %s\n", pm_rel(p->src[i]));
    if (p->nsrc > 30)
        printf("  ... 另有 %d 个\n", p->nsrc - 30);
    printf("c6c: import %d 个，main=%d _start=%d test块=%d\n",
           p->nimp, p->has_main, p->has_start, p->has_test);
}

static int pm_write_yaml(const PmProject *p, const char *path)
{
    FILE *fp = fopen(path, "wb");
    int i = 0;
    if (!fp) {
        fprintf(stderr, "c6c: init: 写不出 %s\n", path);
        return 1;
    }
    fprintf(fp, "# 由 `c6c init` 生成；只支持本工具用的 YAML 子集\n");
    fprintf(fp, "name: %s\nversion: %s\nkind: %s\nout: %s\n",
            p->name, p->version, p->kind, p->out);
    fprintf(fp, "sources:\n");
    for (i = 0; i < p->nsrc; i++)
        fprintf(fp, "  - %s\n", pm_rel(p->src[i]));
    fprintf(fp, "include:\n  - .\n");
    fprintf(fp, "flags:\n");
    for (i = 0; i < p->nflag; i++)
        fprintf(fp, "  - %s\n", p->flag[i]);
    fclose(fp);
    printf("c6c: init: 已写入 %s\n", path);
    return 0;
}

/* 自己切行：c6c 不认识 strtok，自举时不能用它。 */
static char *pm_next_line(char **cursor)
{
    char *s = *cursor;
    char *p = s;
    if (!s || !*s)
        return (char *)0;
    while (*p && *p != '\n')
        p++;
    if (*p == '\n') {
        *p = 0;
        *cursor = p + 1;
    } else {
        *cursor = p;
    }
    return s;
}

/* 只解析上面这个子集：顶层 key: value，缩进列表项 `- value`。 */
static int pm_load_yaml(const char *path, PmProject *p)
{
    char buf[PM_FILE_CAP] = {0};
    char *line = (char *)0;
    char *q = buf;
    int section = 0;            /* 0=顶层 1=sources 2=include 3=flags */
    if (pm_read_file(path, buf, sizeof(buf)) < 0)
        return -1;
    pm_zero_project(p);
    line = pm_next_line(&q);
    while (line) {
        char t[PM_PATH] = {0};
        size_t n = strlen(line);
        if (n >= sizeof(t))
            n = sizeof(t) - 1;
        memcpy(t, line, n);
        t[n] = 0;
        pm_trim(t);
        if (t[0] == '-' && t[1] == ' ') {
            char val[PM_PATH] = {0};
            strcpy(val, t + 2);
            pm_trim(val);
            if (section == 1 && p->nsrc < PM_MAX_SRCS)
                strcpy(p->src[p->nsrc++], val);
            else if (section == 2 && p->ninc < PM_MAX_INCS)
                strcpy(p->inc[p->ninc++], val);
            else if (section == 3 && p->nflag < PM_MAX_FLAGS)
                strcpy(p->flag[p->nflag++], val);
        } else if (strncmp(t, "name:", 5) == 0) {
            strcpy(p->name, t + 5); pm_trim(p->name); section = 0;
        } else if (strncmp(t, "version:", 8) == 0) {
            strcpy(p->version, t + 8); pm_trim(p->version); section = 0;
        } else if (strncmp(t, "kind:", 5) == 0) {
            strcpy(p->kind, t + 5); pm_trim(p->kind); section = 0;
        } else if (strncmp(t, "out:", 4) == 0) {
            strcpy(p->out, t + 4); pm_trim(p->out); section = 0;
        } else if (strcmp(t, "sources:") == 0) {
            section = 1;
        } else if (strcmp(t, "include:") == 0) {
            section = 2;
        } else if (strcmp(t, "flags:") == 0) {
            section = 3;
        }
        line = pm_next_line(&q);
    }
    return 0;
}

static void pm_mkdir_p(const char *path)
{
    char cur[PM_PATH] = {0};
    char *p = (char *)path;
    if (*p == '/')
        strcpy(cur, "/");
    while (*p) {
        if (*p == '/' && cur[0] && cur[strlen(cur) - 1] != '/')
            strcat(cur, "/");
        else if (*p != '/')
            strncat(cur, p, 1);
        if (*p == '/' && strlen(cur) > 1)
            mkdir(cur, 0755);
        p++;
    }
    if (cur[0])
        mkdir(cur, 0755);
}

static const char *pm_self(const char *argv0)
{
    static char buf[PM_PATH] = {0};
    ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
    if (n > 0) {
        buf[n] = 0;
        return buf;
    }
    if (argv0 && argv0[0])
        return argv0;
    return "c6c";
}

static int pm_status(int st)
{
    if (WIFEXITED(st))
        return WEXITSTATUS(st);
    if (WIFSIGNALED(st))
        return 128 + WTERMSIG(st);
    return 1;
}

/* 起一个进程并等它：返回子进程退出码；fork/exec 失败返回 2。 */
static int pm_spawn(char **av)
{
    int pid = fork();
    int st = 0;
    if (pid == 0) {
        execvp(av[0], av);
        _exit(127);
    }
    if (pid < 0 || waitpid(pid, &st, 0) < 0) {
        fprintf(stderr, "c6c: 无法执行 %s\n", av[0]);
        return 2;
    }
    return pm_status(st);
}

static int pm_load(PmProject *p)
{
    struct stat st = {0};
    if (stat("c6c.yaml", &st) == 0) {
        if (pm_load_yaml("c6c.yaml", p) == 0)
            return 0;
        fprintf(stderr, "c6c: c6c.yaml 解析失败\n");
        return 1;
    }
    fprintf(stderr, "c6c: 当前目录没有 c6c.yaml，先用 `c6c init` 生成；本次按扫描结果构建\n");
    pm_scan(p);
    return 0;
}

static int pm_build(PmProject *p, const char *self)
{
    char *av[PM_MAX_ARGS] = {(char *)0};
    int n = 0, i = 0;
    char parent[PM_PATH] = {0};
    char *slash = (char *)0;
    if (p->nsrc == 0) {
        fprintf(stderr, "c6c: build: 没有源文件\n");
        return 2;
    }
    strcpy(parent, p->out[0] ? p->out : "build/a.out");
    slash = strrchr(parent, '/');
    if (slash) {
        *slash = 0;
        if (parent[0])
            pm_mkdir_p(parent);
    }
    av[n++] = (char *)self;
    av[n++] = (char *)"-o";
    av[n++] = p->out[0] ? p->out : "build/a.out";
    for (i = 0; i < p->ninc && n + 2 < PM_MAX_ARGS; i++) {
        av[n++] = (char *)"-I";
        av[n++] = p->inc[i];
    }
    for (i = 0; i < p->nflag && n + 1 < PM_MAX_ARGS; i++)
        av[n++] = p->flag[i];
    for (i = 0; i < p->nsrc && n + 1 < PM_MAX_ARGS; i++)
        av[n++] = p->src[i];
    av[n] = (char *)0;
    return pm_spawn(av);
}

static int pm_test(PmProject *p, const char *self)
{
    char *av[PM_MAX_ARGS] = {(char *)0};
    int n = 0, i = 0;
    if (!p->has_test && p->nsrc > 0) {
        /* 清单里 test 块可能来自没被 pm_add_src 读到的源文件，重新读一遍 */
        char buf[PM_FILE_CAP] = {0};
        for (i = 0; i < p->nsrc; i++) {
            if (pm_read_file(p->src[i], buf, sizeof(buf)) >= 0
                && strstr(buf, "test \"")) {
                p->has_test = 1;
                break;
            }
        }
    }
    if (!p->has_test) {
        printf("c6c: test: 没有找到 test 块\n");
        return 0;
    }
    av[n++] = (char *)self;
    av[n++] = (char *)"-test";
    for (i = 0; i < p->ninc && n + 2 < PM_MAX_ARGS; i++) {
        av[n++] = (char *)"-I";
        av[n++] = p->inc[i];
    }
    for (i = 0; i < p->nsrc && n + 1 < PM_MAX_ARGS; i++)
        av[n++] = p->src[i];
    av[n] = (char *)0;
    return pm_spawn(av);
}

static void pm_help(void)
{
    printf("用法：c6c <子命令> [参数]\n"
           "\n"
           "  init [--force]  扫描当前仓库，生成 c6c.yaml\n"
           "  scan            只打印扫描结果，不写文件\n"
           "  build           按 c6c.yaml 编译到 out（默认 build/<name>）\n"
           "  test            编译并运行全部 `test \"…\" { }` 块\n"
           "  run [参数...]   先 build，再用参数运行产物\n"
           "  help            打印本帮助\n"
           "\n"
           "清单格式：name/version/kind/out + sources/include/flags 三个列表。\n"
           "kind 由 init 按 main() / _start / test 块推断：app / firmware / lib。\n"
           "固件默认带 -nostdlib；ELF/BIN/HEX 与烧录在后续版本接入。\n");
}

int pm_dispatch(int argc, char **argv)
{
    PmProject p = {0};
    const char *cmd = (argc >= 2) ? argv[1] : "";
    const char *self = pm_self(argv[0]);
    int rc = 0;

    if (strcmp(cmd, "help") == 0) {
        pm_help();
        return 0;
    }
    if (strcmp(cmd, "scan") == 0) {
        pm_scan(&p);
        pm_check_imports(&p);
        pm_print_scan(&p);
        return 0;
    }
    if (strcmp(cmd, "init") == 0) {
        struct stat st = {0};
        int force = 0;
        int i = 0;
        for (i = 2; i < argc; i++) {
            if (strcmp(argv[i], "--force") == 0)
                force = 1;
        }
        if (!force && stat("c6c.yaml", &st) == 0) {
            fprintf(stderr, "c6c: init: c6c.yaml 已存在（--force 覆盖）\n");
            return 2;
        }
        pm_scan(&p);
        pm_check_imports(&p);
        pm_print_scan(&p);
        return pm_write_yaml(&p, "c6c.yaml");
    }
    if (strcmp(cmd, "build") == 0) {
        if (pm_load(&p) != 0)
            return 2;
        return pm_build(&p, self);
    }
    if (strcmp(cmd, "test") == 0) {
        if (pm_load(&p) != 0)
            return 2;
        return pm_test(&p, self);
    }
    if (strcmp(cmd, "run") == 0) {
        char *av[PM_MAX_ARGS] = {(char *)0};
        int i = 0;
        if (pm_load(&p) != 0)
            return 2;
        rc = pm_build(&p, self);
        if (rc != 0)
            return rc;
        av[0] = p.out[0] ? p.out : "build/a.out";
        for (i = 2; i < argc && i - 2 + 1 < PM_MAX_ARGS - 1; i++)
            av[i - 1] = argv[i];
        return pm_spawn(av);
    }
    return PM_NOT_SUB;
}
