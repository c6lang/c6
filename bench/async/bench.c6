/* 异步编程基准：c6 的 async/await（语言级无栈协程 + epoll 事件循环）
 *
 * 三项指标，和 bench_c.c / bench_cpp.cpp / bench_go.go / bench_rs.rs 逐项对齐：
 *
 *   create  建 200000 个任务（create + join），报每个任务多少纳秒
 *   switch  同一线程上「挂起 → 内核就绪 → 恢复」跑 50000 轮，报每轮多少纳秒
 *   conns   1000 路并发连接（每路一对管道、一个挂起的读者），事件循环一次
 *           把 1000 路全部服务完，报每路多少微秒；同时报每个挂起任务的
 *           RSS 增量（字节）
 *
 * 运行：
 *   make bench-async          # 五语言一起跑并打表
 *   ./tcc/c6 -B tcc -I . -o build/bench_c6 bench/async/bench.c6 std/os/time.c6
 */
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <sys/resource.h>

/* 只用到这三个 libc 函数（不给 libtcc1 添依赖；fopen/fgets 由 <stdio.h> 声明） */
int pipe(int *fds);
int read(int fd, void *buf, int len);
int write(int fd, const void *buf, int len);

import std.os.time;

#define CREATE_N 200000
#define SWITCH_N 50000
#define CONN_N 1000

static int g_fds[2] = { 0, 0 };

/* 1000 路连接 = 2000 个 fd，先把软限制抬到 4096（默认往往只有 1024） */
static void raise_fds(void)
{
    struct rlimit rl = { 0, 0 };

    if (getrlimit(RLIMIT_NOFILE, &rl) != 0)
        return;
    if (rl.rlim_cur >= 4096)
        return;
    rl.rlim_cur = (rl.rlim_max < 4096) ? rl.rlim_max : 4096;
    setrlimit(RLIMIT_NOFILE, &rl);
}

/* 最便宜的任务：建一次、跑完、回收 */
async int trivial(int id)
{
    return id + 1;
}

/* 真实的一次挂起：等 fd 可读，再把那个字节读走 */
async int read_one(int fd)
{
    char c = 0;
    int rev = 0;

    rev = await c6_io(fd, C6_CO_EV_READ);
    if (rev > 0)
        read(fd, &c, 1);
    return rev;
}

/* 常驻内存（RSS），单位 KiB：/proc/self/statm 的第二个字段是常驻页数 */
static long rss_kb(void)
{
    char line[256] = { 0 };
    long total = 0, resident = 0;
    FILE *f = fopen("/proc/self/statm", "r");

    if (!f)
        return -1;
    if (!fgets(line, (int)sizeof line, f)) {
        fclose(f);
        return -1;
    }
    fclose(f);
    if (sscanf(line, "%ld %ld", &total, &resident) != 2)
        return -1;
    return resident * 4;                /* 一页 4 KiB */
}

static void bench_create(void)
{
    u64 t0 = 0;
    int i = 0;

    t0 = now_ns();
    for (i = 0; i < CREATE_N; i++) {
        struct trivial_task *t = trivial(i);

        if (__c6_co_wait(t) != 0)
            return;
        __c6_co_destroy(t);
    }
    printf("create_ns_per_task,%.1f\n", (double)(now_ns() - t0) / CREATE_N);
}

static void bench_switch(void)
{
    u64 t0 = 0;
    int i = 0;

    if (pipe(g_fds) != 0)
        return;
    t0 = now_ns();
    for (i = 0; i < SWITCH_N; i++) {
        struct read_one_task *t = read_one(g_fds[0]);

        write(g_fds[1], "x", 1);
        if (__c6_co_wait(t) != 0)
            return;
        __c6_co_destroy(t);
    }
    printf("switch_ns_per_round,%.1f\n", (double)(now_ns() - t0) / SWITCH_N);
}

static void bench_conns(void)
{
    static int rfd[CONN_N];
    static int wfd[CONN_N];
    long before = 0, after = 0;
    u64 t0 = 0, dt = 0;
    int i = 0;

    for (i = 0; i < CONN_N; i++) {
        int fds[2] = { 0, 0 };

        if (pipe(fds) != 0) {
            printf("conns_error,pipe %d\n", i);
            return;
        }
        rfd[i] = fds[0];
        wfd[i] = fds[1];
        write(fds[1], "x", 1);          /* 每路先有一个字节等着 */
    }
    before = rss_kb();
    for (i = 0; i < CONN_N; i++)
        co read_one(rfd[i]);            /* 全部挂到 epoll 上 */
    after = rss_kb();
    t0 = now_ns();
    if (__c6_co_run() != 0) {
        printf("conns_error,__c6_co_run\n");
        return;
    }
    dt = now_ns() - t0;
    printf("conns_us_per_conn,%.3f\n", (double)dt / 1000.0 / CONN_N);
    printf("rss_bytes_per_task,%.1f\n",
           before > 0 && after > 0 ? (double)(after - before) * 1024.0 / CONN_N : -1.0);
}

/* BENCH_SEC 选跑哪一段：create / switch / conns（默认全跑）。分开跑是因为
   每个指标都想要干净的进程：RSS 增量只有在「刚起来就挂上 1000 路」时才有
   意义。 */
int main(void)
{
    const char *sec = getenv("BENCH_SEC");

    printf("lang,c6(epoll+语言级协程)\n");
    raise_fds();
    if (!sec || !*sec || strcmp(sec, "all") == 0 || strcmp(sec, "create") == 0)
        bench_create();
    if (!sec || !*sec || strcmp(sec, "all") == 0 || strcmp(sec, "switch") == 0)
        bench_switch();
    if (!sec || !*sec || strcmp(sec, "all") == 0 || strcmp(sec, "conns") == 0)
        bench_conns();
    return 0;
}
