/* obj.c6 —— ET_REL 目标文件写出器（`c6c -c`）：可重定位的 .text / .data，
 * 加上 .symtab / .strtab / .rela.text / .rela.data / .shstrtab。
 *
 * 为什么要有这一节：在此之前 c6c 的 -c 也出一份**可执行**的静态 ELF
 * （单文件 freestanding，_start 直接调 main），所以"编一组源文件、各自出 .o、
 * 再链起来"这条最普通的工程流走不通——没有 .o，链接器就没有能接的东西，
 * 也就没有 c6c 顶替 tcc 的第一块地基。这一节补的就是它。
 *
 * 为什么能做得这么薄：前面几节早就把"将来要重定位的东西"记全了，只是 exec
 * 路径最后一次性把它们拍成了绝对地址。五类记录一一对应五类重定位：
 *
 *   X64.fix[]        代码里的 rel32（call / lea rip+disp32）→ R_X86_64_PC32；
 *                    外部符号走 PLT32（和 gcc 一个口径，动态链接时才进 PLT）
 *   X64.labs_patch[] 代码里的 `&&label` imm64              → R_X86_64_64（.text 段符号）
 *   DFIX[]           数据里的符号地址（`&f`、`p = "x"`）    → R_X86_64_64
 *   C99_RLOFF[]      数据里指向数据段内部的裸偏移（字符串字面量）→ R_X86_64_64
 *   CLBL[]           数据里的 `&&label`                     → R_X86_64_64（.text 段符号）
 *
 * 段内标号（if/while 的跳转）本来就在同一段里、相对位移解析期就算完了，
 * 不需要重定位——这也是这一节能只处理"跨段 / 跨符号"引用的原因。
 */

/* ELF 常量（只列这一节用到的；elf.c6 里那套是 exec 侧的） */
#define OBJ_SHT_PROGBITS   1u
#define OBJ_SHT_SYMTAB     2u
#define OBJ_SHT_STRTAB     3u
#define OBJ_SHT_RELA       4u
#define OBJ_SHT_INIT_ARRAY 14u
#define OBJ_SHT_FINI_ARRAY 15u
#define OBJ_SHF_WRITE      0x1u
#define OBJ_SHF_ALLOC      0x2u
#define OBJ_SHF_EXEC       0x4u
#define OBJ_R_X86_64_64    1u
#define OBJ_R_X86_64_PC32  2u
#define OBJ_R_X86_64_PLT32 4u
#define OBJ_STB_LOCAL      0u
#define OBJ_STB_GLOBAL     1u
#define OBJ_STB_WEAK       2u
#define OBJ_STT_NOTYPE     0u
#define OBJ_STT_OBJECT     1u
#define OBJ_STT_FUNC       2u
#define OBJ_STT_SECTION    3u
#define OBJ_SHN_UNDEF      0u
#define OBJ_SHN_TEXT       1u
#define OBJ_SHN_DATA       2u
#define OBJ_SHN_ABS        0xfff1u     /* SHN_ABS：绝对符号，链接器遍次间不丢弃 */
#define OBJ_NSEC           19u
#define OBJ_SYM_TEXT       1u      /* .text 段符号在符号表里的下标 */
#define OBJ_SYM_DATA       2u      /* .data 段符号 */
#define OBJ_SYM_FIRST      3u      /* 第一个真正的符号 */
/* 段下标：前 9 个沿用老顺序（.text / .data / 两个 .rela / .symtab / .strtab /
 * .shstrtab / .note.GNU-stack），构造函数那两组挂在后面。下标是写死的，
 * 别插队——.rela.init_array 的 sh_link 和 sh_info 都按这些常数指回去。 */
#define OBJ_SEC_INIT       9u
#define OBJ_SEC_FINI       10u
#define OBJ_SEC_RELA_INIT  11u
#define OBJ_SEC_RELA_FINI  12u
/* -g 的四个 DWARF 段 + 它们的两张重定位表（下标同样写死，追加在后面） */
#define OBJ_SEC_DEBUG_ABBREV 13u
#define OBJ_SEC_DEBUG_INFO   14u
#define OBJ_SEC_DEBUG_LINE   15u
#define OBJ_SEC_DEBUG_STR    16u
#define OBJ_SEC_RELA_DBGI    17u
#define OBJ_SEC_RELA_DBGL    18u
#define OBJ_SEC_SHSTRTAB   7u

/* dw.c6 的段序号（两个文件共用同一套编号） */
#define DW_SEC_ABBREV 0
#define DW_SEC_INFO   1
#define DW_SEC_LINE   2
#define DW_SEC_STR    3
#define DW_SEC_RELAI  4
#define DW_SEC_RELAL  5

/* -g：调试信息（DWARF 由 dw.c6 造，本文件只负责把它挂进段表与文件） */
static int OBJ_DEBUG;
static const char *OBJ_DEBUG_SRC = "<unknown>";
static void obj_set_debug(int on) { OBJ_DEBUG = on ? 1 : 0; }
static void obj_set_debug_src(const char *path) { OBJ_DEBUG_SRC = path; }

typedef struct ObjBuf {
    u8 *p;
    u32 n;
    u32 cap;
} ObjBuf;

/* dw.c6（本文件之后 include）提供：造 DWARF、以及按序号取那几块缓冲区 */
static void dw_build(const char *srcpath, u32 text_size);
static ObjBuf *dw_sec(int which);

static void ob_room(ObjBuf *b, u32 need)
{
    u32 ncap = b->cap ? b->cap : 256;
    u8 *np = NULL;

    if (b->n + need <= b->cap)
        return;
    while (ncap < b->n + need)
        ncap += ncap / 2 + 256;
    np = realloc(b->p, ncap);
    if (!np)
        return;
    memset(np + b->cap, 0, (size_t)(ncap - b->cap));
    b->p = np;
    b->cap = ncap;
}

static u32 ob_reserve(ObjBuf *b, u32 n)
{
    u32 off = b->n;

    ob_room(b, n);
    b->n += n;
    return off;
}

static void ob_u8(ObjBuf *b, u32 v)
{
    u32 o = ob_reserve(b, 1);

    b->p[o] = (u8)v;
}

static void ob_u16(ObjBuf *b, u32 v)
{
    u32 o = ob_reserve(b, 2);

    b->p[o] = (u8)(v & 0xFF);
    b->p[o + 1] = (u8)((v >> 8) & 0xFF);
}

static void ob_u32(ObjBuf *b, u32 v)
{
    u32 o = ob_reserve(b, 4);

    memcpy(b->p + o, &v, 4);
}

static void ob_u64(ObjBuf *b, u64 v)
{
    u32 o = ob_reserve(b, 8);
    u32 lo = (u32)(v & 0xFFFFFFFFu);
    u32 hi = (u32)(v >> 32);

    memcpy(b->p + o, &lo, 4);
    memcpy(b->p + o + 4, &hi, 4);
}

static void ob_zero(ObjBuf *b, u32 n)
{
    ob_reserve(b, n);
}

static void ob_copy(ObjBuf *b, const void *src, u32 n)
{
    u32 o = 0;

    if (!n)
        return;
    o = ob_reserve(b, n);
    memcpy(b->p + o, src, n);
}

static void ob_align(ObjBuf *b, u32 a)
{
    while (a && (b->n % a))
        ob_u8(b, 0);
}

/* 回填（头部字段最后才知道）。和 elf.c6 里那组同义，只是作用在 ObjBuf 上。 */
static void ob_patch16(ObjBuf *b, u32 off, u32 v)
{
    b->p[off] = (u8)(v & 0xFF);
    b->p[off + 1] = (u8)((v >> 8) & 0xFF);
}

static void ob_patch32(ObjBuf *b, u32 off, u32 v)
{
    memcpy(b->p + off, &v, 4);
}

static void ob_patch64(ObjBuf *b, u32 off, u64 v)
{
    u32 lo = (u32)(v & 0xFFFFFFFFu);
    u32 hi = (u32)(v >> 32);

    memcpy(b->p + off, &lo, 4);
    memcpy(b->p + off + 4, &hi, 4);
}

/* --- 字符串表（.strtab / .shstrtab）：去重，一个名字只存一份 --- */

typedef struct ObjStr {
    ObjBuf b;
    const char **name;
    u32 *off;
    u32 n;
    u32 cap;
} ObjStr;

static void ob_str_init(ObjStr *s)
{
    ob_u8(&s->b, 0);            /* 下标 0 永远是空串 */
}

static u32 ob_str(ObjStr *s, const char *name)
{
    u32 i = 0;

    if (!s->b.n)
        ob_str_init(s);
    for (i = 0; i < s->n; i++)
        if (strcmp(s->name[i], name) == 0)
            return s->off[i];
    if (s->n >= s->cap) {
        u32 nc = s->cap ? s->cap * 2 : 256;
        const char **nn = (const char **)realloc((void *)s->name,
                                                 (size_t)nc * sizeof(char *));
        u32 *no = (u32 *)realloc(s->off, (size_t)nc * sizeof(u32));

        if (!nn || !no)
            return 0;
        s->name = nn;
        s->off = no;
        s->cap = nc;
    }
    s->name[s->n] = name;
    s->off[s->n] = s->b.n;
    s->n++;
    ob_copy(&s->b, name, (u32)strlen(name) + 1);
    return s->off[s->n - 1];
}

static void ob_str_free(ObjStr *s)
{
    free(s->b.p);
    free((void *)s->name);
    free(s->off);
    s->b.p = NULL;
    s->name = NULL;
    s->off = NULL;
    s->n = 0;
    s->cap = 0;
}

/* --- 符号表 --- */

typedef struct ObjSym {
    u32 name;       /* .strtab 偏移 */
    u8 info;        /* bind << 4 | type */
    u16 shndx;
    u64 value;
} ObjSym;

typedef struct ObjSyms {
    ObjSym *e;
    u32 n;
    u32 cap;
} ObjSyms;

static void ob_sym_add(ObjSyms *s, u32 name, u8 info, u16 shndx, u64 value)
{
    if (s->n >= s->cap) {
        u32 nc = s->cap ? s->cap * 2 : 1024;
        ObjSym *ne = (ObjSym *)realloc(s->e, (size_t)nc * sizeof(ObjSym));

        if (!ne)
            return;
        s->e = ne;
        s->cap = nc;
    }
    s->e[s->n].name = name;
    s->e[s->n].info = info;
    s->e[s->n].shndx = shndx;
    s->e[s->n].value = value;
    s->n++;
}

/* 落一个符号的 24 字节（ELF64 的 Elf64_Sym） */
static void ob_sym_write(ObjBuf *b, const ObjSym *s)
{
    ob_u32(b, s->name);
    ob_u8(b, s->info);
    ob_u8(b, 0);            /* st_other：默认可见性 */
    ob_u16(b, s->shndx);
    ob_u64(b, s->value);
    ob_u64(b, 0);           /* st_size：c6c 不追每个符号的大小，链接器不依赖它 */
}

/* 落一条重定位（ELF64 的 Elf64_Rela，24 字节） */
static void ob_rela_add(ObjBuf *b, u32 off, u32 sym, u32 type, i64 add)
{
    ob_u64(b, (u64)off);
    ob_u64(b, ((u64)sym << 32) | (u64)type);
    ob_u64(b, (u64)add);
}

/* 名字是不是"本 TU 私有"：字符串字面量 `.LC<n>`、静态符号 `helper$2`
 * （tu_static_name 加的后缀）、汇编器内部的段内标号。私有的给 LOCAL，
 * 不污染链接期的全局命名空间。 */
static int ob_sym_local(const char *name)
{
    if (!name || !name[0])
        return 1;
    if (name[0] == '.')
        return 1;
    /* 编译器自己的 TLS 记账格（`__c6_tls_img` / `__c6_tls_len` /
     * `__c6_tls_delta`）：每个 TU 都会发一份，做成全局就"重复定义"。它们是
     * 本 TU 的运行期私有数据，链接期不该有人看见。 */
    if (strncmp(name, "__c6_tls_", 9) == 0)
        return 1;
    /* asmblob.c6 里的指令跳板（`__c6_fsbase`、`__c6_atomic_inc`、`__c6_xchg8`
     * ……）：哪个 TU 用到就在那个 TU 里发一份，两份字节完全一样。做成全局的话
     * 两个用了 TLS 的 .o 一链就"重复定义 __c6_fsbase"。它们没有状态，各留各的
     * 正是"内联"语义。 */
    if (asmblob_find(name))
        return 1;
    return strchr(name, '$') != NULL;
}

/* 符号的段内值：.text 用 CODE_IMG 坐标，.data 减掉文件头的 120 字节。 */
static u64 ob_sym_value(const X64Sym *s)
{
    if (!s->defined)
        return 0;
    /* top-level asm 定义的符号 off 是 CODE_IMG 坐标，即使被 C 的 extern u8[]
     * 引用设了 is_data，也不能按数据段减 ELF_HDR——否则得到负偏移
     * （0xffffff9a），PC32 重定位放不下。 */
    if (s->is_data && !s->is_asm)
        return (u64)(s->off - (u32)ELF_HDR);
    return (u64)s->off;
}

/* 数据段偏移 off 落在哪个数据符号上（取起点不晚于 off 且最靠后的那个）。
 * 找不到就返回 0，调用方退回 .data 段符号 + 加数——链接器只认 S + A。 */
static u32 ob_data_owner(u32 off)
{
    u32 i = 0;
    u32 best = 0;

    for (i = 0; i < X64.nsym; i++) {
        X64Sym *s = &X64.sym[i];

        if (!s->defined || !s->is_data || !s->name || s->off < (u32)ELF_HDR)
            continue;
        if (s->off - (u32)ELF_HDR > off)
            continue;
        if (!best || X64.sym[best].off < s->off)
            best = i;
    }
    return best;
}

/* 函数级死代码消除（实验性，C6C_KERNEL_DCE=1 开）。
 *
 * 内核头文件里上万个 static/extern inline，c6c 不做内联、每个 TU 全量发射，
 * 于是 .o 里有上千个从未被调用的 local 函数，它们体内引用了 gcc 会折叠掉的
 * 符号（__xadd_wrong_size 之类），链接期一堆 undefined reference。
 *
 * 做法：从所有 fixup（代码 call/lea、数据函数指针、label、ctor）收集"被引用
 * 符号集"。defined 的 local 函数符号若从未被引用，就是死函数——把它的入口
 * 改写成一条 ret（0xC3），并丢弃落在它区间内的 fixup。不动函数布局、不改
 * 符号表，所以其它代码的偏移和重定位完全不受影响。 */
static void obj_dce_stub_dead(void)
{
    u8 *mark = NULL;
    u32 ndead = 0;
    u32 i = 0;
    u32 j = 0;
    u32 k = 0;

    if (!getenv("C6C_KERNEL_DCE"))
        return;
    mark = (u8 *)calloc(X64.nsym ? X64.nsym : 1, 1);
    if (!mark)
        return;

    /* 1) 根集：全局可见的 defined 函数（外部可能调用）+ 数据/构造函数引用
     *    的符号。注意**不能**把所有 fixup 目标都当根——那样一串互相调用的
     *    inline 函数会全部被误标成"活"（正是上一版的问题）。 */
    for (i = 0; i < X64.nsym; i++) {
        X64Sym *s = &X64.sym[i];

        if (s->defined && !s->is_data && !s->is_static && s->name && s->name[0])
            mark[i] = 1;
    }
    for (i = 0; i < NDFIX; i++) {
        if (DFIX_SYM[i] < X64.nsym)
            mark[DFIX_SYM[i]] = 1;
    }
    for (i = 0; i < NCLBL; i++) {
        if (CLBL_FN[i] < X64.nsym)
            mark[CLBL_FN[i]] = 1;
    }
    for (i = 0; i < NCTOR; i++) {
        if (CTORS[i] < X64.nsym)
            mark[CTORS[i]] = 1;
    }
    for (i = 0; i < NDTOR; i++) {
        if (DTORS[i] < X64.nsym)
            mark[DTORS[i]] = 1;
    }

    /* 2+3) 高效 DCE：预排序代码符号 off，patch 用二分查所属函数，
     *      避免原 O(nfix × nsym²) 在大 TU（common.c 2179 符号）上超时。 */
    {
        u32 *offs = NULL;
        u32 *oids = NULL;
        u32 *owner = NULL;
        u32 n = 0;
        u32 i2 = 0;
        u32 changed = 1;
        u32 NONE = 0xffffffffu;

        offs = (u32 *)calloc(X64.nsym ? X64.nsym : 1, sizeof(u32));
        oids = (u32 *)calloc(X64.nsym ? X64.nsym : 1, sizeof(u32));
        owner = (u32 *)calloc(X64.nfix ? X64.nfix : 1, sizeof(u32));
        if (!offs || !oids || !owner) {
            free(offs);
            free(oids);
            free(owner);
            free(mark);
            return;
        }
        for (i2 = 0; i2 < X64.nsym; i2++) {
            X64Sym *s = &X64.sym[i2];

            if (!s->defined || s->is_data || !s->name || !s->name[0])
                continue;
            if (s->off >= CODE_IMG.n)
                continue;
            offs[n] = s->off;
            oids[n] = i2;
            n++;
        }
        /* 选择排序：n ~ 2000，一次，足够快 */
        for (i2 = 0; i2 < n; i2++) {
            u32 j2 = i2 + 1;
            u32 best = i2;

            for (; j2 < n; j2++)
                if (offs[j2] < offs[best])
                    best = j2;
            if (best != i2) {
                u32 t = offs[i2];
                offs[i2] = offs[best];
                offs[best] = t;
                t = oids[i2];
                oids[i2] = oids[best];
                oids[best] = t;
            }
        }
        /* 每条 fixup 的 patch 属于"off 最大且 <= patch"的代码符号 */
        for (i2 = 0; i2 < X64.nfix; i2++) {
            u32 p = X64.fix[i2].patch;
            u32 lo = 0;
            u32 hi = n;

            owner[i2] = NONE;
            while (lo < hi) {
                u32 mid = (lo + hi) / 2;

                if (offs[mid] <= p)
                    lo = mid + 1;
                else
                    hi = mid;
            }
            if (lo > 0)
                owner[i2] = oids[lo - 1];
        }
        /* 传递闭包：活函数体内的 fixup 目标也活（迭代到稳定） */
        while (changed) {
            changed = 0;
            for (i2 = 0; i2 < X64.nfix; i2++) {
                u32 o = owner[i2];
                u32 t = X64.fix[i2].sym;

                if (o == NONE || !mark[o] || t >= X64.nsym || mark[t])
                    continue;
                mark[t] = 1;
                changed = 1;
            }
        }
        /* 死 local 函数入口写 ret */
        for (i2 = 0; i2 < X64.nsym; i2++) {
            X64Sym *s = &X64.sym[i2];

            if (!s->defined || s->is_data || !s->is_static || !s->name || !s->name[0])
                continue;
            if (mark[i2] || s->off >= CODE_IMG.n)
                continue;
            CODE_IMG.p[s->off] = 0xC3;      /* ret */
            ndead++;
        }
        /* 压缩 fixup：patch 属于死 local 函数者丢弃；E8 rel32 一并 NOP 化，
         * 否则 objtool 会把 rel32=0 的 call 当 intra-function call。 */
        k = 0;
        for (i2 = 0; i2 < X64.nfix; i2++) {
            u32 o = owner[i2];
            int drop = (o != NONE && !mark[o] && X64.sym[o].is_static);

            /* 内核模式 UND weak → SHN_ABS 0 的符号：代码若 call 它，链接器把
             * rel32 解析成跳到地址 0，早期启动崩溃（gcc 会常量折叠掉这些
             * 不可达调用，c6c 保留了调用）。像死函数一样 NOP 化该 call。 */
            if (!drop && getenv("C6C_KERNEL_DCE") && X64.fix[i2].sym < X64.nsym
                && !X64.sym[X64.fix[i2].sym].defined
                && !X64.sym[X64.fix[i2].sym].is_static)
                drop = 1;

            if (drop) {
                u32 p = X64.fix[i2].patch;

                if (p > 0 && p + 3 < CODE_IMG.n && CODE_IMG.p[p - 1] == 0xE8) {
                    CODE_IMG.p[p - 1] = 0x90;
                    CODE_IMG.p[p] = 0x90;
                    CODE_IMG.p[p + 1] = 0x90;
                    CODE_IMG.p[p + 2] = 0x90;
                    CODE_IMG.p[p + 3] = 0x90;
                }
            } else {
                X64.fix[k++] = X64.fix[i2];
            }
        }
        X64.nfix = k;
        free(offs);
        free(oids);
        free(owner);
    }

    fprintf(stderr, "c6c: DCE stub %u 个死 local 函数，留 %u 条 fixup\n",
            ndead, X64.nfix);
    free(mark);
}

/* 写出目标文件。调用前：解析完、x64_resolve 跑过（跳板补齐、未定义不报错）。 */
static void obj_write(const char *path)
{
    ObjBuf relat = {0};         /* .rela.text */
    ObjBuf relad = {0};         /* .rela.data */
    ObjBuf init = {0};          /* .init_array */
    ObjBuf fini = {0};          /* .fini_array */
    ObjBuf relai = {0};         /* .rela.init_array */
    ObjBuf relaf = {0};         /* .rela.fini_array */
    ObjBuf symtab = {0};
    ObjBuf f = {0};             /* 整份文件 */
    ObjStr str = {0};
    ObjStr shstr = {0};
    ObjSyms loc = {0};          /* 本地符号（含 0 号与两个段符号） */
    ObjSyms glob = {0};
    ObjSyms all = {0};          /* 本地 + 全局，最终顺序 */
    u32 *map = NULL;            /* X64 符号 id → ELF 符号下标 */
    u8 *emit = NULL;            /* 内核模式：UND 且未被重定位引用的符号不发表项 */
    u8 *seen = NULL;            /* 数据段里已落过重定位的字节（去重） */
    u8 *pseudo_syms = NULL;     /* 内核模式 UND weak → ret stub 的符号 id */
    u32 weak_stub_off = 0;      /* .text 末尾 ret stub 的偏移 */
    u32 i = 0;
    u32 nlocal = 0;
    u32 off_text = 0;
    u32 off_data = 0;
    u32 off_relat = 0;
    u32 off_relad = 0;
    u32 off_init = 0;
    u32 off_fini = 0;
    u32 off_relai = 0;
    u32 off_relaf = 0;
    u32 off_dbga = 0;
    u32 off_dbgi = 0;
    u32 off_dbgl = 0;
    u32 off_dbgs = 0;
    u32 off_rela_dbgi = 0;
    u32 off_rela_dbgl = 0;
    u32 off_sym = 0;
    u32 off_str = 0;
    u32 off_shstr = 0;
    u32 off_shdr = 0;
    u32 sh_name[OBJ_NSEC] = {0};
    FILE *out = NULL;

    if (!CODE_IMG.n && !DATA_IMG.n) {
        fprintf(stderr, "c6c: 没有可写出的内容\n");
        return;
    }
    obj_dce_stub_dead();
    /* 内核模式 UND weak 引用（gcc 常量折叠掉、c6c 保留）不能发成 ABS 0：
     * 代码里 call 它会跳地址 0 崩溃。在 .text 末尾放一条独立的 `ret` stub，
     * pseudo 符号统一指向它——call 安全返回，数据引用得到非零地址。 */
    if (getenv("C6C_KERNEL_DCE") && CODE_IMG.n < CODE_IMG.cap) {
        weak_stub_off = CODE_IMG.n;
        CODE_IMG.p[CODE_IMG.n++] = 0xC3;   /* ret */
    }
    ob_str_init(&str);
    ob_str_init(&shstr);

    /* 0 号符号 + 两个段符号（LOCAL，当"段内偏移"的载体） */
    ob_sym_add(&loc, 0, 0, OBJ_SHN_UNDEF, 0);
    ob_sym_add(&loc, ob_str(&str, ".text"),
               (u8)((OBJ_STB_LOCAL << 4) | OBJ_STT_SECTION), OBJ_SHN_TEXT, 0);
    ob_sym_add(&loc, ob_str(&str, ".data"),
               (u8)((OBJ_STB_LOCAL << 4) | OBJ_STT_SECTION), OBJ_SHN_DATA, 0);

    map = (u32 *)calloc(X64.nsym ? X64.nsym : 1, sizeof(u32));
    if (!map) {
        ob_str_free(&str);
        ob_str_free(&shstr);
        return;
    }

    /* 内核模式下，未定义且未被任何重定位引用的符号不进符号表。gcc 前端会
     * 常量折叠掉大量不可达分支/条件编译残留（RCU、__SCK__tp_func_* 等），
     * c6c 只把它们登记成名字。这些符号发成 WEAK UND 后，最终链接
     * （--emit-relocs）保留、kallsyms 中间遍次丢弃，导致一致性检查失败。
     * 没被引用就完全不发，两边就一致；非内核模式行为不变。 */
    emit = (u8 *)calloc(X64.nsym ? X64.nsym : 1, 1);
    pseudo_syms = (u8 *)calloc(X64.nsym ? X64.nsym : 1, 1);
    if (!emit || !pseudo_syms) {
        free(pseudo_syms);
        free(map);
        ob_str_free(&str);
        ob_str_free(&shstr);
        return;
    }
    if (getenv("C6C_KERNEL_DCE")) {
        for (i = 0; i < X64.nsym; i++)
            emit[i] = X64.sym[i].defined ? 1 : 0;
        for (i = 0; i < X64.nfix; i++)
            if (X64.fix[i].sym < X64.nsym)
                emit[X64.fix[i].sym] = 1;
        for (i = 0; i < NDFIX; i++)
            if (DFIX_SYM[i] < X64.nsym)
                emit[DFIX_SYM[i]] = 1;
        for (i = 0; i < C99_NRL; i++) {
            u32 owner = ob_data_owner(C99_RLTGT[i]);
            if (owner && owner < X64.nsym)
                emit[owner] = 1;
        }
        for (i = 0; i < NCTOR; i++)
            if (CTORS[i] < X64.nsym)
                emit[CTORS[i]] = 1;
        for (i = 0; i < NDTOR; i++)
            if (DTORS[i] < X64.nsym)
                emit[DTORS[i]] = 1;
    } else {
        for (i = 0; i < X64.nsym; i++)
            emit[i] = 1;
    }

    /* 先本地、后全局：ELF 要求 sh_info 之前的全是 LOCAL，链接器按这个分界
     * 建全局符号表。 */
    for (i = 0; i < X64.nsym; i++) {
        X64Sym *s = &X64.sym[i];
        int local = 0;
        int pseudo = 0;
        u8 bind = OBJ_STB_GLOBAL;
        u8 type = OBJ_STT_NOTYPE;
        u16 shndx = OBJ_SHN_UNDEF;

        if (!emit[i])
            continue;           /* 未引用的 UND 符号：不发表项，map 里留 0 */
        if (!s->name || !s->name[0])
            continue;           /* 无名符号：重定位里退化成 0 号 */
        local = ob_sym_local(s->name) || s->is_static;
        /* 内核模式下，未定义的外部函数引用一律发 WEAK UND。原因：
         * gcc 会常量折叠掉大量不可达分支（编译期断言 __bad_*、条件编译
         * 关闭的功能、register asm 变量如 current_stack_pointer），从不发
         * 对它们的引用。c6c 不做常量传播/寄存器绑定，保留了这些引用，若
         * 发成强 UND 会全量链接 undefined。
         * WEAK UND：有强定义的符号（.S、其他 TU）链接器仍正常解析；确实
         * 缺失的就是 gcc 也优化掉的不可达引用，填 0 无害。qemu 启动验证。 */
        /* 内核模式 UND 引用默认转 pseudo（→ .text ret stub / ABS 0）：gcc
         * 常量折叠掉的不可达引用（含 tracepoint stub `__SCK__tp_func_*`）若
         * 发成强 UND 会全量链接 undefined。
         * 但**数据初始化目标**（DFIX，如 `current_task = &init_task`）里，
         * 真正有定义的外部符号（init_task 等）必须保持 UND——否则 DFIX 那条
         * R_X86_64_64 被跳过、初值留在 0，common_startup_64 读 current_task
         * 得到 0 → 无效 %rsp → triple fault。tracepoint stub 名字固定以
         * `__SCK__tp_func_` 开头，它们确实没有定义，仍按老规矩转 pseudo。 */
        int dfix_target = 0;
        if (getenv("C6C_KERNEL_DCE")) {
            u32 di2 = 0;
            for (di2 = 0; di2 < NDFIX; di2++)
                if (DFIX_SYM[di2] == i) { dfix_target = 1; break; }
        }
        int sck_stub = s->name && strncmp(s->name, "__SCK__tp_func_", 15) == 0;
        if (!s->defined && !local && getenv("C6C_KERNEL_DCE")
            && (!dfix_target || sck_stub)) {
            pseudo = 1;
            pseudo_syms[i] = 1;
        }
        bind = (u8)(local ? OBJ_STB_LOCAL
                    : (s->is_weak || pseudo) ? OBJ_STB_WEAK : OBJ_STB_GLOBAL);
        if (s->defined && s->is_data && !s->is_asm) {
            type = OBJ_STT_OBJECT;
            shndx = OBJ_SHN_DATA;
        } else if (s->defined) {
            /* is_asm 符号即使被当数据引用，off 也是 CODE_IMG 坐标 → TEXT 段 */
            type = (u8)(s->is_data ? OBJ_STT_OBJECT : OBJ_STT_FUNC);
            shndx = OBJ_SHN_TEXT;
        } else if (s->is_data) {
            /* **未定义**的数据符号也要标成 OBJECT：链接器靠这个区分
             * "能动态导入的函数"和"要做 COPY 重定位的数据"（environ 这类）。
             * 全标 NOTYPE 的话链接器只能瞎猜。 */
            type = OBJ_STT_OBJECT;
        }
        if (pseudo && !getenv("C6C_KERNEL_WEAK_UND")) {
            /* 内核模式未解析的 weak 引用：指向 .text 末尾的 `ret` stub。
             * 不能发成 SHN_ABS 0——代码里 call 它会跳地址 0 崩溃（gcc 会
             * 常量折叠掉这些不可达调用，c6c 保留了）。stub 在所有遍次
             * 都保留且地址一致，System.map 与 .syms 一致；有强定义的符号
             * （别的 TU/.S）链接器仍正常解析覆盖。 */
            if (weak_stub_off) {
                shndx = OBJ_SHN_TEXT;
                type = OBJ_STT_NOTYPE;
            } else {
                shndx = OBJ_SHN_ABS;
                type = OBJ_STT_NOTYPE;
            }
        }
        ob_sym_add(local ? &loc : &glob, ob_str(&str, s->name),
                   (u8)((bind << 4) | type), shndx,
                   (pseudo && weak_stub_off && !getenv("C6C_KERNEL_WEAK_UND"))
                       ? weak_stub_off : ob_sym_value(s));
    }
    nlocal = loc.n;
    for (i = 0; i < loc.n; i++)
        ob_sym_add(&all, loc.e[i].name, loc.e[i].info, loc.e[i].shndx, loc.e[i].value);
    for (i = 0; i < glob.n; i++)
        ob_sym_add(&all, glob.e[i].name, glob.e[i].info, glob.e[i].shndx, glob.e[i].value);

    /* 回填 map：顺序必须和上面分类一致（本地一段、全局一段） */
    {
        u32 li = OBJ_SYM_FIRST;
        u32 gi = nlocal;

        for (i = 0; i < X64.nsym; i++) {
            X64Sym *s = &X64.sym[i];

            if (!emit[i] || !s->name || !s->name[0]) {
                map[i] = 0;
                continue;
            }
            map[i] = (ob_sym_local(s->name) || s->is_static) ? li++ : gi++;
        }
    }

    /* --- .rela.text：代码里的跨符号引用 --- */
    for (i = 0; i < X64.nfix; i++) {
        X64Fix *fx = &X64.fix[i];
        u32 type = 0;

        if (fx->sym >= X64.nsym) {
            fprintf(stderr, "c6c: 警告：代码 fixup 符号 id %u 越界（nsym=%u），跳过\n",
                    fx->sym, X64.nsym);
            continue;
        }
        type = X64.sym[fx->sym].defined ? OBJ_R_X86_64_PC32 : OBJ_R_X86_64_PLT32;
        /* rel32 的 PC 是字段末尾：reloc 算的是 S + A - P，所以 A = -4 */
        ob_rela_add(&relat, fx->patch, map[fx->sym], type, -4);
    }
    for (i = 0; i < X64.nlabs_fix; i++)
        ob_rela_add(&relat, X64.labs_patch[i], OBJ_SYM_TEXT, OBJ_R_X86_64_64,
                    (i64)X64.labs_val[i]);

    /* --- .rela.data：数据里的地址 --- */
    seen = (u8 *)calloc(DATA_IMG.n ? DATA_IMG.n : 1, 1);
    if (!seen) {
        free(map);
        free(emit);
        ob_str_free(&str);
        ob_str_free(&shstr);
        free(loc.e);
        free(glob.e);
        free(all.e);
        return;
    }
    for (i = 0; i < NDFIX; i++) {
        u32 off = DFIX_OFF[i];

        if (off + 8 > DATA_IMG.n || seen[off])
            continue;
        seen[off] = 1;
        if (DFIX_SYM[i] >= X64.nsym) {
            fprintf(stderr, "c6c: 警告：数据 fixup 符号 id %u 越界（nsym=%u, off=%u），跳过\n",
                    DFIX_SYM[i], X64.nsym, off);
            continue;
        }
        /* pseudo（UND→ABS/stub）符号不发绝对重定位：内核 RELOCS 工具拒绝
         * ABS 符号的 R_X86_64_64。真正有定义的初始化目标（init_task 等）已在
         * 符号生成处排除出 pseudo，不受此限。
         * weak 函数定义的 EXPORT_SYMBOL 地址：UND weak→ABS 0 占位常抢占
         * 真 weak 定义，最终链接给 0 且 relocs 拒绝其绝对重定位。 */
        if (pseudo_syms[DFIX_SYM[i]])
            continue;
        if (getenv("C6C_KERNEL_DCE") && X64.sym[DFIX_SYM[i]].is_weak
            && X64.sym[DFIX_SYM[i]].defined)
            continue;
        ob_rela_add(&relad, off, map[DFIX_SYM[i]], OBJ_R_X86_64_64, DFIX_ADD[i]);
    }
    for (i = 0; i < C99_NRL; i++) {
        u32 off = C99_RLOFF[i];
        u32 owner = 0;

        if (off + 8 > DATA_IMG.n || seen[off])
            continue;
        seen[off] = 1;
        owner = ob_data_owner(C99_RLTGT[i]);
        if (owner && owner < X64.nsym) {
            /* 内核模式 weak 函数的 EXPORT_SYMBOL 地址：UND weak→SHN_ABS 0
             * 的占位符号常抢占真 weak 定义（GNU ld 同名 weak 第一个胜出），
             * 最终链接给的地址就是 0，且其 R_X86_64_64 被内核 relocs 拒绝。
             * 这里不发重定位：该格保持 0，与链接结果一致，但消除了 relocs
             * 对 ABS 符号绝对重定位的报错。 */
            if (getenv("C6C_KERNEL_DCE")
                && (pseudo_syms[owner]
                    || (X64.sym[owner].is_weak && X64.sym[owner].defined)))
                continue;
            ob_rela_add(&relad, off, map[owner], OBJ_R_X86_64_64,
                        (i64)C99_RLTGT[i] - (i64)ob_sym_value(&X64.sym[owner]));
        }
        else
            ob_rela_add(&relad, off, OBJ_SYM_DATA, OBJ_R_X86_64_64, (i64)C99_RLTGT[i]);
    }
    for (i = 0; i < NCLBL; i++) {
        u32 off = CLBL_OFF[i];

        if (off + 8 > DATA_IMG.n || seen[off])
            continue;
        seen[off] = 1;
        ob_rela_add(&relad, off, OBJ_SYM_TEXT, OBJ_R_X86_64_64,
                    (i64)x64_lbl_off(&X64, CLBL_FN[i], CLBL_LBL[i]));
    }

    /* --- .init_array / .fini_array：构造函数就是"指向函数的一格指针"。exec
     * 镜像里这张表是编译器在内存里现拼的（见 x64_emit_start 之前的 ctor 循环），
     * 出 .o 时得落进段里，否则链接出来的程序没人跑 TLS 初始化这类构造。 --- */
    for (i = 0; i < NCTOR; i++) {
        if (CTORS[i] >= X64.nsym)
            continue;
        ob_zero(&init, 8);
        ob_rela_add(&relai, init.n - 8u, map[CTORS[i]], OBJ_R_X86_64_64, 0);
    }
    for (i = 0; i < NDTOR; i++) {
        if (DTORS[i] >= X64.nsym)
            continue;
        ob_zero(&fini, 8);
        ob_rela_add(&relaf, fini.n - 8u, map[DTORS[i]], OBJ_R_X86_64_64, 0);
    }

    /* 段名先进 shstrtab：它的内容必须**先定稿**，否则整份文件的偏移全要重排 */
    sh_name[0] = 0;
    sh_name[1] = ob_str(&shstr, ".text");
    sh_name[2] = ob_str(&shstr, ".data");
    sh_name[3] = ob_str(&shstr, ".rela.text");
    sh_name[4] = ob_str(&shstr, ".rela.data");
    sh_name[5] = ob_str(&shstr, ".symtab");
    sh_name[6] = ob_str(&shstr, ".strtab");
    sh_name[7] = ob_str(&shstr, ".shstrtab");
    sh_name[8] = ob_str(&shstr, ".note.GNU-stack");
    sh_name[OBJ_SEC_INIT] = ob_str(&shstr, ".init_array");
    sh_name[OBJ_SEC_FINI] = ob_str(&shstr, ".fini_array");
    sh_name[OBJ_SEC_RELA_INIT] = ob_str(&shstr, ".rela.init_array");
    sh_name[OBJ_SEC_RELA_FINI] = ob_str(&shstr, ".rela.fini_array");
    if (OBJ_DEBUG) {
        sh_name[OBJ_SEC_DEBUG_ABBREV] = ob_str(&shstr, ".debug_abbrev");
        sh_name[OBJ_SEC_DEBUG_INFO] = ob_str(&shstr, ".debug_info");
        sh_name[OBJ_SEC_DEBUG_LINE] = ob_str(&shstr, ".debug_line");
        sh_name[OBJ_SEC_DEBUG_STR] = ob_str(&shstr, ".debug_str");
        sh_name[OBJ_SEC_RELA_DBGI] = ob_str(&shstr, ".rela.debug_info");
        sh_name[OBJ_SEC_RELA_DBGL] = ob_str(&shstr, ".rela.debug_line");
    }

    if (OBJ_DEBUG)
        dw_build(OBJ_DEBUG_SRC, CODE_IMG.n);

    for (i = 0; i < all.n; i++)
        ob_sym_write(&symtab, &all.e[i]);

    /* --- 拼文件 --- */
    ob_zero(&f, ELF_EHDR);              /* 头先占位，字段最后回填 */
    ob_align(&f, 16);
    off_text = f.n;
    ob_copy(&f, CODE_IMG.p, CODE_IMG.n);
    ob_align(&f, 8);
    off_data = f.n;
    ob_copy(&f, DATA_IMG.p, DATA_IMG.n);
    ob_align(&f, 8);
    off_relat = f.n;
    ob_copy(&f, relat.p, relat.n);
    ob_align(&f, 8);
    off_relad = f.n;
    ob_copy(&f, relad.p, relad.n);
    ob_align(&f, 8);
    off_init = f.n;
    ob_copy(&f, init.p, init.n);
    ob_align(&f, 8);
    off_fini = f.n;
    ob_copy(&f, fini.p, fini.n);
    ob_align(&f, 8);
    off_relai = f.n;
    ob_copy(&f, relai.p, relai.n);
    ob_align(&f, 8);
    off_relaf = f.n;
    ob_copy(&f, relaf.p, relaf.n);
    ob_align(&f, 8);
    off_dbgi = 0;
    off_dbgl = 0;
    off_dbga = 0;
    off_dbgs = 0;
    off_rela_dbgi = 0;
    off_rela_dbgl = 0;
    if (OBJ_DEBUG) {
        off_dbga = f.n;
        ob_copy(&f, dw_sec(DW_SEC_ABBREV)->p, dw_sec(DW_SEC_ABBREV)->n);
        ob_align(&f, 8);
        off_dbgi = f.n;
        ob_copy(&f, dw_sec(DW_SEC_INFO)->p, dw_sec(DW_SEC_INFO)->n);
        ob_align(&f, 8);
        off_dbgl = f.n;
        ob_copy(&f, dw_sec(DW_SEC_LINE)->p, dw_sec(DW_SEC_LINE)->n);
        ob_align(&f, 8);
        off_dbgs = f.n;
        ob_copy(&f, dw_sec(DW_SEC_STR)->p, dw_sec(DW_SEC_STR)->n);
        ob_align(&f, 8);
        off_rela_dbgi = f.n;
        ob_copy(&f, dw_sec(DW_SEC_RELAI)->p, dw_sec(DW_SEC_RELAI)->n);
        ob_align(&f, 8);
        off_rela_dbgl = f.n;
        ob_copy(&f, dw_sec(DW_SEC_RELAL)->p, dw_sec(DW_SEC_RELAL)->n);
        ob_align(&f, 8);
    }
    off_sym = f.n;
    ob_copy(&f, symtab.p, symtab.n);
    off_str = f.n;
    ob_copy(&f, str.b.p, str.b.n);
    off_shstr = f.n;
    ob_copy(&f, shstr.b.p, shstr.b.n);
    ob_align(&f, 8);
    off_shdr = f.n;

    /* 9 个段头，每个 64 字节 */
    for (i = 0; i < OBJ_NSEC; i++) {
        u32 ty = 0;
        u64 flags = 0;
        u64 sz = 0;
        u32 off = 0;
        u32 link = 0;
        u32 info = 0;
        u64 align = 1;
        u64 ent = 0;

        if (i == 1) {                   /* .text */
            ty = OBJ_SHT_PROGBITS;
            flags = OBJ_SHF_ALLOC | OBJ_SHF_EXEC;
            sz = CODE_IMG.n;
            off = off_text;
            align = 16;
        } else if (i == 2) {            /* .data */
            ty = OBJ_SHT_PROGBITS;
            flags = OBJ_SHF_ALLOC | OBJ_SHF_WRITE;
            sz = DATA_IMG.n;
            off = off_data;
            align = 8;
        } else if (i == 3) {            /* .rela.text */
            ty = OBJ_SHT_RELA;
            sz = relat.n;
            off = off_relat;
            link = 5;                   /* .symtab */
            info = OBJ_SHN_TEXT;
            align = 8;
            ent = 24;
        } else if (i == 4) {            /* .rela.data */
            ty = OBJ_SHT_RELA;
            sz = relad.n;
            off = off_relad;
            link = 5;
            info = OBJ_SHN_DATA;
            align = 8;
            ent = 24;
        } else if (i == 5) {            /* .symtab */
            ty = OBJ_SHT_SYMTAB;
            sz = symtab.n;
            off = off_sym;
            link = 6;                   /* .strtab */
            info = nlocal;              /* 第一个全局符号的下标 */
            align = 8;
            ent = 24;
        } else if (i == 6) {            /* .strtab */
            ty = OBJ_SHT_STRTAB;
            sz = str.b.n;
            off = off_str;
        } else if (i == 7) {            /* .shstrtab */
            ty = OBJ_SHT_STRTAB;
            sz = shstr.b.n;
            off = off_shstr;
        } else if (i == 8) {            /* .note.GNU-stack：空段，只为告诉链接器
                                         * "这个栈不用可执行" */
            ty = OBJ_SHT_PROGBITS;
        } else if (i == OBJ_SEC_INIT || i == OBJ_SEC_FINI) {
            /* 空表发成 SHT_NULL：GCC 编的普通 C `.o` 根本没有 .init_array，
             * 而带 ALLOC 的空 INIT_ARRAY 会被内核链接脚本当成 unplaced orphan
             * （CONFIG_LD_ORPHAN_WARN_LEVEL=error）直接拒链。索引不能删（后面
             * 的 .rela.sh_info 按常数指回），把 type 置 0、flag 清零即可让
             * 链接器忽略它；有构造函数时照旧发真正的 INIT_ARRAY。 */
            if (i == OBJ_SEC_INIT) {
                sz = init.n;
                off = off_init;
            } else {
                sz = fini.n;
                off = off_fini;
            }
            if (!sz) {
                ty = 0;                 /* SHT_NULL：链接器忽略 */
                align = 1;
            } else {
                ty = (i == OBJ_SEC_INIT) ? OBJ_SHT_INIT_ARRAY : OBJ_SHT_FINI_ARRAY;
                flags = OBJ_SHF_ALLOC | OBJ_SHF_WRITE;
                align = 8;
                ent = 8;
            }
        } else if (OBJ_DEBUG && (i == OBJ_SEC_DEBUG_ABBREV || i == OBJ_SEC_DEBUG_INFO
                                 || i == OBJ_SEC_DEBUG_LINE || i == OBJ_SEC_DEBUG_STR)) {
            ObjBuf *b = NULL;

            ty = OBJ_SHT_PROGBITS;
            if (i == OBJ_SEC_DEBUG_ABBREV) {
                b = dw_sec(DW_SEC_ABBREV);
                off = off_dbga;
            } else if (i == OBJ_SEC_DEBUG_INFO) {
                b = dw_sec(DW_SEC_INFO);
                off = off_dbgi;
            } else if (i == OBJ_SEC_DEBUG_LINE) {
                b = dw_sec(DW_SEC_LINE);
                off = off_dbgl;
            } else {
                b = dw_sec(DW_SEC_STR);
                off = off_dbgs;
            }
            sz = b ? b->n : 0;
            align = 1;
        } else if (OBJ_DEBUG && (i == OBJ_SEC_RELA_DBGI || i == OBJ_SEC_RELA_DBGL)) {
            ty = OBJ_SHT_RELA;
            if (i == OBJ_SEC_RELA_DBGI) {
                sz = dw_sec(DW_SEC_RELAI)->n;
                off = off_rela_dbgi;
                info = OBJ_SEC_DEBUG_INFO;
            } else {
                sz = dw_sec(DW_SEC_RELAL)->n;
                off = off_rela_dbgl;
                info = OBJ_SEC_DEBUG_LINE;
            }
            link = 5;                   /* .symtab */
            align = 8;
            ent = 24;
        } else if (i == OBJ_SEC_RELA_INIT || i == OBJ_SEC_RELA_FINI) {
            if (i == OBJ_SEC_RELA_INIT) {
                sz = relai.n;
                off = off_relai;
                info = OBJ_SEC_INIT;
            } else {
                sz = relaf.n;
                off = off_relaf;
                info = OBJ_SEC_FINI;
            }
            if (!sz) {
                ty = 0;                 /* 空表的重定位段同样是 SHT_NULL */
                info = 0;               /* NULL 段的 sh_info 必须是 0，否则 readelf 告警 */
                align = 1;
            } else {
                ty = OBJ_SHT_RELA;
                link = 5;               /* .symtab */
                align = 8;
                ent = 24;
            }
        }
        ob_u32(&f, sh_name[i]);
        ob_u32(&f, ty);
        ob_u64(&f, flags);
        ob_u64(&f, 0);                  /* sh_addr：可重定位文件里是 0 */
        ob_u64(&f, (u64)off);
        ob_u64(&f, sz);
        ob_u32(&f, link);
        ob_u32(&f, info);
        ob_u64(&f, align);
        ob_u64(&f, ent);
    }

    /* ELF 头 */
    ob_patch32(&f, 0, 0x464C457Fu);             /* \x7fELF */
    f.p[4] = 2;                                 /* ELFCLASS64 */
    f.p[5] = 1;                                 /* ELFDATA2LSB */
    f.p[6] = 1;                                 /* EV_CURRENT */
    ob_patch16(&f, 16, 1);                      /* e_type = ET_REL */
    ob_patch16(&f, 18, 0x3E);                   /* e_machine = EM_X86_64 */
    ob_patch32(&f, 20, 1);                      /* e_version */
    ob_patch64(&f, 24, 0);                      /* e_entry：可重定位文件没有入口 */
    ob_patch64(&f, 32, 0);                      /* e_phoff */
    ob_patch64(&f, 40, (u64)off_shdr);          /* e_shoff */
    ob_patch32(&f, 48, 0);                      /* e_flags */
    ob_patch16(&f, 52, ELF_EHDR);               /* e_ehsize */
    ob_patch16(&f, 54, 0);                      /* e_phentsize */
    ob_patch16(&f, 56, 0);                      /* e_phnum */
    ob_patch16(&f, 58, 64);                     /* e_shentsize */
    ob_patch16(&f, 60, OBJ_NSEC);               /* e_shnum */
    ob_patch16(&f, 62, OBJ_SEC_SHSTRTAB);       /* e_shstrndx */

    out = fopen(path, "wb");
    if (!out) {
        fprintf(stderr, "c6c: 无法写出 %s\n", path);
    } else {
        if (fwrite(f.p, 1, (size_t)f.n, out) != (size_t)f.n)
            fprintf(stderr, "c6c: 写入 %s 不完整\n", path);
        fclose(out);
        printf("c6c: %s（ET_REL：代码 %u 字节 / 数据 %u 字节 / 符号 %u 个 / "
               "重定位 %u 条）\n",
               path, CODE_IMG.n, DATA_IMG.n, all.n, (relat.n + relad.n) / 24u);
    }

    free(map);
    free(emit);
    free(pseudo_syms);
    free(seen);
    free(relat.p);
    free(relad.p);
    free(init.p);
    free(fini.p);
    free(relai.p);
    free(relaf.p);
    free(symtab.p);
    free(f.p);
    free(loc.e);
    free(glob.e);
    free(all.e);
    ob_str_free(&str);
    ob_str_free(&shstr);
}
