/* std/core/sparse：CSR 稀疏矩阵（构建、取值、SpMV、转置、行和）。
 *
 *     import std.core.sparse;
 *
 *     double val[16] = { 0 };
 *     int col[16] = { 0 };
 *     int ptr[5] = { 0 };
 *     Sparse s = { 0 };
 *     s.init(4, 4, val, col, ptr, 16);   // 方法：init / begin / add / end / spmv
 *     s.dense(m, 4, 4);                  // 或者直接从稠密矩阵建
 *     double x[4] = { 1, 1, 1, 1 }, y[4] = { 0 };
 *     s.spmv(x, y);                      // y = A·x
 *
 * CSR（压缩稀疏行）是稀疏矩阵最通用的存法：`ptr[r]..ptr[r+1]` 是第 r 行的区间，
 * `col[i]` 是列号、`val[i]` 是值。三块缓冲都由调用方给，模块不分配内存。
 *
 * 约定：
 *
 * - `s.init(rows, cols, val, col, ptr, cap)`：`val`/`col` 长度 `cap`，`ptr` 长度
 *   `rows + 1`；内部清零，`s.begin()` 之后才能 `add`；
 * - `s.begin()` 复位到第 0 行开头；`s.add(r, c, v)` 追加一个非零元，要求行号**不倒退**
 *   （同一行内列号可乱序，`get` 走线性查找），成功返回 1，容量不够或不按行序返回 -1；
 *   重复的 `(r,c)` 会各占一个位置（`get` 返回第一个）；
 * - `s.finish()` 收尾（补齐 `ptr` 尾部），`s.dense(m, rows, cols)` 直接从行主序稠密矩阵建；
 * - `s.get(r, c)` 取值（没有存就是 0），`s.spmv(x, y)` 做 `y = A·x`，返回 1；
 *   `s.spmv_t(x, y)` 做 `y = Aᵀ·x`；
 * - `s.rows()`/`s.cols()`/`s.nnz()`/`s.cap()`/`s.row_nnz(r)`/`s.row_sum(r)`；
 * - `s.transpose(val2, col2, ptr2, cap2)` 求转置（写进另外三块缓冲），返回新矩阵的 nnz；
 * - 索引 0 基；单线程无锁。
 */
#include <math.h>
#include <string.h>

module std.core.sparse;
import std.core.types;
import std.text.str;

struct Sparse {
    int nr;         /* 行数（字段名避开 rows()/cols()/nnz() 方法） */
    int nc;
    int cap;
    int nz;
    double *val;
    int *col;
    int *ptr;
    int cur;        /* 当前行（构建期游标） */
};

int init(Sparse *s, int rows, int cols, void *val, void *col, void *ptr, int cap)
{
    if (!s || rows <= 0 || cols <= 0 || !val || !col || !ptr || cap <= 0)
        return -1;
    memset(s, 0, sizeof *s);
    memset(val, 0, sizeof(double) * (size_t)cap);
    memset(col, 0, sizeof(int) * (size_t)cap);
    memset(ptr, 0, sizeof(int) * (size_t)(rows + 1));
    s->nr = rows;
    s->nc = cols;
    s->cap = cap;
    s->val = (double *)val;
    s->col = (int *)col;
    s->ptr = (int *)ptr;
    s->cur = 0;
    return 1;
}

int rows(Sparse *s)
{
    return s ? s->nr : 0;
}

int cols(Sparse *s)
{
    return s ? s->nc : 0;
}

int nnz(Sparse *s)
{
    return s ? s->nz : 0;
}

int cap_of(Sparse *s)
{
    return s ? s->cap : 0;
}

int row_nnz(Sparse *s, int r)
{
    if (!s || !s->ptr || r < 0 || r >= s->nr)
        return 0;
    return s->ptr[r + 1] - s->ptr[r];
}

int begin(Sparse *s)
{
    int i = 0;

    if (!s || !s->ptr)
        return -1;
    memset(s->val, 0, sizeof(double) * (size_t)s->cap);
    memset(s->col, 0, sizeof(int) * (size_t)s->cap);
    for (i = 0; i <= s->nr; i++)
        s->ptr[i] = 0;
    s->nz = 0;
    s->cur = 0;
    return 1;
}

int add(Sparse *s, int r, int c, double v)
{
    if (!s || !s->val || r < 0 || r >= s->nr || c < 0 || c >= s->nc)
        return -1;
    if (r < s->cur)
        return -1;                      /* 行号不能倒退 */
    if (s->nz >= s->cap)
        return -1;
    while (s->cur < r) {
        s->cur++;
        s->ptr[s->cur] = s->nz;
    }
    s->val[s->nz] = v;
    s->col[s->nz] = c;
    s->nz++;
    return 1;
}

int finish(Sparse *s)
{
    if (!s || !s->ptr)
        return -1;
    while (s->cur < s->nr) {
        s->cur++;
        s->ptr[s->cur] = s->nz;
    }
    s->ptr[s->nr] = s->nz;
    return s->nz;
}

int dense(Sparse *s, const double *m, int rows_n, int cols_n)
{
    int r = 0, c = 0;

    if (!s || !m)
        return -1;
    if (s->nr != rows_n || s->nc != cols_n)
        return -1;
    if (s->begin() != 1)
        return -1;
    for (r = 0; r < rows_n; r++) {
        for (c = 0; c < cols_n; c++) {
            double v = m[r * cols_n + c];

            if (v != 0.0) {
                if (s->add(r, c, v) != 1)
                    return -1;
            }
        }
    }
    return s->finish();
}

double get(Sparse *s, int r, int c)
{
    int i = 0;

    if (!s || !s->val || r < 0 || r >= s->nr || c < 0 || c >= s->nc)
        return 0.0;
    for (i = s->ptr[r]; i < s->ptr[r + 1]; i++) {
        if (s->col[i] == c)
            return s->val[i];
    }
    return 0.0;
}

double row_sum(Sparse *s, int r)
{
    double sum = 0.0;
    int i = 0;

    if (!s || !s->val || r < 0 || r >= s->nr)
        return 0.0;
    for (i = s->ptr[r]; i < s->ptr[r + 1]; i++)
        sum += s->val[i];
    return sum;
}

int spmv(Sparse *s, const double *x, double *y)
{
    int r = 0, i = 0;

    if (!s || !s->val || !x || !y)
        return -1;
    for (r = 0; r < s->nr; r++) {
        double sum = 0.0;

        for (i = s->ptr[r]; i < s->ptr[r + 1]; i++)
            sum += s->val[i] * x[s->col[i]];
        y[r] = sum;
    }
    return 1;
}

int spmv_t(Sparse *s, const double *x, double *y)
{
    int r = 0, i = 0;

    if (!s || !s->val || !x || !y)
        return -1;
    for (r = 0; r < s->nc; r++)
        y[r] = 0.0;
    for (r = 0; r < s->nr; r++) {
        for (i = s->ptr[r]; i < s->ptr[r + 1]; i++)
            y[s->col[i]] += s->val[i] * x[r];
    }
    return 1;
}

int transpose(Sparse *s, void *val2, void *col2, void *ptr2, int cap2)
{
    Sparse t = { 0 };
    int r = 0, i = 0;

    if (!s || !s->val || !val2 || !col2 || !ptr2 || cap2 < s->nz)
        return -1;
    /* 先数转置后每行的元素个数（用 ptr2 当计数器） */
    if (init(&t, s->nc, s->nr, val2, col2, ptr2, cap2) != 1)
        return -1;
    for (i = 0; i < s->nz; i++)
        t.ptr[s->col[i] + 1]++;
    for (r = 0; r < t.nr; r++)
        t.ptr[r + 1] += t.ptr[r];
    /* 用「下一个可写位置」填表：借用 val2 尾部做不到，改用一个游标数组 */
    {
        int cursor[128] = { 0 };
        int k = 0;

        if (t.nr > 127)
            return -1;
        for (r = 0; r < t.nr; r++)
            cursor[r] = t.ptr[r];
        for (r = 0; r < s->nr; r++) {
            for (i = s->ptr[r]; i < s->ptr[r + 1]; i++) {
                int c = s->col[i];
                int pos = cursor[c];

                t.val[pos] = s->val[i];
                t.col[pos] = r;
                cursor[c] = pos + 1;
                k++;
            }
        }
        t.nz = k;
    }
    return t.nz;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "sparse：构建、取值与 SpMV" {
    double val[16] = { 0 };
    int col[16] = { 0 };
    int ptr[4] = { 0 };
    Sparse s = { 0 };
    double m[9] = { 1, 0, 2, 0, 3, 0, 4, 0, 5 };
    double x[3] = { 1, 2, 3 };
    double y[3] = { 0, 0, 0 };

    if (s.init(3, 3, val, col, ptr, 16) != 1)
        return err(1, "init 失败");
    if (s.rows() != 3 || s.cols() != 3 || s.nnz() != 0 || s.cap_of() != 16)
        return err(2, "初始状态不对");
    if (s.begin() != 1)
        return err(3, "begin 失败");
    /* 手写 CSR：3x3 的 [[1,0,2],[0,3,0],[4,0,5]] */
    if (s.add(0, 0, 1) != 1 || s.add(0, 2, 2) != 1)
        return err(4, "第 0 行 add 失败");
    if (s.add(1, 1, 3) != 1)
        return err(5, "第 1 行 add 失败");
    if (s.add(2, 0, 4) != 1 || s.add(2, 2, 5) != 1)
        return err(6, "第 2 行 add 失败");
    if (s.finish() != 5)
        return err(7, "nnz 应该是 5");
    if (s.nnz() != 5 || s.row_nnz(0) != 2 || s.row_nnz(1) != 1)
        return err(8, "行非零个数不对");
    if (s.get(0, 2) != 2.0 || s.get(1, 0) != 0.0 || s.get(2, 2) != 5.0)
        return err(9, "get 取值不对");
    if (s.row_sum(2) != 9.0)
        return err(10, "行和不对");
    if (s.spmv(x, y) != 1)
        return err(11, "spmv 失败");
    /* A·[1,2,3] = [1+6, 6, 4+15] = [7,6,19] */
    if (fabs(y[0] - 7.0) > 1e-9 || fabs(y[1] - 6.0) > 1e-9
        || fabs(y[2] - 19.0) > 1e-9)
        return err(12, "spmv 结果不对");
    /* 与稠密矩阵互相印证 */
    (void)m;
}

test "sparse：稠密建表、转置与边界" {
    double val[16] = { 0 };
    int col[16] = { 0 };
    int ptr[4] = { 0 };
    Sparse s = { 0 };
    double m[6] = { 1, 0, 2, 0, 3, 0 };     /* 2 行 3 列 */
    double x[2] = { 2, 5 };
    double y[3] = { 0, 0, 0 };
    double v2[16] = { 0 };
    int c2[16] = { 0 };
    int p2[4] = { 0 };

    if (s.init(2, 3, val, col, ptr, 16) != 1)
        return err(13, "init 失败");
    if (s.dense(m, 2, 3) != 3)
        return err(14, "稠密建表 nnz 应该是 3");
    if (s.nnz() != 3 || s.row_nnz(0) != 2 || s.row_nnz(1) != 1)
        return err(15, "稠密建表的行非零数不对");
    /* Aᵀ·x：A 是 [[1,0,2],[0,3,0]]，x=(2,5) → [1*2, 3*5, 2*2] = [2, 15, 4] */
    if (s.spmv_t(x, y) != 1)
        return err(16, "spmv_t 失败");
    if (fabs(y[0] - 2.0) > 1e-9 || fabs(y[1] - 15.0) > 1e-9
        || fabs(y[2] - 4.0) > 1e-9)
        return err(17, "Aᵀx 结果不对");
    /* 转置：3 行 2 列 */
    if (s.transpose(v2, c2, p2, 16) != 3)
        return err(18, "转置 nnz 应该是 3");
    if (p2[0] != 0 || p2[1] != 1 || p2[2] != 2 || p2[3] != 3)
        return err(19, "转置的 ptr 不对");
    if (v2[0] != 1.0 || c2[0] != 0 || v2[2] != 2.0 || c2[2] != 0)
        return err(20, "转置的元素不对");
    /* 边界 */
    if (s.add(0, 0, 1) != -1)
        return err(21, "没有 begin 就 add 应该 -1（行号倒退）");
    if (s.get(9, 0) != 0.0 || s.get(0, 9) != 0.0)
        return err(22, "越界 get 应该 0");
    if (s.init(0, 3, val, col, ptr, 16) != -1)
        return err(23, "rows=0 应该 -1");
    {
        Sparse small = { 0 };
        double vv[2] = { 0 };
        int cc[2] = { 0 };
        int pp[3] = { 0 };

        small.init(2, 2, vv, cc, pp, 2);
        small.begin();
        small.add(0, 0, 1);
        small.add(0, 1, 1);
        if (small.add(1, 0, 1) != -1)
            return err(24, "容量不够应该 -1");
    }
}
