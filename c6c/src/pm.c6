/* pm.c6 —— c6c 的工程管理子命令（P0/P1：清单 + 扫描 + build/test/run）
 *
 * 由 c6c.c6 在 main.c6 之前 #include：所有符号用 pm_ 前缀，保持单 TU 的
 * C6-BOOT 子集（宿主 cc -x c 与 c6c 自举都能编）。
 *
 * 清单是 c6c.yaml 的一个**受控子集**：
 *
 *   name: hello
 *   version: 0.1.0
 *   kind: app              # app / lib / firmware
 *   out: build/hello
 *   sources:
 *     - src/main.c6
 *   include:
 *     - .
 *   flags:
 *     - -b
 *
 * 这里不引 std/data/yaml.c6：那是有 import 的模块，单 TU 引导链里用不了。
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <dirent.h>
#include <sys/stat.h>

#define PM_NOT_SUB (-1234)
#define PM_MAX_SRCS 160
#define PM_MAX_IMPS 160
#define PM_MAX_INCS 32
#define PM_MAX_FLAGS 32
#define PM_MAX_ARGS 256
#define PM_PATH 512
#define PM_FILE_CAP (1024 * 1024)

typedef struct {
    char name[128];
    char version[64];
    char kind[32];              /* app / lib / firmware */
    char out[PM_PATH];
    char src[PM_MAX_SRCS][PM_PATH];
    int nsrc;
    char imp[PM_MAX_IMPS][128];
    int nimp;
    char inc[PM_MAX_INCS][PM_PATH];
    int ninc;
    char flag[PM_MAX_FLAGS][128];
    int nflag;
    int has_main;
    int has_start;
    int has_test;
    /* 打包安装 / 固件烧录调试（P3/P4） */
    char pkg_name[128];
    char pkg_desc[256];
    char pkg_license[64];
    char pkg_fmt[8][16];
    int npkg_fmt;
    char pkg_file[32][1024];       /* "源:目标" */
    int npkg_file;
    char fw_fmt[8][16];
    int nfw_fmt;
    char flash[16][256];
    int nflash;
    char monitor[16][256];
    int nmonitor;
    char debug[16][256];
    int ndebug;
    char link_flag[16][128];
    int nlink_flag;
    /* cargo/go 习惯：安装落点 + profile（P5） */
    char destdir[128];
    char prefix[128];
    char dev_flag[16][128];
    int ndev_flag;
    char rel_flag[16][128];
    int nrel_flag;
} PmProject;

/* stage0（宿主 cc）没有 sys/wait.h 时不引整个头（c6c 自举的 #include 嵌套
 * 有 64 层上限，sys/wait.h → signal.h → ucontext.h 会踩到）；只补这几个宏。 */
#ifndef WIFEXITED
#define WIFEXITED(s) (((s) & 0x7f) == 0)
#define WEXITSTATUS(s) (((s) >> 8) & 0xff)
#define WIFSIGNALED(s) ((((s) & 0x7f) + 1) >> 1 > 0)
#define WTERMSIG(s) ((s) & 0x7f)
#endif
int waitpid(int pid, int *status, int options);

static void pm_zero_project(PmProject *p)
{
    memset(p, 0, sizeof(*p));
    strcpy(p->version, "0.1.0");
    strcpy(p->kind, "app");
    strcpy(p->out, "");
    strcpy(p->pkg_license, "MIT");
    strcpy(p->destdir, "pkg");
    strcpy(p->prefix, "/usr");
    strcpy(p->pkg_fmt[0], "tgz");
    p->npkg_fmt = 1;
    strcpy(p->fw_fmt[0], "elf");
    strcpy(p->fw_fmt[1], "bin");
    strcpy(p->fw_fmt[2], "hex");
    p->nfw_fmt = 3;
}

static const char *pm_rel(const char *path)
{
    if (path[0] == '.' && path[1] == '/')
        return path + 2;
    return path;
}

static void pm_trim(char *s)
{
    char *end = 0;
    char *p = s;
    while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')
        p++;
    if (p != s)
        memmove(s, p, strlen(p) + 1);
    end = s + strlen(s);
    while (end > s && (end[-1] == ' ' || end[-1] == '\t'
                       || end[-1] == '\r' || end[-1] == '\n'))
        *--end = 0;
    /* 行尾注释（清单里不写带 # 的值，这里只做最基本剥离） */
    p = s;
    while (*p) {
        if (*p == '#' && (p == s || p[-1] == ' ' || p[-1] == '\t')) {
            *p = 0;
            break;
        }
        p++;
    }
    end = s + strlen(s);
    while (end > s && (end[-1] == ' ' || end[-1] == '\t'))
        *--end = 0;
}

static int pm_read_file(const char *path, char *buf, size_t cap)
{
    FILE *fp = fopen(path, "rb");
    size_t n = 0;
    int c = 0;
    if (!fp)
        return -1;
    while (n + 1 < cap) {
        c = fgetc(fp);
        if (c == EOF)
            break;
        buf[n++] = (char)c;
    }
    fclose(fp);
    buf[n] = 0;
    return (int)n;
}

static int pm_ends(const char *s, const char *suf)
{
    size_t a = strlen(s), b = strlen(suf);
    if (b > a)
        return 0;
    return strcmp(s + a - b, suf) == 0;
}

static void pm_add_src(PmProject *p, const char *path)
{
    char buf[PM_FILE_CAP] = {0};
    int i = 0;
    if (p->nsrc >= PM_MAX_SRCS)
        return;
    for (i = 0; i < p->nsrc; i++) {
        if (strcmp(p->src[i], path) == 0)
            return;
    }
    strcpy(p->src[p->nsrc++], path);
    if (pm_read_file(path, buf, sizeof(buf)) < 0)
        return;
    if (strstr(buf, "int main(") || strstr(buf, "int main ("))
        p->has_main = 1;
    if (strstr(buf, "_start(") || strstr(buf, "_start ("))
        p->has_start = 1;
    if (strstr(buf, "test \""))
        p->has_test = 1;
    /* import NAME; → NAME，转换成 a.b 的点分形式 */
    {
        char *q = buf;
        while ((q = strstr(q, "import ")) != 0) {
            char *b = q + 7, *e = b;
            while (*e && *e != ';' && *e != ' ' && *e != '\t' && *e != '\n')
                e++;
            if (e > b && p->nimp < PM_MAX_IMPS) {
                int j = 0, dup = 0;
                size_t len = (size_t)(e - b);
                if (len >= sizeof(p->imp[0]))
                    len = sizeof(p->imp[0]) - 1;
                for (j = 0; j < p->nimp; j++) {
                    if (strlen(p->imp[j]) == len
                        && strncmp(p->imp[j], b, len) == 0) {
                        dup = 1;
                        break;
                    }
                }
                if (!dup) {
                    memcpy(p->imp[p->nimp], b, len);
                    p->imp[p->nimp][len] = 0;
                    p->nimp++;
                }
            }
            q = e;
            if (!*q)
                break;
        }
    }
}

static int pm_skip_dir(const char *name)
{
    if (name[0] == '.')
        return 1;
    if (strcmp(name, "build") == 0 || strcmp(name, "out") == 0
        || strcmp(name, "dist") == 0 || strcmp(name, "target") == 0
        || strcmp(name, "node_modules") == 0)
        return 1;
    return 0;
}

static void pm_scan_dir(PmProject *p, const char *dir, int depth)
{
    DIR *d = opendir(dir);
    struct dirent *e = (struct dirent *)0;
    if (!d || depth > 6)
        return;
    while ((e = readdir(d)) != (struct dirent *)0) {
        char path[PM_PATH] = {0};
        struct stat st = {0};
        if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0)
            continue;
        if (pm_skip_dir(e->d_name))
            continue;
        snprintf(path, sizeof(path), "%s/%s", dir, e->d_name);
        if (stat(path, &st) != 0)
            continue;
        if (S_ISDIR(st.st_mode)) {
            pm_scan_dir(p, path, depth + 1);
        } else if (S_ISREG(st.st_mode)) {
            if (pm_ends(e->d_name, ".c6") || pm_ends(e->d_name, ".c"))
                pm_add_src(p, path);
        }
    }
    closedir(d);
}

static void pm_scan(PmProject *p)
{
    char cwd[PM_PATH] = {0};
    char ver[PM_PATH] = {0};
    char *slash = (char *)0;
    pm_zero_project(p);
    if (getcwd(cwd, sizeof(cwd)))
        strcpy(p->name, cwd);
    slash = strrchr(p->name, '/');
    if (slash)
        memmove(p->name, slash + 1, strlen(slash + 1) + 1);
    pm_scan_dir(p, ".", 0);
    if (pm_read_file("VERSION", ver, sizeof(ver)) > 0) {
        char t[64] = {0};
        size_t n = strlen(ver);
        if (n > 0 && ver[n - 1] == '\n')
            ver[n - 1] = 0;
        if (strlen(ver) < sizeof(t)) {
            strcpy(t, ver);
            pm_trim(t);
            if (t[0])
                strcpy(p->version, t);
        }
    }
    strcpy(p->pkg_name, p->name);
    if (p->has_start && !p->has_main)
        strcpy(p->kind, "firmware");
    else if (p->has_test && !p->has_main)
        strcpy(p->kind, "lib");
    else
        strcpy(p->kind, "app");
    if (p->has_start && !p->has_main) {
        strcpy(p->flag[0], "-nostdlib");
        p->nflag = 1;
    }
    snprintf(p->out, sizeof(p->out), "build/%s", p->name);
}

static void pm_check_imports(const PmProject *p)
{
    int i = 0, j = 0, found = 0;
    for (i = 0; i < p->nimp; i++) {
        char want[PM_PATH] = {0};
        size_t k = 0;
        for (k = 0; k < strlen(p->imp[i]); k++)
            want[k] = p->imp[i][k] == '.' ? '/' : p->imp[i][k];
        found = 0;
        for (j = 0; j < p->nsrc; j++) {
            char rel[PM_PATH] = {0};
            const char *s = pm_rel(p->src[j]);
            snprintf(rel, sizeof(rel), "%s.c6", want);
            if (strcmp(s, rel) == 0 || pm_ends(s, rel)) {
                found = 1;
                break;
            }
            snprintf(rel, sizeof(rel), "%s.c", want);
            if (strcmp(s, rel) == 0 || pm_ends(s, rel)) {
                found = 1;
                break;
            }
        }
        if (!found)
            fprintf(stderr, "c6c: init: import %s 没有在仓库里找到对应源文件（请用 -I 或补源文件）\n",
                    p->imp[i]);
    }
}

static void pm_print_scan(const PmProject *p)
{
    int i = 0;
    printf("c6c: 扫描结果：name=%s version=%s kind=%s out=%s\n",
           p->name, p->version, p->kind, p->out);
    printf("c6c: 源文件 %d 个：\n", p->nsrc);
    for (i = 0; i < p->nsrc && i < 30; i++)
        printf("  - %s\n", pm_rel(p->src[i]));
    if (p->nsrc > 30)
        printf("  ... 另有 %d 个\n", p->nsrc - 30);
    printf("c6c: import %d 个，main=%d _start=%d test块=%d\n",
           p->nimp, p->has_main, p->has_start, p->has_test);
}

static int pm_write_yaml(const PmProject *p, const char *path)
{
    FILE *fp = fopen(path, "wb");
    int i = 0;
    if (!fp) {
        fprintf(stderr, "c6c: init: 写不出 %s\n", path);
        return 1;
    }
    fprintf(fp, "# 由 `c6c init` 生成；只支持本工具用的 YAML 子集\n");
    fprintf(fp, "name: %s\nversion: %s\nkind: %s\nout: %s\n",
            p->name, p->version, p->kind, p->out);
    fprintf(fp, "sources:\n");
    for (i = 0; i < p->nsrc; i++)
        fprintf(fp, "  - %s\n", pm_rel(p->src[i]));
    fprintf(fp, "include:\n  - .\n");
    fprintf(fp, "flags:\n");
    for (i = 0; i < p->nflag; i++)
        fprintf(fp, "  - %s\n", p->flag[i]);
    fprintf(fp, "pkg_name: %s\npkg_desc: %s\npkg_license: %s\n",
            p->pkg_name[0] ? p->pkg_name : p->name, p->pkg_desc, p->pkg_license);
    fprintf(fp, "# install 默认落点；发行版可用 DESTDIR=\$pkgdir c6c install 覆盖\n");
    fprintf(fp, "destdir: %s\nprefix: %s\n", p->destdir, p->prefix);
    fprintf(fp, "dev_flags:\nrelease_flags:\n");
    fprintf(fp, "pkg_formats:\n");
    for (i = 0; i < p->npkg_fmt; i++)
        fprintf(fp, "  - %s\n", p->pkg_fmt[i]);
    fprintf(fp, "pkg_files:\n");
    if (p->npkg_file == 0)
        fprintf(fp, "  - %s:bin/%s\n", p->out[0] ? p->out : "build/a.out", p->name);
    for (i = 0; i < p->npkg_file; i++)
        fprintf(fp, "  - %s\n", p->pkg_file[i]);
    if (strcmp(p->kind, "firmware") == 0) {
        fprintf(fp, "fw_formats:\n");
        for (i = 0; i < p->nfw_fmt; i++)
            fprintf(fp, "  - %s\n", p->fw_fmt[i]);
        fprintf(fp, "# flash_cmd / monitor_cmd / debug_cmd: 参数列表，支持 {elf} {bin} {out}\n");
        fprintf(fp, "flash_cmd:\nmonitor_cmd:\ndebug_cmd:\n");
        fprintf(fp, "# c6c 先 -c 出 ET_REL，再用 cc 链接；这里给 cc 的附加参数\n");
        fprintf(fp, "link_flags:\n");
    }
    fclose(fp);
    printf("c6c: init: 已写入 %s\n", path);
    return 0;
}

static void pm_unquote(char *s);
static int pm_spawn(char **av);

/* 自己切行：c6c 不认识 strtok，自举时不能用它。 */
static char *pm_next_line(char **cursor)
{
    char *s = *cursor;
    char *p = s;
    if (!s || !*s)
        return (char *)0;
    while (*p && *p != '\n')
        p++;
    if (*p == '\n') {
        *p = 0;
        *cursor = p + 1;
    } else {
        *cursor = p;
    }
    return s;
}

/* 只解析上面这个子集：顶层 key: value，缩进列表项 `- value`。 */
static int pm_load_yaml(const char *path, PmProject *p)
{
    char buf[PM_FILE_CAP] = {0};
    char *line = (char *)0;
    char *q = buf;
    int section = 0;            /* 0=顶层，1..10=各类列表 */
    if (pm_read_file(path, buf, sizeof(buf)) < 0)
        return -1;
    pm_zero_project(p);
    p->npkg_fmt = 0;           /* 清单里的 pkg_formats 覆盖默认 tgz */
    p->nfw_fmt = 0;
    line = pm_next_line(&q);
    while (line) {
        char t[PM_PATH] = {0};
        size_t n = strlen(line);
        if (n >= sizeof(t))
            n = sizeof(t) - 1;
        memcpy(t, line, n);
        t[n] = 0;
        pm_trim(t);
        if (t[0] == '-' && t[1] == ' ') {
            char val[PM_PATH] = {0};
            strcpy(val, t + 2);
            pm_trim(val);
            pm_unquote(val);
            if (section == 1 && p->nsrc < PM_MAX_SRCS)
                strcpy(p->src[p->nsrc++], val);
            else if (section == 2 && p->ninc < PM_MAX_INCS)
                strcpy(p->inc[p->ninc++], val);
            else if (section == 3 && p->nflag < PM_MAX_FLAGS)
                strcpy(p->flag[p->nflag++], val);
            else if (section == 4 && p->npkg_fmt < 8)
                strcpy(p->pkg_fmt[p->npkg_fmt++], val);
            else if (section == 5 && p->npkg_file < 32)
                strcpy(p->pkg_file[p->npkg_file++], val);
            else if (section == 6 && p->nfw_fmt < 8)
                strcpy(p->fw_fmt[p->nfw_fmt++], val);
            else if (section == 7 && p->nflash < 16)
                strcpy(p->flash[p->nflash++], val);
            else if (section == 8 && p->nmonitor < 16)
                strcpy(p->monitor[p->nmonitor++], val);
            else if (section == 9 && p->ndebug < 16)
                strcpy(p->debug[p->ndebug++], val);
            else if (section == 10 && p->nlink_flag < 16)
                strcpy(p->link_flag[p->nlink_flag++], val);
            else if (section == 11 && p->ndev_flag < 16)
                strcpy(p->dev_flag[p->ndev_flag++], val);
            else if (section == 12 && p->nrel_flag < 16)
                strcpy(p->rel_flag[p->nrel_flag++], val);
        } else if (strncmp(t, "name:", 5) == 0) {
            strcpy(p->name, t + 5); pm_trim(p->name); section = 0;
        } else if (strncmp(t, "version:", 8) == 0) {
            strcpy(p->version, t + 8); pm_trim(p->version); section = 0;
        } else if (strncmp(t, "kind:", 5) == 0) {
            strcpy(p->kind, t + 5); pm_trim(p->kind); section = 0;
        } else if (strncmp(t, "out:", 4) == 0) {
            strcpy(p->out, t + 4); pm_trim(p->out); section = 0;
        } else if (strcmp(t, "sources:") == 0) {
            section = 1;
        } else if (strcmp(t, "include:") == 0) {
            section = 2;
        } else if (strcmp(t, "flags:") == 0) {
            section = 3;
        } else if (strncmp(t, "pkg_name:", 9) == 0) {
            strcpy(p->pkg_name, t + 9); pm_trim(p->pkg_name); section = 0;
        } else if (strncmp(t, "pkg_desc:", 9) == 0) {
            strcpy(p->pkg_desc, t + 9); pm_trim(p->pkg_desc); section = 0;
        } else if (strncmp(t, "pkg_license:", 12) == 0) {
            strcpy(p->pkg_license, t + 12); pm_trim(p->pkg_license); section = 0;
        } else if (strncmp(t, "destdir:", 8) == 0) {
            strcpy(p->destdir, t + 8); pm_trim(p->destdir); section = 0;
        } else if (strncmp(t, "prefix:", 7) == 0) {
            strcpy(p->prefix, t + 7); pm_trim(p->prefix); section = 0;
        } else if (strcmp(t, "pkg_formats:") == 0) {
            section = 4;
        } else if (strcmp(t, "pkg_files:") == 0) {
            section = 5;
        } else if (strcmp(t, "fw_formats:") == 0) {
            section = 6;
        } else if (strcmp(t, "flash_cmd:") == 0) {
            section = 7;
        } else if (strcmp(t, "monitor_cmd:") == 0) {
            section = 8;
        } else if (strcmp(t, "debug_cmd:") == 0) {
            section = 9;
        } else if (strcmp(t, "link_flags:") == 0) {
            section = 10;
        } else if (strcmp(t, "dev_flags:") == 0) {
            section = 11;
        } else if (strcmp(t, "release_flags:") == 0) {
            section = 12;
        }
        line = pm_next_line(&q);
    }
    return 0;
}

static void pm_mkdir_p(const char *path)
{
    char cur[PM_PATH] = {0};
    char *p = (char *)path;
    if (*p == '/')
        strcpy(cur, "/");
    while (*p) {
        if (*p == '/' && cur[0] && cur[strlen(cur) - 1] != '/')
            strcat(cur, "/");
        else if (*p != '/')
            strncat(cur, p, 1);
        if (*p == '/' && strlen(cur) > 1)
            mkdir(cur, 0755);
        p++;
    }
    if (cur[0])
        mkdir(cur, 0755);
}

static void pm_unquote(char *s)
{
    size_t n = strlen(s);
    if (n >= 2 && ((s[0] == '"' && s[n - 1] == '"')
                   || (s[0] == '\'' && s[n - 1] == '\''))) {
        memmove(s, s + 1, n - 2);
        s[n - 2] = 0;
    }
}

static int pm_copy_file(const char *src, const char *dst)
{
    FILE *fi = fopen(src, "rb");
    FILE *fo = (FILE *)0;
    char parent[PM_PATH] = {0};
    char *slash = (char *)0;
    int c = 0;
    if (!fi) {
        fprintf(stderr, "c6c: 拷不到 %s\n", src);
        return 1;
    }
    strcpy(parent, dst);
    slash = strrchr(parent, '/');
    if (slash) {
        *slash = 0;
        pm_mkdir_p(parent);
    }
    fo = fopen(dst, "wb");
    if (!fo) {
        fprintf(stderr, "c6c: 写不出 %s\n", dst);
        fclose(fi);
        return 1;
    }
    while ((c = fgetc(fi)) != EOF)
        fputc(c, fo);
    fclose(fi);
    fclose(fo);
    {
        struct stat sm = {0};
        if (stat(src, &sm) == 0)
            chmod(dst, sm.st_mode & 0777);
    }
    return 0;
}

/* {elf} / {bin} / {out} / {name} / {version} 替换，用于 flash/monitor/debug 模板 */
static const char *pm_expand(const char *tpl, const PmProject *p,
                             const char *elf, const char *bin)
{
    static char buf[2048] = {0};
    size_t n = 0;
    const char *q = tpl;
    while (*q && n + 8 < sizeof(buf)) {
        if (strncmp(q, "{elf}", 5) == 0) {
            n += (size_t)snprintf(buf + n, sizeof(buf) - n, "%s", elf);
            q += 5;
        } else if (strncmp(q, "{bin}", 5) == 0) {
            n += (size_t)snprintf(buf + n, sizeof(buf) - n, "%s", bin);
            q += 5;
        } else if (strncmp(q, "{out}", 5) == 0) {
            n += (size_t)snprintf(buf + n, sizeof(buf) - n, "%s", p->out);
            q += 5;
        } else if (strncmp(q, "{name}", 6) == 0) {
            n += (size_t)snprintf(buf + n, sizeof(buf) - n, "%s", p->name);
            q += 6;
        } else if (strncmp(q, "{version}", 9) == 0) {
            n += (size_t)snprintf(buf + n, sizeof(buf) - n, "%s", p->version);
            q += 9;
        } else {
            buf[n++] = *q++;
        }
    }
    buf[n] = 0;
    return buf;
}

static int pm_run_template(char cmd[][256], int ncmd, const PmProject *p,
                           const char *elf, const char *bin, int dry)
{
    char *av[PM_MAX_ARGS] = {(char *)0};
    char expanded[16][2048] = {0};
    char binpath[PM_PATH] = {0};
    int i = 0;
    if (ncmd == 0) {
        fprintf(stderr, "c6c: 清单里没有配置命令模板（flash_cmd / monitor_cmd / debug_cmd）\n");
        return 2;
    }
    if (!bin[0])
        snprintf(binpath, sizeof(binpath), "%s.bin", elf);
    for (i = 0; i < ncmd && i + 1 < PM_MAX_ARGS; i++) {
        strcpy(expanded[i], pm_expand(cmd[i], p, elf, bin[0] ? bin : binpath));
        av[i] = expanded[i];
    }
    av[ncmd] = (char *)0;
    if (dry) {
        printf("c6c: 预览：");
        for (i = 0; i < ncmd; i++)
            printf(" %s", av[i]);
        printf("\n");
        return 0;
    }
    return pm_spawn(av);
}

static int pm_has_fmt(const char **fmts, int n, const char *want)
{
    int i = 0;
    for (i = 0; i < n; i++) {
        if (strcmp(fmts[i], want) == 0)
            return 1;
    }
    return 0;
}

static const char *pm_self(const char *argv0)
{
    static char buf[PM_PATH] = {0};
    ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
    if (n > 0) {
        buf[n] = 0;
        return buf;
    }
    if (argv0 && argv0[0])
        return argv0;
    return "c6c";
}

static int pm_status(int st)
{
    if (WIFEXITED(st))
        return WEXITSTATUS(st);
    if (WIFSIGNALED(st))
        return 128 + WTERMSIG(st);
    return 1;
}

/* 起一个进程并等它：返回子进程退出码；fork/exec 失败返回 2。 */
static int pm_spawn(char **av)
{
    int pid = fork();
    int st = 0;
    if (pid == 0) {
        execvp(av[0], av);
        _exit(127);
    }
    if (pid < 0 || waitpid(pid, &st, 0) < 0) {
        fprintf(stderr, "c6c: 无法执行 %s\n", av[0]);
        return 2;
    }
    return pm_status(st);
}

/* go.mod 风格：从当前目录向上找 c6c.yaml，返回相对路径并停在清单所在目录。 */
static int pm_find_up(char *buf, size_t cap)
{
    int up = 0, k = 0, j = 0;
    struct stat st = {0};
    const char *names[2] = {"c6c.yaml", "c6c.yml"};
    for (;;) {
        for (j = 0; j < 2; j++) {
            if (stat(names[j], &st) == 0) {
                size_t n = 0;
                for (k = 0; k < up; k++) {
                    if (n + 3 >= cap) return 0;
                    memcpy(buf + n, "../", 3);
                    n += 3;
                }
                snprintf(buf + n, cap - n, "%s", names[j]);
                return 1;
            }
        }
        if (up >= 8 || chdir("..") != 0)
            return 0;
        up++;
    }
}

static int pm_load(PmProject *p, const char *manifest)
{
    struct stat st = {0};
    if (stat(manifest, &st) == 0) {
        if (pm_load_yaml(manifest, p) == 0)
            return 0;
        fprintf(stderr, "c6c: %s 解析失败\n", manifest);
        return 1;
    }
    fprintf(stderr, "c6c: 找不到 %s，先用 `c6c init` 生成；本次按扫描结果构建\n", manifest);
    pm_scan(p);
    return 0;
}

static int pm_up_to_date(const PmProject *p)
{
    struct stat so = {0};
    struct stat ss = {0};
    int i = 0;
    if (stat(p->out, &so) != 0)
        return 0;
    for (i = 0; i < p->nsrc; i++) {
        if (stat(p->src[i], &ss) != 0 || ss.st_mtime > so.st_mtime)
            return 0;
    }
    return 1;
}

/* 固件目标的 BIN/HEX：c6c 出 ELF，objcopy 负责摊平（链接脚本场景仍用
 * examples/boot/flat.py；这里只做常规裸机镜像）。 */
static void pm_firmware_outputs(const PmProject *p)
{
    const char *fmts[8] = {0};
    int i = 0;
    char bin[PM_PATH] = {0}, hex[PM_PATH] = {0};
    for (i = 0; i < p->nfw_fmt && i < 8; i++)
        fmts[i] = p->fw_fmt[i];
    if (!pm_has_fmt(fmts, p->nfw_fmt, "bin") && !pm_has_fmt(fmts, p->nfw_fmt, "hex"))
        return;
    snprintf(bin, sizeof(bin), "%s.bin", p->out);
    snprintf(hex, sizeof(hex), "%s.hex", p->out);
    if (pm_has_fmt(fmts, p->nfw_fmt, "bin")) {
        char *av[5] = {(char *)0};
        av[0] = (char *)"objcopy"; av[1] = (char *)"-O"; av[2] = (char *)"binary";
        av[3] = p->out; av[4] = bin;
        if (pm_spawn(av) == 0)
            printf("c6c: 固件 %s 已生成\n", bin);
    }
    if (pm_has_fmt(fmts, p->nfw_fmt, "hex")) {
        char *av[5] = {(char *)0};
        av[0] = (char *)"objcopy"; av[1] = (char *)"-O"; av[2] = (char *)"ihex";
        av[3] = p->out; av[4] = hex;
        if (pm_spawn(av) == 0)
            printf("c6c: 固件 %s 已生成\n", hex);
    }
}

static int pm_build(PmProject *p, const char *self, int force, int release)
{
    char *av[PM_MAX_ARGS] = {(char *)0};
    int n = 0, i = 0, rc = 0;
    char parent[PM_PATH] = {0};
    char *slash = (char *)0;
    if (p->nsrc == 0) {
        fprintf(stderr, "c6c: build: 没有源文件\n");
        return 2;
    }
    if (!force && pm_up_to_date(p)) {
        printf("c6c: build: %s 已是最新（--force 强制重编）\n", p->out);
        return 0;
    }
    strcpy(parent, p->out[0] ? p->out : "build/a.out");
    slash = strrchr(parent, '/');
    if (slash) {
        *slash = 0;
        if (parent[0])
            pm_mkdir_p(parent);
    }
    av[n++] = (char *)self;
    av[n++] = (char *)"-o";
    av[n++] = p->out[0] ? p->out : "build/a.out";
    for (i = 0; i < p->ninc && n + 2 < PM_MAX_ARGS; i++) {
        av[n++] = (char *)"-I";
        av[n++] = p->inc[i];
    }
    for (i = 0; i < p->nflag && n + 1 < PM_MAX_ARGS; i++)
        av[n++] = p->flag[i];
    for (i = 0; release ? 0 : i < p->ndev_flag && n + 1 < PM_MAX_ARGS; i++)
        av[n++] = p->dev_flag[i];
    for (i = 0; !release ? 0 : i < p->nrel_flag && n + 1 < PM_MAX_ARGS; i++)
        av[n++] = p->rel_flag[i];
    for (i = 0; i < p->nsrc && n + 1 < PM_MAX_ARGS; i++)
        av[n++] = p->src[i];
    if (strcmp(p->kind, "firmware") == 0) {
        char obj[PM_PATH] = {0};
        char *oa[PM_MAX_ARGS] = {(char *)0};
        char *lv[PM_MAX_ARGS] = {(char *)0};
        int m = 0, k = 0;
        snprintf(obj, sizeof(obj), "%s.o", p->out);
        /* c6c 只认 main 当入口：固件走 -c 出 ET_REL，再交给 cc 链接
         * （link_flags 可给 -T 链接脚本等）。 */
        oa[k++] = (char *)self;
        oa[k++] = (char *)"-c";
        oa[k++] = (char *)"-o";
        oa[k++] = obj;
        for (i = 0; i < p->ninc && k + 2 < PM_MAX_ARGS; i++) {
            oa[k++] = (char *)"-I";
            oa[k++] = p->inc[i];
        }
        for (i = 0; i < p->nflag && k + 1 < PM_MAX_ARGS; i++)
            oa[k++] = p->flag[i];
        for (i = 0; release ? 0 : i < p->ndev_flag && k + 1 < PM_MAX_ARGS; i++)
            oa[k++] = p->dev_flag[i];
        for (i = 0; !release ? 0 : i < p->nrel_flag && k + 1 < PM_MAX_ARGS; i++)
            oa[k++] = p->rel_flag[i];
        for (i = 0; i < p->nsrc && k + 1 < PM_MAX_ARGS; i++)
            oa[k++] = p->src[i];
        rc = pm_spawn(oa);
        if (rc)
            return rc;
        lv[m++] = (char *)"cc";
        lv[m++] = (char *)"-nostdlib";
        lv[m++] = (char *)"-Wl,-e,_start";
        lv[m++] = (char *)"-o";
        lv[m++] = p->out;
        lv[m++] = obj;
        for (i = 0; i < p->nlink_flag && m + 1 < PM_MAX_ARGS; i++)
            lv[m++] = p->link_flag[i];
        rc = pm_spawn(lv);
        if (rc)
            return rc;
        pm_firmware_outputs(p);
        return 0;
    }
    av[n] = (char *)0;
    return pm_spawn(av);
}

static int pm_test(PmProject *p, const char *self)
{
    char *av[PM_MAX_ARGS] = {(char *)0};
    int n = 0, i = 0;
    if (!p->has_test && p->nsrc > 0) {
        /* 清单里 test 块可能来自没被 pm_add_src 读到的源文件，重新读一遍 */
        char buf[PM_FILE_CAP] = {0};
        for (i = 0; i < p->nsrc; i++) {
            if (pm_read_file(p->src[i], buf, sizeof(buf)) >= 0
                && strstr(buf, "test \"")) {
                p->has_test = 1;
                break;
            }
        }
    }
    if (!p->has_test) {
        printf("c6c: test: 没有找到 test 块\n");
        return 0;
    }
    av[n++] = (char *)self;
    av[n++] = (char *)"-test";
    for (i = 0; i < p->ninc && n + 2 < PM_MAX_ARGS; i++) {
        av[n++] = (char *)"-I";
        av[n++] = p->inc[i];
    }
    for (i = 0; i < p->nsrc && n + 1 < PM_MAX_ARGS; i++)
        av[n++] = p->src[i];
    av[n] = (char *)0;
    return pm_spawn(av);
}

static int pm_write_text(const char *path, const char *text)
{
    FILE *fp = fopen(path, "wb");
    if (!fp) {
        fprintf(stderr, "c6c: 写不出 %s\n", path);
        return 1;
    }
    fputs(text, fp);
    fclose(fp);
    return 0;
}

/* package：按 pkg_files 装一份 staging 树，再由 tar / dpkg-deb 出包。 */
static int pm_package(const PmProject *p)
{
    char stage[PM_PATH] = {0}, control[PM_PATH] = {0};
    char body[2048] = {0};
    char pkgname[128] = {0};
    const char *fmts[8] = {0};
    int i = 0, rc = 0;
    pm_mkdir_p("build");
    snprintf(pkgname, sizeof(pkgname), "%s-%s",
             p->pkg_name[0] ? p->pkg_name : p->name, p->version);
    snprintf(stage, sizeof(stage), "build/package/%s", pkgname);
    for (i = 0; i < p->npkg_file; i++) {
        char src[512] = {0}, dst[512] = {0}, full[PM_PATH] = {0};
        const char *colon = strchr(p->pkg_file[i], ':');
        if (!colon) {
            fprintf(stderr, "c6c: package: pkg_files 条目缺 ':'：%s\n", p->pkg_file[i]);
            return 2;
        }
        snprintf(src, sizeof(src), "%.*s", (int)(colon - p->pkg_file[i]), p->pkg_file[i]);
        snprintf(dst, sizeof(dst), "%s", colon + 1);
        snprintf(full, sizeof(full), "%s/%s", stage, dst);
        rc = pm_copy_file(src, full);
        if (rc)
            return rc;
    }
    for (i = 0; i < p->npkg_fmt && i < 8; i++)
        fmts[i] = p->pkg_fmt[i];
    if (pm_has_fmt(fmts, p->npkg_fmt, "deb")) {
        char arch[64] = "amd64";
        int word = (int)(sizeof(void *) * 8);
        if (word == 32)
            strcpy(arch, "i386");
        {
            char dir[PM_PATH] = {0};
            snprintf(dir, sizeof(dir), "%s/DEBIAN", stage);
            pm_mkdir_p(dir);
            snprintf(control, sizeof(control), "%s/control", dir);
        }
        snprintf(body, sizeof(body),
                 "Package: %s\nVersion: %s\nSection: utils\nPriority: optional\n"
                 "Architecture: %s\nMaintainer: %s contributors <%s@c6.local>\n"
                 "Description: %s\n",
                 p->pkg_name[0] ? p->pkg_name : p->name, p->version, arch,
                 p->pkg_name[0] ? p->pkg_name : p->name, p->name,
                 p->pkg_desc[0] ? p->pkg_desc : p->name);
        rc = pm_write_text(control, body);
        if (rc)
            return rc;
        {
            char *av[5] = {(char *)0};
            char out[PM_PATH] = {0};
            snprintf(out, sizeof(out), "build/%s.deb", pkgname);
            av[0] = (char *)"dpkg-deb"; av[1] = (char *)"--build";
            av[2] = stage; av[3] = out;
            rc = pm_spawn(av);
            if (rc == 0)
                printf("c6c: package: %s\n", out);
        }
    }
    if (pm_has_fmt(fmts, p->npkg_fmt, "tgz")) {
        char *av[7] = {(char *)0};
        char out[PM_PATH] = {0};
        snprintf(out, sizeof(out), "build/%s.tar.gz", pkgname);
        av[0] = (char *)"tar"; av[1] = (char *)"-czf"; av[2] = out;
        av[3] = (char *)"-C"; av[4] = stage; av[5] = (char *)".";
        rc = pm_spawn(av);
        if (rc == 0)
            printf("c6c: package: %s\n", out);
    }
    printf("c6c: package: staging 树在 %s\n", stage);
    return rc;
}

static int pm_install(const PmProject *p, const char *destdir, const char *prefix)
{
    int i = 0;
    char root[PM_PATH] = {0};
    for (i = 0; i < p->npkg_file; i++) {
        char src[512] = {0}, dst[512] = {0}, full[PM_PATH] = {0};
        const char *colon = strchr(p->pkg_file[i], ':');
        if (!colon) {
            fprintf(stderr, "c6c: install: pkg_files 条目缺 ':'：%s\n", p->pkg_file[i]);
            return 2;
        }
        snprintf(src, sizeof(src), "%.*s", (int)(colon - p->pkg_file[i]), p->pkg_file[i]);
        snprintf(dst, sizeof(dst), "%s", colon + 1);
        snprintf(root, sizeof(root), "%s%s%s", destdir, prefix, dst[0] == '/' ? "" : "/");
        snprintf(full, sizeof(full), "%s%s", root, dst[0] == '/' ? dst + 1 : dst);
        if (pm_copy_file(src, full) != 0)
            return 1;
        printf("c6c: install: %s -> %s\n", src, full);
    }
    return 0;
}

/* publish：package + SHA256SUMS；--tag 时再打一个 v<version> 注解 tag。 */
static int pm_publish(const PmProject *p, int tag, int dry)
{
    char name[128] = {0};
    char cmd[PM_PATH] = {0};
    char *av[4] = {(char *)0};
    int rc = 0;
    if (dry) {
        printf("c6c: publish: 预览（不打包、不打 tag）：c6c package → sha256sum → git tag v%s\n",
               p->version);
        return 0;
    }
    rc = pm_package(p);
    if (rc)
        return rc;
    snprintf(name, sizeof(name), "%s-%s", p->pkg_name[0] ? p->pkg_name : p->name, p->version);
    snprintf(cmd, sizeof(cmd), "cd build && sha256sum %s.tar.gz > SHA256SUMS", name);
    av[0] = (char *)"sh"; av[1] = (char *)"-c"; av[2] = cmd;
    rc = pm_spawn(av);
    if (rc)
        return rc;
    printf("c6c: publish: build/SHA256SUMS 已生成\n");
    if (tag) {
        char msg[256] = {0};
        snprintf(msg, sizeof(msg), "c6 %s", p->version);
        av[0] = (char *)"git"; av[1] = (char *)"tag"; av[2] = (char *)"-a";
        av[3] = (char *)0;
        /* 参数多于 4 个时重新搭一条 */
        {
            char *tav[7] = {(char *)0};
            char vtag[64] = {0};
            snprintf(vtag, sizeof(vtag), "v%s", p->version);
            tav[0] = (char *)"git"; tav[1] = (char *)"tag"; tav[2] = (char *)"-a";
            tav[3] = vtag; tav[4] = (char *)"-m"; tav[5] = msg;
            rc = pm_spawn(tav);
        }
        if (rc == 0)
            printf("c6c: publish: 已打 tag %s\n", p->version);
    }
    return rc;
}

/* cargo check 风格：只做语法检查，不落盘。 */
static int pm_check(const PmProject *p, const char *self)
{
    char *av[PM_MAX_ARGS] = {(char *)0};
    int n = 0, i = 0;
    av[n++] = (char *)self;
    av[n++] = (char *)"-fsyntax-only";
    for (i = 0; i < p->ninc && n + 2 < PM_MAX_ARGS; i++) {
        av[n++] = (char *)"-I";
        av[n++] = p->inc[i];
    }
    for (i = 0; i < p->nsrc && n + 1 < PM_MAX_ARGS; i++)
        av[n++] = p->src[i];
    av[n] = (char *)0;
    return pm_spawn(av);
}

static void pm_rm_rf(const char *path)
{
    DIR *d = opendir(path);
    struct dirent *e = (struct dirent *)0;
    if (!d) {
        unlink(path);
        return;
    }
    while ((e = readdir(d)) != (struct dirent *)0) {
        char child[PM_PATH] = {0};
        struct stat st = {0};
        if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0)
            continue;
        snprintf(child, sizeof(child), "%s/%s", path, e->d_name);
        if (stat(child, &st) == 0 && S_ISDIR(st.st_mode))
            pm_rm_rf(child);
        else
            unlink(child);
    }
    closedir(d);
    rmdir(path);
}

/* 只清本清单产出的文件，不删整个 build/（c6c/ 的 build/c6c 还在用）。 */
static int pm_clean(const PmProject *p, int dry)
{
    const char *sufs[4] = {"", ".o", ".bin", ".hex"};
    char stage[PM_PATH] = {0};
    int i = 0;
    for (i = 0; i < 4; i++) {
        char f[PM_PATH] = {0};
        snprintf(f, sizeof(f), "%s%s", p->out, sufs[i]);
        if (dry) {
            printf("c6c: clean 预览：rm -f %s\n", f);
        } else {
            unlink(f);
            printf("c6c: clean: %s\n", f);
        }
    }
    snprintf(stage, sizeof(stage), "build/package/%s-%s",
             p->pkg_name[0] ? p->pkg_name : p->name, p->version);
    {
        struct stat st = {0};
        if (stat(stage, &st) != 0)
            return 0;
    }
    if (dry)
        printf("c6c: clean 预览：rm -rf %s\n", stage);
    else
        pm_rm_rf(stage);
    return 0;
}

static void pm_list(const PmProject *p, int json)
{
    int i = 0;
    if (json) {
        printf("{\n  \"name\": \"%s\",\n  \"version\": \"%s\",\n"
               "  \"kind\": \"%s\",\n  \"out\": \"%s\",\n  \"sources\": [",
               p->name, p->version, p->kind, p->out);
        for (i = 0; i < p->nsrc; i++)
            printf("%s\"%s\"", i ? ", " : "", pm_rel(p->src[i]));
        printf("]\n}\n");
        return;
    }
    printf("%s %s (%s) -> %s\n", p->name, p->version, p->kind, p->out);
    for (i = 0; i < p->nsrc; i++)
        printf("%s\n", pm_rel(p->src[i]));
}

static void pm_help(void)
{
    printf("用法：c6c <子命令> [参数]\n"
           "\n"
           "  init [--force]  扫描当前仓库，生成 c6c.yaml\n"
           "  scan            只打印扫描结果，不写文件\n"
           "  build [--release] [--force]  按清单编译（mtime 增量，可选 profile）\n"
           "  test            编译并运行全部 `test \"…\" { }` 块\n"
           "  run [参数...]   先 build，再用参数运行产物\n"
           "  package         按 pkg_files / pkg_formats 打包（tgz / deb）\n"
           "  install         按 pkg_files 安装；认 DESTDIR / PREFIX 环境变量\n"
           "  check           只做语法检查（-fsyntax-only）\n"
           "  clean           只删本清单产物（不删整个 build/）\n"
           "  env / list      打印解析后的配置 / 源文件列表（list --json）\n"
           "  publish         打包 + SHA256SUMS，--tag 再打 v<version>\n"
           "  flash / monitor / debug  按 *_cmd 模板操作固件（--dry-run 预览）\n"
           "  help            打印本帮助\n"
           "\n"
           "向上找 c6c.yaml（go.mod 风格）；--manifest-path=... 可显式指定。\n"
           "清单格式：name/version/kind/out + sources/include/flags 三个列表，\n"
           "另有 destdir/prefix、dev_flags/release_flags。\n"
           "kind 由 init 按 main() / _start / test 块推断：app / firmware / lib。\n"
           "固件默认带 -nostdlib，build 会用 objcopy 追加 BIN/HEX；烧录调试用\n"
           "清单里的 flash_cmd / monitor_cmd / debug_cmd 模板（{elf}/{bin}/{out}）。\n");
}

int pm_dispatch(int argc, char **argv)
{
    PmProject p = {0};
    const char *cmd = (argc >= 2) ? argv[1] : "";
    const char *self = pm_self(argv[0]);
    const char *destdir = "pkg";
    const char *prefix = "/usr";
    const char *mpath = (const char *)0;
    char manifest[PM_PATH] = "c6c.yaml";
    char startcwd[PM_PATH] = {0};
    int dd_set = 0, px_set = 0, release = 0, json = 0;
    int force = 0, dry = 0, tag = 0, i = 0;
    int rc = 0;
    if (getcwd(startcwd, sizeof(startcwd)) == 0)
        startcwd[0] = 0;
    for (i = 2; i < argc; i++) {
        if (strcmp(argv[i], "--force") == 0)
            force = 1;
        else if (strcmp(argv[i], "--dry-run") == 0)
            dry = 1;
        else if (strcmp(argv[i], "--tag") == 0)
            tag = 1;
        else if (strncmp(argv[i], "--destdir=", 10) == 0) {
            destdir = argv[i] + 10;
            dd_set = 1;
        } else if (strncmp(argv[i], "--prefix=", 9) == 0) {
            prefix = argv[i] + 9;
            px_set = 1;
        } else if (strncmp(argv[i], "--manifest-path=", 16) == 0)
            mpath = argv[i] + 16;
        else if (strcmp(argv[i], "--release") == 0
                 || strcmp(argv[i], "--profile=release") == 0)
            release = 1;
        else if (strcmp(argv[i], "--profile=dev") == 0)
            release = 0;
        else if (strcmp(argv[i], "--json") == 0)
            json = 1;
    }

    if (strcmp(cmd, "help") == 0)
        return 0;
    if (strcmp(cmd, "scan") != 0 && strcmp(cmd, "init") != 0) {
        if (mpath) {
            char dir[PM_PATH] = {0};
            const char *slash = strrchr(mpath, '/');
            if (slash) {
                int n = (int)(slash - mpath);
                if (n > 0 && n < (int)sizeof(dir)) {
                    memcpy(dir, mpath, n);
                    dir[n] = 0;
                    if (chdir(dir) != 0) {
                        fprintf(stderr, "c6c: 进不了 %s\n", dir);
                        return 2;
                    }
                }
                snprintf(manifest, sizeof(manifest), "%s", slash + 1);
            } else {
                snprintf(manifest, sizeof(manifest), "%s", mpath);
            }
        } else if (!pm_find_up(manifest, sizeof(manifest))) {
            /* 没有清单时退回普通编译语义：保持在原目录，pm_load 会临时扫描 */
            if (startcwd[0])
                chdir(startcwd);
            snprintf(manifest, sizeof(manifest), "c6c.yaml");
        } else {
            /* find_up 已经 chdir 到清单所在目录，这里只留文件名 */
            char *slash = strrchr(manifest, '/');
            if (slash)
                memmove(manifest, slash + 1, strlen(slash + 1) + 1);
        }
    }
    if (strcmp(cmd, "scan") == 0) {
        pm_scan(&p);
        pm_check_imports(&p);
        pm_print_scan(&p);
        return 0;
    }
    if (strcmp(cmd, "init") == 0) {
        struct stat st = {0};
        if (!force && stat("c6c.yaml", &st) == 0) {
            fprintf(stderr, "c6c: init: c6c.yaml 已存在（--force 覆盖）\n");
            return 2;
        }
        pm_scan(&p);
        pm_check_imports(&p);
        pm_print_scan(&p);
        return pm_write_yaml(&p, "c6c.yaml");
    }
    if (strcmp(cmd, "build") == 0) {
        if (pm_load(&p, manifest) != 0)
            return 2;
        return pm_build(&p, self, force, release);
    }
    if (strcmp(cmd, "test") == 0) {
        if (pm_load(&p, manifest) != 0)
            return 2;
        return pm_test(&p, self);
    }
    if (strcmp(cmd, "run") == 0) {
        char *av[PM_MAX_ARGS] = {(char *)0};
        int i = 0;
        if (pm_load(&p, manifest) != 0)
            return 2;
        rc = pm_build(&p, self, force, release);
        if (rc != 0)
            return rc;
        av[0] = p.out[0] ? p.out : "build/a.out";
        for (i = 2; i < argc && i - 2 + 1 < PM_MAX_ARGS - 1; i++)
            av[i - 1] = argv[i];
        return pm_spawn(av);
    }
    if (strcmp(cmd, "package") == 0) {
        if (pm_load(&p, manifest) != 0)
            return 2;
        rc = pm_build(&p, self, force, release);
        return rc ? rc : pm_package(&p);
    }
    if (strcmp(cmd, "install") == 0) {
        const char *d = destdir, *pr = prefix;
        const char *env_d = getenv("DESTDIR");
        const char *env_p = getenv("PREFIX");
        if (pm_load(&p, manifest) != 0)
            return 2;
        if (!dd_set)
            d = env_d ? env_d : p.destdir;
        if (!px_set)
            pr = env_p ? env_p : p.prefix;
        rc = pm_build(&p, self, force, release);
        return rc ? rc : pm_install(&p, d, pr);
    }
    if (strcmp(cmd, "publish") == 0) {
        if (pm_load(&p, manifest) != 0)
            return 2;
        return pm_publish(&p, tag, dry);
    }
    if (strcmp(cmd, "check") == 0) {
        if (pm_load(&p, manifest) != 0)
            return 2;
        return pm_check(&p, self);
    }
    if (strcmp(cmd, "clean") == 0) {
        if (pm_load(&p, manifest) != 0)
            return 2;
        return pm_clean(&p, dry);
    }
    if (strcmp(cmd, "env") == 0) {
        char cwd[PM_PATH] = {0};
        if (pm_load(&p, manifest) != 0)
            return 2;
        if (getcwd(cwd, sizeof(cwd)))
            strcat(cwd, "/");
        printf("c6c_self=%s\nmanifest=%s%s\nname=%s\nversion=%s\n"
               "kind=%s\nout=%s\ndestdir=%s\nprefix=%s\nprofile=%s\n",
               self, cwd, manifest, p.name, p.version, p.kind, p.out,
               p.destdir, p.prefix, release ? "release" : "dev");
        return 0;
    }
    if (strcmp(cmd, "list") == 0) {
        if (pm_load(&p, manifest) != 0)
            return 2;
        pm_list(&p, json);
        return 0;
    }
    if (strcmp(cmd, "flash") == 0 || strcmp(cmd, "monitor") == 0
        || strcmp(cmd, "debug") == 0) {
        char bin[PM_PATH] = {0};
        if (pm_load(&p, manifest) != 0)
            return 2;
        snprintf(bin, sizeof(bin), "%s.bin", p.out);
        if (strcmp(cmd, "flash") == 0)
            return pm_run_template(p.flash, p.nflash, &p, p.out, bin, dry);
        if (strcmp(cmd, "monitor") == 0)
            return pm_run_template(p.monitor, p.nmonitor, &p, p.out, bin, dry);
        return pm_run_template(p.debug, p.ndebug, &p, p.out, bin, dry);
    }
    return PM_NOT_SUB;
}
