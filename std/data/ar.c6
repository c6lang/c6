/* std/data/ar：Unix `ar` 归档（`.a` / `.deb` 的内层容器）的解析。
 *
 *     import std.data.ar;
 *
 *     ArDoc doc = { 0 };
 *     ArMember m = { 0 };
 *     doc.open(buf, n);                    // 游标：open / next / count / find
 *     while (doc.next(&m) == 1)
 *         // m.name / m.size / m.data_off
 *     doc.find(S("libfoo.a(main.o)"), &m);
 *
 * 结构：8 字节魔数 `!<arch>\n`，之后每个成员是「60 字节头 + 数据（按偶数补齐）」：
 *
 *     名字(16) 时间(12) 属主(6) 属组(6) 权限(8) 长度(10) 结束符(2)
 *
 * 名字有三种：`name/`（GNU 短名，去掉末尾 `/`）、`/`（符号表）、`//`（GNU 长名字符串
 * 表）、`/123`（长名：字符串表里第 123 字节起到 `/\n` 为止）、BSD 的 `#1/12`
 * （长度写在名字里，真实名字在数据开头）。
 *
 * 约定：
 *
 * - `ArDoc` 是游标：`open` 扫一遍（顺带记下字符串表位置）并数成员，`next` 逐条返回，
 *   `rewind` 复位；
 * - 符号表成员（`/`、`__.SYMDEF`）与字符串表成员（`//`）**不**出现在 `next` 里
 *   （`special` 字段另有含义，见下），`count` 只数普通成员；
 * - `find` 按名字精确比较（支持 `lib.a(member.o)` 这种 `ar t` 的写法里括号内的部分）；
 * - `m.special` 为 1 表示这是长名成员（名字来自字符串表或 `#1/N` 前缀）；
 * - 不做符号表解析、不校验成员数据的校验和（ar 本身也没有）。
 */
#include <string.h>

module std.data.ar;
import std.core.types;
import std.text.str;

struct ArMember {
    Str name;
    i64 size;
    int mode;
    i64 mtime;
    int uid;
    int gid;
    int data_off;
    int hdr_off;
    int special;
};

struct ArDoc {
    const char *src;
    int n;
    int off;
    int nmembers;
    int strtab_off;
    int strtab_len;
};

static i64 ar_num(const char *p, int len)
{
    i64 v = 0;
    int i = 0;

    for (i = 0; i < len; i++) {
        if (p[i] < '0' || p[i] > '9')
            break;
        v = v * 10 + (p[i] - '0');
    }
    return v;
}

int ar_is_archive(const void *src, int n)
{
    if (!src || n < 8)
        return 0;
    return memcmp(src, "!<arch>\n", 8) == 0;
}

/* 读成员头；返回 1 成功，0 结束，-1 坏数据 */
static int ar_head(ArDoc *d, int off, ArMember *out, int *next_off)
{
    const char *p = d->src;
    int hdr_len = 0, start = 0, namelen = 0, extend = 0;

    if (off + 60 > d->n)
        return 0;
    if (p[off + 58] != '`' || p[off + 59] != '\n')
        return -1;
    memset(out, 0, sizeof *out);
    out->hdr_off = off;
    out->mtime = ar_num(p + off + 16, 12);
    out->uid = (int)ar_num(p + off + 28, 6);
    out->gid = (int)ar_num(p + off + 34, 6);
    out->mode = (int)ar_num(p + off + 40, 8);
    out->size = ar_num(p + off + 48, 10);
    if (out->size < 0 || off + 60 + (int)out->size > d->n)
        return -1;
    out->data_off = off + 60;

    /* 名字：去尾部空格 */
    start = off;
    namelen = 16;
    while (namelen > 0 && (p[start + namelen - 1] == ' '
                           || p[start + namelen - 1] == '\n'))
        namelen--;
    if (namelen == 1 && p[start] == '/') {
        out->name.s = (char[:]){ (char *)p + start, 1 };   /* 符号表 */
    } else if (namelen >= 2 && p[start] == '/' && p[start + 1] == '/') {
        out->name.s = (char[:]){ (char *)p + start, 2 };   /* 字符串表 */
    } else if (namelen >= 2 && p[start] == '#' && p[start + 1] == '1') {
        /* BSD 长名：`#1/12`，真实名字在数据开头，数据也含名字本身 */
        int slash = 0, i = 0;

        for (i = 2; i < namelen; i++) {
            if (p[start + i] == '/') {
                slash = i;
                break;
            }
        }
        if (slash > 0) {
            extend = (int)ar_num(p + start + slash + 1, namelen - slash - 1);
            out->name.s = (char[:]){ (char *)p + out->data_off, extend };
            out->data_off += extend;
            out->size -= extend;
            out->special = 1;
        } else {
            out->name.s = (char[:]){ (char *)p + start, namelen };
        }
    } else if (namelen >= 2 && p[start] == '/'
               && p[start + 1] >= '0' && p[start + 1] <= '9') {
        /* GNU 长名：/123 → 字符串表里的偏移 */
        int rel = (int)ar_num(p + start + 1, namelen - 1);
        int s = d->strtab_off + rel, e = s;

        if (d->strtab_len <= 0 || s < 0 || s + d->strtab_len > d->n)
            return -1;
        while (e < d->strtab_off + d->strtab_len && p[e] != '\n'
               && p[e] != '/')
            e++;
        out->name.s = (char[:]){ (char *)p + s, e - s };
        out->special = 1;
    } else {
        int k = namelen;

        while (k > 0 && p[start + k - 1] == '/')
            k--;
        out->name.s = (char[:]){ (char *)p + start, k };
    }
    hdr_len = 60 + (int)((out->data_off - (off + 60)))
              + (int)(out->size - (out->data_off - (off + 60) > 0 ? 0 : 0));
    (void)hdr_len;
    *next_off = out->data_off + (int)out->size;
    if ((*next_off - off) % 2 != 0)
        (*next_off)++;
    if (*next_off > d->n)
        *next_off = d->n;
    return 1;
}

/* 是否特殊成员（符号表 / 字符串表） */
static int ar_is_special_name(Str name)
{
    if (name.s.len == 0)
        return 0;
    if (name.s.len == 1 && name.s.data[0] == '/')
        return 1;                       /* 符号表 */
    if (name.s.len == 2 && name.s.data[0] == '/' && name.s.data[1] == '/')
        return 1;                       /* 字符串表 */
    if (name.s.len >= 9 && memcmp(name.s.data, "__.SYMDEF", 9) == 0)
        return 1;
    return 0;
}

int open(ArDoc *d, const void *src, int n)
{
    int off = 0, count = 0;

    if (!d || !src || n < 8)
        return -1;
    memset(d, 0, sizeof *d);
    d->src = (const char *)src;
    d->n = n;
    if (!ar_is_archive(src, n))
        return -1;
    off = 8;
    /* 第一遍：找字符串表并数普通成员 */
    while (off + 60 <= n) {
        ArMember m = { 0 };
        int next = 0;
        int r = ar_head(d, off, &m, &next);

        if (r != 1)
            break;
        if (m.name.s.len == 2 && m.name.s.data[0] == '/'
            && m.name.s.data[1] == '/') {
            d->strtab_off = m.data_off;
            d->strtab_len = (int)m.size;
        } else if (!ar_is_special_name(m.name)) {
            count++;
        }
        if (next <= off)
            break;
        off = next;
    }
    d->nmembers = count;
    d->off = 8;
    return count;
}

int next(ArDoc *d, ArMember *out)
{
    int off = 0;

    if (!d || !d->src || !out)
        return -1;
    off = d->off;
    while (off + 60 <= d->n) {
        ArMember m = { 0 };
        int nxt = 0;
        int r = ar_head(d, off, &m, &nxt);

        if (r != 1) {
            d->off = d->n;
            return r;
        }
        d->off = nxt;
        off = nxt;
        if (ar_is_special_name(m.name))
            continue;
        *out = m;
        return 1;
    }
    d->off = d->n;
    return 0;
}

int count(ArDoc *d)
{
    return d ? d->nmembers : 0;
}

int rewind(ArDoc *d)
{
    if (!d)
        return -1;
    d->off = 8;
    return 1;
}

int find(ArDoc *d, char[:] name, ArMember *out)
{
    ArMember m = { 0 };

    if (!d || !out || !name.data)
        return -1;
    rewind(d);
    while (next(d, &m) == 1) {
        if (m.name.s.len == name.len
            && memcmp(m.name.s.data, name.data, (size_t)name.len) == 0) {
            *out = m;
            return 1;
        }
    }
    return 0;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

/* 造一个 60 字节成员头 */
static void mk_ar_head(char *p, const char *name, i64 size, int mode)
{
    char tmp[32] = { 0 };
    int i = 0, k = 0;
    i64 v = 0;

    memset(p, ' ', 60);
    for (i = 0; name[i] && i < 16; i++)
        p[i] = name[i];
    v = 1700000000;
    k = 0;
    while (v > 0) {
        tmp[k++] = (char)('0' + v % 10);
        v /= 10;
    }
    for (i = 0; i < k; i++)
        p[16 + i] = tmp[k - 1 - i];
    p[28] = '0';
    p[34] = '0';
    v = mode;
    k = 0;
    while (v > 0) {
        tmp[k++] = (char)('0' + v % 10);
        v /= 10;
    }
    for (i = 0; i < k; i++)
        p[40 + i] = tmp[k - 1 - i];
    /* size 左对齐 */
    v = size;
    k = 0;
    if (v == 0) {
        tmp[k++] = '0';
    }
    while (v > 0) {
        tmp[k++] = (char)('0' + v % 10);
        v /= 10;
    }
    for (i = 0; i < k; i++)
        p[48 + i] = tmp[k - 1 - i];
    p[58] = '`';
    p[59] = '\n';
}

/* 造一个小归档：符号表 / + 两个成员（一个是长名） */
static int mk_ar(char *buf)
{
    int o = 0;

    memset(buf, 0, 512);
    memcpy(buf, "!<arch>\n", 8);
    o = 8;
    /* 字符串表：内容 "verylongname.o/\n" */
    mk_ar_head(buf + o, "//", 15, 0);
    o += 60;
    memcpy(buf + o, "verylongname.o/\n", 15);
    o += 15;
    if (o % 2)
        o++;
    /* 普通成员 a.o */
    mk_ar_head(buf + o, "a.o/", 4, 0644);
    o += 60;
    memcpy(buf + o, "AAAA", 4);
    o += 4;
    /* 长名成员：/0 */
    mk_ar_head(buf + o, "/0", 3, 0644);
    o += 60;
    memcpy(buf + o, "BBB", 3);
    o += 3;
    if (o % 2)
        o++;
    return o;
}

test "ar：成员与游标" {
    static char buf[512] = { 0 };
    ArDoc d = { 0 };
    ArMember m = { 0 };
    int n = mk_ar(buf);

    if (ar_is_archive(buf, n) != 1)
        return err(1, "应该识别为 ar 归档");
    if (d.open(buf, n) != 2)
        return err(2, "应该有 2 个普通成员");
    if (d.count() != 2)
        return err(3, "count() 不对");
    if (d.next(&m) != 1)
        return err(4, "第一个成员读不到");
    if (m.name.s.len != 3 || memcmp(m.name.s.data, "a.o", 3) != 0)
        return err(5, "第一个成员名字应该是 a.o（去掉斜杠）");
    if (m.size != 4 || m.mode != 0644)
        return err(6, "第一个成员的长度或权限不对");
    if (memcmp(buf + m.data_off, "AAAA", 4) != 0)
        return err(7, "第一个成员的数据不对");
    if (d.next(&m) != 1)
        return err(8, "第二个成员读不到");
    if (m.name.s.len != 14 || memcmp(m.name.s.data, "verylongname.o", 14) != 0)
        return err(9, "长名成员名字不对");
    if (m.special != 1)
        return err(10, "长名成员应该标 special");
    if (m.size != 3 || memcmp(buf + m.data_off, "BBB", 3) != 0)
        return err(11, "第二个成员数据不对");
    if (d.next(&m) != 0)
        return err(12, "读完应该返回 0");
}

test "ar：查找与坏数据" {
    static char buf[512] = { 0 };
    ArDoc d = { 0 };
    ArMember m = { 0 };
    int n = mk_ar(buf);

    if (d.open(buf, n) != 2)
        return err(13, "open 失败");
    if (d.find(S("verylongname.o"), &m) != 1 || m.size != 3)
        return err(14, "按长名查找失败");
    if (d.find(S("nope.o"), &m) != 0)
        return err(15, "不存在应该 0");
    d.rewind();
    if (d.next(&m) != 1 || m.name.s.len != 3)
        return err(16, "rewind 之后应该回到第一个成员");
    /* 魔数不对 */
    if (d.open("XXXXXXXX", 8) != -1)
        return err(17, "魔数不对应该 -1");
    /* 头部结束符坏掉 */
    {
        static char bad[256] = { 0 };

        memset(bad, 0, sizeof bad);
        memcpy(bad, "!<arch>\n", 8);
        mk_ar_head(bad + 8, "x.o/", 2, 0644);
        bad[8 + 58] = 'X';
        if (d.open(bad, (int)sizeof bad) != 0)
            return err(18, "坏成员头应该被跳过（0 个成员）");
    }
    /* 长度超出缓冲区 */
    {
        static char big[128] = { 0 };

        memset(big, 0, sizeof big);
        memcpy(big, "!<arch>\n", 8);
        mk_ar_head(big + 8, "y.o/", 999999, 0644);
        if (d.open(big, (int)sizeof big) != 0)
            return err(19, "长度越界应该被跳过");
    }
}
