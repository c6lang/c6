    if (TOK_EQ(t, "__builtin_abort") || TOK_EQ(t, "__builtin_trap")) {

        pa_advance();
        pa_expect_ch('(');
        pa_expect_ch(')');
        irfn_push(&FN, IR_TRAP, IRT_VOID, 0, 0, 0, 0, 0);
        GEN_TY = ty_void();
        return 0;
    }
    if (TOK_EQ(t, "__FUNCTION__") || TOK_EQ(t, "__func__") || TOK_EQ(t, "__PRETTY_FUNCTION__")) {
        u32 v = 0;

        pa_advance();
        v = gen_str_from(FN.name ? FN.name : "", FN.name ? (u32)strlen(FN.name) : 0);
        return gen_postfix_ops(v);
    }
    if (t->kind == TK_IDENT) {
        Sym *s = sym_find(tok_data(t), t->len);
        int break_qualified = 1;


        /* c6 的枚举限定名 `Color.RED`：名字里带点，不可能同时是变量或类型，
         * 所以先按 "Tag.成员" 整串查一次——**要在 `!s` 之前查**，
         * 因为 `enum Color` 会自动给 `Color` 建一个 typedef，`s` 非空，
         * 否则就会退到"取最后一段"，把 `Fruit.RED` 认成 `Color.RED`。 */
        if (pa_peek(1) && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ".")
            && pa_peek(2) && pa_peek(2)->kind == TK_IDENT) {
            char qn[256] = {0};
            u32 qk = t->len;
            Tok *q2 = pa_peek(2);

            if (qk + q2->len + 2 < sizeof(qn)) {
                Sym *qs = NULL;

                memcpy(qn, tok_data(t), qk);
                qn[qk++] = '.';
                memcpy(qn + qk, tok_data(q2), q2->len);
                qk += q2->len;
                qs = sym_find(qn, qk);
                if (qs) {
                    pa_advance();       /* Tag */
                    pa_advance();       /* . */
                    pa_advance();       /* 成员名 */
                    /* 枚举常量直接在这里出值：以前只吃两格、留给后面的
                     * "SC_ENUMC 分支再吃一格"，可那条路还带着 `t = pa_cur()`
                     * 重读当前 token 的逻辑，状态一乱就把后面的语句（典型是
                     * `switch`）解析崩掉。自己吃完三格最稳。 */
                    if (qs->kind == SC_ENUMC) {
                        u32 dv = irfn_vreg(&FN);


                        dv = gen_int_lit((u64)qs->val, ty_int());
                        GEN_TY = ty_int();
                        PEND_LVAL = 0;
                        PEND_BITS = 0;
                        PEND_BITOFF = 0;
                        return gen_postfix_ops(dv);
                    }
                    t = pa_cur();
                    s = qs;
                }
            }
        }
        /* c6 的模块限定名 `std.core.err.msg(rc)`：单 TU 文本导入下前缀只是
         * 命名空间装饰，真正要找的是最后一段。只在第一段没声明时才这么退，
         * 所以 `s.field` 之类照旧走成员访问。 */
        if (!s && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ".")
            && pa_peek(2) && pa_peek(2)->kind == TK_IDENT) {
            {
                char qn[256] = {0};
                u32 qk = t->len;
                Tok *q2 = pa_peek(2);

                if (q2 && qk + q2->len + 2 < sizeof(qn)) {
                    memcpy(qn, tok_data(t), qk);
                    qn[qk++] = '.';
                    memcpy(qn + qk, tok_data(q2), q2->len);
                    qk += q2->len;
                    s = sym_find(qn, qk);
                    if (s) {
