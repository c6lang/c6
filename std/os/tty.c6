/* std/os/tty：终端检测、窗口大小与原始模式（POSIX termios）。
 *
 *     import std.os.tty;
 *
 *     if (is_tty(0)) {
 *         int rows = 0, cols = 0;
 *         size(0, &rows, &cols);          // TIOCGWINSZ：终端多少行多少列
 *     }
 *
 *     TtyMode mode = { 0 };
 *     mode.raw(0);                        // 关掉行缓冲/回显/信号键
 *     defer mode.restore();
 *     char buf[16] = { 0 };
 *     read(0, buf, sizeof(buf));          // 现在按一个字节就能返回
 *
 * 这一层只包终端最常用的三件事：**这是不是终端**（`isatty`）、**窗口多大**
 * （`TIOCGWINSZ`/`TIOCSWINSZ`）、**原始模式**（`cfmakeraw` + `tcsetattr`，
 * 退出时要恢复）。用它在 CLI 里决定「要不要上色 / 画进度条 / 交互读按键」。
 *
 * 约定：
 *
 * - `is_tty(fd)` 是 `isatty` 的包装：普通文件、管道、socket 都返回 0。
 * - `size(fd, &rows, &cols)` 用 `TIOCGWINSZ` 取窗口大小，取不到返回 0（不动
 *   输出参数）；`width`/`height` 是只要一个的便捷入口，失败给 0。
 * - `set_size(fd, rows, cols)` 用 `TIOCSWINSZ` 改（主要给伪终端/测试用）。
 * - `TtyMode` 保存「进入原始模式之前」的整个 `termios`：`raw(fd)` 返回 1/0，
 *   `restore()` 恢复（重复 `restore` 返回 0，没有副作用），`is_active()` 查状态。
 *   对非终端调用 `raw` 会失败（`tcgetattr` 拿不到东西），不会改任何状态。
 * - 进程退出/崩溃时终端不会自动恢复，所以 `raw` 之后请用 `defer restore()`
 *   把恢复挂在同一条路径上；信号把程序打断时要么装信号处理（`std.os.signal`），
 *   要么在 `errdefer` 里也恢复一次。
 * - 只做本地终端，不做伪终端分配（`posix_openpt` 这类直接调 libc 即可）。
 */
#define _GNU_SOURCE 1

#include <errno.h>
#include <fcntl.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ioctl.h>
#include <termios.h>
#include <unistd.h>

module std.os.tty;
import std.core.types;

/* 是不是终端 */
int is_tty(int fd)
{
    return fd >= 0 && isatty(fd) != 0;
}

/* 窗口大小（行、列）；取不到返回 0，且不动 rows/cols */
int size(int fd, int *rows, int *cols)
{
    struct winsize ws = { 0 };

    if (fd < 0 || !rows || !cols)
        return 0;
    if (ioctl(fd, TIOCGWINSZ, &ws) != 0)
        return 0;
    *rows = (int)ws.ws_row;
    *cols = (int)ws.ws_col;
    return 1;
}

/* 列数；取不到 0 */
int width(int fd)
{
    int rows = 0, cols = 0;

    if (!size(fd, &rows, &cols))
        return 0;
    return cols;
}

/* 行数；取不到 0 */
int height(int fd)
{
    int rows = 0, cols = 0;

    if (!size(fd, &rows, &cols))
        return 0;
    return rows;
}

/* 设置窗口大小（伪终端/测试用）；成功 1 */
int set_size(int fd, int rows, int cols)
{
    struct winsize ws = { 0 };

    if (fd < 0 || rows <= 0 || cols <= 0)
        return 0;
    ws.ws_row = (unsigned short)rows;
    ws.ws_col = (unsigned short)cols;
    return ioctl(fd, TIOCSWINSZ, &ws) == 0;
}

/* 原始模式的状态：保存进入前的 termios，restore 时原样写回 */
struct TtyMode {
    struct termios saved;
    int fd;
    int active;
};

/* 进入原始模式：关掉行缓冲、回显与信号键（Ctrl-C 变成普通字节） */
int raw(TtyMode *self, int fd)
{
    struct termios t = { 0 };

    if (!self || fd < 0)
        return 0;
    if (tcgetattr(fd, &self->saved) != 0)
        return 0;
    memcpy(&t, &self->saved, sizeof(t));
    cfmakeraw(&t);
    if (tcsetattr(fd, TCSANOW, &t) != 0)
        return 0;
    self->fd = fd;
    self->active = 1;
    return 1;
}

/* 恢复 raw 之前的设置；没进过原始模式/重复恢复返回 0 */
int restore(TtyMode *self)
{
    if (!self || !self->active)
        return 0;
    if (tcsetattr(self->fd, TCSANOW, &self->saved) != 0)
        return 0;
    self->active = 0;
    return 1;
}

int is_active(TtyMode *self) { return self && self->active; }

/* ==== 测试 ==== */

test "非终端：isatty、size 与 raw 都失败" {
    int fds[2] = { -1, -1 };
    TtyMode mode = { 0 };
    int rows = 7, cols = 9;

    if (pipe(fds) != 0)
        return err(1, "pipe");
    if (is_tty(fds[0]) || is_tty(fds[1]))
        return err(2, "管道的两端都不是终端");
    if (is_tty(-1))
        return err(3, "无效 fd 不是终端");
    /* 失败时不能动输出参数 */
    if (size(fds[0], &rows, &cols) || rows != 7 || cols != 9)
        return err(4, "管道没有窗口大小");
    if (width(fds[0]) != 0 || height(fds[0]) != 0)
        return err(5, "管道宽高应当是 0");
    if (set_size(fds[0], 24, 80))
        return err(6, "管道设不了窗口大小");
    if (mode.raw(fds[0]) != 0 || mode.is_active())
        return err(7, "非终端进不了原始模式");
    if (mode.restore() != 0)
        return err(8, "没进过原始模式，restore 应当返回 0");
    close(fds[0]);
    close(fds[1]);
}

test "伪终端：检测、窗口大小与原始模式" {
    int master = posix_openpt(O_RDWR | O_NOCTTY);
    int slave = -1;
    char *name = 0;
    TtyMode mode = { 0 };
    int rows = 0, cols = 0;
    char buf[4] = { 0 };

    if (master < 0)
        return 0;                       /* 环境里没有 /dev/pts：跳过 */
    if (grantpt(master) != 0 || unlockpt(master) != 0)
        return err(1, "grantpt/unlockpt");
    name = ptsname(master);
    if (!name)
        return err(2, "ptsname");
    slave = open(name, O_RDWR | O_NOCTTY);
    if (slave < 0)
        return err(3, "打开从端");
    if (!is_tty(slave))
        return err(4, "从端应当是终端");
    if (!set_size(slave, 30, 100))
        return err(5, "设置窗口大小");
    if (!size(slave, &rows, &cols) || rows != 30 || cols != 100)
        return err(6, "读回来的窗口大小不对");
    if (width(slave) != 100 || height(slave) != 30)
        return err(7, "width/height");
    /* 原始模式：关掉行缓冲之后，写两个字节就能读到两个字节 */
    if (!mode.raw(slave))
        return err(8, "进入原始模式");
    if (!mode.is_active())
        return err(9, "raw 之后 is_active 应当是 1");
    if (write(master, "hi", 2) != 2)
        return err(10, "往主端写");
    if (read(slave, buf, 2) != 2 || buf[0] != 'h' || buf[1] != 'i')
        return err(11, "原始模式下应当立刻读到两个字节");
    if (!mode.restore())
        return err(12, "恢复终端设置");
    if (mode.is_active() || mode.restore())
        return err(13, "恢复之后不该还是 active");
    close(slave);
    close(master);
}
