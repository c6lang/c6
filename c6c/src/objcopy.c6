/* objcopy.c6 —— c6c 自带 objcopy 的最小子集（去 binutils 阶段 4 前置）。
 *
 * 覆盖内核构建的：
 *   objcopy -O binary <in.elf> <out.bin>      摊平 PT_LOAD 段为裸二进制
 *   objcopy -O binary -R .note -R .comment -S <in.elf> <out.bin>
 *     -R <sec>：把落在 PT_LOAD 内的该 section 字节清零；
 *     -S：去掉符号表（对 -O binary 输出无影响）。
 *
 * 算法（GNU objcopy -O binary）：
 *   1. 读 ELF header（支持 ELF32/ELF64 小端），取 e_phoff/e_phnum/e_phentsize。
 *   2. 收集所有 PT_LOAD（p_type=1），按 p_vaddr 升序。
 *   3. 最低 p_vaddr 当基址；每段的 p_filesz 字节拷到 out[vaddr-base ..]，
 *      空隙填 0。
 *   4. -R 指定 section 的区间清零（读 section headers + shstrtab 取名字）。
 *
 * 内核用法实测：setup.elf/realmode.elf 是 ELF32，vmlinux 是 ELF64——两种都支持。
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

#define MAXPH 512
#define MAXSEC 1024
#define MAXEXCL 32

struct Phdr { unsigned long vaddr, off, filesz, memsz; };
struct Shdr { char name[64]; unsigned long addr, off, size; };

static char *read_file(const char *path, long *out_size)
{
    int fd = open(path, O_RDONLY, 0);
    struct stat st = {0};
    char *p = 0;
    long n = 0, got = 0;

    if (fd < 0) return 0;
    if (fstat(fd, &st) < 0) { close(fd); return 0; }
    n = (long)st.st_size;
    p = (char *)malloc((size_t)n + 1);
    if (!p) { close(fd); return 0; }
    while (got < n) {
        long r = read(fd, p + got, (unsigned long)(n - got));
        if (r <= 0) break;
        got += r;
    }
    p[got] = 0;
    close(fd);
    if (out_size) *out_size = got;
    return p;
}

static unsigned long rd64(const char *p, int o)
{
    unsigned long v = 0;
    int i = 0;
    for (i = 7; i >= 0; i--)
        v = (v << 8) | (unsigned char)p[o + i];
    return v;
}
static unsigned int rd32(const char *p, int o)
{
    unsigned int v = 0;
    int i = 0;
    for (i = 3; i >= 0; i--)
        v = (v << 8) | (unsigned char)p[o + i];
    return v;
}
static unsigned short rd16(const char *p, int o)
{
    return (unsigned short)((unsigned char)p[o] | ((unsigned short)p[o + 1] << 8));
}

static void sort_phdr(struct Phdr *a, int n)
{
    int i = 0, j = 0;
    for (i = 0; i < n; i++)
        for (j = i + 1; j < n; j++)
            if (a[j].vaddr < a[i].vaddr) {
                struct Phdr t = a[i]; a[i] = a[j]; a[j] = t;
            }
}

int main(int argc, char **argv)
{
    char *elf = 0, *shstr = 0;
    long elfsz = 0;
    const char *in = 0, *out = 0;
    struct Phdr ph[MAXPH] = {{0}};
    struct Shdr sh[MAXSEC] = {{0}};
    const char *excl[MAXEXCL] = {0};
    int nph = 0, nsh = 0, nexcl = 0;
    int is64 = 0;
    unsigned long phoff = 0, shoff = 0, phentsz = 0, shentsz = 0;
    int phnum = 0, shnum = 0, shstrndx = 0;
    int i = 0, j = 0, binary = 0;
    unsigned long base = 0, total = 0, cursor = 0;
    char *img = 0;
    int fd = 0;

    for (i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "-O")) { i++; if (i < argc && !strcmp(argv[i], "binary")) binary = 1; }
        else if (!strcmp(argv[i], "-S")) { /* no-op for binary output */ }
        else if (!strcmp(argv[i], "-R") || !strcmp(argv[i], "--remove-section")) {
            if (i + 1 < argc && nexcl < MAXEXCL) excl[nexcl++] = argv[++i];
        } else if (argv[i][0] != '-' && !in) in = argv[i];
        else if (argv[i][0] != '-' && !out) out = argv[i];
    }
    if (!binary || !in || !out) {
        fprintf(stderr, "用法: objcopy -O binary [-R sec] <in.elf> <out.bin>\n");
        return 1;
    }
    elf = read_file(in, &elfsz);
    if (!elf || elfsz < 52) { fprintf(stderr, "objcopy: 无法读取 ELF\n"); return 1; }
    if ((unsigned char)elf[5] != 1) { fprintf(stderr, "objcopy: 只支持小端 ELF\n"); return 1; }
    if ((unsigned char)elf[4] == 2) is64 = 1;
    else if ((unsigned char)elf[4] != 1) { fprintf(stderr, "objcopy: 非法 ELF class\n"); return 1; }

    if (is64) {
        phoff = rd64(elf, 32); shoff = rd64(elf, 40);
        phentsz = rd16(elf, 54); phnum = rd16(elf, 56);
        shentsz = rd16(elf, 58); shnum = rd16(elf, 60); shstrndx = rd16(elf, 62);
    } else {
        phoff = rd32(elf, 28); shoff = rd32(elf, 32);
        phentsz = rd16(elf, 42); phnum = rd16(elf, 44);
        shentsz = rd16(elf, 46); shnum = rd16(elf, 48); shstrndx = rd16(elf, 50);
    }

    if (phnum > MAXPH) phnum = MAXPH;
    for (i = 0; i < phnum; i++) {
        int o = (int)(phoff + (unsigned long)i * phentsz);
        if (is64) {
            if (o + 56 > elfsz) break;
            if (rd32(elf, o) != 1) continue;
            ph[nph].off = rd64(elf, o + 8);
            ph[nph].vaddr = rd64(elf, o + 16);
            ph[nph].filesz = rd64(elf, o + 32);
            ph[nph].memsz = rd64(elf, o + 40);
        } else {
            if (o + 32 > elfsz) break;
            if (rd32(elf, o) != 1) continue;
            ph[nph].off = rd32(elf, o + 4);
            ph[nph].vaddr = rd32(elf, o + 8);
            ph[nph].filesz = rd32(elf, o + 16);
            ph[nph].memsz = rd32(elf, o + 20);
        }
        nph++;
    }
    if (!nph) { fprintf(stderr, "objcopy: 没有 PT_LOAD 段\n"); return 1; }
    sort_phdr(ph, nph);
    base = ph[0].vaddr;
    for (i = 0; i < nph; i++) {
        unsigned long end = ph[i].vaddr - base + ph[i].filesz;
        if (ph[i].off + ph[i].filesz > (unsigned long)elfsz) continue;
        if (end > total) total = end;
    }

    if (shoff && shnum && shentsz && shnum <= MAXSEC) {
        int sto = (int)(shoff + (unsigned long)shstrndx * shentsz);
        if (is64) {
            if (sto + 64 <= elfsz) shstr = elf + rd64(elf, sto + 24);
        } else {
            if (sto + 40 <= elfsz) shstr = elf + rd32(elf, sto + 16);
        }
        for (i = 0; i < shnum; i++) {
            int o = (int)(shoff + (unsigned long)i * shentsz);
            unsigned long no = 0;
            int need = is64 ? 64 : 40;
            if (o + need > elfsz) break;
            no = rd32(elf, o);
            if (shstr && no < (unsigned long)elfsz) {
                int k = 0;
                while (k < 63 && shstr[no + k] && shstr[no + k] != '/') { sh[i].name[k] = shstr[no + k]; k++; }
                sh[i].name[k] = 0;
            }
            if (is64) {
                sh[i].addr = rd64(elf, o + 16);
                sh[i].off = rd64(elf, o + 24);
                sh[i].size = rd64(elf, o + 32);
            } else {
                sh[i].addr = rd32(elf, o + 12);
                sh[i].off = rd32(elf, o + 16);
                sh[i].size = rd32(elf, o + 20);
            }
            nsh++;
        }
    }

    img = (char *)malloc((size_t)total + 1);
    if (!img) return 1;
    memset(img, 0, (size_t)total + 1);
    for (i = 0; i < nph; i++) {
        unsigned long dst = ph[i].vaddr - base;
        if (ph[i].off + ph[i].filesz > (unsigned long)elfsz) continue;
        memcpy(img + dst, elf + ph[i].off, (size_t)ph[i].filesz);
    }
    for (i = 0; i < nexcl; i++)
        for (j = 0; j < nsh; j++) {
            unsigned long s = 0, e = 0;
            if (strcmp(sh[j].name, excl[i])) continue;
            if (!sh[j].addr || !sh[j].size) continue;
            s = sh[j].addr - base;
            e = s + sh[j].size;
            if (s < total && e <= total) memset(img + s, 0, (size_t)(e - s));
        }

    fd = open(out, O_WRONLY | O_CREAT | O_TRUNC, 0755);
    if (fd < 0) { fprintf(stderr, "objcopy: 无法写输出\n"); return 1; }
    cursor = 0;
    while (cursor < total) {
        long w = write(fd, img + cursor, (unsigned long)(total - cursor));
        if (w <= 0) break;
        cursor += (unsigned long)w;
    }
    close(fd);
    printf("objcopy: %s -> %s (%lu bytes)\n", in, out, total);
    return 0;
}
