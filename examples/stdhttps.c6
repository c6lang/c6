/* examples/stdhttps.c6 —— 第八十二批（同步 HTTPS / 异步 HTTPS / 语言级 async 性能指标）。
 *
 *     make std-https
 *
 * 四节：
 *   1. tlskdf：从固定 ECDHE 共享密钥 + transcript hash 派生密钥，和参考值对比；
 *   2. 同步 HTTPS（std.net.https）：明文往返 + 走 TLS 记录层的往返；
 *   3. 异步 HTTPS（std.net.httpsa）：task 句柄驱动、co 顶层任务驱动；
 *   4. 性能指标（std.async.abench）：任务创建/驱动、一次挂起+恢复、co 批量调度。
 */
#include <stdio.h>
#include <string.h>
#include <unistd.h>

import std.core.types;
import std.text.str;
import std.net.tlskdf;
import std.net.tlsrec;
import std.net.https;
import std.net.httpsa;
import std.async.abench;

static int checks = 0;
static int nfail = 0;

static void check(int cond, const char *what)
{
    checks++;
    if (!cond) {
        nfail++;
        printf("   ✗ %s\n", what);
    }
}

static const char *resp_text =
    "HTTP/1.1 200 OK\r\n"
    "Content-Length: 13\r\n"
    "Content-Type: text/plain\r\n"
    "\r\n"
    "hello, https!";

static void do_kdf(void)
{
    Tls13 ks = { 0 };
    u8 ecdhe[32] = { 0 };
    u8 thash[32] = { 0 };
    u8 key[32] = { 0 };
    u8 iv[12] = { 0 };
    int i = 0;

    printf("== tlskdf\n");
    for (i = 0; i < 32; i++)
        ecdhe[i] = (u8)i;
    for (i = 0; i < 32; i++)
        thash[i] = (u8)(32 + i);
    check(ks.handshake(ecdhe, 32, thash, 32) == 1, "密钥调度");
    check(ks.client_key(key) == 1, "握手 client key");
    /* 参考实现的头 4 字节 */
    check(key[0] == 0x0f && key[1] == 0xab && key[2] == 0xd1 && key[3] == 0x70,
          "client key 与参考值一致");
    check(ks.client_iv(iv) == 1 && iv[0] == 0xcd && iv[1] == 0xee, "client iv 一致");
    printf("   握手 client key = %02x%02x%02x%02x…\n", key[0], key[1], key[2],
           key[3]);
    check(ks.app_client_key(key) == 1 && key[0] == 0xab, "应用期密钥");
    check(ks.verify_data(0, thash, 32, key) == 1 && key[0] == 0x46,
          "Finished verify_data");
}

static void do_sync_https(void)
{
    int req[2] = { -1, -1 };
    int resp[2] = { -1, -1 };
    char rbuf[1024] = { 0 };
    char out[64] = { 0 };
    Https h = { 0 };

    printf("== https（同步）\n");
    /* 明文 */
    if (pipe(req) != 0 || pipe(resp) != 0) {
        check(0, "pipe 失败");
        return;
    }
    h.attach(req[1], resp[0], 0, rbuf, (int)sizeof rbuf);
    write(resp[1], resp_text, (int)strlen(resp_text));
    check(h.request("GET", "example.com", "/", "", 0, 0) == 13, "body 13 字节");
    check(h.status() == 200, "状态码 200");
    check(h.header("Content-Type", out, (int)sizeof out) == 10, "Content-Type 长度");
    check(h.body(out, (int)sizeof out) == 13, "取 body");
    printf("   明文：%d %s\n", h.status(), out);
    h.close_conn();
    close(req[0]);
    close(resp[1]);
    /* 走 TLS 记录层 */
    {
        Tls13 ks = { 0 };
        u8 ecdhe[32] = { 0 };
        u8 thash[32] = { 0 };
        u8 ckey[32] = { 0 }, skey[32] = { 0 };
        u8 civ[12] = { 0 }, siv[12] = { 0 };
        u8 wire[1024] = { 0 };
        TlsRec srv = { 0 };
        Https h2 = { 0 };
        char rbuf2[1024] = { 0 };
        int rn = 0;
        int i = 0;

        for (i = 0; i < 32; i++)
            ecdhe[i] = (u8)(i * 5 + 3);
        for (i = 0; i < 32; i++)
            thash[i] = (u8)(0x40 + i);
        ks.handshake(ecdhe, 32, thash, 32);
        ks.app_client_key(ckey);
        ks.app_client_iv(civ);
        ks.app_server_key(skey);
        ks.app_server_iv(siv);
        if (pipe(req) != 0 || pipe(resp) != 0) {
            check(0, "pipe 失败");
            return;
        }
        srv.init();
        srv.set_key(skey, siv);
        rn = srv.encode(TLSREC_CT_APPDATA, resp_text, (int)strlen(resp_text), wire,
                        (int)sizeof wire);
        write(resp[1], wire, (size_t)rn);
        h2.attach(req[1], resp[0], 1, rbuf2, (int)sizeof rbuf2);
        h2.use_tls(ckey, civ, skey, siv);
        check(h2.request("GET", "secure.example", "/x", "", 0, 0) == 13,
              "加密响应 13 字节");
        check(h2.status() == 200, "加密响应状态码");
        check(h2.secure() == 1, "secure 标记");
        memset(out, 0, sizeof out);
        h2.body(out, (int)sizeof out);
        printf("   加密：%s\n", out);
        check(memcmp(out, "hello, https!", 13) == 0, "加密响应内容");
        h2.close_conn();
        close(req[0]);
        close(resp[1]);
    }
}

static void do_async_https(void)
{
    int req[2] = { -1, -1 };
    int resp[2] = { -1, -1 };
    char rbuf[1024] = { 0 };
    char out[64] = { 0 };
    HAsync h = { 0 };
    struct httpsa_get_task *t = 0;

    printf("== httpsa（异步）\n");
    if (pipe(req) != 0 || pipe(resp) != 0) {
        check(0, "pipe 失败");
        return;
    }
    h.attach(req[1], resp[0], 0, rbuf, (int)sizeof rbuf);
    write(resp[1], resp_text, (int)strlen(resp_text));
    t = httpsa_get(&h, "example.com", "/async");
    check(t != 0, "建任务");
    check(__c6_co_wait(t) == 0 && t->val == 13, "驱动到完成，body 13 字节");
    __c6_co_destroy(t);
    check(h.status() == 200, "状态码");
    memset(out, 0, sizeof out);
    h.body(out, (int)sizeof out);
    printf("   task：%d %s\n", h.status(), out);
    h.close_conn();
    close(req[0]);
    close(resp[1]);
    /* co 顶层任务：一个线程上同时挂两路，谁就绪谁跑 */
    {
        int q1[2] = { -1, -1 }, q2[2] = { -1, -1 };
        int r1[2] = { -1, -1 }, r2[2] = { -1, -1 };
        char b1[512] = { 0 };
        char b2[512] = { 0 };
        HAsync a = { 0 };
        HAsync b = { 0 };
        char out1[32] = { 0 };
        char out2[32] = { 0 };
        char small1[] = "HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\none";
        char small2[] = "HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\ntwo";

        if (pipe(q1) != 0 || pipe(r1) != 0 || pipe(q2) != 0 || pipe(r2) != 0) {
            check(0, "pipe 失败");
            return;
        }
        a.attach(q1[1], r1[0], 0, b1, (int)sizeof b1);
        b.attach(q2[1], r2[0], 0, b2, (int)sizeof b2);
        write(r1[1], small1, sizeof small1 - 1);
        write(r2[1], small2, sizeof small2 - 1);
        co httpsa_get(&a, "a.example", "/1");
        co httpsa_get(&b, "b.example", "/2");
        check(__c6_co_run() == 0, "co 批量跑完");
        check(a.status() == 200 && b.status() == 200, "两路都是 200");
        check(a.body_len() == 3 && b.body_len() == 3, "两路 body_len 都是 3");
        a.body(out1, (int)sizeof out1);
        b.body(out2, (int)sizeof out2);
        printf("   co：a=%s b=%s\n", out1, out2);
        check(memcmp(out1, "one", 3) == 0 && memcmp(out2, "two", 3) == 0,
              "两路 body 各归各的");
        a.close_conn();
        b.close_conn();
        close(q1[0]);
        close(r1[1]);
        close(q2[0]);
        close(r2[1]);
    }
}

static void do_bench(void)
{
    Bench b = { { 0 }, 0, 0, 0, 0, 0 };
    char line[192] = { 0 };
    int fds[2] = { -1, -1 };

    printf("== 性能指标（async 框架本身的开销）\n");
    if (b.run_null(3000) != 1) {
        check(0, "run_null");
        return;
    }
    b.report(line, (int)sizeof line);
    printf("   %s\n", line);
    check(b.ops() == 3000 && b.fail_count() == 0, "3000 次任务创建/驱动/回收");
    check(b.ns_per_op() >= 0 && b.ops_per_sec() > 0, "指标为正");
    if (pipe(fds) != 0) {
        check(0, "pipe 失败");
        return;
    }
    if (b.run_io(500, fds[0], fds[1]) != 1) {
        check(0, "run_io");
        return;
    }
    b.report(line, (int)sizeof line);
    printf("   %s\n", line);
    check(b.ops() == 500 && b.fail_count() == 0, "500 次挂起+恢复");
    if (b.run_co(500, fds[0], fds[1]) != 1) {
        check(0, "run_co");
        return;
    }
    b.report(line, (int)sizeof line);
    printf("   %s\n", line);
    check(b.ops() == 500 && b.fail_count() == 0, "500 次 co 批量调度");
    close(fds[0]);
    close(fds[1]);
}

int main(void)
{
    do_kdf();
    do_sync_https();
    do_async_https();
    do_bench();
    printf("\n%d check(s), %d failure(s)\n", checks, nfail);
    return nfail == 0 ? 0 : 1;
}
