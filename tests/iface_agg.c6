/* c6 自测：接口方法签名里的聚合类型
 *
 * 接口的方法列表按函数原型重放，所以参数和返回值都可以是 struct / union /
 * 元组：vtable 字段就是 `RET (*meth)(void *, PARAMS)`，调用点和普通方法调用
 * 走同一条路径。类型要在 interface 声明之前可见（见 docs/design/plan.md 的已知限制）。
 *
 * 运行（仓库根目录）：
 *   ./tcc/tcc -B tcc -test tests/iface_agg.c6
 */
struct P { int x, y; };
struct Q { int a, b, c; };          /* 12 字节：走寄存器返回 */
struct T { int base; };

interface Box {
    struct P mk(int x);
    int total(struct P p);
    struct Q big(int x);
}

interface PairBox {
    (int, int) pair(int x);
}

/* P 的方法：首参是接收者，其余部分与接口签名一致 */
struct P mk(struct P *self, int x)
{
    return (struct P){self->x + x, self->y + x};
}

int total(struct P *self, struct P p)
{
    return self->x + self->y + p.x + p.y;
}

struct Q big(struct P *self, int x)
{
    return (struct Q){self->x, self->y, x};
}

(int, int) pair(struct T *self, int x)
{
    return (int, int){self->base + x, self->base - x};
}

test "接口方法返回 struct" {
    struct P p = {1, 2};
    Box b = p;
    struct P q = b.mk(10);

    if (q.x != 11 || q.y != 12)
        return err(1, "struct 返回值不对");
}

test "接口方法接收 struct 参数" {
    struct P p = {1, 2};
    Box b = p;

    if (b.total((struct P){3, 4}) != 10)
        return err(1, "struct 参数没有传进去");
}

test "接口方法返回 12 字节 struct" {
    struct P p = {1, 2};
    Box b = p;
    struct Q q = b.big(7);

    if (q.a != 1 || q.b != 2 || q.c != 7)
        return err(1, "12 字节 struct 返回值不对");
}

test "接口方法返回元组" {
    struct T t = {10};
    PairBox b = t;
    (int m, int n) = b.pair(3);

    if (m != 13 || n != 7)
        return err(1, "元组返回值不对");
}
