From 718b329ff217bd6bee727f53fc4f3036794e47ba Mon Sep 17 00:00:00 2001
From: superc-agent <agent@localhost>
Date: Fri, 6 Nov 2026 18:46:44 +0800
Subject: [PATCH 6/7] superc: 'error' is return-only, reject it as a parameter

The error value travels back through the 'T!error' return channel (sentinel
value + global error slot), never through arguments, so declaring
'error' / 'error*' / 'error[]' as a parameter is now rejected in both
prototype and K&R parameter lists.  Local variables of type 'error' (as
declared by 'catch') keep working, and 'error' as a return type is still
allowed.

The new check lives in superc_check_error_param() and is wired into
post_type() (prototype parameters, including nested function-pointer
parameters) and decl() (old-style parameter declaration lists).

Tests: 164_superc_try_errors gains parameter / out-parameter / K&R cases.
---
 tccgen.c                                  | 26 +++++++++++++++++++++++
 tests/tests2/164_superc_try_errors.c      |  9 ++++++++
 tests/tests2/164_superc_try_errors.expect | 11 +++++++++-
 3 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/tccgen.c b/tccgen.c
index 465c4f6..e5808b9 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -168,6 +168,7 @@ static int superc_decl_fallible;
 
 static void superc_fallible_use(void);
 static int superc_parse_fallible_suffix(void);
+static void superc_check_error_param(CType *type);
 static void superc_defer_func_init(void);
 static void superc_defer_func_end(void);
 static void superc_defer_begin(int mode, int depth);
@@ -5250,6 +5251,9 @@ static int post_type(CType *type, AttributeDef *ad, int storage, int td)
                     type_decl(&pt, &ad1, &n, TYPE_DIRECT | TYPE_ABSTRACT | TYPE_PARAM);
                     if ((pt.t & VT_BTYPE) == VT_VOID)
                         tcc_error("parameter declared as void");
+#ifdef TCC_EXT
+                    superc_check_error_param(&pt);
+#endif
                     if (n == 0 || (td & TYPE_PARAM))
                         n |= SYM_FIELD;
                 } else {
@@ -10268,6 +10272,25 @@ static int superc_parse_fallible_suffix(void)
     return 1;
 }
 
+/* 'error' only ever leaves a function: it is the payload of the 'T!error'
+   return channel and is never passed as an argument.  Reject it in parameter
+   lists ('error*' and 'error[]' included, they would be out-parameters). */
+static void superc_check_error_param(CType *type)
+{
+    CType *t = type;
+    Sym *tag;
+
+    if (!tcc_state->superc_ext)
+        return;
+    if ((t->t & VT_BTYPE) == VT_PTR && t->ref)
+        t = pointed_type(t);
+    if ((t->t & VT_BTYPE) != VT_STRUCT || !t->ref)
+        return;
+    tag = struct_find(tok_alloc_const("__tcc_error"));
+    if (tag && t->ref == tag)
+        tcc_error("'error' can only be a return type, not a parameter");
+}
+
 /* Turn the '!error' annotation of TYPE into a property of the function. */
 static void superc_apply_fallible(CType *type)
 {
@@ -10394,6 +10417,9 @@ static int decl(int l)
             type_decl(&type, &ad, &v, l == VT_CMP ? TYPE_DIRECT | TYPE_PARAM : TYPE_DIRECT);
             /*ptype("decl", &type, v);*/
 #ifdef TCC_EXT
+            /* an old-style parameter declaration list ('void f(e) error e;') */
+            if (l == VT_CMP)
+                superc_check_error_param(&type);
             /* 'T f(...)!error' : the same annotation after the declarator */
             if (tcc_state->superc_ext && superc_parse_fallible_suffix())
                 fallible = 1;
diff --git a/tests/tests2/164_superc_try_errors.c b/tests/tests2/164_superc_try_errors.c
index ce8ed4f..2f28f19 100644
--- a/tests/tests2/164_superc_try_errors.c
+++ b/tests/tests2/164_superc_try_errors.c
@@ -33,6 +33,15 @@ int main(void) { return bad_ret().a; }
 #elif defined test_try_in_defer
 static int!error bad(void) { defer { try fails(0); } return 0; }
 int main(void) { return bad(); }
+#elif defined test_error_parameter
+static void take(error e) { }
+int main(void) { return 0; }
+#elif defined test_error_out_parameter
+static void take(error *e) { }
+int main(void) { return 0; }
+#elif defined test_error_parameter_knr
+static void take(e) error e; { }
+int main(void) { return 0; }
 #elif defined test_catch_in_defer
 static int!error bad(void) { defer { int v = fails(0) catch e { return -1; }; } return 0; }
 int main(void) { return bad(); }
diff --git a/tests/tests2/164_superc_try_errors.expect b/tests/tests2/164_superc_try_errors.expect
index 67e1cc7..0002534 100644
--- a/tests/tests2/164_superc_try_errors.expect
+++ b/tests/tests2/164_superc_try_errors.expect
@@ -28,5 +28,14 @@
 [test_try_in_defer]
 164_superc_try_errors.c:34: error: 'try' is not allowed in a defer body
 
+[test_error_parameter]
+164_superc_try_errors.c:37: error: 'error' can only be a return type, not a parameter
+
+[test_error_out_parameter]
+164_superc_try_errors.c:40: error: 'error' can only be a return type, not a parameter
+
+[test_error_parameter_knr]
+164_superc_try_errors.c:43: error: 'error' can only be a return type, not a parameter
+
 [test_catch_in_defer]
-164_superc_try_errors.c:37: error: 'catch' is not allowed in a defer body
+164_superc_try_errors.c:46: error: 'catch' is not allowed in a defer body
