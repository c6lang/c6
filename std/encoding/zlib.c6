/* std/encoding/zlib：zlib 容器格式（RFC 1950）与 Adler-32。
 *
 *     import std.encoding.zlib;
 *
 *     char packed[256] = { 0 };
 *     int n = zlib_compress(text, tlen, packed, (int)sizeof packed);
 *     char back[1024] = { 0 };
 *     int m = zlib_decompress(packed, n, back, (int)sizeof back);
 *
 * zlib 就是「2 字节头 + DEFLATE 流 + 4 字节 Adler-32（大端）」。这一层在
 * `std.encoding.deflate` 外面套壳并校验头和校验和；压缩侧用 `deflate_fixed`
 * （真的会压），解压侧能读 stored/固定/动态三种块。
 *
 * 约定：
 *
 * - 头是 `78 01`（CM=8、CINFO=7、FCHECK 让 `(CMF<<8|FLG) % 31 == 0`）；
 *   解压时检查方法/窗口/FCHECK，**不支持 FDICT**（预设字典返回 -1）；
 * - 校验和按 RFC 1950 的 Adler-32（模 65521），覆盖**解压后的数据**；
 * - 返回压缩/解压后的字节数，数据坏/校验和不符/输入截断/输出放不下返回 -1；
 * - 零分配：全部写调用方缓冲；`zlib_bound(n)` 给压缩侧的保守上界。
 */
#include <string.h>

module std.encoding.zlib;
import std.core.types;
import std.encoding.deflate;

#define ZLIB_ADLER_BASE 65521u

/* Adler-32：s1 = 1 + sum(bytes)，s2 = sum(s1)，最后 (s2<<16)|s1 */
u32 adler32(const void *p, usize n)
{
    const u8 *b = (const u8 *)p;
    u32 s1 = 1, s2 = 0;
    usize i = 0;

    if (!b)
        return 1;
    for (i = 0; i < n; i++) {
        s1 = (s1 + b[i]) % ZLIB_ADLER_BASE;
        s2 = (s2 + s1) % ZLIB_ADLER_BASE;
    }
    return (s2 << 16) | s1;
}

/* 增量版：传入上一次的 Adler-32（没有上一次就传 1） */
u32 adler32_update(u32 adler, const void *p, usize n)
{
    const u8 *b = (const u8 *)p;
    u32 s1 = adler & 0xffffu, s2 = (adler >> 16) & 0xffffu;
    usize i = 0;

    if (!b)
        return adler;
    for (i = 0; i < n; i++) {
        s1 = (s1 + b[i]) % ZLIB_ADLER_BASE;
        s2 = (s2 + s1) % ZLIB_ADLER_BASE;
    }
    return (s2 << 16) | s1;
}

int zlib_bound(int n)
{
    if (n < 0)
        return -1;
    return deflate_bound(n) + 6;
}

int zlib_compress(const void *in, int n, void *out, int cap)
{
    u8 *dst = (u8 *)out;
    int got = 0;
    u32 ad = 0;

    if ((!in && n > 0) || n < 0 || !out || cap < 6)
        return -1;
    dst[0] = 0x78;
    dst[1] = 0x01;
    got = deflate_fixed(in, n, dst + 2, cap - 6);
    if (got < 0)
        return -1;
    ad = adler32(in, (usize)n);
    dst[2 + got] = (u8)(ad >> 24);
    dst[3 + got] = (u8)(ad >> 16);
    dst[4 + got] = (u8)(ad >> 8);
    dst[5 + got] = (u8)ad;
    return got + 6;
}

int zlib_decompress(const void *in, int n, void *out, int cap)
{
    const u8 *src = (const u8 *)in;
    u32 want = 0, got = 0;
    int m = 0;
    int flg = 0;

    if (!in || n < 6 || !out || cap < 0)
        return -1;
    if ((src[0] & 0x0fu) != 8)
        return -1;                      /* CM 必须是 8（DEFLATE） */
    if ((src[0] >> 4) > 7)
        return -1;                      /* CINFO > 7 是非法窗口 */
    if ((((u32)src[0] << 8) | (u32)src[1]) % 31u != 0)
        return -1;
    flg = src[1];
    if (flg & 0x20)
        return -1;                      /* FDICT 不支持 */
    m = inflate(src + 2, n - 6, out, cap);
    if (m < 0)
        return -1;
    want = ((u32)src[n - 4] << 24) | ((u32)src[n - 3] << 16)
           | ((u32)src[n - 2] << 8) | (u32)src[n - 1];
    got = adler32(out, (usize)m);
    if (want != got)
        return -1;
    return m;
}

/* ---- 自测 ---- */

static int unhex(const char *s, u8 *dst, int cap)
{
    int n = 0, i = 0;

    while (s[0] && s[1] && n < cap) {
        int hi = -1, lo = -1;

        for (i = 0; i < 16; i++) {
            if ("0123456789abcdef"[i] == s[0])
                hi = i;
            if ("0123456789abcdef"[i] == s[1])
                lo = i;
        }
        if (hi < 0 || lo < 0)
            return -1;
        dst[n++] = (u8)(hi * 16 + lo);
        s += 2;
    }
    return n;
}

test "Adler-32 的已知值" {
    if (adler32("", 0) != 1u)
        return err(1, "空输入的 Adler-32 应该是 1");
    if (adler32("abc", 3) != 0x024d0127u)
        return err(2, "abc 的 Adler-32 不对");
    if (adler32("Wikipedia", 9) != 0x11e60398u)
        return err(3, "Wikipedia 的 Adler-32 不对");
    /* 增量与一次性一致 */
    {
        u32 a = adler32("hello ", 6);
        u32 b = adler32_update(a, "world", 5);

        if (b != adler32("hello world", 11))
            return err(4, "增量 Adler-32 不对");
        if (adler32_update(1, 0, 0) != 1u)
            return err(5, "空增量的 Adler-32 不对");
    }
}

test "zlib 压缩/解压与错误路径" {
    char text[400] = { 0 };
    u8 packed[1024] = { 0 };
    u8 back[1024] = { 0 };
    u8 vec[128] = { 0 };
    int i = 0, n = 0, m = 0;

    for (i = 0; i < 400; i++)
        text[i] = (char)('a' + i % 17);
    n = zlib_compress(text, 400, packed, (int)sizeof packed);
    if (n <= 0 || n >= 400)
        return err(6, "zlib_compress 失败或没压缩");
    if (packed[0] != 0x78 || packed[1] != 0x01)
        return err(7, "zlib 头不对");
    m = zlib_decompress(packed, n, back, (int)sizeof back);
    if (m != 400 || memcmp(back, text, 400) != 0)
        return err(8, "zlib 往返失败");
    /* Python zlib.compress 的 200 字节文本向量 */
    n = unhex("789ccb48cdc9c957c8402775145252d372124b5215caf38b72521431550c"
              "32750058b347c3",
              vec, (int)sizeof vec);
    m = zlib_decompress(vec, n, back, (int)sizeof back);
    if (m != 200
        || memcmp(back, "hello hello hello hello, deflate world! ", 40) != 0)
        return err(9, "外部 zlib 向量解压不对");
    /* 空输入 */
    n = zlib_compress(0, 0, packed, (int)sizeof packed);
    if (n <= 0 || zlib_decompress(packed, n, back, (int)sizeof back) != 0)
        return err(10, "空输入的往返失败");
    /* 校验和坏 */
    {
        u8 copy[128] = { 0 };

        n = zlib_compress("abcdef", 6, packed, (int)sizeof packed);
        memcpy(copy, packed, (size_t)n);
        copy[n - 1] ^= 0x01;
        if (zlib_decompress(copy, n, back, (int)sizeof back) != -1)
            return err(11, "校验和不对应该 -1");
        /* 头坏：FCHECK 不对 */
        memcpy(copy, packed, (size_t)n);
        copy[1] ^= 0x01;
        if (zlib_decompress(copy, n, back, (int)sizeof back) != -1)
            return err(12, "FCHECK 不对应该 -1");
        /* CM 不是 8 */
        memcpy(copy, packed, (size_t)n);
        copy[0] = 0x79;
        if (zlib_decompress(copy, n, back, (int)sizeof back) != -1)
            return err(13, "CM 不是 8 应该 -1");
    }
    /* 截断与容量 */
    n = zlib_compress(text, 100, packed, (int)sizeof packed);
    if (zlib_decompress(packed, n - 1, back, (int)sizeof back) != -1)
        return err(14, "截断应该 -1");
    if (zlib_decompress(packed, n, back, 8) != -1)
        return err(15, "输出放不下应该 -1");
    if (zlib_compress(text, 100, packed, 4) != -1
        || zlib_compress(0, 4, packed, 32) != -1
        || zlib_decompress(0, 8, back, 8) != -1)
        return err(16, "坏参数应该 -1");
    if (zlib_bound(100) <= 100)
        return err(17, "bound 应该大于输入");
}
