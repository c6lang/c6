/* std/data/lrc：LRC 歌词（`[mm:ss.xx]文本`）的解析与生成。
 *
 *     import std.data.lrc;
 *
 *     LrcDoc doc = { 0 };
 *     LrcLine line = { 0 };
 *     doc.open(buf, n);                 // 游标方法：open / next / count / tag
 *     while (doc.next(&line) == 1)
 *         // line.time_ms / line.text
 *
 * 元信息行是 `[标签:内容]`：`[ti:标题]`、`[ar:艺术家]`、`[al:专辑]`、`[by:制作者]`、
 * `[offset:+/-毫秒]`。歌词行是一个或多个 `[mm:ss.xx]` 前缀加文本。
 *
 * 约定：
 *
 * - `LrcDoc` 是**游标**：`open` 扫一遍数行数并读 `offset`，`next` 逐条返回，
 *   `rewind` 复位，`count` 给行的总数（不含元信息）；
 * - `tag(doc, "ti")` 返回元信息值（不含方括号与标签），没有返回长度为 0 的串；
 * - `offset` 会加到每条的 `time_ms` 上（正数表示歌词整体延后）；
 * - 一行有多个时间标签时只取**第一个**（其余忽略，文档写明）；
 * - `lrc_time_parse` 认 `[mm:ss]`、`[mm:ss.x]`、`[mm:ss.xx]`、`[mm:ss.xxx]`；
 * - `lrc_time_format` 输出 `[mm:ss.xx]`（百分秒）；分钟可以超过 60。
 */
#include <string.h>

module std.data.lrc;
import std.core.types;
import std.text.str;

struct LrcLine {
    i64 time_ms;
    Str text;
};

struct LrcDoc {
    const char *src;
    int n;
    int off;
    int nlines;
    int extended;
    i64 offset_ms;
};

static int lrc_digit(char c)
{
    return c >= '0' && c <= '9';
}

int lrc_time_parse(char[:] src, i64 *ms)
{
    const char *p = src.data;
    int n = src.len, i = 0;
    i64 m = 0, s = 0, frac = 0;
    int mul = 100, digits = 0;

    if (!src.data || !ms || n <= 0)
        return -1;
    while (i < n && (p[i] == '[' || p[i] == ' '))
        i++;
    while (i < n && lrc_digit(p[i])) {
        m = m * 10 + (p[i] - '0');
        digits++;
        i++;
    }
    if (!digits || i >= n || p[i] != ':')
        return -1;
    i++;
    digits = 0;
    while (i < n && lrc_digit(p[i])) {
        s = s * 10 + (p[i] - '0');
        digits++;
        i++;
    }
    if (!digits)
        return -1;
    if (i < n && p[i] == '.') {
        int d = 0;

        i++;
        while (i < n && lrc_digit(p[i]) && mul > 0) {
            frac += (p[i] - '0') * mul;
            mul /= 10;
            d++;
            i++;
        }
        if (d == 0)
            return -1;
    }
    *ms = m * 60000 + s * 1000 + frac;
    return 1;
}

int lrc_time_format(i64 ms, char *dst, int cap)
{
    i64 v = ms < 0 ? 0 : ms;
    i64 m = v / 60000;
    int s = (int)((v % 60000) / 1000);
    int cs = (int)((v % 1000) / 10);
    char buf[32] = { 0 };
    int k = 0, i = 0;
    char tmp[24] = { 0 };
    int t = 0;

    if (!dst || cap <= 0)
        return -1;
    /* 分钟至少两位（[mm:ss.xx]），超过 99 就自然变长 */
    {
        i64 mm = m;

        do {
            tmp[t++] = (char)('0' + (int)(mm % 10));
            mm /= 10;
        } while (mm > 0);
        while (t < 2 && t < 20)
            tmp[t++] = '0';
    }
    for (i = t - 1; i >= 0; i--)
        buf[k++] = tmp[i];
    buf[k++] = ':';
    buf[k++] = (char)('0' + s / 10);
    buf[k++] = (char)('0' + s % 10);
    buf[k++] = '.';
    buf[k++] = (char)('0' + cs / 10);
    buf[k++] = (char)('0' + cs % 10);
    if (k + 2 > cap)
        return -1;
    /* 加上方括号 */
    {
        char out[40] = { 0 };
        int o = 0;

        out[o++] = '[';
        for (i = 0; i < k; i++)
            out[o++] = buf[i];
        out[o++] = ']';
        if (o >= cap)
            return -1;
        for (i = 0; i < o; i++)
            dst[i] = out[i];
        dst[o] = 0;
        return o;
    }
}

static int lrc_lineat(const char *p, int n, int *pos, int *start, int *len)
{
    int i = *pos;

    if (i >= n)
        return 0;
    *start = i;
    while (i < n && p[i] != '\n')
        i++;
    *len = i - *start;
    if (*len > 0 && p[*start + *len - 1] == '\r')
        (*len)--;
    if (i < n)
        i++;
    *pos = i;
    return 1;
}

Str tag(LrcDoc *d, const char *name)
{
    const char *p = 0;
    int nlen = 0, pos = 0, start = 0, len = 0;

    if (!d || !d->src || !name)
        return (Str){ (char[:]){ 0, 0 } };
    p = d->src;
    nlen = (int)strlen(name);
    while (lrc_lineat(p, d->n, &pos, &start, &len)) {
        const char *l = p + start;
        int k = 0;

        if (len < nlen + 3 || l[0] != '[')
            continue;
        for (k = 0; k < nlen; k++) {
            if (l[1 + k] != name[k])
                break;
        }
        if (k != nlen || l[1 + k] != ':')
            continue;
        {
            int s2 = 1 + k + 1, e2 = len;

            if (e2 > s2 && l[e2 - 1] == ']')
                e2--;
            return (Str){ (char[:]){ (char *)l + s2, e2 - s2 } };
        }
    }
    return (Str){ (char[:]){ 0, 0 } };
}

int open(LrcDoc *d, const void *src, int n)
{
    const char *p = (const char *)src;
    int pos = 0, start = 0, len = 0, lines = 0;

    if (!d || !src || n <= 0)
        return -1;
    memset(d, 0, sizeof *d);
    d->src = p;
    d->n = n;
    while (lrc_lineat(p, n, &pos, &start, &len)) {
        const char *l = p + start;
        int i = 0, in_time = 1;

        if (len == 0)
            continue;
        if (l[0] != '[') {
            lines++;
            continue;
        }
        /* `[数字:` 开头的是歌词行，否则是元信息 */
        i = 1;
        while (i < len && lrc_digit(l[i]))
            i++;
        in_time = i > 1 && i < len && l[i] == ':';
        if (in_time) {
            lines++;
            continue;
        }
        if (len >= 8 && memcmp(l, "[offset:", 8) == 0) {
            int k = 8, sign = 1;
            i64 v = 0;

            while (k < len && l[k] == ' ')
                k++;
            if (k < len && (l[k] == '+' || l[k] == '-')) {
                if (l[k] == '-')
                    sign = -1;
                k++;
            }
            while (k < len && lrc_digit(l[k]))
                v = v * 10 + (l[k++] - '0');
            d->offset_ms = sign * v;
        }
    }
    d->nlines = lines;
    d->off = 0;
    return lines;
}

int next(LrcDoc *d, LrcLine *out)
{
    const char *p = 0;
    int start = 0, len = 0;

    if (!d || !d->src || !out)
        return -1;
    p = d->src;
    while (lrc_lineat(p, d->n, &d->off, &start, &len)) {
        const char *l = p + start;
        int i = 0;
        i64 ms = 0;
        int close = -1;

        if (len == 0)
            continue;
        if (l[0] != '[')
            continue;                   /* 没有时间标签的行不算歌词 */
        i = 1;
        while (i < len && lrc_digit(l[i]))
            i++;
        if (i <= 1 || i >= len || l[i] != ':')
            continue;                   /* 元信息行 */
        for (close = i; close < len; close++) {
            if (l[close] == ']')
                break;
        }
        if (close >= len)
            return -1;
        if (lrc_time_parse((char[:]){ (char *)l, close + 1 }, &ms) != 1)
            return -1;
        out->time_ms = ms + d->offset_ms;
        out->text.s = (char[:]){ (char *)l + close + 1, len - close - 1 };
        return 1;
    }
    return 0;
}

int count(LrcDoc *d)
{
    return d ? d->nlines : 0;
}

int rewind(LrcDoc *d)
{
    if (!d)
        return -1;
    d->off = 0;
    return 1;
}

Str doc_title(LrcDoc *d)
{
    return tag(d, "ti");
}

i64 offset(LrcDoc *d)
{
    return d ? d->offset_ms : 0;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "lrc：时间解析与格式化" {
    i64 ms = 0;
    char out[32] = { 0 };

    if (lrc_time_parse(S("[00:01.00]"), &ms) != 1 || ms != 1000)
        return err(1, "[00:01.00] 应该是 1000 毫秒");
    if (lrc_time_parse(S("[01:02.50]"), &ms) != 1 || ms != 62500)
        return err(2, "[01:02.50] 应该是 62500 毫秒");
    if (lrc_time_parse(S("[10:00]"), &ms) != 1 || ms != 600000)
        return err(3, "没有小数也应该可以");
    if (lrc_time_parse(S("[bad]"), &ms) != -1)
        return err(4, "非法时间应该 -1");
    if (lrc_time_format(62500, out, (int)sizeof out) != 10
        || memcmp(out, "[01:02.50]", 10) != 0)
        return err(5, "时间格式化不对");
    if (lrc_time_format(3723450, out, (int)sizeof out) != 10
        || memcmp(out, "[62:03.45]", 10) != 0)
        return err(6, "超过 60 分钟应该继续进分钟");
}

test "lrc：元信息与歌词行" {
    static const char *src =
        "[ti:测试歌曲]\r\n"
        "[ar:测试歌手]\r\n"
        "[offset:-500]\r\n"
        "[00:01.00]第一行\r\n"
        "[00:03.50]第二行\r\n"
        "[00:05.00]\r\n";
    LrcDoc doc = { 0 };
    LrcLine line = { 0 };
    Str t = { 0 };
    int n = 0;

    if (doc.open(src, (int)strlen(src)) != 3)
        return err(7, "应该有 3 行歌词");
    if (doc.count() != 3)
        return err(8, "count() 不对");
    t = doc.tag("ti");
    if (t.s.len != 12)
        return err(9, "ti 标签长度不对");
    t = doc.doc_title();
    if (t.s.len != 12)
        return err(10, "doc_title() 方法不对");
    if (doc.tag("ar").s.len != 12)
        return err(11, "ar 标签不对");
    if (doc.tag("xx").s.len != 0)
        return err(12, "不存在的标签应该空串");
    if (doc.offset() != -500)
        return err(13, "offset 解析不对");
    if (doc.next(&line) != 1)
        return err(14, "第一条歌词取不到");
    if (line.time_ms != 500)
        return err(15, "offset 应该把 1000 变成 500");
    if (line.text.s.len != 9 || memcmp(line.text.s.data, "第一行", 9) != 0)
        return err(16, "第一条歌词文本不对");
    if (doc.next(&line) != 1 || line.time_ms != 3000)
        return err(17, "第二条时间不对");
    if (doc.next(&line) != 1 || line.text.s.len != 0)
        return err(18, "第三条应该没有文本");
    if (doc.next(&line) != 0)
        return err(19, "读完应该返回 0");
    doc.rewind();
    n = 0;
    while (doc.next(&line) == 1)
        n++;
    if (n != 3)
        return err(20, "rewind 之后应该又能读出 3 条");
}
