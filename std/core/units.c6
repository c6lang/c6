/* std/core/units：常用单位换算（长度、质量、温度、字节容量）。
 *
 *     import std.core.units;
 *
 *     Conv c = { 0 };
 *     c.init(UNIT_LENGTH, LEN_KM);       // 方法：init / to
 *     c.to(LEN_M, 1.5);                  // 1500
 *     convert(UNIT_TEMP, TEMP_C, TEMP_F, 100);   // 212
 *     parse_unit(S("MiB"), &kind, &code);
 *
 * 四类单位：
 *
 * - 长度：`LEN_M`（基准）、`LEN_KM`、`LEN_CM`、`LEN_MM`、`LEN_IN`、`LEN_FT`、
 *   `LEN_YD`、`LEN_MI`、`LEN_NMI`；
 * - 质量：`MASS_G`（基准）、`MASS_KG`、`MASS_T`、`MASS_LB`、`MASS_OZ`；
 * - 温度：`TEMP_C`、`TEMP_F`、`TEMP_K`（**不是**按倍率换算，走单独的公式）；
 * - 字节：`SIZE_B`（基准）、`SIZE_KB`/`SIZE_MB`/`SIZE_GB`（1000 进制）、
 *   `SIZE_KIB`/`SIZE_MIB`/`SIZE_GIB`（1024 进制）。
 *
 * 约定：
 *
 * - `Conv` 是「记下类别与源单位」的小状态：`init(kind, code)` + `to(code, v)`；
 * - `convert(kind, from, to, v)` 是一次性版本；
 * - 类别或单位码不匹配时返回 -1（比如拿长度码去换质量）；
 * - `parse_unit("km", &kind, &code)` 认常见写法（大小写不敏感，`KiB`/`kib` 都行），
 *   成功返回 1，失败返回 0；
 * - `unit_name(kind, code)` 给规范写法（`"km"`、`"MiB"`、`"°C"`）；
 * - 全部是 `double`，不处理精度累积误差。
 */
#include <string.h>

module std.core.units;
import std.core.types;
import std.text.str;

enum {
    UNIT_LENGTH = 1,
    UNIT_MASS = 2,
    UNIT_TEMP = 3,
    UNIT_SIZE = 4
};

enum {
    LEN_M = 1,
    LEN_KM = 2,
    LEN_CM = 3,
    LEN_MM = 4,
    LEN_IN = 5,
    LEN_FT = 6,
    LEN_YD = 7,
    LEN_MI = 8,
    LEN_NMI = 9
};

enum {
    MASS_G = 1,
    MASS_KG = 2,
    MASS_T = 3,
    MASS_LB = 4,
    MASS_OZ = 5
};

enum {
    TEMP_C = 1,
    TEMP_F = 2,
    TEMP_K = 3
};

enum {
    SIZE_B = 1,
    SIZE_KB = 2,
    SIZE_MB = 3,
    SIZE_GB = 4,
    SIZE_KIB = 5,
    SIZE_MIB = 6,
    SIZE_GIB = 7
};

struct Conv {
    int kind;
    int code;
};

static double len_factor(int code)
{
    switch (code) {
    case LEN_M:
        return 1.0;
    case LEN_KM:
        return 1000.0;
    case LEN_CM:
        return 0.01;
    case LEN_MM:
        return 0.001;
    case LEN_IN:
        return 0.0254;
    case LEN_FT:
        return 0.3048;
    case LEN_YD:
        return 0.9144;
    case LEN_MI:
        return 1609.344;
    case LEN_NMI:
        return 1852.0;
    default:
        return 0.0;
    }
}

static double mass_factor(int code)
{
    switch (code) {
    case MASS_G:
        return 1.0;
    case MASS_KG:
        return 1000.0;
    case MASS_T:
        return 1000000.0;
    case MASS_LB:
        return 453.59237;
    case MASS_OZ:
        return 28.349523125;
    default:
        return 0.0;
    }
}

static double size_factor(int code)
{
    switch (code) {
    case SIZE_B:
        return 1.0;
    case SIZE_KB:
        return 1000.0;
    case SIZE_MB:
        return 1000000.0;
    case SIZE_GB:
        return 1000000000.0;
    case SIZE_KIB:
        return 1024.0;
    case SIZE_MIB:
        return 1048576.0;
    case SIZE_GIB:
        return 1073741824.0;
    default:
        return 0.0;
    }
}

double convert(int kind, int from, int to, double v)
{
    if (kind == UNIT_LENGTH) {
        double f0 = len_factor(from), f1 = len_factor(to);

        if (f0 == 0 || f1 == 0)
            return -1;
        return v * f0 / f1;
    }
    if (kind == UNIT_MASS) {
        double f0 = mass_factor(from), f1 = mass_factor(to);

        if (f0 == 0 || f1 == 0)
            return -1;
        return v * f0 / f1;
    }
    if (kind == UNIT_SIZE) {
        double f0 = size_factor(from), f1 = size_factor(to);

        if (f0 == 0 || f1 == 0)
            return -1;
        return v * f0 / f1;
    }
    if (kind == UNIT_TEMP) {
        double cel = 0;

        if (from == TEMP_C)
            cel = v;
        else if (from == TEMP_F)
            cel = (v - 32.0) * 5.0 / 9.0;
        else if (from == TEMP_K)
            cel = v - 273.15;
        else
            return -1;
        if (to == TEMP_C)
            return cel;
        if (to == TEMP_F)
            return cel * 9.0 / 5.0 + 32.0;
        if (to == TEMP_K)
            return cel + 273.15;
        return -1;
    }
    return -1;
}

int init(Conv *c, int kind, int code)
{
    if (!c)
        return -1;
    if (kind < UNIT_LENGTH || kind > UNIT_SIZE)
        return -1;
    if (convert(kind, code, code, 1.0) < 0)
        return -1;
    c->kind = kind;
    c->code = code;
    return 1;
}

double to(Conv *c, int code, double v)
{
    if (!c)
        return -1;
    return convert(c->kind, c->code, code, v);
}

static int uni_eq(char[:] s, const char *lit)
{
    int i = 0, n = (int)strlen(lit);

    if (s.len != n)
        return 0;
    for (i = 0; i < n; i++) {
        char a = s.data[i], b = lit[i];

        if (a >= 'A' && a <= 'Z')
            a = (char)(a - 'A' + 'a');
        if (b >= 'A' && b <= 'Z')
            b = (char)(b - 'A' + 'a');
        if (a != b)
            return 0;
    }
    return 1;
}

int parse_unit(char[:] s, int *kind, int *code)
{
    if (!s.data || !kind || !code)
        return -1;
    if (uni_eq(s, "m") || uni_eq(s, "meter") || uni_eq(s, "metre")) {
        *kind = UNIT_LENGTH;
        *code = LEN_M;
        return 1;
    }
    if (uni_eq(s, "km") || uni_eq(s, "kilometer")) {
        *kind = UNIT_LENGTH;
        *code = LEN_KM;
        return 1;
    }
    if (uni_eq(s, "cm")) {
        *kind = UNIT_LENGTH;
        *code = LEN_CM;
        return 1;
    }
    if (uni_eq(s, "mm")) {
        *kind = UNIT_LENGTH;
        *code = LEN_MM;
        return 1;
    }
    if (uni_eq(s, "in") || uni_eq(s, "inch")) {
        *kind = UNIT_LENGTH;
        *code = LEN_IN;
        return 1;
    }
    if (uni_eq(s, "ft") || uni_eq(s, "foot") || uni_eq(s, "feet")) {
        *kind = UNIT_LENGTH;
        *code = LEN_FT;
        return 1;
    }
    if (uni_eq(s, "mi") || uni_eq(s, "mile")) {
        *kind = UNIT_LENGTH;
        *code = LEN_MI;
        return 1;
    }
    if (uni_eq(s, "g") || uni_eq(s, "gram")) {
        *kind = UNIT_MASS;
        *code = MASS_G;
        return 1;
    }
    if (uni_eq(s, "kg") || uni_eq(s, "kilogram")) {
        *kind = UNIT_MASS;
        *code = MASS_KG;
        return 1;
    }
    if (uni_eq(s, "lb") || uni_eq(s, "pound")) {
        *kind = UNIT_MASS;
        *code = MASS_LB;
        return 1;
    }
    if (uni_eq(s, "oz") || uni_eq(s, "ounce")) {
        *kind = UNIT_MASS;
        *code = MASS_OZ;
        return 1;
    }
    if (uni_eq(s, "c") || uni_eq(s, "celsius") || uni_eq(s, "°c")) {
        *kind = UNIT_TEMP;
        *code = TEMP_C;
        return 1;
    }
    if (uni_eq(s, "f") || uni_eq(s, "fahrenheit") || uni_eq(s, "°f")) {
        *kind = UNIT_TEMP;
        *code = TEMP_F;
        return 1;
    }
    if (uni_eq(s, "k") || uni_eq(s, "kelvin")) {
        *kind = UNIT_TEMP;
        *code = TEMP_K;
        return 1;
    }
    if (uni_eq(s, "b") || uni_eq(s, "byte")) {
        *kind = UNIT_SIZE;
        *code = SIZE_B;
        return 1;
    }
    if (uni_eq(s, "kb")) {
        *kind = UNIT_SIZE;
        *code = SIZE_KB;
        return 1;
    }
    if (uni_eq(s, "mb")) {
        *kind = UNIT_SIZE;
        *code = SIZE_MB;
        return 1;
    }
    if (uni_eq(s, "gb")) {
        *kind = UNIT_SIZE;
        *code = SIZE_GB;
        return 1;
    }
    if (uni_eq(s, "kib")) {
        *kind = UNIT_SIZE;
        *code = SIZE_KIB;
        return 1;
    }
    if (uni_eq(s, "mib")) {
        *kind = UNIT_SIZE;
        *code = SIZE_MIB;
        return 1;
    }
    if (uni_eq(s, "gib")) {
        *kind = UNIT_SIZE;
        *code = SIZE_GIB;
        return 1;
    }
    return 0;
}

const char *unit_name(int kind, int code)
{
    if (kind == UNIT_LENGTH) {
        switch (code) {
        case LEN_M: return "m";
        case LEN_KM: return "km";
        case LEN_CM: return "cm";
        case LEN_MM: return "mm";
        case LEN_IN: return "in";
        case LEN_FT: return "ft";
        case LEN_YD: return "yd";
        case LEN_MI: return "mi";
        case LEN_NMI: return "nmi";
        default: return "?";
        }
    }
    if (kind == UNIT_MASS) {
        switch (code) {
        case MASS_G: return "g";
        case MASS_KG: return "kg";
        case MASS_T: return "t";
        case MASS_LB: return "lb";
        case MASS_OZ: return "oz";
        default: return "?";
        }
    }
    if (kind == UNIT_TEMP) {
        switch (code) {
        case TEMP_C: return "°C";
        case TEMP_F: return "°F";
        case TEMP_K: return "K";
        default: return "?";
        }
    }
    if (kind == UNIT_SIZE) {
        switch (code) {
        case SIZE_B: return "B";
        case SIZE_KB: return "KB";
        case SIZE_MB: return "MB";
        case SIZE_GB: return "GB";
        case SIZE_KIB: return "KiB";
        case SIZE_MIB: return "MiB";
        case SIZE_GIB: return "GiB";
        default: return "?";
        }
    }
    return "?";
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int unear(double a, double b, double eps)
{
    double d = a - b;

    if (d < 0)
        d = -d;
    return d <= eps;
}

test "units：长度、质量与温度" {
    Conv c = { 0 };
    double v = 0;

    if (unear(convert(UNIT_LENGTH, LEN_KM, LEN_M, 1.5), 1500.0, 1e-9))
        ;
    else
        return err(1, "1.5 km 应该是 1500 m");
    if (!unear(convert(UNIT_LENGTH, LEN_IN, LEN_CM, 1), 2.54, 1e-9))
        return err(2, "1 英寸应该是 2.54 厘米");
    if (!unear(convert(UNIT_LENGTH, LEN_MI, LEN_KM, 1), 1.609344, 1e-9))
        return err(3, "1 英里应该是 1.609344 公里");
    if (!unear(convert(UNIT_MASS, MASS_LB, MASS_KG, 1), 0.45359237, 1e-9))
        return err(4, "1 磅应该是 0.45359237 千克");
    if (!unear(convert(UNIT_TEMP, TEMP_C, TEMP_F, 100), 212.0, 1e-9))
        return err(5, "100°C 应该是 212°F");
    if (!unear(convert(UNIT_TEMP, TEMP_C, TEMP_K, 0), 273.15, 1e-9))
        return err(6, "0°C 应该是 273.15K");
    if (!unear(convert(UNIT_TEMP, TEMP_F, TEMP_C, 32), 0.0, 1e-9))
        return err(7, "32°F 应该是 0°C");
    /* Conv 方法 */
    if (c.init(UNIT_LENGTH, LEN_KM) != 1)
        return err(8, "init 失败");
    v = c.to(LEN_M, 2.0);
    if (!unear(v, 2000.0, 1e-9))
        return err(9, "Conv.to 不对");
    if (c.init(UNIT_LENGTH, 99) != -1)
        return err(10, "非法单位码应该 -1");
}

test "units：字节、解析与命名" {
    int kind = 0, code = 0;

    if (!unear(convert(UNIT_SIZE, SIZE_MIB, SIZE_KIB, 1), 1024.0, 1e-9))
        return err(11, "1 MiB 应该是 1024 KiB");
    if (!unear(convert(UNIT_SIZE, SIZE_MB, SIZE_KIB, 1), 1000000.0 / 1024.0,
               1e-9))
        return err(12, "1 MB 换成 KiB 不对");
    if (parse_unit(S("km"), &kind, &code) != 1 || kind != UNIT_LENGTH
        || code != LEN_KM)
        return err(13, "parse_unit(km) 不对");
    if (parse_unit(S("MiB"), &kind, &code) != 1 || code != SIZE_MIB)
        return err(14, "parse_unit(MiB) 不对（大小写不敏感）");
    if (parse_unit(S("kg"), &kind, &code) != 1 || kind != UNIT_MASS)
        return err(15, "parse_unit(kg) 不对");
    if (parse_unit(S("nope"), &kind, &code) != 0)
        return err(16, "未知单位应该 0");
    if (strcmp(unit_name(UNIT_LENGTH, LEN_KM), "km") != 0
        || strcmp(unit_name(UNIT_SIZE, SIZE_MIB), "MiB") != 0
        || strcmp(unit_name(UNIT_TEMP, TEMP_C), "°C") != 0)
        return err(17, "unit_name 不对");
    if (convert(UNIT_MASS, LEN_NMI, MASS_KG, 1) != -1)
        return err(18, "跨类别的单位码应该返回 -1");
    if (convert(99, LEN_M, LEN_KM, 1) != -1)
        return err(19, "未知类别应该返回 -1");
}
