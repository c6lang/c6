/* std/encoding/base32：Base32（RFC 4648）的标准表与 base32hex 表。
 *
 *     import std.encoding.base32;
 *
 *     char out[32] = { 0 };
 *     int n = b32_encode(S("foobar"), out, sizeof out);   // 16, "MZXW6YTBOI======"
 *     b32_decode(S("MZXW6YTBOI======"), buf, sizeof buf); // 6, "foobar"
 *
 * 和 `std.encoding.base64` 同一个口径：**不分配**，结果写调用方缓冲，
 * 放不下返回 -1 且一个字节都不写；解码先完整校验再写第二遍，非法输入
 * 不会留下半截结果。编码输出大写，解码同时接受小写（不少实现这么发）。
 *
 * 填充策略是显式参数：
 * - `pad = 1`：编码补 `=` 到 8 的倍数；解码要求填充齐全；
 * - `pad = 0`：编码不补 `=`；解码**两种都收**（省略填充或带标准填充）。
 * 这是 base32 和 base64 不同的地方：base32 在 URL/配置里省略填充很常见，
 * 所以默认解码走宽容口径，要严格就用 `b32_decode_ex(..., 1)`。
 *
 * 解码一律跳过 ASCII 空白（空格、`\t`、`\n`、`\r`、`\v`、`\f`）；`=` 只能
 * 出现在末尾，且个数必须和 RFC 4648 的最后一组匹配。填充位（最后一个
 * 字节没用到的低位）必须是 0，否则按非法输入处理。
 */
#include <string.h>

module std.encoding.base32;
import std.core.types;

enum Error { OK = 0, PARSE = 1, INVAL = 2, RANGE = 3 };

static char *b32_tab(int hex)
{
    return hex ? (char *)"0123456789ABCDEFGHIJKLMNOPQRSTUV"
               : (char *)"ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
}

/* 字节 -> 5 位值；非法给 -1。hex 表下 0-9A-V，标准表下 A-Z2-7。 */
static int b32_val(int c, int hex)
{
    if (hex) {
        if (c >= '0' && c <= '9')
            return c - '0';
        if (c >= 'A' && c <= 'V')
            return c - 'A' + 10;
        if (c >= 'a' && c <= 'v')
            return c - 'a' + 10;
        return -1;
    }
    if (c >= 'A' && c <= 'Z')
        return c - 'A';
    if (c >= 'a' && c <= 'z')
        return c - 'a';
    if (c >= '2' && c <= '7')
        return c - '2' + 26;
    return -1;
}

static int b32_space(int c)
{
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v'
        || c == '\f';
}

/* 编码后多少字节（不含结尾 NUL；n <= 0 给 0） */
int b32_encoded_len(int n, int pad)
{
    int full = 0;
    int rem = 0;

    if (n <= 0)
        return 0;
    full = (n / 5) * 8;
    rem = n % 5;
    if (rem == 0)
        return full;
    return full + (pad ? 8 : (rem * 8 + 4) / 5);
}

/* 扫描并校验；合法时 *data_n = 有效 5 位字符数、*eq_n = `=` 个数，返回
   解码后的字节数；非法返回 -1。 */
static int b32_scan(char[:] s, int hex, int pad, int *data_n, int *eq_n)
{
    int n = 0;
    int eq = 0;
    int seen_eq = 0;
    int i = 0;
    int bits = 0;
    int expected = 0;
    u64 acc = 0;

    if (s.len < 0)
        return -1;
    for (i = 0; i < s.len; i++) {
        int c = (u8)s.data[i];
        int v = 0;

        if (b32_space(c))
            continue;
        if (c == '=') {
            seen_eq = 1;
            eq++;
            continue;
        }
        if (seen_eq)
            return -1;      /* `=` 出现在中间 */
        v = b32_val(c, hex);
        if (v < 0)
            return -1;
        n++;
        acc = (acc << 5) | (u64)v;
        bits += 5;
        if (bits >= 8) {
            bits -= 8;
            acc &= bits ? ((1ull << bits) - 1) : 0;
        }
    }
    if (n % 8 == 1 || n % 8 == 3 || n % 8 == 6)
        return -1;          /* 凑不出整字节 */
    if (n % 8 == 0) {
        if (eq != 0)
            return -1;      /* 整块后面不该有填充 */
    } else {
        expected = 8 - n % 8;
        if (eq != 0 && eq != expected)
            return -1;
        if (pad && eq != expected)
            return -1;      /* 要求填充的调用方：尾部必须补齐 */
    }
    if (bits > 0 && acc != 0)
        return -1;          /* 填充位必须是 0 */
    if (data_n)
        *data_n = n;
    if (eq_n)
        *eq_n = eq;
    return (n * 5) / 8;
}

int b32_decoded_len(char[:] s, int hex, int pad)
{
    return b32_scan(s, hex, pad, 0, 0);
}

int b32_valid(char[:] s, int hex, int pad)
{
    return b32_decoded_len(s, hex, pad) >= 0;
}

/* 编码；cap 不够返回 -1 且不写任何内容 */
int b32_encode_ex(char[:] s, char *dst, int cap, int hex, int pad)
{
    char *tab = b32_tab(hex);
    int n = s.len;
    int need = b32_encoded_len(n, pad);
    int i = 0;
    int o = 0;
    int bits = 0;
    u64 acc = 0;

    if (n < 0 || need < 0 || need > cap || (need > 0 && !dst))
        return -1;
    while (i < n) {
        acc = (acc << 8) | (u64)(u8)s.data[i++];
        bits += 8;
        while (bits >= 5) {
            bits -= 5;
            dst[o++] = tab[(int)((acc >> bits) & 31)];
        }
    }
    if (bits > 0)
        dst[o++] = tab[(int)((acc << (5 - bits)) & 31)];
    if (pad)
        while (o % 8 != 0)
            dst[o++] = '=';
    return o;
}

int b32_encode(char[:] s, char *dst, int cap)
{
    return b32_encode_ex(s, dst, cap, 0, 1);
}

int b32hex_encode(char[:] s, char *dst, int cap)
{
    return b32_encode_ex(s, dst, cap, 1, 1);
}

/* 解码；cap 不够或输入非法返回 -1 且不写任何内容 */
int b32_decode_ex(char[:] s, char *dst, int cap, int hex, int pad)
{
    int need = b32_decoded_len(s, hex, pad);
    int i = 0;
    int o = 0;
    int bits = 0;
    u64 acc = 0;

    if (need < 0 || need > cap || (need > 0 && !dst))
        return -1;
    for (i = 0; i < s.len; i++) {
        int c = (u8)s.data[i];
        int v = 0;

        if (b32_space(c) || c == '=')
            continue;
        v = b32_val(c, hex);
        if (v < 0)
            return -1;      /* 上面已经校验过，这里只是防御 */
        acc = (acc << 5) | (u64)v;
        bits += 5;
        if (bits >= 8) {
            bits -= 8;
            dst[o++] = (char)((acc >> bits) & 0xff);
            acc &= bits ? ((1ull << bits) - 1) : 0;
        }
    }
    return o;
}

int b32_decode(char[:] s, char *dst, int cap)
{
    return b32_decode_ex(s, dst, cap, 0, 0);
}

int b32hex_decode(char[:] s, char *dst, int cap)
{
    return b32_decode_ex(s, dst, cap, 1, 0);
}

/* ---- 自测 ---- */

#define B32S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int enc(const char *src, char *out, int cap, int hex, int pad)
{
    return b32_encode_ex((char[:]){ (char *)src, (int)strlen(src) }, out, cap, hex, pad);
}

static int dec(const char *src, char *out, int cap, int hex, int pad)
{
    return b32_decode_ex((char[:]){ (char *)src, (int)strlen(src) }, out, cap, hex, pad);
}

test "RFC 4648 标准表向量（带填充）" {
    char out[32] = { 0 };
    char back[32] = { 0 };

    if (enc("", out, sizeof out, 0, 1) != 0)
        return err(1, "空串编码不是 0");
    if (enc("f", out, sizeof out, 0, 1) != 8 || strcmp(out, "MY======") != 0)
        return err(2, "f 的向量不对");
    if (enc("fo", out, sizeof out, 0, 1) != 8 || strcmp(out, "MZXQ====") != 0)
        return err(3, "fo 的向量不对");
    if (enc("foo", out, sizeof out, 0, 1) != 8 || strcmp(out, "MZXW6===") != 0)
        return err(4, "foo 的向量不对");
    if (enc("foob", out, sizeof out, 0, 1) != 8 || strcmp(out, "MZXW6YQ=") != 0)
        return err(5, "foob 的向量不对");
    if (enc("fooba", out, sizeof out, 0, 1) != 8 || strcmp(out, "MZXW6YTB") != 0)
        return err(6, "fooba 的向量不对");
    if (enc("foobar", out, sizeof out, 0, 1) != 16
        || strcmp(out, "MZXW6YTBOI======") != 0)
        return err(7, "foobar 的向量不对");

    if (dec("MZXW6YTBOI======", back, sizeof back, 0, 1) != 6
        || memcmp(back, "foobar", 6) != 0)
        return err(8, "foobar 解码不对");
    if (dec("MY======", back, sizeof back, 0, 1) != 1 || back[0] != 'f')
        return err(9, "f 解码不对");
}

test "省略填充与宽容解码" {
    char out[32] = { 0 };
    char back[32] = { 0 };

    if (enc("f", out, sizeof out, 0, 0) != 2 || strcmp(out, "MY") != 0)
        return err(10, "f 省略填充不对");
    if (enc("foobar", out, sizeof out, 0, 0) != 10
        || strcmp(out, "MZXW6YTBOI") != 0)
        return err(11, "foobar 省略填充不对");
    if (dec("MZXW6YTBOI", back, sizeof back, 0, 0) != 6
        || memcmp(back, "foobar", 6) != 0)
        return err(12, "省略填充解码不对");
    if (dec("MZXW6YTBOI======", back, sizeof back, 0, 0) != 6)
        return err(13, "宽容解码不收带填充的输入");
    if (enc("foo", out, sizeof out, 0, 1) != 8
        || dec("MZ XW6===\n", back, sizeof back, 0, 0) != 3
        || memcmp(back, "foo", 3) != 0)
        return err(14, "空白或小写没有被接受");
    if (dec("mzxw6===", back, sizeof back, 0, 1) != 3)
        return err(15, "小写输入没有解码");
}

test "base32hex 向量" {
    char out[32] = { 0 };
    char back[32] = { 0 };

    if (enc("f", out, sizeof out, 1, 1) != 8 || strcmp(out, "CO======") != 0)
        return err(16, "hex f 的向量不对");
    if (enc("fo", out, sizeof out, 1, 1) != 8 || strcmp(out, "CPNG====") != 0)
        return err(17, "hex fo 的向量不对");
    if (enc("foo", out, sizeof out, 1, 1) != 8 || strcmp(out, "CPNMU===") != 0)
        return err(18, "hex foo 的向量不对");
    if (enc("foob", out, sizeof out, 1, 1) != 8 || strcmp(out, "CPNMUOG=") != 0)
        return err(19, "hex foob 的向量不对");
    if (enc("fooba", out, sizeof out, 1, 1) != 8 || strcmp(out, "CPNMUOJ1") != 0)
        return err(20, "hex fooba 的向量不对");
    if (enc("foobar", out, sizeof out, 1, 1) != 16
        || strcmp(out, "CPNMUOJ1E8======") != 0)
        return err(21, "hex foobar 的向量不对");
    if (dec("CPNMUOJ1E8======", back, sizeof back, 1, 1) != 6
        || memcmp(back, "foobar", 6) != 0)
        return err(22, "hex 解码不对");
}

test "非法输入：字符 / 填充 / 填充位 / 容量" {
    char out[8] = { 0 };
    char back[8] = { 0 };
    int i = 0;

    for (i = 0; i < (int)sizeof back; i++)
        back[i] = (char)0xaa;
    if (b32_decode(B32S("MZXW6YTB!"), back, sizeof back) != -1)
        return err(23, "非法字符没有拒绝");
    if (b32_decode(B32S("MZ=XW6Y"), back, sizeof back) != -1)
        return err(24, "= 在中间没有拒绝");
    if (b32_decode_ex(B32S("MY====="), back, sizeof back, 0, 1) != -1)
        return err(25, "填充个数不对没有拒绝");
    if (b32_decode_ex(B32S("MY"), back, sizeof back, 0, 1) != -1)
        return err(26, "要求填充时省略填充没有拒绝");
    if (b32_decode(B32S("MZ"), back, sizeof back) != -1)
        return err(27, "非零填充位没有拒绝");
    if (b32_decode(B32S("A"), back, sizeof back) != -1)
        return err(28, "凑不出整字节的长度没有拒绝");
    for (i = 0; i < (int)sizeof back; i++)
        if (back[i] != (char)0xaa)
            return err(29, "拒绝非法输入时写了半个结果");
    if (enc("foobar", out, 2, 0, 1) != -1)
        return err(30, "容量不够没有返回 -1");
}

test "长度函数与 valid" {
    if (b32_encoded_len(0, 1) != 0 || b32_encoded_len(1, 1) != 8
        || b32_encoded_len(5, 1) != 8 || b32_encoded_len(6, 1) != 16
        || b32_encoded_len(1, 0) != 2 || b32_encoded_len(5, 0) != 8)
        return err(31, "encoded_len 不对");
    if (b32_decoded_len(B32S("MZXW6YTBOI======"), 0, 1) != 6
        || b32_decoded_len(B32S("MZXW6YTBOI"), 0, 0) != 6
        || b32_decoded_len(B32S("MZ"), 0, 0) != -1)
        return err(32, "decoded_len 不对");
    if (!b32_valid(B32S("MZXW6==="), 0, 1)
        || b32_valid(B32S("MZXW6=="), 0, 1)
        || b32_valid(B32S("MZXW6=!="), 0, 1))
        return err(33, "valid 不对");
}
