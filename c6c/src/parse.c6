            pa_advance();
            if (!pa_accept_ch(')')) {
                for (;;) {
                    if (narg >= PA_ARG_MAX) {
                        pa_error("实参太多（上限 64）");
                        break;
                    }
                    args[narg] = value_of(gen_assign());
                    narg++;
                    if (!pa_accept_ch(','))
                        break;
                }
                pa_expect_ch(')');
            }
            irfn_push(&FN, IR_LOAD, IRT_PTR, code, envv, 0, 0, 0);
            for (i2 = 0; i2 < narg; i2++)
                irfn_push(&FN, IR_ARG, IRT_U64, 0, args[i2], 0, 0, i2);
            dst = irfn_vreg(&FN);
            irfn_push(&FN, IR_CALLI, ir_ty_of(ty_target(cft2)), dst, code, 0, 0, 0);
            FN.ops[FN.n - 1].narg = (u8)narg;
