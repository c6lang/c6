/* stdtour：把标准库新加的模块串起来走一圈。
 *
 * 这个文件没有 `module`：入口 `main` 只能出现在不属于任何模块的文件里。
 * 六个新模块各占一节，每节都带自检（失败打 FAIL，最后按失败数决定退出码），
 * 所以 `make std-tour` 既是演示也是集成用例。
 *
 * 编译（模块正文要单独编进程序，import 只带来声明）：
 *
 *     ./tcc/c6 -B tcc -I . -o build/stdtour \
 *         examples/stdtour.c6 std/types.c6 std/err.c6 std/str.c6 \
 *         std/span.c6 std/fmt.c6 std/strbuf.c6 std/utf8.c6 \
 *         std/bits.c6 std/hash.c6 std/path.c6 std/deque.c6
 *
 * 用到的东西：
 *   std.strbuf  StrBuf：会自己长大的字符缓冲（write_int/write_hex/truncate）
 *   std.fmt     数字转换原语（strbuf 底下用它）
 *   std.path    path_base / path_dir / path_ext / path_join / path_normalize
 *   std.hash    FNV-1a 32/64、CRC32、Adler-32、流式 Hasher
 *   std.bits    popcount / clz / ctz / 旋转 / 字节序 / 位掩码
 *   std.utf8    UTF-8 解码、编码、计数、校验、rune 迭代器
 *   std.deque   环形缓冲双端队列 Deque@T（两端进出 O(1)）
 */
#include <stdio.h>
#include <string.h>

import std.types;
import std.err;
import std.str;
import std.fmt;
import std.strbuf;
import std.utf8;
import std.bits;
import std.hash;
import std.path;
import std.deque;

/* 宏不随 import 传递：谁的代码里用，谁自己定义一次 */
#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int checks = 0;
static int fails = 0;

static void check(int cond, char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("FAIL: %s\n", what);
    }
}

/* StrBuf 的方法会分配、返回 int!error；演示里把它折成 -1 方便连续判断 */
static int append(StrBuf *b, char[:] s)
{
    b->strbuf_write(s) catch e { return -1; };
    return 0;
}

static int put_int(StrBuf *b, int v)
{
    b->strbuf_write_int(v) catch e { return -1; };
    return 0;
}

static int put_hex(StrBuf *b, u64 v)
{
    b->strbuf_write_hex(v) catch e { return -1; };
    return 0;
}

static int put_cstr(StrBuf *b, char *z)
{
    b->strbuf_write_cstr(z) catch e { return -1; };
    return 0;
}

/* Deque 的两端进队同理：catch 体必须以 return/err/goto 结尾，所以包一层 */
static int dq_push_back(Deque@int *d, int v)
{
    d->push_back(v) catch e { return -1; };
    return 0;
}

static int dq_push_front(Deque@int *d, int v)
{
    d->push_front(v) catch e { return -1; };
    return 0;
}

/* 演示用的模块名表：c6 里没有「字符串数组字面量」之外的花样，直接 switch */
static char[:] mod_at(int i)
{
    switch (i) {
    case 0: return S("std/vec.c6");
    case 1: return S("std/map.c6");
    case 2: return S("std/path.c6");
    }
    return (char[:]){ (char *)0, 0 };
}

/* ---- 1. strbuf + fmt ---- */
static void tour_strbuf(void)
{
    @StrBuf list = new StrBuf;
    @StrBuf nums = new StrBuf;
    int i = 0;

    for (i = 0; i < 3; i++) {
        if (i > 0)
            check(append(list, S(", ")) == 0, "strbuf: 追加分隔符");
        check(append(list, mod_at(i)) == 0, "strbuf: 追加模块名");
    }
    check(list->strbuf_count() == 35, "strbuf: 拼接长度");
    check(strcmp(list->strbuf_cstr(), "std/vec.c6, std/map.c6, std/path.c6") == 0,
          "strbuf: 拼接内容");
    check(!list->strbuf_is_empty() && list->strbuf_capacity() >= list->strbuf_count(),
          "strbuf: capacity 覆盖 count");

    check(put_int(nums, -42) == 0, "strbuf: write_int 失败");
    check(put_cstr(nums, " ") == 0, "strbuf: write_cstr 失败");
    check(put_hex(nums, 0xdeadbeefu) == 0, "strbuf: write_hex 失败");
    check(strcmp(nums->strbuf_cstr(), "-42 deadbeef") == 0, "strbuf: 数字格式");

    /* 截断只改 n，不动容量：再往里追加还能用 */
    list->strbuf_truncate(10);
    check(list->strbuf_count() == 10 && strcmp(list->strbuf_cstr(), "std/vec.c6") == 0,
          "strbuf: truncate(10)");
    check(append(list, S(" ...")) == 0 && strcmp(list->strbuf_cstr(), "std/vec.c6 ...") == 0,
          "strbuf: truncate 之后继续追加");

    printf("strbuf  %-24s %s\n", nums->strbuf_cstr(), list->strbuf_cstr());
}

/* ---- 2. path ---- */
static void tour_path(void)
{
    Str p = { S("docs/stdlib.md") };
    Str dir = path_dir(p.s);
    Str base = path_base(p.s);
    Str ext = path_ext(p.s);
    Str stem = path_stem(p.s);
    char buf[64] = { 0 };
    int n = 0;

    check((&dir)->eq(S("docs")), "path: dir");
    check((&base)->eq(S("stdlib.md")), "path: base");
    check((&ext)->eq(S(".md")), "path: ext");
    check((&stem)->eq(S("stdlib")), "path: stem");
    check(path_is_abs(S("/usr/bin")) && !path_is_abs(S("usr/bin")),
          "path: is_abs");
    check(path_has_ext(p.s, S(".md")) && !path_has_ext(p.s, S(".h")),
          "path: has_ext");

    n = path_join(dir.s, base.s, buf, sizeof buf);
    check(n == 14 && strcmp(buf, "docs/stdlib.md") == 0, "path: join 还原");
    n = path_normalize(S("./docs//stdlib.md"), buf, sizeof buf);
    check(n == 14 && strcmp(buf, "docs/stdlib.md") == 0, "path: normalize");
    check(path_normalize(S("a/../b"), buf, sizeof buf) == 6
          && strcmp(buf, "a/../b") == 0, "path: normalize 保留 ..");
    /* 放不下：返回 -1 且一个字节都不写（buf 里还是上一步的内容） */
    check(path_join(S("src"), S("main.c6"), buf, 4) == -1
          && strcmp(buf, "a/../b") == 0, "path: join 放不下不写半截");

    printf("path    %.*s + %.*s = %.*s [%.*s]\n", dir.s.len, dir.s.data,
           base.s.len, base.s.data, stem.s.len, stem.s.data, ext.s.len,
           ext.s.data);
}

/* ---- 3. hash ---- */
static void tour_hash(void)
{
    Str p = { S("docs/stdlib.md") };
    Hasher hs = hasher();
    u32 one = 0;
    u32 split = 0;
    u64 h64 = 0ull;

    /* 已知向量：算法对不对不靠「自己和自己比」 */
    check(fnv1a_bytes("a", 1) == 0xe40c292cu, "hash: FNV-1a 32 已知向量");
    check(fnv1a64_bytes("a", 1) == 0xaf63dc4c8601ec8cull,
          "hash: FNV-1a 64 已知向量");
    check(crc32_bytes("123456789", 9) == 0xcbf43926u, "hash: CRC32 已知向量");
    check(adler32_bytes("Wikipedia", 9) == 0x11e60398u, "hash: Adler-32 已知向量");

    /* 同一份内容：一次喂 vs 分两段喂，必须一样（流式接口的核心约定） */
    one = fnv1a_bytes(p.s.data, (usize)p.s.len);
    check(one == fnv1a_cstr("docs/stdlib.md"), "hash: bytes 与 cstr 一致");
    check(one == (&p)->hash(), "hash: std.hash 与 Str::hash 同算法");
    hasher_update(&hs, p.s.data, (usize)5);
    hasher_update(&hs, p.s.data + 5, (usize)(p.s.len - 5));
    split = hasher_digest(&hs);
    check(split == one, "hash: 分两段喂 == 一次喂");
    h64 = fnv1a64_bytes(p.s.data, (usize)p.s.len);
    check(h64 != (u64)one, "hash: 32 位和 64 位不是同一个值");

    printf("hash    fnv32=%08x fnv64=%016llx crc32=123456789->%08x\n",
           one, h64, crc32_bytes("123456789", 9));
}

/* ---- 4. bits ---- */
static void tour_bits(void)
{
    u64 bits = 0ull;
    int i = 0;

    check(popcount32(0xf0f0f0f0u) == 16, "bits: popcount32");
    check(clz32(1u) == 31 && ctz32(8u) == 3, "bits: clz/ctz");
    check(clz32(0u) == 32 && ctz32(0u) == 32, "bits: 0 的 clz/ctz 约定");
    check(rotl32(0x80000001u, 1) == 0x00000003u, "bits: rotl32");
    check(bswap32(0x11223344u) == 0x44332211u, "bits: bswap32");
    check(mask_low(4) == 0x0full && mask_range(4, 8) == 0xf0ull, "bits: mask");
    check(sign_extend(0x0full, 4) == 0xffffffffffffffffull, "bits: sign_extend");
    check(is_pow2_32(1024u) && !is_pow2_32(0u) && !is_pow2_32(6u),
          "bits: is_pow2");

    bit_set(&bits, 3);
    bit_set(&bits, 60);
    check(bit_get(bits, 3) == 1 && bit_get(bits, 60) == 1, "bits: bit_set/get");
    bit_toggle(&bits, 3);
    check(bit_get(bits, 3) == 0 && popcount64(bits) == 1, "bits: bit_toggle");
    bit_clear(&bits, 60);
    check(bits == 0ull, "bits: bit_clear");

    for (i = 0; i < 8; i++)
        bit_set(&bits, i * 8);
    check(popcount64(bits) == 8, "bits: 稀疏掩码的 popcount");

    printf("bits    0x%016llx parity=%d\n", bits, parity32(0xf0f0f0f0u));
}

/* ---- 5. utf8 ---- */
static void tour_utf8(void)
{
    Str t = { S("h\xc3\xa9llo, \xe4\xb8\x96\xe7\x95\x8c") };   /* héllo, 世界 */
    char enc[8] = { 0 };
    u32 cp = 0;
    int k = 0;
    int n = 0;

    check(t.s.len == 14, "utf8: 字节数（不是 rune 数）");
    check(utf8_valid(t.s) == 1, "utf8: valid");
    check(utf8_count(t.s) == 9, "utf8: count");

    k = utf8_decode(t.s, 0, &cp);
    check(k == 1 && cp == 'h', "utf8: 解码 ASCII");
    k = utf8_decode(t.s, 1, &cp);
    check(k == 2 && cp == 0xe9u, "utf8: 解码 2 字节");
    k = utf8_decode(t.s, 8, &cp);
    check(k == 3 && cp == 0x4e16u, "utf8: 解码 3 字节（世）");

    k = utf8_encode(0x4e16u, enc, sizeof enc);
    check(k == 3 && (unsigned char)enc[0] == 0xe4
          && (unsigned char)enc[1] == 0xb8 && (unsigned char)enc[2] == 0x96,
          "utf8: 编码 3 字节");
    check(utf8_encode(0xd800u, enc, sizeof enc) == -1, "utf8: 拒绝代理区");
    check(utf8_encode(0x110000u, enc, sizeof enc) == -1, "utf8: 拒绝超范围");

    /* 非法输入：孤立的续字节、过长编码、截断 */
    check(utf8_decode(S("\x80"), 0, &cp) == -1, "utf8: 孤立续字节");
    check(utf8_decode(S("\xc0\xaf"), 0, &cp) == -1, "utf8: 过长编码");
    check(utf8_decode(S("\xe4\xb8"), 0, &cp) == -1, "utf8: 截断序列");
    check(utf8_valid(S("\x80")) == 0, "utf8: valid 认出坏输入");

    foreach (Rune r = utf8_runes(t.s)) {
        n++;
        if (!r.ok)
            check(0, "utf8: 迭代出坏 rune");
    }
    check(n == 9, "utf8: 迭代器跑完 9 个 rune");

    printf("utf8    %d bytes / %d runes, first=%u\n", t.s.len, utf8_count(t.s),
           (unsigned)0x4e16u);
}

/* ---- 6. deque：滚动窗口只看最近 4 条 ---- */
static void tour_deque(void)
{
    @Deque@int d = new Deque@int;
    int i = 0, v = 0, n = 0, sum = 0;

    for (i = 1; i <= 6; i++)
        check(dq_push_back(d, i) == 0, "deque: push_back 失败");
    while (d->count() > 4)
        check(d->pop_front(&v) == 1, "deque: pop_front 失败");
    check(d->at(0) == 3 && d->at(3) == 6, "deque: 窗口是最后 4 条");

    check(dq_push_front(d, 2) == 0, "deque: push_front 失败");
    check(dq_push_front(d, 1) == 0, "deque: push_front 失败");
    foreach (int x = d->iter()) {
        n++;
        sum += x;
    }
    check(n == 6 && sum == 21, "deque: 迭代顺序与求和");
    check(d->first(&v) == 1 && v == 1, "deque: first");
    check(d->last(&v) == 1 && v == 6, "deque: last");

    d->clear();
    check(d->count() == 0 && d->pop_back(&v) == 0, "deque: clear 之后为空");

    printf("deque   窗口=[3 4 5 6] 加上 1 2 后 sum=%d\n", sum);
}

int main(void)
{
    printf("stdtour: 标准库新模块一日游\n");
    tour_strbuf();
    tour_path();
    tour_hash();
    tour_bits();
    tour_utf8();
    tour_deque();
    printf("stdtour: %d check(s), %d failure(s)\n", checks, fails);
    return fails ? 1 : 0;
}
