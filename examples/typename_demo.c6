/* c6 「裸 tag 类型名」示例：struct / union / enum 都可以不写关键字
 *
 *   ./tcc/tcc -B tcc -run examples/typename_demo.c6
 *
 * 规则只有一条：普通命名空间优先。名字被变量/函数/枚举常量占住时，
 * 仍是老 C 语义，需要类型就写 'struct'（例如 <sys/stat.h> 里
 * 'struct stat' 与函数 'stat()' 同名，两者都照旧可用）。
 */
#include <stdio.h>
#include <sys/stat.h>

struct Vec { int x, y; };
struct Node { int v; Node *next; };     /* 定义体内就能省 */
union Word { int i; float f; };
enum Color { RED = 1, GREEN = 2, BLUE = 3 };

/* 方法：第一个形参是指向 struct Vec 的指针 */
int vec_len(Vec *self) { return self->x + self->y; }

/* 形参和返回值都用裸 tag */
Vec vec_add(Vec a, Vec b)
{
    Vec r = { a.x + b.x, a.y + b.y };
    return r;
}

int main(void)
{
    Vec v = { 3, 4 };
    Vec w = vec_add(v, (Vec){ 10, 20 });
    printf("Vec{%d, %d}, |v| = %d\n", w.x, w.y, (&v)->vec_len());
    printf("sizeof(Vec) = %d, sizeof(struct Vec) = %d\n",
           (int)sizeof(Vec), (int)sizeof(struct Vec));

    union Word word = { 0 };
    word.i = 42;
    printf("sizeof(Word) = %d, word.i = %d\n", (int)sizeof(Word), word.i);

    Color c = GREEN;
    printf("Color c = %d (%s)\n", (int)c,
           c == RED ? "RED" : c == GREEN ? "GREEN" : "BLUE");

    Node c3 = { 3, 0 };
    Node c2 = { 2, &c3 };
    Node c1 = { 1, &c2 };
    int sum = 0;
    Node *it = &c1;
    while (it) {
        sum += it->v;
        it = it->next;
    }
    printf("list sum = %d\n", sum);

    /* 被普通符号遮蔽时仍要写 struct：'stat(...)' 仍然是函数调用 */
    struct stat st = { 0 };
    if (stat(".", &st) == 0)
        printf("struct stat 照旧可用（stat() 没有被 tag 抢走）\n");

    return 0;
}
