/* std/core/least：最小二乘拟合（直线与多项式，正规方程 + 高斯消元）。
 *
 *     import std.core.least;
 *
 *     double xs[5] = { 0, 1, 2, 3, 4 };
 *     double ys[5] = { 3, 5, 7, 9, 11 };
 *     Fit f = { 0 };
 *     f.line(xs, ys, 5);              // 方法：line / poly / value_at / coef
 *     f.coef(0);                      // 3（截距）
 *     f.coef(1);                      // 2（斜率）
 *     f.r2();                         // 1（完全拟合）
 *
 * 拟合 `y = c0 + c1·x + … + ck·x^k`，系数最多 8 个（次数 ≤ 7）。
 *
 * 约定：
 *
 * - `f.line(xs, ys, n)` 直线拟合（次数 1），`f.poly(xs, ys, n, deg)` 多项式拟合；
 *   成功返回次数，点数不足或退化（矩阵奇异）返回 -1；
 * - 系数从低次到高次：`f.coef(0)` 是常数项；`f.value_at(x)` 按当前系数求值；
 * - `f.rss()` 是残差平方和，`f.r2()` 是决定系数（完全拟合为 1，常数序列时按 1 处理）；
 * - `f.degree()` 次数，`f.npoints()` 参与拟合的点数；
 * - 内部用正规方程 + 部分主元高斯消元（`double`，次数高时病态，超过 5 次慎用）；
 * - 需要 `-lm`（`Makefile` 的 `std-*` 目标已经带上）。
 */
#include <math.h>
#include <string.h>

module std.core.least;
import std.core.types;
import std.text.str;

#define LEAST_MAX_DEG 7
#define LEAST_MAX_COEF (LEAST_MAX_DEG + 1)

struct Fit {
    double c[LEAST_MAX_COEF];
    int k;          /* 次数 */
    int np;         /* 点数 */
    double rss_v;
    double r2_v;
};

int degree(Fit *f)
{
    return f ? f->k : 0;
}

int npoints(Fit *f)
{
    return f ? f->np : 0;
}

double coef(Fit *f, int i)
{
    if (!f || i < 0 || i > f->k)
        return 0.0;
    return f->c[i];
}

double rss(Fit *f)
{
    return f ? f->rss_v : 0.0;
}

double r2(Fit *f)
{
    return f ? f->r2_v : 0.0;
}

double value_at(Fit *f, double x)
{
    double v = 0.0, p = 1.0;
    int i = 0;

    if (!f)
        return 0.0;
    for (i = 0; i <= f->k; i++) {
        v += f->c[i] * p;
        p *= x;
    }
    return v;
}

/* 解 n 阶线性方程组（部分主元高斯消元），A 是 n×n（行主序），b 长度 n，
 * 结果写回 b。奇异返回 -1。 */
static int le_solve(double *a, double *b, int n)
{
    int i = 0, j = 0, k = 0;

    for (i = 0; i < n; i++) {
        int piv = i;
        double best = fabs(a[i * n + i]);

        for (j = i + 1; j < n; j++) {
            double v = fabs(a[j * n + i]);

            if (v > best) {
                best = v;
                piv = j;
            }
        }
        if (best < 1e-12)
            return -1;
        if (piv != i) {
            for (k = 0; k < n; k++) {
                double t = a[i * n + k];

                a[i * n + k] = a[piv * n + k];
                a[piv * n + k] = t;
            }
            {
                double t = b[i];

                b[i] = b[piv];
                b[piv] = t;
            }
        }
        for (j = i + 1; j < n; j++) {
            double factor = a[j * n + i] / a[i * n + i];

            if (factor == 0.0)
                continue;
            for (k = i; k < n; k++)
                a[j * n + k] -= factor * a[i * n + k];
            b[j] -= factor * b[i];
        }
    }
    for (i = n - 1; i >= 0; i--) {
        double sum = b[i];

        for (j = i + 1; j < n; j++)
            sum -= a[i * n + j] * b[j];
        b[i] = sum / a[i * n + i];
    }
    return 1;
}

int poly(Fit *f, const double *xs, const double *ys, int n, int deg)
{
    int m = deg + 1;
    int i = 0, j = 0, p = 0;
    double a[LEAST_MAX_COEF * LEAST_MAX_COEF] = { 0 };
    double b[LEAST_MAX_COEF] = { 0 };
    double sst = 0.0;

    if (!f || !xs || !ys || n <= 0 || deg < 0 || deg > LEAST_MAX_DEG || n < m)
        return -1;
    memset(f, 0, sizeof *f);
    f->k = deg;
    f->np = n;
    /* 累加 Σ x^(j+p) 与 Σ y·x^j，得到正规方程 A·c = b */
    memset(a, 0, sizeof a);
    memset(b, 0, sizeof b);
    for (i = 0; i < n; i++) {
        double xp[2 * LEAST_MAX_COEF + 1] = { 0 };

        xp[0] = 1.0;
        for (p = 1; p <= 2 * deg; p++)
            xp[p] = xp[p - 1] * xs[i];
        for (j = 0; j < m; j++) {
            b[j] += ys[i] * xp[j];
            for (p = 0; p < m; p++)
                a[j * m + p] += xp[j + p];
        }
    }
    if (le_solve(a, b, m) < 0)
        return -1;
    for (i = 0; i < m; i++)
        f->c[i] = b[i];
    /* 残差与 r2 */
    {
        double mean = 0.0;

        for (i = 0; i < n; i++)
            mean += ys[i];
        mean /= (double)n;
        for (i = 0; i < n; i++) {
            double d = ys[i] - f->value_at(xs[i]);

            f->rss_v += d * d;
            sst += (ys[i] - mean) * (ys[i] - mean);
        }
    }
    f->r2_v = (sst > 0.0) ? 1.0 - f->rss_v / sst : 1.0;
    if (f->rss_v < 0.0)
        f->rss_v = 0.0;
    return f->k;
}

int line(Fit *f, const double *xs, const double *ys, int n)
{
    return poly(f, xs, ys, n, 1);
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "least：直线拟合" {
    Fit f = { 0 };
    double xs[5] = { 0, 1, 2, 3, 4 };
    double ys[5] = { 3, 5, 7, 9, 11 };

    if (f.line(xs, ys, 5) != 1)
        return err(1, "直线拟合失败");
    if (f.degree() != 1 || f.npoints() != 5)
        return err(2, "次数或点数不对");
    if (fabs(f.coef(0) - 3.0) > 1e-9 || fabs(f.coef(1) - 2.0) > 1e-9)
        return err(3, "斜率/截距应该是 3 与 2");
    if (fabs(f.rss()) > 1e-12 || fabs(f.r2() - 1.0) > 1e-12)
        return err(4, "完全拟合时 rss=0、r2=1");
    if (fabs(f.value_at(10.0) - 23.0) > 1e-9)
        return err(5, "value_at(10) 应该是 23");
    if (fabs(f.coef(5)) != 0.0)
        return err(6, "越界系数应该是 0");
}

test "least：二次拟合与退化" {
    Fit f = { 0 };
    double xs[5] = { -2, -1, 0, 1, 2 };
    double ys[5] = { 3, 1.5, 1, 1.5, 3 };      /* 1 + 0.5x² */

    if (f.poly(xs, ys, 5, 2) != 2)
        return err(7, "二次拟合失败");
    if (fabs(f.coef(0) - 1.0) > 1e-9 || fabs(f.coef(1)) > 1e-9
        || fabs(f.coef(2) - 0.5) > 1e-9)
        return err(8, "二次系数应该是 1/0/0.5");
    if (fabs(f.r2() - 1.0) > 1e-9)
        return err(9, "完全拟合的 r2 应该是 1");
    /* 带噪数据：r2 在 (0,1) 之间，rss 大于 0 */
    {
        double nxs[4] = { 0, 1, 2, 3 };
        double nys[4] = { 0, 2, 1, 3 };

        if (f.line(nxs, nys, 4) != 1)
            return err(10, "带噪直线拟合失败");
        if (f.rss() <= 0.0 || f.r2() <= 0.0 || f.r2() >= 1.0)
            return err(11, "带噪数据的 rss/r2 范围不对");
    }
    /* 退化与非法参数 */
    {
        double same[3] = { 1, 1, 1 };
        double yv[3] = { 2, 4, 6 };

        if (f.poly(same, yv, 3, 1) != -1)
            return err(12, "x 全相同应该奇异");
        if (f.poly(xs, ys, 2, 3) != -1)
            return err(13, "点数不足应该 -1");
        if (f.poly(xs, ys, 5, 9) != -1)
            return err(14, "次数超限应该 -1");
        if (f.line(0, ys, 5) != -1)
            return err(15, "空指针应该 -1");
        /* 常数序列：r2 按 1 处理 */
        {
            double cy[4] = { 5, 5, 5, 5 };
            double cx[4] = { 0, 1, 2, 3 };

            f.line(cx, cy, 4);
            if (fabs(f.coef(0) - 5.0) > 1e-9 || fabs(f.r2() - 1.0) > 1e-12)
                return err(16, "常数序列应该拟合为 y=5");
        }
    }
}
