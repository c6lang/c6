/* std/text/diff：行级差异（LCS）与 unified / script 两种输出。
 *
 *     import std.text.diff;
 *
 *     char work[16384] = { 0 };
 *     Arena ar = arena_make(work, (int)sizeof work);
 *     Diff d = diff_make(&ar, old_text, new_text);
 *     d.write_unified(S(""), 3);      // 先量长度；返回 0 说明一行不差
 *
 * 算法是 **Hirschberg 的线性空间 LCS**：时间 O(na*nb)，额外空间 O(nb)
 * （两行 DP + 匹配表）。先剥掉公共前缀/后缀，所以「在长文件里改几行」这种
 * 常见情形接近线性；只有在中间大段互不相同时才会退到 O(na*nb) 的行比较。
 *
 * 行怎么切：`\n` 结尾算一行，最后一行没有 `\n` 也算一行；空文本 0 行。
 * `\r` 是行内容的一部分（`\r\n` 不会被折叠），比较时按字节相等。
 *
 * 内存：所有工作区都从调用方给的 `Arena` 里分（不 malloc），需要
 * `na + nb + 2*min(na,nb) + 2*(nb+1)` 个 int 左右；不够时 `err = DIFF_ENOMEM`，
 * 之后所有写接口都返回 -1。想省内存就把工作区开得刚好（先量后分）。
 *
 * 输出两种：
 *   - `write_script`：只有 ` `/`-`/`+` 前缀的行，适合自己再染色；
 *   - `write_unified`：`@@ -a,b +c,d @@` 的 hunk（和 `diff -u` 同形，不含
 *     `---`/`+++` 文件头，那两行由调用方补）。
 * 两个接口都是**先量再写**：放不下返回 -1，一个字节都不写。
 */
#include <string.h>

module std.text.diff;
import std.core.types;
import std.core.mem;

/* 一行在编辑脚本里的角色 */
enum DiffKind {
    DIFF_EQUAL = 0,
    DIFF_DEL = 1,
    DIFF_INS = 2,
};

/* diff_make 的失败码 */
enum DiffErr {
    DIFF_OK = 0,
    DIFF_ENOMEM = 1,
};

/* 一条编辑动作：kind 决定 a / b 哪个有意义（另一个是 -1） */
struct DiffOp {
    int kind;
    int a;
    int b;
};

/* LCS 匹配对（内部用） */
struct DiffMatch {
    int a;
    int b;
};

struct Diff {
    char[:] a;
    char[:] b;
    int na;
    int nb;
    int *sa;           /* 旧文本每行起点 */
    int *sb;           /* 新文本每行起点 */
    DiffOp *ops;
    int nops;
    int added;         /* 新增行数 */
    int removed;       /* 删除行数 */
    int same;          /* 相同行数 */
    int err;
    /* 内部工作区（调用方不用碰） */
    DiffMatch *ms;
    int nm;
    int *row1;
    int *row2;
};

/* ---- 行视图 ---- */

static int count_lines(char[:] t)
{
    int n = 0, i = 0;

    if (t.len <= 0)
        return 0;
    for (i = 0; i < t.len; i++)
        if (t.data[i] == '\n')
            n++;
    if (t.data[t.len - 1] != '\n')
        n++;
    return n;
}

static void split_lines(char[:] t, int *starts)
{
    int n = 0, i = 0, s = 0;

    for (i = 0; i < t.len; i++) {
        if (t.data[i] == '\n') {
            starts[n++] = s;
            s = i + 1;
        }
    }
    if (t.len > 0 && t.data[t.len - 1] != '\n')
        starts[n++] = s;
}

/* 第 i 行的结束位置（不含行尾的 '\n'） */
static int line_end(char[:] t, int *starts, int n, int i)
{
    if (i + 1 < n)
        return starts[i + 1] - 1;
    if (t.len > 0 && t.data[t.len - 1] == '\n')
        return t.len - 1;
    return t.len;
}

static int line_eq(Diff *d, int ai, int bi)
{
    int as = d->sa[ai], bs = d->sb[bi];
    int ae = line_end(d->a, d->sa, d->na, ai);
    int be = line_end(d->b, d->sb, d->nb, bi);

    if (ae - as != be - bs)
        return 0;
    if (ae == as)
        return 1;
    return memcmp(d->a.data + as, d->b.data + bs, (usize)(ae - as)) == 0;
}

/* ---- Hirschberg LCS ---- */

/* row[j] = LCS(a[a0..a1), b[b0..b0+j)) */
static void lcs_forward(Diff *d, int a0, int a1, int b0, int b1, int *row)
{
    int len = b1 - b0, i = 0, j = 0, diag = 0, up = 0;

    for (j = 0; j <= len; j++)
        row[j] = 0;
    for (i = a0; i < a1; i++) {
        diag = 0;
        for (j = 0; j < len; j++) {
            up = row[j + 1];
            if (line_eq(d, i, b0 + j))
                row[j + 1] = diag + 1;
            else if (row[j] > row[j + 1])
                row[j + 1] = row[j];
            diag = up;
        }
    }
}

/* row[j] = LCS(a[a0..a1), b[b0+j..b1)) */
static void lcs_backward(Diff *d, int a0, int a1, int b0, int b1, int *row)
{
    int len = b1 - b0, i = 0, j = 0;

    for (j = 0; j <= len; j++)
        row[j] = 0;
    for (i = a1 - 1; i >= a0; i--) {
        for (j = len - 1; j >= 0; j--) {
            if (line_eq(d, i, b0 + j))
                row[j] = row[j + 1] + 1;
            else if (row[j + 1] > row[j])
                row[j] = row[j + 1];
        }
    }
}

static void lcs_rec(Diff *d, int a0, int a1, int b0, int b1)
{
    int mid = 0, j = 0, len = b1 - b0, best = -1, bestj = 0, v = 0;

    if (a0 >= a1 || b0 >= b1)
        return;
    if (a1 - a0 == 1) {
        for (j = b0; j < b1; j++) {
            if (line_eq(d, a0, j)) {
                d->ms[d->nm].a = a0;
                d->ms[d->nm].b = j;
                d->nm++;
                return;
            }
        }
        return;
    }
    mid = (a0 + a1) / 2;
    lcs_forward(d, a0, mid, b0, b1, d->row1);
    lcs_backward(d, mid, a1, b0, b1, d->row2);
    for (j = 0; j <= len; j++) {
        v = d->row1[j] + d->row2[j];
        if (v > best) {
            best = v;
            bestj = j;
        }
    }
    lcs_rec(d, a0, mid, b0, b0 + bestj);
    lcs_rec(d, mid, a1, b0 + bestj, b1);
}

/* ---- 编辑脚本 ---- */

static void push_op(Diff *d, int kind, int a, int b)
{
    d->ops[d->nops].kind = kind;
    d->ops[d->nops].a = a;
    d->ops[d->nops].b = b;
    d->nops++;
}

static void build_ops(Diff *d)
{
    int i = 0, j = 0, mi = 0, na_next = 0, nb_next = 0;

    while (i < d->na && j < d->nb) {
        if (mi < d->nm && d->ms[mi].a == i && d->ms[mi].b == j) {
            push_op(d, DIFF_EQUAL, i, j);
            d->same++;
            i++;
            j++;
            mi++;
            continue;
        }
        na_next = (mi < d->nm) ? d->ms[mi].a : d->na;
        nb_next = (mi < d->nm) ? d->ms[mi].b : d->nb;
        while (i < na_next) {
            push_op(d, DIFF_DEL, i, -1);
            d->removed++;
            i++;
        }
        while (j < nb_next) {
            push_op(d, DIFF_INS, -1, j);
            d->added++;
            j++;
        }
        if (mi >= d->nm)
            break;
    }
    while (i < d->na) {
        push_op(d, DIFF_DEL, i, -1);
        d->removed++;
        i++;
    }
    while (j < d->nb) {
        push_op(d, DIFF_INS, -1, j);
        d->added++;
        j++;
    }
}

/* ---- 输出：先量再写 ---- */

struct DiffOut {
    char[:] buf;
    int n;
    int count_only;
};

static void w_bytes(DiffOut *o, const char *p, int n)
{
    if (!o->count_only && o->n + n <= o->buf.len && n > 0)
        memcpy(o->buf.data + o->n, p, (usize)n);
    o->n += n;
}

static void w_int(DiffOut *o, int v)
{
    char tmp[12] = { 0 };
    int n = 0, i = 0;

    if (v <= 0) {
        w_bytes(o, "0", 1);
        return;
    }
    while (v > 0 && n < 12) {
        tmp[n++] = (char)('0' + v % 10);
        v /= 10;
    }
    for (i = n - 1; i >= 0; i--)
        w_bytes(o, &tmp[i], 1);
}

static void w_line(DiffOut *o, char prefix, char[:] t, int start, int end)
{
    w_bytes(o, &prefix, 1);
    if (end > start)
        w_bytes(o, t.data + start, end - start);
    w_bytes(o, "\n", 1);
}

static void w_op(Diff *d, DiffOut *o, int idx)
{
    DiffOp *op = &d->ops[idx];

    if (op->kind == DIFF_EQUAL)
        w_line(o, ' ', d->a, d->sa[op->a],
               line_end(d->a, d->sa, d->na, op->a));
    else if (op->kind == DIFF_DEL)
        w_line(o, '-', d->a, d->sa[op->a],
               line_end(d->a, d->sa, d->na, op->a));
    else
        w_line(o, '+', d->b, d->sb[op->b],
               line_end(d->b, d->sb, d->nb, op->b));
}

static void render_script(Diff *d, DiffOut *o)
{
    int i = 0;

    for (i = 0; i < d->nops; i++)
        w_op(d, o, i);
}

static void render_unified(Diff *d, int ctx, DiffOut *o)
{
    int i = 0, a_done = 0, b_done = 0;

    if (ctx < 0)
        ctx = 0;
    while (i < d->nops) {
        int s = 0, e = 0, k = 0, back = 0, run = 0;
        int a_s = 0, b_s = 0, a_e = 0, b_e = 0;

        if (d->ops[i].kind == DIFF_EQUAL) {
            a_done++;
            b_done++;
            i++;
            continue;
        }
        s = i;
        back = 0;
        while (s > 0 && d->ops[s - 1].kind == DIFF_EQUAL && back < ctx) {
            s--;
            back++;
        }
        e = i + 1;
        for (;;) {
            k = e;
            run = 0;
            while (k < d->nops && d->ops[k].kind == DIFF_EQUAL && run < ctx) {
                k++;
                run++;
            }
            if (k < d->nops && d->ops[k].kind != DIFF_EQUAL) {
                e = k + 1;          /* 这段变更也吃进来，继续往后扫 */
                continue;
            }
            e = k;
            break;
        }
        a_s = a_done - back;
        b_s = b_done - back;
        a_e = a_s;
        b_e = b_s;
        for (k = s; k < e; k++) {
            if (d->ops[k].kind != DIFF_INS)
                a_e++;
            if (d->ops[k].kind != DIFF_DEL)
                b_e++;
        }
        w_bytes(o, "@@ -", 4);
        w_int(o, a_e == a_s ? a_s : a_s + 1);
        w_bytes(o, ",", 1);
        w_int(o, a_e - a_s);
        w_bytes(o, " +", 2);
        w_int(o, b_e == b_s ? b_s : b_s + 1);
        w_bytes(o, ",", 1);
        w_int(o, b_e - b_s);
        w_bytes(o, " @@\n", 4);
        for (k = s; k < e; k++)
            w_op(d, o, k);
        for (k = s; k < e; k++) {
            if (d->ops[k].kind != DIFF_INS)
                a_done++;
            if (d->ops[k].kind != DIFF_DEL)
                b_done++;
        }
        i = e;
    }
}

int script_len(Diff *self)
{
    DiffOut o = { { (char *)0, 0 }, 0, 1 };

    if (self->err)
        return -1;
    render_script(self, &o);
    return o.n;
}

int unified_len(Diff *self, int ctx)
{
    DiffOut o = { { (char *)0, 0 }, 0, 1 };

    if (self->err)
        return -1;
    render_unified(self, ctx, &o);
    return o.n;
}

int write_script(Diff *self, char[:] out)
{
    DiffOut o = { { (char *)0, 0 }, 0, 0 };
    int need = script_len(self);

    if (need < 0)
        return -1;
    if (need > out.len)
        return -1;
    o.buf = out;
    render_script(self, &o);
    return o.n;
}

int write_unified(Diff *self, char[:] out, int ctx)
{
    DiffOut o = { { (char *)0, 0 }, 0, 0 };
    int need = unified_len(self, ctx);

    if (need < 0)
        return -1;
    if (need > out.len)
        return -1;
    o.buf = out;
    render_unified(self, ctx, &o);
    return o.n;
}

/* 取第 i 条编辑动作：成功返回 1 */
int op_at(Diff *self, int i, DiffOp *out)
{
    if (!out || i < 0 || i >= self->nops)
        return 0;
    *out = self->ops[i];
    return 1;
}

/* ---- 工厂 ---- */

/* 比较两段文本：a 是旧、b 是新。所有工作区从 ar 里分。 */
Diff diff_make(Arena *ar, char[:] a, char[:] b)
{
    Diff d = { { (char *)0, 0 }, { (char *)0, 0 }, 0, 0,
               (int *)0, (int *)0, (DiffOp *)0, 0, 0, 0, 0, DIFF_OK,
               (DiffMatch *)0, 0, (int *)0, (int *)0 };
    int pre = 0, suf = 0, i = 0;
    int cap = 0;

    d.a = a;
    d.b = b;
    d.na = count_lines(a);
    d.nb = count_lines(b);
    d.sa = (int *)ar->alloc_array(d.na > 0 ? d.na : 1, (int)sizeof(int));
    d.sb = (int *)ar->alloc_array(d.nb > 0 ? d.nb : 1, (int)sizeof(int));
    cap = (d.na < d.nb ? d.na : d.nb) + 1;
    d.ms = (DiffMatch *)ar->alloc_array(cap, (int)sizeof(DiffMatch));
    d.row1 = (int *)ar->alloc_array(d.nb + 1, (int)sizeof(int));
    d.row2 = (int *)ar->alloc_array(d.nb + 1, (int)sizeof(int));
    d.ops = (DiffOp *)ar->alloc_array(d.na + d.nb + 1, (int)sizeof(DiffOp));
    if (!d.sa || !d.sb || !d.ms || !d.row1 || !d.row2 || !d.ops) {
        d.err = DIFF_ENOMEM;
        return d;
    }
    split_lines(a, d.sa);
    split_lines(b, d.sb);

    /* 公共前缀 / 后缀先剥掉：常见编辑只动中间一小段 */
    while (pre < d.na && pre < d.nb && line_eq(&d, pre, pre))
        pre++;
    while (suf < d.na - pre && suf < d.nb - pre
           && line_eq(&d, d.na - 1 - suf, d.nb - 1 - suf))
        suf++;
    for (i = 0; i < pre; i++) {
        d.ms[d.nm].a = i;
        d.ms[d.nm].b = i;
        d.nm++;
    }
    lcs_rec(&d, pre, d.na - suf, pre, d.nb - suf);
    for (i = 0; i < suf; i++) {
        d.ms[d.nm].a = d.na - suf + i;
        d.ms[d.nm].b = d.nb - suf + i;
        d.nm++;
    }
    build_ops(&d);
    return d;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static char dwork[65536] = { 0 };

/* 生成 "tagNNN\n"，返回写入的字节数（不含结尾 NUL） */
static int d_gen(char *buf, const char *tag, int i)
{
    int n = 0;

    while (tag[n]) {
        buf[n] = tag[n];
        n++;
    }
    buf[n++] = (char)('0' + (i / 100) % 10);
    buf[n++] = (char)('0' + (i / 10) % 10);
    buf[n++] = (char)('0' + i % 10);
    buf[n++] = '\n';
    buf[n] = 0;
    return n;
}

test "行切分与整体统计" {
    Arena ar = arena_make(dwork, (int)sizeof dwork);
    Diff d = diff_make(&ar, S("a\nb\nc\n"), S("a\nb\nc\n"));

    if (d.err)
        return err(1, "arena 不够");
    if (d.na != 3 || d.nb != 3)
        return err(2, "行数不对");
    if (d.nops != 3 || d.added != 0 || d.removed != 0 || d.same != 3)
        return err(3, "相同文本不该有变更");
    if (d.script_len() != 9)
        return err(4, "script 长度");
    d = diff_make(&ar, S(""), S(""));
    if (d.na != 0 || d.nb != 0 || d.nops != 0)
        return err(5, "空文本");
    d = diff_make(&ar, S("x"), S("x"));
    if (d.na != 1 || d.nb != 1 || d.nops != 1)
        return err(6, "没有换行的单行");
    d = diff_make(&ar, S("a\nb"), S("a\nb\n"));
    if (d.na != 2 || d.nb != 2)
        return err(7, "末尾换行不该多出一行");
}

test "替换、插入、删除" {
    Arena ar = arena_make(dwork, (int)sizeof dwork);
    Diff d = diff_make(&ar, S("a\nb\nc\n"), S("a\nx\nc\n"));

    if (d.removed != 1 || d.added != 1 || d.same != 2)
        return err(8, "替换的统计");
    if (d.script_len() != 12)
        return err(9, "script 长度（替换）");
    d = diff_make(&ar, S("a\nc\n"), S("a\nb\nc\n"));
    if (d.added != 1 || d.removed != 0 || d.same != 2)
        return err(10, "插入");
    if (d.script_len() != 9)
        return err(11, "script 长度（插入）");
    d = diff_make(&ar, S("a\nb\nc\n"), S("a\nc\n"));
    if (d.removed != 1 || d.added != 0)
        return err(12, "删除");
    d = diff_make(&ar, S(""), S("a\nb\n"));
    if (d.added != 2 || d.removed != 0 || d.nops != 2)
        return err(13, "全新增");
    d = diff_make(&ar, S("a\nb\n"), S(""));
    if (d.removed != 2 || d.added != 0)
        return err(14, "全删除");
    /* 非连续变更：插入夹在中间 */
    d = diff_make(&ar, S("a\nb\nc\n"), S("a\nb\nB\nc\n"));
    if (d.added != 1 || d.removed != 0 || d.same != 3 || d.nops != 4)
        return err(15, "中间插入");
}

test "script 输出" {
    Arena ar = arena_make(dwork, (int)sizeof dwork);
    Diff d = diff_make(&ar, S("a\nb\nc\n"), S("a\nx\nc\n"));
    char buf[64] = { 0 };
    char[:] out = { buf, (int)sizeof buf };
    int n = 0, i = 0;
    DiffOp op = { 0 };

    n = d.write_script(out);
    if (n != 12 || strcmp(buf, " a\n-b\n+x\n c\n") != 0)
        return err(16, "script 内容");
    if (!d.op_at(0, &op) || op.kind != DIFF_EQUAL || op.a != 0 || op.b != 0)
        return err(17, "op_at 第一条");
    if (!d.op_at(1, &op) || op.kind != DIFF_DEL || op.a != 1 || op.b != -1)
        return err(18, "op_at 删除");
    if (!d.op_at(2, &op) || op.kind != DIFF_INS || op.a != -1 || op.b != 1)
        return err(19, "op_at 新增");
    if (d.op_at(4, &op))
        return err(20, "op_at 越界");
    /* 放不下：一个字节都不写 */
    out = (char[:]){ buf, 3 };
    for (i = 0; i < 8; i++)
        buf[i] = 'Z';
    if (d.write_script(out) != -1)
        return err(21, "放不下应该返回 -1");
    for (i = 0; i < 8; i++)
        if (buf[i] != 'Z')
            return err(22, "放不下时写了半截");
}

test "unified 输出与上下文" {
    Arena ar = arena_make(dwork, (int)sizeof dwork);
    char buf[512] = { 0 };
    char[:] out = { buf, (int)sizeof buf };
    Diff d = diff_make(&ar, S("1\n2\n3\n4\n5\n6\n7\n8\n"),
                       S("1\n2\n3\nX\n5\n6\n7\n8\n"));
    int n = 0;

    n = d.write_unified(out, 1);
    if (n <= 0 || n != (int)strlen(buf))
        return err(23, "unified 没写出来");
    if (strcmp(buf, "@@ -3,3 +3,3 @@\n 3\n-4\n+X\n 5\n") != 0)
        return err(24, "unified 内容（ctx=1）");
    buf[0] = 0;
    n = d.write_unified(out, 4);
    if (strcmp(buf, "@@ -1,8 +1,8 @@\n 1\n 2\n 3\n-4\n+X\n 5\n 6\n 7\n 8\n") != 0)
        return err(25, "unified 内容（ctx=4）");
    if (d.unified_len(4) != n)
        return err(26, "unified_len 与写出的长度不一致");
    /* 两处变更离得远 → 两个 hunk */
    d = diff_make(&ar, S("a\nb\nc\nd\ne\nf\ng\nh\ni\nj\n"),
                  S("A\nb\nc\nd\ne\nf\ng\nh\ni\nJ\n"));
    buf[0] = 0;
    n = d.write_unified(out, 1);
    if (strcmp(buf, "@@ -1,2 +1,2 @@\n-a\n+A\n b\n@@ -9,2 +9,2 @@\n i\n-j\n+J\n") != 0)
        return err(27, "两个 hunk");
    /* ctx 足够大时全文只有一个 hunk 头 */
    buf[0] = 0;
    n = d.write_unified(out, 20);
    if (strncmp(buf, "@@ -1,10 +1,10 @@\n", 18) != 0)
        return err(28, "单个 hunk 的头");
    if (n != d.script_len() + 18)
        return err(29, "ctx 覆盖全文时只多一个头");
}

test "公共前后缀与中间大段" {
    Arena ar = arena_make(dwork, (int)sizeof dwork);
    static char old[4096] = { 0 };
    static char new[4096] = { 0 };
    int i = 0, no = 0, nn = 0;
    Diff d = { 0 };

    /* 200 行里只有 100..102 三行不同，前后都是长公共段 */
    for (i = 0; i < 200; i++)
        no += d_gen(old + no, "same", i);
    for (i = 0; i < 200; i++) {
        if (i >= 100 && i < 103)
            nn += d_gen(new + nn, "diff", i);
        else
            nn += d_gen(new + nn, "same", i);
    }
    d = diff_make(&ar, (char[:]){ old, no }, (char[:]){ new, nn });
    if (d.err || d.removed != 3 || d.added != 3 || d.same != 197)
        return err(30, "前后缀剥离后的统计");
    /* 全不同：走完整个 LCS */
    d = diff_make(&ar, S("a\nb\nc\n"), S("x\ny\nz\n"));
    if (d.removed != 3 || d.added != 3 || d.same != 0)
        return err(31, "全不同");
}

test "工作区不够" {
    static char tiny[64] = { 0 };
    Arena ar = arena_make(tiny, (int)sizeof tiny);
    Diff d = diff_make(&ar, S("a\nb\nc\n"), S("a\nx\nc\n"));
    char buf[64] = { 0 };

    if (d.err != DIFF_ENOMEM)
        return err(32, "小 arena 应该报 ENOMEM");
    if (d.write_script((char[:]){ buf, (int)sizeof buf }) != -1)
        return err(33, "ENOMEM 之后写接口要给 -1");
    if (d.script_len() != -1 || d.unified_len(3) != -1)
        return err(34, "ENOMEM 之后长度接口要给 -1");
}
