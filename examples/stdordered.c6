/* examples/stdordered.c6 —— 第五十二批（有序容器）的集成示例。
 *
 *     cmake --build build --target std-ordered
 *
 * 四节：Treap（按排名 / 第 k 小）、二叉堆（top-k 与堆排序）、跳表（有序遍历）、
 * 频次计数器（最多出现的键）。
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.text.str;
import std.container.treap;
import std.container.heap;
import std.container.skiplist;
import std.container.counter;

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int checks = 0;
static int fails = 0;

static void check(int cond, const char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("   ✗ %s\n", what);
    }
}

static void do_treap(void)
{
    TreapNode nodes[32] = { 0 };
    Treap t = { 0 };
    i64 old = 0, key = 0;
    int i = 0;

    printf("== treap\n");
    check(t.init(nodes, 32) == 1, "初始化");
    for (i = 0; i < 10; i++)
        t.put((i64)(i * 3), (i64)i, &old);
    printf("   插入 %d 个键，最小 %lld，第 5 小 ", t.size(),
           (long long)nodes[0].key);
    t.kth(5, &key);
    printf("%lld\n", (long long)key);
    check(t.size() == 10, "元素数");
    check(t.get(15, &key) == 1 && key == 5, "取键 15 的值");
    check(t.rank(15) == 5, "比 15 小的有 5 个");
    check(t.kth(0, &key) == 1 && key == 0, "第 0 小是 0");
    check(t.kth(9, &key) == 1 && key == 27, "第 9 小是 27");
    check(t.del(15) == 1 && t.get(15, &key) == 0, "删除 15");
    check(t.kth(5, &key) == 1 && key == 18, "删除后第 5 小是 18");
}

static void do_heap(void)
{
    i64 buf[16] = { 0 };
    Heap h = { 0 };
    i64 v = 0;
    static const i64 vals[8] = { 42, 7, 19, 3, 88, 23, 5, 61 };
    int i = 0, top3 = 0;

    printf("== heap\n");
    h.init(buf, 16, 1);
    for (i = 0; i < 8; i++)
        h.push(vals[i]);
    printf("   最大堆顶 = ");
    h.peek(&v);
    printf("%lld\n", (long long)v);
    check(v == 88, "最大堆顶是 88");
    /* 取前 3 大 */
    {
        i64 sum = 0;

        for (i = 0; i < 3; i++) {
            h.pop(&v);
            sum += v;
            top3 = top3 * 10 + (int)(v % 10);
        }
        printf("   前 3 大：和 = %lld\n", (long long)sum);
        check(sum == 88 + 61 + 42, "前 3 大之和");
    }
    /* 最小堆排序得到降序 */
    {
        i64 raw[5] = { 5, 1, 4, 2, 3 };
        Heap m = { 0 };

        m.build(raw, 5, 0);
        m.sort();
        check(raw[0] == 5 && raw[4] == 1, "最小堆排序得到降序");
    }
    /* pushpop 常用在 top-k */
    {
        Heap k = { 0 };
        i64 kb[4] = { 0 };

        k.init(kb, 4, 0);
        k.push(10);
        k.push(20);
        k.push(30);
        k.pushpop(15, &v);
        check(v == 10, "最小堆 pushpop 返回 10");
        k.pushpop(25, &v);
        check(v == 15, "再 pushpop 返回 15");
    }
}

static void do_skiplist(void)
{
    SkipNode nodes[32] = { 0 };
    SkipList sl = { 0 };
    i64 old = 0, key = 0, val = 0, cur = 0;
    int i = 0, count = 0;
    char line[128] = { 0 };
    int o = 0;

    printf("== skiplist\n");
    check(sl.init(nodes, 32) == 1, "初始化");
    for (i = 0; i < 8; i++)
        sl.put((i64)((i * 5) % 8), (i64)(i * 100), &old);
    printf("   有序键：");
    if (sl.first(&cur, &val)) {
        for (;;) {
            o += snprintf(line + o, sizeof line - o, "%lld ", (long long)cur);
            count++;
            if (!sl.next(cur, &cur, &val))
                break;
        }
    }
    printf("%s（%d 个）\n", line, count);
    check(count == 8, "遍历到 8 个键");
    check(strcmp(line, "0 1 2 3 4 5 6 7 ") == 0, "键是升序的 0..7");
    check(sl.get(3, &val) == 1 && val == 700, "键 3 的值是 700");
    check(sl.del(3) == 1 && sl.size() == 7, "删除键 3");
    check(sl.at(3, &key, &val) == 1 && key == 4, "删除后第 3 个是 4");
}

static void do_counter(void)
{
    CounterSlot slots[256] = { 0 };
    Counter c = { 0 };
    char top[32] = { 0 };
    i64 n = 0;
    static const char *words[6] = { "GET", "PUT", "GET", "POST", "GET", "PUT" };
    int i = 0;

    printf("== counter\n");
    check(c.init(slots, 256) == 1, "初始化");
    for (i = 0; i < 6; i++)
        c.add((char[:]){ (char *)words[i], (int)strlen(words[i]) },
                    1);
    printf("   GET=%lld PUT=%lld POST=%lld，不同键 %d 个\n",
           (long long)c.get(S("GET")),
           (long long)c.get(S("PUT")),
           (long long)c.get(S("POST")), c.keys());
    check(c.get(S("GET")) == 3, "GET 出现 3 次");
    check(c.get(S("PUT")) == 2, "PUT 出现 2 次");
    check(c.get(S("POST")) == 1, "POST 出现 1 次");
    check(c.keys() == 3 && c.sum() == 6, "键数与总量");
    check(c.top(top, (int)sizeof top, &n) == 1 && n == 3
          && strcmp(top, "GET") == 0, "最多的是 GET");
    check(c.get(S("DELETE")) == 0, "没见过的键是 0");
}

int main(void)
{
    do_treap();
    do_heap();
    do_skiplist();
    do_counter();
    printf("\n%d check(s), %d failure(s)\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
