/* c6 自测：shared 的原子计数跨线程（引用计数 GC，阶段 P5）
 *
 * 运行（仓库根目录）：
 *   ./tcc/tcc -B tcc -test tests/gc_thread.c6
 *
 * 'shared @T' 的计数是原子的：它可以从一个线程转到另一个线程。'go' 的
 * 实参块在进入时 +1、trampoline 返回时 −1，所以线程活多久对象就活多久，
 * 即使启动它的线程已经放手（P5 之前这是 UAF）。
 *
 * 跨线程只能传 'shared @T'；传普通 '@T' 是编译错误（E-GC10，见
 * tests/errors/gc_borrow.c6）。
 */
#include <stdio.h>
#include <unistd.h>

struct Node { int v; };

/* 有上界的空转：出错时报失败，而不是挂住 */
static int wait_flag(volatile int *p)
{
    int i = 0;

    for (i = 0; i < 20000 && *p == 0; i++)
        usleep(1000);
    return *p;
}

/* 有上界的等待：等 live 降到 want */
static int wait_live(unsigned long want)
{
    int i = 0;

    for (i = 0; i < 20000 && __c6_gc_live() > want; i++)
        usleep(1000);
    return __c6_gc_live() == want;
}

/* 有上界的等待：等某个对象的计数降到 want（live 计数看不出“还有几个持有者”） */
static int wait_rc(void *p, unsigned long want)
{
    int i = 0;

    for (i = 0; i < 20000 && __c6_gc_refcount(p) > want; i++)
        usleep(1000);
    return __c6_gc_refcount(p) == want;
}

/* ---- 1. 线程里读到的引用是活的（实参块持有一份） ---- */
static volatile int t1_done = 0;
static int t1_v = 0;
static unsigned long t1_rc = 0;

void t1_worker(shared @Node n)
{
    t1_v = n->v;
    t1_rc = __c6_gc_refcount(n);   /* 主线程 1 + 实参块 1 */
    t1_done = 1;
}

test "go 的实参块持有一份引用" {
    shared @Node p = new shared Node;
    p->v = 71;
    t1_done = 0;
    if (__c6_gc_refcount(p) != 1)
        err(1, "new 之后计数不是 1");
    go t1_worker(p);
    if (!wait_flag(&t1_done))
        err(2, "线程没有跑");
    if (t1_v != 71)
        err(3, "线程里没读到内容");
    if (t1_rc != 2)
        err(4, "线程里计数应为 2（主线程 + 实参块）");
    if (!wait_rc(p, 1))
        err(5, "线程退出后实参块没有归还引用");
}

/* ---- 2. 主线程放手，线程继续用 ---- */
static volatile int t2_ready = 0;
static volatile int t2_go = 0;
static volatile int t2_v = 0;

void t2_worker(shared @Node n)
{
    t2_ready = 1;
    /* 等主线程把自己的那份丢掉，这里再读：靠实参块活着 */
    while (!t2_go)
        ;
    t2_v = n->v;
}

test "启动者放手后对象仍然活着" {
    shared @Node p = new shared Node;
    p->v = 72;
    t2_ready = 0;
    t2_go = 0;
    go t2_worker(p);
    if (!wait_flag(&t2_ready))
        err(10, "线程没有跑");
    p = NULL;                      /* 主线程这份没了 */
    if (__c6_gc_live() != 1)
        err(11, "主线程放手后对象不该消失（实参块还持有）");
    t2_go = 1;
    if (!wait_live(0))
        err(12, "线程退出后对象应当释放");
    if (t2_v != 72)
        err(13, "线程读到的内容不对");
}

/* ---- 3. 交接：两个线程把一个引用传给主线程 ---- */
static shared @Node g_slot = NULL;
static volatile int t3_done = 0;

void t3_worker(shared @Node n)
{
    g_slot = n;                    /* 存进全局托管槽：+1 */
    t3_done = 1;
}

test "跨线程交接（存进 shared 全局）" {
    shared @Node p = new shared Node;
    p->v = 73;
    g_slot = NULL;
    t3_done = 0;
    go t3_worker(p);
    if (!wait_flag(&t3_done))
        err(20, "线程没有跑");
    if (!wait_rc(g_slot, 2))
        err(21, "实参块没有归还");
    if (g_slot == NULL || g_slot->v != 73)
        err(22, "交接过来的引用不能用");
    if (__c6_gc_refcount(p) != 2)
        err(23, "交接后计数应为 2（p + g_slot）");
    p = NULL;
    if (__c6_gc_refcount(g_slot) != 1)
        err(24, "放手后计数应为 1");
    g_slot = NULL;
    if (__c6_gc_live() != 0)
        err(25, "接管者放手后对象应当释放");
}

/* ---- 4. 两个线程同时对同一个对象加减计数 ---- */
/* 每个线程写自己的全局槽：槽本身不是原子的，两个线程写同一个槽是测试自己的
   数据竞争，不是 GC 的问题 */
static shared @Node g_t4a = NULL;
static shared @Node g_t4b = NULL;
static volatile int t4_go = 0;
static volatile int t4_done = 0;

void t4_worker_a(shared @Node n)
{
    g_t4a = n;                     /* +1 */
    t4_done++;
    while (!t4_go)
        ;
    g_t4a = NULL;                  /* −1 */
}

void t4_worker_b(shared @Node n)
{
    g_t4b = n;                     /* +1 */
    t4_done++;
    while (!t4_go)
        ;
    g_t4b = NULL;                  /* −1 */
}

test "两个线程同时对同一个对象加减" {
    shared @Node p = new shared Node;
    p->v = 74;
    g_t4a = NULL;
    g_t4b = NULL;
    t4_go = 0;
    t4_done = 0;
    go t4_worker_a(p);
    go t4_worker_b(p);
    {   int i = 0;
        while (t4_done < 2 && i < 20000) { usleep(1000); i++; }
    }
    /* 主线程 1 + 两个实参块 2 + 两个全局槽 2 = 5：并发的 +1 一个都不能丢 */
    if (__c6_gc_refcount(p) != 5)
        err(30, "两个线程都持有后计数应为 5");
    t4_go = 1;
    if (!wait_rc(p, 1))
        err(31, "线程退出后计数应回到 1");
}
