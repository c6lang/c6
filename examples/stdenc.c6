/* stdenc：标准库第三十一批（编码/凭据）的拼装示例。
 *
 * 没有 `module`（入口 `main` 只能写在模块外的文件里），各节自带自检。
 *
 *   1. asn1：一个手写的 DER 结构（SEQUENCE{ INTEGER, OID, UTF8String, UTCTime }）
 *      逐层读出来；
 *   2. x509：一张 openssl 生成的自签证书，取版本/序列号/CN/有效期/公钥位数；
 *   3. jwt：HS256 令牌验签（payload 里的 sub），再改一个字节看它被拒；
 *   4. otp：RFC 4226 的计数器码与 RFC 6238 的时间码，各打几个。
 *
 * 编译（import 只带来声明，模块正文要单独列出来）：
 *
 *     ./tcc/c6 -B tcc -I . -o build/stdenc \
 *         examples/stdenc.c6 std/core/types.c6 std/core/bits.c6 \
 *         std/text/str.c6 std/encoding/asn1.c6 std/encoding/base64.c6 \
 *         std/encoding/sha1.c6 std/encoding/sha256.c6 std/encoding/sha512.c6 \
 *         std/encoding/otp.c6 std/data/x509.c6 std/data/jwt.c6
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.text.str;
import std.encoding.asn1;
import std.encoding.otp;
import std.data.x509;
import std.data.jwt;

static int checks = 0;
static int fails = 0;

static void check(int cond, char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("FAIL: %s\n", what);
    }
}

static int hexval(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    return -1;
}

static int unhex(const char *s, u8 *dst, int cap)
{
    int n = 0;

    while (s[0] && s[1] && n < cap) {
        int hi = hexval(s[0]), lo = hexval(s[1]);

        if (hi < 0 || lo < 0)
            return -1;
        dst[n++] = (u8)(hi * 16 + lo);
        s += 2;
    }
    return n;
}

static const char *CERT_DER =
    "3082033930820221a00302010202021092300d06092a864886f70d01010b0500"
    "3035310b300906035504061302434e310f300d060355040a0c06537570657243"
    "3115301306035504030c0c6578616d706c652e74657374301e170d3236313131"
    "323135323331345a170d3336313130393135323331345a3035310b3009060355"
    "04061302434e310f300d060355040a0c06537570657243311530130603550403"
    "0c0c6578616d706c652e7465737430820122300d06092a864886f70d01010105"
    "000382010f003082010a0282010100b2414e0a4ad885526efbf8ebf3d54a09fa"
    "12a714daae55cc8af8c1824c0ee80cef182a7d7043c529301f066daaf5feab41"
    "f54477cd6d4019f9b5646ee23e00ea6a006d080daa4261b355d1a65f13f7b448"
    "e81748d392d49816f720ade6c0b6227e5c4bf07c78441bfdf8505488ce9494dd"
    "0071c2ce7a9ab46cf27acb81b124fe8e07a314ce1f14e92ce2c68e8db45eef2f"
    "6be84715719518e7a2dccece7750abf42278f57044080d76043edcd56f40d98f"
    "db3db7915da395187f63977f330dfdf4bd2750588a3741e8a73293aab68338c1"
    "fa69ccdb4d1f59634cb47fca9065ee70014fd0f1d0bf2340267138845f2ec028"
    "960b2c6382f3c551ab7d8969d3429d0203010001a3533051301d0603551d0e04"
    "1604140ebd2bd1ee0946cd1fedebd16406193a61448226301f0603551d230418"
    "301680140ebd2bd1ee0946cd1fedebd16406193a61448226300f0603551d1301"
    "01ff040530030101ff300d06092a864886f70d01010b050003820101001aca9a"
    "3633288f2b2d491bf7f2c50cbb353a802856f84be460384bf129ba59ab32e0d5"
    "89a44e6dabd2252d32826eb699814d36a580835afbae7d09710a24eae1df8060"
    "b5517cb3519790d6ec9d001567855b1562e649d6d8bc97b887312704ff671111"
