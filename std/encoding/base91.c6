/* std/encoding/base91：basE91 编解码（Joachim Henke 的 91 字符表，比 base85 更省）。
 *
 *     import std.encoding.base91;
 *
 *     char out[64] = { 0 };
 *     int n = b91_encode(S("Hello"), out, (int)sizeof out);
 *
 * 算法：每 13 位吐两个字符，若「低 13 位」> 88 就只用 13 位（否则用 14 位），
 * 所以平均 1.23 字节/字符。字符表：
 *
 *     A-Z a-z 0-9 ! # $ % & ( ) * + , . / : ; < = > ? @ [ ] ^ _ ` { | } ~ "
 *
 * 约定：
 *
 * - `*_encoded_len` 给的是**上界**（`n*1.23+2`），实际长度以返回值为准；
 * - `b91_encode` 输出不带结尾的 `\0`，返回值不含它；
 * - `b91_decode` 忽略表外的空白字符（空格、`\n`、`\r`、`\t`），其它表外字符算 -1；
 * - `b91_valid` 只看字符是否都在表内（空白允许）；
 * - 解码结果的最后一个字符如果凑不满 8 位会被丢弃（与参考实现一致）。
 */
#include <string.h>

module std.encoding.base91;
import std.core.types;
import std.text.str;

static const char b91_alpha[92] =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    "!#$%&()*+,./:;<=>?@[]^_`{|}~\"";

static int b91_index(char c)
{
    int i = 0;

    for (i = 0; i < 91; i++) {
        if (b91_alpha[i] == c)
            return i;
    }
    return -1;
}

int b91_encoded_len(int n)
{
    if (n <= 0)
        return 0;
    return (n * 123) / 100 + 3;
}

int b91_encode(char[:] src, char *dst, int cap)
{
    int n = src.len, i = 0, o = 0;
    unsigned int b = 0;
    int bits = 0;

    if (n < 0 || !dst || cap <= 0)
        return -1;
    for (i = 0; i < n; i++) {
        b |= (unsigned int)(unsigned char)src.data[i] << bits;
        bits += 8;
        if (bits > 13) {
            unsigned int v = b & 8191u;

            if (v > 88u) {
                b >>= 13;
                bits -= 13;
            } else {
                v = b & 16383u;
                b >>= 14;
                bits -= 14;
            }
            if (o + 2 > cap)
                return -1;
            dst[o++] = b91_alpha[v % 91u];
            dst[o++] = b91_alpha[v / 91u];
        }
    }
    if (bits > 0) {
        if (o + 1 > cap)
            return -1;
        dst[o++] = b91_alpha[b % 91u];
        if (bits > 7 || b > 90u) {
            if (o + 1 > cap)
                return -1;
            dst[o++] = b91_alpha[b / 91u];
        }
    }
    if (o < cap)
        dst[o] = 0;
    return o;
}

int b91_valid(char[:] src)
{
    int i = 0;

    for (i = 0; i < src.len; i++) {
        char c = src.data[i];

        if (c == ' ' || c == '\n' || c == '\r' || c == '\t')
            continue;
        if (b91_index(c) < 0)
            return 0;
    }
    return 1;
}

int b91_decoded_len(char[:] src)
{
    int i = 0, count = 0;

    for (i = 0; i < src.len; i++) {
        char c = src.data[i];

        if (c == ' ' || c == '\n' || c == '\r' || c == '\t')
            continue;
        if (b91_index(c) < 0)
            return -1;
        count++;
    }
    if (count == 0)
        return 0;
    /* 每两个字符最多 14 位 */
    return (count * 7) / 8 + 2;
}

int b91_decode(char[:] src, char *dst, int cap)
{
    int i = 0, o = 0, bits = 0;
    int v = -1;
    unsigned int b = 0;

    if (!dst || cap < 0)
        return -1;
    for (i = 0; i < src.len; i++) {
        char c = src.data[i];
        int d = 0;

        if (c == ' ' || c == '\n' || c == '\r' || c == '\t')
            continue;
        d = b91_index(c);
        if (d < 0)
            return -1;
        if (v < 0) {
            v = d;
        } else {
            v += d * 91;
            b |= (unsigned int)v << bits;
            bits += (v & 8191) > 88 ? 13 : 14;
            while (bits > 7) {
                if (o >= cap)
                    return -1;
                dst[o++] = (char)(b & 0xFFu);
                b >>= 8;
                bits -= 8;
            }
            v = -1;
        }
    }
    if (v >= 0) {
        b |= (unsigned int)v << bits;
        if (o >= cap)
            return -1;
        dst[o++] = (char)(b & 0xFFu);
    }
    return o;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "base91：编码" {
    char out[64] = { 0 };
    int n = 0;

    n = b91_encode(S("Hello"), out, (int)sizeof out);
    if (n != 7 || memcmp(out, ">OwJh>A", 7) != 0)
        return err(1, "Hello 的编码不对");
    n = b91_encode(S(""), out, (int)sizeof out);
    if (n != 0)
        return err(2, "空输入应该 0 字节");
    n = b91_encode(S("abc"), out, (int)sizeof out);
    if (n != 4 || memcmp(out, "#G(I", 4) != 0)
        return err(3, "abc 的编码不对");
    n = b91_encode((char[:]){ (char *)"\x00\x01\x02", 3 }, out,
                   (int)sizeof out);
    if (n != 4 || memcmp(out, ":CQA", 4) != 0)
        return err(4, "三个零字节附近的编码不对");
    if (b91_encoded_len(10) < 12)
        return err(5, "上界太小");
    if (b91_encode(S("Hello"), out, 4) != -1)
        return err(6, "容量不够应该 -1");
}

test "base91：解码与校验" {
    char out[64] = { 0 };
    char back[64] = { 0 };
    int n = 0, m = 0;

    n = b91_decode(S(">OwJh>A"), out, (int)sizeof out);
    if (n != 5 || memcmp(out, "Hello", 5) != 0)
        return err(7, "Hello 解码不对");
    n = b91_decode(S("#G(I"), out, (int)sizeof out);
    if (n != 3 || memcmp(out, "abc", 3) != 0)
        return err(8, "abc 解码不对");
    n = b91_decode(S(":CQA"), out, (int)sizeof out);
    if (n != 3 || out[0] != 0 || out[1] != 1 || out[2] != 2)
        return err(9, "零字节解码不对");
    /* 往返 */
    {
        static const char *msg = "The quick brown fox jumps over the lazy dog";

        n = b91_encode((char[:]){ (char *)msg, (int)strlen(msg) }, out,
                       (int)sizeof out);
        if (n <= 0)
            return err(10, "往返编码失败");
        m = b91_decode((char[:]){ out, n }, back, (int)sizeof back);
        if (m != (int)strlen(msg) || memcmp(back, msg, (size_t)m) != 0)
            return err(11, "往返不一致");
    }
    /* 空白被忽略 */
    if (b91_decode(S(">Ow J\nh>A"), out, (int)sizeof out) != 5)
        return err(12, "空白应该被忽略");
    if (b91_valid(S(">OwJh>A")) != 1)
        return err(13, "合法串应该 1");
    if (b91_valid(S(">OwJh-A")) != 0)
        return err(14, "含非法字符应该 0");
    if (b91_decode(S(">OwJh-A"), out, (int)sizeof out) != -1)
        return err(15, "非法字符解码应该 -1");
    if (b91_decoded_len(S(">OwJh>A")) < 5)
        return err(16, "解码长度上界太小");
}
