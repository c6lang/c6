/* std/data/woff：WOFF 1.0 字体容器（Web Open Font Format）。
 *
 *     import std.data.woff;
 *
 *     WoffInfo info = { 0 };
 *     WoffTable t = { 0 };
 *     if (woff_info(buf, n, &info) == 1
 *         && woff_find(buf, n, "cmap", &t) == 1)
 *         // t.off / t.comp_len / t.orig_len / t.ck_sum
 *
 * 结构：44 字节头（`wOFF` 签名、flavor、长度、表数、`totalSfntSize`、版本、
 * 元数据与私有块的位置长度）+ 每表 20 字节目录（tag、offset、compLength、
 * origLength、origChecksum）+ 表数据（可能 zlib 压缩）。
 *
 * 约定：
 *
 * - 只解析容器，**不解压**：`comp_len < orig_len` 的表要调用方自己用
 *   `std.encoding.zlib` 解；
 * - `WoffInfo.flavor` 是 4 字节大端整数（`0x00010000` 是 TrueType，
 *   `OTTO` 是 CFF）；
 * - tag 用 `Str` 视图（4 字节，可能带尾部空格）；
 * - `woff_find` 按 tag 精确比 4 字节；找不到返回 0，坏数据 -1；
 * - 不校验每表的 checksum（要校验请自己算 sfnt 后再比 `ck_sum`）。
 */
#include <string.h>

module std.data.woff;
import std.core.types;
import std.text.str;

struct WoffInfo {
    u32 flavor;
    u32 length;
    int ntables;
    u32 sfnt_size;
    int major;
    int minor;
    u32 meta_off;
    u32 meta_len;
    u32 priv_off;
    u32 priv_len;
};

struct WoffTable {
    Str tag;
    u32 off;
    u32 comp_len;
    u32 orig_len;
    u32 ck_sum;
};

static u32 woff_u32(const u8 *p)
{
    return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8)
           | (u32)p[3];
}

static u32 woff_u16(const u8 *p)
{
    return ((u32)p[0] << 8) | (u32)p[1];
}

int woff_info(const void *src, int n, WoffInfo *out)
{
    const u8 *p = (const u8 *)src;

    if (!src || !out || n < 44)
        return -1;
    if (memcmp(p, "wOFF", 4) != 0)
        return -1;
    memset(out, 0, sizeof *out);
    out->flavor = woff_u32(p + 4);
    out->length = woff_u32(p + 8);
    out->ntables = (int)woff_u16(p + 12);
    out->sfnt_size = woff_u32(p + 16);
    out->major = (int)woff_u16(p + 20);
    out->minor = (int)woff_u16(p + 22);
    out->meta_off = woff_u32(p + 24);
    out->meta_len = woff_u32(p + 28);
    out->priv_off = woff_u32(p + 36);
    out->priv_len = woff_u32(p + 40);
    if (out->ntables <= 0 || out->ntables > 4096)
        return -1;
    if (out->length > (u32)n || out->length < 44u + (u32)out->ntables * 20u)
        return -1;
    if (44 + out->ntables * 20 > n)
        return -1;
    return 1;
}

int woff_table_at(const void *src, int n, int idx, WoffTable *out)
{
    const u8 *p = (const u8 *)src;
    WoffInfo info = { 0 };
    const u8 *e = 0;

    if (!src || !out)
        return -1;
    if (woff_info(src, n, &info) != 1)
        return -1;
    if (idx < 0 || idx >= info.ntables)
        return -1;
    e = p + 44 + idx * 20;
    memset(out, 0, sizeof *out);
    out->tag.s = (char[:]){ (char *)e, 4 };
    out->off = woff_u32(e + 4);
    out->comp_len = woff_u32(e + 8);
    out->orig_len = woff_u32(e + 12);
    out->ck_sum = woff_u32(e + 16);
    if (out->orig_len == 0)
        return -1;
    if (out->comp_len == 0 || out->comp_len > out->orig_len)
        return -1;
    if ((u64)out->off + (u64)out->comp_len > (u64)n)
        return -1;
    return 1;
}

int woff_find(const void *src, int n, const char *tag, WoffTable *out)
{
    WoffInfo info = { 0 };
    WoffTable t = { 0 };
    int i = 0;

    if (!src || !tag)
        return -1;
    if (woff_info(src, n, &info) != 1)
        return -1;
    for (i = 0; i < info.ntables; i++) {
        if (woff_table_at(src, n, i, &t) != 1)
            return -1;
        if (t.tag.s.len == 4 && memcmp(t.tag.s.data, tag, 4) == 0) {
            if (out)
                *out = t;
            return 1;
        }
    }
    return 0;
}

/* ---- 自测 ---- */

static void woff_put32(u8 *p, u32 v)
{
    p[0] = (u8)(v >> 24);
    p[1] = (u8)((v >> 16) & 0xFF);
    p[2] = (u8)((v >> 8) & 0xFF);
    p[3] = (u8)(v & 0xFF);
}

static void woff_put16(u8 *p, int v)
{
    p[0] = (u8)(v >> 8);
    p[1] = (u8)(v & 0xFF);
}

/* 两表：'cmap'（未压缩）与 'glyf'（压缩成一半长度） */
static int mk_woff(u8 *buf)
{
    int off = 44 + 40;

    memset(buf, 0, 256);
    memcpy(buf, "wOFF", 4);
    woff_put32(buf + 4, 0x00010000u);
    woff_put32(buf + 8, 0);             /* 长度稍后填 */
    woff_put16(buf + 12, 2);
    woff_put32(buf + 16, 200);          /* totalSfntSize */
    woff_put16(buf + 20, 1);
    woff_put16(buf + 22, 0);
    /* 表 0：cmap，8 字节，未压缩 */
    memcpy(buf + 44, "cmap", 4);
    woff_put32(buf + 48, 0);            /* offset 稍后填 */
    woff_put32(buf + 52, 8);
    woff_put32(buf + 56, 8);
    woff_put32(buf + 60, 0x11223344u);
    /* 表 1：glyf，12 字节原长，压成 6 字节 */
    memcpy(buf + 64, "glyf", 4);
    woff_put32(buf + 68, 0);
    woff_put32(buf + 72, 6);
    woff_put32(buf + 76, 12);
    woff_put32(buf + 80, 0x55667788u);
    /* 数据 */
    woff_put32(buf + 48, (u32)off);
    {
        int i = 0;

        for (i = 0; i < 8; i++)
            buf[off++] = (u8)(0xA0 + i);
    }
    woff_put32(buf + 68, (u32)off);
    {
        int i = 0;

        for (i = 0; i < 6; i++)
            buf[off++] = (u8)(0xB0 + i);
    }
    woff_put32(buf + 8, (u32)off);
    return off;
}

test "woff：头部与表目录" {
    static u8 buf[256] = { 0 };
    WoffInfo info = { 0 };
    WoffTable t = { 0 };
    int n = mk_woff(buf);

    if (woff_info(buf, n, &info) != 1)
        return err(1, "头解析失败");
    if (info.flavor != 0x00010000u || info.ntables != 2
        || info.sfnt_size != 200)
        return err(2, "头字段不对");
    if (info.major != 1 || info.minor != 0 || info.length != (u32)n)
        return err(3, "版本或长度不对");
    if (woff_table_at(buf, n, 0, &t) != 1)
        return err(4, "第 0 个表取不到");
    if (t.tag.s.len != 4 || memcmp(t.tag.s.data, "cmap", 4) != 0)
        return err(5, "第 0 个表 tag 不对");
    if (t.comp_len != 8 || t.orig_len != 8 || t.ck_sum != 0x11223344u)
        return err(6, "第 0 个表字段不对");
    if (t.off < 84 || (int)t.off + (int)t.comp_len > n)
        return err(7, "第 0 个表偏移不对");
    if (woff_find(buf, n, "glyf", &t) != 1)
        return err(8, "找不到 glyf");
    if (t.comp_len != 6 || t.orig_len != 12)
        return err(9, "glyf 压缩长度不对");
    if (woff_find(buf, n, "head", &t) != 0)
        return err(10, "不存在的 tag 应该 0");
    if (woff_table_at(buf, n, 2, &t) != -1)
        return err(11, "越界序号应该 -1");
}

test "woff：坏数据" {
    static u8 buf[256] = { 0 };
    WoffInfo info = { 0 };
    WoffTable t = { 0 };
    int n = mk_woff(buf);

    if (woff_info("wOFX", 20, &info) != -1)
        return err(12, "签名不对应该 -1");
    if (woff_info(buf, 20, &info) != -1)
        return err(13, "太短应该 -1");
    if (woff_info(buf, n, 0) != -1)
        return err(14, "空指针应该 -1");
    /* 表数改成 0 */
    woff_put16(buf + 12, 0);
    if (woff_info(buf, n, &info) != -1)
        return err(15, "表数 0 应该 -1");
    /* 恢复，改长度字段小于目录 */
    memcpy(buf, "wOFF", 4);
    woff_put16(buf + 12, 2);
    woff_put32(buf + 8, 50);
    if (woff_info(buf, n, &info) != -1)
        return err(16, "长度小于目录应该 -1");
    /* 恢复，把第 1 个表的 compLength 设成比 origLength 大 */
    woff_put32(buf + 8, (u32)n);
    woff_put32(buf + 72, 20);
    if (woff_table_at(buf, n, 1, &t) != -1)
        return err(17, "compLength 过大应该 -1");
    /* 偏移越界 */
    woff_put32(buf + 72, 6);
    woff_put32(buf + 68, 300);
    if (woff_table_at(buf, n, 1, &t) != -1)
        return err(18, "偏移越界应该 -1");
}
