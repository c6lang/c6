/* std/text/slug：把任意标题折成 URL slug（小写、字母数字、单分隔符）。
 *
 *     import std.text.slug;
 *
 *     char out[64] = { 0 };
 *     slug_make(S("Hello, World!"), out, (int)sizeof out, '-');   // "hello-world"
 *
 * 规则：
 *
 * - 输入按 **UTF-8** 解；ASCII 大写转小写，`A-Z`、`a-z`、`0-9` 原样保留；
 * - U+00C0..U+00FF（拉丁字母补充区）按去音标的基字母折叠（`é`→`e`、`ñ`→`n`、
 *   `Ø`→`o`…），没有基字母的（如 `×`、`÷`）丢弃；
 * - 其它码点（标点、空白、中文、日文、emoji）都算「分隔」；
 * - 连续分隔只出一个 `sep`，开头结尾不留分隔；
 * - 输出不带结尾 `\0` 之外的东西，返回长度，容量不够返回 -1。
 *
 * 注意：CJK 会被整个丢掉（本模块不做音译），要保留 CJK 请自己先转写；不合法
 * 的 UTF-8 字节也按「分隔」处理，不会把半个序列折成字母。
 */
#include <string.h>

module std.text.slug;
import std.core.types;
import std.text.str;

/* 0xC0..0xFF 的折叠表（0 表示没有对应 ASCII 字母） */
static const unsigned char slug_fold[64] = {
    0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x00, 0x63, 0x65, 0x65, 0x65, 0x65, 0x69, 0x69, 0x69, 0x69,
    0x00, 0x6E, 0x6F, 0x6F, 0x6F, 0x6F, 0x6F, 0x00, 0x00, 0x75, 0x75, 0x75, 0x75, 0x79, 0x00, 0x00,
    0x61, 0x61, 0x61, 0x61, 0x61, 0x61, 0x00, 0x63, 0x65, 0x65, 0x65, 0x65, 0x69, 0x69, 0x69, 0x69,
    0x00, 0x6E, 0x6F, 0x6F, 0x6F, 0x6F, 0x6F, 0x00, 0x00, 0x75, 0x75, 0x75, 0x75, 0x79, 0x00, 0x79,
};

int slug_make(char[:] src, char *dst, int cap, char sep)
{
    int i = 0, o = 0, pending = 0;

    if (!dst || cap < 0 || src.len < 0)
        return -1;
    while (i < src.len) {
        unsigned char c = (unsigned char)src.data[i];
        int keep = 0, step = 1;
        unsigned int cp = c;

        if (c < 0x80) {
            if (c >= 'A' && c <= 'Z')
                cp = (unsigned int)(c - 'A' + 'a');
        } else if (c >= 0xC2 && c <= 0xDF && i + 1 < src.len
                   && ((unsigned char)src.data[i + 1] & 0xC0) == 0x80) {
            cp = ((unsigned int)(c & 0x1F) << 6)
                 | (unsigned int)((unsigned char)src.data[i + 1] & 0x3F);
            step = 2;
        } else if (c >= 0xE0 && c <= 0xEF && i + 2 < src.len
                   && ((unsigned char)src.data[i + 1] & 0xC0) == 0x80
                   && ((unsigned char)src.data[i + 2] & 0xC0) == 0x80) {
            cp = 0x800u;                /* 三字节一律当分隔 */
            step = 3;
        } else if (c >= 0xF0 && c <= 0xF4 && i + 3 < src.len
                   && ((unsigned char)src.data[i + 1] & 0xC0) == 0x80
                   && ((unsigned char)src.data[i + 2] & 0xC0) == 0x80
                   && ((unsigned char)src.data[i + 3] & 0xC0) == 0x80) {
            cp = 0x10000u;
            step = 4;
        }
        i += step;
        if (cp >= 'a' && cp <= 'z')
            keep = 1;
        else if (cp >= '0' && cp <= '9')
            keep = 1;
        else if (cp >= 0xC0 && cp <= 0xFF && slug_fold[cp - 0xC0] != 0) {
            cp = (unsigned int)slug_fold[cp - 0xC0];
            keep = 1;
        }
        if (keep) {
            if (pending && o > 0) {
                if (o >= cap)
                    return -1;
                dst[o++] = sep;
            }
            pending = 0;
            if (o >= cap)
                return -1;
            dst[o++] = (char)cp;
        } else if (o > 0) {
            pending = 1;
        }
    }
    if (o < cap)
        dst[o] = 0;
    return o;
}

int slug_valid(char[:] s)
{
    int i = 0;

    for (i = 0; i < s.len; i++) {
        char c = s.data[i];

        if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-'
            || c == '_')
            continue;
        return 0;
    }
    if (s.len > 0 && (s.data[0] == '-' || s.data[s.len - 1] == '-'))
        return 0;
    return 1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "slug：基本折叠" {
    char out[64] = { 0 };
    int n = 0;

    n = slug_make(S("Hello, World!"), out, (int)sizeof out, '-');
    if (n != 11 || memcmp(out, "hello-world", 11) != 0)
        return err(1, "Hello, World! 的 slug 不对");
    n = slug_make(S("  Multiple   spaces  "), out, (int)sizeof out, '-');
    if (n != 15 || memcmp(out, "multiple-spaces", 15) != 0)
        return err(2, "空格应该折成一个分隔符");
    n = slug_make(S("A_B C"), out, (int)sizeof out, '_');
    if (n != 5 || memcmp(out, "a_b_c", 5) != 0)
        return err(3, "自定义分隔符不对");
    n = slug_make(S("!!!"), out, (int)sizeof out, '-');
    if (n != 0 || out[0] != 0)
        return err(4, "全是标点应该得到空串");
    n = slug_make(S(""), out, (int)sizeof out, '-');
    if (n != 0)
        return err(5, "空输入应该 0");
    n = slug_make(S("v1.2.3"), out, (int)sizeof out, '-');
    if (n != 6 || memcmp(out, "v1-2-3", 6) != 0)
        return err(6, "版本号里的点应该变分隔符");
    if (slug_make(S("Hello, World!"), out, 4, '-') != -1)
        return err(7, "容量不够应该 -1");
}

test "slug：去音标与校验" {
    char out[64] = { 0 };
    int n = 0;

    /* é -> e，ñ -> n（Latin-1 单字节） */
    n = slug_make((char[:]){ (char *)"caf\xc3\xa9 na\xc3\xafve", 12 }, out,
                  (int)sizeof out, '-');
    if (n != 10 || memcmp(out, "cafe-naive", 10) != 0)
        return err(8, "去音标不对");
    n = slug_make((char[:]){ (char *)"\xc3\x80\xc3\x89\xc3\x91", 6 }, out,
                  (int)sizeof out, '-');
    if (n != 3 || memcmp(out, "aen", 3) != 0)
        return err(9, "大写带音标不对");
    /* 中文整个丢掉，但它夹在两个字母之间仍算一次分隔 */
    n = slug_make((char[:]){ (char *)"a\xe4\xb8\xad" "b", 5 }, out,
                  (int)sizeof out, '-');
    if (n != 3 || memcmp(out, "a-b", 3) != 0)
        return err(10, "CJK 应该被丢掉但保留一次分隔");
    if (slug_valid(S("hello-world")) != 1)
        return err(11, "合法 slug 应该 1");
    if (slug_valid(S("Hello")) != 0)
        return err(12, "含大写应该 0");
    if (slug_valid(S("-x")) != 0 || slug_valid(S("x-")) != 0)
        return err(13, "首尾分隔符应该 0");
    if (slug_valid(S("")) != 1)
        return err(14, "空串算合法");
}
