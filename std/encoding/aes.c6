/* 密钥扩展的轮常量：2^(i-1) 在 GF(2^8) 里 */
static const u8 aes_rcon[10] = {
    0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80,
    0x1b, 0x36,
};

static u32 aes_load_be(const u8 *p)
{
    return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | (u32)p[3];
}

static u32 aes_sub_word(u32 w)
{
    return ((u32)aes_sbox[(w >> 24) & 0xff] << 24)
           | ((u32)aes_sbox[(w >> 16) & 0xff] << 16)
           | ((u32)aes_sbox[(w >> 8) & 0xff] << 8)
           | (u32)aes_sbox[w & 0xff];
}

static u32 aes_rot_word(u32 w) { return (w << 8) | (w >> 24); }

/* 扩展密钥：16/24/32 字节 -> 10/12/14 轮 */
Aes aes_key(const void *key, usize klen)
{
    Aes a = { { 0 }, 0, 0 };
    const u8 *k = (const u8 *)key;
    int nk = 0, i = 0, total = 0;

    if (!k || (klen != 16 && klen != 24 && klen != 32))
        return a;
    nk = (int)(klen / 4);
    a.nr = nk + 6;
    total = 4 * (a.nr + 1);
    for (i = 0; i < nk; i++)
        a.rk[i] = aes_load_be(k + i * 4);
    for (i = nk; i < total; i++) {
        u32 t = a.rk[i - 1];

        if (i % nk == 0)
            t = aes_sub_word(aes_rot_word(t))
                ^ ((u32)aes_rcon[i / nk - 1] << 24);
        else if (nk > 6 && i % nk == 4)
            t = aes_sub_word(t);
        a.rk[i] = a.rk[i - nk] ^ t;
    }
    a.valid = 1;
    return a;
}

int ok(Aes *self) { return self && self->valid; }

int rounds(Aes *self) { return self && self->valid ? self->nr : 0; }

static u8 aes_xtime(u8 b) { return (u8)((b << 1) ^ ((b & 0x80) ? 0x1b : 0)); }

static u8 aes_mul(u8 a, u8 b)
{
    u8 p = 0;
    int i = 0;

    for (i = 0; i < 8; i++) {
        if (b & 1)
            p ^= a;
        a = aes_xtime(a);
        b >>= 1;
    }
    return p;
}

/* 轮密钥加：状态是列主序，第 c 列用 rk[round*4 + c] 的大端 4 字节 */
static void aes_add_round_key(u8 *st, const u32 *rk, int round)
{
    int c = 0;

    for (c = 0; c < 4; c++) {
        u32 w = rk[round * 4 + c];

        st[c * 4 + 0] ^= (u8)(w >> 24);
        st[c * 4 + 1] ^= (u8)(w >> 16);
        st[c * 4 + 2] ^= (u8)(w >> 8);
        st[c * 4 + 3] ^= (u8)w;
    }
}

static void aes_sub_bytes(u8 *st)
{
    int i = 0;

    for (i = 0; i < 16; i++)
        st[i] = aes_sbox[st[i]];
}

static void aes_inv_sub_bytes(u8 *st)
{
    int i = 0;

    for (i = 0; i < 16; i++)
        st[i] = aes_isbox[st[i]];
}

static void aes_shift_rows(u8 *st)
{
    u8 t = 0;

    /* 第 1 行左移 1 */
    t = st[1];
    st[1] = st[5];
    st[5] = st[9];
    st[9] = st[13];
    st[13] = t;
    /* 第 2 行左移 2 */
    t = st[2];
    st[2] = st[10];
    st[10] = t;
    t = st[6];
    st[6] = st[14];
    st[14] = t;
    /* 第 3 行左移 3（也就是右移 1） */
    t = st[15];
    st[15] = st[11];
    st[11] = st[7];
    st[7] = st[3];
    st[3] = t;
}

static void aes_inv_shift_rows(u8 *st)
{
    u8 t = 0;

    t = st[13];
    st[13] = st[9];
    st[9] = st[5];
    st[5] = st[1];
    st[1] = t;
    t = st[2];
    st[2] = st[10];
    st[10] = t;
    t = st[6];
    st[6] = st[14];
    st[14] = t;
    t = st[3];
    st[3] = st[7];
    st[7] = st[11];
    st[11] = st[15];
    st[15] = t;
}

static void aes_mix_columns(u8 *st)
{
    int c = 0;

    for (c = 0; c < 4; c++) {
        u8 a0 = st[c * 4 + 0], a1 = st[c * 4 + 1];
        u8 a2 = st[c * 4 + 2], a3 = st[c * 4 + 3];
        u8 t = (u8)(a0 ^ a1 ^ a2 ^ a3);

        st[c * 4 + 0] = a0 ^ t ^ aes_xtime((u8)(a0 ^ a1));
        st[c * 4 + 1] = a1 ^ t ^ aes_xtime((u8)(a1 ^ a2));
        st[c * 4 + 2] = a2 ^ t ^ aes_xtime((u8)(a2 ^ a3));
        st[c * 4 + 3] = a3 ^ t ^ aes_xtime((u8)(a3 ^ a0));
    }
}

static void aes_inv_mix_columns(u8 *st)
{
    int c = 0;

    for (c = 0; c < 4; c++) {
        u8 a0 = st[c * 4 + 0], a1 = st[c * 4 + 1];
        u8 a2 = st[c * 4 + 2], a3 = st[c * 4 + 3];

        st[c * 4 + 0] = (u8)(aes_mul(a0, 14) ^ aes_mul(a1, 11)
                             ^ aes_mul(a2, 13) ^ aes_mul(a3, 9));
        st[c * 4 + 1] = (u8)(aes_mul(a0, 9) ^ aes_mul(a1, 14)
                             ^ aes_mul(a2, 11) ^ aes_mul(a3, 13));
        st[c * 4 + 2] = (u8)(aes_mul(a0, 13) ^ aes_mul(a1, 9)
                             ^ aes_mul(a2, 14) ^ aes_mul(a3, 11));
        st[c * 4 + 3] = (u8)(aes_mul(a0, 11) ^ aes_mul(a1, 13)
                             ^ aes_mul(a2, 9) ^ aes_mul(a3, 14));
    }
}

void encrypt_block(Aes *self, const u8 *in16, u8 *out16)
{
    u8 st[16] = { 0 };
    int r = 0;

    if (!self || !self->valid || !in16 || !out16)
        return;
    memcpy(st, in16, sizeof st);
    aes_add_round_key(st, self->rk, 0);
    for (r = 1; r < self->nr; r++) {
        aes_sub_bytes(st);
        aes_shift_rows(st);
        aes_mix_columns(st);
        aes_add_round_key(st, self->rk, r);
    }
    aes_sub_bytes(st);
    aes_shift_rows(st);
    aes_add_round_key(st, self->rk, self->nr);
    memcpy(out16, st, sizeof st);
    memset(st, 0, sizeof st);
}

void decrypt_block(Aes *self, const u8 *in16, u8 *out16)
{
    u8 st[16] = { 0 };
    int r = 0;

    if (!self || !self->valid || !in16 || !out16)
        return;
    memcpy(st, in16, sizeof st);
    aes_add_round_key(st, self->rk, self->nr);
    for (r = self->nr - 1; r >= 1; r--) {
        aes_inv_shift_rows(st);
        aes_inv_sub_bytes(st);
        aes_add_round_key(st, self->rk, r);
        aes_inv_mix_columns(st);
    }
    aes_inv_shift_rows(st);
    aes_inv_sub_bytes(st);
    aes_add_round_key(st, self->rk, 0);
    memcpy(out16, st, sizeof st);
    memset(st, 0, sizeof st);
}

/* 16 字节大端计数器 +1 */
static void aes_ctr_inc(u8 *ctr)
{
    int i = 0;

    for (i = 15; i >= 0; i--) {
        if (++ctr[i] != 0)
            break;
    }
}

/* CTR：密文 = 明文 xor AES(counter)，加解密是同一个操作 */
int ctr_xor(Aes *self, const u8 *iv16, const void *in, usize n, u8 *out)
{
    const u8 *src = (const u8 *)in;
    u8 ctr[16] = { 0 };
    u8 ks[16] = { 0 };
    usize done = 0;

    if (!self || !self->valid || !iv16 || !out)
        return -1;
    if (n == 0)
        return 0;
    if (!src)
        return -1;
    memcpy(ctr, iv16, sizeof ctr);
    while (done < n) {
        usize take = n - done;
        usize i = 0;

        if (take > 16)
            take = 16;
        encrypt_block(self, ctr, ks);
        for (i = 0; i < take; i++)
            out[done + i] = (u8)(src[done + i] ^ ks[i]);
        done += take;
        aes_ctr_inc(ctr);
    }
    memset(ctr, 0, sizeof ctr);
    memset(ks, 0, sizeof ks);
    return 0;
}

/* ---- 自测 ---- */

static int hex_is(const u8 *d, int n, const char *want)
{
    char got[128] = { 0 };
    int i = 0;

    for (i = 0; i < n; i++) {
        got[i * 2] = "0123456789abcdef"[(d[i] >> 4) & 0xf];
        got[i * 2 + 1] = "0123456789abcdef"[d[i] & 0xf];
    }
    got[n * 2] = 0;
    return strcmp(got, want) == 0;
}

static int unhex(const char *s, u8 *dst, int cap)
{
    int n = 0, i = 0;

    while (s[0] && s[1] && n < cap) {
        int hi = -1, lo = -1;

        for (i = 0; i < 16; i++) {
            if ("0123456789abcdef"[i] == s[0])
                hi = i;
            if ("0123456789abcdef"[i] == s[1])
                lo = i;
        }
        if (hi < 0 || lo < 0)
            return -1;
        dst[n++] = (u8)(hi * 16 + lo);
        s += 2;
    }
    return n;
}

test "FIPS 197 的三组分组向量" {
    u8 pt[16] = { 0 }, ct[16] = { 0 }, back[16] = { 0 };
    Aes a = { 0 };
    int klen = 0;

    if (unhex("00112233445566778899aabbccddeeff", pt, 16) != 16)
        return err(1, "明文解不开");
    for (klen = 16; klen <= 32; klen += 8) {
        char keybuf[32] = { 0 };
        int i = 0;

        for (i = 0; i < klen; i++)
            keybuf[i] = (char)i;
        a = aes_key(keybuf, (usize)klen);
        if (!a.ok() || a.rounds() != klen / 4 + 6)
            return err(2, "密钥长度/轮数不对");
        a.encrypt_block(pt, ct);
        if (klen == 16
            && !hex_is(ct, 16, "69c4e0d86a7b0430d8cdb78070b4c55a"))
            return err(3, "AES-128 向量不对");
        if (klen == 24
            && !hex_is(ct, 16, "dda97ca4864cdfe06eaf70a0ec0d7191"))
            return err(4, "AES-192 向量不对");
        if (klen == 32
            && !hex_is(ct, 16, "8ea2b7ca516745bfeafc49904b496089"))
            return err(5, "AES-256 向量不对");
        a.decrypt_block(ct, back);
        if (memcmp(back, pt, 16) != 0)
            return err(6, "解密没还原");
    }
    /* 非法密钥长度 */
    {
        char k[8] = { 0 };
        Aes bad = aes_key(k, 8);

        if (bad.ok() || bad.rounds() != 0)
            return err(7, "8 字节密钥应该无效");
        if (aes_key(0, 16).ok())
            return err(8, "空密钥应该无效");
    }
}

test "CTR 的 SP 800-38A 向量与往返" {
    u8 key[16] = { 0 }, iv[16] = { 0 }, pt[32] = { 0 };
    u8 ct[32] = { 0 }, back[32] = { 0 };
    Aes a = { 0 };

    if (unhex("2b7e151628aed2a6abf7158809cf4f3c", key, 16) != 16
        || unhex("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff", iv, 16) != 16
        || unhex("6bc1bee22e409f96e93d7e117393172a"
                 "ae2d8a571e03ac9c9eb76fac45af8e51",
                 pt, 32)
               != 32)
        return err(9, "CTR 向量解不开");
    a = aes_key(key, 16);
    if (a.ctr_xor(iv, pt, 32, ct) != 0)
        return err(10, "ctr_xor 失败");
    if (!hex_is(ct, 32,
                "874d6191b620e3261bef6864990db6ce"
                "9806f66b7970fdff8617187bb9fffdff"))
        return err(11, "CTR 密文不对");
    a.ctr_xor(iv, ct, 32, back);
    if (memcmp(back, pt, 32) != 0)
        return err(12, "CTR 解密没还原");
    /* 非整块长度：只加密前 17 字节，前 17 字节必须和整块结果一致 */
    {
        u8 part[17] = { 0 };

        if (a.ctr_xor(iv, pt, 17, part) != 0
            || memcmp(part, ct, 17) != 0)
            return err(13, "17 字节的 CTR 结果不对");
        if (a.ctr_xor(iv, pt, 0, part) != 0)
            return err(14, "0 字节应该是空操作");
    }
    /* 原地加解密 */
    {
        u8 buf[16] = { 0 };

        memcpy(buf, pt, 16);
        a.ctr_xor(iv, buf, 16, buf);
        a.ctr_xor(iv, buf, 16, buf);
        if (memcmp(buf, pt, 16) != 0)
            return err(15, "原地加解密没还原");
    }
    /* 分块喂入和整块结果一致 */
    {
        u8 two[32] = { 0 };

        a.ctr_xor(iv, pt, 16, two);
        a.ctr_xor(iv, pt, 16, ct);
        /* 上面这行故意错位？不：重新用同一 IV 分两次是不对的，CTR 的
           分块需要调用方自己推进 counter，所以这里只验证一次性接口 */
        if (memcmp(two, ct, 16) != 0)
            return err(16, "同一 IV 同一块的结果应该一致");
    }
    /* 坏参数 */
    {
        Aes bad = { 0 };

        if (bad.ctr_xor(iv, pt, 16, ct) != -1
            || a.ctr_xor(0, pt, 16, ct) != -1
            || a.ctr_xor(iv, 0, 16, ct) != -1
            || a.ctr_xor(iv, pt, 16, 0) != -1)
            return err(17, "坏参数应该 -1");
    }
}
