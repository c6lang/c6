/* std/data/bdf：BDF 位图字体（X11 的 ASCII 字体格式）。
 *
 *     import std.data.bdf;
 *
 *     BdfInfo fi = { 0 };
 *     BdfChar ch = { 0 };
 *     if (bdf_info(src, n, &fi) == 1 && bdf_find(src, n, 'A', &ch) == 1) {
 *         unsigned char bits[128] = { 0 };
 *         bdf_bitmap(src, n, &ch, bits, (int)sizeof bits);
 *     }
 *
 * 认的分节：`STARTFONT` / `FONT` / `SIZE` / `FONTBOUNDINGBOX` / `CHARS` /
 * `STARTCHAR` / `ENCODING` / `DWIDTH` / `BBX` / `BITMAP` / `ENDCHAR` / `ENDFONT`。
 *
 * 约定：
 *
 * - `BdfInfo` 里 `name` 是 `FONT` 行的视图（指向调用方的缓冲区，不拷贝）；
 * - `BdfChar` 给编码、`DWIDTH`、`BBX`（宽高与偏移）与位图在源码里的偏移
 *   `bitmap_off` 和行数；
 * - `bdf_bitmap` 把 `BITMAP` 到 `ENDCHAR` 之间的十六进制行解成字节，每行
 *   `ceil(bbw/8)` 字节，高位在左；返回字节数（= 行数 × 每行字节数）；
 * - 多字节编码（`ENCODING -1` 的复合字形）跳过；
 * - `bdf_char_at` 的序号是「第几个 STARTCHAR」，跳过复合字形后仍然按出现顺序；
 * - 不支持 `METRICSSET` 的第二套度量与 `SWIDTH` 之外的属性。
 */
#include <string.h>

module std.data.bdf;
import std.core.types;
import std.text.str;

struct BdfInfo {
    Str name;
    int size_pt;
    int fbw;
    int fbh;
    int fbx;
    int fby;
    int nchars;
};

struct BdfChar {
    int encoding;
    int dwidth_x;
    int dwidth_y;
    int bbw;
    int bbh;
    int bbx;
    int bby;
    int bitmap_off;
    int rows;
};

/* 取一行：返回长度，*pos 走到下一行开头 */
static int bdf_line(const char *s, int n, int *pos, int *start)
{
    int i = *pos;

    *start = i;
    while (i < n && s[i] != '\n')
        i++;
    if (i > *start && s[i - 1] == '\r')
        i--;
    {
        int len = i - *start;

        if (i < n)
            i++;
        *pos = i;
        return len;
    }
}

static int bdf_int(const char *p, int n, int *out)
{
    int i = 0, sign = 1, v = 0, digits = 0;

    while (i < n && (p[i] == ' ' || p[i] == '\t'))
        i++;
    if (i < n && (p[i] == '-' || p[i] == '+')) {
        if (p[i] == '-')
            sign = -1;
        i++;
    }
    for (; i < n; i++) {
        if (p[i] < '0' || p[i] > '9')
            break;
        v = v * 10 + (p[i] - '0');
        digits++;
        if (v > 1000000)
            return -1;
    }
    if (!digits)
        return -1;
    *out = v * sign;
    return 1;
}

/* 从 p（长度为 n，指向关键字之后）解 count 个整数 */
static int bdf_ints(const char *p, int n, int *out, int count)
{
    int i = 0, k = 0;

    for (k = 0; k < count; k++) {
        int start = 0, v = 0;

        while (i < n && (p[i] == ' ' || p[i] == '\t'))
            i++;
        start = i;
        while (i < n && p[i] != ' ' && p[i] != '\t')
            i++;
        if (start == i || bdf_int(p + start, i - start, &v) != 1)
            return -1;
        out[k] = v;
    }
    return 1;
}

static int bdf_word(const char *p, int n, const char *kw)
{
    int klen = (int)strlen(kw);

    if (n < klen || memcmp(p, kw, (size_t)klen) != 0)
        return 0;
    if (n > klen && p[klen] != ' ' && p[klen] != '\t')
        return 0;
    return 1;
}

int bdf_info(const void *src, int n, BdfInfo *out)
{
    const char *s = (const char *)src;
    int pos = 0, saw_start = 0;

    if (!src || !out || n <= 0)
        return -1;
    memset(out, 0, sizeof *out);
    while (pos < n) {
        int start = 0;
        int len = bdf_line(s, n, &pos, &start);
        const char *p = s + start;

        if (bdf_word(p, len, "STARTFONT")) {
            saw_start = 1;
            continue;
        }
        if (!saw_start)
            continue;
        if (bdf_word(p, len, "ENDFONT"))
            break;
        if (bdf_word(p, len, "FONT")) {
            int i = 4, j = len;

            while (i < j && (p[i] == ' ' || p[i] == '\t'))
                i++;
            while (j > i && (p[j - 1] == ' ' || p[j - 1] == '\t'))
                j--;
            out->name.s = (char[:]){ (char *)p + i, j - i };
            continue;
        }
        if (bdf_word(p, len, "SIZE")) {
            int v[3] = { 0, 0, 0 };

            if (bdf_ints(p + 4, len - 4, v, 1) == 1)
                out->size_pt = v[0];
            continue;
        }
        if (bdf_word(p, len, "FONTBOUNDINGBOX")) {
            int v[4] = { 0, 0, 0, 0 };

            if (bdf_ints(p + 15, len - 15, v, 4) == 1) {
                out->fbw = v[0];
                out->fbh = v[1];
                out->fbx = v[2];
                out->fby = v[3];
            }
            continue;
        }
        if (bdf_word(p, len, "CHARS")) {
            int v = 0;

            if (bdf_int(p + 5, len - 5, &v) == 1)
                out->nchars = v;
            continue;
        }
    }
    if (!saw_start)
        return -1;
    if (out->fbw <= 0 || out->fbh <= 0)
        return -1;
    return 1;
}

/* 解析第 idx 个字符：1 找到 / 0 没有 / -1 坏 */
int bdf_char_at(const void *src, int n, int idx, BdfChar *out)
{
    const char *s = (const char *)src;
    int pos = 0, seen = -1, in_char = 0;

    if (!src || !out || idx < 0)
        return -1;
    memset(out, 0, sizeof *out);
    while (pos < n) {
        int start = 0;
        int len = bdf_line(s, n, &pos, &start);
        const char *p = s + start;

        if (bdf_word(p, len, "ENDFONT"))
            break;
        if (bdf_word(p, len, "STARTCHAR")) {
            seen++;
            in_char = seen == idx;
            if (in_char)
                out->encoding = -1;
            continue;
        }
        if (!in_char)
            continue;
        if (bdf_word(p, len, "ENCODING")) {
            int v = 0;

            if (bdf_int(p + 8, len - 8, &v) == 1)
                out->encoding = v;
            continue;
        }
        if (bdf_word(p, len, "DWIDTH")) {
            int v[2] = { 0, 0 };

            if (bdf_ints(p + 6, len - 6, v, 2) == 1) {
                out->dwidth_x = v[0];
                out->dwidth_y = v[1];
            }
            continue;
        }
        if (bdf_word(p, len, "BBX")) {
            int v[4] = { 0, 0, 0, 0 };

            if (bdf_ints(p + 3, len - 3, v, 4) == 1) {
                out->bbw = v[0];
                out->bbh = v[1];
                out->bbx = v[2];
                out->bby = v[3];
            }
            continue;
        }
        if (bdf_word(p, len, "BITMAP")) {
            int scan = pos;

            out->bitmap_off = pos;
            out->rows = 0;
            /* 数到 ENDCHAR 前有多少行十六进制 */
            while (scan < n) {
                int sstart = 0;
                int slen = bdf_line(s, n, &scan, &sstart);

                if (bdf_word(s + sstart, slen, "ENDCHAR"))
                    break;
                if (slen > 0)
                    out->rows++;
            }
            if (out->encoding < 0)
                return 0;               /* 复合字形：跳过 */
            return 1;
        }
    }
    return 0;
}

int bdf_find(const void *src, int n, int encoding, BdfChar *out)
{
    BdfChar ch = { 0 };
    int i = 0;

    for (i = 0; i < 65536; i++) {
        int r = bdf_char_at(src, n, i, &ch);

        if (r != 1)
            return 0;
        if (ch.encoding == encoding) {
            *out = ch;
            return 1;
        }
    }
    return 0;
}

static int bdf_hexval(char c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
        return c - 'A' + 10;
    return -1;
}

int bdf_bitmap(const void *src, int n, const BdfChar *ch, void *dst, int cap)
{
    const char *s = (const char *)src;
    unsigned char *out = (unsigned char *)dst;
    int pos = 0, stride = 0, need = 0, got = 0;

    if (!src || !ch || !dst || ch->bbw <= 0 || ch->bbh <= 0)
        return -1;
    stride = (ch->bbw + 7) / 8;
    need = stride * ch->bbh;
    if (cap < need)
        return -1;
    pos = ch->bitmap_off;
    while (pos < n && got < need) {
        int start = 0;
        int len = bdf_line(s, n, &pos, &start);
        int i = 0, byte = 0, nibbles = 0;

        if (len == 0 || bdf_word(s + start, len, "ENDCHAR"))
            break;
        while (i < len && s[start + i] != ' ' && s[start + i] != '\t') {
            int d = bdf_hexval(s[start + i]);

            if (d < 0)
                return -1;
            byte = (byte << 4) | d;
            nibbles++;
            i++;
            if (nibbles == 2) {
                if (got < need)
                    out[got++] = (unsigned char)byte;
                byte = 0;
                nibbles = 0;
            }
        }
        if (nibbles != 0)
            return -1;
    }
    if (got != need)
        return -1;
    return got;
}

/* ---- 自测 ---- */

static const char *bdf_sample =
    "STARTFONT 2.1\n"
    "FONT -misc-fixed-medium-r-normal--8-80-75-75-c-80-iso10646-1\n"
    "SIZE 8 75 75\n"
    "FONTBOUNDINGBOX 8 8 0 0\n"
    "CHARS 2\n"
    "STARTCHAR space\n"
    "ENCODING 32\n"
    "DWIDTH 4 0\n"
    "BBX 4 1 0 0\n"
    "BITMAP\n"
    "00\n"
    "ENDCHAR\n"
    "STARTCHAR A\n"
    "ENCODING 65\n"
    "DWIDTH 8 0\n"
    "BBX 8 8 0 0\n"
    "BITMAP\n"
    "18\n"
    "24\n"
    "42\n"
    "7E\n"
    "42\n"
    "42\n"
    "42\n"
    "00\n"
    "ENDCHAR\n"
    "ENDFONT\n";

test "bdf：字体信息与字符查找" {
    BdfInfo fi = { 0 };
    BdfChar ch = { 0 };
    int n = (int)strlen(bdf_sample);

    if (bdf_info(bdf_sample, n, &fi) != 1)
        return err(1, "头解析失败");
    if (fi.size_pt != 8 || fi.fbw != 8 || fi.fbh != 8 || fi.nchars != 2)
        return err(2, "字体信息不对");
    if (fi.name.s.len <= 0 || fi.name.s.data[0] != '-')
        return err(3, "FONT 名字不对");
    if (bdf_find(bdf_sample, n, 65, &ch) != 1)
        return err(4, "找不到 A");
    if (ch.encoding != 65 || ch.bbw != 8 || ch.bbh != 8 || ch.dwidth_x != 8)
        return err(5, "A 的度量不对");
    if (ch.rows != 8 || ch.bitmap_off <= 0)
        return err(6, "A 的位图位置不对");
    if (bdf_find(bdf_sample, n, 32, &ch) != 1 || ch.bbw != 4
        || ch.dwidth_x != 4)
        return err(7, "空格度量不对");
    if (bdf_find(bdf_sample, n, 66, &ch) != 0)
        return err(8, "不存在的编码应该 0");
}

test "bdf：位图解码与坏数据" {
    BdfChar ch = { 0 };
    BdfInfo fi2 = { 0 };
    unsigned char bits[16] = { 0 };
    int n = (int)strlen(bdf_sample);

    if (bdf_find(bdf_sample, n, 65, &ch) != 1)
        return err(9, "找不到 A");
    if (bdf_bitmap(bdf_sample, n, &ch, bits, (int)sizeof bits) != 8)
        return err(10, "位图字节数不对");
    if (bits[0] != 0x18 || bits[1] != 0x24 || bits[2] != 0x42
        || bits[3] != 0x7E)
        return err(11, "位图内容不对");
    if (bits[7] != 0x00)
        return err(12, "最后一行不对");
    /* 容量不够 */
    if (bdf_bitmap(bdf_sample, n, &ch, bits, 4) != -1)
        return err(13, "容量不够应该 -1");
    /* 坏数据 */
    if (bdf_info("not a bdf\n", 10, &fi2) != -1)
        return err(14, "没有 STARTFONT 应该 -1");
    if (bdf_info(0, 10, 0) != -1)
        return err(15, "空指针应该 -1");
    if (bdf_char_at(bdf_sample, n, 99, &ch) != 0)
        return err(16, "越界序号应该 0");
}
