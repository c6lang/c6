/* std/encoding/pbkdf2：PBKDF2-HMAC-SHA-256 / PBKDF2-HMAC-SHA-1（RFC 2898 / RFC 8018）。
 *
 *     import std.encoding.pbkdf2;
 *
 *     u8 key[32] = { 0 };
 *     pbkdf2_sha256("password", 8, salt, salt_len, 100000, key, sizeof key);
 *     u8 old[20] = { 0 };
 *     pbkdf2_sha1("password", 8, salt, salt_len, 4096, old, sizeof old);
 *
 * PBKDF2 是「把口令摊成密钥」的老牌做法：每个输出块做 iters 次 HMAC，
 * `U(1) = HMAC(P, S || INT(i))`、`U(j) = HMAC(P, U(j-1))`、`T = U(1) xor ... xor
 * U(iters)`。它故意慢（迭代次数是安全参数），适合口令；**不适合**当通用 KDF
 * （那个用 `std.encoding.hkdf`，快且不需要迭代），也不是内存硬的（scrypt/
 * Argon2 才是）。这里只提供 SHA-1 与 SHA-256 两个常见组合，算法本身与哈希
 * 模块共享实现，不链宿主的 OpenSSL。
 *
 * 约定：
 *
 * - `iters <= 0` 返回 -1（迭代 0 次等于不设防，直接拒绝比默默降级好）；
 * - `out == 0` 或 `out_len == 0` 返回 -1 / 0：空输出是合法的空操作；
 * - pass/salt 传 0 当空串（长度为 0），口令为空是允许的（虽然不该）；
 * - 输出长度没有上限（块号按需递增），中间块都在栈上，用完清零；不 malloc。
 * - 返回 0 = 成功，-1 = 参数不合法。
 */
#include <string.h>

module std.encoding.pbkdf2;
import std.core.types;
import std.encoding.sha1;
import std.encoding.sha256;

#define PBKDF2_SHA1_LEN 20
#define PBKDF2_SHA256_LEN 32

/* HMAC-SHA-256 的流式版本：消息 = a || (block >= 0 ? BE32(block) : 空) || b */
static void pb_hmac256(const u8 *key, usize klen, const void *a, usize alen,
                       int block, const void *b, usize blen, u8 *out32)
{
    u8 kblock[64] = { 0 };
    u8 pad[64] = { 0 };
    u8 inner[32] = { 0 };
    Sha256 st = { 0 };
    int i = 0;

    if (key && klen > 0) {
        if (klen > sizeof kblock)
            sha256(key, klen, kblock);
        else
            memcpy(kblock, key, (size_t)klen);
    }
    for (i = 0; i < 64; i++)
        pad[i] = (u8)(kblock[i] ^ 0x36);
    st.init();
    st.update(pad, sizeof pad);
    st.update(a, alen);
    if (block >= 0) {
        u8 be[4] = { 0 };

        be[0] = (u8)(block >> 24);
        be[1] = (u8)(block >> 16);
        be[2] = (u8)(block >> 8);
        be[3] = (u8)block;
        st.update(be, sizeof be);
    }
    st.update(b, blen);
    st.final(inner);
    for (i = 0; i < 64; i++)
        pad[i] = (u8)(kblock[i] ^ 0x5c);
    st.init();
    st.update(pad, sizeof pad);
    st.update(inner, sizeof inner);
    st.final(out32);
    memset(kblock, 0, sizeof kblock);
    memset(pad, 0, sizeof pad);
    memset(inner, 0, sizeof inner);
}

/* HMAC-SHA-1 的同一套流式版本（块 64、输出 20） */
static void pb_hmac1(const u8 *key, usize klen, const void *a, usize alen,
                     int block, const void *b, usize blen, u8 *out20)
{
    u8 kblock[64] = { 0 };
    u8 pad[64] = { 0 };
    u8 inner[20] = { 0 };
    Sha1 st = { 0 };
    int i = 0;

    if (key && klen > 0) {
        if (klen > sizeof kblock)
            sha1(key, (int)klen, kblock);
        else
            memcpy(kblock, key, (size_t)klen);
    }
    for (i = 0; i < 64; i++)
        pad[i] = (u8)(kblock[i] ^ 0x36);
    st.init();
    st.update(pad, sizeof pad);
    st.update(a, (int)alen);
    if (block >= 0) {
        u8 be[4] = { 0 };

        be[0] = (u8)(block >> 24);
        be[1] = (u8)(block >> 16);
        be[2] = (u8)(block >> 8);
        be[3] = (u8)block;
        st.update(be, sizeof be);
    }
    st.update(b, (int)blen);
    st.final(inner);
    for (i = 0; i < 64; i++)
        pad[i] = (u8)(kblock[i] ^ 0x5c);
    st.init();
    st.update(pad, sizeof pad);
    st.update(inner, sizeof inner);
    st.final(out20);
    memset(kblock, 0, sizeof kblock);
    memset(pad, 0, sizeof pad);
    memset(inner, 0, sizeof inner);
}

int pbkdf2_sha256(const void *pass, usize plen, const void *salt, usize slen,
                  int iters, u8 *out, usize out_len)
{
    u8 u[PBKDF2_SHA256_LEN] = { 0 };
    u8 t[PBKDF2_SHA256_LEN] = { 0 };
    usize done = 0;
    int block = 0, j = 0;

    if (!out || out_len == 0 || iters <= 0)
        return -1;
    for (block = 1; done < out_len; block++) {
        usize take = out_len - done;
        int k = 0;

        pb_hmac256(pass, plen, salt, slen, block, 0, 0, u);
        memcpy(t, u, sizeof t);
        for (j = 1; j < iters; j++) {
            pb_hmac256(pass, plen, u, sizeof u, -1, 0, 0, u);
            for (k = 0; k < PBKDF2_SHA256_LEN; k++)
                t[k] ^= u[k];
        }
        if (take > (usize)PBKDF2_SHA256_LEN)
            take = (usize)PBKDF2_SHA256_LEN;
        memcpy(out + done, t, (size_t)take);
        done += take;
        memset(u, 0, sizeof u);
        memset(t, 0, sizeof t);
    }
    return 0;
}

int pbkdf2_sha1(const void *pass, usize plen, const void *salt, usize slen,
                int iters, u8 *out, usize out_len)
{
    u8 u[PBKDF2_SHA1_LEN] = { 0 };
    u8 t[PBKDF2_SHA1_LEN] = { 0 };
    usize done = 0;
    int block = 0, j = 0;

    if (!out || out_len == 0 || iters <= 0)
        return -1;
    for (block = 1; done < out_len; block++) {
        usize take = out_len - done;
        int k = 0;

        pb_hmac1(pass, plen, salt, slen, block, 0, 0, u);
        memcpy(t, u, sizeof t);
        for (j = 1; j < iters; j++) {
            pb_hmac1(pass, plen, u, sizeof u, -1, 0, 0, u);
            for (k = 0; k < PBKDF2_SHA1_LEN; k++)
                t[k] ^= u[k];
        }
        if (take > (usize)PBKDF2_SHA1_LEN)
            take = (usize)PBKDF2_SHA1_LEN;
        memcpy(out + done, t, (size_t)take);
        done += take;
        memset(u, 0, sizeof u);
        memset(t, 0, sizeof t);
    }
    return 0;
}

/* ---- 自测 ---- */

static int hex_is(const u8 *d, int n, const char *want)
{
    char got[256] = { 0 };
    int i = 0;

    for (i = 0; i < n; i++) {
        got[i * 2] = "0123456789abcdef"[(d[i] >> 4) & 0xf];
        got[i * 2 + 1] = "0123456789abcdef"[d[i] & 0xf];
    }
    got[n * 2] = 0;
    return strcmp(got, want) == 0;
}

test "RFC 6070 的 PBKDF2-HMAC-SHA-1 向量" {
    u8 out[20] = { 0 };

    if (pbkdf2_sha1("password", 8, "salt", 4, 1, out, sizeof out) != 0)
        return err(1, "iters=1 失败");
    if (!hex_is(out, 20, "0c60c80f961f0e71f3a9b524af6012062fe037a6"))
        return err(2, "iters=1 的向量不对");
    if (pbkdf2_sha1("password", 8, "salt", 4, 2, out, sizeof out) != 0)
        return err(3, "iters=2 失败");
    if (!hex_is(out, 20, "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957"))
        return err(4, "iters=2 的向量不对");
    if (pbkdf2_sha1("password", 8, "salt", 4, 4096, out, sizeof out) != 0)
        return err(5, "iters=4096 失败");
    if (!hex_is(out, 20, "4b007901b765489abead49d926f721d065a429c1"))
        return err(6, "iters=4096 的向量不对");
    /* 口令很长（> 64 字节块长）也要对：RFC 6070 的 "passwordPASSWORD..." 用例 */
    if (pbkdf2_sha1("passwordPASSWORDpassword", 24,
                    "saltSALTsaltSALTsaltSALTsaltSALTsalt", 36, 4096, out,
                    sizeof out)
        != 0)
        return err(7, "长口令失败");
    if (!hex_is(out, 20, "3d2eec4fe41c849b80c8d83662c0e44a8b291a96"))
        return err(8, "长口令向量不对");
}

test "PBKDF2-HMAC-SHA-256 向量与截断" {
    u8 out[64] = { 0 };
    u8 half[16] = { 0 }, first[16] = { 0 };

    if (pbkdf2_sha256("passwd", 6, "salt", 4, 1, out, sizeof out) != 0)
        return err(9, "SHA-256 失败");
    if (!hex_is(out, 64,
                "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc"
                "49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783"))
        return err(10, "SHA-256 向量不对");
    /* 16 字节输出必须是 64 字节输出的前缀（同一次迭代，只是截断） */
    if (pbkdf2_sha256("passwd", 6, "salt", 4, 1, half, sizeof half) != 0)
        return err(11, "16 字节输出失败");
    memcpy(first, out, sizeof first);
    if (memcmp(first, half, sizeof half) != 0)
        return err(12, "截断输出应该是完整输出的前缀");
    /* 输出跨块：20 字节 SHA-256 要两块 */
    {
        u8 cross[40] = { 0 }, expect[40] = { 0 };

        if (pbkdf2_sha256("p", 1, "s", 1, 3, cross, sizeof cross) != 0)
            return err(13, "跨块输出失败");
        if (pbkdf2_sha256("p", 1, "s", 1, 3, expect, 32) != 0)
            return err(14, "第一块失败");
        if (memcmp(cross, expect, 32) != 0)
            return err(15, "跨块输出的第一块应该一致");
        if (memcmp(cross + 32, expect, 8) == 0)
            return err(16, "第二块不该和第一块相同");
    }
}

test "迭代次数、空输入与错误路径" {
    u8 a[32] = { 0 }, b[32] = { 0 };
    u8 one[20] = { 0 }, direct[20] = { 0 };

    /* iters=1 就是 HMAC(P, S || INT(1)) */
    pbkdf2_sha1("p", 1, "s", 1, 1, one, sizeof one);
    hmac_sha1("p", 1, "s\x00\x00\x00\x01", 5, direct);
    if (memcmp(one, direct, sizeof one) != 0)
        return err(17, "iters=1 应该等于一次 HMAC");
    /* 不同迭代次数必须给出不同结果 */
    pbkdf2_sha256("p", 1, "s", 1, 1, a, sizeof a);
    pbkdf2_sha256("p", 1, "s", 1, 2, b, sizeof b);
    if (memcmp(a, b, sizeof a) == 0)
        return err(18, "不同迭代次数不该给出同一结果");
    /* 空口令 / 空盐；NULL 与空串一致 */
    pbkdf2_sha256("", 0, "", 0, 1, a, sizeof a);
    pbkdf2_sha256(0, 0, 0, 0, 1, b, sizeof b);
    if (memcmp(a, b, sizeof a) != 0)
        return err(19, "NULL 口令/盐应该等于空串");
    /* 非法参数 */
    if (pbkdf2_sha256("p", 1, "s", 1, 0, a, sizeof a) != -1)
        return err(20, "iters=0 应该失败");
    if (pbkdf2_sha256("p", 1, "s", 1, -5, a, sizeof a) != -1)
        return err(21, "负数 iters 应该失败");
    if (pbkdf2_sha256("p", 1, "s", 1, 1, 0, sizeof a) != -1)
        return err(22, "空输出应该失败");
    if (pbkdf2_sha256("p", 1, "s", 1, 1, a, 0) != -1)
        return err(23, "0 长度输出应该失败");
    if (pbkdf2_sha1("p", 1, "s", 1, 0, one, sizeof one) != -1)
        return err(24, "SHA-1 iters=0 应该失败");
    if (pbkdf2_sha1("p", 1, "s", 1, 1, 0, sizeof one) != -1)
        return err(25, "SHA-1 空输出应该失败");
}
