/* std/data/tiff：基线 TIFF 解码（零分配，解成 RGBA8888）。
 *
 *     import std.data.tiff;
 *
 *     TiffInfo ti = tiff_info(data, n);
 *     u8 rgba[4 * 4096];
 *     if (tiff_decode(data, n, rgba, (int)sizeof rgba) == 0) {
 *         // ti.width x ti.height 个像素，alpha 一律 255（4 样本时取第 4 个）
 *     }
 *
 * 支持：小端（II）/大端（MM）字节序、IFD0、STRIP 组织、8 位样本、chunky
 * 平面、压缩 none(1) / Deflate(8，zlib 容器) / PackBits(32773)、光度 RGB(2) 与
 * BlackIsZero(1)/WhiteIsZero(0) 灰度、SamplesPerPixel 1/3/4。
 *
 * 约定：
 *
 * - `tiff_info` 只读 IFD，给出尺寸/样本数/压缩/光度/条带数；
 * - `tiff_decode` 逐条带解压后展开成 RGBA；灰度复制到 R=G=B，
 *   WhiteIsZero 取反；4 样本时第 4 个当 alpha；
 * - 只支持 8 位样本、PlanarConfiguration=1、Predictor=1；LZW(5)、JPEG(6/7)、
 *   16 位、分平面、浮点样本、tiled(324/325) 一律返回 -1；
 * - 单条带解压后的临时区上限 64KB（超过返回 -1），失败时不写半截 RGBA。
 */
#include <string.h>

module std.data.tiff;
import std.core.types;
import std.encoding.zlib;
import std.encoding.rle;

#define TIFF_MAX_STRIPS 512

struct TiffInfo {
    int valid;
    int big_endian;
    int width;
    int height;
    int bits;
    int samples;
    int photometric;
    int compression;
    int rows_per_strip;
    int strips;
    int planar;
};

struct Tiff {
    const u8 *p;
    int n;
    int be;
    TiffInfo info;
    u64 off[TIFF_MAX_STRIPS];
    u64 cnt[TIFF_MAX_STRIPS];
};

static TiffInfo tiff_bad(void)
{
    TiffInfo t = { 0 };

    return t;
}

static int tiff_u16(Tiff *t, int off)
{
    if (off < 0 || off + 2 > t->n)
        return -1;
    if (t->be)
        return (t->p[off] << 8) | t->p[off + 1];
    return t->p[off] | (t->p[off + 1] << 8);
}

static u64 tiff_u32(Tiff *t, int off)
{
    if (off < 0 || off + 4 > t->n)
        return 0;
    if (t->be)
        return ((u64)t->p[off] << 24) | ((u64)t->p[off + 1] << 16)
               | ((u64)t->p[off + 2] << 8) | (u64)t->p[off + 3];
    return ((u64)t->p[off + 3] << 24) | ((u64)t->p[off + 2] << 16)
           | ((u64)t->p[off + 1] << 8) | (u64)t->p[off];
}

/* 读第 i 个 SHORT/LONG 值；放不下返回 0 */
static u64 tiff_val(Tiff *t, int entry, int type, u64 count, int i)
{
    int sz = (type == 3) ? 2 : 4;
    u64 inline_base = 0;

    if (i < 0 || (u64)i >= count || sz <= 0)
        return 0;
    if (count * (u64)sz > 4) {
        u64 off = tiff_u32(t, entry + 8);

        if ((int)(off + (u64)i * (u64)sz) >= t->n)
            return 0;
        if (type == 3)
            return (u64)tiff_u16(t, (int)(off + (u64)i * 2));
        return tiff_u32(t, (int)(off + (u64)i * 4));
    }
    inline_base = (u64)entry + 8;
    if (type == 3) {
        int v = tiff_u16(t, (int)inline_base + i * 2);

        return v < 0 ? 0 : (u64)v;
    }
    return tiff_u32(t, (int)inline_base + i * 4);
}

static int tiff_open(Tiff *t, const void *data, int n)
{
    const u8 *p = (const u8 *)data;

    if (!t || !data || n < 8)
        return -1;
    memset(t, 0, sizeof *t);
    t->p = p;
    t->n = n;
    if (p[0] == 'I' && p[1] == 'I')
        t->be = 0;
    else if (p[0] == 'M' && p[1] == 'M')
        t->be = 1;
    else
        return -1;
    if (tiff_u16(t, 2) != 42)
        return -1;
    return 0;
}

static int tiff_scan(Tiff *t)
{
    u64 ifd = tiff_u32(t, 4);
    int count = 0, i = 0;

    if (ifd == 0 || (int)ifd + 2 > t->n)
        return -1;
    count = tiff_u16(t, (int)ifd);
    if (count <= 0 || (int)ifd + 2 + count * 12 > t->n)
        return -1;
    t->info.width = 0;
    t->info.height = 0;
    t->info.bits = 8;
    t->info.samples = 1;
    t->info.photometric = 1;
    t->info.compression = 1;
    t->info.rows_per_strip = 0;
    t->info.planar = 1;
    for (i = 0; i < count; i++) {
        int e = (int)ifd + 2 + i * 12;
        int tag = tiff_u16(t, e);
        int type = tiff_u16(t, e + 2);
        u64 cnt = tiff_u32(t, e + 4);

        if (tag < 0)
            return -1;
        switch (tag) {
        case 256: t->info.width = (int)tiff_val(t, e, type, cnt, 0); break;
        case 257: t->info.height = (int)tiff_val(t, e, type, cnt, 0); break;
        case 258: t->info.bits = (int)tiff_val(t, e, type, cnt, 0); break;
        case 259: t->info.compression = (int)tiff_val(t, e, type, cnt, 0); break;
        case 262: t->info.photometric = (int)tiff_val(t, e, type, cnt, 0); break;
        case 277: t->info.samples = (int)tiff_val(t, e, type, cnt, 0); break;
        case 278: t->info.rows_per_strip = (int)tiff_val(t, e, type, cnt, 0); break;
        case 284: t->info.planar = (int)tiff_val(t, e, type, cnt, 0); break;
        case 317: /* Predictor */ if ((int)tiff_val(t, e, type, cnt, 0) != 1) return -1; break;
        case 273:
            if ((int)cnt > TIFF_MAX_STRIPS)
                return -1;
            {
                int k = 0;

                t->info.strips = (int)cnt;
                for (k = 0; k < (int)cnt; k++)
                    t->off[k] = tiff_val(t, e, type, cnt, k);
            }
            break;
        case 279:
            if ((int)cnt > TIFF_MAX_STRIPS)
                return -1;
            {
                int k = 0;

                for (k = 0; k < (int)cnt; k++)
                    t->cnt[k] = tiff_val(t, e, type, cnt, k);
            }
            break;
        case 322: /* TileWidth */ case 323: case 324: case 325:
            return -1;                  /* 分块 TIFF 不支持 */
        default:
            break;
        }
    }
    if (t->info.width <= 0 || t->info.height <= 0)
        return -1;
    if (t->info.rows_per_strip <= 0)
        t->info.rows_per_strip = t->info.height;
    if (t->info.strips <= 0) {
        /* 没有 StripOffsets：拒绝 */
        return -1;
    }
    return 0;
}

TiffInfo tiff_info(const void *data, int n)
{
    Tiff t = { 0 };

    if (tiff_open(&t, data, n) != 0 || tiff_scan(&t) != 0)
        return tiff_bad();
    t.info.valid = 1;
    t.info.big_endian = t.be;
    return t.info;
}

int tiff_decode(const void *data, int n, u8 *rgba, int cap)
{
    Tiff t = { 0 };
    u8 tmp[65536] = { 0 };
    int s = 0, x = 0, y = 0, sp = 0;

    if (!data || !rgba)
        return -1;
    if (tiff_open(&t, data, n) != 0 || tiff_scan(&t) != 0)
        return -1;
    if (t.info.bits != 8 || t.info.planar != 1)
        return -1;
    if (t.info.photometric != 0 && t.info.photometric != 1
        && t.info.photometric != 2)
        return -1;
    if (t.info.samples != 1 && t.info.samples != 3 && t.info.samples != 4)
        return -1;
    if (cap < t.info.width * t.info.height * 4)
        return -1;
    sp = (t.info.samples == 1) ? 1 : t.info.samples;
    for (s = 0; s < t.info.strips; s++) {
        int rows = t.info.rows_per_strip;
        int need = 0, got = 0, raw = (int)t.cnt[s];

        if (s * t.info.rows_per_strip >= t.info.height)
            break;
        if (rows > t.info.height - s * t.info.rows_per_strip)
            rows = t.info.height - s * t.info.rows_per_strip;
        need = rows * t.info.width * sp;
        if (need <= 0 || need > (int)sizeof tmp)
            return -1;
        if ((int)(t.off[s] + (u64)raw) > t.n)
            return -1;
        switch (t.info.compression) {
        case 1:
            got = raw;
            if (got != need)
                return -1;
            memcpy(tmp, t.p + t.off[s], (size_t)got);
            break;
        case 8:
            /* TIFF 的 Deflate 是 zlib 容器（RFC 1950），不是裸 deflate */
            got = zlib_decompress(t.p + t.off[s], raw, tmp, (int)sizeof tmp);
            break;
        case 32773:
            got = rle_decode(t.p + t.off[s], raw, tmp, (int)sizeof tmp);
            break;
        default:
            return -1;
        }
        if (got != need)
            return -1;
        for (y = 0; y < rows; y++) {
            int out_y = s * t.info.rows_per_strip + y;

            for (x = 0; x < t.info.width; x++) {
                const u8 *q = tmp + ((size_t)y * t.info.width + x) * sp;
                u8 *o = rgba + ((size_t)out_y * t.info.width + x) * 4;

                if (t.info.photometric == 2) {
                    o[0] = q[0];
                    o[1] = q[1];
                    o[2] = q[2];
                    o[3] = (sp == 4) ? q[3] : 255;
                } else {
                    u8 v = (t.info.photometric == 0) ? (u8)(255 - q[0]) : q[0];

                    o[0] = v;
                    o[1] = v;
                    o[2] = v;
                    o[3] = 255;
                }
            }
        }
    }
    return 0;
}

/* ---- 自测 ---- */

static int hexval(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    return -1;
}

static int unhex(const char *s, u8 *dst, int cap)
{
    int n = 0;

    while (s[0] && s[1] && n < cap) {
        int hi = hexval(s[0]), lo = hexval(s[1]);

        if (hi < 0 || lo < 0)
            return -1;
        dst[n++] = (u8)(hi * 16 + lo);
        s += 2;
    }
    return n;
}

static const char *TIFF_RGB_RAW =
    "49492a00080000000a0000010400010000000400000001010400010000000300"
    "0000020103000300000086000000030103000100000001000000060103000100"
    "00000200000011010400010000008c0000001501030001000000030000001601"
    "040001000000030000001701040001000000240000001c010300010000000100"
    "000000000000080008000800ff000000ff000000ffffff000a141e28323c4650"
    "5a646e78ffffff808080000000c86432";

static const char *TIFF_RGB_DEFLATE =
    "49492a0030000000789cfbcfc0c0f01f84ffff67e01291d330b2710b884ac9ab"
    "00f21b1a1a801227528c00f7880de3000a000001030001000000040000000101"
    "030001000000030000000201030003000000ae00000003010300010000000800"
    "0000060103000100000002000000110104000100000008000000150103000100"
    "0000030000001601030001000000030000001701040001000000270000001c01"
    "0300010000000100000000000000080008000800";

static const char *TIFF_RGB_PACKBITS =
    "49492a002c00000000fffe0000fffe00feff00000b0a141e28323c46505a646e"
    "78fefffe80fe0002c86432000a00000103000100000004000000010103000100"
    "0000030000000201030003000000aa0000000301030001000000058000000601"
    "0300010000000200000011010400010000000800000015010300010000000300"
    "00001601030001000000030000001701040001000000230000001c0103000100"
    "00000100000000000000080008000800";

static const char *TIFF_GRAY_PACKBITS =
    "49492a001800000003002040600380a0c0e003ff0a141e000900000103000100"
    "0000040000000101030001000000030000000201030001000000080000000301"
    "0300010000000580000006010300010000000100000011010400010000000800"
    "000016010300010000000300000017010400010000000f0000001c0103000100"
    "00000100000000000000";

static const char *TIFF_BE_GRAY =
    "4d4d002a00000008000901000003000000010002000001010003000000010002"
    "0000010200030000000100080000010300030000000100010000010600030000"
    "00010001000001110004000000010000007a0115000300000001000100000116"
    "00030000000100020000011700040000000100000004000000000a141e28";


/* 4x3 RGB 的期望 RGBA */
static const u8 RGB_WANT[12][4] = {
    { 255, 0, 0, 255 }, { 0, 255, 0, 255 }, { 0, 0, 255, 255 },
    { 255, 255, 0, 255 }, { 10, 20, 30, 255 }, { 40, 50, 60, 255 },
    { 70, 80, 90, 255 }, { 100, 110, 120, 255 }, { 255, 255, 255, 255 },
    { 128, 128, 128, 255 }, { 0, 0, 0, 255 }, { 200, 100, 50, 255 },
};

static int rgb_ok(const u8 *rgba)
{
    int i = 0;

    for (i = 0; i < 12; i++) {
        if (rgba[i * 4] != RGB_WANT[i][0] || rgba[i * 4 + 1] != RGB_WANT[i][1]
            || rgba[i * 4 + 2] != RGB_WANT[i][2] || rgba[i * 4 + 3] != 255)
            return 0;
    }
    return 1;
}

test "IFD 元信息与三种压缩的 RGB 解码" {
    u8 data[256] = { 0 };
    u8 rgba[64] = { 0 };
    int n = unhex(TIFF_RGB_RAW, data, (int)sizeof data);
    TiffInfo ti = tiff_info(data, n);

    if (!ti.valid || ti.width != 4 || ti.height != 3)
        return err(1, "尺寸不对");
    if (ti.samples != 3 || ti.bits != 8 || ti.photometric != 2)
        return err(2, "样本/位深/光度不对");
    if (ti.compression != 1 || ti.big_endian || ti.strips != 1)
        return err(3, "压缩/字节序/条带数不对");
    if (tiff_decode(data, n, rgba, (int)sizeof rgba) != 0 || !rgb_ok(rgba))
        return err(4, "未压缩 RGB 解码不对");
    /* Deflate */
    memset(data, 0, sizeof data);
    memset(rgba, 0, sizeof rgba);
    n = unhex(TIFF_RGB_DEFLATE, data, (int)sizeof data);
    if (tiff_info(data, n).compression != 8)
        return err(5, "Deflate TIFF 的压缩标记不对");
    if (tiff_decode(data, n, rgba, (int)sizeof rgba) != 0 || !rgb_ok(rgba))
        return err(6, "Deflate RGB 解码不对");
    /* PackBits */
    memset(data, 0, sizeof data);
    memset(rgba, 0, sizeof rgba);
    n = unhex(TIFF_RGB_PACKBITS, data, (int)sizeof data);
    if (tiff_info(data, n).compression != 32773)
        return err(7, "PackBits TIFF 的压缩标记不对");
    if (tiff_decode(data, n, rgba, (int)sizeof rgba) != 0 || !rgb_ok(rgba))
        return err(8, "PackBits RGB 解码不对");
}

test "灰度（PackBits）与大端 TIFF" {
    u8 data[256] = { 0 };
    u8 rgba[64] = { 0 };
    int n = unhex(TIFF_GRAY_PACKBITS, data, (int)sizeof data);
    static const u8 gray[12] = { 0, 32, 64, 96, 128, 160, 192, 224, 255, 10, 20, 30 };
    int i = 0;
    TiffInfo ti = tiff_info(data, n);

    if (!ti.valid || ti.width != 4 || ti.height != 3 || ti.samples != 1
        || ti.photometric != 1)
        return err(9, "灰度 TIFF 的元信息不对");
    if (tiff_decode(data, n, rgba, (int)sizeof rgba) != 0)
        return err(10, "灰度解码失败");
    for (i = 0; i < 12; i++)
        if (rgba[i * 4] != gray[i] || rgba[i * 4 + 1] != gray[i]
            || rgba[i * 4 + 2] != gray[i] || rgba[i * 4 + 3] != 255)
            return err(11, "灰度像素不对");
    /* 大端 2x2 */
    memset(data, 0, sizeof data);
    memset(rgba, 0, sizeof rgba);
    n = unhex(TIFF_BE_GRAY, data, (int)sizeof data);
    ti = tiff_info(data, n);
    if (!ti.valid || !ti.big_endian || ti.width != 2 || ti.height != 2)
        return err(12, "大端 TIFF 的元信息不对");
    if (tiff_decode(data, n, rgba, (int)sizeof rgba) != 0)
        return err(13, "大端解码失败");
    {
        static const u8 want[4] = { 10, 20, 30, 40 };

        for (i = 0; i < 4; i++)
            if (rgba[i * 4] != want[i])
                return err(14, "大端像素不对");
    }
}

test "坏 TIFF 与不支持的变体" {
    u8 data[256] = { 0 };
    u8 rgba[64] = { 0 };
    int n = unhex(TIFF_RGB_RAW, data, (int)sizeof data);

    if (tiff_info(data, 6).valid)
        return err(15, "截断的 TIFF 不该有效");
    data[0] = 'X';
    if (tiff_info(data, n).valid)
        return err(16, "坏字节序标记不该有效");
    memset(data, 0, sizeof data);
    n = unhex(TIFF_RGB_RAW, data, (int)sizeof data);
    /* 改 BitsPerSample 为 16：解码应拒绝 */
    {
        u8 copy[256] = { 0 };

        memcpy(copy, data, (size_t)n);
        copy[0x86] = 16;
        if (tiff_decode(copy, n, rgba, (int)sizeof rgba) != -1)
            return err(17, "16 位样本应该 -1");
    }
    /* 输出缓冲不够 */
    if (tiff_decode(data, n, rgba, 8) != -1)
        return err(18, "缓冲不够应该 -1");
    if (tiff_decode(0, n, rgba, (int)sizeof rgba) != -1
        || tiff_decode(data, n, 0, (int)sizeof rgba) != -1)
        return err(19, "空指针应该 -1");
}
