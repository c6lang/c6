/* std/container/set：哈希集合 Set@K。
 *
 *     import std.container.set;
 *
 *     @Set@int s = new Set@int;
 *     s->add(7) catch e { return e.id; };   // 1 = 新增，0 = 本来就有
 *     s->has(7);                            // 1
 *     s->remove(7);                         // 1
 *     foreach (int k = s->iter()) { ... }
 *
 * 键的要求与 `std.container.map` 完全一致（这里就是它的薄包装）：**POD**、按
 * `sizeof(K)` 个字节做 FNV-1a 哈希、用 memcmp 判等。带指针/填充的大结构体
 * 请自己保证「相等 ⇒ 逐字节相同」。
 *
 * 为什么不另写一张表：集合就是「键 → 没用到的值」，开放寻址、扩容、墓碑、
 * 迭代顺序这些语义和 Map 必须一致；复制一份只会让两边慢慢分叉。代价是
 * **用 Set 的程序要把 `std/container/map.c6` 的正文一起编**（import 只带来声明）。
 *
 * 设计要点：
 * - `Set` 含托管字段（`@Map@(K, int)`），只能 `new` 出来用 `@Set@K` 持有；
 * - `add` 返回 1/0 表示「新增/已存在」，内存不足时返回 `int!error`；
 * - `remove`/`has` 不分配、不失败；
 * - `iter()` 返回单参数泛型 `SetIter@K`（模板体内不能返回多参数实例），
 *   迭代器借用集合，**改集合之前先迭代完**——和 Map 的迭代器同一个约定。
 */
module std.container.set;
import std.core.types;
import std.core.err;
import std.container.map;

struct Set@K {
    @Map@(K, int) m;

    int count() { return m ? m->count() : 0; }

    int capacity() { return m ? m->capacity() : 0; }

    int is_empty() { return count() == 0; }

    int has(K k) { return m ? m->has(k) : 0; }

    /* 预留容量（只增不减）：失败不改内容 */
    int!error reserve(int want)
    {
        if (!m) {
            if (want <= 0)
                return 0;
            m = new Map@(K, int);
            if (!m)
                return err(std.core.err.NOMEM, "set: out of memory");
        }
        try m->reserve(want);
        return 0;
    }

    /* 插入：1 = 本次新增，0 = 本来就有；失败不改变集合 */
    int!error add(K k)
    {
        int had = 0;

        if (!m) {
            m = new Map@(K, int);
            if (!m)
                return err(std.core.err.NOMEM, "set: out of memory");
        }
        had = m->has(k) ? 1 : 0;
        try m->put(k, 1);
        return had ? 0 : 1;
    }

    /* 删除：命中返回 1，不在集合里返回 0（不失败） */
    int remove(K k) { return m ? m->remove(k) : 0; }

    /* 清空但保留容量（和 Map 的墓碑策略一致） */
    void clear()
    {
        if (m)
            m->clear();
    }

    /* 迭代器是纯值、借用集合；集合为空时也能安全地 has() */
    SetIter@K iter()
    {
        SetIter@K it = { 0 };

        it.it.map = m;
        it.it.i = 0;
        return it;
    }
};

/* 集合迭代器：复用 Map 的 Iter@(K, int)，只把「值」换成键。
   Map 的 Iter 已经负责跳过空槽和墓碑，这里不再碰 flags。 */
struct SetIter@K {
    Iter@(K, int) it;

    int has()
    {
        if (!it.map)
            return 0;
        return it.has();
    }

    K next()
    {
        K k = it.map->keys[it.i];

        it.next();      /* 推进游标；int 值用不上 */
        return k;
    }
};

/* ---- 自测 ---- */

test "空集合的 count / has / remove / iter" {
    @Set@int s = new Set@int;

    if (s->count() != 0 || s->capacity() != 0 || !s->is_empty())
        return err(1, "空集合的计数不对");
    if (s->has(1) != 0)
        return err(2, "空集合不该命中");
    if (s->remove(1) != 0)
        return err(3, "空集合 remove 应返回 0");
    {
        SetIter@int it = s->iter();
        SetIter@int *p = &it;

        if (p->has())
            return err(4, "空集合的迭代器不该 has()");
    }
    s->clear();     /* 空集合 clear 是安全的 */
    if (s->count() != 0)
        return err(5, "clear 之后不空了");
}

test "add 区分新增与已存在" {
    @Set@int s = new Set@int;

    s->add(7) catch e { return err(6, "add 失败"); };
    if (s->count() != 1)
        return err(7, "第一次 add 之后计数不对");
    if (s->has(7) != 1)
        return err(8, "add 之后 has 仍为 0");
    if ((try s->add(7)) != 0)
        return err(9, "重复 add 应当返回 0");
    if (s->count() != 1)
        return err(10, "重复 add 增加了计数");
    if ((try s->add(8)) != 1 || s->count() != 2)
        return err(11, "第二个元素 add 不对");
}

test "remove 之后可以重新加入" {
    @Set@int s = new Set@int;

    s->add(7) catch e { return err(12, "add 失败"); };
    if (s->remove(7) != 1)
        return err(13, "remove 没有命中");
    if (s->has(7) != 0 || s->count() != 0)
        return err(14, "remove 之后还在集合里");
    if (s->remove(7) != 0)
        return err(15, "第二次 remove 仍返回 1");
    if ((try s->add(7)) != 1 || s->has(7) != 1)
        return err(16, "删除之后重新加入失败");
}

test "大量元素触发扩容后全部仍在" {
    @Set@int s = new Set@int;
    int i = 0;

    for (i = 0; i < 500; i++)
        s->add(i * 3) catch e { return err(17, "add 失败"); };
    if (s->count() != 500)
        return err(18, "count 不是 500");
    if (s->capacity() < 500)
        return err(19, "容量没有扩到 500 以上");
    for (i = 0; i < 500; i++) {
        if (s->has(i * 3) != 1)
            return err(20, "扩容后丢了元素");
        if (s->has(i * 3 + 1) != 0)
            return err(21, "扩容后出现了不存在的元素");
    }
}

test "删除一半之后集合内容正确" {
    @Set@int s = new Set@int;
    int i = 0;

    for (i = 0; i < 100; i++)
        s->add(i) catch e { return err(22, "add 失败"); };
    for (i = 0; i < 100; i += 2)
        if (s->remove(i) != 1)
            return err(23, "偶数 remove 应当命中");
    if (s->count() != 50)
        return err(24, "删除之后计数不是 50");
    for (i = 0; i < 100; i++) {
        int want = (i % 2) ? 1 : 0;

        if (s->has(i) != want)
            return err(25, "删除之后 has 不对");
    }
}

test "clear 清空但保留容量" {
    @Set@int s = new Set@int;
    int cap0 = 0;

    s->add(1) catch e { return err(26, "add 失败"); };
    s->add(2) catch e { return err(27, "add 失败"); };
    cap0 = s->capacity();
    s->clear();
    if (s->count() != 0 || !s->is_empty())
        return err(28, "clear 之后不空");
    if (s->capacity() != cap0)
        return err(29, "clear 丢了容量");
    if (s->has(1) != 0)
        return err(30, "clear 之后还能命中");
    s->add(3) catch e { return err(31, "clear 之后 add 失败"); };
    if (s->count() != 1 || s->has(3) != 1)
        return err(32, "clear 之后重用失败");
}

test "迭代器覆盖全部元素且不重复" {
    @Set@int s = new Set@int;
    int seen[20] = { 0 };
    int i = 0, n = 0, sum = 0;

    for (i = 0; i < 20; i++)
        s->add(i) catch e { return err(33, "add 失败"); };
    foreach (int k = s->iter()) {
        if (k < 0 || k >= 20)
            return err(34, "迭代出了集合外的键");
        seen[k]++;
        n++;
        sum += k;
    }
    if (n != 20 || sum != 190)
        return err(35, "迭代器没有覆盖全部元素");
    for (i = 0; i < 20; i++)
        if (seen[i] != 1)
            return err(36, "迭代器重复或漏掉了元素");

    /* 删除几个之后再迭代：墓碑必须被跳过 */
    s->remove(3);
    s->remove(11);
    n = 0;
    foreach (int k = s->iter()) {
        if (k == 3 || k == 11)
            return err(37, "迭代器漏过了墓碑");
        n++;
    }
    if (n != 18)
        return err(38, "删除之后的迭代计数不对");
}

test "reserve 只增不减、不改内容" {
    @Set@int s = new Set@int;
    int cap0 = 0;

    s->reserve(100) catch e { return err(39, "reserve 失败"); };
    cap0 = s->capacity();
    if (cap0 < 100)
        return err(40, "reserve 没有扩到 100");
    s->add(42) catch e { return err(41, "add 失败"); };
    s->reserve(10) catch e { return err(42, "缩小 reserve 应当是 no-op"); };
    if (s->capacity() != cap0)
        return err(43, "reserve 不该缩小容量");
    if (s->count() != 1 || s->has(42) != 1)
        return err(44, "reserve 改了内容");
    s->reserve(0) catch e { return err(45, "reserve(0) 失败"); };
    if (s->count() != 1)
        return err(46, "reserve(0) 改了内容");
}
