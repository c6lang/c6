/* parse.c6 —— 声明层 + 表达式/语句 → IR（流式，不建表达式树）。
 *
 * 原则（design.md §4）：**边解析边降 IR**。每个 gen_* 返回一个虚拟寄存器号，
 * 值已经在 IR 里算好了；没有 AST，也就没有节点分配和二次遍历。
 * 需要“先看再说”的语义（defer/闭包捕获/泛型）留到 P4，用 token 区间重放。
 *
 * 值模型：标量在虚拟寄存器里统一按 64 位存，宽度信息留在 IR 的 type 字段，
 * 后端按它选指令（当前后端只用 64 位，P3-3 补 8/16/32 位读写）。
 */

#define PA_LOOK 16

/* 后端入口。llvm.c6 必须排在 parse.c6 **之后**（它要读数据段、重定位表和
 * 构造器表，那些都在后面才定义），所以这里先给声明。 */
static int llvm_mode(void);
static int llvm_open(const char *out);
static int llvm_finish(const char *out);
static void be_emit_fn(IrFn *f, u32 func_sym);

/* 优化 pass 的统一入口：一个函数的 IR 已经降完、还没交给任何后端。
 * -O0 时 ir_optimize() 立即返回，字节行为与优化器引入前完全一致。 */
static void pa_emit_fn(IrFn *f, u32 func_sym)
{
    ir_optimize(f);
    if (C99_MODE) {
        /* 让 C99 后端知道数据段 VA 区间：kpool 里指向数据段的常量要翻成
         * `D + off`（native 后端镜像就映射在 0x400000，不需要翻）。 */
        c99_set_data_range((u64)ELF_BASE_VA + (u64)ELF_HDR, (u64)DATA_IMG.n);
        be_emit_fn(f, func_sym);
    } else if (llvm_mode())
        be_emit_fn(f, func_sym);
    else
        x64_compile(&X64, f, func_sym);
}

static IrFn FN;
static int PA_ERRS;
static Image CODE_IMG;

/* --- 两遍发射（kernel DCE=2）-------------------------------------------
 * c6c 是单遍编译：边解析边 x64_compile。内核头里上万个 static inline 全量
 * 发射，99% 是死函数（见 docs/kernel-no-gcc-plan.md）。出 .o 后做物理压缩
 * 不可行——x64_branch 把函数内 rel32 目标拍死进代码字节、无重定位记录。
 * 这里改成延迟发射：先把每个函数的 IR 深拷贝缓存，TU 解析完后从全局根
 * 沿 IR_CALL 引用图算可达集，只发射 live 函数（死函数根本不生成字节）。
 * env C6C_KERNEL_DCE=2 开，默认关，行为与原来一致。 */
typedef struct {
    IrFn ir;            /* 深拷贝（ops/kpool/lines 都是独立缓冲） */
    u32 sym;            /* 函数符号 id（X64.sym 下标） */
    u32 alias_sym;      /* 函数别名符号 id，0 = 无 */
    u8 is_static;       /* local 函数（可安全剔除） */
    u8 emitted;         /* 可达性标记（发射阶段用） */
} DefFn;

static DefFn *DEF_FNS;
static u32 NDEF;
static u32 DEF_CAP;
static int PA_DEFER_EMIT;   /* =1 时延迟发射（kernel DCE=2） */

static int pa_defer_enabled(void)
{
    const char *v = getenv("C6C_KERNEL_DCE");

    return v && v[0] == '2';
}

static void def_fn_add(const IrFn *f, u32 sym, u32 alias_sym)
{
    DefFn *d = NULL;

    if (NDEF >= DEF_CAP) {
        u32 nc = DEF_CAP ? DEF_CAP * 2 : 512;
        DefFn *nv = (DefFn *)malloc((size_t)nc * sizeof(DefFn));

        if (!nv)
            return;
        if (NDEF)
            memcpy(nv, DEF_FNS, (size_t)NDEF * sizeof(DefFn));
        free(DEF_FNS);
        DEF_FNS = nv;
        DEF_CAP = nc;
    }
    d = &DEF_FNS[NDEF++];
    memset(d, 0, sizeof(*d));
    d->ir = *f;
    d->ir.ops = NULL;
    d->ir.kpool = NULL;
    d->ir.lines = NULL;
    d->sym = sym;
    d->alias_sym = alias_sym;
    if (sym < X64.nsym)
        d->is_static = X64.sym[sym].is_static;
    if (f->n && f->ops) {
        d->ir.ops = (IrOp *)malloc((size_t)f->n * sizeof(IrOp));
        if (d->ir.ops) {
            memcpy(d->ir.ops, f->ops, (size_t)f->n * sizeof(IrOp));
            d->ir.cap = f->n;
        }
    }
    if (f->nk && f->kpool) {
        d->ir.kpool = (u64 *)malloc((size_t)f->nk * sizeof(u64));
        if (d->ir.kpool) {
            memcpy(d->ir.kpool, f->kpool, (size_t)f->nk * sizeof(u64));
            d->ir.kcap = f->nk;
        }
    }
}

/* --- token 流（跳过换行；带 4 个 token 的前瞻） --- */

/* 前瞻窗口：PA_BUF[0] 永远是“当前 token”，消费就是整体左移一格。
 * 只做 memmove ≤4 个 32 字节结构，比“PA_POS 游标 + 边界处理”省心得多
 * （游标版本在窗口末端会让 pa_peek(1) 误报 EOF）。 */
static void agg_names_set(u32 ty, const char **names, const u32 *lens, u32 n);

/* ---------- interface ---------- */
#define IFACE_MAX 32
#define IFACE_NMET 8

static const char *IFACE_NAME[IFACE_MAX];
static u32 IFACE_NLEN[IFACE_MAX];
static const char *IFACE_MET[IFACE_MAX][IFACE_NMET];
static u32 IFACE_MLEN[IFACE_MAX][IFACE_NMET];
static u32 IFACE_RET[IFACE_MAX][IFACE_NMET];
#define IFACE_NPARAM 6
static u32 IFACE_PTY[IFACE_MAX][IFACE_NMET][IFACE_NPARAM];   /* 形参类型（不含接收者） */
static u32 IFACE_NP[IFACE_MAX][IFACE_NMET];
/* interface 签名里第一次出现的 tag：按 C 的规则那是**原型作用域**的 tag，和
 * 随后文件作用域里同名的 struct 不是同一个类型
 * （tests/errors/iface.c6 的 test_proto_scope_tag）。 */
#define PROTO_TAG_MAX 64
static u32 PROTO_TAG[PROTO_TAG_MAX];
static int NPROTO_TAG;
/* 正在解析 interface 的成员签名：这里第一次出现的 tag 属于**原型作用域**，
 * 用和普通 tag 不同的 intern 键建类型，并且只记名字（诊断要打印）、不进标签
 * 名字空间——否则随后文件作用域的 `struct P` 会命中同一个 id，两个类型就分
 * 不开了（tests/errors/iface.c6 的 test_proto_scope_tag）。 */
static int PA_IN_PROTO;
/* 原型作用域 tag 的 intern 键：把普通键的第 30 位翻一下，两者永远不相等 */
#define PROTO_TAG_KEY 0x40000000u

static void proto_tag_mark(u32 ty)
{
    int i = 0;

    for (i = 0; i < NPROTO_TAG; i++)
        if (PROTO_TAG[i] == ty)
            return;
    if (NPROTO_TAG < PROTO_TAG_MAX)
        PROTO_TAG[NPROTO_TAG++] = ty;
}

static int proto_tag_has(u32 ty)
{
    int i = 0;

    for (i = 0; i < NPROTO_TAG; i++)
        if (PROTO_TAG[i] == ty)
            return 1;
    return 0;
}
static u32 IFACE_NM[IFACE_MAX];
static u32 IFACE_TY[IFACE_MAX];
static u32 NIFACE;

/* 有没有接口类型：没有的话 store_conv / 语句分派里那几处热路径可以直接跳过 */
static int TY_HAS_IFACE;

static u32 ty_iface(u32 idx)
{
    u32 mem[2] = {0};
    const char *names[2] = {"self", "vt"};
    u32 lens[2] = {4, 2};
    u32 ty = 0;

    TY_HAS_IFACE = 1;

    if (IFACE_TY[idx])
        return IFACE_TY[idx];
    mem[0] = ty_ptr(ty_void());
    mem[1] = ty_ptr(ty_void());
    ty = ty_agg(mem, NULL, 2, 0,
                1u + (u32)(sym_hash_str("iface", 5) & 0x7FFFFFFFu) + idx);
    agg_names_set(ty, names, lens, 2);
    IFACE_TY[idx] = ty;
    return ty;
}

static int ty_is_iface(u32 ty, u32 *idx)
{
    u32 i = 0;

    for (i = 0; i < NIFACE; i++)
        if (IFACE_TY[i] == ty) {
            if (idx)
                *idx = i;
            return 1;
        }
    return 0;
}

static u32 iface_find(const char *nm, u32 nl)
{
    u32 i = 0;

    for (i = 0; i < NIFACE; i++)
        if (IFACE_NLEN[i] == nl && memcmp(IFACE_NAME[i], nm, nl) == 0)
            return i;
    return IFACE_MAX;
}

static void data_fixup_add(u32 data_off, u32 sym);
static void data_fixup_add_ex(u32 data_off, u32 sym, i64 add);

#define VT_MAX 64
static u32 VT_IF[VT_MAX];
static u32 VT_ST[VT_MAX];
static u32 VT_SYM[VT_MAX];
static u32 NVT;

static Sym *meth_find(u32 self_ty, const char *nm, u32 nl);
static void iface_check_impl(u32 ty, u32 ifx);

static u32 iface_vtbl(u32 ifidx, u32 sty)
{
    u32 k = 0;
    u32 nm = 0;
    u32 off = 0;

    for (k = 0; k < NVT; k++)
        if (VT_IF[k] == ifidx && VT_ST[k] == sty)
            return VT_SYM[k];
    nm = IFACE_NM[ifidx];
    off = data_alloc(nm * 8 ? nm * 8 : 8, 8);
    if (NVT < VT_MAX) {
        char vn[64] = {0};

        snprintf(vn, sizeof(vn), "__vt_%u_%u", (unsigned)ifidx, (unsigned)sty);
        VT_IF[NVT] = ifidx;
        VT_ST[NVT] = sty;
        VT_SYM[NVT] = x64_data_sym(&X64, arena_strdup(&A_main, vn), ELF_HDR + off);
        NVT++;
    }
    for (k = 0; k < nm; k++) {
        /* 先按"接收者就是这个实现类型"找（同名方法可以有好几份：
         * Circle_area / Rect_area），找不到再退回按裸名字找。 */
        Sym *f = meth_find(sty, IFACE_MET[ifidx][k], IFACE_MLEN[ifidx][k]);

        if (!f)
            f = sym_find(IFACE_MET[ifidx][k], IFACE_MLEN[ifidx][k]);
        if (f && f->is_func)
            data_fixup_add(off + k * 8, (u32)f->val);
    }
    return NVT ? VT_SYM[NVT - 1] : 0;
}

/* ---------- `@T` 的 GC 描述符 ----------
 * 结构体类型里哪些字段是托管引用只有前端知道（类型系统里 `@U` 和 `U *`
 * 是同一个类型 id），所以在这里单独记一张"结构体 → 托管字段下标"表，
 * 需要时再换成偏移。 */
#define MGDST_MAX 256
#define MGDST_FLD 64
static u32 MGDST_TY[MGDST_MAX];
static u8 MGDST_IDX[MGDST_MAX][MGDST_FLD];
static u8 MGDST_KIND[MGDST_MAX][MGDST_FLD];   /* 0=一个引用 1=引用数组 2=嵌套聚合 */
static u8 MGDST_CNT[MGDST_MAX][MGDST_FLD];
static u32 MGDST_N[MGDST_MAX];
static u16 MGDST_FILE[MGDST_MAX];             /* 定义落在哪个源文件（跨 TU 环诊断用） */
static u32 NMGDST;

static void mgdst_add(u32 ty, const u8 *idx, const u8 *kind, const u8 *cnt, u32 n,
                      u32 file)
{
    u32 k = 0;
    u32 j = 0;

    if (!n)
        return;
    for (k = 0; k < NMGDST; k++)
        if (MGDST_TY[k] == ty)
            break;
    if (k == NMGDST) {
        if (NMGDST >= MGDST_MAX)
            return;
        MGDST_TY[k] = ty;
        MGDST_N[k] = 0;
        NMGDST++;
    }
    /* 一个 TU 里两个结构体的类型 id 互不相同，但同一次编译里的第二个
     * 翻译单元（tests/tu/*.c6）有自己的 id 空间之外的文件归属 —— 记下
     * 定义所在文件，环检查才分得清「单元内成环」和「跨翻译单元成环」。 */
    MGDST_FILE[k] = (u16)(file > 0xFFFFu ? 0xFFFFu : file);
    if (getenv("C6C_DBG_MGDST"))
        fprintf(stderr, "[mgdst] ty=%u n=%u\n", (unsigned)ty, (unsigned)n);
    MGDST_N[k] = 0;                 /* 同一个类型会增量登记，最后一次为准 */
    for (j = 0; j < n && MGDST_N[k] < MGDST_FLD; j++) {
        if (getenv("C6C_DBG_MGDST"))
            fprintf(stderr, "  [mgdst] idx=%u kind=%u cnt=%u\n",
                    (unsigned)idx[j], (unsigned)kind[j], (unsigned)cnt[j]);
        MGDST_IDX[k][MGDST_N[k]] = idx[j];
        MGDST_KIND[k][MGDST_N[k]] = kind[j];
        MGDST_CNT[k][MGDST_N[k]] = cnt[j];
        MGDST_N[k]++;
    }
}

static int agg_find_promoted(u32 ty, const char *nm, u32 nl, u32 *sty, u32 *soff);

/* ty（含按值嵌套）里有没有叫 nm 的成员？只要个是与否。 */
static int agg_has_member(u32 ty, const char *nm, u32 nl)
{
    u32 st = 0;
    u32 so = 0;

    return agg_find_promoted(ty, nm, nl, &st, &so);
}

static u32 mgdst_find(u32 ty)
{
    u32 k = 0;

    for (k = 0; k < NMGDST; k++)
        if (MGDST_TY[k] == ty)
            return k;
    return 0xFFFFFFFFu;
}

/* 类型的定义落在哪个源文件；没登记过（或没有托管字段）返回 0xFFFF。 */
static u32 mgd_file(u32 ty)
{
    u32 k = mgdst_find(ty);

    return k == 0xFFFFFFFFu ? 0xFFFFu : (u32)MGDST_FILE[k];
}

/* 成员 idx 的种类：0=不是托管字段 1=托管引用 2=托管引用数组 3=弱引用 */
static int mgdst_kind(u32 ty, u32 idx)
{
    u32 k = mgdst_find(ty);
    u32 j = 0;

    if (k == 0xFFFFFFFFu || idx == 0xFFFFFFFFu)
        return 0;
    for (j = 0; j < MGDST_N[k]; j++)
        if ((u32)MGDST_IDX[k][j] == idx) {
            /* 内部编码：0=引用 1=引用数组 2=弱引用 3=按值嵌套
             * 对外：1=托管引用 2=引用数组 3=弱引用（嵌套本身不是指针） */
            if (MGDST_KIND[k][j] == 3)
                return 0;
            if (MGDST_KIND[k][j] == 4)
                return 1;       /* own 也是托管引用（只是不参与引用环） */
            return (int)MGDST_KIND[k][j] + 1;
        }
    return 0;
}

/* 这个类型"按值"带着托管引用吗？（结构体、按值嵌套的子结构体、
 * 托管字段数组都算）——这种类型不能按值声明/传参/赋值：拷贝一份引用
 * 却不加计数，两头都会以为自己拥有它。 */
static int ty_has_mgd(u32 ty)
{
    u32 n = 0;
    u32 i = 0;

    if (!ty || ty_is_ptr(ty) || !ty_is_agg(ty))
        return 0;
    n = TY_AT(ty)->a;                 /* 成员个数 */
    for (i = 0; i < n; i++) {
        int k = mgdst_kind(ty, i);

        if (k == 1 || k == 2)         /* 托管引用 / 托管引用数组 */
            return 1;
        if (k == 3)                   /* 弱引用：不拥有对象，拷贝没事 */
            continue;
        if (TY_AT(ty)->kids && ty_has_mgd(TY_AT(ty)->kids[i]))
            return 1;                 /* 按值嵌套的子结构体 */
    }
    return 0;
}

/* 诊断里用的类型名：`struct Foo` / `union Foo` */
static void agg_disp_name(u32 ty, char *buf, size_t cap);
static void pa_error(const char *fmt, ...);
static int in_c6_tu(void);
static int E_CLOSURE_LIT;
static const char *E_CLOSURE_NAME;

/* 捕获式字面量的值是个**闭包对象**（带环境）：转成普通函数指针就把环境丢了，
 * 调用时参数对不上、一跳就飞（tests/errors/closure_capture.c6）。 */
static void closure_lit_check(u32 to_ty)
{
    if (!E_CLOSURE_LIT || !in_c6_tu())
        return;
    if (ty_is_ptr(to_ty) && ty_is_func(ty_target(to_ty)))
        pa_error("this literal captures '%s', so its value is a closure, not a "
                 "function pointer: use 'closure RET (parameters)' as the type, or "
                 "pass the value in as a parameter",
                 E_CLOSURE_NAME ? E_CLOSURE_NAME : "?");
}



/* 诊断里用的类型名：聚合体走 agg_disp_name，标量/指针给个短名。
 * 轮流用 4 块缓冲，同一条 pa_error 里出现两次也不会串。 */
static const char *ty_disp(u32 ty)
{
    static char b[4][96];
    static int k;

    k = (k + 1) & 3;
    b[k][0] = 0;
    if (ty_is_agg(ty)) {
        agg_disp_name(ty, b[k], sizeof(b[k]));
        return b[k];
    }
    if (ty == ty_void())
        snprintf(b[k], sizeof(b[k]), "void");
    else if (ty_is_ptr(ty)) {
        if (ty_target(ty) == ty_void())
            snprintf(b[k], sizeof(b[k]), "void *");
        else if (ty_is_agg(ty_target(ty))) {
            char t2[64] = {0};

            agg_disp_name(ty_target(ty), t2, sizeof(t2));
            snprintf(b[k], sizeof(b[k]), "%s *", t2);
        } else
            snprintf(b[k], sizeof(b[k]), "pointer");
    } else if (ty_is_array(ty))
        snprintf(b[k], sizeof(b[k]), "array of %s", ty_disp(ty_target(ty)));
    else if (ty_is_int(ty))
        snprintf(b[k], sizeof(b[k]), "int");
    else
        snprintf(b[k], sizeof(b[k]), "value");
    return b[k];
}

static void pa_error(const char *fmt, ...);
static u32 ty_tuple(const u32 *tys, u32 n);
static u32 ty_slice(u32 et);

/* 在函数体里声明的 struct/union：这种类型只在那个函数里可见，不能出现在
 * 元组/切片这类"要按值搬来搬去"的地方。 */
#define LOCAL_AGG_MAX 512
static u32 LOCAL_AGG[LOCAL_AGG_MAX];
static int NLOCAL_AGG;

static void local_agg_mark(u32 ty)
{
    int i = 0;

    for (i = 0; i < NLOCAL_AGG; i++)
        if (LOCAL_AGG[i] == ty)
            return;
    if (NLOCAL_AGG < LOCAL_AGG_MAX)
        LOCAL_AGG[NLOCAL_AGG++] = ty;
}

static int is_local_agg(u32 ty)
{
    int i = 0;

    for (i = 0; i < NLOCAL_AGG; i++)
        if (LOCAL_AGG[i] == ty)
            return 1;
    return 0;
}

/* 元组元素的合法性（tests/errors/tuple.c6）：元组按值搬，元素不能是 void、
 * 函数、数组，也不能是不完整类型或者函数里声明的结构体。 */
static u32 ty_tuple_chk(const u32 *tys, u32 tn)
{
    u32 i = 0;

    for (i = 0; i < tn; i++) {
        u32 t = tys[i];

        if (t == ty_void()) {
            pa_error("'tuple' element cannot be 'void'");
            continue;
        }
        if (ty_is_func(t)) {
            pa_error("'tuple' element cannot be a function type");
            continue;
        }
        if (ty_is_array(t)) {
            pa_error("'tuple' element cannot be an array type");
            continue;
        }
        if (ty_is_agg(t) && ty_size(t) == 0) {
            pa_error("'tuple' requires a complete element type, not '%s'", ty_disp(t));
            continue;
        }
        if (ty_is_agg(t) && is_local_agg(t))
            pa_error("the element type of a 'tuple' must be declared at file scope, "
                     "but '%s' is local", ty_disp(t));
    }
    return ty_tuple(tys, tn);
}

/* 切片元素的合法性：和元组一样按值搬，元素必须完整、不能是函数里声明的
 * 结构体，也不能是 `error`（tests/errors/slice.c6）。 */
static u32 ty_slice_chk(u32 et)
{
    if (ty_is_agg(et) && ty_size(et) == 0)
        pa_error("'[:]' requires a complete element type, not '%s'", ty_disp(et));
    else if (ty_is_agg(et) && is_local_agg(et))
        pa_error("the element type of '[:]' must be declared at file scope, but "
                 "'%s' is local", ty_disp(et));
    else if (ty_is_func(et))
        pa_error("'[:]' element cannot be a function type");
    return ty_slice(et);
}

static void agg_disp_name(u32 ty, char *buf, size_t cap)
{
    const char *tn = sym_tag_name(ty);

    snprintf(buf, cap, "%s %s", ty_is_union(ty) ? "union" : "struct",
             tn ? tn : "<anonymous>");
}

static void data_u64(u32 off, u64 v)
{
    int i = 0;

    for (i = 0; i < 8; i++)
        DATA_IMG.p[off + i] = (u8)((v >> (i * 8)) & 0xFF);
}

/* `<结构体>_drop` 登记：`void drop(struct T *self)` 和结构体体里的
 * `void drop()` 方法都算 T 的析构，运行时释放到零时调它。 */
#define MGD_DROP_MAX 128
static u32 DROP_TY[MGD_DROP_MAX];
static u32 DROP_SYM[MGD_DROP_MAX];
static u32 NDROP;

static void drop_reg(u32 ty, u32 sym)
{
    u32 k = 0;

    for (k = 0; k < NDROP; k++)
        if (DROP_TY[k] == ty) {
            DROP_SYM[k] = sym;
            return;
        }
    if (NDROP < MGD_DROP_MAX) {
        DROP_TY[NDROP] = ty;
        DROP_SYM[NDROP] = sym;
        NDROP++;
    }
}

/* 这个符号是不是登记过的析构函数（`T_drop`）？析构函数不能显式调用：
 * 它由引用计数在最后一个引用放掉时调。 */
static int drop_is_sym(u32 sym)
{
    u32 k = 0;

    if (!sym)
        return 0;
    for (k = 0; k < NDROP; k++)
        if (DROP_SYM[k] == sym)
            return 1;
    return 0;
}

static u32 drop_of(u32 ty)
{
    u32 k = 0;

    for (k = 0; k < NDROP; k++)
        if (DROP_TY[k] == ty)
            return DROP_SYM[k];
    return 0;
}

#define DESC_MAX 256
static u32 DESC_TY[DESC_MAX];
static u32 DESC_SYM[DESC_MAX];
static u32 NDESC;

/* 把 ty 的托管字段展开成偏移表（递归进按值嵌套的结构体，数组按元素展开）。
 * 返回写进 out 的条数。 */
static u32 mgd_offsets(u32 ty, u32 base, u32 *out, u32 cap, u32 n)
{
    u32 mi = mgdst_find(ty);
    u32 k = 0;

    if (mi == 0xFFFFFFFFu)
        return n;
    for (k = 0; k < MGDST_N[mi] && n < cap; k++) {
        u32 mo = ty_member_off(ty, MGDST_IDX[mi][k]);
        u32 kind = MGDST_KIND[mi][k];
        u32 cnt = MGDST_CNT[mi][k];
        u32 i = 0;

        if (kind == 0 || kind == 4) {
            /* 4 = `own @T`：不参与引用环分析，但销毁时照样要放 */
            out[n++] = base + mo;
        } else if (kind == 1) {
            /* 引用数组：元素是 8 字节指针，逐个登记 */
            for (i = 0; i < cnt && n < cap; i++)
                out[n++] = base + mo + i * 8;
        } else if (kind == 3) {
            n = mgd_offsets(ty_member(ty, MGDST_IDX[mi][k]), base + mo, out, cap, n);
        }
    }
    return n;
}

/* 给结构体类型 ty 发一份 `{ drop, foff, nfoff }` 描述符，返回数据符号。 */
/* ty 里偏移 off 上的成员是托管引用吗？（方法体里裸写成员名时要用：
 * 那里是手搓地址，不会经过普通成员访问的 PEND_MGD 判定） */
static int mgd_at_off(u32 ty, u32 off)
{
    u32 foffs[64] = {0};
    u32 n = 0;
    u32 i = 0;

    n = mgd_offsets(ty, 0, foffs, 64, 0);
    for (i = 0; i < n; i++)
        if (foffs[i] == off)
            return 1;
    return 0;
}

static u32 mgd_desc(u32 ty)
{
    u32 k = 0;
    u32 off = 0;
    u32 foff = 0;
    u32 fsym = 0;
    u32 mi = 0;
    u32 nf = 0;
    u32 *foffs = NULL;
    u32 drop_sym = 0;
    char nm[192] = {0};
    const char *tag = sym_tag_name(ty);

    for (k = 0; k < NDESC; k++)
        if (DESC_TY[k] == ty)
            return DESC_SYM[k];
    if (NDESC >= DESC_MAX)
        return 0;
    mi = mgdst_find(ty);
    if (mi != 0xFFFFFFFFu && MGDST_N[mi] > 0) {
        u32 FOFF_MAX2 = 8 * MGDST_FLD;

        foffs = arena_alloc(&A_main, (size_t)FOFF_MAX2 * sizeof(u32));
        nf = mgd_offsets(ty, 0, foffs, FOFF_MAX2, 0);
        if (nf) {
            foff = data_alloc(nf * 8, 8);
            for (k = 0; k < nf; k++)
                data_u64(foff + k * 8, (u64)foffs[k]);
            snprintf(nm, sizeof(nm), "__c6_fo_%u", (unsigned)ty);
            fsym = x64_data_sym(&X64, arena_strdup(&A_main, nm), ELF_HDR + foff);
        }
    }
    drop_sym = drop_of(ty);
    off = data_alloc(24, 8);
    if (drop_sym)
        data_fixup_add(off, drop_sym);
    if (fsym)
        data_fixup_add(off + 8, fsym);
    data_u64(off + 16, (u64)nf);
    snprintf(nm, sizeof(nm), "__c6_desc_%u", (unsigned)ty);
    k = x64_data_sym(&X64, arena_strdup(&A_main, nm), ELF_HDR + off);
    DESC_TY[NDESC] = ty;
    DESC_SYM[NDESC] = k;
    NDESC++;
    return k;
}

/* c6 元组 `(T1, T2, …)`：就是一个布局固定的匿名 struct，成员名按位置叫
 * "0"/"1"/…。按元素类型列表缓存，同一个元组在任何地方都是同一个类型 id。 */
#define TUPLE_CACHE_MAX 128
#define TUPLE_MAXN 8
static u32 TUPLE_KEY[TUPLE_CACHE_MAX][TUPLE_MAXN];
static u32 TUPLE_TY[TUPLE_CACHE_MAX];
static u32 NTUPLE;

static u32 ty_tuple(const u32 *tys, u32 n)
{
    u32 i = 0;
    u32 j = 0;
    u32 mem[TUPLE_MAXN] = {0};
    const char *names[TUPLE_MAXN] = {0};
    u32 lens[TUPLE_MAXN] = {0};
    u32 ty = 0;

    if (n < 2)
        return n ? tys[0] : ty_int();
    for (i = 0; i < NTUPLE; i++) {
        int same = 1;

        for (j = 0; j < n; j++)
            if (TUPLE_KEY[i][j] != tys[j])
                same = 0;
        if (same)
            return TUPLE_TY[i];
    }
    for (j = 0; j < n; j++) {
        char *nm = arena_alloc(&A_main, 4);

        mem[j] = tys[j];
        nm[0] = (char)('0' + (int)j);
        nm[1] = 0;
        names[j] = nm;
        lens[j] = 1;
    }
    ty = ty_agg(mem, NULL, n, 0, 1u + (u32)(sym_hash_str("tuple", 5) & 0x7FFFFFFFu) + NTUPLE);
    agg_names_set(ty, names, lens, n);
    if (NTUPLE < TUPLE_CACHE_MAX) {
        for (j = 0; j < n; j++)
            TUPLE_KEY[NTUPLE][j] = tys[j];
        TUPLE_TY[NTUPLE] = ty;
        NTUPLE++;
    }
    return ty;
}

static int ty_is_tuple(u32 ty)
{
    u32 i = 0;

    for (i = 0; i < NTUPLE; i++)
        if (TUPLE_TY[i] == ty)
            return 1;
    return 0;
}

static Tok PA_BUF[PA_LOOK];
static int PA_HAVE;
/* 环形游标：消费时只挪 PA_HEAD，不再把整个窗口往前 memmove。
 * 窗口满的时候（一次深度前瞻之后）每次 advance 要搬 15 个 32 字节的
 * token，profiler 里 pa_fill 一项就占 16%。 */
static int PA_HEAD;

/* 窗口里“当前 token”的地址，PA_HAVE == 0 时为 NULL。
 *
 * pa_cur() 是**全编译器调用次数最多的函数**（tcc.c 上一次编译 648 万次，
 * 加上 pa_is_punct 319 万、pa_is_ident 239 万），原来每次都要
 * `PA_HAVE 判断 + PA_HEAD 取模 + PA_BUF 基址` 三条 load 加几条 lea。
 * 把地址缓存在这里之后只剩一条 load 一次判断，省下约 4 条指令/次。
 * 只在 pa_fill 结尾和 pa_advance 结尾写，另外 PA_HAVE 清零的地方统一走
 * pa_win_clear()。 */
static Tok *PA_CURP;

C6C_INLINE void pa_win_clear(void)
{
    PA_HAVE = 0;
    PA_CURP = NULL;
}

/* ---------- 模板（泛型）的 token 重放 ----------
 * c6 的模板在声明处只**捕获 token 区间**，实例化时把这段 token 重放一遍，
 * 参数名临时绑成 typedef——不需要"类型替换"那套机械，模板体里写什么就按
 * 什么解析。捕获和重放都挂在 pa_fill 上，前向窗口的逻辑一行没动。 */
#define RP_MAX 8
typedef struct RpFrame {
    Tok *toks;
    u32 n;
    u32 pos;
} RpFrame;

static RpFrame RP[RP_MAX];
static int RP_N;

/* token 来源栈：重放模板时，当前**前瞻窗口里还没消费**的 token 必须先存下来、
 * 排到重放流后面去（否则重放一开始读到的是源文件里紧跟着的那几个）。
 * 栈空时用预处理器。 */
#define SRC_MAX 16
typedef struct TokSrc {
    Tok *t;
    u32 n;
    u32 pos;
} TokSrc;

static TokSrc SRC[SRC_MAX];
static int NSRC;

static void pa_src_push(Tok *t, u32 n)
{
    if (NSRC >= SRC_MAX || n == 0)
        return;
    SRC[NSRC].t = t;
    SRC[NSRC].n = n;
    SRC[NSRC].pos = 0;
    NSRC++;
}

/* 把 `t` 压回源栈、让解析器重读一遍。**前瞻窗口里已经拉到但还没消费的 token
 * 必须先垫在下面**（SRC 是栈，后压的在上面），否则重放一开始读到的是那几个
 * 旧 token，整段就串位了。 */
static Tok *pa_peek(int k);      /* 下面几百行才定义，这里先用 */

static void pa_src_push_back(Tok *t, u32 n)
{
    if (PA_HAVE > 0) {
        Tok *save = arena_alloc(&A_main, sizeof(Tok) * (size_t)PA_HAVE);
        u32 ns = (u32)PA_HAVE;
        u32 q = 0;

        for (q = 0; q < ns; q++)
            save[q] = *pa_peek((int)q);
        pa_win_clear();
        pa_src_push(save, ns);
    }
    pa_src_push(t, n);
}

#define CAP_MAX 32768
static Tok CAP_TOK[CAP_MAX];
static u32 CAP_N;
static int CAP_ON;

static void pa_fill(int want)
{
    if (PA_HAVE >= want)
        return;
    while (PA_HAVE < want && PA_HAVE < PA_LOOK) {
        int at = PA_HEAD + PA_HAVE;
        Tok *t = NULL;
        int k = 0;

        if (at >= PA_LOOK)
            at -= PA_LOOK;
        /* 直接填进窗口格子（out 只是中途落脚点）：先落到局部 Tok、再拷进
         * PA_BUF 是每个 token 两趟 40 字节的搬运。 */
        t = &PA_BUF[at];
        if (NSRC > 0) {
            TokSrc *sc = &SRC[NSRC - 1];

            if (sc->pos < sc->n) {
                *t = sc->t[sc->pos++];
                k = (int)t->kind;
            } else {
                NSRC--;
                continue;
            }
        } else {
            k = pp_next(t);
            if (k == TK_NL)
                continue;
        }
        /* 捕获要记**所有**进来的 token，不只是预处理器的。函数字面量里再写
         * 函数字面量时，外层体是从 SRC 栈里重放的，只记预处理器那条路的话
         * 内层体捕到的是空串（`tests/fn_lit.c6` 的嵌套字面量）。 */
        if (CAP_ON && CAP_N < CAP_MAX) {
            /* 拉进来的 token 未必都会被消费（前瞻窗口会多拉几个），
             * 由捕获结束时的花括号配平来裁掉多余的。 */
            CAP_TOK[CAP_N++] = *t;
        }
        PA_HAVE++;
        if (k == TK_EOF)
            break;
    }
    PA_CURP = PA_HAVE > 0 ? &PA_BUF[PA_HEAD] : NULL;
}

static Tok *pa_peek_slow(int k)
{
    static Tok eof_tok;
    static int inited = 0;

    if (!inited) {
        memset(&eof_tok, 0, sizeof(eof_tok));
        eof_tok.kind = TK_EOF;
        inited = 1;
    }
    pa_fill(k + 1);
    if (k >= PA_HAVE)
        return &eof_tok;
    {
        int idx2 = PA_HEAD + k;

        if (idx2 >= PA_LOOK)
            idx2 -= PA_LOOK;
        return &PA_BUF[idx2];
    }
}

/* 前瞻一格是解析器最频繁的动作之一（profile 里 pa_peek 占 2.6%）。
 * 窗口里已经有就直接给指针，不再走 pa_fill 的那个函数调用 + 判空。 */
C6C_INLINE Tok *pa_peek(int k)
{
    if (k < PA_HAVE) {
        int idx = PA_HEAD + k;

        if (idx >= PA_LOOK)
            idx -= PA_LOOK;
        return &PA_BUF[idx];
    }
    return pa_peek_slow(k);
}

C6C_INLINE Tok *pa_cur(void)
{
    Tok *t = PA_CURP;

    if (t)
        return t;
    pa_fill(1);
    t = PA_CURP;
    if (t)
        return t;
    return pa_peek(0);
}

static void pa_advance(void)
{
    if (PA_HAVE <= 0)
        return;
    PA_HEAD++;
    if (PA_HEAD >= PA_LOOK)
        PA_HEAD = 0;
    PA_HAVE--;
    pa_fill(1);
    PA_CURP = PA_HAVE > 0 ? &PA_BUF[PA_HEAD] : NULL;
}

/* 单字符标点：`pa_is_punct("}")` 这一类占全部标点判断的九成二（550/597 个
 * 调用点）。走字符串版要先 load 首字节、再查 s[t->len] 是不是 0、最后还要进
 * tok_eq 循环，二十条指令才能说一句“不是”；单字符版只要 kind / len / 首字节
 * 三条判断，十亿级调用次数下这笔差值是实打实的。调用点统一换成 pa_is_ch。 */
C6C_INLINE int pa_is_ch(int ch)
{
    Tok *t = pa_cur();
    const char *d = NULL;

    if (t->kind != TK_PUNCT || t->len != 1)
        return 0;
    d = tok_data(t);
    return (u8)d[0] == (u8)(ch & 0xFF);
}

/* 同上：名字是固定字面量，长度编译期已知，先比 t->len 再比字节。
 * 调用点由脚本统一换成 PA_IS_IDENT / PA_ACCEPT_IDENT。 */
C6C_INLINE int pa_is_ident_n(const char *s, u32 n)
{
    Tok *t = pa_cur();

    return t->kind == TK_IDENT && tok_eq_len(t, s, n);
}

C6C_INLINE int pa_accept_ident_n(const char *s, u32 n)
{
    if (pa_is_ident_n(s, n)) {
        pa_advance();
        return 1;
    }
    return 0;
}

#define PA_IS_IDENT(lit) pa_is_ident_n((lit), (u32)(sizeof(lit) - 1))
#define PA_ACCEPT_IDENT(lit) pa_accept_ident_n((lit), (u32)(sizeof(lit) - 1))

C6C_INLINE int pa_accept_ch(int ch)
{
    if (pa_is_ch(ch)) {
        pa_advance();
        return 1;
    }
    return 0;
}

C6C_INLINE int pa_is_punct(const char *s)
{
    Tok *t = pa_cur();

    /* 先比首字节和长度，绝大多数不匹配的调用一步就否掉（profiler 里这条
     * 判断占 9.9%，是全编译器最热的谓词之一）。 */
    if (t->kind != TK_PUNCT || t->len == 0 || tok_data(t)[0] != s[0] || s[t->len] != 0)
        return 0;
    return tok_eq(t, s);
}

C6C_INLINE int pa_is_ident(const char *s)
{
    Tok *t = pa_cur();

    return t->kind == TK_IDENT && tok_eq(t, s);
}

C6C_INLINE int pa_accept_punct(const char *s)
{
    if (pa_is_punct(s)) {
        pa_advance();
        return 1;
    }
    return 0;
}

C6C_INLINE int pa_accept_ident(const char *s)
{
    if (pa_is_ident(s)) {
        pa_advance();
        return 1;
    }
    return 0;
}

static void pa_dbg_counts(void);
static u32 frame_slots_for(u32 size);
static void gen_init_braced(u32 addr, u32 ty, u32 off);
static void gen_init_obj(u32 addr, u32 ty, u32 off);
static u32 INIT_COUNT;      /* 上一次初始化器给了多少个元素（补全 a[] 长度用） */
static int INIT_CNT_OK;     /* INIT_COUNT 是否被这次初始化器写过（空初始化器也算 0） */
/* GNU 语句表达式 ({ ... })：值 = 块里最后一条表达式语句的值 */
static u32 BLOCK_VAL;
static u32 BLOCK_TY;
static int BLOCK_HAS;
static u32 METHOD_SELF_TY;  /* 结构体内方法：接收者类型（0 = 普通函数） */
/* 方法体入口那一层作用域。模板实例的体是在实例化点展开的，那里能看见
 * 调用方函数的局部量——裸字段名会被同名局部量遮住（见 sym_in_method_scope）。 */
static Scope *METHOD_SCOPE_BASE;
static u32 CUR_RET_TY;      /* 当前函数的返回类型（return 要按它转换） */
/* 聚合按值返回的"结果槽"（**只给 C99 输出后端**用）：C 的语义是调用者提供
 * 位置、被调方写进去；C99 后端以前返回的是被调方帧里那个临时对象的地址，
 * 调用方拿到就已经失效——它生成的 C 在 `gcc -O1` 下读到被复用的栈，
 * `struct S s = f();` 全是垃圾（native/LLVM 后端各自有自洽的约定，不受影响）。
 * 约定：这种函数多收一个隐藏形参（排在所有显式形参后面），`return <聚合>`
 * 把对象拷进去、再把这个指针原样返回。只在 C99 后端开，所以同一个程序里
 * 每一对调用点/定义都一致；变参函数不参与（位置对不齐）。 */
static u32 CUR_SRET;
/* `CUR_SRET` 有没有值**不能**用"是不是 0"判断：虚寄存器 0 是合法的（零形参
 * 函数的第一个 vreg 就是 0），拿 0 当哨兵会让 `struct A f(void)` 这种最常见的
 * 写法悄悄退回旧路径。 */
static int CUR_SRET_ON;

/* 聚合按值返回走"调用者给槽"那套约定吗？ */
static int agg_ret_abi(u32 fty, u32 rty)
{
    if (!C99_MODE)
        return 0;               /* native / LLVM 后端保持各自的既有约定 */
    if (!rty || !ty_is_agg(rty) || ty_size(rty) == 0)
        return 0;
    /* 变参函数不参与：隐藏实参排在"实际传了几个实参"后面，被调方那边没有
     * 确定位置。**零形参是例外**：c6c 把 `(void)`/`()` 这种无形参表当成
     * "可以多传实参"（`f(void)` 写成 `f(1,2)` 也能编），但零形参时隐藏实参
     * 正好落在第 0 个，两边一致——不认这条，`struct A ma(void)` 这种最常见的
     * 写法就退回"返回被调方帧地址"，C99 后端在 `-O1` 下读出来是垃圾。 */
    if (fty && ty_func_variadic(fty) && ty_func_nparams(fty) > 0)
        return 0;
    if (fty && ty_is_closure(fty, NULL))
        return 0;               /* 闭包走 thunk，隐藏实参位置对不齐 */
    return 1;
}
static u32 ty_promote(u32 ty);
/* `sizeof("a" "b" …)`：括号里是一串（至少一个）相邻字符串字面量、后面紧跟
 * `)`。以前只认"恰好一个"字面量，拼接的（`sizeof("39°" "54'15\"N")`）掉进
 * 表达式分支，拿到的是退化后的 `char *`，sizeof 变成 8——stdgeo 的
 * `S(...)` 这类拼接字面量长度全错（DMS 的秒位被截掉，to_deg 少算 15 角秒）。 */
static int sizeof_lit_run(void)
{
    int k = 1;

    if (!pa_is_ch('(') || !pa_peek(1) || pa_peek(1)->kind != TK_STR)
        return 0;
    while (k < 64 && pa_peek(k) && pa_peek(k)->kind == TK_STR)
        k++;
    return pa_peek(k) && pa_peek(k)->kind == TK_PUNCT && tok_eq(pa_peek(k), ")");
}

static u32 gen_unary(void);
static int parse_const_u64(u64 *out);
static u32 cur_op_ty(void);
static u32 gen_convert(u32 v, u32 from, u32 to);
static void gen_block(void);
/* C99 复数（_Complex）：类型层在 parse_typespec 前面，值运算在 gen_mul 前面 */
static int ty_is_cplx(u32 ty);
static u32 cplx_comp(u32 cty);
static u32 cplx_temp(u32 cty);
static u32 cplx_load(u32 addr, u32 ct, u32 off);
static void cplx_store(u32 addr, u32 ct, u32 off, u32 v);
static u32 cplx_from_real(u32 v, u32 vty, u32 cty);
static u32 cplx_zero(u32 ct);
static u32 cplx_bin(u8 op, u32 a, u32 aty, u32 b, u32 bty);
static u32 cplx_cmp(u8 cc, u32 a, u32 aty, u32 b, u32 bty);
static u32 cplx_neg(u32 a, u32 cty);
static u32 gen_int_lit(u64 c, u32 ty);
static u32 gen_cmp3(u32 a, u32 aty, u32 b, u32 bty, u8 cc, u32 cty);

typedef struct InitSave {
    u32 n;
    int trunc;
    u32 cur;
    u32 max;
    u32 lvd;
    u32 count;
    int cntok;
    u32 *off;
    u32 *ty;
    u32 *bits;
    u32 *boff;
    u32 *lvty;
    u32 *lvoff;
} InitSave;

/* 复合字面量（`(Str){ … }`）可能出现在**另一个初始化器里**：
 * `Str a[3] = { (Str){ … }, (Str){ … }, … }`。它内部的 gen_init_obj 会把全局
 * 的叶子表（LF_）、游标（INIT_CUR / INIT_MAX）和层栈（LV_）整个重建，外面那个
 * 初始化器接着走时游标已经指向别处——表现就是"只有第一个元素被写进去，剩下两个
 * 被 skip_init_list 当成多余的值吞掉"（std-search2 的倒排统计因此对不上）。
 * 进出各存/取一次，外面那个初始化器完全不受影响。 */
static void init_save(InitSave *st);
static void init_restore(InitSave *st);

/* 上限可调：环境变量 C6C_MAX_ERRORS（默认 20），调大是为了能一次看清
 * 大文件（比如 tcc.h）里所有独立的错误点。 */
static int pa_err_cap = -1;

/* 当前 token 所在的源文件是不是 c6 翻译单元（扩展名 `.c6`）？c6 的语法与
 * 诊断只对 `.c6` 生效：纯 C 的 TU（`tests/abi/*_plain.c`、tcc 的源码）照 C
 * 的规矩来——那边"未初始化"是合法的。 */
static int DEF_DEPTH;      /* 前向声明：块嵌套深度（定义在后面，见 gen_block） */

static int C6_TU_SEEN;      /* 这个编译单元里有 .c6 文件（主文件就是） */

/* 自动挂上的自带运行时（lib/rt.c6）的源文件 id，0 = 还没挂。
 *
 * 它**不参与** C6_TU_SEEN 的判定：运行时是 c6c 自己无条件塞进来的，跟用户
 * 这一单编的是不是 c6 无关。少了这一条，编任何纯 C 文件都会因为 rt.c6 被
 * 预处理到而把整个 TU 认成 c6——于是**外部头文件**里的函数体开始按 c6 的
 * 规矩查，"`int bytes;` 必须初始化"在内核 include/linux/overflow.h 上直接
 * 开火（实测：只 include <linux/list.h> 就多出 3 条这一类假诊断）。 */
static u32 C6_RT_FILE;

/* in_c6_tu() 的按文件缓存：文件 id → 后缀类别（1 = `.c6`，2 = `.h`，3 = 别的）。
 * 这个判断每个 token 都要被问一次（`c6_kw()` 撒在声明、表达式、语句解析的每个
 * 岔路口），原来每问一次就 strlen(路径) + memcmp 走一遍路径字符串——c6c 自己
 * 1.2 MB 源码上有几百万次，profiler 里占 2.7%。后缀不会变，按文件 id 记一次就
 * 够；`.h` 的答案还取决于 C6_TU_SEEN（从 .c6 里 include 进来的头文件也按 c6 的
 * 规矩查），所以这一位每次现判。 */
#define C6K_MAX 8192
static u8 C6K_CLASS[C6K_MAX];

/* c6c **自带**的 include 目录（stddef.h / string.h … 所在的那几个），由
 * main.c6 的 setup_incdirs() 填。声明的落点必须在 parse.c6——它比 main.c6
 * 先被 #include 进来（见 src/c6c.c6 的顺序）。 */
#define C6_SELF_INCDIRS_MAX 4
static const char *C6_SELF_INCDIR[C6_SELF_INCDIRS_MAX];
static int N_C6_SELF_INCDIR;

/* c6c **自带的** include/ 里的头（stddef.h / string.h / stdio.h …）：那是 c6
 * 自己的头，按 c6 的规矩解析，不是外部 C 头。
 *
 * 为什么要单列一条：这些头里的声明（`typedef unsigned long size_t;`、
 * `void *memcpy(void *dst, const void *src, size_t n);`）是**规范写法**，但
 * `in_c6_tu()` 只看后缀——`.h` 在纯 C 的 TU 里被当成"外部头"，于是
 * 「不带类型说明符」那条判据把它们全认成隐式 int，一个空 TU 上刷 218 条
 * `type defaults to int` 的**假警告**（实测：`-fsyntax-only` 一个只 include
 * <stddef.h> 的文件，stderr 218 行）。编译内核这种每行都要 `-Werror` 的活
 * 直接被这层噪声淹没，真正要看的诊断反而看不见。
 *
 * 判据取"路径是否落在 INCDIR[] 里某个 c6 自带目录下"：命令行 -I 给的目录
 * 不算（那是用户的外部头），而是 setup_incdirs() 按 C6C_SELF_DIR 拼出来的那
 * 几个——`<self>/include`、`<self>/../include`、`<self>/../lib/c6/include`
 * （安装布局下 <self> = <prefix>/bin，第三条正是 <prefix>/lib/c6/include），
 * 外加 `-B` 目录下的 `include/`。它们由 main.c6 在填 INCDIR[] 时同步记进
 * C6_SELF_INCDIR[]，这里只做前缀比较。 */
static int c6_bundled_header(const char *path, size_t n)
{
    int i = 0;

    if (!path || n < 8)
        return 0;
    for (i = 0; i < N_C6_SELF_INCDIR; i++) {
        const char *d = C6_SELF_INCDIR[i];
        size_t dn = d ? strlen(d) : 0;

        if (dn && n > dn + 1 && path[dn] == '/'
            && memcmp(path, d, dn) == 0)
            return 1;
    }
    return 0;
}

static int in_c6_tu(void)
{
    Tok *t = pa_cur();
    SrcFile *f = NULL;
    u32 id = 0;
    u8 k = 0;
    size_t n = 0;

    if (!t)
        return 0;
    id = t->file;
    if (id < C6K_MAX)
        k = C6K_CLASS[id];
    if (!k) {
        f = file_by_id(id);
        if (!f || !f->path)
            return 0;
        n = strlen(f->path);
        if (n > 3 && memcmp(f->path + n - 3, ".c6", 3) == 0)
            k = 1;
        else if (c6_bundled_header(f->path, n))
            k = 1;      /* c6c 自带的 include/ 就是 c6 的头，不是外部 C 头 */
        else if (n > 2 && memcmp(f->path + n - 2, ".h", 2) == 0)
            k = 2;
        else
            k = 3;
        if (id < C6K_MAX)
            C6K_CLASS[id] = k;
    }
    if (k == 1) {
        /* 自动挂上的运行时不算数：它是 c6c 自己塞的，不代表用户编的是 c6 */
        if ((u32)id == C6_RT_FILE)
            return 0;
        /* 记一笔：从 .c6 里 include 进来的头文件（`.h`）也按 c6 的规矩查
         * （tests/errors/loc.c6 的 test_sizeof_in_header：头文件里不能
         * `int g;` 这样定义未初始化的对象）。 */
        C6_TU_SEEN = 1;
        return 1;
    }
    return (k == 2 && C6_TU_SEEN) ? 1 : 0;
}

/* c6 的软关键字（`shared` / `weak` / `own` / `closure` / `try` / `@` …）只在
 * .c6 里才有特殊含义。`.c` 是**纯 C99**（README 明说没有 -std=c6），这些词
 * 在那里必须是普通标识符：`int shared = 1;`、`struct S { int own; };`、
 * `s.weak++`、`s.try` 全都要编得过。所有认这几个词的地方都先过这一道。 */
static int c6_kw(void)
{
    return in_c6_tu();
}

static Tok *PA_ERR_AT;
static void pa_error(const char *fmt, ...)
{
    va_list ap = {0};
    Tok *t = PA_ERR_AT ? PA_ERR_AT : pa_cur();

    PA_ERRS++;
    if (pa_err_cap < 0) {
        const char *e = getenv("C6C_MAX_ERRORS");

        pa_err_cap = e ? atoi(e) : 20;
        if (pa_err_cap <= 0)
            pa_err_cap = 20;
    }
    if (PA_ERRS > (u32)pa_err_cap) {
        diag_emit("c6c: 错误太多，停止");
        exit(1);
    }
    if (getenv("C6C_DBG_COUNTS"))
        pa_dbg_counts();
    {
        /* 文件 id 0 是**合法**的首个文件——不能拿 0 当"没有位置" */
        SrcFile *sf = file_by_id(t->file);
        char msg[1024] = {0};
        int n = 0;

        if (!sf && FILES.head)
            sf = FILES.head;
        n = snprintf(msg, sizeof(msg), "c6c: %s:%u: ", sf ? src_path_of(sf) : "<internal>",
                     sf ? src_line_of(sf, t->off) : 0);
        if (n < 0)
            n = 0;
        if (n > (int)sizeof(msg) - 2)
            n = (int)sizeof(msg) - 2;
        va_start(ap, fmt);
        vsnprintf(msg + n, sizeof(msg) - (size_t)n, fmt, ap);
        va_end(ap);
        msg[sizeof(msg) - 1] = 0;
        /* 走 diag_emit：一行 path:line: 打到 stderr（字节与以前一样）。 */
        diag_emit(msg);
    }
}

static void pa_expect_ch(int ch)
{
    if (!pa_accept_ch(ch))
        pa_error("这里要 '%c'（当前是 '%.*s'）", ch, (int)pa_cur()->len, tok_data(pa_cur()));
}

static void pa_expect_punct(const char *s)
{
    if (!pa_accept_punct(s))
        pa_error("这里要 '%s'（当前是 '%.*s'）", s, (int)pa_cur()->len, tok_data(pa_cur()));
}

/* tcc 口径的 warning：`path:line: warning: …`（**没有列号**）。
 * tcc 的 tests2 里有一批 .expect 的第一段就是它自己的告警原文
 * （tests2/149_parameter_qualifier_errors.expect 只有一行这个），格式对不上
 * 就整条用例判"输出不符"。列号那版走 diag_warn()，这个是给上游兼容用的。 */
static void pa_warn_tcc(const char *fmt, ...)
{
    va_list ap = {0};
    Tok *t = pa_cur();
    SrcFile *sf = file_by_id(t->file);
    char msg[1024] = {0};
    int n = 0;

    if (!sf && FILES.head)
        sf = FILES.head;
    n = snprintf(msg, sizeof(msg), "%s:%u: warning: ",
                 sf ? src_path_of(sf) : "<internal>",
                 sf ? src_line_of(sf, t->off) : 0);
    if (n < 0)
        n = 0;
    if (n > (int)sizeof(msg) - 2)
        n = (int)sizeof(msg) - 2;
    va_start(ap, fmt);
    vsnprintf(msg + n, sizeof(msg) - (size_t)n, fmt, ap);
    va_end(ap);
    msg[sizeof(msg) - 1] = 0;
    diag_emit(msg);
}

/* --- 类型说明符与声明符 --- */

/* 关键字表：预先算好每个关键字的 hash，查表时先比 hash 再比字节。
 * 这个函数每个标识符 token 都要调一次，线性比 41 个字符串曾经占掉 13% 的运行时间
 * （profiler 里 tok_eq 高居第二）。 */
static u32 TYKW_HASH[64];
static const char *const TYKW_NAME[64] = {
    "void", "char", "short", "int", "long", "float", "double", "signed",
    "unsigned", "const", "volatile", "struct", "union", "enum", "static",
    "extern", "inline", "register", "auto", "_Bool", "_Atomic", "_Complex",
    "_Noreturn", "__signed__", "__const", "__volatile__", "restrict",
    "__restrict", "__restrict__", "__extension__", "typeof", "__typeof__",
    "__typeof", "_Alignas", "alignas", "_Thread_local", "__thread",
    "__attribute__", "__attribute", "_Static_assert", "__inline", "__inline__",
    "typedef", "__auto_type",
    /* 128 位整数（GCC 扩展）。它们必须在表里，因为 is_typename_tok 决定
     * 「这里开始一条声明 / 这是个强制转换」；漏了的话 `__int128 x = 0;`
     * 和 `(__int128)k * load` 都会被当成表达式开头的普通标识符。 */
    "__int128", "__int128_t", "__uint128_t", "__builtin_va_list",
    NULL
};

/* 关键字查找的开放寻址表：`is_typename_tok` 每个标识符都调一次，线性扫 42 个
 * 字符串曾经是 profile 里稳定的一块。槽里存"下标 + 1"，0 = 空。 */
static u16 TYKW_SLOT[256];

static void tykw_init(void)
{
    int i = 0;

    for (i = 0; TYKW_NAME[i] && i < 64; i++) {
        u32 h = tok_hash(TYKW_NAME[i], (u32)strlen(TYKW_NAME[i]));
        u32 sl = h & 255;
        int g = 0;

        TYKW_HASH[i] = h;
        while (TYKW_SLOT[sl] && g++ < 8)
            sl = (sl + 1) & 255;
        if (!TYKW_SLOT[sl])
            TYKW_SLOT[sl] = (u16)(i + 1);
    }
}

static int tykw_is_qual(Tok *t);
static int is_typename_tok(Tok *t)
{
    int i = 0;
    Sym *s = NULL;

    if (t->kind != TK_IDENT)
        return 0;
    /* `closure` 不进关键字表：它是 c6 独有的类型关键字，`.c` 里必须能当普通
     * 标识符（`static int wrap(int closure){ … }` 的形参名就是这么用的）。
     * 先比长度，热路径上几乎不花钱。 */
    if (t->len == 7 && memcmp(tok_data(t), "closure", 7) == 0)
        return c6_kw();
    /* `bf16` 同理：c6 独有的类型关键字，`.c` 里必须能当普通标识符
     * （`int bf16 = 1;` 这种老代码不断）。 */
    if (t->len == 4 && memcmp(tok_data(t), "bf16", 4) == 0)
        return c6_kw();
    {
        u32 sl = t->hash & 255;
        int g = 0;

        while (TYKW_SLOT[sl] && g++ < 8) {
            u32 k = (u32)TYKW_SLOT[sl] - 1;

            if (TYKW_HASH[k] == t->hash && tok_eq(t, TYKW_NAME[k]))
                return 1;
            sl = (sl + 1) & 255;
        }
    }
    i = 0;
    s = sym_find(tok_data(t), t->len);
    if (s && s->kind == SC_TYPEDEF)
        return 1;
    /* 接口名也是类型名（`sizeof(Shape)`、`(Shape)x`、`Shape s = x;`），
     * 但它不在符号表里，走接口表。 */
    return NIFACE > 0 && iface_find(tok_data(t), t->len) < IFACE_MAX;
}

/* 一个函数能有多少个形参/实参。tcc 的 `tests/abitest.c` 里有超过 16 个实参的
 * 调用，16 太紧；64 够用，栈上的临时数组也就 64 字节。 */
#define PA_ARG_MAX 64

/* 多维 VLA **形参**的形状（`void f(int n, int m, int a[n][m])` 里的 a）。
 *
 * 为什么单独记一份：形参表里 n/m 的值还没有，算不出行 stride（见 dims_apply
 * 里的注释）。声明符上只留"每一维是常量还是哪个形参名"，等 pa_func_def 在
 * 函数入口按槽里的值现算（pa_vla_param_prep）。记录挂在函数声明符的
 * `pvla_head` 链上，按 `idx`（第几个形参）对号——形参的声明符是临时对象，
 * 用完就没了，所以记录要复制到 arena 里。 */
typedef struct PVla {
    struct PVla *next;      /* 同一个函数声明符上的下一条记录 */
    u8 idx;                 /* 这是第几个形参（== d->nparams，绑帧时对号） */
    u8 nd;                  /* 维度数（>= 2 才有这条记录） */
    u8 k[8];                /* 每一维：0 = 常量，1 = 简单标识符 */
    u32 c[8];               /* k == 0：常量长度（0 = 空着的维度） */
    const char *nm[8];      /* k == 1：名字（一般就是前面的形参名） */
    u32 nl[8];              /* k == 1：名字长度 */
    u32 esz;                /* 最内层元素大小（字节） */
} PVla;

typedef struct Declarator {
    const char *name;
    u32 nlen;
    int is_func;
    u32 ptype[16];      /* 形参类型 */
    const char *pname[16];  /* 形参名字（可能为 NULL） */
    u32 plen[16];
    u32 nparams;
    int variadic;
    u8 knr;             /* 旧式（K&R）定义：参数表里只有名字 */
    u8 knr_conv;        /* 实参按默认提升传进来（调用方没看到原型） */
    u8 pknr[PA_ARG_MAX];        /* 该参数的类型是在 K&R 声明列表里给出的 */
    u8 pmgd[PA_ARG_MAX];        /* 该参数是托管引用：1 = `@T p`（借用，返回时要加计数），2 = `weak @T p` */
    u8 pshared[PA_ARG_MAX];     /* 该参数写了 `shared @T` */
    u8 pconst[PA_ARG_MAX];      /* 该参数的**对象**是只读的（`int *const p`） */
    u8 obj_const;       /* 这个声明符声明的对象本身带 const（`*const p`） */
    u8 arrqual;         /* `int x[const 5]` 方括号里的限定符（形参：归调整后的指针） */
    u8 vla;             /* C99 变长数组：长度是运行期表达式 */
    u32 vla_cnt;        /* 长度（vreg） */
    u32 vla_esz;        /* 元素大小（字节） */
    /* 多维 VLA（`int b[n][m]`）：类型表示成 k 层指针，每一维的行 stride 在
     * 声明处算成 vreg（`vla_str[i]` = 跳过第 i 维一个元素的字节数），
     * 整块字节数 `vla_bytes` 也现算（多维时 ALLOCA 的立即数装不下 stride）。 */
    u8 vla_nd;          /* 维度数（多维时 >= 2） */
    u8 vla_multi;       /* 1 = 多维 VLA，vla_bytes/vla_str 有效 */
    u32 vla_str[8];     /* 行 stride（vreg，字节；最内维不用，按元素大小缩放） */
    u32 vla_bytes;      /* 整块字节数（vreg） */
    u8 ptr_depth;       /* 这个声明符里已经吃掉几层 `*` */
    u8 paren;           /* 套过括号声明符：`int (*p)[m]` 才是"指向数组的指针" */
    PVla pvla;          /* 多维 VLA 形参的形状（见 PVla；nd == 0 = 不是） */
    PVla *pvla_head;    /* 函数声明符：形参们留下的形状记录链 */
    u32 type;           /* 解析出来的完整类型（形参/抽象声明符也要用） */
    u8 mgd;             /* `@T`：托管引用（机器层面还是 T *，但要插引用计数） */
    u8 mgd_kind;        /* 0=强引用 1=weak（不加计数） 2=own（同强引用） */
    u8 mgd_shared;      /* `shared @T`：这个槽/形参按跨线程共享处理 */
    u8 own_params_taken;    /* 标识符自己那层参数表已经解析过（见 parse_param_list） */
} Declarator;

/* 发射层加模块前缀（docs/modules.md 的 M2'）：
 * 符号表里永远是短名（std/ 里跨模块引用、方法表、接口表全按短名比），
 * 只有"最终要落到目标文件里的名字"才加 `<模块前缀>`。这样 std/ 不会被前缀
 * 搅坏，两个 TU 编到一起时又不会撞名。非模块文件前缀是空串，等于恒等。 */
static const char *emit_name(const char *nm)
{
    const char *pfx = "";
    u32 pl = 0;
    char *b = NULL;

    if (CUR_FILE)
        pfx = mod_prefix(mod_of_file((u32)CUR_FILE->id));
    if (!pfx || !pfx[0] || !nm)
        return nm;
    pl = (u32)strlen(pfx);
    b = arena_alloc(&A_main, pl + strlen(nm) + 1);
    memcpy(b, pfx, pl);
    strcpy(b + pl, nm);
    return b;
}

static void pa_func_def(Sym *s, Declarator *d);
/* ---- 多 TU ----
 *
 * 命令行上一个源文件 = 一个翻译单元（main.c6 逐文件调 pa_parse_new_tu）。
 * 符号表、类型表、数据段、代码段仍然是**整份镜像一份**：外部符号按名字
 * intern，所以"TU1 定义、TU2 引用"天然接得上，缺谁由最后的回填
 * （x64_resolve）一次性报出来。TU 之间真正要分家的只有文件作用域的
 * `static`：符号表用 sym_tu_begin() 摘掉前一个 TU 的，发射名用
 * tu_static_name() 加 `$<TU>` 后缀。自带运行时算 TU 0，命令行上的源文件
 * 从 TU 1 起。 */
static u32 PA_TU;
/* 输入文件个数：只有多 TU 才需要给 static 符号分家（见 tu_static_name）。
 * 驱动（main.c6）在开编之前把命令行上的文件数传进来；不传就是 1 = 单文件。 */
static u32 PA_NFILES = 1;

static void pa_set_nfiles(u32 n)
{
    PA_NFILES = n ? n : 1;
}

/* -c（ET_REL）：驱动在开编之前打开。打开之后 pa_finish 走 obj.c6 那条路：
 * 不查 main、不容错未定义符号、不拍绝对地址（见 obj.c6 的说明）。 */
static int PA_RELOC;

/* obj.c6 在本文件之后 include（它要用 DFIX / CLBL 这些解析期的记录），
 * 这里先声明。 */
static void obj_write(const char *path);

static void pa_set_reloc(int v)
{
    PA_RELOC = v ? 1 : 0;
}

/* 文件作用域 `static` 的**发射名**：拿不到模块前缀那套（static 本来就
 * 不跨模块），换成 TU 后缀 —— `helper$2`。符号表里仍是短名 `helper`
 * （本 TU 内的解析、诊断、方法表全按短名走），只有落到镜像里的名字分家：
 * 两个 TU 各写一个 `static int helper(void)` 时，它们是两段互不相干的代码。
 * `$` 在 ELF 符号名里合法，C99/LLVM 后端本来就会把它换成 `_`。 */
static const char *tu_static_name(const char *nm)
{
    char buf[256] = {0};

    if (!nm)
        return nm;
    /* 单文件（自编译就是）根本不需要分家：直接返回原名，省掉每个 static 符号
     * 一次 snprintf + 一次 arena 复制（c6c 自己两千多个 static 函数，实测
     * 1~2 ms）。多 TU 才走下面那条路。 */
    if (PA_NFILES <= 1)
        return nm;
    snprintf(buf, sizeof(buf), "%s$%u", nm, (unsigned)PA_TU);
    return arena_strdup(&A_main, buf);
}

/* 数据段初始化器里写函数名（`static struct Big (*p)(int) = big;`）时，要
 * 重定位到哪个符号：非 static 的用**源码名**（方法/模板实例的真符号是
 * `<结构体>_<函数名>`，源码名是那条弱别名，纯 C 的 TU 也按它调）；static
 * 的只有带 TU 后缀的那一个名字（它没有弱别名，源码名在镜像里不存在）。 */
static u32 addr_sym_of(Sym *t)
{
    if (t->is_func && !t->is_static)
        return x64_sym(&X64, t->name);
    return (u32)t->val;
}

/* `__attribute__((alias("target")))` / `__asm__("target")`：这个名字**没有
 * 自己的代码/存储**，只是 target 的第二个入口。target 可能写在本 TU 后面，
 * 也可能在别的 TU 里（120_alias 的 asm_for_target 就是），所以先记账，
 * 等所有 TU 解析完、回填之前一次性接上（x64_alias_idx 就是"名字 → 偏移表"
 * 里再加一条）。 */
#define ALIAS_MAX 256
static const char *ALIAS_FROM[ALIAS_MAX];
static const char *ALIAS_TO[ALIAS_MAX];
static u32 NALIAS;

static void alias_register(const char *from, const char *to)
{
    if (!from || !to || !to[0] || from[0] == 0)
        return;
    if (NALIAS >= ALIAS_MAX)
        return;
    ALIAS_FROM[NALIAS] = from;
    ALIAS_TO[NALIAS] = to;
    NALIAS++;
}

/* 方法式函数的**短名 → 真名**别名。
 *
 * 声明那会儿结构体可能还只有个名字（`struct Bucket;`），发射名只能按源码
 * 短名走，调用点也按它发过重定位；等到定义处结构体补齐了，发射名换成
 * `<结构体>_<方法>`，旧的那条就悬着了（`static int poke(Bucket *b);` 先声明
 * 后定义时，链接期报 `poke$2` 未定义）。
 *
 * 记账而不是当场接：`x64_alias_idx` 干的是**复制偏移**，定义处这会儿代码
 * 还没生成，接过去的是 0 —— 引用会跳到地址 0（c6c 编 tcc 时 whole 程序
 * 一启动就段错误，就是这条线踩的）。等所有 TU 解析完、代码都发出来，
 * `alias_apply()` 里再接，那会儿偏移才是定下来的。
 */
#define METH_ALIAS_MAX 1024
static u32 METH_ALIAS_FROM[METH_ALIAS_MAX];
static u32 METH_ALIAS_TO[METH_ALIAS_MAX];
static u32 NMETH_ALIAS;

static void meth_alias_register(u32 from, u32 to)
{
    if (from == to || NMETH_ALIAS >= METH_ALIAS_MAX)
        return;
    METH_ALIAS_FROM[NMETH_ALIAS] = from;
    METH_ALIAS_TO[NMETH_ALIAS] = to;
    NMETH_ALIAS++;
}

static u32 gen_expr(void);
static u32 gen_assign(void);
static u32 value_of(u32 v);
static int agg_find_promoted(u32 ty, const char *name, u32 nlen, u32 *out_ty,
                             u32 *out_off);

/* struct/union 的成员名。类型本身是 hash-consing 的（同构同 id），
 * 名字放不进 C6Type，所以另开一张由类型 id 索引的小表。
 * 查找是线性的——单 TU 里聚合类型数量是几百到几千量级，比再建一层哈希划算。 */
#define AGG_CAP0 1024
/* 成员表放在 arena 里按需增长：tcc 的 struct TCCState 有三百多个成员，
 * 定长数组要么炸要么浪费一大片 BSS。 */
typedef struct AggInfo {
    u32 ty;
    const char **names;
    u32 *lens;
    u32 n;
    u32 next_same;          /* 同类型 id 的下一条（名字表可能不同），0 = 链尾 */
} AggInfo;

/* 类型 id → 条目链的桶。成员查找是热路径（每个 `.`/`->` 都走），线性扫全表
 * 在 tcc.c 这种 TU 上会退化成 O(n²)。 */
#define AGG_NB 4096
static u32 AGG_HEAD[AGG_NB];    /* 0 = 空，否则是"条目下标 + 1" */


static AggInfo *AGG;
static u32 NAGG;
static u32 AGG_CAP;

/* 表按需扩容（arena 里翻倍 + 拷贝）：tcc.c 一个 TU 里的 struct/union 定义
 * 就超过四千个，定长表满了就静默丢条目，后面所有成员查找都变成"没有成员" */
static void agg_tab_grow(void)
{
    u32 nc = AGG_CAP ? AGG_CAP * 2 : AGG_CAP0;
    AggInfo *na = arena_alloc(&A_main, (size_t)nc * sizeof(AggInfo));

    if (AGG && NAGG)
        memcpy(na, AGG, (size_t)NAGG * sizeof(AggInfo));
    AGG = na;
    AGG_CAP = nc;
}

/* 成员 i 有没有名字？（无名的位域 `unsigned :32;` 在**位置初始化**里不占位，
 * 却有布局意义——tests2/90_struct-init.c 的 test_init_bf） */
static int agg_member_named(u32 ty, u32 idx)
{
    u32 b = 0;
    u32 j = 0;

    if (TY_AT(ty)->qual)
        ty = ty_unqual(ty);
    b = ty % AGG_NB;
    j = AGG_HEAD[b];

    while (j) {
        AggInfo *e = &AGG[j - 1];

        if (e->ty == ty && idx < e->n && e->names && e->names[idx]
            && e->lens && e->lens[idx] > 0)
            return 1;
        j = e->next_same;
    }
    return 0;
}

static void agg_names_set(u32 ty, const char **names, const u32 *lens, u32 n)
{
    u32 i = 0;

    /* 同构类型共用一个 type id（类型 id 只按布局哈希，不含成员名），但**成员名
     * 可能不同**。所以只有名字表完全一样才能真正共用条目，否则各占一条，
     * 查找时按类型 id 扫所有条目。`struct { unsigned short cmp_op, cmp_r; }` 与
     * 别的同布局结构撞 id，正是 tcc 的 SValue 查不到 cmp_op 的原因。 */
    {
        u32 b = ty % AGG_NB;
        u32 j = AGG_HEAD[b];

        while (j) {
            AggInfo *e = &AGG[j - 1];
            u32 k = 0;
            int same = 1;

            if (e->ty == ty && e->n == n) {
                for (k = 0; k < n; k++) {
                    if (e->lens[k] != lens[k] || !e->names[k] || !names[k]
                        || memcmp(e->names[k], names[k], lens[k]) != 0) {
                        same = 0;
                        break;
                    }
                }
                if (same)
                    return;
            }
            j = e->next_same;
        }
    }
    if (NAGG >= AGG_CAP)
        agg_tab_grow();
    AGG[NAGG].ty = ty;
    AGG[NAGG].n = n;
    AGG[NAGG].names = arena_alloc(&A_main, (size_t)(n ? n : 1) * sizeof(char *));
    AGG[NAGG].lens = arena_alloc(&A_main, (size_t)(n ? n : 1) * sizeof(u32));
    for (i = 0; i < n; i++) {
        AGG[NAGG].names[i] = names[i];
        AGG[NAGG].lens[i] = lens[i];
    }
    {
        u32 b = ty % AGG_NB;

        AGG[NAGG].next_same = AGG_HEAD[b];
        AGG_HEAD[b] = NAGG + 1;
    }
    NAGG++;
}

/* 刚访问到的成员是不是位域、位宽多少（0 = 不是位域）。整型提升要用：
 * 宽度 < 32 的无符号位域要提升成 int，否则 `u3 - 100 < 0` 会按无符号算出 0。 */
static u32 AGG_FOUND_BITS;
static u32 AGG_FOUND_IDX = 0xFFFFFFFFu;
static u32 AGG_FOUND_BITOFF;
static int AGG_FOUND_ENUMBF;
static u32 PEND_BITS;
static u32 PEND_BITOFF;
static int PEND_BF_ENUM;

/* 返回成员下标；没找到返回 -1 */
/* 类型 id 上带着 const/volatile 时（`const struct T g[]`：限定符按 C11
 * 6.7.3p9 从数组落到元素上），它和成员名表里登记的 id 不是同一个。成员名
 * 只跟布局走，所以查表前先剥掉限定符。 */
static int agg_find_member(u32 ty, const char *name, u32 len)
{
    u32 j = 0;

    if (TY_AT(ty)->qual)
        ty = ty_unqual(ty);
    j = AGG_HEAD[ty % AGG_NB];

    while (j) {
        AggInfo *e = &AGG[j - 1];
        u32 i = 0;

        if (e->ty == ty) {
            for (i = 0; i < e->n; i++)
                if (e->lens[i] == len && e->names[i] &&
                    memcmp(e->names[i], name, len) == 0) {
                    return (int)i;
                }
            /* 同一个 type id 可能有多条名字表（布局相同、名字不同），继续找 */
        }
        j = e->next_same;
    }
    return -1;
}

/* 成员 k 是否匿名（C11 的匿名 struct/union 成员：没有名字，其成员提升到
 * 外层）。tcc 的 Sym 就是 `union { struct {int c;}; int *d; ... };` 这种。 */
static int agg_member_is_anon(u32 ty, u32 idx)
{
    u32 j = 0;

    if (TY_AT(ty)->qual)
        ty = ty_unqual(ty);
    j = AGG_HEAD[ty % AGG_NB];

    while (j) {
        AggInfo *e = &AGG[j - 1];

        if (e->ty == ty) {
            if (idx >= e->n)
                return 0;
            if (e->names[idx] == NULL || e->lens[idx] == 0)
                return 1;       /* 任一条名字表说它是匿名的，就当匿名 */
        }
        j = e->next_same;
    }
    return 0;
}

/* 成员查找（含匿名成员的提升）：成功时给出成员类型与相对偏移 */
static int agg_find_promoted(u32 ty, const char *nm, u32 len, u32 *mty, u32 *moff)
{
    int i = 0;
    u32 n = 0;
    u32 k = 0;

    *mty = 0;
    *moff = 0;
    AGG_FOUND_IDX = 0xFFFFFFFFu;
    i = agg_find_member(ty, nm, len);
    if (i >= 0) {
        u32 bw = 0;

        AGG_FOUND_IDX = (u32)i;
        *mty = ty_member(ty, (u32)i);
        *moff = ty_member_off(ty, (u32)i);
        AGG_FOUND_BITS = ty_member_bits(ty, (u32)i);
        AGG_FOUND_BITOFF = ty_member_bitoff(ty, (u32)i);
        AGG_FOUND_ENUMBF = ty_member_enum_bf(ty, (u32)i);
        bw = AGG_FOUND_BITS;
        (void)bw;
        return 1;
    }
    n = ty_member_n(ty);
    for (k = 0; k < n; k++) {
        u32 mt = ty_member(ty, k);
        u32 sub = 0;

        if (!ty_is_agg(mt) || !agg_member_is_anon(ty, k))
            continue;
        if (agg_find_promoted(mt, nm, len, mty, &sub)) {
            *moff = ty_member_off(ty, k) + sub;
            return 1;              /* AGG_FOUND_BITS 已经由内层设好 */
        }
    }
    return 0;
}

/* `s` 是不是方法**自己的**作用域里声明的？
 *
 * 模板实例的体在实例化点（往往是别的函数的声明中间）展开，那时调用方的
 * 局部量、形参都在作用域链上。方法体里的裸名字本该指向接收者的成员，可
 * `sym_find` 会先撞上调用方的同名局部量：
 *
 *     struct DIter@T { Deque@T *d; int i; }   方法体里裸写 d / i
 *     void tour_deque(void) { @Deque@int d = ...; int i = 0; }
 *     foreach (int x = d->iter())             实例在这里展开
 *
 * 于是 `i++` 改的是 tour_deque 的循环变量、`has()` 读的是调用方的 `i`：
 * std-tour 的 deque 迭代永远是第一个元素（sum 恒等于 6）。
 *
 * 判断方法：从当前作用域往上走到方法入口那一层，看这个符号到底登记在哪个
 * 作用域的链表里。链表里有 = 方法自己的（形参/局部量/`self`），没有 = 外层
 * 函数的，调用方该让位给接收者的成员。 */
static int sym_in_method_scope(Sym *s)
{
    Scope *sc = SCOPE;

    if (!s)
        return 1;
    if (!METHOD_SCOPE_BASE)
        return 1;
    for (;;) {
        Sym *p = sc ? sc->head : NULL;

        for (; p; p = p->scope_next)
            if (p == s)
                return 1;
        if (sc == METHOD_SCOPE_BASE || !sc || !sc->up)
            return 0;
        sc = sc->up;
    }
}

/* 字符族判断：插值只接受"能当文本看"的切片/指针。`@char` 这种托管文本
 * 在类型表里是"切片，元素是 char 指针"，所以要顺着指针再认一层。 */
static int ty_charish(u32 t)
{
    if (!t)
        return 0;
    if (t == ty_char() || t == ty_schar() || t == ty_uchar())
        return 1;
    if (ty_size(t) == 1)
        return 1;
    if (ty_is_ptr(t))
        return ty_charish(ty_target(t));
    return 0;
}

/* 任务句柄：`async T f(…)` 的返回类型是指向 `struct f_task { T val; }` 的
 * 指针（见 pa_func_def）。判断"这是个任务"就看目标类型有没有 val 成员。 */
static int ty_is_task_ptr(u32 ty)
{
    u32 mt = 0;
    u32 mo = 0;

    if (!ty_is_ptr(ty))
        return 0;
    return agg_find_promoted(ty_target(ty), "val", 3, &mt, &mo);
}

static u32 parse_typespec(void);

/* 当前 `(` 打头的是不是元组类型 `(T1, T2, …)`？
 *
 * 光看"有逗号"不够：函数指针形参 `(const void *, const void *)` 里也有逗号。
 * 元组类型后面一定紧跟着声明符的名字，所以再加一条"配对 `)` 之后是标识符"。
 * 只看 PA_LOOK 以内的 token，看不完就当不是。 */
static int pa_at_tuple_type(void)
{
    int depth = 0;
    int comma = 0;
    int k = 0;

    if (!pa_is_ch('('))
        return 0;
    for (k = 0; k < PA_LOOK; k++) {
        Tok *q = pa_peek(k);

        if (q->kind != TK_PUNCT)
            continue;
        if (tok_eq(q, "(")) {
            depth++;
        } else if (tok_eq(q, ")")) {
            depth--;
            if (depth == 0) {
                Tok *nx = pa_peek(k + 1);

                return comma && nx && nx->kind == TK_IDENT;
            }
        } else if (depth == 1 && TOK_EQ(q, "...")) {
            return 0;                /* 变参函数类型，不是元组 */
        } else if (depth == 1 && tok_eq(q, ",")) {
            comma = 1;
        }
    }
    return 0;
}

/* ---------- c6 角色宏 ----------
 * 文件作用域里长得像函数的宏：
 *
 *   stmt swap(expr a, expr b) { typeof(a) t = (a); (a) = (b); (b) = t; }
 *
 * 开头那个词是**角色**，说明展开结果怎么用；每个形参前面也带角色。展开是
 * 纯 token 级的（和模板一样把 token 压进 SRC 栈重放），所以实参里可以再写
 * 宏调用，递归展开是自然发生的。
 *
 *   expr  展开成 ( 体 )，实参各自加一层括号
 *   stmt  展开成 { 体 }，当语句用
 *   ident 原样重放（给 ## / 字符串化用）
 *   type  原样重放，当类型说明符用
 *
 * 卫生：宏体里自己声明的局部变量，每次展开加一个唯一后缀重命名，不会捕获
 * 调用处的同名变量；写了 `__local` 的保持原名。
 */
#define CM_MAX 96
#define CM_NP 8
#define CM_TOK_MAX 4096
#define CM_ID_MAX 64

enum { CM_ROLE_EXPR = 0, CM_ROLE_STMT = 1, CM_ROLE_IDENT = 2, CM_ROLE_TYPE = 3 };

typedef struct CMacro {
    const char *name;
    u32 nlen;
    int role;
    int np;
    const char *pname[CM_NP];
    u32 plen[CM_NP];
    int prole[CM_NP];
    Tok *body;
    u32 nbody;
    /* 体内自己声明的局部变量（卫生重命名用） */
    const char *loc[CM_NP * 4];
    u32 loclen[CM_NP * 4];
    int nloc;
} CMacro;

static CMacro CM[CM_MAX];
static u32 NCM;
static u32 CM_SEQ;

static u32 tmpl_capture_body(void);
static int CM_STMT_DEPTH;
static int CM_EXPR_DEPTH;

static int cm_role_of(const char *s, u32 n)
{
    if (n == 4 && memcmp(s, "expr", 4) == 0)
        return CM_ROLE_EXPR;
    if (n == 4 && memcmp(s, "stmt", 4) == 0)
        return CM_ROLE_STMT;
    if (n == 5 && memcmp(s, "ident", 5) == 0)
        return CM_ROLE_IDENT;
    if (n == 4 && memcmp(s, "type", 4) == 0)
        return CM_ROLE_TYPE;
    return -1;
}

static CMacro *cm_find(const char *s, u32 n)
{
    u32 i = 0;

    for (i = 0; i < NCM; i++)
        if (CM[i].nlen == n && memcmp(CM[i].name, s, n) == 0)
            return &CM[i];
    return NULL;
}

static Tok cm_syn_punct(const char *s, u32 n)
{
    Tok t = {0};

    t.kind = TK_PUNCT;
    t.len = n;
    t.hash = tok_hash(s, n);
    t.flags = TF_SYN;
    t.syn = s;
    return t;
}

static Tok cm_syn_ident(const char *s, u32 n)
{
    Tok t = {0};
    char *buf = arena_alloc(&A_main, (size_t)n + 1);

    memcpy(buf, s, n);
    buf[n] = 0;
    t.kind = TK_IDENT;
    t.len = n;
    t.hash = tok_hash(buf, n);
    t.flags = TF_SYN;
    t.syn = buf;
    return t;
}

/* 当前 token 是不是这个宏的调用点（名字后面紧跟 '('） */
static CMacro *cm_at_call(int role)
{
    Tok *t = pa_cur();
    CMacro *m = NULL;

    if (t->kind != TK_IDENT)
        return NULL;
    if (!pa_peek(1) || pa_peek(1)->kind != TK_PUNCT || !tok_eq(pa_peek(1), "("))
        return NULL;
    m = cm_find(tok_data(t), t->len);
    if (!m || (role >= 0 && m->role != role))
        return NULL;
    return m;
}

/* 读一个实参：从当前 token 开始，括号/方括号/花括号配平，遇到顶层 ',' 或
 * ')' 停（不消费它们）。返回收进 out 的 token 数。 */
static u32 cm_read_arg(Tok *out, u32 cap)
{
    int depth = 0;
    u32 n = 0;

    while (pa_cur()->kind != TK_EOF) {
        Tok *t = pa_cur();

        if (t->kind == TK_PUNCT) {
            if (depth == 0 && (tok_eq(t, ",") || tok_eq(t, ")")))
                break;
            if (tok_eq(t, "(") || TOK_EQ(t, "[") || TOK_EQ(t, "{"))
                depth++;
            else if (tok_eq(t, ")") || TOK_EQ(t, "]") || TOK_EQ(t, "}"))
                depth--;
        }
        if (n < cap)
            out[n++] = *t;
        pa_advance();
    }
    return n;
}

/* 展开一次（当前 token 是宏名）。args/alen 已由调用方读好。 */
static void cm_push_expansion(CMacro *m, Tok *args, const u32 *aoff, const u32 *alen,
                              int narg)
{
    Tok *out = arena_alloc(&A_main, sizeof(Tok) * CM_TOK_MAX);
    u32 no = 0;
    u32 i = 0;
    u32 seq = CM_SEQ++;
    int paste = 0;
    /* 卫生后缀：`tmp` → `tmp__<seq>` */
    char sfx[24] = {0};
    u32 slen = 0;

    snprintf(sfx, sizeof(sfx), "__%u", (unsigned)seq);
    slen = (u32)strlen(sfx);

#define CM_PUT(tok) do { \
        if (no < CM_TOK_MAX) { \
            out[no] = (tok); \
            if (paste && no > 0) { \
                char *cat = arena_alloc(&A_main, (size_t)out[no - 1].len + out[no].len + 1); \
                memcpy(cat, tok_data(&out[no - 1]), out[no - 1].len); \
                memcpy(cat + out[no - 1].len, tok_data(&out[no]), out[no].len); \
                cat[out[no - 1].len + out[no].len] = 0; \
                out[no - 1] = cm_syn_ident(cat, out[no - 1].len + out[no].len); \
                paste = 0; \
                no--; \
            } \
            no++; \
        } \
    } while (0)

    for (i = 0; i < m->nbody; i++) {
        Tok *b = &m->body[i];
        int pi = -1;
        int k = 0;
        const char *bd = NULL;

        if (b->kind == TK_EOF)
            continue;                    /* `__local` 的占位 */
        if (b->kind == TK_PUNCT && TOK_EQ(b, "##")) {
            paste = 1;
            continue;
        }
        /* 形参？ */
        if (b->kind == TK_IDENT) {
            bd = tok_data(b);
            for (k = 0; k < m->np; k++) {
                if (m->plen[k] == b->len && memcmp(m->pname[k], bd, b->len) == 0) {
                    pi = k;
                    break;
                }
            }
        }
        if (pi >= 0) {
            u32 a0 = aoff[pi];
            u32 an = alen[pi];
            u32 j = 0;

            if (m->prole[pi] == CM_ROLE_EXPR) {
                CM_PUT(cm_syn_punct("(", 1));
                for (j = 0; j < an; j++)
                    CM_PUT(args[a0 + j]);
                CM_PUT(cm_syn_punct(")", 1));
            } else {
                for (j = 0; j < an; j++)
                    CM_PUT(args[a0 + j]);
            }
            continue;
        }
        /* 体内局部变量：重命名 */
        if (b->kind == TK_IDENT && m->nloc > 0) {
            int isloc = 0;

            bd = tok_data(b);
            for (k = 0; k < m->nloc; k++) {
                if (m->loclen[k] == b->len && memcmp(m->loc[k], bd, b->len) == 0) {
                    isloc = 1;
                    break;
                }
            }
            if (isloc) {
                char *nm = arena_alloc(&A_main, (size_t)b->len + slen + 1);

                memcpy(nm, bd, b->len);
                memcpy(nm + b->len, sfx, slen);
                nm[b->len + slen] = 0;
                CM_PUT(cm_syn_ident(nm, b->len + slen));
                continue;
            }
        }
        CM_PUT(*b);
    }
#undef CM_PUT

    if (m->role == CM_ROLE_EXPR) {
        Tok *w = arena_alloc(&A_main, sizeof(Tok) * (no + 2));
        u32 j = 0;

        w[0] = cm_syn_punct("(", 1);
        for (j = 0; j < no; j++)
            w[j + 1] = out[j];
        w[no + 1] = cm_syn_punct(")", 1);
        out = w;
        no += 2;
    } else if (m->role == CM_ROLE_STMT) {
        Tok *w = arena_alloc(&A_main, sizeof(Tok) * (no + 2));
        u32 j = 0;

        w[0] = cm_syn_punct("{", 1);
        for (j = 0; j < no; j++)
            w[j + 1] = out[j];
        w[no + 1] = cm_syn_punct("}", 1);
        out = w;
        no += 2;
    }
    (void)narg;
    if (no > 0) {
        /* 前瞻窗口里已经拉到、但还没消费的 token 要先垫在下面 */
        if (PA_HAVE > 0) {
            Tok *save = arena_alloc(&A_main, sizeof(Tok) * (size_t)PA_HAVE);
            u32 ns = (u32)PA_HAVE;
            u32 q = 0;

            for (q = 0; q < ns; q++)
                save[q] = *pa_peek((int)q);
            pa_win_clear();
            pa_src_push(save, ns);
        }
        pa_src_push(out, no);
    }
}

/* 收集实参（当前 token 是宏名）。返回实参个数，argc 越界时截断。 */
#define CM_ARG_MAX 8192
static Tok CM_ARGS[CM_ARG_MAX];

static int cm_collect_args(CMacro *m, u32 *aoff, u32 *alen)
{
    int n = 0;
    u32 used = 0;

    pa_expect_ch('(');
    if (pa_accept_ch(')'))
        return (m->np == 0) ? 0 : 0;
    for (;;) {
        u32 k = cm_read_arg(CM_ARGS + used, (u32)CM_ARG_MAX - used);

        if (n < CM_NP) {
            aoff[n] = used;
            alen[n] = k;
        }
        used += k;
        n++;
        if (pa_accept_ch(','))
            continue;
        break;
    }
    pa_expect_ch(')');
    return n;
}

/* 文件作用域上试一次角色宏定义：`role name(role p, …) { … }`。
 * 不是这个形状就什么也不做、返回 0。 */
static int cm_try_define(void)
{
    Tok *t0 = pa_cur();
    Tok *t1 = NULL;
    Tok *t2 = NULL;
    int role = 0;
    CMacro *m = NULL;
    u32 ntok = 0;
    u32 i = 0;

    if (t0->kind != TK_IDENT || NCM >= CM_MAX)
        return 0;
    role = cm_role_of(tok_data(t0), t0->len);
    if (role < 0)
        return 0;
    t1 = pa_peek(1);
    t2 = pa_peek(2);
    if (!t1 || t1->kind != TK_IDENT)
        return 0;
    if (!t2 || t2->kind != TK_PUNCT || !tok_eq(t2, "("))
        return 0;
    if (cm_find(tok_data(t1), t1->len))
        return 0;
    pa_advance();                                /* 角色词 */
    m = &CM[NCM++];
    memset(m, 0, sizeof(*m));
    m->role = role;
    m->name = tok_data(pa_cur());
    m->nlen = pa_cur()->len;
    pa_advance();                                /* 名字 */
    pa_expect_ch('(');
    if (!pa_accept_ch(')')) {
        for (;;) {
            int pr = -1;

            if (pa_cur()->kind != TK_IDENT)
                break;
            pr = cm_role_of(tok_data(pa_cur()), pa_cur()->len);
            if (pr < 0) {
                pa_error("宏形参前面要写角色词（expr / stmt / ident / type）");
                break;
            }
            pa_advance();
            if (pa_cur()->kind != TK_IDENT) {
                pa_error("a parameter name must follow the '%s' role",
                         pr == CM_ROLE_EXPR ? "expr"
                                            : (pr == CM_ROLE_STMT ? "stmt"
                                                                  : (pr == CM_ROLE_IDENT
                                                                         ? "ident"
                                                                         : "type")));
                break;
            }
            if (m->np < CM_NP) {
                m->prole[m->np] = pr;
                m->pname[m->np] = tok_data(pa_cur());
                m->plen[m->np] = pa_cur()->len;
                m->np++;
            }
            pa_advance();
            if (pa_accept_ch(','))
                continue;
            break;
        }
        pa_expect_ch(')');
    }
    if (!pa_is_ch('{'))
        return 1;
    ntok = tmpl_capture_body();
    if (ntok >= 2) {
        m->nbody = ntok - 2;
        m->body = arena_alloc(&A_main, sizeof(Tok) * (size_t)(m->nbody ? m->nbody : 1));
        for (i = 0; i < m->nbody; i++)
            m->body[i] = CAP_TOK[i + 1];
    } else {
        m->nbody = 0;
        m->body = arena_alloc(&A_main, sizeof(Tok));
    }
    /* `expr f(expr a) { a + 1; }`：结尾的 ';' 可有可无，展开时要吃掉——
     * 否则 `( a + 1 ; )` 就不是表达式了。 */
    if (m->role != CM_ROLE_STMT) {
        while (m->nbody > 0 && m->body[m->nbody - 1].kind == TK_PUNCT
               && TOK_EQ(&m->body[m->nbody - 1], ";"))
            m->nbody--;
        /* `expr` 宏的体就是**一个表达式**：空的、或者中间还有分号（多条
         * 语句）都不是表达式（tests/errors/macro.c6 的 expr_empty /
         * expr_statements）。语句请写 `stmt` 宏 + `({ … })`。 */
        if (m->nbody == 0) {
            pa_error("an 'expr' macro needs an expression in its body");
        } else {
            int d2 = 0;
            u32 j2 = 0;

            for (j2 = 0; j2 < m->nbody; j2++) {
                if (m->body[j2].kind != TK_PUNCT)
                    continue;
                if (tok_eq(&m->body[j2], "(") || TOK_EQ(&m->body[j2], "[")
                    || TOK_EQ(&m->body[j2], "{"))
                    d2++;
                else if (tok_eq(&m->body[j2], ")") || TOK_EQ(&m->body[j2], "]")
                         || TOK_EQ(&m->body[j2], "}"))
                    d2--;
                else if (TOK_EQ(&m->body[j2], ";") && d2 == 0) {
                    pa_error("an 'expr' macro body is one expression: use a "
                             "'stmt' macro and '({ ... })' for statements");
                    break;
                }
            }
        }
    }
    /* `#` / `##` 只能作用在 ident 形参上 */
    {
        u32 j3 = 0;

        for (j3 = 0; j3 + 1 < m->nbody; j3++) {
            if (m->body[j3].kind != TK_PUNCT)
                continue;
            if (!TOK_EQ(&m->body[j3], "#") && !TOK_EQ(&m->body[j3], "##"))
                continue;
            /* 运算符**两边**都查：`a ## b` 里 a 是左边那个 */
            if (j3 > 0 && m->body[j3 - 1].kind == TK_IDENT) {
                u32 k3 = 0;

                for (k3 = 0; k3 < m->np; k3++)
                    if (m->plen[k3] == m->body[j3 - 1].len
                        && memcmp(m->pname[k3], tok_data(&m->body[j3 - 1]),
                                  m->plen[k3]) == 0) {
                        if (m->prole[k3] != CM_ROLE_IDENT)
                            pa_error("'%.*s' has role '%s': '#' and '##' need an "
                                     "'ident' parameter", (int)m->plen[k3],
                                     m->pname[k3],
                                     m->prole[k3] == CM_ROLE_EXPR
                                         ? "expr"
                                         : (m->prole[k3] == CM_ROLE_STMT ? "stmt"
                                                                         : "type"));
                        break;
                    }
            }
            if (m->body[j3 + 1].kind == TK_IDENT) {
                u32 k3 = 0;

                for (k3 = 0; k3 < m->np; k3++)
                    if (m->plen[k3] == m->body[j3 + 1].len
                        && memcmp(m->pname[k3], tok_data(&m->body[j3 + 1]),
                                  m->plen[k3]) == 0) {
                        if (m->prole[k3] != CM_ROLE_IDENT)
                            pa_error("'%.*s' has role '%s': '#' and '##' need an "
                                     "'ident' parameter", (int)m->plen[k3],
                                     m->pname[k3],
                                     m->prole[k3] == CM_ROLE_EXPR
                                         ? "expr"
                                         : (m->prole[k3] == CM_ROLE_STMT ? "stmt"
                                                                         : "type"));
                        break;
                    }
            }
        }
    }
    /* 找体内自己声明的局部变量：`typename 名字` / `typeof(…) 名字` */
    for (i = 0; i + 1 < m->nbody; i++) {
        int decl = 0;
        u32 j = i + 1;

        if (m->body[i].kind == TK_IDENT && TOK_EQ(&m->body[i], "__local"))
            continue;                /* 手动指定：后面的名字不重命名 */
        if (m->body[i].kind == TK_IDENT
            && (TOK_EQ(&m->body[i], "typeof") || TOK_EQ(&m->body[i], "__typeof__")
                || TOK_EQ(&m->body[i], "__typeof"))) {
            int d = 0;

            j = i + 1;
            while (j < m->nbody) {
                if (m->body[j].kind == TK_PUNCT && tok_eq(&m->body[j], "("))
                    d++;
                else if (m->body[j].kind == TK_PUNCT && tok_eq(&m->body[j], ")")) {
                    d--;
                    if (d == 0) {
                        j++;
                        break;
                    }
                }
                j++;
            }
            decl = 1;
        } else if (is_typename_tok(&m->body[i])) {
            decl = 1;
        }
        if (!decl)
            continue;
        while (j < m->nbody && m->body[j].kind == TK_PUNCT
               && (TOK_EQ(&m->body[j], "*") || TOK_EQ(&m->body[j], "const")))
            j++;
        if (j >= m->nbody || m->body[j].kind != TK_IDENT)
            continue;
        {
            int isparam = 0;
            int k = 0;
            int dup = 0;

            for (k = 0; k < m->np; k++)
                if (m->plen[k] == m->body[j].len
                    && memcmp(m->pname[k], tok_data(&m->body[j]), m->body[j].len) == 0)
                    isparam = 1;
            for (k = 0; k < m->nloc; k++)
                if (m->loclen[k] == m->body[j].len
                    && memcmp(m->loc[k], tok_data(&m->body[j]), m->body[j].len) == 0)
                    dup = 1;
            if (!isparam && !dup && m->nloc < CM_NP * 4) {
                m->loc[m->nloc] = tok_data(&m->body[j]);
                m->loclen[m->nloc] = m->body[j].len;
                m->nloc++;
            }
        }
    }
    /* `__local` 那个占位 token 在展开时跳过：把 kind 换成 TK_NL 之类不可见的
     * 不行（会影响语法），干脆标成空指针 token，展开循环里显式跳。 */
    for (i = 0; i < m->nbody; i++) {
        if (m->body[i].kind == TK_IDENT && m->body[i].len == 7
            && memcmp(tok_data(&m->body[i]), "__local", 7) == 0)
            m->body[i].kind = TK_EOF;            /* 展开时丢弃 */
    }
    return 1;
}

/* `ident` 角色的宏：结果直接当成一个标识符用（`int cat(ab, cd) = 7;` 里的
 * 声明符名字）。返回合成好的名字，不是 ident 宏就返回 NULL。 */
static const char *cm_ident_name(u32 *outlen)
{
    CMacro *m = cm_at_call(CM_ROLE_IDENT);
    u32 aoff[CM_NP] = {0};
    u32 alen[CM_NP] = {0};
    char buf[256] = {0};
    u32 bl = 0;
    int n = 0;
    int i = 0;
    int k = 0;

    if (!m)
        return NULL;
    pa_advance();                                /* 宏名 */
    n = cm_collect_args(m, aoff, alen);
    for (i = 0; i < (int)m->nbody; i++) {
        Tok *b = &m->body[i];
        int pi = -1;

        if (b->kind == TK_EOF)
            continue;
        if (b->kind == TK_PUNCT && TOK_EQ(b, "##"))
            continue;
        if (b->kind == TK_IDENT) {
            for (k = 0; k < m->np; k++)
                if (m->plen[k] == b->len
                    && memcmp(m->pname[k], tok_data(b), b->len) == 0) {
                    pi = k;
                    break;
                }
        }
        if (pi >= 0) {
            u32 j = 0;

            if (pi < n) {
                for (j = 0; j < alen[pi]; j++) {
                    Tok *at = &CM_ARGS[aoff[pi] + j];
                    u32 tl = at->len;

                    if (bl + tl < sizeof(buf)) {
                        memcpy(buf + bl, tok_data(at), tl);
                        bl += tl;
                    }
                }
            }
            continue;
        }
        if (bl + b->len < sizeof(buf)) {
            memcpy(buf + bl, tok_data(b), b->len);
            bl += b->len;
        }
    }
    *outlen = bl;
    if (bl == 0)
        return NULL;
    {
        char *r = arena_alloc(&A_main, (size_t)bl + 1);

        memcpy(r, buf, bl);
        r[bl] = 0;
        return r;
    }
}

/* 就地展开：当前 token 是宏名，后面跟 '('。返回 1 表示展开了。 */
static int cm_expand(int role)
{
    CMacro *m = cm_at_call(role);
    u32 aoff[CM_NP] = {0};
    u32 alen[CM_NP] = {0};
    int n = 0;

    if (!m)
        return 0;
    pa_advance();                                /* 宏名 */
    n = cm_collect_args(m, aoff, alen);
    (void)n;
    cm_push_expansion(m, CM_ARGS, aoff, alen, n);
    return 1;
}

static u32 parse_typename(void);
static void gen_decl_from_spec(u32 base);
static u32 gen_unary(void);
static void gen_zero_obj(u32 addr, u32 sz);
static void init_skip_value(void);
static void init_skip_expr(void);
static void skip_attributes(void);
static void skip_paren_group(void);
/* 结构体成员里的 `_Static_assert(...)` 要用（定义在后面）。 */
static void parse_static_assert_rest(void);
static u32 GEN_TY;
static int PEND_LVAL;
static u32 PEND_ADDR;
static u32 PEND_TY;
/* typeof(表达式) 要的是**未退化**的类型：函数指示符不能变成函数指针 */
static int NO_DECAY;


/* 存储类标记：静态局部要落到数据段（有静态生存期），不能用栈槽 */
static int PA_STATIC;
/* `extern` 说明符：`extern int g;` 是引用不是定义，不要求初始化器 */
static int PA_EXTERN;
/* `__thread` / `_Thread_local`：这个声明定义的是线程局部量（TLS）
 *
 * 布局上 TLS 量就是数据段里的普通全局量（初始化器一个字都不用改），差别只在
 * **访问**：地址算成 `%fs 基址 + 数据段偏移`。运行期每个线程 mmap 一块
 * [TLS_LO, TLS_HI) 的拷贝，`%fs` 设成 `块首 - TLS_LO`，于是解析期生成的
 * 常量偏移正好落到拷贝里那个变量上（见 lib/rt.c6 的 c6c_tls_setup 和
 * src/x64.c6 的 __c6_fsbase）。块里会顺带拷贝夹在中间的不相干数据——它们
 * 只是副本、没人写回，换来的是"偏移在解析期就是常量"，不用二次扫描。
 *
 * 三个交给运行期的量（`.data` 里的 8 字节全局量，没有 TLS 时长度是 0）：
 *   __c6_tls_img   影像在数据段里的**地址**
 *   __c6_tls_len   影像长度
 *   __c6_tls_delta 影像起点相对数据段起点的偏移（%fs = 块首 - 这个）
 */
static int PA_TLS;
static u32 TLS_LO;              /* 第一个 TLS 变量的数据段偏移 */
static u32 TLS_HI;              /* 最后一个 TLS 变量的结尾 */
static u32 NTLS;
static Sym *SYM_TLS_IMG;
static Sym *SYM_TLS_LEN;
static Sym *SYM_TLS_DELTA;

static void tls_note(u32 goff, u32 sz)
{
    if (NTLS == 0 || goff < TLS_LO)
        TLS_LO = goff;
    if (goff + sz > TLS_HI)
        TLS_HI = goff + sz;
    NTLS++;
}
/* 模板定义（`struct B@(int N) {...}`）自己不产生声明，它后面的 `;` 是可选的；
 * 处理完把它置 1，让 gen_decl_from_spec 直接跳过（否则会去吃后面的 `test`）。 */
static int PA_TMPL_DEF_DONE;
/* 结构体体的"第一遍"：只登记方法签名、跳过方法体。为的是让前面的方法能调用
 * 后面才定义的方法（std/container/map.c6 的 rebuild → probe 就是这个形状）。 */
static int PA_SIG_ONLY;
static char TMPL_INST_NM[320];   /* 正在展开的模板实例名（方法命名用） */

/* 实例类型 id → 实例名（`Vect_int` 这种）。顶层函数带实例指针做首形参时，
 * 符号名要按 `<实例名>_<函数名>` 拼，所以得能反查。 */
#define TINST_MAX 128
static u32 TINST_ID[TINST_MAX];
static char TINST_NM[TINST_MAX][96];
static u32 NTINST;

static const char *tmpl_inst_name(u32 ty)
{
    u32 i = 0;

    for (i = 0; i < NTINST; i++)
        if (TINST_ID[i] == ty)
            return TINST_NM[i];
    return NULL;
}
/* 正在解析 `&` 的操作数：方法体里的成员访问默认会立刻 load 成右值，
 * 取地址时要留住左值（`&keys[i]`）。 */
static int PA_AMP;
/* 正在重放模板结构体的体：只有这种体才做"两遍"（第一遍只登记方法签名），
 * 普通结构体保持一遍，免得白跑一遍解析、也免得踩到只能在单遍里成立的写法。 */
static int PA_TMPL_BODY;
/* 正在解析模板**实参**（`V@int[:]` 里的 `int`）：这时不能把 `[:]` 当切片后缀
 * 吃掉——它是"实例的切片"（`ty_slice_chk(V@int)`），不是实参类型的一部分。 */
static int PA_TMPL_ARG;
/* `@T` 在 c6c 里就是 `T *`。指针**不能**在 parse_typespec 里就套上去：那样
 * `@int (*f)(int)` 的 base 一开始就是指针，`decl_fill_hole` 会把外层 `(int)`
 * 后缀装到错误的一层（现象：`f(3)` 编不过、`(*f)(3)` 段错误）。所以这里只
 * 记一个计数，由 parse_declarator 当成"额外的 `*`"叠进 nptr。 */
static int PA_MGD_PTR;
static int PA_MGD_SHARED;    /* 刚看到 `shared` 限定符 */
static int PA_CAST_CONV;     /* 正在做显式 cast */
static int PA_TMPL_STRUCT;   /* 正在定义的 struct/union 是模板（`struct X@T`） */
static int PA_MGD_KIND;      /* 0=强 1=weak 2=own */
/* `async T f()`：c6c 里就是"返回任务结构的普通函数"。任务结构
 * `struct <名字>_task { T val; }` 在编译器内部建好并登记成普通 tag，函数返回
 * 它的指针；`await t` 读 `t->val`。任务同步跑完，`__c6_co_wait` 恒 0。 */
static int PA_ASYNC;
static u32 CUR_TASK_TY;            /* 当前函数是 async 时为任务结构类型 */
static u32 CUR_TASK_VAL;           /* 任务结构里 val 的类型 */
/* async 体的"回卷出口"标签：销毁挂起的任务时，挂起点之后的检查会跳到这里，
 * 把 defer/errdefer 和栈上的托管局部量都收拾掉（见 async_unwind_gate）。 */
static u32 CUR_UNWIND_LBL;
/* 正在编 `co` 语句（决定 async 调用的起点闸门：co 跳过闸门） */
static int PA_CO_STMT;

/* 正在编的初始化表达式属于哪种声明：0 = 不是声明初始化，1 = 普通目标，
 * 2 = 托管引用（`@T`）。f-string 用它查"借来的文本存进托管引用"这类错。 */
static u8 PA_DECL_INIT_MGD;
/* async 的上下文检查用：defer 体里不许 await；sizeof/typeof 这种不求值上下文
 * 里也不许；`task`/`thread` 是哪个关键字写出来的（文件作用域只禁 `task`）。 */
static int PA_IN_DEFER;
static int PA_DEFER_DEPTH;   /* defer 体的嵌套层数（上限 8） */
static int PA_DEFER_SITES;   /* 本函数的清理点个数（上限 128） */
static int PA_RET_EXPR;      /* 正在编 `return` 的操作数（err() 只许在这里） */
/* 刚编完的那次调用可不可失败：0 = 不是调用，1 = 返回 T!error，2 = 普通函数，
 * 3 = 可失败性看不出来（方法/函数指针调用），4 = 已经被 catch 处理过。 */
static int E_CALL_FALLIBLE;
static int E_NEW_SEEN;       /* 刚编完的表达式里有 `new` */
static int E_NEW_SHARED;     /* 那个 `new` 带 `shared`（原子计数） */
static int PA_LAST_TERM;     /* 上一条语句是 return/goto（catch 体的收尾检查） */
/* `move(a)` 之后槽里的引用就交出去了：再读、再比较、再传参、再 move 拿到的
 * 都是空值，编译期直接拦下来（tests/errors/gc_move.c6）。
 *
 * 用**稀疏表**存：一个函数里同时空着的槽通常只有一两个，别为每个 if/循环
 * memcpy 一张 2 KB 位图（profiler 里那是实打实 1% 的开销）。 */
#define MV_MAX 24
static u16 MV_SLOT[MV_MAX];
static int MV_N;
/* 控制流汇合用的快照：分支各自从"进来时"的状态开始分析，出去时取并集
 * （一条路重新赋值、另一条没有，就算"还可能是空的"）。defer 体单独分析，
 * 里面的 move 不漏到外面。 */
#define MV_SNAP_MAX 24
static u16 MV_SNAP[MV_SNAP_MAX][MV_MAX];
static u8 MV_SNAP_N[MV_SNAP_MAX];
static u16 MV_TMP[MV_MAX];
static u8 MV_TMP_N;
static int MV_SP;

static int mv_has(u32 slot)
{
    int i = 0;

    for (i = 0; i < MV_N; i++)
        if (MV_SLOT[i] == (u16)slot)
            return 1;
    return 0;
}

static void mv_set(u32 slot)
{
    if (slot > 0xFFFFu || mv_has(slot))
        return;
    if (MV_N < MV_MAX)
        MV_SLOT[MV_N++] = (u16)slot;
}

static void mv_clear(u32 slot)
{
    int i = 0;

    for (i = 0; i < MV_N; i++)
        if (MV_SLOT[i] == (u16)slot) {
            MV_SLOT[i] = MV_SLOT[--MV_N];
            return;
        }
}

static void mv_push(void)
{
    if (MV_SP < MV_SNAP_MAX) {
        memcpy(MV_SNAP[MV_SP], MV_SLOT, sizeof(MV_SLOT));
        MV_SNAP_N[MV_SP] = (u8)MV_N;
        MV_SP++;
    }
}

static void mv_restore(void)
{
    if (MV_SP > 0) {
        memcpy(MV_SLOT, MV_SNAP[MV_SP - 1], sizeof(MV_SLOT));
        MV_N = MV_SNAP_N[MV_SP - 1];
    }
}

static void mv_pop(void)
{
    if (MV_SP > 0)
        MV_SP--;
}

static void mv_save_tmp(void)
{
    memcpy(MV_TMP, MV_SLOT, sizeof(MV_SLOT));
    MV_TMP_N = (u8)MV_N;
}

static void mv_union_tmp(void)
{
    int i = 0;

    for (i = 0; i < MV_TMP_N; i++)
        mv_set(MV_TMP[i]);
}

/* 循环体/分支体：进门快照，出门取"入口 ∪ 体"——循环可能一次都不跑，
 * 体里的赋值保证不了执行（tests/errors/gc_move.c6 的 loop / switch_case）。 */
static void mv_loop_enter(void) { mv_push(); }

static void mv_loop_leave(void)
{
    mv_save_tmp();
    mv_restore();
    mv_union_tmp();
    mv_pop();
}

static int NLOOP;            /* 循环/switch 的嵌套层数（下面再定义一次） */
static int PA_IN_COND;        /* 正在编 if/while/switch 的分支体：里面的赋值
                                不能保证执行，清不了"已移走"标记 */
static int PA_MOVE_OPERAND;   /* 正在编 move() 的操作数：这一处不算读 */
static int PA_UNEVAL;
static int PA_AWAIT_IO;      /* 正在编 await 的操作数：c6_io 只在这里合法 */
static int PA_INLINE_SEEN;
static u8 PA_TASK_KW;
/* `__builtin_va_list` 的类型 id：SysV x86-64 的 4 字段结构，懒构造一次
 * （见 parse_typespec 里那条分支）。0 = 还没构造。 */
static u32 VA_LIST_TY;
/* `__auto_type`（GNU）：类型由初始化器表达式的类型决定。
 *
 * 内核 include/linux/compiler_types.h 里有一句 `# define auto __auto_type`，
 * 于是 include/linux/minmax.h、cleanup.h、arch/x86/include/asm/bug.h 里
 * 所有 `auto ux = (x);` 都落到它上面——这是内核头链在 c6c 上剩下的最后一处
 * 类型层缺口。
 *
 * 实现是"占位 + 就地回填"：parse_typespec() 见到它置 PA_AUTO_PENDING，
 * 声明解析到初始化器时把真类型填进 ty。
 *
 * 占位**用 void**，不造假 id：parse_typespec() 的调用方拿到返回值后常会立刻
 * 问 ty_is_array()/ty_size()，不存在的 id 会直接踩到类型表外面去
 * （实测：用 0xFFFFFF00 做哨兵，编第一个含 auto 的文件就段错误）。 */
static u32 AUTO_TY;
/* 类型位置刚见过 __auto_type：声明处据此决定要不要从初始化器推类型。 */
static int PA_AUTO_PENDING;
/* 推导结果：PA_AUTO_HAVE 为真时 PA_AUTO_V 是已求值好的初始化表达式、
 * PA_AUTO_VTY 是它的类型；声明路径拿这两个直接存槽，**不重解析**。 */
static int PA_AUTO_HAVE;
static u32 PA_AUTO_V;
static u32 PA_AUTO_VTY;
/* `!error` 返回类型：PA_FALLIBLE 是"刚看到标记，等挂到声明上"，
 * CUR_FALLIBLE 是"当前这个函数带 `!error`"（try 要查它）。 */
/* 刚解析完的表达式是一次函数调用吗？（返回值可能是新引用，比如
 * `@T f()`——那种情况下 `@T p = f();` 完全合法） */
static int E_WAS_CALL;
/* 刚解析完的表达式是 `&x` 吗？（拿普通地址初始化 `@T` 就是这条） */
static int E_WAS_ADDR;
/* 刚读出来的是 `weak @T` 吗？（弱引用要先升级成 `@T` 才能用） */
static int E_WEAK;
/* 刚解析完的操作数是不是**空指针常量**（C11 6.3.2.3p3）。三元式的类型合并要用 */
static int E_NPC;

/* ---------- 每个 vreg 的"编译期整型常量值" ----------
 * 只为一件事：**空指针常量**的判定。C11 6.3.2.3p3 说的是"值为 0 的整型
 * **常量表达式**"，不是"字面量 0"；`(void *)((long)(x) * 0l)` 里的
 * `(long)(x) * 0l` 在 x 是常量时值是 0 的 ICE，整个转换就是空指针常量。
 * 内核 include/linux/compiler.h:347 的 `__is_constexpr()` 整条靠这条规则
 * 区分"编译期常量"和"运行期值"：
 *     sizeof(int) == sizeof(*(8 ? ((void *)((long)(x) * 0l)) : (int *)8))
 * 常量 x 时三元式两半是 int* / 空指针常量 → 结果 int* → 相等 → 1；
 * 非常量 x 时那半是 void* → 不等 → 0。只认字面量 0 的话它恒为 0，
 * 于是内核 overflow.h 的 struct_size() 一律走运行期的 size_add() 分支，
 * 而 DEFINE_FLEX() 把它用在**数组维度**上就直接编不过
 * （fs/ext4/mballoc.c、fs/notify/fdinfo.c 实测）。
 *
 * 表按 vreg 编号索引，每进一个函数换一代（CV_CUR），不用清表。 */
static u32 *CV_GEN;
static u64 *CV_VAL;
static u32 CV_CAP;
static u32 CV_CUR = 1;

static void cv_next(void) { CV_CUR++; }

/* 收窄到 ty 的位宽并做符号扩展：槽里的值按类型规范化，和 gen_int_lit 一致 */
static u64 cv_fit(u64 v, u32 ty)
{
    u32 sz = ty_size(ty);
    u32 bits = 0;
    u64 mask = 0;

    if (sz >= 8 || sz == 0)
        return v;
    bits = sz * 8;
    mask = ((u64)1 << bits) - 1;
    v &= mask;
    if (ty_is_signed(ty) && ((v >> (bits - 1)) & 1))
        v |= ~mask;
    return v;
}

static void cv_set(u32 v, u64 val)
{
    if (v >= CV_CAP) {
        u32 ncap = CV_CAP ? CV_CAP : 256;
        u32 *ng = NULL;
        u64 *nv = NULL;
        u32 i = 0;

        while (ncap <= v)
            ncap *= 2;
        ng = arena_zalloc(&A_main, (size_t)ncap * sizeof(u32));
        nv = arena_zalloc(&A_main, (size_t)ncap * sizeof(u64));
        for (i = 0; i < CV_CAP; i++) {
            ng[i] = CV_GEN[i];
            nv[i] = CV_VAL[i];
        }
        CV_GEN = ng;
        CV_VAL = nv;
        CV_CAP = ncap;
    }
    CV_GEN[v] = CV_CUR;
    CV_VAL[v] = val;
}

static int cv_get(u32 v, u64 *out)
{
    if (v >= CV_CAP || CV_GEN[v] != CV_CUR)
        return 0;
    *out = CV_VAL[v];
    return 1;
}

/* 折一个整数二元运算。做不出来（除/模零、移位越界、不支持的操作）就返回 0，
 * 调用方按"这不是常量"处理——保守的方向永远是安全的。 */
static int cv_fold(u8 op, u64 a, u64 b, u32 ty, u64 *out)
{
    int sg = ty_is_signed(ty);

    switch (op) {
    case IR_ADD: *out = a + b; return 1;
    case IR_SUB: *out = a - b; return 1;
    case IR_MUL: *out = a * b; return 1;
    case IR_AND: *out = a & b; return 1;
    case IR_OR:  *out = a | b; return 1;
    case IR_XOR: *out = a ^ b; return 1;
    case IR_SHL: if (b >= 64) return 0; *out = a << b; return 1;
    case IR_SHR: if (b >= 64) return 0; *out = a >> b; return 1;
    case IR_SAR: if (b >= 64) return 0;
                 *out = sg ? (u64)((i64)a >> b) : (a >> b); return 1;
    case IR_DIV: if (b == 0) return 0; *out = sg ? (u64)((i64)a / (i64)b) : (a / b);
                 return 1;
    case IR_UDIV: if (b == 0) return 0; *out = a / b; return 1;
    case IR_MOD: if (b == 0) return 0; *out = sg ? (u64)((i64)a % (i64)b) : (a % b);
                 return 1;
    case IR_UMOD: if (b == 0) return 0; *out = a % b; return 1;
    default: return 0;
    }
}
/* 刚解析的类型名里出现过 const/volatile/restrict（c6c 不把限定符放进类型 id） */
static int SAW_TYPE_QUAL;
static int CAST_QUAL;       /* 当前这个强转的类型名里带限定符 */
static int PA_FALLIBLE;
static int PA_IN_DROP;      /* 正在生成析构函数体（`drop`），不能挂起/失败 */
static int CUR_ASYNC_DEF;   /* 当前函数定义带 `async`（文件作用域登记 drop 时还要看） */
static int CUR_FALLIBLE;

/* 合成出来的任务结构类型（`struct f_task`）：句柄上的 wait/done/kind/cancel/start
 * 是内建成员，直接落到 `__c6_co_*`。类型系统里没有"任务"这个叶子类型，
 * 所以在合成的时候登记一张表。 */
#define TASK_TY_MAX 256
static u32 TASK_TY[TASK_TY_MAX];
static u32 NTASKTY;
/* 任务体入口处错误标志的快照槽（0 = 没有） */
static u32 TASK_ERR_SLOT;
/* 任务结构指针的槽，以及前缀里已经填了几个托管引用 */
static u32 TASK_SLOT;
static u32 TASK_MG_N;

static int ty_is_task(u32 ty)
{
    u32 i = 0;
    u32 t = ty_is_ptr(ty) ? ty_target(ty) : ty;

    for (i = 0; i < NTASKTY; i++)
        if (TASK_TY[i] == t)
            return 1;
    return 0;
}

/* 任务结构的布局是 `{ long kind; T val; }`：kind 在偏移 0，运行时
 * `__c6_co_wait()` 靠它回报"成功 / 出错"（c6c 没有调度器，任务同步跑完，
 * 能表达的就这两种状态）。val 的偏移按名字查，别写死。 */
static u32 task_off(const char *nm, u32 nl)
{
    u32 ft = 0;
    u32 fo = 0;

    if (!CUR_TASK_TY || !agg_find_promoted(CUR_TASK_TY, nm, nl, &ft, &fo))
        return 0;
    return fo;
}

static u32 task_val_off(void)
{
    return task_off("val", 3);
}

/* 托管形参前缀：任务持有每个托管实参的一份引用（创建时 +1，销毁时 −1），
 * 最多 4 个。 */
#define TASK_MG_CAP 4

/* 任务结构在函数**入口**就 calloc 好：形参拷进来的时候要往引用前缀里填，
 * 各条 return 出口只是把同一个指针交出去。 */
static void task_new(void)
{
    u32 c1 = 0;
    u32 c2 = 0;
    u32 t = 0;
    u32 a = 0;

    TASK_SLOT = frame_slots_for(8);
    TASK_MG_N = 0;
    c1 = irfn_vreg(&FN);
    c2 = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_U64, c1, 0, 0, 0, 1);
    irfn_push(&FN, IR_CONST, IRT_U64, c2, 0, 0, 0,
              ty_size(CUR_TASK_TY) ? ty_size(CUR_TASK_TY) : 8);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, c1, 0, 0, 0);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, c2, 0, 0, 1);
    t = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALL, IRT_PTR, t, 0, 0, 0, x64_sym(&X64, "calloc"));
    FN.ops[FN.n - 1].narg = 2;
    a = irfn_vreg(&FN);
    irfn_push(&FN, IR_ADDR, IRT_PTR, a, 0, 0, 0, X64_SLOT(TASK_SLOT));
    irfn_push(&FN, IR_STORE, IRT_U64, a, t, 0, 0, 0);
    /* 任务结构登记到协程上：函数体可能停在某个 `await`，创建者那时还没拿到
     * 返回值，只能从协程记录里取（__c6_co_start 就是读它）。 */
    {
        u32 pa2 = irfn_vreg(&FN);
        u32 pv2 = irfn_vreg(&FN);

        irfn_push(&FN, IR_ARG, IRT_U64, 0, t, 0, 0, 0);
        irfn_push(&FN, IR_CALL, IRT_VOID, pv2, 0, 0, 0,
                  x64_sym(&X64, "__c6_co_publish"));
        FN.ops[FN.n - 1].narg = 1;
        (void)pa2;
    }
}

/* 挂起点之后问一句"正被回卷吗"：是就跳到回卷出口。只有 async 体才有。 */
static u32 task_get(void);
static void task_seal(u32 tsk);
static void defer_run(int from_scope, int on_error);

static void async_unwind_gate(void)
{
    u32 uv = 0;
    u32 z = 0;
    u32 cc = 0;
    u32 lclean = 0;
    u32 cont = 0;

    if (!CUR_TASK_TY)
        return;
    uv = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALL, IRT_I64, uv, 0, 0, 0,
              x64_sym(&X64, "__c6_co_unwind_pending"));
    FN.ops[FN.n - 1].narg = 0;
    z = irfn_vreg(&FN);
    cc = irfn_vreg(&FN);
    irfn_push(&FN, IR_CONST, IRT_U64, z, 0, 0, 0, 0);
    irfn_push(&FN, IR_CMP, IRT_I64, cc, uv, z, 0, 0);
    FN.ops[FN.n - 1].flags = (u8)IRCC_NE;
    lclean = irfn_label(&FN);
    cont = irfn_label(&FN);
    irfn_push(&FN, IR_BR, IRT_VOID, 0, cc, lclean, cont, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lclean, 0, 0, 0);
    /* 回卷：就地收尾——把**此刻**还登记着的清理体（defer、errdefer、托管
     * 局部量）逆序跑掉，任务按失败结，然后直接返回。放在挂起点原地而不是跳到
     * 函数末尾，是因为块的清理代码就发在块尾，跳过去会把它整个跳过
     * （errdefer 就丢了）。 */
    {
        u32 dt = 0;

        defer_run(1, 1);
        dt = task_get();
        task_seal(dt);
        irfn_push(&FN, IR_RET, IRT_PTR, 0, dt, 0, 0, 0);
    }
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, cont, 0, 0, 0);
}

static u32 task_get(void)
{
    u32 a = irfn_vreg(&FN);
    u32 t = irfn_vreg(&FN);

    irfn_push(&FN, IR_ADDR, IRT_PTR, a, 0, 0, 0, X64_SLOT(TASK_SLOT));
    irfn_push(&FN, IR_LOAD, IRT_PTR, t, a, 0, 0, 0);
    return t;
}

/* 收尾：带 `!error` 的 async 函数把"这次是不是失败"记进 kind。
 *
 * 判据是"现在的错误标志 != 进入任务体时的标志"——创建任务的人手上可能已经
 * 带着一个待处理的错误（前一次调用留下的），那不能算到这个任务头上
 * （tests/task_method.c6 "成功的任务与失败的任务相邻" 就是这条）。
 * 记完之后把标志清掉：错误已经搬到任务里了。 */
static void task_seal(u32 tsk)
{
    u32 f = 0;
    u32 a = 0;
    u32 e = 0;
    u32 c = 0;

    if (!CUR_FALLIBLE)
        return;
    f = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALL, IRT_I64, f, 0, 0, 0,
              x64_sym(&X64, "__tcc_err_flag_get"));
    FN.ops[FN.n - 1].narg = 0;
    if (TASK_ERR_SLOT) {
        a = irfn_vreg(&FN);
        e = irfn_vreg(&FN);
        c = irfn_vreg(&FN);
        irfn_push(&FN, IR_ADDR, IRT_PTR, a, 0, 0, 0, X64_SLOT(TASK_ERR_SLOT));
        irfn_push(&FN, IR_LOAD, IRT_I64, e, a, 0, 0, 0);
        irfn_push(&FN, IR_CMP, IRT_I64, c, f, e, 0, 0);
        FN.ops[FN.n - 1].flags = (u8)IRCC_NE;
        f = c;
    }
    {
        u32 ka = irfn_vreg(&FN);

        irfn_push(&FN, IR_LEA, IRT_PTR, ka, tsk, 0, 0,
                  task_off("kind", 4));
        irfn_push(&FN, IR_STORE, IRT_U64, ka, f, 0, 0, 0);
    }
    if (TASK_ERR_SLOT) {
        u32 z = irfn_vreg(&FN);

        irfn_push(&FN, IR_CALL, IRT_VOID, z, 0, 0, 0,
                  x64_sym(&X64, "__tcc_err_clear"));
        FN.ops[FN.n - 1].narg = 0;
    }
}
static u32 NSTATIC;
/* `extern __thread` 的引用表：偏移要等所有 TU 解析完（tls_finish）才知道，
 * 先记下来，那时把值写进各自的 tls_slot。 */
#define TLS_REF_MAX 256
static Sym *TLS_REF[TLS_REF_MAX];
static u32 NTLS_REF;
/* 某个 `extern __thread` 到最后都没人定义：报一条"未定义的符号"，不写产物 */
static int PA_LINK_UNDEF;      /* 有符号到最后没定义：不写产物 */
/* 刚扫到 `__attribute__((packed))`（由 parse_agg_spec 取走并作用到那个结构体） */
static int SAW_PACKED;
/* 结构体嵌套时 TY_PACK 的存档栈（每个 parse_agg_spec 进体前压、出体后弹） */
static int PACK_SAVE[32];
static int NPACK_SAVE;
static int SAW_ALIGN;
static int ALIGN_SAVE[32];
/* 文件作用域声明符尾部的 `__aligned(N)`（如内核 __page_aligned_bss）：
 * skip_attributes 把它记进 SAW_ALIGN，gen_decl_from_spec 在 parse_declarator
 * 返回后抄到这里，由 gen_one_global 消费。以前全局量的 data_alloc 只用类型的
 * 自然对齐、忽略这个属性——内核 `static pte_t bm_pte[] __page_aligned_bss`
 * 被放到页内偏移 0x310，而页表按页基址寻址，PTE 落进错误的页 → 早期 #PF。 */
static int DECL_ALIGN_REQ;
/* .o 里 .data 段的 sh_addralign：取所有全局量对齐要求的最大值，obj.c6 用它
 * 写段头，保证链接器把段放到满足对齐的地址。 */
static u32 GLOB_MAX_ALIGN = 8;

/* 只看类型时（模板实参 `Vect@int v;` 里的 `int`）不要把后面的标识符
 * 当成声明符的名字吃掉。 */
static int PA_NO_NAME;
/* 解析模板**类型实参**时置上：此时不能把后面的 `[:]` 当成切片后缀
 * （`V@int[:] s` 里那个 `[:]` 属于外层声明，不是实参）。 */
static int PA_TYPE_ATOM;

/* __attribute__((constructor)) 收集表：进程入口在 main 之前按序调用 */
/* c6 的 `test "名字" { … }` 块：编成一个 int(void) 函数，失败返回非 0。
 * 名字进表里，-test / 合成的测试入口按顺序调用。 */
static u32 TESTS[512];
static const char *TEST_NAMES[512];    /* "test:描述"（旧版 FAIL 行用） */
static const char *TEST_DESCS[512];    /* 只有描述：-test 的 PASS/FAIL/过滤用 */
static u32 NTESTS;

static u32 CTORS[256];
static u32 NCTOR;
static int SAW_CTOR;
/* `__attribute__((weak))` / `__weak`（内核里 __weak 宏展开成前者）：符号绑定
 * 走 STB_WEAK，链接器允许被同名的强定义覆盖。内核大量 __weak 默认实现
 * （fork.c/panic.c/cpu.c），不认它就会和 arch/x86 的真实定义 multiple definition。 */
static int SAW_WEAK;
/* __attribute__((destructor))：main 返回之后按**逆序**调用 */
static u32 DTORS[256];
static u32 NDTOR;
static int SAW_DTOR;
/* 成员/声明里刚见过 enum 说明符：枚举位域要按零扩展（tcc 的约定） */
static int PA_SAW_ENUM;
/* -fsyntax-only：完整跑前端，但既不要求 main 也不写输出 */
static int PA_SYNTAX_ONLY;
/* -run：输出只是临时 ELF，别把临时文件名报出来（main.c6 里置 1） */
static int PA_QUIET_OUT;
/* -test：跑 test 块、不跑用户 main（和 tcc 的 -test 同语义、同输出协议）。
 * PA_TEST_FILTER 是 -test-filter 给的子串，NULL/空串表示全跑。 */
static int PA_TEST_MODE;
static const char *PA_TEST_FILTER;

void pa_set_test_mode(const char *filter)
{
    PA_TEST_MODE = 1;
    PA_TEST_FILTER = filter;
}

/* 吞掉多余的初始化器元素：跳到 depth 0 处的 ',' 或 '}'（都不吃掉） */
static void skip_init_list(void)
{
    int depth = 0;
    int n = 0;

    while (pa_cur()->kind != TK_EOF && n < 100000) {
        Tok *t = pa_cur();

        if (depth == 0 && t->kind == TK_PUNCT && TOK_EQ(t, "}"))
            return;      /* 跳过剩下所有多余元素，停在收尾的 '}' 前 */
        if (t->kind == TK_PUNCT) {
            if (TOK_EQ(t, "{"))
                depth++;
            else if (TOK_EQ(t, "}"))
                depth--;
        }
        pa_advance();
        n++;
    }
}


/* ---------- 字面量解码 ----------
 * 数字：支持 0x/0b/0 前缀与 u/l 后缀（strtoull 不认 0b）。
 * 字符/字符串：完整的转义处理（八进制 1~3 位、\x 十六进制、常见字母转义）。 */
static u64 int_lit_val(const char *s, u32 len)
{
    u64 v = 0;
    u32 i = 0;

    if (len >= 2 && s[0] == '0' && (s[1] == 'b' || s[1] == 'B')) {
        for (i = 2; i < len; i++) {
            if (s[i] == '0' || s[i] == '1')
                v = v * 2 + (u64)(s[i] - '0');
            else
                break;
        }
        return v;
    }
    return (u64)strtoull(s, NULL, 0);
}

static int hex_val(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
        return c - 'A' + 10;
    return -1;
}

/* 解码一个转义序列：*pp 指向反斜杠之后，返回字节值并推进 *pp。 */
/* 上一次 esc_decode 解出来的是不是**码点**（`\uXXXX` / `\UXXXXXXXX`）。
 * `\x41` / `\101` 是**字节**转义，值 >= 0x80 也只能写进一个字节——把它们
 * 当码点再 UTF-8 编码会把 `"\xde"` 变成两个字节（踩过：std/encoding/hexdump
 * 的用例就是拿它拼二进制数据，结果 0xde 变成了 0xc3 0x9e）。 */
static int ESC_IS_UCN;

static u32 esc_decode(const char **pp, const char *end)
{
    const char *p = *pp;
    u32 v = 0;

    ESC_IS_UCN = 0;
    if (p >= end)
        return 0;
    switch (*p) {
    case 'n': *pp = p + 1; return 10;
    case 't': *pp = p + 1; return 9;
    case 'r': *pp = p + 1; return 13;
    case 'a': *pp = p + 1; return 7;
    case 'b': *pp = p + 1; return 8;
    case 'f': *pp = p + 1; return 12;
    case 'v': *pp = p + 1; return 11;
    case 'e': *pp = p + 1; return 27;
    case 'u':
    case 'U': {
        /* 通用字符名：\uXXXX（4 位）/ \UXXXXXXXX（8 位）→ 码点 */
        int want = (*p == 'u') ? 4 : 8;
        int k = 0;

        ESC_IS_UCN = 1;

        p++;
        for (k = 0; k < want && p < end && hex_val((u8)*p) >= 0; k++) {
            v = v * 16 + (u32)hex_val((u8)*p);
            p++;
        }
        *pp = p;
        return v;
    }
    case 'x': {
        int k = 0;

        p++;
        while (p < end && hex_val((u8)*p) >= 0) {
            v = v * 16 + (u32)hex_val((u8)*p);
            p++;
            k++;
        }
        (void)k;
        *pp = p;
        return v;
    }
    default:
        break;
    }
    if (*p >= '0' && *p <= '7') {
        int k = 0;

        while (k < 3 && p < end && *p >= '0' && *p <= '7') {
            v = v * 8 + (u32)(*p - '0');
            p++;
            k++;
        }
        *pp = p;
        return v;
    }
    *pp = p + 1;
    return (u32)(u8)*p;
}

/* 字符串字面量的**解码后字节数**（窄串口径，和 emit_string_literal_run /
 * sizeof("…") 完全一致）。`__builtin_strlen("a\nb")` 要数 3 字节，不能数
 * token 里 "\\n" 的 4 个字符——内核 moduleparam.h 的 MODULE_INFO 断言
 * `sizeof(info)-1 == __builtin_strlen(info)` 遇到带转义的模块描述就假失败
 * （drivers/ata/ahci.c 等 8 个 TU）。 walks 一遍 esc_decode，窄串非 ASCII
 * 码点按 UTF-8 重新编码，正好对上发射器。 */
static u32 str_lit_byte_len(Tok *t)
{
    const char *s = tok_data(t);
    const char *end = s + t->len;
    const char *base = s;
    u32 n = 0;
    int kind = 0;

    while (s < end && *s != '"')
        s++;                                   /* 跳 L/u/U/u8 前缀 */
    if (s < end) {
        u32 pre = (u32)(s - base);

        if (pre > 0 && !(pre == 2 && base[0] == 'u' && base[1] == '8'))
            kind = (base[0] == 'u') ? 2 : 4;
        s++;
    }
    while (s + 1 < end) {
        u32 ch = 0;
        int ucn = 0;
        int utf8 = 0;

        if (*s == '\\') {
            const char *p = s + 1;

            ch = esc_decode(&p, end);
            ucn = ESC_IS_UCN;
            s = p;
        } else {
            ch = (u32)(u8)*s;
            s++;
            if (ch >= 0xC0) {                  /* 源码里的 UTF-8 多字节序列 */
                u32 need = (ch >= 0xF0) ? 3 : (ch >= 0xE0) ? 2 : 1;
                u32 acc = ch & ((need == 2) ? 0x0F : (need == 1) ? 0x1F : 0x07);
                u32 k = 0;

                for (k = 0; k < need && s < end; k++) {
                    acc = (acc << 6) | ((u32)(u8)*s & 0x3F);
                    s++;
                }
                ch = acc;
                utf8 = 1;
            }
        }
        if (kind == 0 && ch == 0)
            break;                             /* 内嵌 NUL：strlen 到此为止 */
        if (kind == 0 && (ucn || utf8) && ch >= 0x80) {
            if (ch < 0x800)
                n += 2;
            else if (ch < 0x10000)
                n += 3;
            else
                n += 4;
        } else {
            n += 1;
        }
    }
    return n;
}

/* 字符常量：跳过 L/u/U 前缀，按"多字节累积"处理 'ab' 这种写法 */
static i64 char_lit_val(Tok *t)
{
    const char *s = tok_data(t);
    const char *end = s + t->len;
    i64 v = 0;
    int nch = 0;

    while (s < end && *s != '\'')
        s++;
    if (s < end)
        s++;
    if (end > s && end[-1] == '\'')
        end--;
    while (s < end) {
        u32 ch = 0;

        if (*s == '\\') {
            s++;
            ch = esc_decode(&s, end);
        } else {
            ch = (u32)(u8)*s;
            s++;
        }
        v = (v << 8) | (i64)(ch & 0xFF);
        nch++;
    }
    /* C99 6.4.4.4p10：单字符常量的值就是"那个字符按 `char` 解释再转 int"。
     * c6c 的 char 是 signed，所以 `'\377'` 是 -1（gcc 也是），不是 255。
     * 多字符常量是实现定义（`'ab'` = 0x6162，和 gcc 一致），不动。 */
    if (nch == 1 && (v & 0x80))
        v = (i64)(signed char)(u8)(v & 0xFF);
    return v;
}

/* ---------- 编译期常量表达式 ----------
 * 数组长度、枚举值、位域宽度、case 标签、全局初始化器都要在**解析期**求值。
 * 这里走一条独立的递归下降，只做整数运算（不产生 IR）。 */
static i64 const_expr(void);
static i64 const_cast_to(i64 v, u32 ty);
/* 上一次 str_lit_data() 写出的字节/码元数、以及元素宽度（1 = char、
 * 2 = u""、4 = L""）。常量层的 `sizeof("…")` 要用它们：`sizeof("abc")` 是 4，
 * `sizeof(L"abc")` 是 16。定义在 str_lit_data() 那一节。 */
static u32 STR_LIT_N;
static u32 STR_LIT_ESZ = 1;
static u32 str_lit_data(void);
static int CONST_LAX;
/* 常量求值刚返回的值是**符号下标**（全局量/函数名）而不是整数：
 * 全局初始化器据此决定要不要生成一条重定位。 */
static u32 CONST_SYM;
/* 和 CONST_SYM 一起用：`&sym` / `&sym.member` 是"符号 + 偏移"，偏移放这里。
 * 0 表示不加（裸符号名的情况）。 */
static i64 CONST_SYM_ADD;
/* 枚举措名既是类型名又是常量名。`(CT_STATE_MAX - 1)` 这种写法里，括号
 * **不是**强制转换——把枚举成员当类型名去 parse_typename，就会在 `-` 上
 * 报"这里要 ')'"。内核 include/linux/log2.h 的 bits_per() 正好这么用。 */
static Sym *sym_find(const char *nm, u32 nl);
static void sa_pending_push(const char *orig, u32 olen, const char *mang);
static void sa_pending_pop(void);
static int pa_is_enum_const(Tok *t)
{
    Sym *s = 0;

    if (!t || t->kind != TK_IDENT)
        return 0;
    s = sym_find(tok_data(t), t->len);
    return s && s->kind == SC_ENUMC;
}
static u32 CONST_TY;      /* const_unary 刚求值的常量类型，供 `~`/`-` 用 */
static u32 lit_type(u64 v, int uns, int lng, int base);
static void lit_suffix(const char *s, u32 len, int *uns, int *lng, int *base);

/* 全局地址常量里的偏移必须是**整数常量表达式**（C99 6.6p9）。这里的常量求值
 * 对全局变量的名字是宽容的——直接给它的 `s->val`（数据段偏移/符号下标），
 * 因为别的地方（`int a[N];` 这类，N 恰好是个全局量）历来这么用。地址常量
 * 这条路上不能宽容：`&A[i]`（i 是全局变量）会拿符号下标当元素下标，编出一个
 * 野指针。要严格时把 CONST_NOREF 打开，让 const_primary 见到全局变量就报错。 */
static int CONST_NOREF;

/* 把常量值按类型 ty 截断再按有符号性补回来。常量求值里本来是 `i64` 一统，
 * `(T)x` 直接 `return x` —— 于是 `(u64)(~0U)` 算出 0xFFFFFFFFFFFFFFFF，
 * 而 C 要求先按 `unsigned int` 取反（0xFFFFFFFF）再零扩展成 0xFFFFFFFF。
 * 内核 include/linux/mm_types.h:2038 的
 *     static_assert((u64)MMF_INIT_LEGACY_MASK <= (u64)UINT_MAX);
 * 右端正是 `(u64)(~0U)`，少了这一步断言就假失败。 */
static i64 const_cast_to(i64 v, u32 ty)
{
    u32 sz = 0;
    int uns = 0;

    if (!ty || ty_is_ptr(ty) || ty_is_float(ty) || ty_is_func(ty))
        return v;
    sz = ty_size(ty);
    if (sz == 0 || sz >= 8)
        return v;
    uns = !ty_is_signed(ty);
    {
        u64 u = (u64)v;
        u64 mask = (sz >= 8) ? ~0ULL : ((1ULL << (sz * 8)) - 1ULL);

        u = u & mask;
        if (!uns && (u & (1ULL << (sz * 8 - 1))))
            u |= ~mask;          /* 符号扩展 */
        return (i64)u;
    }
}
static u32 generic_ctl_ty(u32 t)
{
    t = ty_unqual(t);
    if (ty_is_array(t))
        return ty_ptr(ty_unqual(ty_target(t)));
    if (ty_is_func(t))
        return ty_ptr(t);
    return t;
}

static i64 const_unary(void)
{
    if (pa_accept_ch('-'))
        return -(i64)const_unary();
    if (pa_accept_ch('+'))
        return (i64)const_unary();
    if (pa_accept_ch('~')) {
        /* 操作数的类型决定取反做多宽：`~0U` 是 unsigned int 的 0xFFFFFFFF，
         * 不是 unsigned long 的 0xFFFF…FF。const_unary 收尾时会把类型记进
         * CONST_TY，这里按它截断。 */
        i64 v = const_unary();
        u32 t = CONST_TY;

        CONST_TY = t;
        return const_cast_to(~v, t);
    }
    if (pa_accept_ch('!'))
        return const_unary() == 0 ? 1 : 0;
    if (pa_accept_ch('&')) {
        /* offsetof 的经典写法：`&((T *)0)->m` 的值就是成员偏移。真实代码里
         * `#define offsetof(t,m) ((size_t)&((t *)0)->m)` 到处都是（tcc 自己
         * 的 tccdbg.c / tccelf.c 用了三百多处）。外层可能还套着括号。 */
        u32 ty = 0;
        u32 off = 0;
        u32 mty = 0;
        int extra = 0;
        Sym *sbase = NULL;

        while (extra < 4 && pa_is_ch('(') && !is_typename_tok(pa_peek(1))) {
            pa_advance();
            extra++;
        }
        if (pa_is_ch('(') && (is_typename_tok(pa_peek(1))
            || (pa_peek(1)->kind == TK_IDENT && pa_peek(2)->kind == TK_PUNCT
                && TOK_EQ(pa_peek(2), "@")))) {
            pa_advance();
            ty = parse_typename();
            if (pa_is_ch(',')) {
                /* `sizeof((int, int))`：元组类型 */
                u32 tys[TUPLE_MAXN] = {0};
                u32 tn = 0;

                tys[tn++] = ty;
                while (tn < TUPLE_MAXN && pa_accept_ch(','))
                    tys[tn++] = parse_typename();
                ty = ty_tuple_chk(tys, tn);
            }
            pa_expect_ch(')');
            if (pa_accept_ch('(')) {
                if (pa_cur()->kind == TK_NUM)
                    pa_advance();
                (void)pa_accept_ch(')');
            } else if (pa_cur()->kind == TK_NUM) {
                pa_advance();
            }
            /* 先把外层多余的 ')' 吃掉，然后才是成员链 */
            while (extra > 0) {
                pa_expect_ch(')');
                extra--;
            }
        } else if (pa_cur()->kind == TK_STR) {
            /* `&"string"`：`&#option` 宏展开成 `&"PARPORT_SERIAL"`（内核
             * drivers/tty/serial/8250/8250_pci.c 的 REPORT_CONFIG），字符串
             * 字面量的地址是常量。`str_lit_data()` 把相邻串拼好写进数据段，
             * 返回地址；extra 里记着前面剥掉的 `(`（宏的括号），逐个补回。 */
            u32 str_off = str_lit_data();
            u64 va = ELF_BASE_VA + ELF_HDR + (u64)str_off;

            while (extra > 0) {
                pa_expect_ch(')');
                extra--;
            }
            CONST_TY = ty_ptr(ty_char());
            return (i64)va;
        } else if (pa_cur()->kind == TK_IDENT
                   && (sbase = sym_find(tok_data(pa_cur()), pa_cur()->len)) != NULL
                   && sbase->kind == SC_GLOBAL) {
            /* `&全局对象` / `&函数名`：早期这里只认 `&((T *)0)->member`，
             * 直接报"只支持 … 形式的取地址"。可内核里到处都是它的变体：
             *   .driver_data = (kernel_ulong_t)(&i830_early_ops)
             *   DECLARE_WORK(n, &fn)          → .func = (&fn)
             *   unsigned long *p = cpumask_bits(&mask)   → &mask.bits[0]
             * 这些在全局初始化器里落地的方式和裸符号名一样：写一条重定位
             * （符号下标 + 偏移），不是整数。 */
            ty = sbase->type;
            pa_advance();
            while (extra > 0 && pa_is_ch(')')) {
                pa_advance();
                extra--;
            }
        } else {
            pa_error("常量表达式里只支持 &((T *)0)->member 形式的取地址");
            return 0;
        }
        /* 成员链：`&((T *)0)->m` 和 `&sym.m` 走同一段。
         * 常量下标 `&sym[i]` 也算在内（`(unsigned long)(&tab[2])` 这种写法
         * 在内核 X86_MATCH_* 的 `.driver_data = (unsigned long)(&ppin_info[V])`
         * 里到处都是）：元素大小乘一下就是偏移，和 glob_addr_parse 一致。 */
        for (;;) {
            int arrow = 0;
            char *nm = NULL;
            u32 nl = 0;
            u32 mo = 0;

            if (pa_accept_ch('[')) {
                i64 k = const_expr();
                u32 base = ty;

                pa_expect_ch(']');
                if (ty_is_ptr(base))
                    base = ty_target(base);
                if (!ty_is_array(base)) {
                    pa_error("常量表达式里的下标只能用在数组上");
                    return 0;
                }
                off += (u32)(k * (i64)ty_size(ty_target(base)));
                ty = ty_target(base);
                continue;
            }
            if (pa_accept_punct("->"))
                arrow = 1;
            else if (!pa_accept_ch('.'))
                break;
            if (arrow)
                ty = ty_target(ty);
            if (pa_cur()->kind != TK_IDENT) {
                pa_error("常量表达式里的取地址只能跟成员名");
                return 0;
            }
            nm = (char *)tok_data(pa_cur());
            nl = pa_cur()->len;
            pa_advance();
            if (!agg_find_promoted(ty, nm, nl, &mty, &mo)) {
                pa_error("常量表达式里的取地址找不到成员");
                return 0;
            }
            off += mo;
            ty = mty;
        }
        if (sbase) {
            /* 是个"符号 + 偏移"，交给全局初始化器补重定位。 */
            CONST_SYM = 1;
            CONST_SYM_ADD = (i64)off;
            return sbase->val;
        }
        return (i64)off;
    }
    /* `_Generic` 也要能出现在常量上下文（`_Static_assert(_Generic(...), "…")`）。
     * 控制表达式只取类型：发一条赋值再撤销，和表达式那条路是同一招。 */
    if (PA_IS_IDENT("_Generic") && pa_peek(1)->kind == TK_PUNCT
        && tok_eq(pa_peek(1), "(")) {
        u32 cty = 0;
        i64 hit = 0;
        i64 dflt = 0;
        int found = 0;
        int has_dflt = 0;

        pa_advance();
        pa_advance();
        {
            u32 save0 = FN.n;

            (void)gen_assign();
            cty = generic_ctl_ty(GEN_TY);
            FN.n = save0;
            PEND_LVAL = 0;
        }
        while (pa_accept_ch(',')) {
            if (PA_IS_IDENT("default")) {
                pa_advance();
                pa_expect_ch(':');
                dflt = const_expr();
                has_dflt = 1;
                continue;
            }
            {
                u32 at = parse_typename();

                pa_expect_ch(':');
                if (!found && ty_unqual(at) == ty_unqual(cty)) {
                    hit = const_expr();
                    found = 1;
                } else {
                    /* 没选中：把这个值整体跳过去，停在 ',' 或 ')' 前 */
                    int depth = 0;

                    while (pa_cur()->kind != TK_EOF) {
                        Tok *t = pa_cur();

                        if (depth == 0 && t->kind == TK_PUNCT
                            && (tok_eq(t, ",") || tok_eq(t, ")")))
                            break;
                        if (t->kind == TK_PUNCT) {
                            if (tok_eq(t, "(") || TOK_EQ(t, "[") || TOK_EQ(t, "{"))
                                depth++;
                            else if (tok_eq(t, ")") || TOK_EQ(t, "]") || TOK_EQ(t, "}"))
                                depth--;
                        }
                        pa_advance();
                    }
                }
            }
        }
