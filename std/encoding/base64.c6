/* std/encoding/base64：Base64（RFC 4648）的标准表与 URL 安全表。
 *
 *     import std.encoding.base64;
 *
 *     char out[32] = { 0 };
 *     int n = b64_encode(S("foobar"), out, sizeof out);          // 8, "Zm9vYmFy"
 *     b64_decode(S("Zm9vYmFy"), buf, sizeof buf);                // 6, "foobar"
 *     b64url_encode(S("\xfb\xff"), out, sizeof out);             // "-_8"
 *
 * `std.encoding.codec` 里已经有一份 Base64（`b64_encode`/`b64_decode`，宽容口径：跳过
 * 空白、接受省略填充）。这一层是给**协议实现**用的：JWT / JWKS / HTTP
 * `Authorization` 要 URL 安全表，还要能严格拒绝「该有填充却没有」之类的问题。
 * 所以这里每个函数都显式带表与填充策略，不靠全局开关：
 *
 *   - `url` 参数：0 = 标准表（`+` `/`），1 = URL 安全表（`-` `_`）；
 *   - `pad` 参数：1 = 输出填充 / 要求填充，0 = 不输出 / 不要求。
 *
 * 约定和其他编解码一样：**不分配**，结果写调用方缓冲，放不下返回 -1 并且
 * 一个字节都不写。解码器先完整校验再写第二遍，非法输入不留半截结果。
 *
 * 解码的容忍度是显式选择的，不是拍脑袋：
 * - 一律跳过 ASCII 空白（`空格 \t \n \r \v \f`）和 CRLF——MIME 换行；
 * - `pad == 1` 时要求长度补齐到 4 的倍数、`=` 正好在末尾；`pad == 0` 时接受
 *   省略填充，但**拒绝出现在中间的 `=`**；
 * - 两种表互不混用：标准表下 `-`/`_` 是非法字符，反之亦然；
 * - 纯空输入解出 0 字节。
 *
 * `*_decode_inplace` 在**同一块缓冲**上解码（输入和输出可以重叠），给
 * 「读进一大块再解」的场合省一次搬运。
 */
#include <string.h>

module std.encoding.base64;
import std.core.types;
import std.core.err;

enum Error { OK = 0, PARSE = 1, INVAL = 2, RANGE = 3 };

static char *b64_tab(int url)
{
    return url ? (char *)"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                       "0123456789-_"
               : (char *)"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                         "0123456789+/";
}

/* 字节 -> 6 位值；非法给 -1 */
static int b64_val(int c, int url)
{
    if (c >= 'A' && c <= 'Z')
        return c - 'A';
    if (c >= 'a' && c <= 'z')
        return c - 'a' + 26;
    if (c >= '0' && c <= '9')
        return c - '0' + 52;
    if (url) {
        if (c == '-')
            return 62;
        if (c == '_')
            return 63;
        return -1;
    }
    if (c == '+')
        return 62;
    if (c == '/')
        return 63;
    return -1;
}

static int b64_space(int c)
{
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v'
        || c == '\f';
}

/* ---- 编码 ---- */

/* 编码后多少字节（不含结尾 NUL；n <= 0 给 0） */
int b64_encoded_len(int n, int pad)
{
    int full = 0;

    if (n <= 0)
        return 0;
    full = (n / 3) * 4;
    if (n % 3 == 0)
        return full;
    return full + (pad ? 4 : n % 3 + 1);
}

/* 编码；cap 不够返回 -1 且不写任何内容。返回值不含结尾 NUL。 */
int b64_encode_ex(char[:] s, char *dst, int cap, int url, int pad)
{
    char *tab = b64_tab(url);
    int n = s.len;
    int need = b64_encoded_len(n, pad);
    int i = 0;
    int o = 0;

    if (n < 0 || need < 0 || need > cap)
        return -1;
    while (i + 2 < n) {
        u32 v = ((u32)(u8)s.data[i] << 16) | ((u32)(u8)s.data[i + 1] << 8)
                | (u32)(u8)s.data[i + 2];

        dst[o + 0] = tab[(v >> 18) & 63];
        dst[o + 1] = tab[(v >> 12) & 63];
        dst[o + 2] = tab[(v >> 6) & 63];
        dst[o + 3] = tab[v & 63];
        i += 3;
        o += 4;
    }
    if (n - i == 1) {
        u32 v = (u32)(u8)s.data[i] << 16;

        dst[o + 0] = tab[(v >> 18) & 63];
        dst[o + 1] = tab[(v >> 12) & 63];
        o += 2;
        if (pad) {
            dst[o + 0] = '=';
            dst[o + 1] = '=';
            o += 2;
        }
    } else if (n - i == 2) {
        u32 v = ((u32)(u8)s.data[i] << 16) | ((u32)(u8)s.data[i + 1] << 8);

        dst[o + 0] = tab[(v >> 18) & 63];
        dst[o + 1] = tab[(v >> 12) & 63];
        dst[o + 2] = tab[(v >> 6) & 63];
        o += 3;
        if (pad) {
            dst[o + 0] = '=';
            o += 1;
        }
    }
    return o;
}

int b64_encode(char[:] s, char *dst, int cap)
{
    return b64_encode_ex(s, dst, cap, 0, 1);
}

int b64url_encode(char[:] s, char *dst, int cap)
{
    return b64_encode_ex(s, dst, cap, 1, 0);
}

/* ---- 解码 ---- */

/* 只校验 + 算长度：返回解码后的字节数，非法输入返回 -1 */
int b64_decoded_len(char[:] s, int url, int pad)
{
    int n = 0;      /* 有效字符数（去掉空白与填充） */
    int eq = 0;     /* 填充个数 */
    int seen_eq = 0;
    int i = 0;

    if (s.len < 0)
        return -1;
    for (i = 0; i < s.len; i++) {
        int c = (u8)s.data[i];

        if (b64_space(c))
            continue;
        if (c == '=') {
            /* 没要求填充（URL 安全变体）时，`=` 是**非法字符**而不是可忽略的
             * 修饰：JWT 这类格式里一个 `=` 就意味着发送方用错了表。 */
            if (!pad)
                return -1;
            seen_eq = 1;
            eq++;
            if (eq > 2)
                return -1;
            continue;
        }
        if (seen_eq)
            return -1;      /* `=` 出现在中间 */
        if (b64_val(c, url) < 0)
            return -1;
        n++;
    }
    if (n % 4 == 1)
        return -1;          /* 6 位剩 1 位，解不出整字节 */
    if (eq > 0) {
        if (!pad)
            return -1;
        if ((n + eq) % 4 != 0)
            return -1;      /* 填充没补齐到 4 的倍数 */
        if (n % 4 == 0)
            return -1;      /* 整块后面不该有填充 */
        if (eq != 4 - n % 4)
            return -1;      /* 填充位数不对 */
    } else if (pad && n % 4 != 0) {
        /* 要求填充的调用方：尾部不整块就必须带着 `=` 来。少了填充意味着
         * 发送方截断了一块，或被中继顺手剥掉了——和「`=` 出现在中间」一样
         * 是形态错误，不能当宽容输入放过去。 */
        return -1;
    }
    return (n / 4) * 3 + (n % 4 == 0 ? 0 : n % 4 - 1);
}

/* 解码；cap 不够或输入非法返回 -1 且不写任何内容 */
int b64_decode_ex(char[:] s, char *dst, int cap, int url, int pad)
{
    int need = b64_decoded_len(s, url, pad);
    int acc = 0;
    int bits = 0;
    int o = 0;
    int i = 0;

    if (need < 0 || need > cap)
        return -1;
    for (i = 0; i < s.len; i++) {
        int c = (u8)s.data[i];
        int v = 0;

        if (b64_space(c) || c == '=')
            continue;
        v = b64_val(c, url);
        acc = (acc << 6) | v;
        bits += 6;
        if (bits >= 8) {
            bits -= 8;
            dst[o] = (char)((acc >> bits) & 0xff);
            o++;
        }
    }
    return o;
}

int b64_decode(char[:] s, char *dst, int cap)
{
    return b64_decode_ex(s, dst, cap, 0, 1);
}

int b64url_decode(char[:] s, char *dst, int cap)
{
    return b64_decode_ex(s, dst, cap, 1, 0);
}

/* 在调用方给自己的缓冲上就地解码：src 是编码文本、dst 可以是同一块内存。
 * cap 是 dst 的可用容量。返回字节数，非法或放不下给 -1（此时 dst 未被改动）。
 *
 * 成功时**额外写一个结尾 NUL**（占 cap 里的一格）：就地解码的典型用法是
 * 「读进来一块文本 → 就地解成字节 → 当字符串继续处理」，不补 NUL 就会把
 * 输入里剩下的编码字符当成结果的一部分（输出永远比输入短，尾巴不会自己消失）。 */
int b64_decode_inplace(char[:] src, char *dst, int cap)
{
    int need = b64_decoded_len(src, 0, 1);
    int n = 0;

    if (need < 0 || need + 1 > cap)
        return -1;
    /* 只有确认能成功才动 dst——src 与 dst 重叠时这尤其重要 */
    n = b64_decode_ex(src, dst, cap, 0, 1);
    if (n < 0)
        return -1;
    dst[n] = 0;
    return n;
}

int b64url_decode_inplace(char[:] src, char *dst, int cap)
{
    int need = b64_decoded_len(src, 1, 0);
    int n = 0;

    if (need < 0 || need + 1 > cap)
        return -1;
    n = b64_decode_ex(src, dst, cap, 1, 0);
    if (n < 0)
        return -1;
    dst[n] = 0;
    return n;
}

/* ---- 便捷：判断是否是合法 Base64（不写任何东西） ---- */
int b64_valid(char[:] s, int url, int pad)
{
    return b64_decoded_len(s, url, pad) >= 0;
}

test "已知向量：RFC 4648 第 10 节" {
    struct V { char *plain; char *enc; char *url; };
    V v[7] = {
        { (char *)"", (char *)"", (char *)"" },
        { (char *)"f", (char *)"Zg==", (char *)"Zg" },
        { (char *)"fo", (char *)"Zm8=", (char *)"Zm8" },
        { (char *)"foo", (char *)"Zm9v", (char *)"Zm9v" },
        { (char *)"foob", (char *)"Zm9vYg==", (char *)"Zm9vYg" },
        { (char *)"fooba", (char *)"Zm9vYmE=", (char *)"Zm9vYmE" },
        { (char *)"foobar", (char *)"Zm9vYmFy", (char *)"Zm9vYmFy" },
    };
    char buf[32] = { 0 };
    char plain[16] = { 0 };
    int i = 0;

    for (i = 0; i < 7; i++) {
        int plen = (int)strlen(v[i].plain);
        int n = 0;

        /* 编码**不写结尾 NUL**（长度就是返回值），所以比之前先清零：
         * 否则上一轮的尾巴会让 strcmp 看到多余字节 */
        memset(buf, 0, sizeof buf);
        n = b64_encode((char[:]){ v[i].plain, plen }, buf, sizeof buf);
        if (n != (int)strlen(v[i].enc) || strcmp(buf, v[i].enc) != 0)
            return err(1, "标准表编码与 RFC 4648 不符");
        memset(buf, 0, sizeof buf);
        n = b64url_encode((char[:]){ v[i].plain, plen }, buf, sizeof buf);
        if (n != (int)strlen(v[i].url) || strcmp(buf, v[i].url) != 0)
            return err(2, "URL 表编码与 RFC 4648 不符");
        n = b64_decode((char[:]){ v[i].enc, (int)strlen(v[i].enc) }, plain,
                       sizeof plain);
        if (n != plen || memcmp(plain, v[i].plain, plen) != 0)
            return err(3, "标准表解码与 RFC 4648 不符");
        n = b64url_decode((char[:]){ v[i].url, (int)strlen(v[i].url) }, plain,
                          sizeof plain);
        if (n != plen || memcmp(plain, v[i].plain, plen) != 0)
            return err(4, "URL 表解码与 RFC 4648 不符");
    }
}

test "高位置字节与表差异" {
    char buf[16] = { 0 };
    char out[8] = { 0 };
    char raw[3] = { (char)0xfb, (char)0xff, (char)0xbf };

    if (b64_encode((char[:]){ raw, 3 }, buf, sizeof buf) != 4
        || strcmp(buf, "+/+/") != 0)
        return err(5, "0xfb 0xff 0xbf 的标准编码不对");
    if (b64url_encode((char[:]){ raw, 3 }, buf, sizeof buf) != 4
        || strcmp(buf, "-_-_") != 0)
        return err(6, "0xfb 0xff 0xbf 的 URL 编码不对");
    if (b64_decode((char[:]){ (char *)"+/+/", 4 }, out, sizeof out) != 3)
        return err(7, "标准表解不出");
    if ((u8)out[0] != 0xfb || (u8)out[1] != 0xff || (u8)out[2] != 0xbf)
        return err(8, "标准表解错");
    if (b64url_decode((char[:]){ (char *)"-_-_", 4 }, out, sizeof out) != 3)
        return err(9, "URL 表解不出");
    if ((u8)out[0] != 0xfb || (u8)out[1] != 0xff || (u8)out[2] != 0xbf)
        return err(10, "URL 表解错");
    /* 两张表不混用 */
    if (b64_valid((char[:]){ (char *)"+/+/", 4 }, 1, 1) != 0)
        return err(11, "URL 表不该接受 +/");
    if (b64_valid((char[:]){ (char *)"-_-_", 4 }, 0, 1) != 0)
        return err(12, "标准表不该接受 -_");
}

test "空输入、空白与 CRLF" {
    char buf[16] = { 0 };

    if (b64_decode((char[:]){ (char *)"", 0 }, buf, sizeof buf) != 0)
        return err(13, "空输入应当解出 0 字节");
    if (b64_encoded_len(0, 1) != 0 || b64_encoded_len(-5, 1) != 0)
        return err(14, "空/负长度编码长度不是 0");
    if (b64_decode((char[:]){ (char *)" ", 1 }, buf, sizeof buf) != 0)
        return err(15, "纯空白应当解出 0 字节");
    memset(buf, 0, sizeof buf);
    if (b64_decode((char[:]){ (char *)"Zm9v\r\nYmFy", 10 }, buf, sizeof buf) != 6
        || strcmp(buf, "foobar") != 0)
        return err(16, "CRLF 没有跳过");
    memset(buf, 0, sizeof buf);
    if (b64_decode((char[:]){ (char *)" Z m 9 v ", 9 }, buf, sizeof buf) != 3
        || memcmp(buf, "foo", 3) != 0)
        return err(17, "空格穿插没有跳过");
    if (b64_decode((char[:]){ (char *)"Zm9v\n", 5 }, buf, sizeof buf) != 3
        || strcmp(buf, "foo") != 0)
        return err(18, "尾部换行没有跳过");
}

test "填充策略：pad 为 0 / 1 的差别" {
    char buf[16] = { 0 };

    /* pad = 0：接受省略，也接受带着的 */
    if (b64url_decode((char[:]){ (char *)"Zg", 2 }, buf, sizeof buf) != 1)
        return err(19, "省略填充没解出");
    /* URL 安全变体不发填充：带着 `=` 来意味着发送方用错了表，明确拒收 */
    if (b64url_decode((char[:]){ (char *)"Zg==", 4 }, buf, sizeof buf) != -1)
        return err(20, "URL 表下 `=` 应当拒收");
    /* pad = 1：必须有 */
    if (b64_decode((char[:]){ (char *)"Zg", 2 }, buf, sizeof buf) != -1)
        return err(21, "pad = 1 时省略填充应当报错");
    if (b64_decoded_len((char[:]){ (char *)"Zm8", 3 }, 0, 1) != -1)
        return err(22, "pad = 1 时省略填充的长度应当 -1");
    /* 不带填充输出 */
    if (b64_encode_ex((char[:]){ (char *)"f", 1 }, buf, sizeof buf, 0, 0) != 2
        || strcmp(buf, "Zg") != 0)
        return err(23, "pad = 0 不该写 =");
    if (b64_encode_ex((char[:]){ (char *)"fo", 2 }, buf, sizeof buf, 0, 0) != 3
        || strcmp(buf, "Zm8") != 0)
        return err(24, "pad = 0 时两字节输入给 3 个字符");
}

test "非法输入：`=` 位置、长度、字符" {
    char buf[16] = { 0 };
    char[:] bad[8] = {
        { (char *)"Z", 1 },        /* % 4 == 1 */
        { (char *)"Zg=", 3 },      /* 填充没补齐 */
        { (char *)"Zg===", 5 },    /* 填充超过 2 */
        { (char *)"=Zg=", 4 },     /* = 在开头 */
        { (char *)"Zm9vYmFy=", 9 },/* 整块后面有填充 */
        { (char *)"Zm9v!", 5 },    /* 非法字符 */
        { (char *)"Zg=Z", 4 },     /* = 在中间 */
        { (char *)"Zm9vYg===", 9 } /* 3 个填充 */
    };
    int i = 0;

    for (i = 0; i < 8; i++) {
        if (b64_decoded_len(bad[i], 0, 1) != -1)
            return err(30, "非法输入的长度没报 -1");
        if (b64_decode(bad[i], buf, sizeof buf) != -1)
            return err(31, "非法输入没报 -1");
    }
}

test "放不下时一个字节都不写" {
    char buf[16] = { 0 };
    char small[2] = { 'Z', 'Z' };

    memset(buf, 'Q', sizeof buf);
    if (b64_encode((char[:]){ (char *)"foobar", 6 }, buf, 7) != -1)
        return err(32, "b64_encode 应当放不下");
    if (buf[0] != 'Q' || buf[7] != 'Q')
        return err(33, "b64_encode 写了半截");
    if (b64_encode((char[:]){ (char *)"foobar", 6 }, buf, 0) != -1)
        return err(34, "cap = 0 应当失败");
    if (b64_encode((char[:]){ (char *)"foobar", 6 }, buf, 8) != 8)
        return err(34, "刚好 8 格应当放得下");
    if (b64_decode((char[:]){ (char *)"Zm9vYmFy", 8 }, small, sizeof small)
        != -1)
        return err(35, "b64_decode 应当放不下");
    if (small[0] != 'Z' || small[1] != 'Z')
        return err(36, "b64_decode 写了半截");
    /* 长度先算得出来 */
    if (b64_encoded_len(6, 1) != 8 || b64_encoded_len(4, 1) != 8
        || b64_encoded_len(4, 0) != 6)
        return err(37, "encoded_len 不对");
    if (b64_decoded_len((char[:]){ (char *)"Zm9vYmFy", 8 }, 0, 1) != 6)
        return err(38, "decoded_len 不对");
}

test "就地解码" {
    char buf[16] = { 0 };

    memcpy(buf, "Zm9vYmFy", 8);
    if (b64_decode_inplace((char[:]){ buf, 8 }, buf, sizeof buf) != 6
        || strcmp(buf, "foobar") != 0)
        return err(39, "就地解码不对");
    memcpy(buf, "Zg==", 5);
    if (b64_decode_inplace((char[:]){ buf, 4 }, buf, sizeof buf) != 1
        || buf[0] != 'f')
        return err(40, "就地解码单字节不对");
    memcpy(buf, "Zm9v!", 6);
    if (b64_decode_inplace((char[:]){ buf, 5 }, buf, 2) != -1)
        return err(41, "非法输入的就地解码没报错");
    memcpy(buf, "Zm9vYmFy", 8);
    if (b64_decode_inplace((char[:]){ buf, 8 }, buf, 2) != -1)
        return err(42, "容量不够的就地解码没报错");
    if (b64_decode_inplace((char[:]){ buf, 8 }, buf, sizeof buf) != 6)
        return err(43, "报错之后没动缓冲，还能正常解");
}

test "往返：所有 0..255 的字节" {
    char raw[256] = { 0 };
    char enc[512] = { 0 };
    char back[256] = { 0 };
    int i = 0;
    int n = 0;

    for (i = 0; i < 256; i++)
        raw[i] = (char)i;
    for (n = 0; n <= 256; n += 7) {
        int e = b64_encode((char[:]){ raw, n }, enc, sizeof enc);

        if (e != b64_encoded_len(n, 1))
            return err(50, "编码长度与 encoded_len 不一致");
        if (b64_decode((char[:]){ enc, e }, back, sizeof back) != n)
            return err(51, "往返长度不一致");
        if (n > 0 && memcmp(raw, back, n) != 0)
            return err(52, "往返内容不一致");
        e = b64url_encode((char[:]){ raw, n }, enc, sizeof enc);
        if (e != b64_encoded_len(n, 0))
            return err(53, "URL 编码长度与 encoded_len 不一致");
        if (b64url_decode((char[:]){ enc, e }, back, sizeof back) != n)
            return err(54, "URL 往返长度不一致");
        if (n > 0 && memcmp(raw, back, n) != 0)
            return err(55, "URL 往返内容不一致");
    }
}
