/* c6 函数字面量 'RET (参数) { 体 }' 示例
 *
 *   ./tcc/tcc -B tcc -run examples/fn_lit_demo.c6
 *
 * 字面量是一个表达式，值就是那个函数（退化成普通函数指针）：不分配对象、
 * 不做引用计数、能直接交给 C。体在翻译单元末尾单独编译，因此体里只看得见
 * 它自己的参数和文件作用域的名字——外层的局部变量和形参要用参数传进去。
 */
#include <stdio.h>
#include <stdlib.h>

static int offset = 100;            /* 文件作用域：体里直接用 */

static int apply(int (*f)(int), int v)
{
    return f(v);
}

int main(void)
{
    /* 1. 显式声明 */
    int (*inc)(int) = int(int x) { return x + 1; };
    printf("inc(1)      = %d\n", inc(1));

    /* 2. 就地调用 */
    printf("就地调用    = %d\n", int(int x) { return x * 2; }(21));

    /* 3. 推断声明：类型从字面量推出来 */
    heavier = int(int x) { return x + offset; };
    printf("推断声明    = %d\n", heavier(1));

    /* 4. 当实参、进函数指针表 */
    printf("作实参      = %d\n", apply(int(int x) { return x * 3; }, 3));
    int (*table[2])(int) = {
        { int(int x) { return x - 1; } },
        { int(int x) { return x - 2; } },
    };
    printf("表[0]/[1]   = %d %d\n", table[0](10), table[1](10));

    /* 5. 交给 C 标准库：就地写比较函数 */
    int v[5] = { 3, 1, 4, 1, 5 };
    qsort(v, 5, sizeof v[0], int(const void *a, const void *b) {
        int x = *(const int *)a, y = *(const int *)b;
        return x < y ? -1 : x > y;
    });
    printf("qsort       = %d %d %d %d %d\n", v[0], v[1], v[2], v[3], v[4]);

    /* 6. 可失败的字面量 */
    int (*divi)(int, int)!error = int!error (int a, int b) {
        if (!b)
            err(1, "division by zero");
        return a / b;
    };
    divi(9, 0) catch e {
        printf("catch       = %d %s\n", e.id, e.msg);
        return 0;
    };
    return 0;
}
