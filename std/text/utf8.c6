/* std/text/utf8：UTF-8 解码、编码、校验与按码点迭代。
 *
 *     import std.text.utf8;          // 需要 Str 时再 import std.text.str
 *
 *     char[:] s = S("中文🙂");
 *     foreach (Rune r = utf8_runes(s)) {
 *         printf("U+%04x @%d %d 字节\n", r.cp, r.pos, r.size);
 *     }
 *     if (!utf8_valid(s)) ...
 *
 * Str 是**字节**视图（`count()` 是字节数），这一层才谈「字符」。规则写死：
 * 拒绝 overlong 编码、代理区 D800..DFFF、> U+10FFFF、截断序列和非法续字节；
 * 非法输入在迭代里**恰好前进 1 字节**（重同步），不会卡住也不会吃掉后续
 * 合法字符。
 *
 * 非法码点的 Rune 约定：`ok = 0`、`cp = UTF8_RUNE_BAD`（U+FFFD 替换符）、
 * `size = 1`、`pos` 指向那个坏字节，同时 `Runes.bad` 加一。原始字节值可以
 * 从 `s[pos]` 自己取——`cp` 只保证是「约定的替换符」，不做两套语义。
 */
module std.text.utf8;
import std.core.types;

/* U+10FFFF 是 UTF-8 的上限；U+FFFD 是替换符 */
enum Utf8 {
    UTF8_RUNE_MAX = 0x10ffff,
    UTF8_RUNE_BAD = 0xfffd,
};

struct Rune {
    u32 cp;     /* 码点（非法时是 UTF8_RUNE_BAD） */
    int pos;    /* 在源切片里的起始字节 */
    int size;   /* 占几个字节（非法时 1） */
    int ok;     /* 合法给 1 */
};

struct Runes {
    char[:] s;
    int pos;
    int bad;    /* 已经遇到的非法字节数 */
};

/* 从 i 处解一个码点：返回消耗的字节数 1..4；i 越界给 0；非法给 -1。
   *cp 只在返回 > 0 时写。 */
int utf8_decode(char[:] s, int i, u32 *cp)
{
    u8 c = 0, c1 = 0, c2 = 0, c3 = 0;
    u32 v = 0u;

    if (i < 0 || i >= s.len)
        return 0;
    c = (u8)s.data[i];
    if (c < 0x80u) {
        if (cp)
            *cp = (u32)c;
        return 1;
    }
    /* 2 字节：C2..DF 已经排除 overlong（C0/C1） */
    if (c >= 0xc2u && c <= 0xdfu) {
        if (i + 1 >= s.len)
            return -1;
        c1 = (u8)s.data[i + 1];
        if ((c1 & 0xc0u) != 0x80u)
            return -1;
        v = ((u32)(c & 0x1fu) << 6) | (u32)(c1 & 0x3fu);
        if (cp)
            *cp = v;
        return 2;
    }
    if (c >= 0xe0u && c <= 0xefu) {
        if (i + 2 >= s.len)
            return -1;
        c1 = (u8)s.data[i + 1];
        c2 = (u8)s.data[i + 2];
        if ((c1 & 0xc0u) != 0x80u || (c2 & 0xc0u) != 0x80u)
            return -1;
        if (c == 0xe0u && c1 < 0xa0u)         /* overlong */
            return -1;
        if (c == 0xedu && c1 >= 0xa0u)        /* 代理区 */
            return -1;
        v = ((u32)(c & 0x0fu) << 12) | ((u32)(c1 & 0x3fu) << 6)
          | (u32)(c2 & 0x3fu);
        if (cp)
            *cp = v;
        return 3;
    }
    if (c >= 0xf0u && c <= 0xf4u) {
        if (i + 3 >= s.len)
            return -1;
        c1 = (u8)s.data[i + 1];
        c2 = (u8)s.data[i + 2];
        c3 = (u8)s.data[i + 3];
        if ((c1 & 0xc0u) != 0x80u || (c2 & 0xc0u) != 0x80u
            || (c3 & 0xc0u) != 0x80u)
            return -1;
        if (c == 0xf0u && c1 < 0x90u)         /* overlong */
            return -1;
        if (c == 0xf4u && c1 > 0x8fu)         /* > U+10FFFF */
            return -1;
        v = ((u32)(c & 0x07u) << 18) | ((u32)(c1 & 0x3fu) << 12)
          | ((u32)(c2 & 0x3fu) << 6) | (u32)(c3 & 0x3fu);
        if (cp)
            *cp = v;
        return 4;
    }
    return -1;
}

/* 把码点编码进 dst（cap 是 dst 的字节容量）：返回写入字节数；
   非法码点或放不下返回 -1，且**一个字节都不写**。 */
int utf8_encode(u32 cp, char *dst, int cap)
{
    int need = 0;

    if (cp > (u32)UTF8_RUNE_MAX)
        return -1;
    if (cp >= 0xd800u && cp <= 0xdfffu)
        return -1;                            /* 代理区不是码点 */
    if (cp < 0x80u)
        need = 1;
    else if (cp < 0x800u)
        need = 2;
    else if (cp < 0x10000u)
        need = 3;
    else
        need = 4;
    if (!dst || cap < need)
        return -1;
    if (need == 1) {
        dst[0] = (char)cp;
    } else if (need == 2) {
        dst[0] = (char)(0xc0u | (cp >> 6));
        dst[1] = (char)(0x80u | (cp & 0x3fu));
    } else if (need == 3) {
        dst[0] = (char)(0xe0u | (cp >> 12));
        dst[1] = (char)(0x80u | ((cp >> 6) & 0x3fu));
        dst[2] = (char)(0x80u | (cp & 0x3fu));
    } else {
        dst[0] = (char)(0xf0u | (cp >> 18));
        dst[1] = (char)(0x80u | ((cp >> 12) & 0x3fu));
        dst[2] = (char)(0x80u | ((cp >> 6) & 0x3fu));
        dst[3] = (char)(0x80u | (cp & 0x3fu));
    }
    return need;
}

/* 整个切片是不是合法 UTF-8 */
int utf8_valid(char[:] s)
{
    int i = 0;
    int k = 0;

    while (i < s.len) {
        k = utf8_decode(s, i, (u32 *)0);
        if (k <= 0)
            return 0;
        i += k;
    }
    return 1;
}

/* 码点个数（非法字节算 1 个，与迭代轮数一致） */
int utf8_count(char[:] s)
{
    int i = 0, n = 0, k = 0;

    while (i < s.len) {
        k = utf8_decode(s, i, (u32 *)0);
        if (k <= 0)
            k = 1;                 /* 重同步：坏字节单独算一个 */
        i += k;
        n++;
    }
    return n;
}

/* ---- foreach 迭代器 ---- */

int has(Runes *self) { return self->pos < self->s.len; }

Rune next(Runes *self)
{
    Rune r = { (u32)UTF8_RUNE_BAD, self->pos, 1, 0 };
    u32 cp = 0u;
    int k = 0;

    if (self->pos >= self->s.len) {
        r.pos = self->s.len;
        r.size = 0;
        return r;
    }
    r.pos = self->pos;
    k = utf8_decode(self->s, self->pos, &cp);
    if (k <= 0) {
        self->bad++;
        self->pos++;
        return r;
    }
    r.cp = cp;
    r.size = k;
    r.ok = 1;
    self->pos += k;
    return r;
}

Runes utf8_runes(char[:] s)
{
    Runes r = { s, 0, 0 };

    return r;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "ASCII 与多字节解码" {
    char[:] a = S("A");
    char[:] cn = S("中");
    char[:] emo = S("🙂");
    u32 cp = 0u;

    if (utf8_decode(a, 0, &cp) != 1 || cp != 0x41u)
        return err(1, "ASCII 解码不对");
    if (utf8_decode(cn, 0, &cp) != 3 || cp != 0x4e2du)
        return err(2, "3 字节解码不对");
    if (utf8_decode(emo, 0, &cp) != 4 || cp != 0x1f642u)
        return err(3, "4 字节解码不对");
    if (utf8_decode(a, 1, &cp) != 0)
        return err(4, "i 越界应给 0");
    if (utf8_decode(cn, 1, &cp) != -1)
        return err(5, "从续字节开始应给 -1");
}

test "overlong / 代理区 / 超范围一律拒绝" {
    char[:] overlong2 = S("\xc0\xaf");          /* U+002F 的 overlong */
    char[:] overlong3 = S("\xe0\x80\xaf");
    char[:] surro = S("\xed\xa0\x80");          /* U+D800 */
    char[:] toobig = S("\xf4\x90\x80\x80");     /* > U+10FFFF */
    char[:] bad5 = S("\xf5\x80\x80\x80");
    u32 cp = 0u;

    if (utf8_decode(overlong2, 0, &cp) != -1)
        return err(6, "2 字节 overlong 没被拒");
    if (utf8_decode(overlong3, 0, &cp) != -1)
        return err(7, "3 字节 overlong 没被拒");
    if (utf8_decode(surro, 0, &cp) != -1)
        return err(8, "代理区没被拒");
    if (utf8_decode(toobig, 0, &cp) != -1)
        return err(9, ">U+10FFFF 没被拒");
    if (utf8_decode(bad5, 0, &cp) != -1)
        return err(10, "0xF5 起始没被拒");
}

test "截断与坏续字节" {
    char[:] trunc = S("\xe4\xb8");              /* “中”少一个字节 */
    char[:] cont = S("\x80");
    u32 cp = 0u;

    if (utf8_decode(trunc, 0, &cp) != -1)
        return err(11, "截断序列没被拒");
    if (utf8_decode(cont, 0, &cp) != -1)
        return err(12, "孤立续字节没被拒");
    if (utf8_valid(trunc) != 0 || utf8_valid(S("中文")) != 1)
        return err(13, "utf8_valid 不对");
}

test "码点计数与字节数分开" {
    char[:] s = S("a中🙂");

    if (s.len != 8)
        return err(14, "字节数不是 8");
    if (utf8_count(s) != 3)
        return err(15, "码点数不是 3");
    if (utf8_count(S("")) != 0)
        return err(16, "空切片码点数不是 0");
}

test "迭代：顺序、偏移、bad 计数" {
    char[:] s = S("a\xffz");
    Runes it = utf8_runes(s);
    Runes *p = &it;
    int n = 0, bad = 0, sum = 0;

    while (p->has()) {
        Rune r = p->next();
        n++;
        if (r.pos != n - 1 && r.pos != 1)
            return err(17, "pos 不对");
        if (!r.ok)
            bad++;
        if (r.ok)
            sum += (int)r.cp;
    }
    if (n != 3 || bad != 1)
        return err(18, "轮数/bad 计数不对");
    if (sum != (int)'a' + (int)'z')
        return err(19, "合法码点累加不对");
    if (p->bad != 1)
        return err(20, "Runes.bad 没记上");
}

test "foreach 直接吃 utf8_runes" {
    char[:] s = S("中文");
    int n = 0, bytes = 0;

    foreach (Rune r = utf8_runes(s)) {
        n++;
        bytes += r.size;
        if (!r.ok)
            return err(21, "合法串里出现了 ok=0");
    }
    if (n != 2 || bytes != 6)
        return err(22, "foreach 结果不对");
}

test "编码往返与失败路径" {
    char buf[8] = { 0 };
    u32 cps[4] = { 0x41u, 0x4e2du, 0x7ffu, 0x1f642u };
    int i = 0;

    for (i = 0; i < 4; i++) {
        int k = utf8_encode(cps[i], buf, (int)sizeof buf);
        u32 back = 0u;

        if (k <= 0)
            return err(23, "encode 失败");
        if (utf8_decode((char[:]){ buf, k }, 0, &back) != k)
            return err(24, "decode 的长度与 encode 不同");
        if (back != cps[i])
            return err(25, "编码往返不一致");
    }
    /* 放不下：一个字节都不写 */
    buf[0] = 'X';
    if (utf8_encode(0x1f642u, buf, 3) != -1 || buf[0] != 'X')
        return err(26, "cap 不足时写了半截");
    /* 非码点 */
    if (utf8_encode(0x110000u, buf, 8) != -1)
        return err(27, "超范围码点没被拒");
    if (utf8_encode(0xd800u, buf, 8) != -1)
        return err(28, "代理区码点没被拒");
    if (utf8_encode(0x41u, (char *)0, 8) != -1)
        return err(29, "空目标没被拒");
}
