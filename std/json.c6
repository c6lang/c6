/* std/json：JSON 解析与写出（RFC 8259），DOM 分配在 Arena 上。
 *
 *     import std.json;
 *     import std.mem;
 *     import std.str;
 *
 *     u8 buf[4096] = { 0 };
 *     Arena a = arena_make(buf, sizeof buf);
 *     Arena *pa = &a;
 *     Str text = { S("{\"a\":[1,2],\"b\":\"x\"}") };   // S() 来自 std.str
 *     Json doc = try json_parse(pa, text);
 *     Json *pd = &doc;
 *
 *     Json *arr = json_get(pd, "a");           // 不是对象 / 没有这个键 -> 0
 *     f64 first = json_at(arr, 0)->num;        // 不是数组 / 越界 -> 崩溃源，先判空
 *     Str name = json_get_str(pd, "b", "?");   // 类型不符就给默认值
 *
 *     char out[256] = { 0 };
 *     int n = json_write(pd, out, sizeof out); // 紧凑，返回字节数（不含 NUL）
 *
 * 设计与取舍：
 * - **DOM 在 Arena 上**：节点、键数组、解码后的字符串全部走
 *   `arena->alloc` / `alloc_array` / `alloc_str`，一次都不 malloc。解析出来的
 *   `Json` 树和输入文本一样，生命周期由调用方给的 arena 决定；
 *   `Arena::reset()` 一把全扔。
 * - **数字保留原文**：`Json.raw` 是输入里的那段文本（**视图，不复制**），
 *   `num` 是解析出来的 f64。写回时优先用 `raw`，所以
 *   `9007199254740993` 这种超过 f64 精度的整数写出还是原样；`raw` 为空
 *   （手工构造的节点）才用 `fmt_f64_g(num, …, 17)` 现算，并保证是合法 JSON 数字。
 * - **严格按 RFC 8259**：允许开头一个 UTF-8 BOM；空白只认 space/tab/CR/LF；
 *   顶层可以是任意值；数字只认 `-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?`
 *   （`+1` / `.5` / `01` / `1.` / `nan` / `inf` 全部拒绝）；字符串里未转义的
 *   控制字符（< 0x20）报 PARSE；`\uXXXX` 解码成 UTF-8，代理对合并，落单的
 *   代理报 PARSE。
 * - **重复键全部保留**（`n` 就是成员个数，`keys` / `kids` 一一对应），
 *   `json_get` 返回**最后**一个——后写的覆盖先写的，和大多数实现一致。
 * - **嵌套深度上限 64 层**，超过报 RANGE，递归不会爆栈。
 * - **零依赖 libm**：只用到 `std.num` 的 `fmt_f64_g` / `parse_f64`。
 *
 * 错误码（`enum Error`）：空输入 / 只有 BOM / 只有空白 → `INVAL`；
 * 语法错（含未闭合、尾随垃圾、非法转义）→ `PARSE`；深度超限 → `RANGE`；
 * arena 放不下 → `NOMEM`；`arena` 指针为空 → `INVAL`。消息是静态中文描述。
 *
 * 写出（`json_write` / `json_write_pretty` / `json_escape` / `json_unescape`）
 * 一律**先量长度再落笔**：容量不够返回 -1，且一个字节都不写（缓冲区原样保留）。
 * 容量按 C 字符串算，即 `cap` 包含结尾 NUL，返回的长度不含 NUL。
 * `json_escape` 只转义内容不加引号（`"` `\` 与 < 0x20 的控制字符，
 * 其余字节——包括 UTF-8——原样），`json_unescape` 是它的反向，非法转义给 -1。
 * 非有限数（inf / nan）在 JSON 里没有表示，写 `null`（和 `JSON.stringify` 一致）。
 */
#include <string.h>

module std.json;
import std.types;
import std.err;
import std.mem;
import std.str;
import std.num;

/* 字面量 -> 视图（宏不随 import 传递，每个模块自己定义一次） */
#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

/* 字面量 -> Str（参数要 Str 的地方比上面多个括号强转） */
#define SS(lit) ((Str){ S(lit) })

/* 嵌套深度上限：JS ([]) 65 层报 RANGE */
#define JSON_MAX_DEPTH 64

/* 值还是错误？错误码取 std.err 的同名语义（PARSE = 7 是这里独有的宽松档） */
enum Error {
    INVAL = 1,      /* 输入为空 / 参数不合法 */
    RANGE = 2,      /* 嵌套太深 */
    NOMEM = 3,      /* arena 放不下 */
    PARSE = 7,      /* 语法错 */
};

enum JsonKind {
    JNULL = 0,
    JBOOL = 1,
    JNUM  = 2,
    JSTR  = 3,
    JARR  = 4,
    JOBJ  = 5,
};

struct Json {
    JsonKind kind;  /* 是哪种值 */
    int b;          /* JBOOL: 0 / 1 */
    f64 num;        /* JNUM: 解析后的数值（raw 为空时也用它写字面量） */
    Str raw;        /* JNUM: 原始文本，指向输入、不复制；手工构造的为空 */
    Str s;          /* JSTR: 解码后的 UTF-8（在 arena 里，结尾有 NUL） */
    int n;          /* JARR / JOBJ: 子值 / 键值对个数 */
    Json *kids;     /* JARR / JOBJ: 子值数组（arena），JARR 时 keys 为 0 */
    Str *keys;      /* JOBJ: 键数组（arena），与 kids 一一对应 */
};

/* ---- 解析 ---- */

struct Jp {
    char *p;            /* 输入起点 */
    int n;              /* 输入长度 */
    int i;              /* 当前偏移 */
    Arena *a;           /* 节点都从这里出 */
    int depth;          /* 当前容器嵌套层数 */
    const char *msg;    /* 失败时的静态中文描述 */
};

static int jp_fail(Jp *ps, int code, const char *msg)
{
    ps->msg = msg;
    return code;
}

/* 跳过空白，返回下一个字节（0..255），到结尾给 -1。ps->i 停在非空白字节上 */
static int jp_ws(Jp *ps)
{
    while (ps->i < ps->n) {
        int c = (int)(u8)ps->p[ps->i];

        if (c != ' ' && c != '\t' && c != '\r' && c != '\n')
            return c;
        ps->i++;
    }
    return -1;
}

static int jp_digit(int c) { return c >= '0' && c <= '9'; }

static int jp_hex(int c)
{
    if (c >= '0' && c <= '9')
        return c - '0';
    if (c >= 'a' && c <= 'f')
        return c - 'a' + 10;
    if (c >= 'A' && c <= 'F')
        return c - 'A' + 10;
    return -1;
}

/* 读 4 位十六进制（at 指向第一位）；越界或不是 hex 报 PARSE */
static int jp_hex4(Jp *ps, int at, int *out)
{
    int v = 0, k = 0;

    for (k = 0; k < 4; k++) {
        int h = 0;

        if (at + k >= ps->n)
            return jp_fail(ps, PARSE, "\\u 后面不足 4 位十六进制");
        h = jp_hex((int)(u8)ps->p[at + k]);
        if (h < 0)
            return jp_fail(ps, PARSE, "\\u 后面不是十六进制数字");
        v = v * 16 + h;
    }
    *out = v;
    return 0;
}

/* 已校验过的 4 位 hex（解码第二遍用，不做检查） */
static int jp_hex4_at(char *s)
{
    int v = 0, k = 0;

    for (k = 0; k < 4; k++)
        v = v * 16 + jp_hex((int)(u8)s[k]);
    return v;
}

/* 一个码点写成 UTF-8，返回字节数（1..4） */
static int jp_utf8(char *dst, int cp)
{
    if (cp < 0x80) {
        dst[0] = (char)cp;
        return 1;
    }
    if (cp < 0x800) {
        dst[0] = (char)(0xc0 | (cp >> 6));
        dst[1] = (char)(0x80 | (cp & 0x3f));
        return 2;
    }
    if (cp < 0x10000) {
        dst[0] = (char)(0xe0 | (cp >> 12));
        dst[1] = (char)(0x80 | ((cp >> 6) & 0x3f));
        dst[2] = (char)(0x80 | (cp & 0x3f));
        return 3;
    }
    dst[0] = (char)(0xf0 | (cp >> 18));
    dst[1] = (char)(0x80 | ((cp >> 12) & 0x3f));
    dst[2] = (char)(0x80 | ((cp >> 6) & 0x3f));
    dst[3] = (char)(0x80 | (cp & 0x3f));
    return 4;
}

/* 一个码点编码后的字节数 */
static int jp_utf8_len(int cp)
{
    if (cp < 0x80)
        return 1;
    if (cp < 0x800)
        return 2;
    if (cp < 0x10000)
        return 3;
    return 4;
}

/* 扫一遍字符串：校验转义 / 代理对，算出解码后的字节数。
   进入时 ps->i 指向开引号；成功时 ps->i 指向**闭引号**（由调用方跳过），
   *start 是内容起点，*len 是解码后长度；失败返回错误码。 */
static int jp_scan_string(Jp *ps, int *start, int *len)
{
    int i = ps->i + 1;
    int out = 0;

    *start = i;
    for (;;) {
        int c = 0;

        if (i >= ps->n)
            return jp_fail(ps, PARSE, "字符串没有闭合");
        c = (int)(u8)ps->p[i];
        if (c == '"') {
            break;
        }
        if (c < 0x20)
            return jp_fail(ps, PARSE, "字符串里有未转义的控制字符");
        if (c != '\\') {
            i++;
            out++;
            continue;
        }
        /* 反斜杠：看下一个字符 */
        i++;
        if (i >= ps->n)
            return jp_fail(ps, PARSE, "字符串末尾只有一个反斜杠");
        c = (int)(u8)ps->p[i];
        switch (c) {
        case '"':
        case '\\':
        case '/':
        case 'b':
        case 'f':
        case 'n':
        case 'r':
        case 't':
            i++;
            out++;
            break;
        case 'u': {
            int cp = 0, rc = 0;

            rc = jp_hex4(ps, i + 1, &cp);
            if (rc)
                return rc;
            i += 5;
            if (cp >= 0xd800 && cp <= 0xdbff) {
                int lo = 0;

                if (i + 1 >= ps->n || ps->p[i] != '\\'
                    || ps->p[i + 1] != 'u')
                    return jp_fail(ps, PARSE, "落单的高位代理");
                rc = jp_hex4(ps, i + 2, &lo);
                if (rc)
                    return rc;
                if (lo < 0xdc00 || lo > 0xdfff)
                    return jp_fail(ps, PARSE, "落单的高位代理");
                i += 6;
                out += 4;
            } else if (cp >= 0xdc00 && cp <= 0xdfff) {
                return jp_fail(ps, PARSE, "落单的低位代理");
            } else {
                out += jp_utf8_len(cp);
            }
            break;
        }
        default:
            return jp_fail(ps, PARSE, "不认识的转义序列");
        }
    }
    *len = out;
    ps->i = i;          /* 停在闭引号上，由调用方跳过 */
    return 0;
}

/* 第二遍：把已经校验过的 [src, src + rawlen) 解码到 dst（不检查，只搬字节） */
static void jp_decode(char *dst, char *src, int rawlen)
{
    int i = 0, o = 0;

    while (i < rawlen) {
        int c = (int)(u8)src[i];

        if (c != '\\') {
            dst[o++] = src[i++];
            continue;
        }
        i++;
        c = (int)(u8)src[i];
        switch (c) {
        case 'b':
            dst[o++] = (char)0x08;
            i++;
            break;
        case 'f':
            dst[o++] = (char)0x0c;
            i++;
            break;
        case 'n':
            dst[o++] = (char)0x0a;
            i++;
            break;
        case 'r':
            dst[o++] = (char)0x0d;
            i++;
            break;
        case 't':
            dst[o++] = (char)0x09;
            i++;
            break;
        case 'u': {
            int cp = jp_hex4_at(src + i + 1);

            i += 5;
            if (cp >= 0xd800 && cp <= 0xdbff) {
                int lo = jp_hex4_at(src + i + 2);

                i += 6;
                cp = 0x10000 + ((cp - 0xd800) << 10) + (lo - 0xdc00);
            }
            o += jp_utf8(dst + o, cp);
            break;
        }
        default:
            dst[o++] = (char)c;   /* " \ / 三个原样 */
            i++;
            break;
        }
    }
}

/* 读一个字符串值（键或 JSTR 的值）。ps->i 指向开引号，成功后停在闭引号之后 */
static int jp_read_string(Jp *ps, Str *out)
{
    int start = 0, len = 0, rc = 0;
    char *buf = 0;

    if (ps->i >= ps->n || ps->p[ps->i] != '"')
        return jp_fail(ps, PARSE, "这里需要一个字符串");
    rc = jp_scan_string(ps, &start, &len);
    if (rc)
        return rc;
    buf = ps->a->alloc_str(len);   /* len + 1 字节，结尾有 NUL */
    if (!buf)
        return jp_fail(ps, NOMEM, "arena 放不下解码后的字符串");
    jp_decode(buf, ps->p + start, ps->i - start);
    ps->i++;
    *out = (Str){ (char[:]){ buf, len } };
    return 0;
}

/* 预先数出当前容器的元素个数：只跳字符串、只数**同级**逗号，不做语法校验
   （真正的校验在解析时做）。ps->i 指向开括号；-1 表示扫到结尾也没见到闭括号。 */
static int jp_count(Jp *ps)
{
    int i = ps->i + 1;
    int open = (int)(u8)ps->p[ps->i];
    int close = open == '{' ? '}' : ']';
    int d = 0, cnt = 0, any = 0;

    while (i < ps->n) {
        int c = (int)(u8)ps->p[i];

        if (c == '"') {
            i++;
            while (i < ps->n && ps->p[i] != '"') {
                if (ps->p[i] == '\\')
                    i++;
                i++;
            }
            if (i >= ps->n)
                return -1;
            i++;
            any = 1;
            continue;
        }
        if (c == '{' || c == '[') {
            d++;
            i++;
            any = 1;
            continue;
        }
        if (c == '}' || c == ']') {
            if (d == 0) {
                if (c != close)
                    return -1;
                return any ? cnt + 1 : 0;
            }
            d--;
            i++;
            any = 1;
            continue;
        }
        if (c == ',' && d == 0) {
            cnt++;
            i++;
            continue;
        }
        if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
            i++;
            continue;
        }
        i++;
        any = 1;
    }
    return -1;
}

static int jp_value(Jp *ps, Json *out);

/* 数字文法校验，成功时 ps->i 不动、*len 给原文长度 */
static int jp_scan_number(Jp *ps, int *len)
{
    int i = ps->i;

    if (i < ps->n && ps->p[i] == '-')
        i++;
    if (i >= ps->n)
        return jp_fail(ps, PARSE, "数字只有一个负号");
    if (ps->p[i] == '0') {
        i++;
    } else if (ps->p[i] >= '1' && ps->p[i] <= '9') {
        while (i < ps->n && jp_digit((int)(u8)ps->p[i]))
            i++;
    } else {
        return jp_fail(ps, PARSE, "数字的整数部分不合法");
    }
    if (i < ps->n && ps->p[i] == '.') {
        i++;
        if (i >= ps->n || !jp_digit((int)(u8)ps->p[i]))
            return jp_fail(ps, PARSE, "小数点后面没有数字");
        while (i < ps->n && jp_digit((int)(u8)ps->p[i]))
            i++;
    }
    if (i < ps->n && (ps->p[i] == 'e' || ps->p[i] == 'E')) {
        i++;
        if (i < ps->n && (ps->p[i] == '+' || ps->p[i] == '-'))
            i++;
        if (i >= ps->n || !jp_digit((int)(u8)ps->p[i]))
            return jp_fail(ps, PARSE, "指数部分没有数字");
        while (i < ps->n && jp_digit((int)(u8)ps->p[i]))
            i++;
    }
    *len = i - ps->i;
    return 0;
}

/* inf：不写 1.0 / 0.0（常量折叠可能报除零），用溢出得到 */
static f64 json_inf(void)
{
    f64 big = 1.0e308;

    return big * 10.0;
}

static int jp_number(Jp *ps, Json *out)
{
    int start = ps->i;
    int len = 0, rc = 0, bad = 0;
    f64 v = 0.0;

    rc = jp_scan_number(ps, &len);
    if (rc)
        return rc;
    ps->i += len;
    parse_f64((char[:]){ ps->p + start, len }, &v) catch e {
        bad = 1;
        goto parsed;
    };
parsed:
    /* 超出 f64 范围（1e400）不当作语法错：原文保真，数值夹到 ±inf */
    if (bad)
        v = ps->p[start] == '-' ? -json_inf() : json_inf();
    out->kind = JNUM;
    out->num = v;
    out->raw = (Str){ (char[:]){ ps->p + start, len } };
    return 0;
}

static int jp_lit(Jp *ps, char *lit, int n, JsonKind kind, Json *out)
{
    int k = 0;

    if (ps->i + n > ps->n)
        return jp_fail(ps, PARSE, "字面量不完整");
    for (k = 0; k < n; k++)
        if (ps->p[ps->i + k] != lit[k])
            return jp_fail(ps, PARSE, "字面量不完整");
    ps->i += n;
    out->kind = kind;
    out->b = (kind == JBOOL && lit[0] == 't') ? 1 : 0;
    return 0;
}

static int jp_array(Jp *ps, Json *out)
{
    int cnt = jp_count(ps);
    Json *kids = 0;
    int k = 0, rc = 0;

    if (cnt < 0)
        return jp_fail(ps, PARSE, "数组没有闭合");
    if (ps->depth + 1 > JSON_MAX_DEPTH)
        return jp_fail(ps, RANGE, "嵌套深度超过 64 层");
    if (cnt > 0) {
        kids = (Json *)ps->a->alloc(cnt * (int)sizeof(Json), 8);
        if (!kids)
            return jp_fail(ps, NOMEM, "arena 放不下数组");
        memset(kids, 0, (size_t)cnt * sizeof(Json));
    }
    ps->i++;
    ps->depth++;
    for (k = 0; k < cnt; k++) {
        if (k > 0) {
            if (jp_ws(ps) != ',')
                return jp_fail(ps, PARSE, "数组元素之间缺逗号");
            ps->i++;
        }
        rc = jp_value(ps, &kids[k]);
        if (rc)
            return rc;
    }
    ps->depth--;
    if (jp_ws(ps) != ']')
        return jp_fail(ps, PARSE, "数组没有闭合");
    ps->i++;
    out->kind = JARR;
    out->n = cnt;
    out->kids = kids;
    return 0;
}

static int jp_object(Jp *ps, Json *out)
{
    int cnt = jp_count(ps);
    Json *kids = 0;
    Str *keys = 0;
    int k = 0, rc = 0;

    if (cnt < 0)
        return jp_fail(ps, PARSE, "对象没有闭合");
    if (ps->depth + 1 > JSON_MAX_DEPTH)
        return jp_fail(ps, RANGE, "嵌套深度超过 64 层");
    if (cnt > 0) {
        kids = (Json *)ps->a->alloc(cnt * (int)sizeof(Json), 8);
        keys = (Str *)ps->a->alloc(cnt * (int)sizeof(Str), 8);
        if (!kids || !keys)
            return jp_fail(ps, NOMEM, "arena 放不下对象");
        memset(kids, 0, (size_t)cnt * sizeof(Json));
        memset(keys, 0, (size_t)cnt * sizeof(Str));
    }
    ps->i++;
    ps->depth++;
    for (k = 0; k < cnt; k++) {
        if (k > 0) {
            if (jp_ws(ps) != ',')
                return jp_fail(ps, PARSE, "对象成员之间缺逗号");
            ps->i++;
        }
        if (jp_ws(ps) != '"')
            return jp_fail(ps, PARSE, "对象的键必须是字符串");
        rc = jp_read_string(ps, &keys[k]);
        if (rc)
            return rc;
        if (jp_ws(ps) != ':')
            return jp_fail(ps, PARSE, "键后面缺冒号");
        ps->i++;
        rc = jp_value(ps, &kids[k]);
        if (rc)
            return rc;
    }
    ps->depth--;
    if (jp_ws(ps) != '}')
        return jp_fail(ps, PARSE, "对象没有闭合");
    ps->i++;
    out->kind = JOBJ;
    out->n = cnt;
    out->kids = kids;
    out->keys = keys;
    return 0;
}

static int jp_value(Jp *ps, Json *out)
{
    int c = jp_ws(ps);

    if (c < 0)
        return jp_fail(ps, PARSE, "值缺失：输入提前结束");
    if (c == '{')
        return jp_object(ps, out);
    if (c == '[')
        return jp_array(ps, out);
    if (c == '"') {
        int rc = jp_read_string(ps, &out->s);

        if (rc)
            return rc;
        out->kind = JSTR;
        return 0;
    }
    if (c == 't')
        return jp_lit(ps, (char *)"true", 4, JBOOL, out);
    if (c == 'f')
        return jp_lit(ps, (char *)"false", 5, JBOOL, out);
    if (c == 'n')
        return jp_lit(ps, (char *)"null", 4, JNULL, out);
    if (c == '-' || jp_digit(c))
        return jp_number(ps, out);
    return jp_fail(ps, PARSE, "不是合法的 JSON 值");
}

/* 解析：[err_pos] 非空时，失败写出出错字节偏移（成功给 -1） */
Json!error json_parse_at(Arena *a, Str text, int *err_pos)
{
    Jp ps = { 0 };
    Json v = { 0 };
    int rc = 0;

    if (err_pos)
        *err_pos = -1;
    if (!a)
        return err(INVAL, "json_parse: arena 为空");
    if (!text.s.data && text.s.len > 0)
        return err(INVAL, "json_parse: 输入指针为空");
    ps.p = text.s.data;
    ps.n = (int)text.s.len;
    ps.i = 0;
    ps.a = a;
    ps.depth = 0;
    ps.msg = 0;
    /* 开头允许一个 UTF-8 BOM */
    if (ps.n >= 3 && (u8)ps.p[0] == 0xef && (u8)ps.p[1] == 0xbb
        && (u8)ps.p[2] == 0xbf)
        ps.i = 3;
    if (jp_ws(&ps) < 0)
        return err(INVAL, "json_parse: 输入为空");
    rc = jp_value(&ps, &v);
    if (rc == 0 && jp_ws(&ps) >= 0)
        rc = jp_fail(&ps, PARSE, "顶层值后面还有多余内容");
    if (rc != 0) {
        if (err_pos)
            *err_pos = ps.i;
        return err(rc, ps.msg ? ps.msg : (const char *)"JSON 语法错误");
    }
    return v;
}

Json!error json_parse(Arena *a, Str text)
{
    Json v = { 0 };

    v = try json_parse_at(a, text, 0);
    return v;
}

/* ---- 访问 ---- */

/* 对象取键：重复键返回**最后**一个；找不到 / 不是对象给 0 */
Json *json_get(Json *self, char *key)
{
    int i = 0;

    if (!self || !key || self->kind != JOBJ || !self->kids || !self->keys)
        return 0;
    for (i = self->n - 1; i >= 0; i--)
        if ((&self->keys[i])->cmp_cstr(key) == 0)
            return &self->kids[i];
    return 0;
}

/* 数组取下标：越界 / 不是数组给 0 */
Json *json_at(Json *self, int i)
{
    if (!self || self->kind != JARR || !self->kids)
        return 0;
    if (i < 0 || i >= self->n)
        return 0;
    return &self->kids[i];
}

/* 容器的元素个数，其他给 0 */
int json_count(Json *self)
{
    if (!self)
        return 0;
    if (self->kind != JARR && self->kind != JOBJ)
        return 0;
    return self->n > 0 ? self->n : 0;
}

/* 对象第 i 个键，非法给空串 */
Str json_key(Json *self, int i)
{
    Str empty = { (char[:]){ (char *)0, 0 } };

    if (!self || self->kind != JOBJ || !self->keys)
        return empty;
    if (i < 0 || i >= self->n)
        return empty;
    return self->keys[i];
}

Str json_get_str(Json *self, char *key, char *def)
{
    Json *v = json_get(self, key);

    if (v && v->kind == JSTR)
        return v->s;
    return str(def);
}

f64 json_get_num(Json *self, char *key, f64 def)
{
    Json *v = json_get(self, key);

    if (v && v->kind == JNUM)
        return v->num;
    return def;
}

int json_get_bool(Json *self, char *key, int def)
{
    Json *v = json_get(self, key);

    if (v && v->kind == JBOOL)
        return v->b ? 1 : 0;
    return def;
}

/* ---- 写出 ---- */

/* 一个「可以边量边写」的小输出器：dst 为 0 时只累加长度（先量后写） */
struct Jw {
    char *dst;      /* 落笔位置；0 = 只量长度 */
    int cap;        /* dst 可写字节数（已经扣掉结尾 NUL） */
    int len;        /* 已产出字节数 */
    int over;       /* 容量不够 */
    int bad;        /* 语义失败（非法转义等） */
    int indent;     /* > 0 时按这个宽度美化输出 */
    int depth;      /* 当前缩进层数 */
};

static void jw_bytes(Jw *w, char *p, int n)
{
    if (w->over || w->bad)
        return;
    if (n < 0) {
        w->over = 1;
        return;
    }
    if (w->dst) {
        if (w->len + n > w->cap) {
            w->over = 1;
            return;
        }
        memcpy(w->dst + w->len, p, (size_t)n);
    }
    w->len += n;
}

static void jw_ch(Jw *w, char c)
{
    if (w->over || w->bad)
        return;
    if (w->dst) {
        if (w->len + 1 > w->cap) {
            w->over = 1;
            return;
        }
        w->dst[w->len] = c;
    }
    w->len++;
}

static void jw_lit(Jw *w, char *lit, int n) { jw_bytes(w, lit, n); }

/* 美化模式下的换行 + 缩进 */
static void jw_nl(Jw *w)
{
    int k = 0, n = 0;

    if (w->indent <= 0)
        return;
    jw_ch(w, '\n');
    n = w->indent * w->depth;
    for (k = 0; k < n; k++)
        jw_ch(w, ' ');
}

/* 一个码点写成 UTF-8（json_unescape 用） */
static void jw_cp(Jw *w, int cp)
{
    char tmp[4] = { 0 };
    int n = jp_utf8(tmp, cp);

    jw_bytes(w, tmp, n);
}

/* 只转义内容、不加引号：`"` `\` 与 < 0x20 的控制字符，其余字节（含 UTF-8）原样 */
static void jw_escaped(Jw *w, Str s)
{
    char *hx = (char *)"0123456789abcdef";
    int i = 0;

    if (w->over || w->bad || !s.s.data)
        return;
    for (i = 0; i < s.s.len; i++) {
        int c = (int)(u8)s.s.data[i];

        switch (c) {
        case '"':
            jw_lit(w, (char *)"\\\"", 2);
            break;
        case '\\':
            jw_lit(w, (char *)"\\\\", 2);
            break;
        case 0x08:
            jw_lit(w, (char *)"\\b", 2);
            break;
        case 0x0c:
            jw_lit(w, (char *)"\\f", 2);
            break;
        case 0x0a:
            jw_lit(w, (char *)"\\n", 2);
            break;
        case 0x0d:
            jw_lit(w, (char *)"\\r", 2);
            break;
        case 0x09:
            jw_lit(w, (char *)"\\t", 2);
            break;
        default:
            if (c < 0x20) {
                char t[6] = { 0 };

                t[0] = '\\';
                t[1] = 'u';
                t[2] = '0';
                t[3] = '0';
                t[4] = hx[(c >> 4) & 0xf];
                t[5] = hx[c & 0xf];
                jw_bytes(w, t, 6);
            } else {
                jw_ch(w, (char)c);
            }
            break;
        }
    }
}

/* json_escape 的反向：非法转义置 bad */
static void jw_unescaped(Jw *w, Str s)
{
    int i = 0;

    if (w->over || w->bad || !s.s.data)
        return;
    while (i < s.s.len) {
        int c = (int)(u8)s.s.data[i];

        if (c != '\\') {
            jw_ch(w, (char)c);
            i++;
            continue;
        }
        i++;
        if (i >= s.s.len) {
            w->bad = 1;
            return;
        }
        c = (int)(u8)s.s.data[i];
        switch (c) {
        case '"':
            jw_ch(w, '"');
            i++;
            break;
        case '\\':
            jw_ch(w, '\\');
            i++;
            break;
        case '/':
            jw_ch(w, '/');
            i++;
            break;
        case 'b':
            jw_ch(w, (char)0x08);
            i++;
            break;
        case 'f':
            jw_ch(w, (char)0x0c);
            i++;
            break;
        case 'n':
            jw_ch(w, (char)0x0a);
            i++;
            break;
        case 'r':
            jw_ch(w, (char)0x0d);
            i++;
            break;
        case 't':
            jw_ch(w, (char)0x09);
            i++;
            break;
        case 'u': {
            int cp = 0, k = 0;

            if (i + 4 >= s.s.len) {
                w->bad = 1;
                return;
            }
            for (k = 1; k <= 4; k++) {
                int h = jp_hex((int)(u8)s.s.data[i + k]);

                if (h < 0) {
                    w->bad = 1;
                    return;
                }
                cp = cp * 16 + h;
            }
            i += 5;
            if (cp >= 0xd800 && cp <= 0xdbff) {
                int lo = 0;

                if (i + 5 >= s.s.len || s.s.data[i] != '\\'
                    || s.s.data[i + 1] != 'u') {
                    w->bad = 1;
                    return;
                }
                for (k = 0; k < 4; k++) {
                    int h = jp_hex((int)(u8)s.s.data[i + 2 + k]);

                    if (h < 0) {
                        w->bad = 1;
                        return;
                    }
                    lo = lo * 16 + h;
                }
                if (lo < 0xdc00 || lo > 0xdfff) {
                    w->bad = 1;
                    return;
                }
                i += 6;
                cp = 0x10000 + ((cp - 0xd800) << 10) + (lo - 0xdc00);
            } else if (cp >= 0xdc00 && cp <= 0xdfff) {
                w->bad = 1;
                return;
            }
            jw_cp(w, cp);
            break;
        }
        default:
            w->bad = 1;
            return;
        }
    }
}

/* 十进制指数：|x| 落在 [10^e, 10^(e+1))；x 为 0 给 0（调用方不喂 inf/nan） */
static int json_dec_exp(f64 x)
{
    f64 a = x < 0.0 ? -x : x;
    int e = 0;

    if (!(a > 0.0))
        return 0;
    while (a >= 10.0) {
        a /= 10.0;
        e++;
    }
    while (a < 1.0) {
        a *= 10.0;
        e--;
    }
    return e;
}

/* 这段文本是不是合法 JSON 数字（fmt_f64_g 输出的兜底检查） */
static int json_num_valid(char *s, int n)
{
    int i = 0;

    if (i < n && s[i] == '-')
        i++;
    if (i >= n)
        return 0;
    if (s[i] == '0') {
        i++;
    } else if (s[i] >= '1' && s[i] <= '9') {
        while (i < n && jp_digit((int)(u8)s[i]))
            i++;
    } else {
        return 0;
    }
    if (i < n && s[i] == '.') {
        i++;
        if (i >= n || !jp_digit((int)(u8)s[i]))
            return 0;
        while (i < n && jp_digit((int)(u8)s[i]))
            i++;
    }
    if (i < n && (s[i] == 'e' || s[i] == 'E')) {
        i++;
        if (i < n && (s[i] == '+' || s[i] == '-'))
            i++;
        if (i >= n || !jp_digit((int)(u8)s[i]))
            return 0;
        while (i < n && jp_digit((int)(u8)s[i]))
            i++;
    }
    return i == n;
}

/* 数字：有原文用原文（保真），否则现算；非有限数写 null。
   现算这条路上 `fmt_f64_g` 的定点分支内部只有 12 字节的小数位缓冲，
   所以有效位数按十进制指数收敛（`e + 11`，最多 17 位）：e >= -4 时小数位
   不超过 11，既拿到当前实现能给出的最多位数字，也不会写到缓冲区外面。 */
static void jw_number(Jw *w, Json *v)
{
    char tmp[48] = { 0 };
    int n = 0, sig = 0;

    if (v->raw.s.data && v->raw.s.len > 0) {
        jw_bytes(w, v->raw.s.data, v->raw.s.len);
        return;
    }
    if (f64_is_nan(v->num) || f64_is_inf(v->num)) {
        jw_lit(w, (char *)"null", 4);   /* JSON 没有 inf/nan */
        return;
    }
    sig = json_dec_exp(v->num) + 11;
    if (sig > 17)
        sig = 17;
    if (sig < 1)
        sig = 1;
    n = fmt_f64_g(v->num, tmp, (int)sizeof tmp, sig);
    if (n <= 0 || !json_num_valid(tmp, n)) {
        jw_lit(w, (char *)"0", 1);   /* 兜底：宁可给 0，也不写出非法 JSON */
        return;
    }
    jw_bytes(w, tmp, n);
}

static void jw_value(Jw *w, Json *v)
{
    int i = 0;

    if (w->over || w->bad)
        return;
    if (!v) {
        jw_lit(w, (char *)"null", 4);
        return;
    }
    switch (v->kind) {
    case JNULL:
        jw_lit(w, (char *)"null", 4);
        break;
    case JBOOL:
        if (v->b)
            jw_lit(w, (char *)"true", 4);
        else
            jw_lit(w, (char *)"false", 5);
        break;
    case JNUM:
        jw_number(w, v);
        break;
    case JSTR:
        jw_ch(w, '"');
        jw_escaped(w, v->s);
        jw_ch(w, '"');
        break;
    case JARR:
        jw_ch(w, '[');
        w->depth++;
        for (i = 0; i < v->n; i++) {
            if (i > 0)
                jw_ch(w, ',');
            jw_nl(w);
            jw_value(w, v->kids ? &v->kids[i] : 0);
        }
        w->depth--;
        if (v->n > 0)
            jw_nl(w);
        jw_ch(w, ']');
        break;
    case JOBJ:
        jw_ch(w, '{');
        w->depth++;
        for (i = 0; i < v->n; i++) {
            if (i > 0)
                jw_ch(w, ',');
            jw_nl(w);
            jw_ch(w, '"');
            if (v->keys)
                jw_escaped(w, v->keys[i]);
            jw_ch(w, '"');
            jw_ch(w, ':');
            if (w->indent > 0)
                jw_ch(w, ' ');
            jw_value(w, v->kids ? &v->kids[i] : 0);
        }
        w->depth--;
        if (v->n > 0)
            jw_nl(w);
        jw_ch(w, '}');
        break;
    default:
        jw_lit(w, (char *)"null", 4);
        break;
    }
}

/* 先量长度、容量够才落笔：装不下返回 -1 且一个字节都不写 */
static int jw_render(Json *self, char *dst, int cap, int indent)
{
    Jw m = { 0 };
    Jw w = { 0 };

    if (!dst || cap <= 0)
        return -1;
    m.indent = indent;
    jw_value(&m, self);
    if (m.over || m.bad || m.len < 0)
        return -1;
    if (m.len + 1 > cap)
        return -1;
    w.dst = dst;
    w.cap = cap - 1;
    w.indent = indent;
    jw_value(&w, self);
    if (w.over || w.bad)
        return -1;
    dst[w.len] = 0;
    return w.len;
}

/* 紧凑输出：返回字节数（不含 NUL），放不下 -1 */
int json_write(Json *self, char *dst, int cap)
{
    return jw_render(self, dst, cap, 0);
}

/* 美化输出：每层缩进 indent 个空格，indent <= 0 当 2 */
int json_write_pretty(Json *self, char *dst, int cap, int indent)
{
    return jw_render(self, dst, cap, indent > 0 ? indent : 2);
}

/* 只转义内容、不加引号；结果 NUL 结尾，返回字节数（不含 NUL），放不下 -1 */
int json_escape(Str s, char *dst, int cap)
{
    Jw m = { 0 };
    Jw w = { 0 };

    if (!dst || cap <= 0)
        return -1;
    jw_escaped(&m, s);
    if (m.over || m.bad || m.len + 1 > cap)
        return -1;
    w.dst = dst;
    w.cap = cap - 1;
    jw_escaped(&w, s);
    if (w.over || w.bad)
        return -1;
    dst[w.len] = 0;
    return w.len;
}

/* json_escape 的反向：非法转义 / 容量不够都给 -1 */
int json_unescape(Str s, char *dst, int cap)
{
    Jw m = { 0 };
    Jw w = { 0 };

    if (!dst || cap <= 0)
        return -1;
    jw_unescaped(&m, s);
    if (m.bad || m.over || m.len + 1 > cap)
        return -1;
    w.dst = dst;
    w.cap = cap - 1;
    jw_unescaped(&w, s);
    if (w.over || w.bad)
        return -1;
    dst[w.len] = 0;
    return w.len;
}

/* ---- 自测 ---- */

test "解析基本对象、数组与嵌套" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    Json doc = try json_parse(pa, SS("{\"a\":1,\"b\":[true,false,null],\"c\":{\"d\":\"x\"}}"));
    Json *p = &doc;

    if (doc.kind != JOBJ || json_count(p) != 3)
        return err(1, "顶层应当是有 3 个键的对象");
    if (json_get_num(p, "a", -1.0) != 1.0)
        return err(2, "a 不是 1");
    if (json_get_bool(p, "a", 0) != 0 || json_get_bool(p, "b", 0) != 0)
        return err(3, "非 bool 不该当 true");
    {
        Json *arr = json_get(p, "b");

        if (!arr || arr->kind != JARR || json_count(arr) != 3)
            return err(4, "b 应当是 3 元素数组");
        if (!json_at(arr, 0) || json_at(arr, 0)->kind != JBOOL
            || json_at(arr, 0)->b != 1)
            return err(5, "b[0] 应当是 true");
        if (json_at(arr, 1)->kind != JBOOL || json_at(arr, 1)->b != 0)
            return err(6, "b[1] 应当是 false");
        if (json_at(arr, 2)->kind != JNULL)
            return err(7, "b[2] 应当是 null");
        if (json_at(arr, 3) != 0 || json_at(arr, -1) != 0)
            return err(8, "数组越界应当给 0");
    }
    {
        Json *c = json_get(p, "c");
        Str s = json_get_str(c, "d", "?");

        if (s.s.len != 1 || s.s.data[0] != 'x')
            return err(9, "c.d 不是 \"x\"");
        if (json_count(c) != 1)
            return err(10, "c 应当有 1 个键");
        if (json_key(c, 0).s.len != 1 || json_key(c, 0).s.data[0] != 'd')
            return err(11, "c 的第一个键不是 d");
    }
    if (json_get(p, "nope") != 0)
        return err(12, "缺失的键应当给 0");
    if (json_get(p, 0) != 0)
        return err(13, "key 为 0 应当给 0");
}

test "顶层可以是任意值，空白只认四种" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;

    {
        Json d = try json_parse(pa, SS("42"));

        if (d.kind != JNUM || d.num != 42.0)
            return err(20, "顶层裸数字不对");
    }
    {
        Json d = try json_parse(pa, SS(" \"x\" "));

        if (d.kind != JSTR || d.s.s.len != 1 || d.s.s.data[0] != 'x')
            return err(21, "顶层裸字符串不对");
    }
    {
        Json d = try json_parse(pa, SS("null"));

        if (d.kind != JNULL)
            return err(22, "顶层 null 不对");
    }
    {
        Json d = try json_parse(pa, SS("\ttrue\r\n"));

        if (d.kind != JBOOL || d.b != 1)
            return err(23, "顶层 true 不对");
    }
    {
        Json d = try json_parse(pa, SS(" { \"a\" : [ 1 , 2 ] } "));
        Json *arr = json_get(&d, "a");

        if (!arr || json_count(arr) != 2 || json_at(arr, 1)->num != 2.0)
            return err(24, "空白容忍不对");
    }
}

test "解析开头允许一个 UTF-8 BOM" {
    u8 buf[1024] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    char bom_obj[8] = { (char)0xef, (char)0xbb, (char)0xbf, '{', '}', 0 };
    char bom_arr[8] = { (char)0xef, (char)0xbb, (char)0xbf, '[', '1', ']', 0 };
    char bom_only[4] = { (char)0xef, (char)0xbb, (char)0xbf, 0 };
    int id = 0;

    {
        Json d = try json_parse(pa, (Str){ (char[:]){ bom_obj, 5 } });

        if (d.kind != JOBJ || json_count(&d) != 0)
            return err(25, "带 BOM 的空对象解析不对");
    }
    {
        Json d = try json_parse(pa, (Str){ (char[:]){ bom_arr, 6 } });

        if (d.kind != JARR || json_count(&d) != 1)
            return err(26, "带 BOM 的数组解析不对");
    }
    json_parse(pa, (Str){ (char[:]){ bom_only, 3 } }) catch e {
        id = e.id;
        goto bom_is_inval;
    };
    return err(27, "只有 BOM 的输入没有报错");
bom_is_inval:
    if (id != INVAL)
        return err(28, "只有 BOM 的输入不应该是 PARSE");
}

test "数字：raw 保真与解析值" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    Json doc = try json_parse(pa, SS("[0,-0,1.5,-2.25e3,1e-2,9007199254740993]"));
    Json *p = &doc;
    char out[128] = { 0 };
    int n = 0;

    if (json_count(p) != 6)
        return err(30, "应当是 6 个数字");
    if (json_at(p, 0)->num != 0.0 || json_at(p, 2)->num != 1.5)
        return err(31, "0 / 1.5 解出来不对");
    if (json_at(p, 3)->num != -2250.0 || json_at(p, 4)->num != 0.01)
        return err(32, "-2.25e3 / 1e-2 解出来不对");
    if (json_at(p, 5)->raw.s.len != 16)
        return err(33, "大整数的原文长度不对");
    n = json_write(p, out, sizeof out);
    if (n != 40 || (int)strlen(out) != n)
        return err(34, "写出的长度不对");
    if (strcmp(out, "[0,-0,1.5,-2.25e3,1e-2,9007199254740993]") != 0)
        return err(35, "数字没有按原文写出");
}

test "数字文法：逐条拒绝非法写法" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    char *bad[9] = { (char *)"01", (char *)"+1", (char *)".5", (char *)"1.",
                     (char *)"1e", (char *)"nan", (char *)"inf", (char *)"-",
                     (char *)"1.2.3" };
    int i = 0;

    for (i = 0; i < 9; i++) {
        int id = 0;

        json_parse(pa, str(bad[i])) catch e {
            id = e.id;
            goto next;
        };
        return err(40 + i, "非法数字没有报错");
next:
        if (id != PARSE)
            return err(60 + i, "非法数字的错误码不是 PARSE");
        pa->reset();
    }
    /* 数组里同样拒绝 */
    {
        int id = 0;

        json_parse(pa, SS("[01]")) catch e {
            id = e.id;
            goto in_arr;
        };
        return err(70, "[01] 没有报错");
in_arr:
        if (id != PARSE)
            return err(71, "[01] 的错误码不是 PARSE");
    }
}

test "字符串转义解码（含 \\u 与代理对）" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    Json doc = try json_parse(pa,
        SS("[\"a\\\"b\\\\c\\/d\\b\\f\\n\\r\\t\",\"\\u4e2d\\u6587\",\"\\ud83d\\ude00\"]"));
    char want[12] = { 'a', '"', 'b', '\\', 'c', '/', 'd', 8, 12, 10, 13, 9 };
    char zh[6] = { (char)0xe4, (char)0xb8, (char)0xad,
                   (char)0xe6, (char)0x96, (char)0x87 };
    char emoji[4] = { (char)0xf0, (char)0x9f, (char)0x98, (char)0x80 };

    if (json_count(&doc) != 3)
        return err(80, "应当是 3 个字符串");
    if (json_at(&doc, 0)->s.s.len != 12
        || memcmp(json_at(&doc, 0)->s.s.data, want, 12) != 0)
        return err(81, "短转义解码不对");
    if (json_at(&doc, 1)->s.s.len != 6
        || memcmp(json_at(&doc, 1)->s.s.data, zh, 6) != 0)
        return err(82, "\\u4e2d\\u6587 没有解成 UTF-8");
    if (json_at(&doc, 2)->s.s.len != 4
        || memcmp(json_at(&doc, 2)->s.s.data, emoji, 4) != 0)
        return err(83, "代理对没有合并成 F0 9F 98 80");
    /* 解码后的字符串在 arena 里、结尾有 NUL */
    if (json_at(&doc, 2)->s.s.data[4] != 0)
        return err(84, "解码后的字符串没有 NUL 结尾");
}

test "未转义控制字符、非法转义与落单代理都报 PARSE" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    char ctl[4] = { '"', 'a', 1, '"' };
    char *bad[5] = { (char *)"[\"\\ud83d\"]", (char *)"[\"\\udc00\"]",
                     (char *)"[\"\\q\"]", (char *)"[\"\\u12\"]",
                     (char *)"[\"a\\\"]" };
    int id = 0, i = 0;

    json_parse(pa, (Str){ (char[:]){ ctl, 3 } }) catch e {
        id = e.id;
        goto ctl_done;
    };
    return err(90, "未转义的控制字符没有报错");
ctl_done:
    if (id != PARSE)
        return err(91, "控制字符的错误码不是 PARSE");

    for (i = 0; i < 5; i++) {
        int id2 = 0;

        json_parse(pa, str(bad[i])) catch e {
            id2 = e.id;
            goto next;
        };
        return err(92 + i, "非法转义没有报错");
next:
        if (id2 != PARSE)
            return err(100 + i, "非法转义的错误码不是 PARSE");
        pa->reset();
    }
}

test "未闭合、尾随垃圾与空输入" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    char *bad[7] = { (char *)"{\"a\":1", (char *)"[1,2", (char *)"\"abc",
                     (char *)"123 x", (char *)"{}x", (char *)"[1,]",
                     (char *)"{\"a\"}" };
    char *empty[3] = { (char *)"", (char *)"   ", (char *)"\t\r\n " };
    int i = 0;

    for (i = 0; i < 3; i++) {
        int id2 = 0;

        json_parse(pa, str(empty[i])) catch e {
            id2 = e.id;
            goto empty_done;
        };
        return err(110 + i, "空输入没有报错");
empty_done:
        if (id2 != INVAL)
            return err(115 + i, "空输入的错误码不是 INVAL");
    }
    for (i = 0; i < 7; i++) {
        int id2 = 0;

        json_parse(pa, str(bad[i])) catch e {
            id2 = e.id;
            goto bad_done;
        };
        return err(120 + i, "坏输入没有报错");
bad_done:
        if (id2 != PARSE)
            return err(130 + i, "坏输入的错误码不是 PARSE");
        pa->reset();
    }
    /* 未转义的 NUL 字节是控制字符 */
    {
        char raw[5] = { '"', 'a', 0, 'b', '"' };
        int id3 = 0;

        json_parse(pa, (Str){ (char[:]){ raw, 5 } }) catch e {
            id3 = e.id;
            goto nul_done;
        };
        return err(140, "字符串里的 NUL 没有报错");
nul_done:
        if (id3 != PARSE)
            return err(141, "NUL 的错误码不是 PARSE");
    }
}

test "json_parse_at 给出出错字节偏移" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    int pos = -99, id = 0;

    json_parse_at(pa, SS("{\"a\":1,}"), &pos) catch e {
        id = e.id;
        goto trailing_comma;
    };
    return err(150, "拖尾逗号没有报错");
trailing_comma:
    if (id != PARSE)
        return err(151, "拖尾逗号的错误码不是 PARSE");
    if (pos != 7)
        return err(152, "拖尾逗号的出错偏移不对");

    pos = -99;
    json_parse_at(pa, SS("[1 2]"), &pos) catch e {
        id = e.id;
        goto missing_comma;
    };
    return err(153, "缺逗号没有报错");
missing_comma:
    if (id != PARSE || pos != 3)
        return err(154, "缺逗号的出错偏移不对");

    pos = -99;
    {
        Json d = try json_parse_at(pa, SS(" [1] "), &pos);

        if (pos != -1 || d.kind != JARR)
            return err(155, "成功时 err_pos 应当给 -1");
    }
    /* err_pos 可以为 0 */
    json_parse_at(pa, SS("x"), 0) catch e {
        id = e.id;
        goto no_pos;
    };
    return err(156, "非法值没有报错");
no_pos:
    if (id != PARSE)
        return err(157, "非法值的错误码不是 PARSE");
}

test "嵌套深度上限 64：64 层可以，65 层报 RANGE" {
    u8 buf[16384] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    char text[160] = { 0 };
    int i = 0, id = 0;

    for (i = 0; i < 64; i++)
        text[i] = '[';
    for (i = 0; i < 64; i++)
        text[64 + i] = ']';
    {
        Json d = try json_parse(pa, (Str){ (char[:]){ text, 128 } });
        Json *p = &d;

        for (i = 0; i < 63; i++) {
            p = json_at(p, 0);
            if (!p)
                return err(160, "64 层解析出来的结构不对");
        }
        if (json_count(p) != 0)
            return err(161, "最里层应当是空数组");
    }
    pa->reset();
    text[64] = '[';
    for (i = 0; i < 65; i++)
        text[65 + i] = ']';
    json_parse(pa, (Str){ (char[:]){ text, 130 } }) catch e {
        id = e.id;
        goto too_deep;
    };
    return err(162, "65 层没有报错");
too_deep:
    if (id != RANGE)
        return err(163, "65 层的错误码不是 RANGE");
}

test "arena 不够给 NOMEM，arena 为空给 INVAL" {
    u8 tiny[8] = { 0 };
    Arena a = arena_make(tiny, sizeof tiny);
    int id = 0;

    json_parse(&a, SS("{\"a\":1}")) catch e {
        id = e.id;
        goto obj_nomem;
    };
    return err(170, "小 arena 解析对象没有报错");
obj_nomem:
    if (id != NOMEM)
        return err(171, "对象放不下的错误码不是 NOMEM");

    id = 0;
    json_parse(&a, SS("\"aaaaaaaaaaaaaaaaaaaa\"")) catch e {
        id = e.id;
        goto str_nomem;
    };
    return err(172, "小 arena 解析长字符串没有报错");
str_nomem:
    if (id != NOMEM)
        return err(173, "字符串放不下的错误码不是 NOMEM");

    id = 0;
    json_parse(0, SS("{}")) catch e {
        id = e.id;
        goto no_arena;
    };
    return err(174, "空 arena 没有报错");
no_arena:
    if (id != INVAL)
        return err(175, "空 arena 的错误码不是 INVAL");
}

test "json_write：紧凑输出与容量不足一个字节都不写" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    Json doc = try json_parse(pa, SS("{\"a\":[1,2],\"b\":{\"c\":\"x y\"}}"));
    char out[128] = { 0 };
    int n = 0;

    n = json_write(&doc, out, sizeof out);
    if (n != 27 || (int)strlen(out) != n)
        return err(180, "紧凑输出的长度不对");
    if (strcmp(out, "{\"a\":[1,2],\"b\":{\"c\":\"x y\"}}") != 0)
        return err(181, "紧凑输出的内容不对");

    /* 正好少一个字节（放不下 NUL）：-1 且缓冲区原样 */
    {
        char small[128] = { 0 };

        small[0] = 'Z';
        small[1] = 'Z';
        if (json_write(&doc, small, n) != -1)
            return err(182, "cap 不够应当返回 -1");
        if (small[0] != 'Z' || small[1] != 'Z')
            return err(183, "cap 不够时动了缓冲区");
        if (json_write(&doc, small, 1) != -1)
            return err(184, "cap 1 应当返回 -1");
        if (small[0] != 'Z')
            return err(185, "cap 1 时动了缓冲区");
    }
    if (json_write(&doc, 0, 128) != -1)
        return err(186, "dst 为 0 应当给 -1");
    if (json_write(&doc, out, 0) != -1 || json_write(&doc, out, -5) != -1)
        return err(187, "cap <= 0 应当给 -1");
    /* self 为 0 写 null，不崩 */
    if (json_write(0, out, sizeof out) != 4 || strcmp(out, "null") != 0)
        return err(188, "self 为 0 应当写 null");
    /* 手写的容器（kids 为空指针）也不崩 */
    {
        Json fake = { 0 };

        fake.kind = JARR;
        if (json_write(&fake, out, sizeof out) != 2 || strcmp(out, "[]") != 0)
            return err(189, "空数组应当写 []");
        fake.kind = JOBJ;
        if (json_write(&fake, out, sizeof out) != 2 || strcmp(out, "{}") != 0)
            return err(190, "空对象应当写 {}");
    }
}

test "json_write_pretty：缩进与固定小 cap" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    Json doc = try json_parse(pa, SS("{\"a\":[1,2],\"b\":\"x\"}"));
    char out[256] = { 0 };
    char out2[256] = { 0 };
    char want[128] = { 0 };
    int n = 0, n2 = 0;

    n = json_write_pretty(&doc, out, sizeof out, 2);
    memcpy(want, "{\n  \"a\": [\n    1,\n    2\n  ],\n  \"b\": \"x\"\n}",
           strlen("{\n  \"a\": [\n    1,\n    2\n  ],\n  \"b\": \"x\"\n}") + 1);
    if (n != (int)strlen(want))
        return err(200, "pretty 输出的长度不对");
    if (strcmp(out, want) != 0)
        return err(201, "pretty 输出的内容不对");
    /* indent <= 0 当 2 */
    n2 = json_write_pretty(&doc, out2, sizeof out2, 0);
    if (n2 != n || strcmp(out, out2) != 0)
        return err(202, "indent <= 0 没有按 2 处理");
    if (json_write_pretty(&doc, out2, sizeof out2, -3) != n)
        return err(203, "indent 为负没有按 2 处理");
    /* 固定小 cap：-1 且一个字节都不写 */
    {
        char small[8] = { 0 };

        small[0] = 'Q';
        if (json_write_pretty(&doc, small, sizeof small, 2) != -1)
            return err(204, "pretty 小 cap 应当返回 -1");
        if (small[0] != 'Q')
            return err(205, "pretty 小 cap 动了缓冲区");
    }
    /* 空容器的 pretty 不产生多余换行 */
    {
        Json empty = try json_parse(pa, SS("[[],{}]"));

        n = json_write_pretty(&empty, out, sizeof out, 4);
        if (n != 18 || strcmp(out, "[\n    [],\n    {}\n]") != 0)
            return err(206, "空容器的 pretty 不对");
    }
}

test "json_get / json_at / json_count / json_key 的缺失与类型不符" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    Json doc = try json_parse(pa,
        SS("{\"s\":\"v\",\"n\":3.5,\"b\":true,\"arr\":[10,20],\"o\":{}}"));
    Json *p = &doc;

    if (json_get(json_get(p, "arr"), "x") != 0)
        return err(210, "对数组取键应当给 0");
    if (json_at(p, 0) != 0)
        return err(211, "对对象取下标应当给 0");
    if (json_count(json_get(p, "s")) != 0)
        return err(212, "字符串的元素个数应当是 0");
    if (json_count(0) != 0 || json_at(0, 0) != 0 || json_get(0, "a") != 0)
        return err(213, "self 为 0 应当给 0");
    if (json_key(p, 99).s.len != 0 || json_key(p, -1).s.len != 0)
        return err(214, "越界的键应当给空串");
    if (json_key(json_get(p, "arr"), 0).s.len != 0)
        return err(215, "对数组取键名应当给空串");
    if (json_key(p, 0).s.len != 1 || json_key(p, 4).s.data[0] != 'o')
        return err(216, "键的顺序不对");
    /* 类型不符给默认值 */
    if (json_get_num(p, "s", 7.0) != 7.0)
        return err(217, "字符串取数字应当给默认值");
    if (json_get_num(p, "nope", -2.5) != -2.5)
        return err(218, "缺失键取数字应当给默认值");
    if (json_get_bool(p, "n", 1) != 1 || json_get_bool(p, "b", 0) != 1)
        return err(219, "取 bool 不对");
    if (json_get_str(p, "n", "d").s.len != 1)
        return err(220, "非字符串取字符串应当给默认值");
    if (json_get_num(0, "x", 9.0) != 9.0)
        return err(221, "self 为 0 取数字应当给默认值");
    if (json_get_str(0, "x", "dd").s.len != 2)
        return err(222, "self 为 0 取字符串应当给默认值");
    if (json_get_str(p, "zz", 0).s.len != 0)
        return err(223, "默认值为 0 时应当给空串");
    if (json_get_bool(p, "b", 0) != 1 || json_get_bool(p, "o", 3) != 3)
        return err(224, "取 bool 的默认值不对");
}

test "重复键全部保留，json_get 取最后一个" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    Json doc = try json_parse(pa, SS("{\"k\":1,\"k\":2,\"j\":3}"));
    Json *last = json_get(&doc, "k");

    if (json_count(&doc) != 3)
        return err(230, "重复键应当全部保留");
    if (!last || last->num != 2.0)
        return err(231, "重复键应当取最后一个");
    if (doc.kids[0].num != 1.0 || doc.kids[1].num != 2.0)
        return err(232, "两个同名键的顺序不对");
    if (json_key(&doc, 0).s.data[0] != 'k' || json_key(&doc, 2).s.data[0] != 'j')
        return err(233, "重复键的键名顺序不对");
}

test "数字：手写节点的写出仍然是合法 JSON" {
    u8 buf[4096] = { 0 };
    Arena a = arena_make(buf, sizeof buf);
    Arena *pa = &a;
    Json v = { 0 };
    char out[64] = { 0 };
    f64 inf = 1.0e308;

    v.kind = JNUM;
    v.num = 1.5;
    if (json_write(&v, out, sizeof out) != 3 || strcmp(out, "1.5") != 0)
        return err(240, "手写的 1.5 写出不对");

    /* 不能精确表示的数值：写出来的位数受 fmt_f64_g 限制，要求相对误差很小 */
    v.num = 1.0 / 3.0;
    if (json_write(&v, out, sizeof out) <= 0)
        return err(241, "1/3 写出失败");
    {
        Json back = try json_parse(pa, str(out));
        f64 got = back.num;

        if (back.kind != JNUM || back.raw.s.len != (int)strlen(out))
            return err(242, "1/3 写出后解析不回来");
        if (got < 0.0)
            got = -got;
        got = got - 1.0 / 3.0;
        if (got > 1.0e-9 || got < -1.0e-9)
            return err(243, "1/3 写出后的精度太差");
    }
    /* 能精确表示的：必须逐位保真 */
    {
        f64 exact[4] = { 1.5, 0.25, -0.5e-6, 1234.5 };
        int i = 0;

        for (i = 0; i < 4; i++) {
            Json back = { 0 };

            v.num = exact[i];
            if (json_write(&v, out, sizeof out) <= 0)
                return err(244, "精确值写出失败");
            back = try json_parse(pa, str(out));
            if (back.kind != JNUM || back.num != exact[i])
                return err(245, "精确值写出后解析不回来");
        }
    }
    /* 非有限数：JSON 没有表示，写 null */
    inf = inf * 10.0;
    v.num = inf;
    if (json_write(&v, out, sizeof out) != 4 || strcmp(out, "null") != 0)
        return err(246, "inf 应当写成 null");
    v.num = inf - inf;   /* inf - inf 是 nan */
    if (json_write(&v, out, sizeof out) != 4 || strcmp(out, "null") != 0)
        return err(247, "nan 应当写成 null");
    /* 字符串节点按 JSON 要求转义 */
    v.kind = JSTR;
    v.s = SS("a\"b\\c\nd");
    if (json_write(&v, out, sizeof out) != 12
        || strcmp(out, "\"a\\\"b\\\\c\\nd\"") != 0)
        return err(248, "字符串节点的转义不对");
}

test "json_escape / json_unescape 往返" {
    Str src = str((char *)"a\"b\\c\nd\te\xe4\xb8\xad");
    char esc[64] = { 0 };
    char back[64] = { 0 };
    int n = 0, m = 0;

    n = json_escape(src, esc, sizeof esc);
    if (n != 16)
        return err(250, "转义后的长度不对");
    if (strcmp(esc, "a\\\"b\\\\c\\nd\\te\xe4\xb8\xad") != 0)
        return err(251, "转义后的内容不对");
    m = json_unescape(str(esc), back, sizeof back);
    if (m != src.s.len || memcmp(back, src.s.data, src.s.len) != 0)
        return err(252, "转义再解回来和原文不一样");
    /* 控制字符补成 \u00XX */
    {
        char one[2] = { 1, 2 };
        char e2[16] = { 0 };

        if (json_escape((Str){ (char[:]){ one, 2 } }, e2, sizeof e2) != 12)
            return err(253, "控制字符转义后的长度不对");
        if (strcmp(e2, "\\u0001\\u0002") != 0)
            return err(254, "控制字符转义后的内容不对");
        if (json_unescape(str(e2), back, sizeof back) != 2
            || back[0] != 1 || back[1] != 2)
            return err(255, "\\u0001 解不回来");
    }
    /* \u 与代理对都能解 */
    {
        char zh[8] = { 0 };

        if (json_unescape(str((char *)"\\u4e2d"), zh, sizeof zh) != 3
            || memcmp(zh, "\xe4\xb8\xad", 3) != 0)
            return err(256, "\\u4e2d 解不成 UTF-8");
        if (json_unescape(str((char *)"\\ud83d\\ude00"), zh, sizeof zh) != 4
            || memcmp(zh, "\xf0\x9f\x98\x80", 4) != 0)
            return err(257, "代理对没有合并");
    }
    /* 非法转义与容量不够都给 -1，且不留半截 */
    if (json_unescape(str((char *)"\\q"), back, sizeof back) != -1)
        return err(258, "\\q 应当给 -1");
    if (json_unescape(str((char *)"\\ud83d"), back, sizeof back) != -1)
        return err(259, "落单高位代理应当给 -1");
    if (json_unescape(str((char *)"\\udc00"), back, sizeof back) != -1)
        return err(260, "落单低位代理应当给 -1");
    if (json_unescape(str((char *)"\\u12"), back, sizeof back) != -1)
        return err(261, "\\u12 应当给 -1");
    if (json_unescape(str((char *)"ab\\"), back, sizeof back) != -1)
        return err(262, "末尾反斜杠应当给 -1");
    {
        char tiny[4] = { 0 };

        tiny[0] = 'W';
        if (json_unescape(str((char *)"abcdef"), tiny, sizeof tiny) != -1)
            return err(263, "容量不够应当给 -1");
        if (tiny[0] != 'W')
            return err(264, "容量不够时动了缓冲区");
        if (json_escape(src, tiny, 3) != -1)
            return err(265, "escape 容量不够应当给 -1");
        if (json_escape(src, 0, 64) != -1 || json_escape(src, esc, 0) != -1)
            return err(266, "dst/cap 非法应当给 -1");
        if (json_unescape(src, 0, 64) != -1 || json_unescape(src, back, 0) != -1)
            return err(267, "dst/cap 非法应当给 -1");
        if (json_escape((Str){ (char[:]){ (char *)0, 0 } }, back, sizeof back) != 0
            || back[0] != 0)
            return err(268, "空串转义应当给 0");
        if (json_unescape((Str){ (char[:]){ (char *)0, 0 } }, back, sizeof back) != 0
            || back[0] != 0)
            return err(269, "空串反解应当给 0");
    }
    /* 解析里的 raw 与输入是同一段内存（视图，不复制） */
    {
        char *text = (char *)"[12345]";

        u8 rbuf[1024] = { 0 };
        Arena ra = arena_make(rbuf, sizeof rbuf);
        Json d = try json_parse(&ra, str(text));
        Str raw = json_at(&d, 0)->raw;

        if (raw.s.data != text + 1 || raw.s.len != 5)
            return err(270, "raw 不是输入的视图");
    }
}
