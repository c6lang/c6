@@ -85,10 +85,26 @@ SUPERC_TESTS = $(patsubst %.c,%.test,$(sort $(notdir $(wildcard $(SRC)/1??_super
 SUPERC_OK := $(shell echo | $(TCC_LOCAL) -std=tcc-ext -dD -E - 2>/dev/null | grep -q __TCC_EXT__ && echo yes)
 ifneq (,$(SUPERC_OK))
  $(SUPERC_TESTS): FLAGS += -std=tcc-ext
+ # gcc cannot build them, so their .expect files come from tcc itself
+ $(SUPERC_TESTS): GEN = $(GEN-TCC)
  158_superc_test.test: FLAGS += -test
  162_superc_iface_errors.test: FLAGS += -dt
  164_superc_try_errors.test: FLAGS += -dt
  165_superc_init.test: FLAGS += -dt
+ 167_superc_pkg_dot_errors.test: FLAGS += -dt
+ 170_superc_method_errors.test: FLAGS += -dt
+ # these compile a second file before '-run'
+ 168_superc_pkg_dot_tu.test: FLAGS += $(subst 168,168+,$1)
+ 168_superc_pkg_dot_tu.test: GEN = $(GEN-TCC)
+ 171_superc_method_tu.test: FLAGS += $(subst 171,171+,$1)
+ 171_superc_method_tu.test: GEN = $(GEN-TCC)
+ # 172 mixes an extension unit with a unit built for plain C
+ 172_superc_plain_interop.test: NORUN = true
+ 172_superc_plain_interop.test: GEN = $(GEN-TCC)
+ 172_superc_plain_interop.test: T1 = \
+     $(TCC) -std=tcc-ext -c $(SRC)/172_superc_plain_interop.c -o $*-ext.o && \
+     $(TCC) -c $(SRC)/172+_superc_plain_interop.c -o $*-plain.o && \
+     $(TCC) $*-ext.o $*-plain.o -o $*.exe && ./$*.exe
 else
  SKIP += $(SUPERC_TESTS)
 endif
