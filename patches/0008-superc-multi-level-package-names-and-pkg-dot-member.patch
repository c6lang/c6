@@ -7354,7 +7432,7 @@ static void block_cleanup(struct scope *o)
 
 static int superc_mangle_tok(const char *pkg, int v)
 {
-    char buf[192];
+    char buf[512];
     const char *name = get_tok_str(v, NULL);
     if (strlen(pkg) + strlen(name) + 3 > sizeof(buf))
         tcc_error("package symbol name too long");
@@ -7362,6 +7440,48 @@ static int superc_mangle_tok(const char *pkg, int v)
     return tok_alloc_const(buf);
 }
 
+/* Parse 'ident ( "." ident )*' and return the package prefix: the dotted
+   spelling is purely a name separator, so 'acme.util' becomes
+   "acme__util".  Nothing here looks at directories or files. */
+static char *superc_pkg_name(int *ptok)
+{
+    char buf[128];
+    int n;
+
+    if (*ptok < TOK_UIDENT)
+        expect("package name");
+    n = snprintf(buf, sizeof buf, "%s", get_tok_str(*ptok, NULL));
+    if (n >= (int)sizeof buf)
+        tcc_error("package name too long");
+    next();
+    while (*ptok == '.') {
+        next();
+        if (*ptok < TOK_UIDENT)
+            tcc_error("package name expected after '.'");
+        n += snprintf(buf + n, sizeof buf - n, "__%s",
+                      get_tok_str(*ptok, NULL));
+        if (n >= (int)sizeof buf)
+            tcc_error("package name too long");
+        next();
+    }
+    return tcc_strdup(buf);
+}
+
+/* 'pkg.member' is only allowed for a package that was imported, or for the
+   package the code currently sits in */
+static int superc_pkg_imported(const char *name)
+{
+    int i;
+
+    if (tcc_state->superc_package
+        && !strcmp(tcc_state->superc_package, name))
+        return 1;
+    for (i = 0; i < tcc_state->superc_nb_imports; i++)
+        if (!strcmp(tcc_state->superc_imports[i], name))
+            return 1;
+    return 0;
+}
+
 /* resolve V as a member of the current package or of an imported package */
 static Sym *superc_import_lookup(int v)
 {
@@ -7386,14 +7506,19 @@ static Sym *superc_import_lookup(int v)
     return NULL;
 }
 
