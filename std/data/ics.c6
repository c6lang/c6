/* std/data/ics：iCalendar（RFC 5545）的 VEVENT 读取器（零分配，两段式）。
 *
 *     import std.data.ics;
 *
 *     char flat[8192];
 *     int fn = ics_unfold(data, n, flat, (int)sizeof flat);
 *     IcsReader r = ics_open(flat, fn);
 *     IcsEvent ev = { 0 };
 *     while (r.next(&ev) == 1) {
 *         // ev.summary / ev.dtstart / ev.dtend / ev.location / ev.uid
 *     }
 *
 * 和 vCard 一样是「一行一个 `名字;参数:值`」，折行要先摊平（`ics_unfold`），
 * 再在摊平后的文本上逐行读。一个 VCALENDAR 里可以有多个 VEVENT，`next`
 * 每次返回一个。
 *
 * 约定：
 *
 * - `ics_unfold` 与 `vcard_unfold` 语义相同（去掉折行、普通换行保留成 `\n`）；
 * - 名字大小写不敏感，参数忽略；只取常见属性：UID/SUMMARY/LOCATION/DTSTART/
 *   DTEND/DTSTAMP/DESCRIPTION；其余跳过但计入 `props`；
 * - `DTSTART` 的 `VALUE=DATE`、`TZID=...` 参数被忽略，值原样给出（带 `Z` 的
 *   UTC 时间就是带 Z 的字符串，不做时区换算）；
 * - `next` 返回 1 取到一个事件 / 0 读完 / -1 结构坏（缺 END:VEVENT、
 *   没摊平就喂进来导致行过长等）；
 * - 要求 `BEGIN:VCALENDAR` 出现过；VCALENDAR 之外的行跳过。
 */
#include <string.h>

module std.data.ics;
import std.core.types;
import std.text.str;

struct IcsEvent {
    int valid;
    int props;
    Str uid;
    Str summary;
    Str location;
    Str dtstart;
    Str dtend;
    Str dtstamp;
    Str description;
};

struct IcsReader {
    const char *p;
    int n;
    int pos;
    int bad;
    int seen_cal;
};

static IcsEvent ics_bad_event(void)
{
    IcsEvent e = { 0 };

    return e;
}

int ics_unfold(const void *src, int n, char *dst, int cap)
{
    const char *p = (const char *)src;
    int i = 0, o = 0;

    if (!src || !dst || n < 0 || cap <= 0)
        return -1;
    while (i < n) {
        char c = p[i];

        if (c == '\r' || c == '\n') {
            if (c == '\r' && i + 1 < n && p[i + 1] == '\n')
                i += 2;
            else
                i++;
            if (i < n && (p[i] == ' ' || p[i] == '\t')) {
                i++;
                continue;
            }
            if (o >= cap - 1)
                return -1;
            dst[o++] = '\n';
            continue;
        }
        if (o >= cap - 1)
            return -1;
        dst[o++] = c;
        i++;
    }
    dst[o] = 0;
    return o;
}

static int ics_name_is(Str name, const char *want)
{
    int i = 0, wl = (int)strlen(want);

    if (name.s.len != wl)
        return 0;
    for (i = 0; i < wl; i++) {
        char a = name.s.data[i], b = want[i];

        if (a >= 'A' && a <= 'Z')
            a = (char)(a - 'A' + 'a');
        if (b >= 'A' && b <= 'Z')
            b = (char)(b - 'A' + 'a');
        if (a != b)
            return 0;
    }
    return 1;
}

IcsReader ics_open(const void *flat, int n)
{
    IcsReader r = { 0 };

    if (!flat || n <= 0) {
        r.bad = 1;
        return r;
    }
    r.p = (const char *)flat;
    r.n = n;
    return r;
}

int next(IcsReader *self, IcsEvent *out)
{
    int in_event = 0;
    IcsEvent e = { 0 };

    if (!self || self->bad || !out)
        return -1;
    memset(out, 0, sizeof *out);
    while (self->pos < self->n) {
        int start = self->pos, colon = -1, semi = -1, line_end = 0, j = 0;

        while (self->pos < self->n && self->p[self->pos] != '\n')
            self->pos++;
        line_end = self->pos;
        if (self->pos < self->n)
            self->pos++;
        if (line_end <= start)
            continue;
        for (j = start; j < line_end; j++) {
            if (self->p[j] == ':' && colon < 0) {
                colon = j;
                break;
            }
            if (self->p[j] == ';' && semi < 0)
                semi = j;
        }
        if (colon < 0)
            continue;
        {
            Str name = { 0 };
            Str value = { 0 };

            if (semi >= 0 && semi < colon)
                name.s = (char[:]){ (char *)self->p + start, semi - start };
            else
                name.s = (char[:]){ (char *)self->p + start, colon - start };
            value.s = (char[:]){ (char *)self->p + colon + 1,
                                 line_end - colon - 1 };
            if (ics_name_is(name, "begin")) {
                if (ics_name_is(value, "vcalendar"))
                    self->seen_cal = 1;
                else if (ics_name_is(value, "vevent")) {
                    in_event = 1;
                    memset(&e, 0, sizeof e);
                }
                continue;
            }
            if (ics_name_is(name, "end")) {
                if (ics_name_is(value, "vevent")) {
                    if (!in_event)
                        return -1;
                    e.valid = 1;
                    *out = e;
                    return 1;
                }
                continue;
            }
            if (!in_event)
                continue;
            e.props++;
            if (ics_name_is(name, "uid")) {
                if (e.uid.s.len == 0)
                    e.uid = value;
            } else if (ics_name_is(name, "summary")) {
                if (e.summary.s.len == 0)
                    e.summary = value;
            } else if (ics_name_is(name, "location")) {
                if (e.location.s.len == 0)
                    e.location = value;
            } else if (ics_name_is(name, "dtstart")) {
                if (e.dtstart.s.len == 0)
                    e.dtstart = value;
            } else if (ics_name_is(name, "dtend")) {
                if (e.dtend.s.len == 0)
                    e.dtend = value;
            } else if (ics_name_is(name, "dtstamp")) {
                if (e.dtstamp.s.len == 0)
                    e.dtstamp = value;
            } else if (ics_name_is(name, "description")) {
                if (e.description.s.len == 0)
                    e.description = value;
            }
        }
    }
    if (in_event)
        return -1;
    return self->seen_cal ? 0 : -1;
}

/* ---- 自测 ---- */

static const char *CAL =
    "BEGIN:VCALENDAR\r\n"
    "VERSION:2.0\r\n"
    "PRODID:-//SuperC//std.data.ics//EN\r\n"
    "BEGIN:VEVENT\r\n"
    "UID:event-1@example.test\r\n"
    "DTSTAMP:20260101T090000Z\r\n"
    "DTSTART;TZID=Europe/Berlin:20260301T100000\r\n"
    "DTEND;TZID=Europe/Berlin:20260301T113000\r\n"
    "SUMMARY:Standup meeting with the whole team\r\n"
    "LOCATION:Room 4\r\n"
    "DESCRIPTION:short one\r\n"
    "END:VEVENT\r\n"
    "BEGIN:VEVENT\r\n"
    "UID:event-2@example.test\r\n"
    "DTSTART;VALUE=DATE:20260302\r\n"
    "SUMMARY:Lunch\r\n"
    "END:VEVENT\r\n"
    "END:VCALENDAR\r\n";

test "iCalendar：两个 VEVENT 与折行" {
    char flat[4096] = { 0 };
    int fn = ics_unfold(CAL, (int)strlen(CAL), flat, (int)sizeof flat);
    IcsReader r = ics_open(flat, fn);
    IcsEvent a = { 0 }, b = { 0 };

    if (fn <= 0)
        return err(1, "摊平失败");
    if (r.next(&a) != 1)
        return err(2, "第一个事件没读到");
    if (!a.valid || a.summary.s.len != 35
        || memcmp(a.summary.s.data, "Standup meeting with the whole team", 35) != 0)
        return err(3, "SUMMARY 不对");
    if (a.dtstart.s.len != 15
        || memcmp(a.dtstart.s.data, "20260301T100000", 15) != 0)
        return err(4, "DTSTART（带 TZID 参数）不对");
    if (a.dtend.s.len != 15
        || memcmp(a.dtend.s.data, "20260301T113000", 15) != 0)
        return err(5, "DTEND 不对");
    if (a.location.s.len != 6 || memcmp(a.location.s.data, "Room 4", 6) != 0)
        return err(6, "LOCATION 不对");
    if (a.uid.s.len != 20 || a.props != 7)
        return err(7, "UID 或属性计数不对");
    if (r.next(&b) != 1)
        return err(8, "第二个事件没读到");
    if (b.summary.s.len != 5 || memcmp(b.summary.s.data, "Lunch", 5) != 0)
        return err(9, "第二个 SUMMARY 不对");
    if (b.dtstart.s.len != 8 || memcmp(b.dtstart.s.data, "20260302", 8) != 0)
        return err(10, "VALUE=DATE 的 DTSTART 不对");
    if (r.next(&b) != 0)
        return err(11, "读完应该是 0");
    if (r.next(&b) != 0)
        return err(12, "读完后再读还是 0");
}

test "iCalendar：折行、坏结构与容量边界" {
    static const char *folded =
        "BEGIN:VCALENDAR\n"
        "BEGIN:VEVENT\n"
        "SUMMARY:a very long summary that got\r\n"
        "  folded across two lines\n"
        "END:VEVENT\n"
        "END:VCALENDAR\n";
    char flat[256] = { 0 };
    int fn = ics_unfold(folded, (int)strlen(folded), flat, (int)sizeof flat);
    IcsReader r = ics_open(flat, fn);
    IcsEvent e = { 0 };

    if (r.next(&e) != 1)
        return err(13, "折行事件没读到");
    if (e.summary.s.len != 52
        || memcmp(e.summary.s.data,
                  "a very long summary that got folded across two lines",
                  52) != 0)
        return err(14, "折行摊平后不对");
    /* 缺 END:VEVENT */
    {
        static const char *bad =
            "BEGIN:VCALENDAR\nBEGIN:VEVENT\nSUMMARY:x\n";
        char f2[128] = { 0 };
        int n2 = ics_unfold(bad, (int)strlen(bad), f2, (int)sizeof f2);
        IcsReader r2 = ics_open(f2, n2);

        if (r2.next(&e) != -1)
            return err(15, "缺 END:VEVENT 应该 -1");
    }
    /* 缓冲区不够 */
    if (ics_unfold(CAL, (int)strlen(CAL), flat, 16) != -1)
        return err(16, "缓冲不够应该 -1");
    /* 空输入 / 空指针 */
    if (ics_open(0, 10).bad == 0 || ics_unfold(0, 10, flat, 16) != -1
        || ics_unfold(CAL, 10, 0, 16) != -1)
        return err(17, "空指针应该失败");
    if (next(0, &e) != -1)
        return err(18, "空 reader 应该 -1");
}
