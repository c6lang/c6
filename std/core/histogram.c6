/* std/core/histogram：等宽分箱直方图（计数、众数箱、按箱中心估计均值）。
 *
 *     import std.core.histogram;
 *
 *     Hist h = { 0 };
 *     long long counts[8] = { 0 };
 *     h.init(counts, 8, 0.0, 8.0);      // 方法：init / add / bin_of / count
 *     h.add(2.5);
 *     h.bin_of(2.5);                    // 2（[2,3)）
 *
 * 等宽分箱：箱 i 覆盖 `[min + i*step, min + (i+1)*step)`，最后一箱包含右端点。
 *
 * 约定：
 *
 * - `init(counts, nbins, min, max)` 清零计数数组；`nbins <= 0` 或 `max <= min`
 *   返回 -1；
 * - `add(v)` 把值计入对应箱（小于 `min` 计入第 0 箱、大于等于 `max` 计入最后一箱），
 *   返回箱号；
 * - `bin_of(v)` 只算箱号不计入；`count(i)` 给某箱计数；`total()` 是总样本数；
 * - `mode(&lo, &hi)` 找计数最大的箱，成功返回 1 并写箱的左右边界；
 * - `mean()` 用箱中心近似估计均值；`clamp` 的样本会让估计有偏（文档已说明）；
 * - `step()` 给箱宽。
 */
#include <string.h>

module std.core.histogram;
import std.core.types;
import std.text.str;

struct Hist {
    i64 *counts;
    int nbins;
    double min;
    double max;
    i64 n;              /* 字段名不能与 total() 方法冲突 */
};

int init(Hist *h, i64 *counts, int nbins, double min, double max)
{
    if (!h || !counts || nbins <= 0 || !(max > min))
        return -1;
    memset(counts, 0, sizeof(i64) * (size_t)nbins);
    h->counts = counts;
    h->nbins = nbins;
    h->min = min;
    h->max = max;
    h->n = 0;
    return 1;
}

double step(Hist *h)
{
    if (!h || h->nbins <= 0)
        return 0;
    return (h->max - h->min) / (double)h->nbins;
}

int bins(Hist *h)
{
    return h ? h->nbins : 0;
}

i64 total(Hist *h)
{
    return h ? h->n : 0;
}

int bin_of(Hist *h, double v)
{
    double st = 0;
    int idx = 0;

    if (!h || h->nbins <= 0)
        return -1;
    if (v < h->min)
        return 0;
    if (v >= h->max)
        return h->nbins - 1;
    st = step(h);
    idx = (int)((v - h->min) / st);
    if (idx < 0)
        idx = 0;
    if (idx >= h->nbins)
        idx = h->nbins - 1;
    return idx;
}

int add(Hist *h, double v)
{
    int idx = bin_of(h, v);

    if (idx < 0)
        return -1;
    h->counts[idx]++;
    h->n++;
    return idx;
}

i64 count(Hist *h, int i)
{
    if (!h || !h->counts || i < 0 || i >= h->nbins)
        return 0;
    return h->counts[i];
}

int mode(Hist *h, double *lo, double *hi)
{
    int i = 0, best = -1;
    double st = 0;

    if (!h || !h->counts || h->n <= 0)
        return 0;
    for (i = 0; i < h->nbins; i++) {
        if (best < 0 || h->counts[i] > h->counts[best])
            best = i;
    }
    if (best < 0)
        return 0;
    st = step(h);
    if (lo)
        *lo = h->min + (double)best * st;
    if (hi)
        *hi = h->min + (double)(best + 1) * st;
    return 1;
}

double mean(Hist *h)
{
    double st = 0, sum = 0;
    int i = 0;

    if (!h || !h->counts || h->n <= 0)
        return 0;
    st = step(h);
    for (i = 0; i < h->nbins; i++) {
        double center = h->min + ((double)i + 0.5) * st;

        sum += center * (double)h->counts[i];
    }
    return sum / (double)h->n;
}

i64 max_count(Hist *h)
{
    i64 best = 0;
    int i = 0;

    if (!h || !h->counts)
        return 0;
    for (i = 0; i < h->nbins; i++) {
        if (h->counts[i] > best)
            best = h->counts[i];
    }
    return best;
}

int clear(Hist *h)
{
    if (!h || !h->counts)
        return -1;
    memset(h->counts, 0, sizeof(i64) * (size_t)h->nbins);
    h->n = 0;
    return 1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

static int hnear(double a, double b, double eps)
{
    double d = a - b;

    if (d < 0)
        d = -d;
    return d <= eps;
}

test "histogram：分箱与计数" {
    i64 counts[4] = { 0 };
    Hist h = { 0 };
    int i = 0;

    if (h.init(counts, 4, 0.0, 4.0) != 1)
        return err(1, "init 失败");
    if (!hnear(h.step(), 1.0, 1e-9) || h.bins() != 4)
        return err(2, "箱宽或箱数不对");
    if (h.bin_of(0.0) != 0 || h.bin_of(1.5) != 1 || h.bin_of(3.0) != 3)
        return err(3, "bin_of 不对");
    if (h.bin_of(-1.0) != 0 || h.bin_of(9.0) != 3)
        return err(4, "越界值应该夹到首尾箱");
    for (i = 0; i < 4; i++)
        h.add(0.5);
    h.add(2.5);
    if (h.total() != 5 || h.count(0) != 4 || h.count(2) != 1)
        return err(5, "计数不对");
    if (h.count(9) != 0)
        return err(6, "越界箱计数应该 0");
    if (h.max_count() != 4)
        return err(7, "最大计数应该是 4");
    if (h.init(counts, 4, 1.0, 1.0) != -1 || h.init(counts, 0, 0.0, 1.0) != -1)
        return err(8, "非法范围或箱数应该 -1");
}

test "histogram：众数与均值" {
    i64 counts[8] = { 0 };
    Hist h = { 0 };
    double lo = 0, hi = 0;
    int i = 0;

    if (h.init(counts, 8, 0.0, 8.0) != 1)
        return err(9, "init 失败");
    /* 0..7 每个值各一个，再给 [5,6) 加 3 个 */
    for (i = 0; i < 8; i++)
        h.add((double)i + 0.5);
    for (i = 0; i < 3; i++)
        h.add(5.5);
    if (h.total() != 11)
        return err(10, "总数不对");
    if (h.mode(&lo, &hi) != 1 || !hnear(lo, 5.0, 1e-9)
        || !hnear(hi, 6.0, 1e-9))
        return err(11, "众数箱应该是 [5,6)");
    if (h.count(5) != 4)
        return err(12, "第 5 箱应该有 4 个");
    /* 均值按箱中心估计：原始数据中心为 0.5..7.5 与 5.5×3 */
    if (!hnear(h.mean(), (0.5 + 1.5 + 2.5 + 3.5 + 4.5 + 5.5 * 4 + 6.5 + 7.5)
                              / 11.0, 1e-9))
        return err(13, "箱中心均值不对");
    if (h.clear() != 1 || h.total() != 0 || h.count(5) != 0)
        return err(14, "clear 之后应该清零");
    /* 空直方图 */
    if (h.mode(&lo, &hi) != 0 || !hnear(h.mean(), 0.0, 1e-9))
        return err(15, "空直方图的 mode/mean 不对");
}
