/* std/core/vector：二维/三维矢量（点积、叉积、长度、归一化、插值）。
 *
 *     import std.core.vector;
 *
 *     Vec3 a = { 1, 2, 3 };
 *     Vec3 b = { 0, 1, 0 };
 *     Vec3 n = vec3_cross(a, b);      // (-3, 0, 1)
 *     double d = vec3_dot(a, b);      // 2
 *
 * 约定：
 *
 * - `Vec2`/`Vec3` 是 `double` 的平凡结构体，按值传参、按值返回；
 * - `vec*_len` 是欧氏长度（`sqrt`），`vec*_norm` 在长度为 0 时原样返回零矢量
 *   （不返回 NaN）；
 * - `vec2_cross` 返回标量（二维「叉积」的 z 分量），三维才有 `vec3_cross`；
 * - `vec*_lerp` 在 `t=0` 给 `a`、`t=1` 给 `b`；
 * - `vec*_angle` 用 `acos(dot/(|a||b|))`，任一为零矢量返回 0；
 * - `vec3_project` 是 `a` 在 `b` 上的投影矢量，`b` 为零矢量返回零矢量。
 */
#include <math.h>

module std.core.vector;
import std.core.types;

struct Vec2 {
    double x;
    double y;
};

struct Vec3 {
    double x;
    double y;
    double z;
};

Vec2 vec2_make(double x, double y)
{
    Vec2 v = { 0, 0 };

    v.x = x;
    v.y = y;
    return v;
}

Vec3 vec3_make(double x, double y, double z)
{
    Vec3 v = { 0, 0, 0 };

    v.x = x;
    v.y = y;
    v.z = z;
    return v;
}

Vec2 vec2_add(Vec2 a, Vec2 b)
{
    return vec2_make(a.x + b.x, a.y + b.y);
}

Vec2 vec2_sub(Vec2 a, Vec2 b)
{
    return vec2_make(a.x - b.x, a.y - b.y);
}

Vec2 vec2_scale(Vec2 a, double k)
{
    return vec2_make(a.x * k, a.y * k);
}

double vec2_dot(Vec2 a, Vec2 b)
{
    return a.x * b.x + a.y * b.y;
}

double vec2_cross(Vec2 a, Vec2 b)
{
    return a.x * b.y - a.y * b.x;
}

double vec2_len(Vec2 a)
{
    return sqrt(a.x * a.x + a.y * a.y);
}

double vec2_dist(Vec2 a, Vec2 b)
{
    double dx = a.x - b.x, dy = a.y - b.y;

    return sqrt(dx * dx + dy * dy);
}

Vec2 vec2_norm(Vec2 a)
{
    double l = vec2_len(a);

    if (l == 0)
        return vec2_make(0, 0);
    return vec2_make(a.x / l, a.y / l);
}

Vec2 vec2_lerp(Vec2 a, Vec2 b, double t)
{
    return vec2_make(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t);
}

Vec3 vec3_add(Vec3 a, Vec3 b)
{
    return vec3_make(a.x + b.x, a.y + b.y, a.z + b.z);
}

Vec3 vec3_sub(Vec3 a, Vec3 b)
{
    return vec3_make(a.x - b.x, a.y - b.y, a.z - b.z);
}

Vec3 vec3_scale(Vec3 a, double k)
{
    return vec3_make(a.x * k, a.y * k, a.z * k);
}

double vec3_dot(Vec3 a, Vec3 b)
{
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

Vec3 vec3_cross(Vec3 a, Vec3 b)
{
    return vec3_make(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z,
                     a.x * b.y - a.y * b.x);
}

double vec3_len(Vec3 a)
{
    return sqrt(a.x * a.x + a.y * a.y + a.z * a.z);
}

double vec3_dist(Vec3 a, Vec3 b)
{
    double dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;

    return sqrt(dx * dx + dy * dy + dz * dz);
}

Vec3 vec3_norm(Vec3 a)
{
    double l = vec3_len(a);

    if (l == 0)
        return vec3_make(0, 0, 0);
    return vec3_make(a.x / l, a.y / l, a.z / l);
}

Vec3 vec3_lerp(Vec3 a, Vec3 b, double t)
{
    return vec3_make(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t,
                     a.z + (b.z - a.z) * t);
}

Vec3 vec3_project(Vec3 a, Vec3 b)
{
    double d = vec3_dot(b, b);

    if (d == 0)
        return vec3_make(0, 0, 0);
    return vec3_scale(b, vec3_dot(a, b) / d);
}

double vec3_angle(Vec3 a, Vec3 b)
{
    double la = vec3_len(a), lb = vec3_len(b), c = 0;

    if (la == 0 || lb == 0)
        return 0;
    c = vec3_dot(a, b) / (la * lb);
    if (c > 1)
        c = 1;
    if (c < -1)
        c = -1;
    return acos(c);
}

/* ---- 自测 ---- */

static int near(double a, double b)
{
    double d = a - b;

    if (d < 0)
        d = -d;
    return d < 1e-9;
}

test "vector：二维" {
    Vec2 a = vec2_make(3, 4);
    Vec2 b = vec2_make(1, 0);
    Vec2 n = { 0, 0 };

    if (!near(vec2_len(a), 5))
        return err(1, "(3,4) 的长度应该是 5");
    if (!near(vec2_dot(a, b), 3))
        return err(2, "点积不对");
    if (!near(vec2_cross(a, b), -4))
        return err(3, "二维叉积应该是 -4");
    if (!near(vec2_dist(a, b), sqrt(20.0)))
        return err(4, "距离不对");
    n = vec2_norm(a);
    if (!near(n.x, 0.6) || !near(n.y, 0.8))
        return err(5, "归一化不对");
    if (!near(vec2_len(vec2_norm(vec2_make(0, 0))), 0))
        return err(6, "零矢量归一化应该还是零");
    n = vec2_lerp(vec2_make(0, 0), vec2_make(10, 20), 0.25);
    if (!near(n.x, 2.5) || !near(n.y, 5))
        return err(7, "插值不对");
    n = vec2_add(vec2_make(1, 2), vec2_make(3, 4));
    if (!near(n.x, 4) || !near(n.y, 6))
        return err(8, "加法不对");
}

test "vector：三维" {
    Vec3 a = vec3_make(1, 2, 3);
    Vec3 b = vec3_make(0, 1, 0);
    Vec3 c = vec3_make(0, 0, 0);

    if (!near(vec3_dot(a, b), 2))
        return err(9, "三维点积不对");
    c = vec3_cross(a, b);
    if (!near(c.x, -3) || !near(c.y, 0) || !near(c.z, 1))
        return err(10, "叉积应该是 (-3,0,1)");
    if (!near(vec3_len(vec3_make(0, 3, 4)), 5))
        return err(11, "长度不对");
    c = vec3_project(vec3_make(2, 3, 0), vec3_make(1, 0, 0));
    if (!near(c.x, 2) || !near(c.y, 0))
        return err(12, "投影不对");
    if (!near(vec3_angle(vec3_make(1, 0, 0), vec3_make(0, 1, 0)),
              acos(0.0)))
        return err(13, "夹角应该是 90 度");
    if (!near(vec3_angle(vec3_make(0, 0, 0), b), 0))
        return err(14, "零矢量的夹角应该是 0");
    c = vec3_norm(vec3_make(0, 0, 0));
    if (!near(c.x, 0) || !near(c.y, 0) || !near(c.z, 0))
        return err(15, "零矢量归一化应该还是零");
    c = vec3_lerp(vec3_make(0, 0, 0), vec3_make(2, 4, 6), 0.5);
    if (!near(c.x, 1) || !near(c.y, 2) || !near(c.z, 3))
        return err(16, "三维插值不对");
}
