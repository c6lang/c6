/* examples/stdhash.c6 —— 第三十八批（哈希与校验）的集成示例。
 *
 *     cmake --build build --target std-hash
 *
 * 四节：SHA-3-256 / SHAKE128、BLAKE2s-256、CRC-32C、XXH32/XXH64。每节都拿已知
 * 向量对一遍，再演示一次流式与一次性的结果相同。
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.text.str;
import std.encoding.sha3;
import std.encoding.blake2s;
import std.encoding.crc32c;
import std.encoding.xxhash;

static int checks = 0;
static int fails = 0;

static void check(int cond, const char *what)
{
    checks++;
    if (!cond) {
        fails++;
        printf("   ✗ %s\n", what);
    }
}

static void hex(const u8 *p, int n, char *out)
{
    static const char *d = "0123456789abcdef";
    int i = 0;

    for (i = 0; i < n; i++) {
        out[2 * i] = d[(p[i] >> 4) & 0xF];
        out[2 * i + 1] = d[p[i] & 0xF];
    }
    out[2 * n] = 0;
}

static void do_sha3(void)
{
    u8 dig[64] = { 0 };
    char txt[129] = { 0 };
    Sha3 s = { 0 };
    u8 xof[32] = { 0 };

    printf("== sha3\n");
    sha3_hash(256, "abc", 3, dig);
    hex(dig, 32, txt);
    printf("   SHA3-256(abc) = %s\n", txt);
    check(strcmp(txt,
                 "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
              == 0,
          "SHA3-256 向量");
    /* 流式 */
    s.sha3_init(256);
    s.sha3_update("a", 1);
    s.sha3_update("bc", 2);
    s.sha3_final(dig);
    hex(dig, 32, txt);
    check(strcmp(txt,
                 "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
              == 0,
          "SHA3-256 流式");
    /* SHAKE128 挤 32 字节 */
    {
        Sha3 x = { 0 };

        x.shake_init(128);
        x.sha3_update("", 0);
        x.shake_out(xof, 32);
        hex(xof, 32, txt);
        printf("   SHAKE128(\"\",32) = %s\n", txt);
        check(strcmp(txt,
                     "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26")
                  == 0,
              "SHAKE128 向量");
    }
    sha3_hash(512, "", 0, dig);
    hex(dig, 64, txt);
    check(strlen(txt) == 128, "SHA3-512 输出 128 个十六进制字符");
}

static void do_blake2s(void)
{
    u8 dig[32] = { 0 };
    char txt[65] = { 0 };
    Blake2s b = { 0 };

    printf("== blake2s\n");
    blake2s_hash("abc", 3, dig, 32);
    hex(dig, 32, txt);
    printf("   BLAKE2s-256(abc) = %s\n", txt);
    check(strcmp(txt,
                 "508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982")
              == 0,
          "BLAKE2s 向量");
    b.blake2s_init(32);
    b.blake2s_update("ab", 2);
    b.blake2s_update("c", 1);
    b.blake2s_final(dig, 32);
    hex(dig, 32, txt);
    check(strcmp(txt,
                 "508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982")
              == 0,
          "BLAKE2s 流式");
    /* 短输出 */
    blake2s_hash("abc", 3, dig, 16);
    hex(dig, 16, txt);
    printf("   BLAKE2s-128(abc) = %s\n", txt);
    check(strcmp(txt, "aa4938119b1dc7b87cbad0ffd200d0ae") == 0, "BLAKE2s-128 向量");
}

static void do_crc32c(void)
{
    static const char *s = "123456789";
    u32 c = 0;
    u32 r = 0xFFFFFFFFu;

    printf("== crc32c\n");
    c = crc32c(s, 9);
    printf("   CRC32C(\"123456789\") = 0x%08x\n", c);
    check(c == 0xE3069283u, "CRC-32C 向量");
    r = crc32c_update(r, s, 4);
    r = crc32c_update(r, s + 4, 5);
    check((r ^ 0xFFFFFFFFu) == c, "分段与一次算一致");
    check(crc32c_str((Str){ S("123456789") }) == c, "Str 版一致");
    check(crc32c("", 0) == 0, "空数据是 0");
}

static void do_xxhash(void)
{
    char msg[100] = { 0 };
    Xxh32 a = { 0 };
    Xxh64 b = { 0 };
    int i = 0;

    printf("== xxhash\n");
    printf("   XXH32(abc) = %08x，XXH64(abc) = %016llx\n", xxh32("abc", 3, 0),
           (unsigned long long)xxh64("abc", 3, 0));
    check(xxh32("", 0, 0) == 0x02CC5D05u, "XXH32 空串向量");
    check(xxh32("abc", 3, 0) == 0x32D153FFu, "XXH32 向量");
    check(xxh64("", 0, 0) == 0xEF46DB3751D8E999ULL, "XXH64 空串向量");
    check(xxh64("abc", 3, 0) == 0x44BC2CF5AD770999ULL, "XXH64 向量");
    for (i = 0; i < 100; i++)
        msg[i] = (char)('0' + i % 10);
    a.xxh32_init(0);
    b.xxh64_init(0);
    for (i = 0; i < 100; i += 9)
        a.xxh32_update(msg + i, 100 - i < 9 ? 100 - i : 9);
    for (i = 0; i < 100; i += 31)
        b.xxh64_update(msg + i, 100 - i < 31 ? 100 - i : 31);
    check(a.xxh32_digest() == xxh32(msg, 100, 0), "XXH32 流式一致");
    check(b.xxh64_digest() == xxh64(msg, 100, 0), "XXH64 流式一致");
}

int main(void)
{
    do_sha3();
    do_blake2s();
    do_crc32c();
    do_xxhash();
    printf("\n%d check(s), %d failure(s)\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
