            return 0;
        }

        /* 枚举的限定名 `Color.RED` 也是常量表达式的一部分
         * （`int a[Color.BLUE]`、`(1u << Color.GREEN)`、`case Color.RED:`）。
         * 必须在裸名判断之前试：`Color` 自己也是类型名（枚举裸名当类型用），
         * 先看裸名就看走眼了。 */
        if (pa_peek(1) && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ".")
            && pa_peek(2) && pa_peek(2)->kind == TK_IDENT
            && (!s || (s->kind != SC_ENUMC && s->kind != SC_GLOBAL))
            && pa_cur()->len + pa_peek(2)->len + 2 < 256) {
            char qn[256] = {0};
            u32 qk = pa_cur()->len;

            memcpy(qn, tok_data(pa_cur()), qk);
            qn[qk++] = '.';
            memcpy(qn + qk, tok_data(pa_peek(2)), pa_peek(2)->len);
            qk += pa_peek(2)->len;
            s = sym_find(qn, qk);
            if (s) {
                pa_advance();
                pa_advance();
                pa_advance();
                return s->val;
            }
        }
        if (s && (s->kind == SC_ENUMC || s->kind == SC_GLOBAL)) {
            if (s->kind == SC_GLOBAL && CONST_NOREF)
                /* 地址常量里的偏移不能引用全局对象：它的值是运行期的 */
                pa_error("'%.*s' 不是常量：静态初始化器里的偏移要整数常量表达式",
                         (int)pa_cur()->len, tok_data(pa_cur()));
            if (s->kind == SC_GLOBAL)
                CONST_SYM = 1;
            pa_advance();
            return s->val;
        }
        if (CONST_LAX && pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
            && tok_eq(pa_peek(1), "(")) {
            /* 宽松模式（三元未选中的那一支）：认不出的调用直接跳过整组实参，
             * 值给 0。位置必须走走对，不然解析会错位。 */
            int d = 0;

            pa_advance();
            while (pa_cur()->kind != TK_EOF) {
                Tok *t = pa_cur();

                if (t->kind == TK_PUNCT) {
                    if (tok_eq(t, "(") || TOK_EQ(t, "["))
                        d++;
                    else if (tok_eq(t, ")") || TOK_EQ(t, "]")) {
                        d--;
                        if (d == 0) {
                            pa_advance();
                            break;
                        }
                    }
                }
                pa_advance();
            }
            return 0;
        }
        if (CONST_LAX) {
            pa_advance();
            return 0;
        }
        pa_error("常量表达式里出现未知名字 '%.*s'", (int)pa_cur()->len, tok_data(pa_cur()));
        pa_advance();
        return 0;
    }
    if (CONST_LAX) {
        if (pa_cur()->kind != TK_EOF)
            pa_advance();
        return 0;
    }
    pa_error("这里要一个常量表达式");
    if (pa_cur()->kind != TK_EOF)
        pa_advance();
    return 0;
}

static i64 const_mul(void)
{
    i64 v = const_unary();
    u32 lty = CONST_TY;         /* 结果类型取左操作数 */

    for (;;) {
        if (pa_accept_ch('*')) {
            v = v * const_unary();
            CONST_TY = lty;     /* 右侧求值会改写 CONST_TY */
        } else if (pa_accept_ch('/')) {
            i64 r = const_unary();

            v = r ? v / r : 0;
            CONST_TY = lty;
        } else if (pa_accept_ch('%')) {
            i64 r = const_unary();

            v = r ? v % r : 0;
            CONST_TY = lty;
        } else {
            return v;
        }
    }
}

static i64 const_add(void)
{
    i64 v = const_mul();
    u32 lty = CONST_TY;         /* 结果类型取左操作数（寻常算术转换） */

    for (;;) {
        if (pa_accept_ch('+')) {
            v = v + const_mul();
            CONST_TY = lty;     /* 右侧求值会改写 CONST_TY */
        } else if (pa_accept_ch('-')) {
            v = v - const_mul();
            CONST_TY = lty;
        } else
            return v;
    }
}

static i64 const_shift(void)
{
    i64 v = const_add();
    u32 lty = CONST_TY;         /* 左操作数类型：移位结果的类型 */

    for (;;) {
        if (pa_accept_punct("<<")) {
            i64 sh = const_add();
            v = (i64)((u64)v << (u64)sh);
            CONST_TY = lty;     /* 右侧求值会改写 CONST_TY，恢复为左值类型 */
        } else if (pa_accept_punct(">>")) {
            i64 sh = const_add();
            v = v >> (u64)sh;
            CONST_TY = lty;
        } else
            return v;
    }
}

/* 常量层的比较：先按 C 的"寻常算术转换"定公共类型，再比。返回 -1 / 0 / 1。
 *
 * 直接拿 i64 比会错：`(0ULL - 1) < 1ULL` 变成 -1 < 1 → 真。内核
 * include/linux/overflow.h:33 的 is_signed_type() 正是
 *
 *     #define is_signed_type(type) (((type)(-1)) < (type)1)
 *
 * 判错让 type_max() 只剩一半宽（0x7FFF… 而不是 0xFFFF…），
 * arch/x86/include/asm/svm.h:308-310 的三条 static_assert 于是全假失败——
 * 实测 7 个 arch/x86 文件卡在这条（crash.c / head64.c / kvm.c / nmi.c /
 * probe_roms.c / smpboot.c / tsc.c）。 */
static int const_cmp3(i64 a, u32 aty, i64 b, u32 bty)
{
    u32 aw = 0;
    u32 bw = 0;
    int as = 0;
    int bs = 0;
    int uns = 0;
    u32 w = 0;
    u64 m = 0;
    u64 ua = 0;
    u64 ub = 0;

    if (!aty)
        aty = bty ? bty : ty_int();
    if (!bty)
        bty = aty;
    aw = ty_size(aty);
    bw = ty_size(bty);
    as = ty_is_signed(aty);
    bs = ty_is_signed(bty);
    /* 整型提升：窄于 int 的一律提到有符号 int */
    if (aw < 4) {
        aw = 4;
        as = 1;
    }
    if (bw < 4) {
        bw = 4;
        bs = 1;
    }
    if (aw > 8)
        aw = 8;
    if (bw > 8)
        bw = 8;
    w = aw > bw ? aw : bw;
    if (as && bs)
        uns = 0;
    else if (!as && !bs)
        uns = 1;
    else if (aw == bw)
        uns = 1;                 /* 同宽时无符号胜出 */
    else
        /* 一宽一窄：宽的那个有符号就能装下窄的无符号类型的全部值，仍有符号 */
        uns = (aw > bw) ? (as ? 0 : 1) : (bs ? 0 : 1);
    m = (w >= 8) ? ~(u64)0 : ((1ULL << (w * 8)) - 1ULL);
    ua = (u64)a & m;
    ub = (u64)b & m;
    if (uns)
        return ua < ub ? -1 : (ua > ub ? 1 : 0);
    {
        i64 sa = (i64)ua;
        i64 sb = (i64)ub;

        if (w < 8) {
            u64 sign = 1ULL << (w * 8 - 1);

            if (ua & sign)
                sa = (i64)(ua | ~m);
            if (ub & sign)
                sb = (i64)(ub | ~m);
        }
        return sa < sb ? -1 : (sa > sb ? 1 : 0);
    }
}

static i64 const_rel(void)
{
    i64 v = const_shift();
    u32 lty = CONST_TY;

    for (;;) {
        i64 r = 0;

        if (pa_accept_ch('<')) {
            r = const_shift();
            v = const_cmp3(v, lty, r, CONST_TY) < 0 ? 1 : 0;
        } else if (pa_accept_punct("<=")) {
            r = const_shift();
            v = const_cmp3(v, lty, r, CONST_TY) <= 0 ? 1 : 0;
        } else if (pa_accept_ch('>')) {
            r = const_shift();
            v = const_cmp3(v, lty, r, CONST_TY) > 0 ? 1 : 0;
        } else if (pa_accept_punct(">=")) {
            r = const_shift();
            v = const_cmp3(v, lty, r, CONST_TY) >= 0 ? 1 : 0;
        } else {
            return v;
        }
        lty = ty_int();          /* 比较结果是 int */
    }
}

static i64 const_eq(void)
{
    i64 v = const_rel();
    u32 lty = CONST_TY;

    for (;;) {
        i64 r = 0;

        if (pa_accept_punct("==")) {
            r = const_rel();
            v = const_cmp3(v, lty, r, CONST_TY) == 0 ? 1 : 0;
        } else if (pa_accept_punct("!=")) {
            r = const_rel();
            v = const_cmp3(v, lty, r, CONST_TY) != 0 ? 1 : 0;
        } else {
            return v;
        }
        lty = ty_int();
    }
}

static i64 const_band(void)
{
    i64 v = const_eq();

    while (pa_accept_ch('&'))
        v = v & const_eq();
    return v;
}

static i64 const_bxor(void)
{
    i64 v = const_band();

    while (pa_accept_ch('^'))
        v = v ^ const_band();
    return v;
}

static i64 const_bor(void)
{
    i64 v = const_bxor();

    while (pa_accept_ch('|'))
        v = v | const_bxor();
    return v;
}

static i64 const_land(void)
{
    i64 v = const_bor();

    while (pa_accept_punct("&&")) {
        i64 r = const_bor();

        v = (v != 0 && r != 0) ? 1 : 0;
    }
    return v;
}

static i64 const_lor(void)
{
    i64 v = const_land();

    while (pa_accept_punct("||")) {
        i64 r = const_land();

        v = (v != 0 || r != 0) ? 1 : 0;
    }
    return v;
}

static i64 const_cond(void)
{
    i64 c = const_lor();

    if (pa_accept_ch('?')) {
        /* 三元的**两支都要过一遍 token**，但只有选中的那支的**值**有用。
         * 未选中的那支里常有函数调用（内核 include/linux/log2.h 的 ilog2()
         * 就是这样：`… ? (…) : (sizeof(n) <= 4) ? __ilog2_u32(n) : __ilog2_u64(n)`），
         * 常量求值器碰不得——所以求值期间把 CONST_LAX 打开：认不出的东西一律
         * 当 0、只把 token 吃掉，不报错。 */
        int save_lax = CONST_LAX;
        i64 a = 0;
        i64 b = 0;

        CONST_LAX = 1;
        if (pa_is_ch(':')) {
            /* GNU 省略中间操作数的三元 `a ?: b`：条件只求值一次，非 0 时
             * 结果就是它自己。运行期那条路 gen_cond 早就认这个写法，
             * 常量层这里以前没有，于是 `__aligned__( ( + 0) ? : (1 << 6) )`
             * 一进常量求值就报"这里要 ':'（当前是 '('）"。内核
             * include/linux/cache.h 的 __cacheline_group_begin/end 展开出来
             * 就是这个形状（实测 lib/ 下 6 个文件卡在这条）。 */
            a = c;
            pa_advance();
        } else {
            a = const_expr();
            pa_expect_ch(':');
        }
        b = const_cond();
        CONST_LAX = save_lax;
        return c ? a : b;
    }
    return c;
}
static i64 const_expr(void)
{
    return const_cond();
}

static u32 parse_declarator(u32 base, Declarator *d);

static void pa_dbg_counts(void)
{
    fprintf(stderr, "       [dbg] sym=%u nagg=%u type=%u data=%u static=%u\n",
            (unsigned)SYM_COUNT, (unsigned)NAGG, (unsigned)TT.n,
            (unsigned)DATA_IMG.n, (unsigned)NSTATIC);
}

/* struct/union 定义体：成员类型 + 成员名 + 位宽。
 * 名字不要跟上面的 AGG_CAP0（聚合成员表容量）撞——那两个是不同的初始容量，
 * 同名会被预处理器告警，而且改一个的后果会悄悄落到另一个身上。 */
#define AGG_MEM_CAP0 64

static void *agg_grow(void *old, u32 n, u32 cap, u32 esz)
{
    void *np = arena_alloc(&A_main, (size_t)cap * esz);

    if (old && n)
        memcpy(np, old, (size_t)n * esz);
    return np;
}

/* 从当前的 `{` 开始抓一段平衡的花括号，把**消费掉**的 token 抄进 out；
 * 返回抄了几个。不碰前瞻缓冲（tmpl_capture_body 会把前瞻前缀也算进去，
 * 拿来做"抓了再放回去"会错位）。 */
/* ---------- 方法表 ----------
 * 方法在符号表里就是"首形参是 ptr(接收者)"的普通函数，名字不带接收者，
 * 于是一个同名的全局变量/别的函数就能把它遮住（std/net/httpd.c6 的 `port`
 * 就是这样），方法调用糖失效、报"结构体没有成员"。另记一张
 * (接收者类型, 名字) 的表，按接收者类型查：既不受符号表遮蔽影响，
 * 模板实例之间也不会互相串味。 */
#define METH_MAX 8192
static Sym *METH_SYM[METH_MAX];
static u32 METH_SELF[METH_MAX];
static u32 METH_NEXT[METH_MAX];
static u32 NMETH;

/* (接收者类型 → 方法) 的桶链。原来 meth_find 线性扫整张方法表：tcc.c 这种 TU
 * 里表长近两千，而每次查找只有两三千次调用、却要扫上千个条目 —— profile 里
 * 1.8% 全花在这条 `METH_SELF[i] != self_ty` 的比较上。按接收者类型挂链之后
 * 只走同类型的那几条。**顺序必须保持“先登记的在前”**（TAIL 记链尾、追加到
 * 链尾），否则同名方法会挑到另一份，语义就和逐项比较不一样了。 */
#define METH_NB 1024
static u32 METH_HEAD[METH_NB];    /* 0 = 空，否则是下标 + 1 */
static u32 METH_TAIL[METH_NB];

static u32 meth_bucket(u32 self_ty)
{
    return (self_ty * 2654435761u) >> 22;
}

static void meth_add(Sym *p, u32 self_ty)
{
    u32 i = 0;
    u32 b = 0;

    if (NMETH >= METH_MAX)
        return;
    i = NMETH++;
    b = meth_bucket(self_ty);
    METH_SYM[i] = p;
    METH_SELF[i] = self_ty;
    METH_NEXT[i] = 0;
    if (METH_TAIL[b])
        METH_NEXT[METH_TAIL[b] - 1] = i + 1;
    else
        METH_HEAD[b] = i + 1;
    METH_TAIL[b] = i + 1;
}

/* 同名函数的**重载选择**：在符号表里找形参个数对得上、首形参类型也对得上
 * 的那一个。`area(&c)` / `area(&r)`、`plain_area()` / `plain_area(&b)`
 * 都是同一个名字的多个符号，光 `sym_find` 只会给最后登记的那个
 * （tests/method.c6）。 */
static Sym *sym_find_fn(const char *nm, u32 nl, u32 narg, u32 a0ty)
{
    u32 h = sym_hash_ns(nm, nl, 0);
    u32 b = h & (SYM_NBUCKET - 1);
    Sym *p = SYM_BUCKET[b];
    Sym *best = NULL;

    for (; p; p = p->next) {
        if (p->hash != h || p->len != nl || !p->is_func || !p->type)
            continue;
        if (memcmp(p->name, nm, nl) != 0)
            continue;
        if (!ty_is_func(p->type))
            continue;
        if (ty_func_nparams(p->type) != narg)
            continue;
        if (narg > 0 && a0ty && ty_func_param(p->type, 0) == a0ty)
            return p;
        if (!best)
            best = p;
    }
    return best;
}

/* 同一个名字、但**形参个数不同**的函数还在不在？方法输出成
 * `<结构体>_<方法>` 之后，源码名那个弱别名就不能再挂了——挂上去会把
 * libc 的 `getpid()` 顶掉，或者顶掉同名的普通函数（tests/method.c6 的
 * 两组断言）。形参个数相同的不算冲突：闭包参数在纯 C 一侧写成
 * `struct __c6_closure_any *`，那还是同一个函数（tests/abi/closure.c6）。 */
static int fn_overload_taken(const char *nm, u32 nl, u32 ty)
{
    u32 h = sym_hash_ns(nm, nl, 0);
    u32 b = h & (SYM_NBUCKET - 1);
    Sym *p = SYM_BUCKET[b];
    u32 np = ty_func_nparams(ty);

    for (; p; p = p->next)
        if (p->hash == h && p->len == nl && p->is_func && p->type
            && memcmp(p->name, nm, nl) == 0 && ty_is_func(p->type)
            && ty_func_nparams(p->type) != np)
            return 1;
    return 0;
}

static Sym *meth_find(u32 self_ty, const char *nm, u32 nl)
{
    u32 j = METH_HEAD[meth_bucket(self_ty)];

    while (j) {
        u32 i = j - 1;
        Sym *p = METH_SYM[i];

        if (METH_SELF[i] == self_ty && p && p->len == nl
            && memcmp(p->name, nm, nl) == 0)
            return p;
        j = METH_NEXT[i];
    }
    return NULL;
}

/* 抓花括号体的同时把"这片初始化器铺了多少个元素"数出来（游标模拟，规则和
 * C11 6.7.8 一致）：设计符把游标跳到 N+1，范围设计符取最后一个数，顺序值接在
 * 游标后面，嵌套花括号算一个条目，花括号省略接着填。
 * **在抓的时候就数**，省掉事后再扫一遍（实测省下的时间在噪声里，但少一遍
 * 就少一遍；`tcc.c` 里那几张大表都走这条路）。 */
static u32 CAP_BOUND;
/* 抓下来的 token 一个都不能少：`T x[] = {…}` 的长度**由初始化器的条数决定**，
 * 少抓一条就编出一个短一截的数组（早先按 1 KB 估过，tcc 里那张 354 条的
 * 静态指令表被编成 122 条）。所以缓冲区按需翻倍，不设上限——
 * 内核 arch/x86/kernel/cpu/common.c 的 cpu_vuln_whitelist 一张表就有 13 万个
 * token，固定 32768 的上限只能报"初始化器太大"。
 * 起点给 4 K 条：绝大多数初始化器都装得下，而按 32768 条（1 MB）一刀切会
 * 让每个 `T x[] = {…}` 都吃掉 1 MB 永不回收的 arena。 */
#define CAP_CHUNK0 4096
static u32 body_capture(Tok **pout, u32 *pcap)
{
    int depth = 0;
    u32 n = 0;
    u32 cur = 0;
    u32 bound = 0;
    int at_item = 1;
    int in_desig = 0;
    int desig_seen = 0;
    u32 desig_last = 0;
    u32 cap = CAP_CHUNK0;
    Tok *out = arena_alloc(&A_main, (size_t)cap * sizeof(Tok));

    for (;;) {
        Tok *t = pa_cur();

        if (t->kind == TK_EOF)
            break;
        if (t->kind == TK_PUNCT) {
            if (TOK_EQ(t, "{")) {
                if (depth == 1 && at_item) {
                    at_item = 0;
                    cur++;
                    if (cur > bound)
                        bound = cur;
                }
                depth++;
            } else if (TOK_EQ(t, "}")) {
                depth--;
            } else if (depth == 1) {
                if (in_desig) {
                    /* 设计符里的数字是 TK_NUM，不走这条标点分支（见下面非标点
                     * 那条）；这里只管收尾的 `]`。 */
                    if (TOK_EQ(t, "]")) {
                        in_desig = 0;
                        cur = desig_seen ? desig_last + 1 : cur + 1;
                        if (cur > bound)
                            bound = cur;
                    }
                } else if (tok_eq(t, ",")) {
                    at_item = 1;
                } else if (at_item) {
                    at_item = 0;
                    if (TOK_EQ(t, "[")) {
                        in_desig = 1;
                        desig_seen = 0;
                        desig_last = 0;
                    } else if (TOK_EQ(t, ".")) {
                        /* 成员设计符 `.m = …`：不推进数组游标 */
                    } else {
                        cur++;
                        if (cur > bound)
                            bound = cur;
                    }
                }
            }
        } else if (depth == 1 && in_desig) {
            /* `[N]` / `[a ... b]`：取最后一个数当游标终点 */
            int ok = t->kind == TK_NUM;
            u32 v = 0;
            u32 j = 0;

            if (ok) {
                for (j = 0; j < t->len; j++) {
                    char ch = t->syn[j];

                    if (ch < '0' || ch > '9') {
                        ok = 0;
                        break;
                    }
                    v = v * 10 + (u32)(ch - '0');
                }
            }
            if (ok) {
                desig_last = v;
                desig_seen = 1;
            }
        } else if (depth == 1 && at_item) {
            at_item = 0;
            cur++;
            if (cur > bound)
                bound = cur;
        }
        if (n == cap) {
            u32 ncap = cap * 2;
            Tok *nb = arena_alloc(&A_main, (size_t)ncap * sizeof(Tok));

            memcpy(nb, out, (size_t)cap * sizeof(Tok));
            out = nb;
            cap = ncap;
        }
        out[n] = *t;
        n++;
        pa_advance();
        if (depth == 0)
            break;
    }
    CAP_BOUND = bound;
    *pout = out;
    *pcap = cap;
    return n;
}

/* 把一段 token 塞回输入流的前面。**必须先腾空前瞻缓冲**：pa_src_push 只认
 * token 流，已经 peek 出来的那些不腾空就会和推回去的重复/错位。 */
static void pa_push_tokens(Tok *t, u32 n)
{
    if (PA_HAVE > 0) {
        Tok *save = arena_alloc(&A_main, (size_t)PA_HAVE * sizeof(Tok));
        u32 ns = (u32)PA_HAVE;
        u32 q = 0;

        for (q = 0; q < ns; q++)
            save[q] = *pa_peek((int)q);
        pa_win_clear();
        pa_src_push(save, ns);
    }
    pa_src_push(t, n);
}

static u32 parse_struct_body(u32 complete_id, u32 tag, int is_union)
{
    u32 cap = AGG_MEM_CAP0;
    u32 *mem = arena_alloc(&A_main, (size_t)cap * sizeof(u32));
    u32 *bits = arena_alloc(&A_main, (size_t)cap * sizeof(u32));
    const char **names = arena_alloc(&A_main, (size_t)cap * sizeof(char *));
    u32 *lens = arena_alloc(&A_main, (size_t)cap * sizeof(u32));
    u32 n = 0;
    u32 ty = 0;
    u8 mgd_idx[MGDST_FLD] = {0};
    u8 mgd_kind[MGDST_FLD] = {0};
    u8 mgd_cnt[MGDST_FLD] = {0};
    u32 nmgd_fld = 0;      /* 登记进 MGDST 的条目（含按值嵌套） */
    u32 nmgd_own = 0;      /* 本结构体自己拥有的托管字段（不含嵌套） */
    int saw_flex_mgd = 0;
    u16 def_file = pa_cur()->file;   /* 这个定义写在哪个翻译单元里 */
    u32 memb_align = 0;              /* 当前成员声明上的 aligned(N)，0 = 没写 */

    /* 体里有方法（出现了嵌套的 `{`）就先抓下来跑一遍"只登记签名"，
     * 再原样重放一遍正常解析。 */
    if (!PA_SIG_ONLY && PA_TMPL_BODY) {
        Tok *tmp = NULL;
        u32 tmpcap = 0;
        u32 e = body_capture(&tmp, &tmpcap);
        int nested = 0;

        if (e > 0 && !pa_is_ch('{')) {
            int d2 = 0;
            u32 i2 = 0;

            for (i2 = 0; i2 < e; i2++) {
                Tok *q = &tmp[i2];

                if (q->kind == TK_PUNCT && TOK_EQ(q, "{")) {
                    d2++;
                    if (d2 == 2) {
                        nested = 1;
                        break;
                    }
                }
            }
        }
        if (e > 0) {
            Tok *pb2 = arena_alloc(&A_main, (size_t)e * sizeof(Tok));
            Tok *pc2 = arena_alloc(&A_main, (size_t)e * sizeof(Tok));

            memcpy(pb2, tmp, (size_t)e * sizeof(Tok));
            memcpy(pc2, tmp, (size_t)e * sizeof(Tok));
            if (nested) {
                PA_SIG_ONLY = 1;
                pa_push_tokens(pb2, e);
                (void)parse_struct_body(complete_id, tag, is_union);
                PA_SIG_ONLY = 0;
            }
            pa_push_tokens(pc2, e);
        }
    }
    pa_expect_ch('{');
    PA_SAW_ENUM = 0;
    while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF) {
        u32 base = 0;
        int any = 0;
        int memb_is_enum = 0;
        int memb_method = 0;
        int base_mgd_ptr = 0;
        int base_mgd_kind = 0;

        PA_SAW_ENUM = 0;
        /* 结构体/联合体里的 `_Static_assert(expr, "msg");`（C11 6.7.2.1p2，
         * 不需要是完整声明）。内核 include/linux/compiler.h 的
         * __BUILD_BUG_ON_ZERO_MSG 正是这么写的：
         *     #define __BUILD_BUG_ON_ZERO_MSG(e, msg, ...) \
         *             ((int)sizeof(struct { _Static_assert(!(e), msg); }))
         * 少了这一支，它会被当成"没有返回类型的成员函数"，
         * 报 a member function needs a body —— 而 __must_be_array()
         * 在头文件里到处都是。 */
        if (PA_IS_IDENT("_Static_assert") || PA_IS_IDENT("static_assert")) {
            pa_advance();
            parse_static_assert_rest();
            (void)pa_accept_ch(';');
            continue;
        }
        /* 空声明 `;`：C 允许结构体体里出现孤立的空声明，它不占成员、不影响
         * 布局。内核的 `__SEQ_LOCK(x)` 在非 PREEMPT_RT 下展开为空，于是
         * `struct seqcount_spinlock { seqcount_t seqcount; ; }` 就带一个多余的
         * `;`。以前这里会把 `;` 当成无名成员，sizeof 从 4 变 8 —— 于是 c6c
         * 与 GCC 的布局从 seqcount_spinlock_t 起整体错开 8 字节，
         * init_task.thread.sp 落到 0xc60 而不是 asm-offsets.h 里的 0xc58。 */
        if (pa_is_ch(';')) {
            pa_advance();
            continue;
        }
        base = parse_typespec();
        memb_is_enum = PA_SAW_ENUM;
        /* 成员上的 `__attribute__((aligned(N)))` 写在**类型说明符之前**
         * （`A char a:4;` 里 A 就在 char 前面），parse_typespec 里那个
         * skip_attributes 已经把它记进 SAW_ALIGN 了——这里赶紧抄走，
         * 否则下面给"结构体级别"清位的时候就被扔掉（95_bitfields 的
         * WITH ALIGN 那一半靠它）。 */
        memb_align = SAW_ALIGN;
        SAW_ALIGN = 0;
        /* `@T a, b;`：`@` 是类型说明符的一部分（PA_MGD_PTR），
         * 而 parse_declarator 会把它吃掉清零——所以每个声明符之前都要补回来，
         * 否则第二个成员变成按值的 `T b`（托管字段登记成"嵌套"，释放时炸）。 */
        base_mgd_ptr = PA_MGD_PTR;
        base_mgd_kind = PA_MGD_KIND;

        for (;;) {
            Declarator d = {0};
            u32 mty = 0;

            PA_MGD_PTR = base_mgd_ptr;
            PA_MGD_KIND = base_mgd_kind;
            SAW_ALIGN = 0;      /* 结构体级别的 aligned 不能漏到成员上 */
            mty = parse_declarator(base, &d);
            /* 写在声明符后面的那种写法：`char a __attribute__((aligned(16)))` */
            if (SAW_ALIGN > memb_align)
                memb_align = SAW_ALIGN;
            SAW_ALIGN = 0;   /* 成员对齐已经抄进 memb_align，清掉免得外溢 */

            /* 结构体里放闭包 = 引用环：闭包可能捕获持有它的那个对象，而闭包
             * 的捕获表不能写成 weak（tests/errors/closure_cycle.c6）。 */
            if (ty_is_closure(mty, NULL) && in_c6_tu())
                pa_error("reference cycle: a closure member captures the object that "
                         "holds it; break it with 'weak' or 'own'");
            /* 结构体里"看着像函数"的成员：
             *   - 不带体（`T at(int i);`）—— 模板里也不许，方法必须有体；
             *   - 非模板结构体里带体 —— 普通结构体不能内联定义函数。 */
            if (ty_is_func(mty) && d.name) {
                if (!pa_is_ch('{'))
                    pa_error("a member function needs a body: write '%.*s(...) { ... }' "
                             "in the template", (int)d.nlen, d.name);
                /* 带体的成员函数只有**模板**结构体里才有意义：模板体是在实例化
                 * 时才重放的（`PA_TMPL_BODY`），那时才知道 `T` 是什么、接收者
                 * 类型是什么。普通结构体没有模板参数，方法写在外面。 */
                else if (!PA_TMPL_BODY)
                    pa_error("a function cannot be defined inside a struct: write '%.*s' "
                             "outside it", (int)d.nlen, d.name);
            }
            /* c6 结构体内的方法 */
            if (ty_is_func(mty) && d.name && pa_is_ch('{')) {
                u32 np = ty_func_nparams(mty);
                u32 ps[17] = {0};
                u32 i2 = 0;
                u32 self_ty = complete_id ? complete_id : tag;
                Sym *ms = NULL;

                ps[0] = ty_ptr(self_ty);
                for (i2 = 0; i2 < np && i2 < 16; i2++)
                    ps[i2 + 1] = ty_func_param(mty, i2);
                d.type = ty_func(ty_target(mty), ps, np + 1, 0);
                /* 全局登记：实例可能在块作用域里惰性展开，方法不能跟着块没掉 */
                ms = sym_add_gl(d.name, d.nlen, d.type, SC_GLOBAL);
                ms->is_func = 1;
                /* 链接名带上接收者类型：方法在 C 层面就是普通函数，同名就撞，
                 * 而 `port` 这种名字很容易和全局变量/别的函数同名（std/net/httpd.c6）。
                 * 调用点都走 ms->val，所以换个名字是安全的。 */
                {
                    char mn[320] = {0};

                    /* 模板实例里的方法按 `<实例名>_<方法名>` 命名——和普通
                     * 结构体的 `c6m_<方法>_<类型 id>` 不同：实例名本身就是
                     * 一个稳定的 C 标识符，测试（tests/generic.c6）能直接
                     * 写 `int Stack_int_4_cap(struct Stack_int_4 *);` 声明它，
                     * 两个 TU 之间也靠这个名字合成一份。 */
                    if (PA_TMPL_BODY && TMPL_INST_NM[0])
                        snprintf(mn, sizeof(mn), "%s_%s", TMPL_INST_NM, ms->name);
                    else
                        snprintf(mn, sizeof(mn), "c6m_%s_%u", ms->name,
                                 (unsigned)self_ty);
                    ms->val = (i64)x64_sym(&X64, emit_name(mn));
                }
                meth_add(ms, self_ty);
                if (ms->len == 4 && memcmp(ms->name, "drop", 4) == 0)
                    drop_reg(self_ty, (u32)ms->val);
                if (PA_SIG_ONLY) {
                    /* 第一遍：签名登记完就把方法体跳过去。
                     * 注意 skip_init_list 是"停在收尾 `}` 前"的，开头的 `{`
                     * 得先自己吃掉，否则它会一路吃到别的成员的 `}` 上。 */
                    pa_advance();
                    skip_init_list();
                    if (pa_is_ch('}'))
                        pa_advance();
                    memb_method = 1;
                    break;
                }
                METHOD_SELF_TY = self_ty;
                pa_func_def(ms, &d);
                METHOD_SELF_TY = 0;
                memb_method = 1;
                break;
            }
            if (n + 1 >= cap) {
                cap *= 2;
                mem = agg_grow(mem, n, cap, sizeof(u32));
                bits = agg_grow(bits, n, cap, sizeof(u32));
                names = agg_grow(names, n, cap, sizeof(char *));
                lens = agg_grow(lens, n, cap, sizeof(u32));
            }
            if (pa_accept_ch(':')) {
                u32 w = (u32)const_expr();

                /* 最高位标记"位域"；没有声明符的（`unsigned : 32;`）再加次高位
                 * 标记"无名"——这种不占初始化器位置、也不抬结构体对齐
                 * （见 type.c6 的布局）。`unsigned char a:4` 是有名字的，不能标。 */
                bits[n] = w | 0x80000000u | (d.name ? 0u : 0x2000u);
                if (memb_is_enum)
                    bits[n] |= 0x40000000u;  /* 枚举位域：取零扩展 */
            } else {
                bits[n] = 0;
            }
            /* 成员级 aligned(N)：编码 log2(N)+1 到 bits[] 的 14..29 位，
             * agg_layout 按这个把字段起点对到 N 字节边界（低 8 位是位域宽度、
             * 8..13 是单元内位偏移，最高两位是标志，中间空着）。 */
            if (memb_align > 1) {
                u32 v = (u32)memb_align;
                u32 lg = 0;

                while ((v >>= 1) != 0)
                    lg++;
                bits[n] |= ((lg + 1) & 0xFFFFu) << 14;
            }
            mem[n] = mty;
            names[n] = d.name;
            lens[n] = d.nlen;
            if (d.mgd && ty_is_array(mty) && ty_array_n(mty) == 0)
                saw_flex_mgd = 1;
            if (nmgd_fld < MGDST_FLD) {
                if (d.mgd) {
                    nmgd_own++;
                    mgd_idx[nmgd_fld] = (u8)n;
                    mgd_cnt[nmgd_fld] = 1;
                    if (d.mgd_kind == 1) {
                        /* 弱引用字段：不拥有对象（不进偏移表），但升级/赋值
                         * 时前端要知道它是托管的 */
                        mgd_kind[nmgd_fld] = 2;
                    } else if (d.mgd_kind == 2) {
                        /* `own @T`：所有权转移，不算引用环的边 */
                        mgd_kind[nmgd_fld] = 4;
                    } else if (ty_is_array(mty) && ty_is_ptr(ty_target(mty))) {
                        mgd_kind[nmgd_fld] = 1;
                        mgd_cnt[nmgd_fld] = (u8)(ty_array_n(mty) > 255 ? 255 : ty_array_n(mty));
                    } else {
                        mgd_kind[nmgd_fld] = 0;
                    }
                    nmgd_fld++;
                } else if (!d.mgd && ty_is_agg(mty)) {
                    /* 按值嵌套的结构体：它的托管字段也要跟着释放 */
                    mgd_idx[nmgd_fld] = (u8)n;
                    mgd_kind[nmgd_fld] = 3;
                    mgd_cnt[nmgd_fld] = 1;
                    nmgd_fld++;
                }
            }
            n++;
            any = 1;
            if (!pa_accept_ch(','))
                break;
        }
        (void)any;
        if (!memb_method)
            pa_expect_ch(';');
        /* 增量注册已看到的成员（方法体只能看到前面声明的成员） */
        if (n > 0) {
            u32 t2 = complete_id ? ty_agg_complete(complete_id, mem, bits, n, is_union)
                                 : ty_agg(mem, bits, n, is_union, tag);

            agg_names_set(t2, names, lens, n);
        }
    }
    pa_expect_ch('}');
    /* `} __attribute__((aligned(N)))` / `} __packed`：属性写在**花括号后面**
     * 这一形态要在算布局之前吃掉，TY_ALIGN/TY_PACK 才会被 agg_layout 看见。
     *
     * 少了这一条，内核 `struct page` 的尾部
     *     } __attribute__((__aligned__(2 * sizeof(unsigned long))));
     * 就被忽略，sizeof 给 56 而 gcc 给 64（对齐 16 要向上取整到 64）。
     * 于是 mm/slab 的
     *     static_assert(sizeof(struct slab) <= sizeof(struct page));
     * 假失败——实测 mm/ 下 9 个文件都卡在这条。
     *
     * 属性只作用于这一个结构体：调用方在进体前把 TY_PACK/TY_ALIGN 存档、
     * 出体后还原（见 NPACK_SAVE），所以这里改它们不会外溢。 */
    {
        int save_pk2 = TY_PACK;
        int save_al2 = TY_ALIGN;

        SAW_PACKED = 0;
        SAW_ALIGN = 0;
        skip_attributes();
        if (SAW_PACKED) {
            TY_PACK = 1;
            SAW_PACKED = 0;
        }
        if (SAW_ALIGN > 0) {
            TY_ALIGN = SAW_ALIGN;
            SAW_ALIGN = 0;
        }
        ty = complete_id ? ty_agg_complete(complete_id, mem, bits, n, is_union)
                         : ty_agg(mem, bits, n, is_union, tag);
        TY_PACK = save_pk2;
        TY_ALIGN = save_al2;
    }
    if (getenv("C6C_DBG_AGG"))
        fprintf(stderr, "       [dbg] struct ty=%u members=%u\n",
                (unsigned)ty, (unsigned)n);
    agg_names_set(ty, names, lens, n);
    if (DEF_DEPTH > 0)
        local_agg_mark(ty);
    if (nmgd_fld)
        mgdst_add(ty, mgd_idx, mgd_kind, mgd_cnt, nmgd_fld, (u32)def_file);
    if (nmgd_own && in_c6_tu()) {
        char dnm[160] = {0};

        agg_disp_name(ty, dnm, sizeof(dnm));
        if (saw_flex_mgd)
            pa_error("'%s' has a flexible array of managed references: "
                     "allocate it with 'new T[n]' instead", dnm);
        else if (is_union)
            pa_error("'%s' is a union with a managed field: which member is alive "
                     "cannot be known, use a struct", dnm);
        else if (DEF_DEPTH > 0 && !tmpl_inst_name(ty))
            pa_error("'%s' holds managed references and is defined in a block: "
                     "define it at file scope", dnm);
    }
    return ty;
}

static u32 parse_enum_spec(void);

/* `struct Tag` / `union Tag` / `enum {...}` */
/* c6 里 `struct Bitset { … }` 同时给出类型名 `Bitset`（不用 typedef）。
 * 只在 .c6 源文件里这么做——C 源码里同名标识符可能有别的含义。 */
static void c6_auto_typedef(const char *nm, u32 len, u32 ty)
{
    Sym *s = NULL;
    u32 n = 0;

    if (!CUR_FILE || !CUR_FILE->path)
        return;
    n = (u32)strlen(CUR_FILE->path);
    if (n < 3 || memcmp(CUR_FILE->path + n - 3, ".c6", 3) != 0)
        return;
    s = sym_find(nm, len);
    if (s && s->kind == SC_TYPEDEF)
        return;
    if (s)
        return;                  /* 已经有同名符号，不抢 */
    sym_add(nm, len, ty, SC_TYPEDEF);
}

/* `import a.b.c;`：把模块源码当"文本包含"读进来（单 TU 口径）。
 * 已导入过的按路径去重；找不到就报错（不静默）。 */
static const char *IMPORTED[256];
static u32 NIMPORTED;

static void c6_import(const char *path)
{
    SrcFile *f = NULL;
    u32 i = 0;
    int di = 0;

    for (i = 0; i < NIMPORTED; i++)
        if (strcmp(IMPORTED[i], path) == 0)
            return;                      /* 已经导入过 */
    f = find_include(path, 1, 0, &di);
    if (!f) {
        pa_error("找不到模块 '%s'（按 include 路径找 %s）", path, path);
        return;
    }
    if (NIMPORTED < 256)
        IMPORTED[NIMPORTED++] = arena_strdup(&A_main, path);
    pp_push_file(f, di);
}

/* c6 切片 `T[:]`：规范就是 `struct { T *const data; const size_t len; }`。
 * 这里按元素类型造（并缓存）一个这样的结构体类型，于是 `.data`/`.len`、
 * 按值传参、sizeof 全都直接复用现有的聚合支持；`s[i]` 在 gen_postfix 里
 * 改写成 `s.data[i]`（边界检查还没做，见 todo P6-3）。 */
#define SLICE_CACHE_MAX 256
static u32 SLICE_ET[SLICE_CACHE_MAX];
static u32 SLICE_TY[SLICE_CACHE_MAX];
static u32 NSLICE;

static u32 ty_slice(u32 et)
{
    u32 i = 0;
    u32 mem[2] = {0};
    u32 ty = 0;
    const char *names[2] = {"data", "len"};
    u32 lens[2] = {4, 3};

    for (i = 0; i < NSLICE; i++)
        if (SLICE_ET[i] == et)
            return SLICE_TY[i];
    mem[0] = ty_ptr(et);
    mem[1] = ty_ulong();
    ty = ty_agg(mem, NULL, 2, 0, 1u + (u32)(sym_hash_str("slice", 5) & 0x7FFFFFFFu)
                + NSLICE);
    agg_names_set(ty, names, lens, 2);
    if (NSLICE < SLICE_CACHE_MAX) {
        SLICE_ET[NSLICE] = et;
        SLICE_TY[NSLICE] = ty;
        NSLICE++;
    }
    return ty;
}


/* 是不是切片类型（ty_slice 造出来的那些） */
static int ty_is_slice(u32 ty)
{
    u32 i = 0;

    for (i = 0; i < NSLICE; i++)
        if (SLICE_TY[i] == ty)
            return 1;
    return 0;
}

static u32 ty_slice_elem(u32 ty)
{
    u32 i = 0;

    for (i = 0; i < NSLICE; i++)
        if (SLICE_TY[i] == ty)
            return SLICE_ET[i];
    return ty_int();
}

/* c6 `catch e { … }` 里 `e` 的类型：错误载荷 `{ int id; }`（最小版）。
 * 完整规范里载荷还有模块号段、消息指针等，见 docs/manual/errors.md。 */
static u32 ERRPAY_TY;

static u32 ty_errpay(void)
{
    u32 mem[2] = {0};
    const char *names[2] = {"id", "msg"};
    u32 lens[2] = {2, 3};

    if (!ERRPAY_TY) {
        mem[0] = ty_int();
        mem[1] = ty_ptr(ty_char());
        ERRPAY_TY = ty_agg(mem, NULL, 2, 0, 1u + (u32)(sym_hash_str("errpay", 6) & 0x7FFFFFFFu));
        agg_names_set(ERRPAY_TY, names, lens, 2);
    }
    return ERRPAY_TY;
}

/* ---------- 模板表（泛型）---------- */
#define TMPL_MAX 64

#define TMPL_NPARAM 4
#define TMPL_NINST 8

typedef struct Tmpl {
    const char *name;
    u32 nlen;
    const char *param[TMPL_NPARAM];
    u32 plen[TMPL_NPARAM];
    int pkind[TMPL_NPARAM];        /* 0 = 类型形参，1 = 值形参（常量） */
    u32 pvty[TMPL_NPARAM];         /* 值形参声明的类型（范围检查用） */
    u32 nparam;
    Tok *toks;
    u32 n;
    int is_union;
    int is_func;
    int is_typedef;                /* `|T| typedef <spec> <名字>;` */
    u32 name_i;
    u32 body_i;
    u32 ninst;
    u32 inst_arg[TMPL_NINST][TMPL_NPARAM];
    u32 inst_res[TMPL_NINST];
} Tmpl;

static Tmpl TMPL[TMPL_MAX];
static u32 NTMPL;

static Tmpl *tmpl_find(const char *nm, u32 nl)
{
    u32 i = 0;

    for (i = 0; i < NTMPL; i++)
        if (TMPL[i].nlen == nl && memcmp(TMPL[i].name, nm, nl) == 0)
            return &TMPL[i];
    return NULL;
}

/* 类型 → mangle 片段（`Vect@int` → `Vect_int`）。跨 TU 的约定，所以只用
 * 类型名本身，不用 id。 */
static void tmpl_mangle(u32 ty, char *out, u32 cap)
{
    const char *nm = NULL;

    if (ty == ty_int()) nm = "int";
    else if (ty == ty_uint()) nm = "uint";
    else if (ty == ty_long()) nm = "long";
    else if (ty == ty_ulong()) nm = "ulong";
    else if (ty == ty_llong()) nm = "llong";
    else if (ty == ty_ullong()) nm = "ullong";
    else if (ty == ty_short()) nm = "short";
    else if (ty == ty_ushort()) nm = "ushort";
    else if (ty == ty_char()) nm = "char";
    else if (ty == ty_schar()) nm = "schar";
    else if (ty == ty_uchar()) nm = "uchar";
    else if (ty == ty_float()) nm = "float";
    else if (ty == ty_bf16()) nm = "bf16";
    else if (ty == ty_double()) nm = "double";
    else if (ty == ty_void()) nm = "void";
    if (nm) {
        snprintf(out, cap, "%s", nm);
        return;
    }
    if (ty_is_ptr(ty)) {
        char sub[64] = {0};

        tmpl_mangle(ty_target(ty), sub, sizeof(sub));
        snprintf(out, cap, "p_%s", sub);
        return;
    }
    snprintf(out, cap, "t%u", (unsigned)ty);
}

typedef struct TmplSaved {
    IrFn fn;
    u32 ret;
    u32 sret;                  /* 聚合返回的结果槽（C99 后端专用，见 CUR_SRET） */
    int sret_on;               /* 有没有结果槽：不能用 vreg 0 当哨兵 */
    u32 self_ty;               /* 裸字段（`v` == `self->v`）靠它，模板实例化会改 */
    int loop;
    int sw;
    u32 nglbl;
    int dd;
    int ndf;
} TmplSaved;

static TmplSaved tmpl_sv;

static void tmpl_save_state(TmplSaved *sv);
static void tmpl_restore_state(TmplSaved *sv);

static u32 tmpl_inst(Tmpl *t, const u32 *args)
{
    u32 i = 0;
    u32 k = 0;
    u32 ty = 0;
    u32 tag = 0;
    u32 cid = 0;
    char m[256] = {0};
    char nm[320] = {0};
    char inst_nm_sv[sizeof(TMPL_INST_NM)] = {0};
    int tmpl_body_sv = 0;
    Sym *s = NULL;

    for (i = 0; i < t->ninst; i++) {
        int same = 1;

        for (k = 0; k < t->nparam; k++)
            if (t->inst_arg[i][k] != args[k])
                same = 0;
        if (same)
            return t->inst_res[i];
    }
    m[0] = 0;
    for (k = 0; k < t->nparam; k++) {
        char one[96] = {0};

        if (t->pkind[k])
            snprintf(one, sizeof(one), "%d", (int)args[k]);
        else
            tmpl_mangle(args[k], one, sizeof(one));
        if (k)
            strncat(m, "_", sizeof(m) - strlen(m) - 1);
        strncat(m, one, sizeof(m) - strlen(m) - 1);
    }
    snprintf(nm, sizeof(nm), "%.*s_%s", (int)t->nlen, t->name, m);
    tag = 1u + (u32)(sym_hash_str(nm, (u32)strlen(nm)) & 0x7FFFFFFFu);
    /* 先登记一个不完整类型占位并立刻进缓存：模板体里可能引用它自己
     * （`struct Node@T { Node@T *next; }`）。 */
    {
        u32 inc = ty_agg(NULL, NULL, 0, t->is_union, tag);

        if (NTINST < TINST_MAX && !tmpl_inst_name(inc)) {
            u32 q3 = 0;

            TINST_ID[NTINST] = inc;
            for (q3 = 0; q3 + 1 < 96 && nm[q3]; q3++)
                TINST_NM[NTINST][q3] = nm[q3];
            TINST_NM[NTINST][q3] = 0;
            NTINST++;
        }
        /* 实例名撞上已经存在的 tag（`struct Vect_int { … };` + `Vect@int`）：
         * 两个不同的类型用同一个 C 名字，链接/调试都说不清
         * （tests/errors/generic.c6 的 test_instance_name_taken）。 */
        {
            Sym *ex = sym_find_tag(nm, (u32)strlen(nm));

            /* 第二个 TU 里再写一遍同一个实例是合法的（类型表跨 TU 共享，
             * 占位类型 id 会不一样）——只有撞上**用户写的**同名结构体才报。 */
            if (ex && !tmpl_inst_name((u32)ex->val))
                pa_error("the instance name '%s' is already in use", nm);
        }
        s = sym_add_tag(nm, (u32)strlen(nm), inc);
        s->val = (i64)inc;
        cid = inc;
        if (t->ninst < TMPL_NINST) {
            for (k = 0; k < t->nparam; k++)
                t->inst_arg[t->ninst][k] = args[k];
            t->inst_res[t->ninst] = inc;
            t->ninst++;
        }
    }
    if (t->n == 0) {
        /* 前置声明的模板（`struct Fwd@T;`）：没有体，实例化出一个不完整类型 */
        return cid;
    }
    scope_enter();
    for (k = 0; k < t->nparam; k++) {
        if (t->pkind[k]) {
            /* 值形参：绑成枚举常量，这样 `T data[N]` 里的 N 能进常量表达式 */
            Sym *e = sym_add(t->param[k], t->plen[k], ty_int(), SC_ENUMC);

            e->val = (i64)args[k];
        } else {
            sym_add(t->param[k], t->plen[k], args[k], SC_TYPEDEF);
        }
    }
    if (PA_HAVE > 0) {
        Tok *save = arena_alloc(&A_main, (size_t)PA_HAVE * sizeof(Tok));
        u32 ns = (u32)PA_HAVE;
        u32 q2 = 0;

        for (q2 = 0; q2 < ns; q2++)
            save[q2] = *pa_peek((int)q2);
        pa_win_clear();
        pa_src_push(save, ns);
    }
    pa_src_push(t->toks, t->n);
    RP_N++;
    /* typedef 模板：体是 `typedef` 后面的那段（`<spec> <名字>;`），
     * 重新解析一遍就是实例化结果。 */
    if (t->is_typedef) {
        u32 n0 = FN.n;
        IrOp *bak = arena_alloc(&A_main, (size_t)(n0 ? n0 : 1) * sizeof(IrOp));

        if (n0)
            memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
        tmpl_save_state(&tmpl_sv);
        /* `PA_TMPL_BODY` 要**存档再恢复**，不能直接清零：实例化是在解析中途
         * 发生的（模板体里的某个成员/方法体又展开了别的模板），清零会把外层
         * "正在重放模板体"的状态一并抹掉——外层剩下的成员会被当成普通结构体
         * 的成员（方法体于是报"不能在结构体里定义函数"，链接名也从
         * `<实例名>_<方法>` 掉回 `c6m_...`）。 */
        tmpl_body_sv = PA_TMPL_BODY;
        PA_TMPL_BODY = 1;
        ty = parse_typespec();
        while (pa_accept_ch('*'))
            ty = ty_ptr(ty);
        if (ty && pa_cur()->kind == TK_IDENT) {
            /* 顺手按实例名登记成 typedef，`MyVec@int x;` 这种写法也能直接用 */
            Sym *td = sym_add(nm, (u32)strlen(nm), ty, SC_TYPEDEF);

            (void)td;
            pa_advance();
        }
        (void)pa_accept_ch(';');
        PA_TMPL_BODY = tmpl_body_sv;
        tmpl_restore_state(&tmpl_sv);
        if (n0)
            memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
        if (RP_N > 0)
            RP_N--;
        scope_leave();
        for (i = 0; i < t->ninst; i++)
            if (t->inst_res[i] == cid)
                t->inst_res[i] = ty;
        return ty;
    }
    /* 模板体里可能带**方法**。方法是真函数，`pa_func_def` 会 irfn_reset +
     * 立刻发射——而实例化往往发生在另一个函数（比如 main）的声明中间，
     * 所以当前函数的 IR 状态必须整份存档/恢复，否则外层函数的指令被冲掉
     * （现象是"编译通过、运行时崩"）。存档/恢复的实现在后面（那里能看到
     * NLOOP 等全局），这里只留调用。 */
    {
        /* 光存 `IrFn` 那份快照不够：`FN.ops` 指向的是**共用**的缓冲区，
         * 方法发射时会把里面的指令整片覆盖掉，恢复快照只把 n 拨回来、
         * 内容已经是方法体的了。所以连内容一起备份。 */
        u32 n0 = FN.n;
        IrOp *bak = arena_alloc(&A_main, (size_t)(n0 ? n0 : 1) * sizeof(IrOp));

        if (n0)
            memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
        tmpl_save_state(&tmpl_sv);
        tmpl_body_sv = PA_TMPL_BODY;
        PA_TMPL_BODY = 1;
        memcpy(inst_nm_sv, TMPL_INST_NM, sizeof(inst_nm_sv));
        memcpy(TMPL_INST_NM, nm, sizeof(TMPL_INST_NM));
        TMPL_INST_NM[sizeof(TMPL_INST_NM) - 1] = 0;
        /* 外层可能正走在"只登记签名"的那一遍里（模板 A 的方法签名里用到
         * 模板 B 的实例）：B 的体必须在这里一次展开完。外层的第二遍不会
         * 再重放 B —— `tmpl_inst` 的缓存直接短路返回，于是 B 的方法只剩
         * 声明、没有定义，链接期报 `<实例名>_<方法>` 未定义（std 的
         * `Vect@T.iter()` 返回 `Iter@T`，`Iter_int_has` 就是这么丢的）。 */
        {
            int sig_sv = PA_SIG_ONLY;

            PA_SIG_ONLY = 0;
            ty = parse_struct_body(cid, tag, t->is_union);
            PA_SIG_ONLY = sig_sv;
        }
        memcpy(TMPL_INST_NM, inst_nm_sv, sizeof(inst_nm_sv));
        PA_TMPL_BODY = tmpl_body_sv;
        tmpl_restore_state(&tmpl_sv);
        if (n0)
            memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
    }
    /* 模板体里的**方法**是普通函数，但登记在了"模板参数作用域"里，
     * scope_leave 之后就查不到了（`d->count()` 找不到 count）。这里把它们
     * 提到外层重新登记一次。 */
    {
        const char *lnm[64] = {0};
        u32 llen[64] = {0};
        u32 lty[64] = {0};
        i64 lval[64] = {0};
        u32 ln = 0;
        Sym *p = SCOPE ? SCOPE->head : NULL;

        for (; p && ln < 64; p = p->scope_next) {
            if (!p->is_func)
                continue;
            lnm[ln] = p->name;
            llen[ln] = p->len;
            lty[ln] = p->type;
            lval[ln] = p->val;
            ln++;
        }
        if (RP_N > 0)
            RP_N--;
        scope_leave();
        for (k = 0; k < ln; k++) {
            Sym *g = sym_add(lnm[k], llen[k], lty[k], SC_GLOBAL);

            g->is_func = 1;
            g->val = lval[k];
        }
    }
    for (i = 0; i < t->ninst; i++)
        if (t->inst_res[i] == cid)
            t->inst_res[i] = ty;
    return ty;
}

/* 吃掉一段平衡的花括号，同时（CAP_ON 时）把 token 收进 CAP_TOK；返回
 * 匹配 `}` 之后的 token 个数，用来裁掉前瞻多拉的那些。 */
static u32 tmpl_capture_body(void)
{
    int depth = 0;
    u32 i = 0;
    u32 e = 0;

    CAP_N = 0;
    for (i = 0; i < (u32)PA_HAVE; i++) {
        Tok *q = pa_peek((int)i);

        if (CAP_N < CAP_MAX)
            CAP_TOK[CAP_N++] = *q;
    }
    {
        /* 没出现过 `{` 的时候（`|T| typedef T *Ptr;` 这类），配对的终止符
         * 不是 `}` 而是 `;`——否则会一路吃到文件尾，连解析器位置也推到 EOF。 */
        int seen_brace = 0;

        CAP_ON = 1;
        while (pa_cur()->kind != TK_EOF) {
            int last = 0;

            if (pa_is_ch('{')) {
                depth++;
                seen_brace = 1;
            } else if (pa_is_ch('}')) {
                depth--;
                last = (depth == 0);
            } else if (!seen_brace && pa_is_ch(';')) {
                last = 1;
            }
            pa_advance();
            if (last)
                break;
        }
        CAP_ON = 0;
        if (!seen_brace)
            return CAP_N;
    }
    depth = 0;
    for (i = 0; i < CAP_N; i++) {
        Tok *q = &CAP_TOK[i];

        if (q->kind == TK_PUNCT) {
            if (TOK_EQ(q, "{")) {
                depth++;
            } else if (TOK_EQ(q, "}")) {
                depth--;
                if (depth == 0) {
                    e = i + 1;
                    break;
                }
            }
        }
    }
    return e;
}

/* ---------- 函数模板 ----------
 * 实例化分两步走，因为调用点在**另一个函数的表达式中间**：
 *   ① 调用点只重放"签名"（把捕获的 token 从返回类型截到参数表结束，末尾补一个
 *      合成的 `;`）——这一步只登记符号，不碰当前函数的 IR；
 *   ② 函数体的重放排进 worklist，等当前这条顶层声明做完（此时 FN 空闲）
 *      再跑，跑出来的实例直接发射。
 * 这样就不用在表达式中间存档/恢复整个 IrFn（那样做会把外层函数的 IR 搅乱）。
 */
/* 模板实参只允许"类型说明符 + 若干 `*`"：用 parse_typename() 会把紧跟的
 * `(`（调用的实参表）当成函数声明符吃进去。 */
static u32 tmpl_arg_ty(int allow_ptr)
{
    u32 t = 0;
    int save = PA_TYPE_ATOM;

    PA_TYPE_ATOM = 1;
    t = parse_typespec();
    PA_TYPE_ATOM = save;

    /* 只有带括号的写法 `@(int *)` 才吃 `*`。不带括号时 `*` 属于**外层声明符**：
     * `Vect@T *self` 里那个星号是指向实例的指针，被当成模板实参就会变成
     * `Vect@(T*)`——成员指针于是指向指针，下标步长翻倍（踩过）。 */
    if (allow_ptr) {
        while (pa_accept_ch('*'))
            t = ty_ptr(t);
    }
    return t;
}

/* 模板的重复定义：同一个文件里同一个名字定义了两次就是重定义；定义成另一种
 * 东西（struct / union / 函数）另报一条"as a different kind"。模块文件是文本
 * 内联的，重复解析的位置完全一样，不算。 */
#define TMPLDEF_MAX 256
static const char *TMPLDEF_NM[TMPLDEF_MAX];
static u32 TMPLDEF_LEN[TMPLDEF_MAX];
static u16 TMPLDEF_FILE[TMPLDEF_MAX];
static u32 TMPLDEF_OFF[TMPLDEF_MAX];
static u8 TMPLDEF_KIND[TMPLDEF_MAX];
static int NTMPLDEF;

static void tmpl_def_check(const char *nm, u32 len, int kind)
{
    int i = 0;

    if (!pa_cur())
        return;
    for (i = 0; i < NTMPLDEF; i++)
        if (TMPLDEF_LEN[i] == len && memcmp(TMPLDEF_NM[i], nm, len) == 0) {
            if (TMPLDEF_FILE[i] != pa_cur()->file || TMPLDEF_OFF[i] == pa_cur()->off)
                return;
            if (TMPLDEF_KIND[i] != (u8)kind)
                pa_error("redefinition of template '%.*s' as a different kind",
                         (int)len, nm);
            else
                pa_error("redefinition of template '%.*s'", (int)len, nm);
            return;
        }
    if (NTMPLDEF < TMPLDEF_MAX) {
        TMPLDEF_NM[NTMPLDEF] = nm;
        TMPLDEF_LEN[NTMPLDEF] = len;
        TMPLDEF_FILE[NTMPLDEF] = pa_cur()->file;
        TMPLDEF_OFF[NTMPLDEF] = pa_cur()->off;
        TMPLDEF_KIND[NTMPLDEF] = (u8)kind;
        NTMPLDEF++;
    }
}

/* 按模板声明的形参种类解析实参表：类型形参吃类型，值形参吃常量表达式。 */
static u32 tmpl_parse_args(Tmpl *t, u32 *args, int paren)
{
    u32 na = 0;

    /* 值形参必须用括号形式实例化：`Arr@4` 里的 4 到底是类型还是值看不出来
     * （tests/errors/generic.c6 的 test_value_arg_parens）。 */
    if (!paren && t && t->nparam > 0 && t->pkind[0]
        && in_c6_tu())
        pa_error("'%.*s' takes a value argument here: write '%.*s@(...)'",
                 (int)t->nlen, t->name, (int)t->nlen, t->name);
    if (paren)
        pa_expect_ch('(');
    while (na < TMPL_NPARAM && na < t->nparam && pa_cur()->kind != TK_EOF) {
        if (paren && pa_is_ch(')'))
            break;
        if (t->pkind[na]) {
            i64 v4 = (i64)const_expr();
            u32 vty4 = t->pvty[na];

            /* 值实参要能装进形参声明的类型（`short N` 配 40000 就是错的）
             * ——tests/errors/generic.c6 的 test_value_arg_range。 */
            if (vty4 && ty_is_int(vty4) && in_c6_tu()) {
                u32 bits = ty_size(vty4) * 8;
                i64 lo4 = 0;
                i64 hi4 = 0;

                if (bits > 0 && bits < 64) {
                    if (ty_is_signed(vty4)) {
                        lo4 = -((i64)1 << (bits - 1));
                        hi4 = ((i64)1 << (bits - 1)) - 1;
                    } else {
                        lo4 = 0;
                        hi4 = ((i64)1 << bits) - 1;
                    }
                    if (v4 < lo4 || v4 > hi4)
                        pa_error("value argument %ld does not fit in '%s'", (long)v4,
                                 ty_disp(vty4));
                }
            }
            args[na] = (u32)v4;
        } else {
            int save_ta = PA_TMPL_ARG;

            PA_TMPL_ARG = 1;
            args[na] = tmpl_arg_ty(paren);
            PA_TMPL_ARG = save_ta;
        }
        na++;
        if (!paren)
            break;
        if (!pa_accept_ch(','))
            break;
    }
    if (paren)
        pa_expect_ch(')');
    /* 实参个数必须和形参个数对上（tests/errors/generic.c6 的 zero_arg 等） */
    if (t && t->name && na < t->nparam)
        pa_error("'%.*s' needs %u type argument(s) (got %u)",
                 (int)t->nlen, t->name, (unsigned)t->nparam, (unsigned)na);
    return na;
}

#define FW_MAX 32
static Tmpl *FW_T[FW_MAX];
static u32 FW_A[FW_MAX][TMPL_NPARAM];
static u32 NFW;

static Tok *tmpl_syn_semi(void)
{
    Tok *t = arena_alloc(&A_main, sizeof(Tok));
    Tok z = {0};

    z.kind = TK_PUNCT;
    z.len = 1;
    z.hash = sym_hash_str(";", 1);
    z.flags = TF_SYN;
    z.syn = arena_strdup(&A_main, ";");
    *t = z;
    return t;
}

/* 用捕获的 token 重放一段：`n` 个 token + 可选的结尾 `;`。
 * 函数名 token 换成 mangle 后的合成 token（同一段 token 要吐出 f_int、f_char…）。 */
static void tmpl_poke(Tmpl *t, u32 n, int semi, const char *mname)
{
    Tok *toks = arena_alloc(&A_main, (size_t)(n + 1) * sizeof(Tok));

    memcpy(toks, t->toks, (size_t)n * sizeof(Tok));
    if (mname && t->name_i < n) {
        u32 nl2 = (u32)strlen(mname);

        toks[t->name_i].flags |= TF_SYN;
        toks[t->name_i].syn = arena_strndup(&A_main, mname, nl2);
        toks[t->name_i].len = nl2;
        toks[t->name_i].hash = sym_hash_str(mname, nl2);
    }
    if (semi) {
        Tok *z = tmpl_syn_semi();

        toks[n] = *z;
        n++;
    }
    if (PA_HAVE > 0) {
        Tok *save = arena_alloc(&A_main, (size_t)PA_HAVE * sizeof(Tok));
        u32 ns = (u32)PA_HAVE;
        u32 q2 = 0;

        for (q2 = 0; q2 < ns; q2++)
            save[q2] = *pa_peek((int)q2);
        pa_win_clear();
        pa_src_push(save, ns);
    }
    pa_src_push(toks, n);
}

static void tmpl_bind_params(Tmpl *t, const u32 *args)
{
    u32 k = 0;

    scope_enter();
    for (k = 0; k < t->nparam; k++) {
        if (t->pkind[k]) {
            Sym *e = sym_add(t->param[k], t->plen[k], ty_int(), SC_ENUMC);

            e->val = (i64)args[k];
        } else {
            sym_add(t->param[k], t->plen[k], args[k], SC_TYPEDEF);
        }
    }
}

/* 把一个作用域里登记的符号提到全局（模板参数作用域里登记的符号出了作用域
 * 就看不见了） */
static void tmpl_lift(const char *nm, u32 nl)
{
    Sym *fs = sym_find(nm, nl);
    u32 fty = fs ? fs->type : 0;
    i64 fval = fs ? fs->val : 0;
    int ff = fs ? fs->is_func : 0;

    scope_leave();
    if (fs && fty && ff) {
        Sym *g = sym_add(nm, nl, fty, SC_GLOBAL);

        g->is_func = 1;
        g->val = fval;
    }
}

static void tmpl_mangle_name(Tmpl *t, const u32 *args, u32 na, char *nm, u32 cap)
{
    char m[256] = {0};
    u32 k = 0;

    m[0] = 0;
    for (k = 0; k < na; k++) {
        char one[96] = {0};

        tmpl_mangle(args[k], one, sizeof(one));
        if (k)
            strncat(m, "_", sizeof(m) - strlen(m) - 1);
        strncat(m, one, sizeof(m) - strlen(m) - 1);
    }
    snprintf(nm, cap, "%.*s_%s", (int)t->nlen, t->name, m);
}

/* ① 只登记签名。返回符号 id（失败返回 0） */
/* 某个类型是模板的实例？是的话把 (模板下标, 实参) 找回来——方法调用糖在
 * 找不到 ms 时靠它把 `|T| T vat(Vect@T *self, …)` 这类**函数模板**实例化。 */
static int tmpl_args_of_ty(u32 ty, u32 *args, u32 *na)
{
    u32 i = 0;
    u32 k = 0;

    for (i = 0; i < NTMPL; i++) {
        for (k = 0; k < TMPL[i].ninst; k++) {
            if (TMPL[i].inst_res[k] == ty) {
                u32 j = 0;

                for (j = 0; j < TMPL[i].nparam && j < TMPL_NPARAM; j++)
                    args[j] = TMPL[i].inst_arg[k][j];
                *na = TMPL[i].nparam;
                return (int)i;
            }
        }
    }
    return -1;
}

static u32 tmpl_func_sig(Tmpl *t, const u32 *args, u32 na)
{
    char nm[320] = {0};
    Sym *s = NULL;

    tmpl_mangle_name(t, args, na, nm, sizeof(nm));
    s = sym_find(nm, (u32)strlen(nm));
    if (s && s->is_func)
        return (u32)s->val;
    tmpl_bind_params(t, args);
    tmpl_poke(t, t->body_i, 1, nm);
    {
        u32 base = parse_typespec();

        gen_decl_from_spec(base);
    }
    tmpl_lift(nm, (u32)strlen(nm));
    s = sym_find(nm, (u32)strlen(nm));
    return (s && s->is_func) ? (u32)s->val : 0;
}

/* ② 重放函数体（只在顶层声明之间调用，FN 空闲） */
static void tmpl_func_body(Tmpl *t, const u32 *args, u32 na)
{
    char nm[320] = {0};
    Tok *toks = NULL;

    tmpl_mangle_name(t, args, na, nm, sizeof(nm));
    (void)toks;
    tmpl_bind_params(t, args);
    tmpl_poke(t, t->n, 0, nm);
    {
        u32 base = parse_typespec();

        gen_decl_from_spec(base);
    }
    tmpl_lift(nm, (u32)strlen(nm));
}

/* ---------- 函数字面量 ----------
 * `int(int n) { … }`：不捕获的匿名函数。签名就地解析（拿类型、登记符号、
 * 给调用方一个地址），函数体排队到**本函数发射之前**再发——`irfn_reset`
 * 只把 n 归零、不换缓冲区，所以在中间发会把本函数的指令就地覆盖掉。 */
#define FN_LIT_MAX 32

#define FL_CAP_MAX 16

typedef struct FnLit {
    Sym *sym;
    Declarator d;
    Tok *toks;
    u32 n;
    u32 fty;                 /* 声明里的函数类型（不含隐藏的 env 形参） */
    int ncap;                /* 捕获了几个外层变量（0 = 不捕获） */
    const char *cname[FL_CAP_MAX];
    u32 clen[FL_CAP_MAX];
    u32 cty[FL_CAP_MAX];
    u32 coff[FL_CAP_MAX];
    u32 envbytes;
} FnLit;

static FnLit FL[FN_LIT_MAX];
static u32 NFL;
static int FL_LAST;          /* 最近一次 fnlit_parse_sym 的 FL 下标 */


/* 闭包体发射期间的捕获表（pa_func_def 进来时登记成"环境里的变量"） */
static u32 FLCAP_N;
static const char *FLCAP_NAME[FL_CAP_MAX];
static u32 FLCAP_LEN[FL_CAP_MAX];
static u32 FLCAP_TY[FL_CAP_MAX];
static u32 FLCAP_OFF[FL_CAP_MAX];
#define CAP_SLOT_BIT 0x80000000u

static void fnlit_drain(void)
{
    while (NFL > 0) {
        u32 i = --NFL;
        u32 q = 0;

        if (PA_HAVE > 0) {
            Tok *save = arena_alloc(&A_main, (size_t)PA_HAVE * sizeof(Tok));
            u32 ns = (u32)PA_HAVE;

            for (q = 0; q < ns; q++)
                save[q] = *pa_peek((int)q);
            pa_win_clear();
            pa_src_push(save, ns);
        }
        pa_src_push(FL[i].toks, FL[i].n);
        FLCAP_N = (u32)FL[i].ncap;
        for (q = 0; q < FLCAP_N && q < FL_CAP_MAX; q++) {
            FLCAP_NAME[q] = FL[i].cname[q];
            FLCAP_LEN[q] = FL[i].clen[q];
            FLCAP_TY[q] = FL[i].cty[q];
            FLCAP_OFF[q] = FL[i].coff[q];
        }
        pa_func_def(FL[i].sym, &FL[i].d);
        FLCAP_N = 0;
    }
}

/* 把一个外层变量登记进字面量的捕获表（已经在表里就不重复）。 */
static void fnlit_add_capture(u32 fi, Tok *t, Sym *cs)
{
    u32 k2 = 0;

    for (k2 = 0; k2 < (u32)FL[fi].ncap; k2++)
        if (FL[fi].clen[k2] == t->len
            && memcmp(FL[fi].cname[k2], tok_data(t), t->len) == 0)
            return;
    if (FL[fi].ncap >= FL_CAP_MAX)
        return;
    {
        u32 csz = ty_size(cs->type);
        u32 kk = (u32)FL[fi].ncap;

        if (csz == 0)
            csz = 8;
        csz = (csz + 7u) & ~7u;
        FL[fi].cname[kk] = arena_strndup(&A_main, tok_data(t), t->len);
        FL[fi].clen[kk] = t->len;
        FL[fi].cty[kk] = cs->type;
        FL[fi].coff[kk] = 8 + FL[fi].envbytes;
        FL[fi].envbytes += csz;
        FL[fi].ncap++;
    }
}

/* 解析一个函数字面量：签名就地定，函数体排队。返回登记好的符号。 */
static u32 parse_param_list(u32 fnret, Declarator *d);

static Sym *fnlit_parse_sym(void)
{
    u32 ret = 0;
    int save_at = PA_TYPE_ATOM;
    Declarator d = {0};
    char nm[64] = {0};
    Sym *fs = NULL;
    static u32 NFNLIT;
    u32 ntok = 0;

    PA_TYPE_ATOM = 1;
    ret = parse_typespec();
    PA_TYPE_ATOM = save_at;
    snprintf(nm, sizeof(nm), "__fnlit_%u", (unsigned)NFNLIT++);
    d.name = arena_strdup(&A_main, nm);
    d.nlen = (u32)strlen(nm);
    pa_advance();                            /* '(' */
    d.type = parse_param_list(ret, &d);
    fs = sym_add(d.name, d.nlen, d.type, SC_GLOBAL);
    fs->is_func = 1;
    fs->val = (i64)x64_sym(&X64, emit_name(d.name));
    ntok = tmpl_capture_body();
    if (NFL < FN_LIT_MAX) {
        u32 fi = NFL;
        int prev_dot = 0;
        int k_skip = 0;

        FL[fi].sym = fs;
        FL[fi].d = d;
        FL[fi].n = ntok;
        FL[fi].fty = d.type;
        FL[fi].ncap = 0;
        FL[fi].envbytes = 0;
        FL[fi].toks = arena_alloc(&A_main, (size_t)(ntok ? ntok : 1) * sizeof(Tok));
        if (ntok)
            memcpy(FL[fi].toks, CAP_TOK, (size_t)ntok * sizeof(Tok));
        /* 体里引用的**外层**局部量/形参要拷进环境对象：体是排队到本函数
         * 发射前才发的，那时外层作用域已经没了，只能在这里先记下来。 */
        {
            u32 ti = 0;
            /* 体**自己**的形参和局部变量不算捕获。以前只按名字查外层符号，
             * `int p = 5;` 外层 + 体内 `int p = 0;` 就会把 p 抓进环境，字面量
             * 悄悄变成闭包对象，赋给普通函数指针后一跳就飞。 */
            const char *skip[64] = {0};
            u32 skipl[64] = {0};
            int nskip = 0;
            u32 pj = 0;

            for (pj = 0; pj < d.nparams && nskip < 64; pj++) {
                skip[nskip] = d.pname[pj];
                skipl[nskip] = d.plen[pj];
                nskip++;
            }
            {
                int decl = 0;

                for (ti = 0; ti < ntok && nskip < 64; ti++) {
                    Tok *t = &CAP_TOK[ti];

                    if (t->kind == TK_IDENT
                        && (TOK_EQ(t, "struct") || TOK_EQ(t, "union")
                            || TOK_EQ(t, "enum"))) {
                        ti++;
                        decl = 1;
                        continue;
                    }
                    if (is_typename_tok(t)) {
                        decl = 1;
                        continue;
                    }
                    if (decl && t->kind == TK_PUNCT && TOK_EQ(t, "*"))
                        continue;
                    if (decl && t->kind == TK_IDENT) {
                        skip[nskip] = tok_data(t);
                        skipl[nskip] = t->len;
                        nskip++;
                        decl = 0;
                        continue;
                    }
                    decl = 0;
                }
            }
            for (ti = 0; ti < ntok; ti++) {
                Tok *t = &CAP_TOK[ti];
                int isdot = (t->kind == TK_PUNCT
                             && (TOK_EQ(t, ".") || TOK_EQ(t, "->")));

                /* `sizeof(a)` / `typeof(a)` 里的名字**不求值**：数组、`own` 引用
                 * 这些"不能拷进环境"的东西出现在里面是合法的，不能当捕获
                 * （tests/closure.c6 的"sizeof 捕获：数组只做类型检查"）。 */
                if (t->kind == TK_IDENT
                    && (TOK_EQ(t, "sizeof") || TOK_EQ(t, "typeof")
                        || TOK_EQ(t, "__typeof__") || TOK_EQ(t, "__typeof")
                        || TOK_EQ(t, "alignof") || TOK_EQ(t, "_Alignof"))) {
                    if (ti + 1 < ntok && CAP_TOK[ti + 1].kind == TK_PUNCT
                        && tok_eq(&CAP_TOK[ti + 1], "(")) {
                        int sd = 0;
                        u32 sj = ti + 1;

                        for (; sj < ntok; sj++) {
                            if (CAP_TOK[sj].kind != TK_PUNCT)
                                continue;
                            if (tok_eq(&CAP_TOK[sj], "("))
                                sd++;
                            else if (tok_eq(&CAP_TOK[sj], ")")) {
                                sd--;
                                if (sd == 0)
                                    break;
                            }
                        }
                        /* 里面的名字**只做类型检查**：不报"不能捕获"，
                         * 但要静默登记进捕获表——函数体是排队到后面才发的，
                         * 不登记的话 `sizeof(a)` 里的 a 在体里就成了未声明。 */
                        {
                            u32 q4 = ti + 2;

                            for (; q4 < sj; q4++) {
                                if (CAP_TOK[q4].kind != TK_IDENT)
                                    continue;
                                {
                                    Sym *cs4 = sym_find(tok_data(&CAP_TOK[q4]),
                                                        CAP_TOK[q4].len);

                                    if (cs4 && (cs4->kind == SC_LOCAL
                                                || cs4->kind == SC_PARAM))
                                        fnlit_add_capture(fi, &CAP_TOK[q4], cs4);
                                }
                            }
                        }
                        ti = sj;              /* 整个 sizeof(…) 跳过 */
                    } else if (ti + 1 < ntok) {
                        ti++;
                    }
                    prev_dot = 0;
                    continue;
                }
                if (t->kind != TK_IDENT) {
                    prev_dot = isdot;
                    continue;
                }
                if (prev_dot) {
                    prev_dot = 0;
                    continue;
                }
                prev_dot = 0;
                {
                    int sk = 0;

                    for (k_skip = 0; k_skip < nskip; k_skip++)
                        if (skipl[k_skip] == t->len
                            && memcmp(skip[k_skip], tok_data(t), t->len) == 0)
                            sk = 1;
                    if (sk)
                        continue;
                }
                {
                    Sym *cs = sym_find(tok_data(t), t->len);
                    u32 k = 0;
                    int dup = 0;

                    if (!cs || (cs->kind != SC_LOCAL && cs->kind != SC_PARAM))
                        continue;
                    /* 能被拷进环境对象的只有"普通的值/托管引用"：
                     *   - `own` 引用会转移所有权，拷一份等于两份主人；
                     *   - `weak` 得先升级成 `@T`；
                     *   - 数组要按切片/指针传；
                     *   - 函数里声明的类型跨不过去
                     * （tests/errors/closure_capture_type.c6）。 */
                    if (cs->is_own) {
                        pa_error("a closure cannot capture '%.*s': an 'own' reference "
                                 "cannot be copied", (int)t->len, tok_data(t));
                        continue;
                    }
                    if (cs->is_mgd == 2) {
                        pa_error("a closure cannot capture '%.*s': upgrade the 'weak' "
                                 "reference to '@T' first", (int)t->len, tok_data(t));
                        continue;
                    }
                    if (ty_is_array(cs->type)) {
                        pa_error("a closure cannot capture the array '%.*s': pass a "
                                 "slice 'T[:]' or a pointer instead",
                                 (int)t->len, tok_data(t));
                        continue;
                    }
                    if (ty_is_agg(cs->type) && is_local_agg(cs->type)) {
                        pa_error("a closure cannot capture '%.*s': its type is declared "
                                 "in a block (move the type to file scope)",
                                 (int)t->len, tok_data(t));
                        continue;
                    }
                    /* 捕获另一个闭包（尤其是正在赋值的那个自己）：对象里存的是
                     * **旧值**，递归会拿到没初始化/过期的那份
                     * （tests/errors/closure_opaque.c6 的 test_self）。 */
                    if (ty_is_closure(cs->type, NULL)) {
                        pa_error("'%.*s' is captured by the closure being assigned to it: "
                                 "the closure would see the old value (use a named "
                                 "function for recursion)", (int)t->len, tok_data(t));
                        continue;
                    }
                    for (k = 0; k < (u32)FL[fi].ncap; k++)
                        if (FL[fi].clen[k] == t->len
                            && memcmp(FL[fi].cname[k], tok_data(t), t->len) == 0)
                            dup = 1;
                    if (dup || FL[fi].ncap >= FL_CAP_MAX)
                        continue;
                    {
                        u32 csz = ty_size(cs->type);
                        u32 k2 = (u32)FL[fi].ncap;

                        if (csz == 0)
                            csz = 8;
                        csz = (csz + 7u) & ~7u;
                        FL[fi].cname[k2] = arena_strndup(&A_main, tok_data(t), t->len);
                        FL[fi].clen[k2] = t->len;
                        FL[fi].cty[k2] = cs->type;
                        FL[fi].coff[k2] = 8 + FL[fi].envbytes;
                        FL[fi].envbytes += csz;
                        FL[fi].ncap++;
                    }
                }
            }
        }
        if (FL[fi].ncap > 0) {
            /* 捕获的闭包：函数体多一个隐藏首参 void *__env */
            Declarator nd = d;
            u32 k = 0;

            nd.nparams = d.nparams + 1;
            nd.pname[0] = "__env";
            nd.plen[0] = 5;
            nd.ptype[0] = ty_ptr(ty_void());
            for (k = 0; k < d.nparams && k + 1 < 16; k++) {
                nd.pname[k + 1] = d.pname[k];
                nd.plen[k + 1] = d.plen[k];
                nd.ptype[k + 1] = d.ptype[k];
            }
            FL[fi].d = nd;
            fs->type = ty_func(ret, nd.ptype, nd.nparams, 0);
        }
        FL_LAST = (int)fi;
        NFL++;
        E_CLOSURE_LIT = FL[fi].ncap > 0 ? 1 : 0;
        E_CLOSURE_NAME = FL[fi].ncap > 0 ? FL[fi].cname[0] : NULL;
    }
    return fs;
}

/* 把 worklist 跑空（顶层每做完一条声明调一次） */
static void tmpl_drain(void)
{
    u32 guard = 0;

    fnlit_drain();
    while (NFW > 0 && guard++ < 256) {
        u32 i = --NFW;
        u32 args[TMPL_NPARAM] = {0};
        u32 k = 0;

        for (k = 0; k < TMPL_NPARAM; k++)
            args[k] = FW_A[i][k];
        tmpl_func_body(FW_T[i], args, FW_T[i]->nparam);
    }
}


static u32 parse_agg_spec(int is_union)
{
    const char *tn = NULL;
    u32 tlen = 0;
    u32 tag = 0;
    u32 ty = 0;
    Sym *s = NULL;

    {
        int save_pk = TY_PACK;

        SAW_PACKED = 0;
        SAW_ALIGN = 0;
        skip_attributes();     /* `struct __attribute__((packed)) S {…}` */
        if (SAW_PACKED) {
            TY_PACK = 1;
            SAW_PACKED = 0;
        }
        ALIGN_SAVE[NPACK_SAVE & 31] = TY_ALIGN;
        if (SAW_ALIGN > 0) {
            TY_ALIGN = SAW_ALIGN;
            SAW_ALIGN = 0;
        }
        PACK_SAVE[NPACK_SAVE & 31] = save_pk;
        NPACK_SAVE++;
    }
    if (pa_cur()->kind == TK_IDENT && !pa_is_ch('{')) {
        /* 标签名走一张独立的表：用 SC_TAG 符号存 */
        tn = tok_data(pa_cur());
        tlen = pa_cur()->len;
        pa_advance();
    }
    /* 泛型：`struct Vect@T { … }` 是模板定义，`struct Vect@int` 是实例。
     * 实例化出来的类型名本身就是类型，前面不能再带 `struct`/`union`
     * （tests/errors/generic.c6 的 test_drop_struct）。 */
    if (tn && pa_is_ch('@')) {
        /* 往后找一个"这个 `@…` 是定义还是实例"的判据：跳过实参/形参表，
         * 后面跟 `{` 的是模板定义（`struct Vect@T { … }` /
         * `struct Vect@(T) { … }`），否则就是实例，而实例前面不能带
         * `struct`（tests/errors/generic.c6 的 test_drop_struct）。 */
        u32 lq = 1;
        int ld = 0;
        Tok *nx2 = NULL;

        if (pa_peek(lq) && pa_peek(lq)->kind == TK_PUNCT && tok_eq(pa_peek(lq), "(")) {
            for (; lq < PA_LOOK; lq++) {
                Tok *q2 = pa_peek(lq);

                if (!q2 || q2->kind == TK_EOF)
                    break;
                if (q2->kind != TK_PUNCT)
                    continue;
                if (tok_eq(q2, "(")) {
                    ld++;
                } else if (tok_eq(q2, ")")) {
                    ld--;
                    if (ld == 0) {
                        lq++;
                        break;
                    }
                }
            }
        } else {
            for (; lq < PA_LOOK; lq++) {
                Tok *q2 = pa_peek(lq);

                if (!q2 || q2->kind != TK_IDENT)
                    break;
                lq++;
                if (pa_peek(lq) && pa_peek(lq)->kind == TK_PUNCT && tok_eq(pa_peek(lq), ",")) {
                    lq++;
                    continue;
                }
                break;
            }
        }
        nx2 = pa_peek(lq);
        /* `{` = 定义、`;` = 模板的前置声明（`struct Fwd@T;`），两者都不是实例 */
        if (nx2 && !(nx2->kind == TK_PUNCT
                     && (TOK_EQ(nx2, "{") || TOK_EQ(nx2, ";"))))
            pa_error("an instance drops 'struct': write the instance name on its own");
    }
    if (tn && pa_is_ch('@')) {
        const char *pn = NULL;
        u32 plen = 0;
        const char *par_n[TMPL_NPARAM] = {0};
        u32 par_len[TMPL_NPARAM] = {0};
        int par_kind[TMPL_NPARAM] = {0};
        u32 par_vty[TMPL_NPARAM] = {0};
        u32 npar = 0;

        /* 两种形状：`@K` 一个参数，`@(K, V)` 多个。定义还是实例看参数表
         * 后面是不是 `{`——定义时参数是名字，实例时参数是类型。 */
        {
            int paren = 0;
            int is_def = 0;

            pa_advance();                 /* 吃掉 '@' */
            if (pa_is_ch('(')) {
                int depth = 0;
                int k = 0;

                paren = 1;
                /* 找匹配的 ')' 后面的那个 token */
                for (k = 0; k < PA_LOOK; k++) {
                    Tok *q = pa_peek(k);

                    if (q->kind != TK_PUNCT)
                        continue;
                    if (tok_eq(q, "(")) {
                        depth++;
                    } else if (tok_eq(q, ")")) {
                        depth--;
                        if (depth == 0) {
                            Tok *nx = pa_peek(k + 1);

                            is_def = (nx->kind == TK_PUNCT && TOK_EQ(nx, "{"));
                            break;
                        }
                    }
                }
            } else {
                Tok *p1 = pa_peek(0);
                Tok *p2 = pa_peek(1);

                is_def = (p1->kind == TK_IDENT && p2->kind == TK_PUNCT
                          && TOK_EQ(p2, "{"));
            }
            if (!is_def) {
                u32 args[TMPL_NPARAM] = {0};
                u32 na = 0;
                Tmpl *t0 = tmpl_find(tn, tlen);
                int save_nn = PA_NO_NAME;
                int was_fwd = 0;

                if (!t0 && !paren) {
                    /* 前置声明：`struct Fwd@T;`——模板只有声明没有体。形参就是
                     * 这一串标识符（逗号分隔），登记一个空模板，实例化出来的
                     * 是不完整类型（只能取指针）。 */
                    const char *fwd_n[TMPL_NPARAM] = {0};
                    u32 fwd_l[TMPL_NPARAM] = {0};
                    u32 nfa = 0;
                    int okfwd = 1;
                    u32 qf = 0;

                    for (;;) {
                        Tok *a1 = pa_peek(qf);
                        Tok *a2 = NULL;

                        if (!a1 || a1->kind != TK_IDENT) {
                            okfwd = 0;
                            break;
                        }
                        if (nfa < TMPL_NPARAM) {
                            fwd_n[nfa] = tok_data(a1);
                            fwd_l[nfa] = a1->len;
                            nfa++;
                        }
                        qf++;
                        a2 = pa_peek(qf);
                        if (a2 && a2->kind == TK_PUNCT && tok_eq(a2, ",")) {
                            qf++;
                            continue;
                        }
                        break;
                    }
                    if (okfwd && nfa > 0 && NTMPL < TMPL_MAX) {
                        Tmpl *tf = &TMPL[NTMPL];
                        u32 kf = 0;

                        memset(tf, 0, sizeof *tf);
                        tf->name = arena_strndup(&A_main, tn, tlen);
                        tf->nlen = tlen;
                        tf->nparam = nfa;
                        tf->is_union = is_union;
                        for (kf = 0; kf < nfa; kf++) {
                            tf->param[kf] = fwd_n[kf];
                            tf->plen[kf] = fwd_l[kf];
                            tf->pkind[kf] = 0;
                        }
                        NTMPL++;
                        t0 = tf;
                        was_fwd = 1;
                    }
                }
                if (!t0) {
                    pa_error("没有叫 '%.*s' 的模板", (int)tlen, tn);
                    pa_advance();
                    return ty_agg(NULL, NULL, 0, is_union, 0);
                }
                PA_NO_NAME = 1;
                na = tmpl_parse_args(t0, args, paren);
                PA_NO_NAME = save_nn;
                /* 前置声明的形参只是那串标识符：它们不是真正的类型名，
                 * 类型解析认不出来，会把 token 留在原地（`struct Fwd@T;`
                 * 的 `T` 于是被外面当成变量名，报一堆莫名其妙的错）。
                 * 这里按登记下来的形参个数补齐吃掉。 */
                if (was_fwd) {
                    while (pa_cur()->kind == TK_IDENT) {
                        pa_advance();
                        if (!pa_accept_ch(','))
                            break;
                    }
                }
                return tmpl_inst(t0, args);
            }
            /* 定义：收集参数名 */
            if (!paren) {
                if (pa_cur()->kind != TK_IDENT) {
                    pa_error("模板参数名要一个标识符");
                    return ty_int();
                }
                par_n[0] = tok_data(pa_cur());
                par_len[0] = pa_cur()->len;
                npar = 1;
                pa_advance();
            } else {
                pa_expect_ch('(');
                while (npar < TMPL_NPARAM && !pa_is_ch(')')) {
                    /* 两种写法：`T`（类型形参）/ `int N`（值形参，按常量绑定） */
                    if (pa_cur()->kind != TK_IDENT)
                        break;
                    if (pa_peek(1)->kind == TK_IDENT) {
                        u32 vpty2 = parse_typespec();   /* 值形参的类型 */

                        if (npar < TMPL_NPARAM)
                            par_vty[npar] = vpty2;
                        if (vpty2 && ty_size(vpty2) > 4)
                            pa_error("a value parameter must be an integer type no "
                                     "wider than 'int'");
                        if (pa_cur()->kind == TK_IDENT) {
                            par_n[npar] = tok_data(pa_cur());
                            par_len[npar] = pa_cur()->len;
                            par_kind[npar] = 1;
                            npar++;
                            pa_advance();
                        }
                    } else {
                        par_n[npar] = tok_data(pa_cur());
                        par_len[npar] = pa_cur()->len;
                        par_kind[npar] = 0;
                        npar++;
                        pa_advance();
                    }
                    if (!pa_accept_ch(','))
                        break;
                }
                pa_expect_ch(')');
            }
            pn = par_n[0];
            plen = par_len[0];
        }
        if (pa_is_ch('{')) {
            /* 定义：只捕获 token，不解析（参数名此刻还没有具体类型） */
            u32 ntok = tmpl_capture_body();
            Tmpl *t = NULL;
            u32 ti = 0;

            /* 模板表**跨 TU 保留**（token 串要等下个 TU 开头才能安全释放），
             * 所以第二个 TU 再写一遍同一个模板时会命中上一个 TU 留下的那格。
             * 必须**就地覆盖**：否则 `tmpl_find` 返回的是旧的那格，它的
             * 实例缓存（ninst）里已经有 `Vect_int`，实例化直接短路返回，
             * 这个 TU 里就没有 `Vect_int_at` 这个方法（tests/tu/generic.c6
             * 的 `p->at(0)` 就是这么挂的）。 */
            for (ti = 0; ti < NTMPL; ti++)
                if (TMPL[ti].nlen == tlen
                    && memcmp(TMPL[ti].name, tn, (size_t)tlen) == 0
                    && TMPL[ti].nparam == npar) {
                    t = &TMPL[ti];
                    break;
                }
            if (!t) {
                if (NTMPL >= TMPL_MAX) {
                    pa_error("模板太多（上限 %d）", TMPL_MAX);
                    return ty_int();
                }
                t = &TMPL[NTMPL++];
            }
            tmpl_def_check(arena_strndup(&A_main, tn, tlen), tlen, is_union ? 1 : 0);
            t->name = arena_strndup(&A_main, tn, tlen);
            t->nlen = tlen;
            t->nparam = npar;
            {
                u32 pk = 0;

                for (pk = 0; pk < npar; pk++) {
                    t->param[pk] = arena_strndup(&A_main, par_n[pk], par_len[pk]);
                    t->plen[pk] = par_len[pk];
                    t->pkind[pk] = par_kind[pk];
                    t->pvty[pk] = par_vty[pk];
                }
            }
            t->n = ntok;
            t->toks = arena_alloc(&A_main, (size_t)(ntok ? ntok : 1) * sizeof(Tok));
            if (ntok)
                memcpy(t->toks, CAP_TOK, (size_t)ntok * sizeof(Tok));
            t->is_union = is_union;
            t->ninst = 0;
            return ty_int();       /* 定义本身不产生类型；声明处会忽略 */
        }
    }
    if (pa_is_ch('{')) {
        char nm[256] = {0};
        u32 k = tlen < 200 ? tlen : 200;
        u32 cid = 0;

        if (tn) {
            tag = 1u + (u32)(sym_hash_str(tn, tlen) & 0x7FFFFFFFu);
            memcpy(nm, tn, k);
            /* 定义体里可能出现自引用（`struct Sym { struct Sym *next; }`），
             * 所以先把标签登记成一个**不完整类型**占位，成员解析时就能看到；
             * 等成员表解析完再就地补全同一个 id。 */
            s = sym_find_tag(nm, k);
            /* 同名标签在外层作用域：内层这次定义要新建一层来遮蔽它 */
            if (s && !sym_in_cur_scope(s))
                s = NULL;
            if (!s) {
                u32 inc = ty_agg(NULL, NULL, 0, is_union, tag);

                s = sym_add_tag(nm, k, inc);
                s->val = (i64)inc;
            }
            if (ty_is_agg((u32)s->val) && ty_member_n((u32)s->val) == 0)
                cid = (u32)s->val;
            /* 先把"标签也是类型名"登记上，再解析体：方法体里会写 `F r;`
             * （`F` 就是正在定义的这个结构体），登记晚了就解析不出来，
             * 报"未声明的标识符 'F'"。占位类型是就地补全的，先登记不影响。 */
            c6_auto_typedef(nm, k, (u32)s->val);
        }
        ty = parse_struct_body(cid, tag, is_union);
        if (NPACK_SAVE > 0) {
            NPACK_SAVE--;
            TY_PACK = PACK_SAVE[NPACK_SAVE & 31];
            TY_ALIGN = ALIGN_SAVE[NPACK_SAVE & 31];
        }
        /* `struct Vect@int v;`：实例化出来的类型名本身就是类型，前面不能再
         * 带 `struct`（tests/errors/generic.c6 的 test_drop_struct）。 */
        if (pa_is_ch('@'))
            pa_error("an instance drops 'struct': write the instance name on its own");
        if (tn) {
            if (s)
                s->val = (i64)ty;
            else {
                s = sym_add_tag(nm, k, ty);
                s->val = (i64)ty;
            }
            c6_auto_typedef(nm, k, ty);
        }
        return ty;
    }
    if (!tn) {
        pa_error("struct/union 缺标签名");
        return ty_int();
    }
    {
        char nm[256] = {0};
        u32 k = tlen < 200 ? tlen : 200;

        memcpy(nm, tn, k);
        s = sym_find_tag(nm, k);
        if (s)
            return (u32)s->val;
    }
    /* 前置声明 `struct S *p;`：给一个不完整类型 */
    {
        char nm[256] = {0};
        u32 k = tlen < 200 ? tlen : 200;
        u32 hv = 0;

        memcpy(nm, tn, k);
        hv = sym_hash_str(nm, k);
        if (PA_IN_PROTO) {
            /* interface 签名里的 tag：原型作用域，和文件作用域的同名 tag
             * 是两个类型，所以换一个 intern 键、并且**不登记**到标签表。 */
            ty = ty_agg(NULL, NULL, 0, is_union,
                        1u + (u32)((hv ^ PROTO_TAG_KEY) & 0x7FFFFFFFu));
            sym_tag_disp(nm, k, ty);
            return ty;
        }
        ty = ty_agg(NULL, NULL, 0, is_union, 1u + (u32)(hv & 0x7FFFFFFFu));
        s = sym_add_tag(nm, k, ty);
        s->val = (i64)ty;
    }
    return ty;
}

/* 有没有出现过带标签的枚举（`enum Color {…}`）。有的话 `Color.RED` 这种
 * 限定常量名才可能存在，标识符分派里那条检查才需要跑。 */
static int HAS_ENUM_TAG;

/* 两个枚举都定义了同名成员时，裸名就有歧义：用的时候必须写限定名
 * （tests/errors/enum_scope.c6 的 test_ambiguous_bare）。 */
#define POISON_MAX 256
static char POISON_NM[POISON_MAX][64];
static int NPOISON;

static void poison_add(const char *nm, u32 k)
{
    int i = 0;

    if (k >= 64)
        k = 63;
    for (i = 0; i < NPOISON; i++)
        if (memcmp(POISON_NM[i], nm, k) == 0 && POISON_NM[i][k] == 0)
            return;
    if (NPOISON < POISON_MAX) {
        memcpy(POISON_NM[NPOISON], nm, k);
        POISON_NM[NPOISON][k] = 0;
        NPOISON++;
    }
}

static int poison_find(const char *nm, u32 k)
{
    int i = 0;

    for (i = 0; i < NPOISON; i++)
        if (strlen(POISON_NM[i]) == k && memcmp(POISON_NM[i], nm, k) == 0)
            return 1;
    return 0;
}

/* enum：常量塞进符号表（SC_ENUMC），类型按 int（C 的整数提升一致） */
static u32 parse_enum_spec(void)
{
    PA_SAW_ENUM = 1;
    u32 val = 0;
    char etag[200] = {0};
    u32 etaglen = 0;
    int has_tag = 0;
    /* 模块里的 `enum Error` 就是它的错误码表：成员值要落进本模块的号段
     * `(area << 27) | (slot << 12) | code`（docs/modules.md M5）。 */
    u32 ebase = 0;

    if (pa_cur()->kind == TK_IDENT && !pa_is_ch('{')) {
        /* 标签名：登记到标签表，这样裸 tag 也能当类型用（`Color c;`）。
         * 枚举在 c6c 里就是 int，不做范围检查。 */
        if (!sym_find_tag(tok_data(pa_cur()), pa_cur()->len)) {
            Sym *te = sym_add_tag(tok_data(pa_cur()), pa_cur()->len, ty_int());

            te->val = (i64)ty_int();
        }
        /* c6 里 `enum Color {…}` 同时给出类型名 `Color`（和 struct 一样），
         * 否则 `Color c = BLUE;` / `(Color)GREEN` 会报"未声明的标识符" */
        c6_auto_typedef(tok_data(pa_cur()), pa_cur()->len, ty_int());
        /* 记下标签名：普通形式的 `enum Color { GREEN }` 也要能查限定名
         * `Color.GREEN`（明文写 `Color.GREEN` 定义的那条路本来就会登记）。 */
        if (pa_cur()->len < sizeof(etag)) {
            memcpy(etag, tok_data(pa_cur()), pa_cur()->len);
            etaglen = pa_cur()->len;
            has_tag = 1;
        }
        pa_advance();
    }
    if (has_tag && etaglen == 5 && memcmp(etag, "Error", 5) == 0 && CUR_FILE)
        ebase = mod_err_base(mod_of_file((u32)CUR_FILE->id));
    if (!pa_accept_ch('{')) {
        /* `enum t` 这种**引用**（没有体）：查标签表拿真类型，不要无脑给
         * ty_int()——packed 枚举在标签表里存的是窄类型，
         * `sizeof(enum _tlb_table_type)` 得是 1 而不是 4
         * （内核 arch/x86/include/asm/cpuid/types.h:105 的静态断言）。 */
        if (has_tag) {
            Sym *tg = sym_find_tag(etag, etaglen);

            if (tg)
                return (u32)tg->val;
        }
        return ty_int();
    }
    while (!pa_is_ch('}') && pa_cur()->kind != TK_EOF) {
        Tok *t = pa_cur();
        char nm[256] = {0};
        u32 k = 0;
        Sym *s = NULL;

        if (t->kind != TK_IDENT) {
            pa_error("枚举常量名缺失");
            break;
        }
        k = t->len < 200 ? t->len : 200;
        memcpy(nm, tok_data(t), k);
        pa_advance();
        /* c6 的限定成员名 `Color.RED`：常量同时按 "Color.RED" 登记，
         * 这样两个枚举可以有同名的成员（C 的裸名会撞车）。 */
        if (pa_is_ch('.') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT
            && pa_peek(1)->len + k + 1 < sizeof(nm)) {
            char bare[256] = {0};
            u32 bk = 0;
            Tok *bt = pa_peek(1);

            bk = bt->len < 200 ? bt->len : 200;
            memcpy(bare, tok_data(bt), bk);
            /* 限定名只能用自己的 tag，匿名枚举根本没有 tag 可写 */
            if (!has_tag)
                pa_error("the enumerator of an anonymous enum cannot be qualified");
            else if (k != etaglen || memcmp(nm, etag, k) != 0)
                pa_error("enumerator qualifier '%.*s' must be the enum's own tag '%.*s'",
                         (int)k, nm, (int)etaglen, etag);
            nm[k] = '.';
            memcpy(nm + k + 1, bare, bk);
            k = k + 1 + bk;
            pa_advance();
            pa_advance();
            if (pa_accept_ch('='))
                val = (u32)(i32)const_expr();
            s = sym_add(nm, k, ty_int(), SC_ENUMC);
            s->val = (i64)(i32)(val ? (val | ebase) : 0u);
            {
                /* 裸名也登记一份；已经存在就不覆盖，改成"毒化"——两个枚举
                 * 都有这个成员名，裸用就是歧义。 */
                Sym *bs = sym_find(bare, bt->len);

                if (!bs) {
                    bs = sym_add(bare, bt->len, ty_int(), SC_ENUMC);
                    bs->val = (i64)(i32)(val ? (val | ebase) : 0u);
                } else if ((u32)bs->val != (val ? (val | ebase) : 0u)) {
                    /* 同名但值不同：两个枚举真的都有这个成员 */
                    poison_add(bare, bt->len);
                }
            }
            val++;
            if (!pa_accept_ch(','))
                break;
            continue;
        }
        if (pa_accept_ch('='))
            val = (u32)(i32)const_expr();
        /* 模块的错误码表：成员值会加在号段的低 12 位上，超出 12 位会撞进
         * 邻居的号段（docs/modules.md M5 / tests/errors/err_code.c6）。 */
        if (ebase && ((i32)val < 0 || val > 4095))
            pa_error("error code of '%s' is not in 0..4095", nm);
        /* 都不带限定符时，两个枚举里的同名成员仍然是 C 的重定义。模块文件是
         * 文本内联的（同一个文件被 import 两次就会解析两遍），那种重复登记的
         * 值完全一样，不算重定义。 */
        if (etaglen && !ebase) {
            Sym *ex4 = sym_find(nm, k);

            if (ex4 && ex4->kind == SC_ENUMC
                && (u32)ex4->val != (val ? (val | ebase) : 0u))
                pa_error("redeclaration of '%s'", nm);
        }
        s = sym_add(nm, k, ty_int(), SC_ENUMC);
        s->val = (i64)(i32)(val ? (val | ebase) : 0u);
        if (ebase && pa_cur() && mod_of_file((u32)pa_cur()->file)) {
            const char *mpA = mod_path(mod_of_file((u32)pa_cur()->file));
            char qA[320] = {0};
            u32 wA = 0;
            u32 jA = 0;

            if (mpA) {
                for (jA = 0; mpA[jA] && wA + 2 < 300; jA++)
                    if (mpA[jA] == '.') { qA[wA++] = '_'; qA[wA++] = '_'; }
                    else if (wA + 1 < 300) qA[wA++] = mpA[jA];
                qA[wA++] = '_'; qA[wA++] = '_';
                if (wA + k < 316) {
                    Sym *sqA = NULL;

                    memcpy(qA + wA, tok_data(t), k);
                    wA += k;
                    sqA = sym_add(qA, wA, ty_int(), SC_ENUMC);
                    /* 和裸名那次**同一个表达式**：`OK = 0` 不能加基址
                     * （tests/err_ids.c6 的"0 永远是「没有错误」"）。 */
                    sqA->val = (i64)(i32)(val ? (val | ebase) : 0u);
                }
            }
        }
        /* 有标签就再登记一份限定名 `Tag.名字`（`enum Color { GREEN }` 之后
         * 也能写 `Color.GREEN`）；同名已存在就不覆盖。 */
        if (etaglen && etaglen + k + 2 < sizeof(nm)) {
            char qn[256] = {0};
            u32 qk = etaglen;

            memcpy(qn, etag, etaglen);
            qn[qk++] = '.';
            memcpy(qn + qk, nm, k);
            qk += k;
            if (!sym_find(qn, qk)) {
                Sym *qs = sym_add(qn, qk, ty_int(), SC_ENUMC);

                qs->val = (i64)(i32)(val ? (val | ebase) : 0u);
            }
        }
        val++;
        if (!pa_accept_ch(','))
            break;
    }
    pa_expect_ch('}');
    if (has_tag)
        HAS_ENUM_TAG = 1;
    /* `} __packed;` / `} __attribute__((packed));`：GCC 的 packed enum 取
     * **刚好装得下所有枚举值**的最小宽度（1/2/4 字节）。
     *
     * 内核 arch/x86/include/asm/cpuid/types.h 就有
     *     enum _tlb_table_type { … } __packed;
     *     static_assert(sizeof(enum _tlb_table_type) == 1);
     * 不给它以 1 字节，内联在 struct leaf_0x2_table 里的那个 union 会整体
     * 撑大，那条静态断言当场失败（实测：kernel/sched/core.c 报
     * cpuid/types.h:84 与 :112 两条 _Static_assert 失败）。
     *
     * 这里的属性是**枚举自己**的，parse_typespec 的 skip_attributes 在
     * 返回之后才跑，所以得在这一层吃掉并记账。 */
    {
        int packed = 0;

        if (PA_IS_IDENT("__packed") || PA_IS_IDENT("packed")) {
            pa_advance();
            packed = 1;
        } else if (PA_IS_IDENT("__attribute__") || PA_IS_IDENT("__attribute")) {
            /* `__attribute__((packed))`：前瞻扫一遍属性体，只找 packed。
             * 不用 skip_attributes()——它会真吃掉，而这里之后
             * parse_typespec 还会再跑一遍（属性可能不止 packed）。 */
            u32 k = 2;      /* 跳过 `__attribute__` `(` */

            while (pa_peek(k)->kind != TK_EOF) {
                Tok *c = pa_peek(k);

                /* `packed` 和它的别名拼法都要认：内核的 __packed 展开出来
                 * 是 `__attribute__((__packed__))`（**带尾双下划线**），
                 * 只匹配 "packed" 会漏（实测：拆开写的
                 * `__attribute__((packed))` 能过，内核里却过不去）。 */
                if (c->kind == TK_IDENT
                    && (TOK_EQ(c, "packed") || TOK_EQ(c, "__packed")
                        || TOK_EQ(c, "__packed__")))
                    packed = 1;
                if (c->kind == TK_PUNCT && TOK_EQ(c, ")")) {
                    /* 两个 `)` 关掉 ((…))。见到第二个就停。 */
                    if (pa_peek(k + 1)->kind == TK_PUNCT
                        && TOK_EQ(pa_peek(k + 1), ")") && k > 2)
                        k += 2;
                    else
                        k++;
                    break;
                }
                k++;
            }
            /* 真吃掉，免得 parse_typespec 那里再扫一遍时又不认识 */
            skip_attributes();
        }
        if (packed) {
            /* 值域 → 最小宽度。maxval 是最后那个 val - 1（val 已经自增过）。 */
            u32 last = val ? val - 1 : 0;
            int hi = (int)last;
            u32 et = ty_int();

            if (hi >= 0 && hi <= 0xFF)
                et = ty_uchar();
            else if (hi >= 0 && hi <= 0xFFFF)
                et = ty_ushort();
            /* 超过 16 位就保持 int：GCC 也不会为此给 8 字节。
             *
             * 标签表里那一条也要跟着改：`sizeof(enum t)` / `enum t x;` 走的是
             * 标签表里的类型，而不是 parse_enum_spec 的返回值——开头登记时
             * 还不知道末尾有没有 packed（实测：只改返回值，sizeof 照样是 4）。 */
            if (has_tag) {
                Sym *tg = sym_find_tag(etag, etaglen);

                if (tg)
                    tg->val = (i64)et;
            }
            return et;
        }
    }
    return ty_int();
}

/* typeof(expr) / __typeof__(type)：类型取自表达式（不求值） */
static u32 parse_typeof(void)
{
    u32 ty = 0;

    pa_advance();
    skip_attributes();
    pa_expect_ch('(');
    if (is_typename_tok(pa_cur())) {
        ty = parse_typename();
    } else {
        u32 save = FN.n;

        NO_DECAY = 1;           /* 函数指示符不能退化，typeof 要函数类型本身 */
        /* typeof 里是**完整表达式**，不是一元表达式：`typeof(1?f:f)`、
         * `typeof((a,b))` 都是合法写法（tcc tests2 的 33_ternary_op 靠这个）。 */
        (void)gen_expr();
        ty = GEN_TY;
        NO_DECAY = 0;
        FN.n = save;
        PEND_LVAL = 0;
    }
    pa_expect_ch(')');
    return ty;
}

/* 块作用域里才允许 VLA：函数形参表里 `char a[n]` 是指针，不是新分配 */
static int PA_VLA_OK;

/* `[` 到这里为止是不是 VLA：括号里出现局部变量/形参就是运行期长度。
 * 常量表达式里不可能有局部变量，所以这个判断不会把常量数组误判成 VLA。
 * `sizeof(x)` 里出现局部变量是唯一的反例——它会按 VLA 处理，分配同样大小，
 * 语义仍然对，只是 `sizeof` 会退化成指针宽度。 */
static int pa_bracket_is_vla_at(int base)
{
    int i = 0;
    /* 调用点已经吃掉了 `[`，所以一开始就在里面（depth = 1） */
    int depth = 1;

    for (i = 0; i < 64; i++) {
        Tok *t = pa_peek(base + i);

        if (!t || t->kind == TK_EOF)
            return 0;
        if (t->kind == TK_PUNCT) {
            if (TOK_EQ(t, "[")) {
                depth++;
            } else if (TOK_EQ(t, "]")) {
                depth--;
                if (depth == 0)
                    return 0;
            } else if (TOK_EQ(t, ";") || TOK_EQ(t, "{") || TOK_EQ(t, "}")) {
                return 0;
            }
            continue;
        }
        if (t->kind != TK_IDENT || depth != 1)
            continue;
        if (TOK_EQ(t, "sizeof") || TOK_EQ(t, "alignof")
            || TOK_EQ(t, "_Alignof") || TOK_EQ(t, "__alignof__")) {
            /* 跳过 sizeof(...)：括号里的局部变量是合法的常量表达式 */
            Tok *n1 = pa_peek(base + i + 1);

            if (n1 && n1->kind == TK_PUNCT && tok_eq(n1, "(")) {
                int k = i + 1;
                int d2 = 0;

                for (; k < 200; k++) {
                    Tok *tk = pa_peek(base + k);

                    if (!tk || tk->kind == TK_EOF)
                        return 0;
                    if (tk->kind == TK_PUNCT && tok_eq(tk, "("))
                        d2++;
                    else if (tk->kind == TK_PUNCT && tok_eq(tk, ")")) {
                        d2--;
                        if (d2 == 0)
                            break;
                    }
                }
                i = k;
            }
            continue;
        }
        if (is_typename_tok(t))
            continue;
        {
            Sym *v = sym_find(tok_data(t), t->len);

            /* c6 的枚举限定名 `Color.RED` 也是常量：两段拼起来再查一次 */
            if (!v) {
                Tok *n2 = pa_peek(base + i + 1);
                Tok *n3 = pa_peek(base + i + 2);

                if (n2 && n2->kind == TK_PUNCT && TOK_EQ(n2, ".") && n3
                    && n3->kind == TK_IDENT && t->len + n3->len + 2 < 256) {
                    char qn[256] = {0};
                    u32 qk = t->len;

                    memcpy(qn, tok_data(t), qk);
                    qn[qk++] = '.';
                    memcpy(qn + qk, tok_data(n3), n3->len);
                    qk += n3->len;
                    v = sym_find(qn, qk);
                }
            }
            /* 只有枚举常量和常量全局量能出现在常量表达式里，其余都是运行期长度 */
            if (!v || v->is_func || (v->kind != SC_ENUMC && v->kind != SC_GLOBAL))
                return 1;
        }
    }
    return 0;
}

/* 当前 token 已经在括号里面（`[` 被吃掉了）：`[n]` 里的 n 是不是运行期长度。 */
static int pa_bracket_is_vla(void)
{
    return pa_bracket_is_vla_at(0);
}

static u32 gen_bin2(u32 a, u32 aty, u8 op, u32 b, u32 bty);

/* dims_apply 的附加输入：每一维在**源码里长什么样**（和 dims[]/dimv[]/dimr[]
 * 平行）。普通的常量维度只用 dims[] 就够了，但多层 VLA **形参**的 stride 要等
 * 形参有值以后再算，那时得知道"第 i 维写的是哪个名字"，所以声明处把名字也
 * 留下来（见 decl_apply_suffix 里填它们的那段）。 */
static u8 PA_DIMK[16];          /* 0 = 常量，1 = 简单标识符，2 = 其它表达式 */
static const char *PA_DIMN[16]; /* k == 1：标识符 */
static u32 PA_DIML[16];         /* k == 1：标识符长度 */
static u32 PA_DIMC[16];         /* k == 0：常量值 */

/* 一串数组维度 → 类型。全是常量就是普通数组；只要有一维是运行期长度，这个
 * 对象就是 C99 VLA（`int b[n][m]`）。
 *
 * 多维 VLA 的难点是**行 stride 是运行期的**：`b[i]` 不能按 sizeof(元素) 缩放，
 * 要乘 `m * sizeof(int)`。所以在**声明处**把每一维的 stride 现算成 vreg 记到
 * 声明符上（vla_str[i] = 跳过第 i 维一个元素的字节数），下标那一段再按它缩放
 * （见 gen_postfix_ops）。类型本身表示成 k 层指针（`int b[n][m]` → `int **`），
 * 于是 `b[i]` 的结果就是 `int *`，再 `[j]` 回到普通指针下标，不用再记 stride。
 *
 * 一维（nd == 1）保持老表示法不动：类型 = 元素指针，长度是运行期 vreg、
 * 元素大小是编译期常量，IR_ALLOCA 直接按 `cnt * imm` 开。 */
static u32 dims_apply(u32 t, Declarator *d, u32 *dims, u32 *dimv, u8 *dimr, int nd)
{
    int i = 0;
    int nrun = 0;
    int npar = 0;

    for (i = 0; i < nd; i++) {
        if (dimr[i] == 1)
            nrun++;
        else if (dimr[i] == 2)
            npar++;
    }
    /* 指向变长数组的指针（`int (*p)[m]`、`int (*p)[n][m]`）：运行期 stride 得
     * 跟着**这个指针**走，类型里没有地方放它（c6c 的类型是静态 id）。以前这条
     * 会静默按 `sizeof(元素)` 缩放，`p[i][j]` 读出来是垃圾；与其算错，不如说清。
     * 多维 VLA 本身请写成 `int a[n][m]` 这种"数组形参"形式（那条现在支持）。 */
    /* 只有"括号声明符 + 有指针层"才是"指向数组的指针"（`int (*p)[m]`）。
     * `void *addr[count]` 是**指针数组**：ptr_depth 也是 1，但数组本身是对象、
     * 元素才是指针，那条路是支持的一维 VLA（tcc tests2/79_vla_continue 就是它）。 */
    if (d && d->paren && d->ptr_depth > 0 && (nrun > 0 || npar > 0)) {
        pa_error("暂不支持指向变长数组的指针（`int (*p)[m]`）：运行期 stride 没有"
                 "地方放；请写成数组形参 `int p[][m]`、或自己按 `p[i * m + j]` 算");
    }
    /* 多维 VLA 形参：`int a[n][m]`。形参表里 n/m 还没有值、槽也还没建，这里
     * **算不出**行 stride，所以一条 IR 都不发——只把形状（每一维是常量还是哪个
     * 名字）记到声明符上，等 pa_func_def 绑帧时在函数入口现算（见
     * pa_vla_param_prep）。类型表示成和块作用域多维 VLA 一样的 k 层指针
     * （`int a[n][m]` → `int **`），于是 `a[i][j]` 直接走 gen_postfix_ops 里
     * 现成的多维 VLA 下标逻辑，三个后端一行都不用改。
     * 一维 `int a[n]` 不用 stride，仍然落到下面的普通常量数组那条路。 */
    if (nrun == 0 && npar > 0 && nd > 1 && d) {
        int okk = 1;

        if (nd > 8) {
            /* pvla.k[] 只有 8 格（真要有 9 维再改，现在报清楚） */
            pa_error("多维 VLA 形参最多 8 维");
            okk = 0;
        }
        /* 只有**内层**维度的长度会进 stride：stride[nd-2] = len[nd-1] * sizeof(T)，
         * stride[i] = len[i+1] * stride[i+1]。最外层那一维（len[0]）除了 sizeof
         * 之外没有任何用处，而形参的 sizeof 是"指针大小"，本来就不用它——所以
         * `int a[n + 1][m]` 这种最外层写表达式的形式放行，内层只收常量/形参名。 */
        for (i = 1; okk && i < nd; i++) {
            if (PA_DIMK[i] > 1) {
                pa_error("多维 VLA 形参：内层维度只支持常量或形参名"
                         "（`int a[n][m]`、`int a[n][5]`），不支持复合表达式");
                okk = 0;
            }
        }
        if (okk) {
            d->pvla.nd = (u8)nd;
            d->pvla.esz = ty_size(t) ? ty_size(t) : 1;
            for (i = 0; i < nd && i < 8; i++) {
                d->pvla.k[i] = PA_DIMK[i] > 1 ? 2 : PA_DIMK[i];
                d->pvla.c[i] = PA_DIMC[i];
                d->pvla.nm[i] = PA_DIMN[i];
                d->pvla.nl[i] = PA_DIML[i];
            }
        }
        for (i = 0; i < nd; i++)
            t = ty_ptr(t);
        return t;
    }
    if (nrun == 0) {
        /* 普通常量数组。`[` 空着的维度是 0（不完整类型），照原样留着。 */
        while (nd > 0)
            t = ty_array(t, dims[--nd]);
        return t;
    }
    if (nd > 8) {
        /* vla_str[] 只有 8 格（真要有 9 维 VLA 再改，现在报清楚） */
        pa_error("多维变长数组最多 8 维");
        while (nd > 0)
            t = ty_array(t, 0);
        return t;
    }
    if (!d) {
        /* 抽象声明符（`sizeof(int[n])`）：没有对象可分配，类型表达不了运行期
         * 长度，按不完整数组处理——和以前一样，别在这儿发 stride 的 IR。 */
        while (nd > 0)
            t = ty_array(t, 0);
        return t;
    }
    if (nd == 1) {
        /* 一维 VLA：老路一个字都没改 */
        d->vla = 1;
        d->vla_cnt = dimv[0];
        d->vla_esz = ty_size(t) ? ty_size(t) : 1;
        d->vla_nd = 1;
        d->vla_multi = 0;
        return ty_ptr(t);
    }
    {
        u32 esz = ty_size(t) ? ty_size(t) : 1;
        u32 lenv[16] = {0};
        u32 acc = 0;
        u32 total = 0;

        /* 每维长度都做成 vreg（常量也发一条 CONST）：stride 从最内层往外乘，
         *   stride[nd-1] = sizeof(T)（编译期常量）
         *   stride[i]    = len[i+1] * stride[i+1]
         * 最内层那一维不用 stride（下标直接按元素大小缩放）。 */
        for (i = 0; i < nd; i++) {
            if (dimr[i] == 1) {
                lenv[i] = dimv[i];
            } else {
                lenv[i] = irfn_vreg(&FN);
                irfn_push(&FN, IR_CONST, IRT_U64, lenv[i], 0, 0, 0, dims[i]);
            }
        }
        for (i = nd - 2; i >= 0; i--) {
            u32 kk = acc;

            if (!kk) {
                kk = irfn_vreg(&FN);
                irfn_push(&FN, IR_CONST, IRT_U64, kk, 0, 0, 0, esz);
            }
            d->vla_str[i] = gen_bin2(lenv[i + 1], ty_ulong(), IR_MUL, kk, ty_ulong());
            acc = d->vla_str[i];
        }
        total = gen_bin2(lenv[0], ty_ulong(), IR_MUL, d->vla_str[0], ty_ulong());
        d->vla = 1;
        d->vla_multi = 1;
        d->vla_nd = (u8)nd;
        /* sizeof 要的是整块字节数：cnt * esz = len[0] * stride[0]，正好对 */
        d->vla_cnt = lenv[0];
        d->vla_esz = d->vla_str[0];
        d->vla_bytes = total;
    }
    for (i = 0; i < nd; i++)
        t = ty_ptr(t);
    return t;
}

/* --- C99 复数（_Complex）-------------------------------------------------
 * 表示：两个分量的**普通结构体**（`__c6_cplx_f/d/l`，定义在 main.c6 的
 * BUILTIN_DEFS 里），布局就是 `{re, im}`。于是 sizeof、对齐、整体赋值、
 * 按值传参、返回全都走现成的聚合路径，三个后端一行都不用改——只有算术、
 * 比较、转换在这里被拆成两个标量。
 *
 * 分量类型：float _Complex → float；double/long double _Complex → double
 * （c6c 里 long double 本来就算 double）。 */
static u32 TY_CPLX_F;
static u32 TY_CPLX_D;
static u32 TY_CPLX_L;

static void cplx_types_init(void)
{
    Sym *s = NULL;

    if (TY_CPLX_F && TY_CPLX_D && TY_CPLX_L)
        return;
    /* 结构体标签把类型 id 存在 `val` 里（不是 `type`，见 parse_agg_spec） */
    s = sym_find_tag("__c6_cplx_f", 11);
    TY_CPLX_F = s ? (u32)s->val : 0;
    s = sym_find_tag("__c6_cplx_d", 11);
    TY_CPLX_D = s ? (u32)s->val : 0;
    s = sym_find_tag("__c6_cplx_l", 11);
    TY_CPLX_L = s ? (u32)s->val : 0;
}

static int ty_is_cplx(u32 ty)
{
    if (!ty)
        return 0;
    if (!TY_CPLX_D)
        cplx_types_init();
    return ty == TY_CPLX_F || ty == TY_CPLX_D || ty == TY_CPLX_L;
}

/* 复数类型的分量类型 */
static u32 cplx_comp(u32 cty)
{
    (void)cty;
    return ty_is_cplx(cty) && cty == TY_CPLX_F ? ty_float() : ty_double();
}

/* 基础类型 → 对应的复数类型；0 = 这个基础类型不能加 `_Complex` */
static u32 ty_cplx_of_base(u32 base)
{
    if (!TY_CPLX_D)
        cplx_types_init();
    if (base == ty_float())
        return TY_CPLX_F;
    if (base == ty_double())
        return TY_CPLX_D;
    if (base == ty_ldouble())
        return TY_CPLX_L;
    return 0;
}

/* 类型说明符（含指针） */
static u32 parse_closure_type(void)
{
    u32 rty = 0;
    u32 pts[TY_PARAM_MAX] = {0};
    u32 np = 0;

    pa_advance();                        /* closure */
    rty = parse_typespec();
    while (pa_accept_ch('*'))
        rty = ty_ptr(rty);
    int variadic = 0;

    pa_expect_ch('(');
    while (np < TY_PARAM_MAX && !pa_is_ch(')') && pa_cur()->kind != TK_EOF) {
        u32 pt = 0;

        /* `closure int(int, ...)`：省略号表示变参（词法上是**一个** token） */
        if (pa_is_punct("...")) {
            pa_advance();
            variadic = 1;
            break;
        }
        pt = parse_typespec();
        while (pa_accept_ch('*'))
            pt = ty_ptr(pt);
        /* 形参名可以写（只做提示，不进类型） */
        if (pa_cur()->kind == TK_IDENT)
            pa_advance();
        pts[np++] = pt;
        if (!pa_accept_ch(','))
            break;
    }
    pa_expect_ch(')');
    return ty_closure(ty_func(rty, pts, np, variadic));
}

/* 形参表里**不发**"隐式 int"告警：tcc 的 type-defaults-to-int 只对缺类型的
 * 声明发（decl() 的 oldint），对形参表里的裸标识符（K&R `int f(a, b)`）和
 * 省略号都不告警——实测 `tcc kr.c` 零告警。c6c 的 parse_param_list 会把
 * `...` 和 K&R 裸标识符喂给 parse_typespec 兜底成 int（幻影形参，nparams
 * 不自增、无实害），有了告警之后这条旧路径每条变参原型都多一行噪声
 * （c6c/include/stdio.h 的 23-26 曾让 tests2 全线飘红）。 */
static int PA_NO_II_WARN;

/* `-ffreestanding-kernel` 下的内核头（include/trace/trace_events.h 的
 * `tstruct;` 等）大量用 C89 风格的隐式 int，这是合法代码，不该走 tcc 口径
 * 告警。Opts O 是 main.c6 里的 static，而 parse.c6 在它之前 include，
 * 看不见 O；由 main.c6 识别 -ffreestanding-kernel 时把本标志一起置上。 */
static int PA_KERNEL_MODE;

/* 隐式 int 的**待定告警**：parse_typespec 兜底成 int 时先记一笔，等声明符
 * 解析完再看最终类型告警——tcc 的 warning 在 decl() 里只对**非函数**声明发
 * （`} else if (oldint)` 前面是 VT_FUNC 分支），所以 `f();` / `f(){}` 不告警、
 * `n;` 告警（tests2/60_errors_and_warnings 的 "f(); // don't warn" 逐字要它）。
 * 由 gen_decl_from_spec / gen_local_decl 在 parse_declarator 之后消费。 */
static int PA_II_PENDING;

static u32 parse_typespec(void)
{
    u32 base = 0;

    /* 每条新声明重新计：上一笔待定告警由声明收尾处消费（见 PA_II_PENDING） */
    PA_II_PENDING = 0;
    int nlong = 0;
    int nshort = 0;
    int uns = 0;
    /* 已经出现过基础类型关键字（int/long/short/unsigned…）。有了它，后面再
     * 出现同名 typedef 就是**声明符的名字**，不是又一个类型说明符——
     * `int byte = 3;` 曾经被解析成"类型 byte、名叫 3"，于是参数/局部变量
     * 想遮蔽同名 typedef 全都报错。 */
    int saw_int = 0;
    /* 说明符里出现的 const/volatile/restrict 掩码。c6c 里限定符对多数类型只是
     * 标记（对象的只读性走 Sym.is_const），但**数组**上的限定符必须落到元素上
     * （C11 6.7.3p9）——`typedef int *restrict rp; typedef restrict int *arr[2];`
     * 里 restrict 归元素，`rp[2]` 才能和它同 id（tests2/100_c99array-decls）。 */
    u8 qm = 0;
    /* 见过 `_Complex`（C99 6.7.2.5）：最后要把基础类型换成对应的复数结构体 */
    int saw_complex = 0;

    /* typeof(expr) / __typeof__(type)：类型取自表达式（不求值）。
     * 不能直接 `return`：后面还可能跟着限定符和 `*`——内核
     * include/linux/kfifo.h:64 的 `ptrtype const *ptr_const;` 展开出来就是
     * `typeof(*(__tmp)->type) const *ptr_const`，以前 `const` 成了声明符名，
     * 报"这里要 ';'（当前是 '*'）"。`goto typespec_done` 让后缀限定符那段
     * 接着吃，`*` 仍旧归声明符管。 */
    if (PA_IS_IDENT("typeof") || PA_IS_IDENT("__typeof__") || PA_IS_IDENT("__typeof")) {
        base = parse_typeof();
        goto typespec_done;
    }
    /* `closure RET(params)`：闭包类型，单字（指向 {代码指针, 捕获…} 的堆对象） */
    if (c6_kw() && PA_IS_IDENT("closure"))
        return parse_closure_type();
    /* `thread` 是**软**关键字：`thread h = spawn f();` 里是类型，
     * `static int thread = 1;` 里就是普通标识符（tests/errors/thread_handle.c6
     * 的正常路径要求这一点）。判据：后面紧跟一个标识符。 */
    if (pa_cur()->kind == TK_IDENT && tok_data(pa_cur())[0] == 't'
        && (PA_IS_IDENT("thread") || PA_IS_IDENT("task"))
        && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
        /* `task` 是 async 句柄（wait/done/kind/val），`thread` 是线程句柄
         * （join/done/value）。两者都是单字，但方法不同，所以类型也分开。 */
        PA_TASK_KW = PA_IS_IDENT("task") ? 1 : 2;
        pa_advance();
        return PA_TASK_KW == 1 ? ty_task() : ty_thread();
    }
    /* 声明位置上的 _Alignas(...) 直接忽略 */
    while (PA_IS_IDENT("_Alignas") || PA_IS_IDENT("alignas")) {
        pa_advance();
        if (pa_is_ch('('))
            skip_paren_group();
    }
    int nsigned = 0;

    /* 元组类型 `(T1, T2, …)`：写在类型位置、以 `(` 开头、里面有逗号。
     * 只有一个元素时 `(T)` 就是 T（括号而已）。 */
    if (pa_is_ch('(') && !PA_TYPE_ATOM) {
        u32 tys[TUPLE_MAXN] = {0};
        u32 tn = 0;

        pa_advance();
        /* `error` 不是一等类型：`(int, error)` 这里要直接点出来，否则它会被
         * 当成"隐式 int 的元素名"悄悄放过（tests/errors/tuple.c6）。 */
        if (PA_IS_IDENT("error"))
            pa_error("'error' can only be a return type, not a tuple element");
        tys[tn++] = parse_typename();
        if (pa_is_ch(',')) {
            while (tn < TUPLE_MAXN && pa_accept_ch(',')) {
                if (PA_IS_IDENT("error"))
                    pa_error("'error' can only be a return type, not a tuple element");
                tys[tn++] = parse_typename();
            }
            pa_expect_ch(')');
            /* 元组作 `!error` 返回类型：`(int, int)!error f()` */
            if (pa_is_ch('!') && pa_peek(1)->kind == TK_IDENT) {
                PA_FALLIBLE = 1;
                pa_advance();
                pa_advance();
            }
            return ty_tuple_chk(tys, tn);
        }
        pa_expect_ch(')');
        return tys[0];
    }
    /* 托管引用 `@T`：表示上和 `T *` 一样（对象头 + 引用计数还没做，
     * 见 docs/manual/gc.md 与 todo 的 P6-6）。`shared`/`weak`/`own` 是
     * 所有权修饰符，先按普通强引用处理。 */
    while (c6_kw()
           && (PA_IS_IDENT("shared") || PA_IS_IDENT("weak") || PA_IS_IDENT("own"))) {
        if (PA_IS_IDENT("weak"))
            PA_MGD_KIND = 1;
        else if (PA_IS_IDENT("own"))
            PA_MGD_KIND = 2;
        else
            PA_MGD_SHARED = 1;
        pa_advance();
    }
    if (pa_is_ch('@')) {
        u32 it = 0;
        int save_at = PA_TYPE_ATOM;

        pa_advance();
        PA_TYPE_ATOM = 0;
        it = parse_typespec();
        PA_TYPE_ATOM = save_at;
        /* 闭包本身就是一个托管引用（单字，堆上的 {代码, 环境}），外面再套
         * 一层 `@` 没有意义（tests/errors/closure_signature.c6）。 */
        if (ty_is_closure(it, NULL) && in_c6_tu())
            pa_error("'@' cannot be applied to a closure type: a closure is already "
                     "a managed reference");
        PA_MGD_PTR++;
        return it;
    }
    for (;;) {
        /* `__builtin_va_list`：GCC 口径的"编译器内建的 va_list 类型"。
         * 内核的 include/linux/stdarg.h 就一句 `typedef __builtin_va_list
         * va_list;`——不带内建类型名，整棵内核头链在第一个文件就断。
         * 形状与自带 include/stdarg.h 的 __c6c_va_elem 一致（SysV x86-64 的
         * 4 字段结构：gp_offset / fp_offset / overflow_arg_area /
         * reg_save_area），IR_VASTART 的 ABI 就是按这个形状写的；但内建写法
         * 是**结构体本身**，不带那个 [1]（GCC 的 __builtin_va_list 是数组
         * 类型，只是几乎所有代码都用它取地址/当形参退化成指针，这里按结构体
         * 给，`va_list ap;` + `va_start(ap,x)` 的用法照样成立）。 */
        if (PA_IS_IDENT("__builtin_va_list")) {
            if (!VA_LIST_TY) {
                u32 m[4] = {0};

                m[0] = ty_uint();
                m[1] = ty_uint();
                m[2] = ty_ptr(ty_void());
                m[3] = ty_ptr(ty_void());
                VA_LIST_TY = ty_agg(m, NULL, 4, 0, 0u);
            }
            pa_advance();
            base = VA_LIST_TY;
            saw_int = 1;        /* 已经是完整类型，别再按隐式 int 补 */
            continue;
        }
        if (PA_ACCEPT_IDENT("unsigned")) { uns = 1; saw_int = 1; continue; }
        if (PA_ACCEPT_IDENT("signed")) { nsigned = 1; saw_int = 1; continue; }
        if (PA_ACCEPT_IDENT("long")) { nlong++; saw_int = 1; continue; }
        /* `__int128` / `unsigned __int128`（GCC 扩展）。见 type.c6 里
         * TY_I128 的注释：内核 include/uapi/linux/types.h 无条件 typedef 了
         * `unsigned __int128 __u128`，而这行必须解析得过。
         *
         * 只做类型层：宽 16 字节、按整数类型对待（sizeof/对齐/取地址/当成员
         * 都对），128 位的算术与转换没有实现——内核头链里它只出现在声明
         * 位置（`union __u128_halves`、`__u128 irte`、GENMASK_U128）。 */
        /* `__uint128_t` 是「已经带 unsigned」的独立名字（GCC 的预定义
         * typedef），不是 `__int128` 的加长写法。 */
        if (PA_ACCEPT_IDENT("__uint128_t")) {
            base = ty_u128();
            uns = 1;
            saw_int = 1;
            continue;
        }
        if (PA_ACCEPT_IDENT("__int128") || PA_ACCEPT_IDENT("__int128_t")) {
            base = uns ? ty_u128() : ty_i128();
            saw_int = 1;
            continue;
        }
        if (PA_ACCEPT_IDENT("short")) { nshort++; saw_int = 1; continue; }
        if (PA_IS_IDENT("typeof") || PA_IS_IDENT("__typeof__")
            || PA_IS_IDENT("__typeof")) {
            base = parse_typeof();
            continue;
        }
        /* `__auto_type`：占位类型，真类型由初始化器决定（见 AUTO_TY 的注释）。 */
        if (PA_IS_IDENT("__auto_type")) {
            pa_advance();
            if (!AUTO_TY)
                AUTO_TY = ty_void();
            base = AUTO_TY;
            PA_AUTO_PENDING = 1;
            saw_int = 1;        /* 已经是完整类型，不要再按隐式 int 补 */
            continue;
        }
        /* c6 错误通道返回类型：`T!error`。完整语义（错误值是个带 id 的载荷、
         * catch 绑定）还没做，这里先按 `T` 解析，返回 err(id,msg) 就是那个 id。 */
        if (pa_is_ch('!') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
            if (base && ty_is_array(base))
                pa_error("'!error' 不支持数组返回类型");
            PA_FALLIBLE = 1;
            pa_advance();
            pa_advance();
            continue;
        }
        /* c6 切片类型：`T[:]`（写在类型位置，名字在后面：`int[:] s`）。
         * 不看 PA_TYPE_ATOM：类型位置上的 `[` 只可能是切片后缀，而函数字面量
         * 解析返回类型时正是 PA_TYPE_ATOM 状态（`int[:](int[:] s) { … }`）。 */
        if (!PA_TMPL_ARG && pa_is_ch('[') && pa_peek(1)
            && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ":")) {
            pa_advance();
            pa_advance();
            pa_expect_ch(']');
            if (base == ty_void())
                pa_error("'[:]' 不能是 void 元素类型");
            base = ty_slice_chk(base ? base : ty_int());
            continue;
        }
        if (PA_ACCEPT_IDENT("struct")) { base = parse_agg_spec(0);
            continue; }
        if (PA_ACCEPT_IDENT("union")) { base = parse_agg_spec(1); continue; }
        if (PA_ACCEPT_IDENT("enum")) { base = parse_enum_spec(); continue; }
        if (PA_ACCEPT_IDENT("void")) { base = ty_void(); continue; }
        if (PA_ACCEPT_IDENT("_Bool")) { base = ty_bool(); continue; }
        if (PA_ACCEPT_IDENT("_Complex")) {
            saw_complex = 1;
            continue;
        }
        /* `_Imaginary`（C99 6.2.5p11 是**可选**的）没有实现：和 gcc 一样明确
         * 报错，别静默当实数用。 */
        if (PA_ACCEPT_IDENT("_Imaginary")) {
            pa_error("'_Imaginary' 类型没有实现（C99 允许实现不提供）");
            continue;
        }
        if (PA_ACCEPT_IDENT("_Noreturn")) { continue; }
        if (PA_IS_IDENT("_Atomic") && pa_peek(1)->kind == TK_PUNCT
            && tok_eq(pa_peek(1), "(")) {
            pa_advance();
            pa_advance();
            base = parse_typename();
            pa_expect_ch(')');
            continue;
        }
        if (PA_ACCEPT_IDENT("_Atomic")) { continue; }    /* 限定符位置 */
        /* `__seg_gs` / `__seg_fs`：x86 的**地址空间限定符**（gcc 内置关键字，
         * 不是宏——内核只在 sparse（__CHECKER__）下才把它们定义成
         * __attribute__((address_space(...)))）。内核
         * arch/x86/include/asm/percpu_types.h 用它拼出
         * `typeof(var) __seg_gs *`，于是 percpu 读写整套宏（per_cpu()、
         * this_cpu_ptr()、raw_cpu_read()…）全靠它。c6c 没有分段模型，
         * 当限定符吃掉即可——语义上等价于"普通指针"。 */
        if (PA_ACCEPT_IDENT("__seg_gs") || PA_ACCEPT_IDENT("__seg_fs")) { continue; }
        if (PA_ACCEPT_IDENT("int")) { saw_int = 1; continue; }
        if (PA_ACCEPT_IDENT("char")) { base = uns ? ty_uchar() : (nsigned ? ty_schar() : ty_char()); continue; }
        if (PA_ACCEPT_IDENT("float")) { base = ty_float(); continue; }
        /* bf16 只在 .c6 里是关键字：.c 文件保持纯 C，那边 `bf16` 仍是普通标识符
         * （老代码拿它当变量名/字段名的不会断）。 */
        if (c6_kw() && PA_ACCEPT_IDENT("bf16")) { base = ty_bf16(); continue; }
        if (PA_ACCEPT_IDENT("double")) { base = ty_double(); continue; }
        if (PA_IS_IDENT("__attribute__") || PA_IS_IDENT("__attribute")) {
            skip_attributes();
            continue;
        }
        if (PA_IS_IDENT("_Alignas") || PA_IS_IDENT("alignas")) {
            /* `int _Alignas(16) i2;`：对齐说明符可以出现在类型说明符中间 */
            pa_advance();
            if (pa_is_ch('('))
                skip_paren_group();
            continue;
        }
        if (PA_ACCEPT_IDENT("static")) { PA_STATIC = 1; continue; }
        /* 所有权修饰符也可能出现在 `static` 之后（`static weak @T g;`） */
        if (c6_kw()
            && (PA_IS_IDENT("weak") || PA_IS_IDENT("own") || PA_IS_IDENT("shared"))) {
            if (PA_IS_IDENT("weak"))
                PA_MGD_KIND = 1;
            else if (PA_IS_IDENT("own"))
                PA_MGD_KIND = 2;
            else
                PA_MGD_SHARED = 1;
            pa_advance();
            continue;
        }
        /* `static inline int f(…)`：c6c 不做内联，`inline` 只是个装饰——
         * 但和 `async` 撞在一起要报（协程不能被就地展开）。 */
        if (PA_ACCEPT_IDENT("inline") || PA_ACCEPT_IDENT("__inline")
            || PA_ACCEPT_IDENT("__inline__")) {
            PA_INLINE_SEEN = 1;
            continue;
        }
        /* `async T f(…)`：c6c 没有协程调度器，async 函数就是普通函数（和
         * rt.c6 里那组 __c6_co_* 桩一个口径）。这里只把 async 吃掉。 */
        /* `async (int, int) f()`：返回类型也可以是元组，所以后面跟 `(` 也算。 */
        if (PA_IS_IDENT("async") && c6_kw() && pa_peek(1)
            && (pa_peek(1)->kind == TK_IDENT
                || (pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), "(")))) {
            pa_advance();
            PA_ASYNC = 1;
            /* `async (int, int) f(…)`：返回类型是元组。元组那条分支在说明符
             * 循环之前就判过了（那时当前还是 `async`），所以这里补一次。 */
            if (pa_is_ch('(')) {
                u32 tys[TUPLE_MAXN] = {0};
                u32 tn = 0;

                pa_advance();
                tys[tn++] = parse_typename();
                while (tn < TUPLE_MAXN && pa_accept_ch(','))
                    tys[tn++] = parse_typename();
                pa_expect_ch(')');
                if (pa_is_ch('!') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
                    PA_FALLIBLE = 1;
                    pa_advance();
                    pa_advance();
                }
                base = ty_tuple_chk(tys, tn);
            }
            continue;
        }
        /* `@T` / `weak @T` / `shared @T` / `own @T` 也能出现在**说明符循环里**
         * （`static @Node give(...)`）：c6c 里 `@T` 的表示就是 `T *`。 */
        if (pa_is_ch('@')) {
            u32 it2 = 0;
            int save_at2 = PA_TYPE_ATOM;

            pa_advance();
            PA_TYPE_ATOM = 0;
            it2 = parse_typespec();
            PA_TYPE_ATOM = save_at2;
            PA_MGD_PTR++;
            base = it2;
            continue;
        }
        if (pa_cur()->kind == TK_IDENT) {
            char c0 = tok_data(pa_cur())[0];

            if (c6_kw()
                && ((c0 == 'w' && PA_IS_IDENT("weak"))
                    || (c0 == 's' && PA_IS_IDENT("shared"))
                    || (c0 == 'o' && PA_IS_IDENT("own")))) {
                if (c0 == 's')
                    PA_MGD_SHARED = 1;
                pa_advance();
                continue;
            }
        }
        if (c6_kw() && PA_IS_IDENT("closure")) { base = parse_closure_type(); continue; }
        if (pa_cur()->kind == TK_IDENT && tok_data(pa_cur())[0] == 't'
            && PA_IS_IDENT("thread") && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
            base = ty_thread();
            pa_advance();
            continue;
        }
        if (PA_ACCEPT_IDENT("extern")) {
            PA_EXTERN = 1;
            continue;
        }
        /* `__thread` / `_Thread_local`：线程局部存储的说明符。以前这两个词
         * 只是躺在关键字表里没人处理，顶层靠"把 `__thread` 当成隐式 int 的
         * 声明符名字"侥幸编过去——位域/声明形状一变就报错，而且语义上它们
         * 完全被忽略（tests2/144_tls 就是这么挂的）。 */
        if (PA_ACCEPT_IDENT("__thread") || PA_ACCEPT_IDENT("_Thread_local")) {
            PA_TLS = 1;
            continue;
        }
        if (PA_ACCEPT_IDENT("const") || PA_ACCEPT_IDENT("__const")) {
            qm = (u8)(qm | TQ_CONST);
            SAW_TYPE_QUAL = 1;
            continue;
        }
        if (PA_ACCEPT_IDENT("volatile") || PA_ACCEPT_IDENT("__volatile__")) {
            qm = (u8)(qm | TQ_VOLATILE);
            SAW_TYPE_QUAL = 1;
            continue;
        }
        if (PA_ACCEPT_IDENT("register") || PA_ACCEPT_IDENT("inline") ||
            PA_ACCEPT_IDENT("auto") || PA_ACCEPT_IDENT("__extension__")) {
            SAW_TYPE_QUAL = 1;
            continue;
        }
        if (PA_ACCEPT_IDENT("restrict") || PA_ACCEPT_IDENT("__restrict")
            || PA_ACCEPT_IDENT("__restrict__")) {
            qm = (u8)(qm | TQ_RESTRICT);
            SAW_TYPE_QUAL = 1;
            continue;
        }
        /* `static (int, int) f(…)`：元组返回类型出现在说明符**之后**。
         * 元组那条分支在循环之前，那时当前还是 `static`，所以这里补一次。 */
        if (base == 0 && pa_at_tuple_type()) {
            u32 tys[TUPLE_MAXN] = {0};
            u32 tn = 0;

            pa_advance();
            tys[tn++] = parse_typename();
            while (tn < TUPLE_MAXN && pa_accept_ch(','))
                tys[tn++] = parse_typename();
            pa_expect_ch(')');
            if (pa_is_ch('!') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
                PA_FALLIBLE = 1;
                pa_advance();
                pa_advance();
            }
            base = ty_tuple_chk(tys, tn);
            continue;
        }

        break;
    }
    if (!base && !saw_int) {
        Tok *t = pa_cur();

        /* 模板实例可以直接写在类型位置：`Vect@int v;`（不带 `struct`） */
        if (t->kind == TK_IDENT && pa_peek(1)->kind == TK_PUNCT
            && TOK_EQ(pa_peek(1), "@")) {
            Tmpl *tp = tmpl_find(tok_data(t), t->len);

            if (tp && !tp->is_func) {
                u32 args[TMPL_NPARAM] = {0};
                int paren = 0;

                pa_advance();               /* 名字 */
                pa_advance();               /* @ */
                if (pa_is_ch('('))
                    paren = 1;
                (void)tmpl_parse_args(tp, args, paren);
                base = tmpl_inst(tp, args);
                /* 实例后面还可能跟切片后缀：`Vect@int[:] s = arr;` */
                while (!PA_TMPL_ARG && pa_is_ch('[') && pa_peek(1)->kind == TK_PUNCT
                       && TOK_EQ(pa_peek(1), ":")) {
                    pa_advance();
                    pa_advance();
                    pa_expect_ch(']');
                    if (base == ty_void())
                        pa_error("'[:]' 不能是 void 元素类型");
                    base = ty_slice_chk(base);
                }
                goto typespec_done;
            }
        }
        if (t->kind == TK_IDENT) {
            Sym *s = sym_find(tok_data(t), t->len);

            /* 模块限定的类型名 `tu.module.Point`：前缀是命名空间装饰，跳到
             * 最后一段（只在第一段不是 typedef 时才退）。 */
            if ((!s || s->kind != SC_TYPEDEF) && pa_peek(1)
                && pa_peek(1)->kind == TK_PUNCT && TOK_EQ(pa_peek(1), ".")) {
                u32 qk2 = 1;

                while (pa_peek(qk2) && pa_peek(qk2)->kind == TK_PUNCT
                       && TOK_EQ(pa_peek(qk2), ".") && pa_peek(qk2 + 1)
                       && pa_peek(qk2 + 1)->kind == TK_IDENT)
                    qk2 += 2;
                if (qk2 > 1) {
                    Tok *lt2 = pa_peek(qk2 - 1);
                    Sym *ls2 = sym_find(tok_data(lt2), lt2->len);
                    Sym *ltg2 = sym_find_tag(tok_data(lt2), lt2->len);

                    if ((ls2 && ls2->kind == SC_TYPEDEF) || ltg2) {
                        while (qk2 > 1) {
                            pa_advance();
                            qk2--;
                        }
                        t = pa_cur();
                        s = ls2;
                    }
                }
            }
            /* c6 允许裸 tag 当类型用：`struct Node { Node *next; }`、
             * `typedef Vec VecAlias;`——typedef 查不到就再查标签表。 */
            if (NIFACE > 0 && (!s || s->kind != SC_TYPEDEF)) {
                u32 ii = iface_find(tok_data(t), t->len);

                if (ii < IFACE_MAX) {
                    base = ty_iface(ii);
                    pa_advance();
                    goto typespec_done;
                }
            }
            if (!s || s->kind != SC_TYPEDEF) {
                Sym *tg = sym_find_tag(tok_data(t), t->len);

                if (tg && tg->val)
                    s = tg;
            }
            if (s && (s->kind == SC_TYPEDEF || s->kind == SC_TAG)) {
                base = (s->kind == SC_TYPEDEF) ? s->type : (u32)s->val;
                pa_advance();
                /* c6 的 `T!error` 后缀：typedef 名（`i64!error fs_size(...)`）
                 * 是在循环之后才认的，循环里那段 `!error` 处理走不到，
                 * 得在这里补一次，否则 `i64` 被当成声明符名字，报"顶层声明缺名字" */
                if (pa_is_ch('!') && pa_peek(1) && pa_peek(1)->kind == TK_IDENT) {
                    if (base && ty_is_array(base))
                        pa_error("'!error' 不支持数组返回类型");
                    PA_FALLIBLE = 1;
                    pa_advance();
                    pa_advance();
                }
                /* typedef 名后面也可能直接跟切片后缀：`Row[:] rows`（c6 允许
                 * 把 `[:]` 写在类型位置）。循环里那个检查走不到这里，因为
                 * typedef 名是在循环**之后**才认的。 */
                while (!PA_TMPL_ARG && pa_is_ch('[') && pa_peek(1)->kind == TK_PUNCT
                       && TOK_EQ(pa_peek(1), ":")) {
                    pa_advance();
                    pa_advance();
                    pa_expect_ch(']');
                    if (base == ty_void())
                        pa_error("'[:]' 不能是 void 元素类型");
                    base = ty_slice_chk(base);
                }
            }
        }
    }
    if (saw_complex) {
        /* C99 6.7.2p4/p5：`_Complex` 只能修饰 float/double/long double；
         * 单写 `_Complex` 就是 `double _Complex`（`int _Complex` 是约束违背）。 */
        u32 cb = base ? base : (saw_int ? 0 : ty_double());

        if (cb) {
            u32 ct = ty_cplx_of_base(cb);

            if (!ct) {
                /* `long _Complex` 之类：long 单独不是 long double */
                pa_error("'_Complex' can only be applied to float, double or "
                         "long double (C99 6.7.2p4)");
                ct = TY_CPLX_D;
            }
            base = ct;
        } else {
            pa_error("'_Complex' can only be applied to float, double or "
                     "long double (C99 6.7.2p4)");
            base = TY_CPLX_D;
        }
        saw_complex = 0;
    }
    if (!base) {
        /* 只有**完全不带类型说明符**（`x;`、`_Alignas(16) i3;`）才是隐式 int，
         * 要发 tcc 口径的 warning（tests2/102_alignas.expect 与
         * 60_errors_and_warnings.expect 逐字要它）。`unsigned` / `long` /
         * `unsigned long` 这类组合也走本分支——但那只是在选宽度（saw_int 已
         * 置位），不是隐式 int；多打一条就把整个 TU 的输出全污染了（stddef.h
         * 的 `typedef unsigned long size_t;` 曾让 tests2 118 条全红）。
         * c6 源码总是显式类型，不打噪声。 */
        if (!saw_int && !in_c6_tu() && !PA_NO_II_WARN && !PA_KERNEL_MODE)
            PA_II_PENDING = 1;
        if (nlong >= 2)
            base = uns ? ty_ullong() : ty_llong();
        else if (nlong == 1)
            base = uns ? ty_ulong() : ty_long();
        else if (nshort)
            base = uns ? ty_ushort() : ty_short();
        else
            base = uns ? ty_uint() : ty_int();
    }
typespec_done:
    /* 后缀限定符：`Vec const *cq`、`int const volatile *p`。前缀的
     * const/volatile 在说明符循环里吃掉了，写在类型名**后面**的这一份
     * 以前没人管，`Vec const` 就被当成"声明符名字是 const"。
     * 语义上 qualifier 对 c6c 只是标记，吃掉即可。 */
    while (PA_IS_IDENT("const") || PA_IS_IDENT("volatile") || PA_IS_IDENT("restrict")
           || PA_IS_IDENT("__const") || PA_IS_IDENT("__volatile__")
           || PA_IS_IDENT("__restrict") || PA_IS_IDENT("__restrict__")) {
        if (PA_IS_IDENT("const") || PA_IS_IDENT("__const"))
            qm = (u8)(qm | TQ_CONST);
        else if (PA_IS_IDENT("volatile") || PA_IS_IDENT("__volatile__"))
            qm = (u8)(qm | TQ_VOLATILE);
        else
            qm = (u8)(qm | TQ_RESTRICT);
        pa_advance();
    }
    /* 数组上的限定符按 C11 6.7.3p9 落到元素上。别的类型不动：c6c 里
     * `const int` 仍然是 int（对象只读性走 Sym.is_const），只有数组这一条
     * 必须真的改类型 id（`typedef restrict int *arr[2]` 要和 `int *restrict [2]`
     * 同 id）。ty_qual 对数组正是往下推的。 */
    if (qm && base && ty_is_array(base))
        base = ty_qual(base, qm);
    /* 注意：`*` 归声明符管，不在这里吃。parse_typespec 是**每个声明语句**
     * 调一次的，而 `int *a, *b;` 里每个声明符都要自己再吃一遍 `*`——
     * 在这里吃会让第二个声明符多出一层指针。 */
    return base;
}

/* 声明符：指针/数组后缀已经在 parse_typespec 里吃了指针，这里只管名字与后缀 */
/* `__attribute__((…))` / `__asm__(…)` / `__extension__` 这类扩展：
 * 语法上要吃掉，语义上大多数可以忽略（glibc 和 tcc 的头里到处都是）。 */
static void skip_paren_group(void)
{
    int depth = 0;
    int n = 0;

    if (!pa_is_ch('('))
        return;
    do {
        Tok *t = pa_cur();

        if (t->kind == TK_EOF)
            return;
        if (t->kind == TK_PUNCT) {
            if (tok_eq(t, "("))
                depth++;
            else if (tok_eq(t, ")"))
                depth--;
        }
        pa_advance();
        n++;
    } while (depth > 0 && n < 100000);
}

/* `__attribute__((cleanup(fn)))`：作用域退出时调 fn(&变量) */
static const char *SAW_CLEANUP;
static u32 SAW_CLEANUP_LEN;
/* `__attribute__((alias("目标")))` 里的目标名；`__asm__("目标")` 是同一件事
 * 的另一种拼法（`void f(void) __asm__("target");`）。两者都"给这个名字
 * 换个落点"，所以合成一个 SAW_ALIAS 交给声明处处理。
 *
 * 只在**文件作用域声明**里认（PA_AT_DECL）：函数体里的 `asm("nop")` 是内联
 * 汇编，它的字符串不是符号名，认错了会把下一条声明做成别名。 */
static const char *SAW_ALIAS;
static const char *SAW_ASMNAME;
static int PA_AT_DECL;

/* 字符串 token 的文本带引号：属性里的符号名要去掉 */
static const char *sa_str_tok(Tok *t)
{
    const char *s = NULL;
    u32 n = 0;

    if (!t)
        return NULL;
    s = tok_data(t);
    n = t->len;
    if (n >= 2 && s[0] == '"' && s[n - 1] == '"')
        return arena_strndup(&A_main, s + 1, n - 2);
    return arena_strndup(&A_main, s, n);
}

/* skip_attributes 里那一长串 `pa_is_ident(...)` 在每个声明上都要跑一遍，
 * 每次都是一次 memcmp。先用 token 哈希快筛（标识符的哈希词法层已经算好了），
 * 命中才做真正的文本比较。 */
static const char *const SA_KW[] = {
    "__attribute__", "__attribute", "__extension__", "__restrict", "__restrict__",
    "restrict", "__inline", "__inline__", "inline", "__signed__", "_Nonnull",
    "_Nullable", "__const", "__volatile__", "__asm__", "__asm", "asm", NULL
};
static u32 SA_HASH[17];
static int SA_INIT;

static int sa_is_kw(Tok *t)
{
    u32 i = 0;

    if (!t || t->kind != TK_IDENT)
        return 0;
    if (!SA_INIT) {
        for (i = 0; SA_KW[i]; i++)
            SA_HASH[i] = tok_hash(SA_KW[i], strlen(SA_KW[i]));
        SA_INIT = 1;
    }
    for (i = 0; SA_KW[i]; i++)
        if (SA_HASH[i] == t->hash && tok_eq(t, SA_KW[i]))
            return 1;
    return 0;
}

static void skip_attributes(void)
{
    int n = 0;

    if (!sa_is_kw(pa_cur()))
        return;

    for (;;) {
        if (PA_IS_IDENT("__attribute__") || PA_IS_IDENT("__attribute")) {
            u32 save = FN.n;
            Tok *t1 = pa_peek(1);
            int is_ctor = 0;

            pa_advance();
            /* 扫一遍属性名，看是不是 constructor / destructor */
            if (t1 && t1->kind == TK_PUNCT && tok_eq(t1, "(")) {
                int depth = 0;
                int guard = 0;

                for (;;) {
                    Tok *c = pa_cur();

                    if (!c || c->kind == TK_EOF || ++guard > 256)
                        break;
                    if (c->kind == TK_PUNCT && tok_eq(c, "(")) {
                        depth++;
                        pa_advance();
                        continue;
                    }
                    if (c->kind == TK_PUNCT && tok_eq(c, ")")) {
                        depth--;
                        pa_advance();
                        if (depth <= 0)
                            break;
                        continue;
                    }
                    if (c->kind == TK_IDENT && TOK_EQ(c, "constructor"))
                        is_ctor = 1;
                    if (c->kind == TK_IDENT
                        && (TOK_EQ(c, "weak") || TOK_EQ(c, "__weak__")))
                        SAW_WEAK = 1;
                    if (c->kind == TK_IDENT
                        && (TOK_EQ(c, "cleanup") || TOK_EQ(c, "__cleanup__"))) {
                        Tok *nx = pa_peek(1);
                        Tok *ny = pa_peek(2);

                        if (nx && ny && nx->kind == TK_PUNCT && tok_eq(nx, "(")
                            && ny->kind == TK_IDENT) {
                            SAW_CLEANUP = arena_strndup(&A_main, tok_data(ny), ny->len);
                            SAW_CLEANUP_LEN = ny->len;
                        }
                    }
                    if (c->kind == TK_IDENT && TOK_EQ(c, "destructor"))
                        SAW_DTOR = 1;
                    /* `__attribute__((packed))`：布局按 pack(1) 走 */
                    if (c->kind == TK_IDENT && TOK_EQ(c, "packed"))
                        SAW_PACKED = 1;
                    /* `__attribute__((aligned(N)))` / `__declspec(align(N))`，
                     * 以及 GCC 的保留拼写 `__aligned(N)` / `__aligned__(N)`
                     * ——内核 include/linux/compiler_attributes.h 里
                     * `#define __aligned(x) __attribute__((__aligned__(x)))`，
                     * `atomic_t` 的第一句就是 `int __aligned(sizeof(int))
                     * counter;`，不认这个拼写整条内核头链从这里断。 */
                    if (c->kind == TK_IDENT
                        && (TOK_EQ(c, "aligned") || TOK_EQ(c, "align")
                            || TOK_EQ(c, "__aligned") || TOK_EQ(c, "__aligned__"))) {
                        Tok *nx2 = pa_peek(1);

                        if (nx2 && nx2->kind == TK_PUNCT && tok_eq(nx2, "(")) {
                            /* 值要按**常量表达式**求，不能只认一个数字字面量：
                             * 内核 include/linux/mm_types.h 里 struct page 的
                             *     } __attribute__((__aligned__(2 * sizeof(unsigned long))));
                             * 首 token 是 `2`，只取它会把对齐当成 2（实际是 16），
                             * 于是 sizeof(struct page) 给 56 而不是 64。
                             * 这里把整个 (…) 吃干净：查完求值，游标停在 `)` 之后。 */
                            u32 save3 = FN.n;
                            i64 av = 0;

                            pa_advance();      /* 对齐标识符 */
                            pa_advance();      /* ( */
                            av = const_expr();
                            FN.n = save3;
                            PEND_LVAL = 0;
                            if (pa_is_ch(')'))
                                pa_advance();
                            if (av > 0 && (int)av > SAW_ALIGN)
                                SAW_ALIGN = (int)av;
                            continue;          /* 已消费整组，跳过末尾的 pa_advance() */
                        }
                    }
                    /* `__attribute__((alias("目标")))`：这个名字没有自己的
                     * 代码/存储，只是目标的另一个入口 */
                    if (PA_AT_DECL && c->kind == TK_IDENT
                        && (TOK_EQ(c, "alias") || TOK_EQ(c, "__alias__"))) {
                        Tok *nx3 = pa_peek(1);
                        Tok *ny3 = pa_peek(2);

                        if (nx3 && ny3 && nx3->kind == TK_PUNCT && tok_eq(nx3, "(")
                            && ny3->kind == TK_STR)
                            SAW_ALIAS = sa_str_tok(ny3);
                    }
                    pa_advance();
                }
            } else {
                skip_paren_group();
            }
            FN.n = save;
            if (is_ctor)
                SAW_CTOR = 1;
        } else if (PA_IS_IDENT("__extension__") || PA_IS_IDENT("__restrict")
                   || PA_IS_IDENT("__restrict__") || PA_IS_IDENT("restrict")
                   || PA_IS_IDENT("__inline") || PA_IS_IDENT("__inline__")
                   || PA_IS_IDENT("inline") || PA_IS_IDENT("__signed__")
                   || PA_IS_IDENT("_Nonnull") || PA_IS_IDENT("_Nullable")
                   || PA_IS_IDENT("__const") || PA_IS_IDENT("__volatile__")) {
            pa_advance();
        } else if (PA_IS_IDENT("__asm__") || PA_IS_IDENT("__asm") || PA_IS_IDENT("asm")) {
            Tok *s1 = pa_peek(1);
            Tok *s2 = pa_peek(2);

            /* `void f(void) __asm__("target");`：asm 标签 = 别名。
             * 只有 `asm("名字")` 这个形状才算（带冒号的是内联汇编）。 */
            pa_advance();
            if (PA_AT_DECL && s1 && s2 && s1->kind == TK_PUNCT && tok_eq(s1, "(")
                && s2->kind == TK_STR) {
                Tok *s3 = pa_peek(2);

                if (s3 && s3->kind == TK_PUNCT && tok_eq(s3, ")"))
                    SAW_ASMNAME = sa_str_tok(s2);
            }
            skip_paren_group();
        } else {
            break;
        }
        if (++n > 64)
            break;
    }
}

static u32 parse_declarator(u32 base, Declarator *d);

/* 现在解析的是不是**形参**声明符：决定了 `[` 里的限定符往哪放。
 * 形参：C11 6.7.6.3p7「形参声明成数组时调整成**带限定符的指针**」——
 * 限定符归调整后的指针（`int ca[const 2]` → `int *const`，
 * tests2/149_parameter_qualifiers）。非形参：C11 6.7.3p9「数组上的限定符
 * 修饰的是元素」。 */
static int PA_IN_PARAMS;

static u32 parse_param_list(u32 fnret, Declarator *d)
{
    /* 一个声明符里可以有好几层参数表：
     *   `int (*f1(int a, int b))(int c, int b)`
     * 前一个是 f1 自己的，后一个属于**返回类型**那层函数类型。以前两层都往
     * d->nparams 尾巴上堆，于是这个定义被当成 4 个形参去绑帧，而且同名形参
     * （内层的 `b`）直接把外层 `b` 的槽位顶掉——`a != b` 读到的是垃圾，
     * 返回的函数指针一调就段错误（c-testsuite single-exec/00124）。
     *
     * 现在每层只认自己那一段 d->ptype[base_n ..]；只有"标识符自己那层"
     * （这个声明符里**第一个**解析到的参数表）的参数留在 d 上，因为
     * pa_func_def 要靠它绑帧。 */
    u32 base_n = d->nparams;
    int own_layer = d->own_params_taken ? 0 : 1;
    int save_knr = d->knr;
    int save_variadic = d->variadic;
    int save_nowarn = PA_NO_II_WARN;
    u32 r = 0;

    /* 见 PA_NO_II_WARN：形参表里 `...` / K&R 裸标识符走 parse_typespec 的
     * 隐式 int 兜底是合法旧路径，不许告警。 */
    PA_NO_II_WARN = 1;
    d->own_params_taken = 1;
    /* 声明符对象可能被复用，`...` 的标记不能从上一个声明符漏进来 */
    d->variadic = 0;
    /* 先嗅一下是不是旧式（K&R）参数表：真正的原型一定以类型名开头，
     * 而以裸标识符开头的只能是 `int f(a, b)` 这种。 */
    if (pa_cur()->kind == TK_IDENT && !is_typename_tok(pa_cur()))
        d->knr = 1;
    if (pa_accept_ch(')')) {
        r = ty_func(fnret, d->ptype + base_n, 0, 0);
        goto fin;
    }
    if (PA_IS_IDENT("void") && pa_peek(1)->kind == TK_PUNCT && tok_eq(pa_peek(1), ")")) {
        pa_advance();
        pa_advance();
        r = ty_func(fnret, d->ptype + base_n, 0, 0);
        goto fin;
    }
    for (;;) {
        Declarator pd = {0};
        u32 pt = 0;
        int save_inparams = PA_IN_PARAMS;

        skip_attributes();
        if (d->nparams >= PA_ARG_MAX) {
            pa_error("形参太多（上限 64）");
            skip_paren_group();
            r = ty_func(fnret, d->ptype + base_n, d->nparams - base_n, (u32)d->variadic);
            goto fin;
        }
        /* `...` 是**一个** token，不是形参。必须在 parse_typespec 之前拦下来：
         * 它在说明符位置没有类型，会被当成"隐式 int 的形参"，于是每个变参
         * 原型都多一条 `type defaults to int` 警告——c6c 自己的 stdio.h 就有
         * 4 条、unistd.h 还有，把 `-test` 那批"stderr 干净"的检查全打挂了。 */
        if (pa_is_punct("...")) {
            pa_advance();
            d->variadic = 1;
            break;
        }
        pt = parse_typespec();
        if (!pt)
            d->knr = 1;         /* 裸标识符形参：旧式（K&R）参数表 */
        PA_IN_PARAMS = 1;
        pt = parse_declarator(pt, &pd);
        PA_IN_PARAMS = save_inparams;
        if (ty_is_array(pt)) {
            /* 形参里的数组按指针传；`[` 里的限定符贴到这个指针上
             * （C11 6.7.6.3p7：`int ca[const 2]` 的形参类型是 `int *const`） */
            pt = ty_ptr(ty_target(pt));
            if (pd.arrqual)
                pt = ty_qual(pt, pd.arrqual);
        } else if (ty_is_func(pt)) {
            /* 形参里的**函数类型**也按指针传（C11 6.9.1p10 / 6.7.6.3p8：
             * "函数类型形参调整为指向函数的指针"）。
             *
             * 少了这一条，把函数类型 typedef 当形参用就直接崩解析：
             *     typedef int (pcpu_fc_cpu_distance_fn_t)(unsigned int, unsigned int);
             *     extern int pcpu_embed_first_chunk(…, pcpu_fc_cpu_distance_fn_t
             *                                       cpu_distance_fn, …);
             * 报"这里要 ')'（当前是 'cpu_distance_fn'）"——内核
             * include/linux/percpu.h:121 就是这一行。 */
            pt = ty_ptr(pt);
        } else if (pd.arrqual) {
            pt = ty_qual(pt, pd.arrqual);
        }
        d->ptype[d->nparams] = pt;
        d->pmgd[d->nparams] = (u8)(pd.mgd ? (pd.mgd_kind == 1 ? 2 : 1) : 0);
        d->pshared[d->nparams] = pd.mgd_shared;
        d->pconst[d->nparams] = pd.obj_const;
        /* 多层 VLA 形参（`int a[n][m]`）：形状记到函数声明符上，等 pa_func_def
         * 绑帧时算 stride。pd 是这一轮的临时声明符，所以记录要复制进 arena
         * ——函数定义可能在这之后才用到它（pa_func_def 在 parse_declarator
         * 返回之后才跑）。 */
        if (pd.pvla.nd >= 2) {
            PVla *pv = arena_alloc(&A_main, sizeof(PVla));

            *pv = pd.pvla;
            pv->idx = (u8)d->nparams;
            pv->next = d->pvla_head;
            d->pvla_head = pv;
        }
        if (pd.name) {
            d->pname[d->nparams] = pd.name;
            d->plen[d->nparams] = pd.nlen;
        }
        if (pa_accept_punct("...")) {
            d->variadic = 1;   /* 省略号不是形参：不进 nparams */
            break;
        }
        d->nparams++;
        if (!pa_accept_ch(','))
            break;
    }
    pa_expect_ch(')');
    r = ty_func(fnret, d->ptype + base_n, d->nparams - base_n, (u32)d->variadic);
fin:
    PA_NO_II_WARN = save_nowarn;
    if (!own_layer) {
        /* 不是自己那层：用完就退回，别把返回类型/形参类型里的形参名字
         * 混进这个函数定义的形参表里。 */
        d->nparams = base_n;
        d->knr = (u8)save_knr;
        d->variadic = save_variadic;
    }
    return r;
}

/* 后缀套在最里层的类型上（C 声明符的就近绑定规则）：
 * 普通情况 `int *f(int)`：后缀直接套在 int* 上 → 返回 int* 的函数；
 * 嵌套情况 `int (*f)(int)`：跳过指针套在 int 上 → 指向"返回 int 的函数"的指针。 */
static u32 decl_apply_suffix(u32 ty, Declarator *d, int at_target)
{
    u32 nptr = 0;
    u32 t = ty;
    u32 i = 0;

    if (at_target) {
        while (ty_is_ptr(t)) {
            nptr++;
            t = ty_target(t);
        }
    }
    /* 数组维度要**从右往左**套：`int a[2][3]` 是「2 个 int[3]」，不是
     * 「3 个 int[2]」。一边扫一边套就正好反了（`sizeof a[0]` 会给出 8 而不是
     * 12，推断长度的 `int a[][3]` 更是直接变成 0 长度）。所以先攒起来。 */
    {
        u32 dims[16] = {0};
        /* 每一维的两种情况：dims[i] = 常量长度；dimv[i] = 运行期长度的 vreg。
         * dimr[i] 记这一维是哪一种（0 = 常量，1 = 运行期，2 = 形参里的
         * 运行期维度，只在形参表里出现、这里不求值）。 */
        u32 dimv[16] = {0};
        u8 dimr[16] = {0};
        int nd = 0;

    while (pa_is_ch('(') || pa_is_ch('[')) {
        if (pa_is_ch('[')) {
            u32 cnt = 0;
            u8 bq = 0;
            /* 这一维的"源码形态"，跟着 dims[]/dimr[] 一起交给 dims_apply
             * （多层 VLA 形参要等到函数入口才能按名字取值，见 PA_DIMK） */
            u8 dk = 0;
            const char *dnm = NULL;
            u32 dnl = 0;
            u32 dc = 0;

            pa_advance();
            if (pa_is_ch(':')) {
                /* c6 切片：`T[:]` */
                pa_advance();
                pa_expect_ch(']');
                t = dims_apply(t, d, dims, dimv, dimr, nd);
                nd = 0;
                t = ty_slice_chk(t);
                skip_attributes();
                continue;
            }
            /* C99 数组形参：`int x[const 5]`、`int x[static 5]`、`int x[volatile 5]` */
            while (PA_IS_IDENT("const") || PA_IS_IDENT("volatile") || PA_IS_IDENT("restrict")
                   || PA_IS_IDENT("static") || PA_IS_IDENT("__restrict")
                   || PA_IS_IDENT("__restrict__")
                   || PA_IS_IDENT("__const") || PA_IS_IDENT("__volatile__")) {
                if (PA_IS_IDENT("const") || PA_IS_IDENT("__const"))
                    bq = (u8)(bq | TQ_CONST);
                else if (PA_IS_IDENT("volatile") || PA_IS_IDENT("__volatile__"))
                    bq = (u8)(bq | TQ_VOLATILE);
                else if (PA_IS_IDENT("restrict") || PA_IS_IDENT("__restrict")
                         || PA_IS_IDENT("__restrict__"))
                    bq = (u8)(bq | TQ_RESTRICT);
                pa_advance();
            }
            if (bq && d) {
                if (PA_IN_PARAMS) {
                    /* 形参：留给 parse_param_list 在数组退化时贴到指针上 */
                    d->arrqual = (u8)(d->arrqual | bq);
                } else {
                    /* 非形参：下推到元素（`int a[const 5]` 是 5 个 const int） */
                    t = ty_qual(t, bq);
                }
            }
            if (pa_is_ch(']')) {
                cnt = 0;
            } else if (pa_is_ch('*')) {
                /* `int x[const *]`：C99 的"未指定大小的 VLA 形参"，* 是占位符 */
                pa_advance();
                cnt = 0;
            } else if (PA_VLA_OK && d && pa_bracket_is_vla()) {
                /* C99 VLA：长度是运行期值。这里只把长度求出来记下，类型和
                 * stride 留到 dims_apply——多维（`int b[n][m]`）每一维的
                 * stride 都要先知道**后面**几维的长度才算得出来。 */
                if (nd < 16) {
                    dimv[nd] = value_of(gen_assign());
                    dimr[nd] = 1;
                    dims[nd] = 0;
                    PA_DIMK[nd] = 2;    /* 运行期表达式（形参那条路不给它用） */
                    nd++;
                } else {
                    pa_error("数组维度太多（上限 16）");
                    (void)value_of(gen_assign());
                }
                pa_expect_ch(']');
                skip_attributes();
                continue;
            } else if (d && PA_IN_PARAMS && pa_bracket_is_vla()) {
                /* C99 6.7.5.3p7：形参里的 `int a[n]` 只说明它是"VLA 形参"，
                 * 类型照样降成指针；长度表达式在**调用处**求值，这里既不必
                 * 求值也不能求值（还没进函数体）。以前这里按常量表达式求，
                 * 于是 `int sum(int n, int a[n])` 直接报"未知名字 n"。 */
                int dep = 1;
                int ntok = 0;
                Tok *t0 = pa_cur();

                while (pa_cur()->kind != TK_EOF) {
                    if (pa_is_ch('[')) {
                        dep++;
                    } else if (pa_is_ch(']') && --dep == 0) {
                        break;
                    }
                    if (ntok == 0)
                        t0 = pa_cur();
                    ntok++;
                    pa_advance();
                }
                cnt = 0;
                if (nd < 16) {
                    dimr[nd] = 2;       /* 2 = 形参的运行期维度（不求值） */
                    /* 长度这里求不了，但**形态**得记下来：多层 VLA 形参
                     * （`int a[n][m]`）的行 stride 要等形参有值才算，那时只能
                     * 按名字去找形参槽；写成别的表达式（`[n + 1]`）就没法
                     * 支持了，dimr[] 里分不出这两种，所以在 dims_apply 之前
                     * 记清楚（诊断的措辞也靠它，见那里的 for 循环）。 */
                    if (ntok == 1 && t0->kind == TK_IDENT) {
                        dk = 1;
                        dnm = tok_data(t0);
                        dnl = t0->len;
                    } else {
                        dk = 2;
                    }
                }
            } else {
                cnt = (u32)const_expr();
                dc = cnt;
            }
            pa_expect_ch(']');
            if (nd < 16) {
                PA_DIMK[nd] = dk;
                PA_DIMN[nd] = dnm;
                PA_DIML[nd] = dnl;
                PA_DIMC[nd] = dc;
                dims[nd++] = cnt;
            } else {
                t = ty_array(t, cnt);
            }
        } else {
            /* 函数后缀前面攒下的数组维度要先按逆序套上 */
            t = dims_apply(t, d, dims, dimv, dimr, nd);
            nd = 0;
            pa_advance();
            t = parse_param_list(t, d);
        }
        skip_attributes();
    }
    t = dims_apply(t, d, dims, dimv, dimr, nd);
    }
    for (i = 0; i < nptr; i++)
        t = ty_ptr(t);
    /* `int f(int n)!error;`：错误标记也可以写在声明符（参数表）之后 */
    if (pa_is_ch('!') && pa_peek(1)->kind == TK_IDENT) {
        PA_FALLIBLE = 1;
        pa_advance();
        pa_advance();
    }
    return t;
}

/* 内层声明符解出来的类型里，原始 base 藏在某一串 ptr/array/func 壳的最里面
 * （那个位置就是“洞”）。把外层的指针和外层后缀填进去：从洞里往外重建。 */
#define DH_MAX 24
static u32 decl_fill_hole(u32 ty, u32 nptr, Declarator *d, const u8 *pq, u32 base)
{
    u8 kind[DH_MAX] = {0};
    u32 num[DH_MAX] = {0};
    u32 keep[DH_MAX] = {0};
    u32 dep = 0;
    u32 t = ty;
    u32 i = 0;

    memset(kind, 0, sizeof(kind));
    memset(num, 0, sizeof(num));
    memset(keep, 0, sizeof(keep));
    /* 往下剥到 `base` 为止，**不是**剥到"第一层非指针"为止。
     *
     * base 自己就可能是指针（`typedef void *own_t;`），这时内层声明符
     * `(*a)(void)` 解出来是 `void **`，第一层指针是 `(*a)` 的、第二层是
     * base 自带的。按"剥到非指针"走会把 base 那层也当成外层指针扔到函数
     * 后缀外面，`own_t (*a)(void)` 就变成「指向『返回 void 的函数』的指针
     * 的指针」——`a(p)` 于是报"这里要 ';'（当前是 '('）"（内核
     * fs/locks.c 的 `fl_owner_t (*lm_get_owner)(fl_owner_t)` 正是这个形状）。 */
    while (dep < DH_MAX && t != base) {
        if (ty_is_ptr(t)) {
            kind[dep] = 0;
            keep[dep] = t;
            dep++;
            t = ty_target(t);
        } else if (ty_is_array(t)) {
            kind[dep] = 1;
            num[dep] = ty_array_n(t);
            keep[dep] = t;
            dep++;
            t = ty_target(t);
        } else if (ty_is_func(t)) {
            /* 洞在返回类型里（`int (*(*f)(void))(void)`） */
            kind[dep] = 2;
            keep[dep] = t;
            dep++;
            t = ty_func_ret(t);
        } else {
            break;
        }
    }
    for (i = 0; i < nptr; i++)
        t = ty_ptr_q(t, pq ? pq[i] : 0);
    t = decl_apply_suffix(t, d, 0);
    for (i = dep; i > 0; i--) {
        if (kind[i - 1] == 0) {
            /* 内层那层指针自己带的限定符（`int (* const f)(void)` 的 const）
             * 在 keep[] 里，套回去的时候要带上 */
            t = ty_ptr_q(t, TY_AT(keep[i - 1])->qual);
        } else if (kind[i - 1] == 1) {
            t = ty_array(t, num[i - 1]);
        } else {
            u32 prm[TY_PARAM_MAX] = {0};
            u32 n = ty_func_nparams(keep[i - 1]);
            u32 k = 0;
            u32 fid = keep[i - 1];

            if (n > TY_PARAM_MAX)
                n = TY_PARAM_MAX;
            for (k = 0; k < n; k++)
                prm[k] = ty_func_param(fid, k);
            t = ty_func(t, prm, n, ty_func_variadic(fid));
        }
    }
    return t;
}

/* 一个声明符里最多记多少层指针的限定符（超出就不记，只丢限定符不炸） */
#define PQ_MAX DH_MAX

static u32 parse_declarator(u32 base, Declarator *d)
{
    u32 ty = base;
    u32 nptr = 0;
    u32 i = 0;
    /* 每层指针的限定符掩码，按**扫描顺序**存（第 0 个就是最先读到的那层，
     * 也就是最里面、最先套到 base 上的那层）。决定类型 id 的那一份。 */
    u8 pq[PQ_MAX] = {0};

    memset(d, 0, sizeof(*d));
    d->type = base;
    if (PA_MGD_PTR) {                /* `@T` 的那层指针 */
        nptr += (u32)PA_MGD_PTR;
        PA_MGD_PTR = 0;
        d->mgd = 1;
        d->mgd_kind = (u8)PA_MGD_KIND;
        d->mgd_shared = (u8)PA_MGD_SHARED;
        PA_MGD_KIND = 0;
        PA_MGD_SHARED = 0;
    }
    skip_attributes();
    while (pa_accept_ch('*')) {
        /* 指针限定符可以叠加、重复：`int *restrict`、`const char * const *`…
         * （tcc 自己的源码里满是 `*restrict`）
         *
         * 只有**最外层**那层指针（token 里最后一个 `*`，也就是最后套到对象上的
         * 那层）的 const 才让被声明的对象本身只读：`int *const p` 的 p 不能
         * 赋值，`const int *p` 的 p 可以。所以每进一层指针就重置一次标记，
         * 循环结束时留下的是最外层的。tests2/149_parameter_qualifier_errors.c。 */
        d->obj_const = 0;
        {
            u8 q = 0;

            while (PA_IS_IDENT("const") || PA_IS_IDENT("volatile") || PA_IS_IDENT("restrict")
                   || PA_IS_IDENT("__restrict") || PA_IS_IDENT("__restrict__")
                   || PA_IS_IDENT("__const") || PA_IS_IDENT("__volatile__")) {
                if (PA_IS_IDENT("const") || PA_IS_IDENT("__const")) {
                    d->obj_const = 1;
                    q = (u8)(q | TQ_CONST);
                } else if (PA_IS_IDENT("volatile") || PA_IS_IDENT("__volatile__")) {
                    q = (u8)(q | TQ_VOLATILE);
                } else {
                    q = (u8)(q | TQ_RESTRICT);
                }
                pa_advance();
            }
            if (nptr < PQ_MAX)
                pq[nptr] = q;
        }
        nptr++;
        d->ptr_depth++;
        skip_attributes();
    }
    /* `(` 后面可以先跟一个 `__attribute__((...))` 再跟 `*`：
     *     typedef int (__attribute__((ms_abi)) *fp_t)(int);
     * 这时 pa_peek(1) 是标识符而不是 `*`，老判断认不出嵌套声明符，把 `(` 当成
     * 函数参数表、typedef 登记成 `int()`，fp_t 就不是类型名了——后面每个用
     * 到它的声明跟着全崩（内核 drivers/firmware/efi/libstub/efistub.h 的
     * efi_pci_io_protocol_cfg_t 就让 15+ 个 TU 编不过）。把"属性打头"也算进
     * 嵌套声明符，进分支后用 skip_attributes() 吃掉属性。 */
    if (pa_is_ch('(')
        && ((pa_peek(1) && pa_peek(1)->kind == TK_PUNCT
             && (TOK_EQ(pa_peek(1), "*") || tok_eq(pa_peek(1), "(")))
            || (pa_peek(1) && pa_peek(1)->kind == TK_IDENT
                && (tok_eq(pa_peek(1), "__attribute__")
                    || tok_eq(pa_peek(1), "__attribute")
                    || tok_eq(pa_peek(1), "__extension__"))))) {
        /* 嵌套声明符 (*name)(…)：括号里的 `*` 比外面的后缀更"紧"，
         * 而**外层**的指针反而套在最里面（贴着 base）。
         *
         *     int *(*f)(void);      f = 指向「返回 int* 的函数」的指针
         *     int (*q[4])(void);    q = 4 个「指向函数的指针」的数组
         *
         * 所以先把内层声明符按原 base 解出来（得到一个「在某个位置留了
         * 洞」的类型），再把外层的指针 + 外层后缀填进那个洞。 */
        u32 inner = 0;

        pa_advance();                 /* ( */
        inner = parse_declarator(base, d);
        pa_expect_ch(')');
        d->paren = 1;
        d->type = decl_fill_hole(inner, nptr, d, pq, base);
        d->is_func = ty_is_func(d->type);
        return d->type;
    }
    /* `(name)` 形态的嵌套声明符：`typedef int (fn_t)(unsigned int);`、
     * `int (f)(int);`。这里括号里没有 `*`，所以上面那个
     * `(*name)`/`((…))` 的分支不会命中——但语义完全一样：括号只是把 `fn_t`
     * 这个**名字**包起来，好让函数后缀粘到外层。
     *
     * 少这一条的话，`(fn_t)` 的 `(` 被当成**函数参数表**的开头，于是
     * `typedef int (fn_t)(unsigned int, unsigned int);` 会把类型登记成
     * `int()`（没有参数、返回 int），而 `fn_t` 后面的形参名 `d` 直接崩解析
     * （实测：内核 include/linux/percpu.h:110 的
     *  pcpu_fc_cpu_distance_fn_t 就是这种写法，用到它的是 :121）。 */
    if (pa_is_ch('(') && pa_peek(1)->kind == TK_IDENT && !PA_NO_NAME
        && pa_peek(2)->kind == TK_PUNCT && TOK_EQ(pa_peek(2), ")")) {
        u32 inner2 = 0;

        pa_advance();                 /* ( */
        inner2 = parse_declarator(base, d);
        pa_expect_ch(')');
        d->paren = 1;
        d->type = decl_fill_hole(inner2, nptr, d, pq, base);
        d->is_func = ty_is_func(d->type);
        /* 括号之后可能还挂着函数后缀：`typedef int (fn_t)(unsigned int);`
         * 的 `(unsigned int)` 要在这之后粘上去，由调用方继续解析。 */
        return d->type;
    }
    if (pa_cur()->kind == TK_IDENT && !PA_NO_NAME && cm_at_call(CM_ROLE_IDENT)) {
        /* `int cat(ab, cd) = 7;`：`ident` 宏当场拼成一个标识符 */
        u32 il = 0;
        const char *in2 = cm_ident_name(&il);

        if (in2) {
            d->name = in2;
            d->nlen = il;
        }
    }
    if (pa_cur()->kind == TK_IDENT && !PA_NO_NAME) {
        d->name = tok_data(pa_cur());
        d->nlen = pa_cur()->len;
        pa_advance();
    }
    ty = base;
    for (i = 0; i < nptr; i++)
        ty = ty_ptr_q(ty, i < PQ_MAX ? pq[i] : 0);
    skip_attributes();
    /* 普通声明符：后缀套在**整个**类型上（`int *f(int)` = 返回指针的函数）；
     * 只有嵌套声明符 `(*f)(…)` 才套到指针目标上。 */
    d->type = decl_apply_suffix(ty, d, 0);
    d->is_func = ty_is_func(d->type);
    return d->type;
}

/* --- 表达式 --- */

/* 流式求值只需要“最近一个值的类型”，不留表达式树（design.md §4）。
 *
 * 左值用**推迟取值**表示：gen_postfix 只把地址算进 vreg 并置 PEND_LVAL，
 * 真正需要值的一方（运算符 / return / 条件）调 value_of() 才发 LOAD。
 * 好处：`x = 1` 不会白读一次 x，也不需要“先看后面是不是 '='”的前瞻
 * （前瞻窗口只有 4 个 token，`a[i][j] = ...` 根本不够看）。 */
static u32 gen_expr(void);
static u32 gen_assign(void);
static u32 gen_cond(void);
static u32 gen_unary(void);
static u32 goto_label(const char *nm, u32 len);
/* 是不是浮点字面量：十进制里出现 '.' 或指数 e/E；十六进制里出现 'p/P' 或 '.' */
static int is_float_lit(const char *s, u32 n)
{
    int hex = 0;
    u32 i = 0;

    if (n > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
        hex = 1;
    for (i = 0; i < n; i++) {
        if (s[i] == '.')
            return 1;
        if (hex) {
            if (s[i] == 'p' || s[i] == 'P')
                return 1;
        } else if (s[i] == 'e' || s[i] == 'E') {
            return 1;
        }
    }
    return 0;
}

/* 10 的整数次幂（0..19 在 u64 里装得下，转 double 时都是精确值） */
static const u64 POW10_I[20] = {
    1ULL, 10ULL, 100ULL, 1000ULL, 10000ULL, 100000ULL, 1000000ULL,
    10000000ULL, 100000000ULL, 1000000000ULL, 10000000000ULL, 100000000000ULL,
    1000000000000ULL, 10000000000000ULL, 100000000000000ULL, 1000000000000000ULL,
    10000000000000000ULL, 100000000000000000ULL, 1000000000000000000ULL,
    10000000000000000000ULL
};

/* 十进制/十六进制浮点字面量 → IEEE-754 位模式。
 * 尾数 ≤ 2^53 且 |指数| ≤ 19 时只做一次乘或除，那一步就是正确舍入（Clinger
 * 快路径）；更长的字面量取前 19 位有效数字后走循环近似——不静默：精度只到
 * 双精度的最后一位，日常字面量都在快路径里。 */
static u64 float_lit_bits(const char *s, u32 n, int *is_f32)
{
    u64 m = 0;
    int dexp = 0;
    int ee = 0;
    int eneg = 0;
    int seen_dot = 0;
    int is_hex = 0;
    int have_e = 0;
    int i = 0;
    double v = 0;

    *is_f32 = 0;
    if (n > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'))
        is_hex = 1;
    i = is_hex ? 2 : 0;
    for (; i < (int)n; i++) {
        int c = (int)(unsigned char)s[i];
        int d = -1;

        if (c >= '0' && c <= '9')
            d = c - '0';
        else if (is_hex && c >= 'a' && c <= 'f')
            d = c - 'a' + 10;
        else if (is_hex && c >= 'A' && c <= 'F')
            d = c - 'A' + 10;
        if (d >= 0) {
            if (m < 1000000000000000000ULL) {
                m = m * (u64)(is_hex ? 16 : 10) + (u64)d;
                if (seen_dot)
                    dexp -= is_hex ? 4 : 1;
            } else if (!seen_dot) {
                dexp += is_hex ? 4 : 1;
            }
            continue;
        }
        if (c == '.') {
            seen_dot = 1;
            continue;
        }
        if (is_hex ? (c == 'p' || c == 'P') : (c == 'e' || c == 'E')) {
            have_e = 1;
            i++;
            if (i < (int)n && (s[i] == '-' || s[i] == '+')) {
                eneg = s[i] == '-';
                i++;
            }
            for (; i < (int)n; i++) {
                if (s[i] < '0' || s[i] > '9')
                    break;
                ee = ee * 10 + ((int)s[i] - '0');
            }
            /* 指数后面可能还有 f/F 后缀（.123E12F），别在这儿 break 掉 */
            i--;
            continue;
        }
        if (c == 'f' || c == 'F')
            *is_f32 = 1;
    }
    if (have_e && eneg)
        ee = -ee;
    if (is_hex) {
        int bexp = dexp + ee;

        v = (double)m;
        for (i = 0; i < bexp; i++)
            v = v * 2.0;
        for (i = 0; i < -bexp; i++)
            v = v / 2.0;
    } else {
        int de = dexp + ee;

        if (m <= (1ULL << 53) && de >= 0 && de < 20) {
            v = (double)m * (double)POW10_I[de];
        } else if (m <= (1ULL << 53) && de < 0 && -de < 20) {
            v = (double)m / (double)POW10_I[-de];
        } else {
            v = (double)m;
            for (i = 0; i < de; i++)
                v = v * 10.0;
            for (i = 0; i < -de; i++)
                v = v / 10.0;
        }
    }
    if (*is_f32) {
        u32 b32 = 0;
        float fv = (float)v;

        *(float *)&b32 = fv;          /* 类型双关：拿 float 的位模式 */
        return (u64)b32;
    }
    {
        u64 b64 = 0;

        *(double *)&b64 = v;
        return b64;
    }
}

static u32 gen_postfix(void);
static u32 parse_typename(void);
/* `_Static_assert ( 常量表达式 [, "消息"] ) ;` —— 档级和块级共用 */
static void parse_static_assert_rest(void)
{
    i64 v = 1;
    const char *msg = NULL;

    pa_expect_ch('(');
    v = const_expr();
    if (pa_accept_ch(',')) {
        /* 消息可以是**相邻字符串字面量的拼接**（C99 6.4.5），要连着吃。
         * 内核 include/linux/build_bug.h:17 的
         *     __BUILD_BUG_ON_ZERO_MSG(e, msg, ...) (… #e " is true")
         * 展开出来就是 `"BUILD_BUG_ON failed" " is true"` 两个相邻的串——
         * 只吃第一个的话，那个 " is true" 会被当成 `)` 之后的多余 token，
         * 报"这里要 ')'（当前是 '" is true"'）"。 */
        msg = (const char *)tok_data(pa_cur());
        while (pa_cur()->kind == TK_STR)
            pa_advance();
    }
    pa_expect_ch(')');
    pa_expect_ch(';');
    if (!v)
        pa_error("_Static_assert 失败%s%s", msg ? ": " : "", msg ? msg : "");
}

static void gen_stmt(void);
static void gen_local_decl(int need_semi);
static void pa_func_def(Sym *fn, Declarator *d);

#define DATA_VA(off) (ELF_BASE_VA + ELF_HDR + (off))

/* 类型 id → IR 的宽度/符号码 */
static u8 ir_ty_of(u32 t)
{
    switch (ty_kind(t)) {
    case TY_BOOL: return IRT_U8;
    case TY_CHAR: return IRT_I8;
    case TY_SCHAR: return IRT_I8;
    case TY_UCHAR: return IRT_U8;
    case TY_SHORT: return IRT_I16;
    case TY_USHORT: return IRT_U16;
    case TY_INT: return IRT_I32;
    case TY_UINT: return IRT_U32;
    case TY_LONG: return IRT_I64;
    case TY_LLONG: return IRT_I64;
    case TY_ULONG: return IRT_U64;
    case TY_ULLONG: return IRT_U64;
    /* `__int128` 没有对应的 IR 宽度：IR 寄存器一律 64 位。目前只保证
     * "声明得出、sizeof 对、拿地拿得到"，真正的 128 位运算没有实现。 */
    case TY_I128: return IRT_I64;
    case TY_U128: return IRT_U64;
    case TY_FLOAT: return IRT_F32;
    case TY_DOUBLE: return IRT_F64;
    case TY_LDOUBLE: return IRT_F64;
    /* bf16 的**值**在 IR 里是 f32：内存里 2 字节，一读出来就摊成 f32（见
     * load_lval），写回去之前按 RNE 舍入（见 store_lval）。这样后端一条
     * 指令都不用改：所有算术、比较、调用、返回都走现成的 F32/F64 通路。 */
    case TY_BF16: return IRT_F32;
    case TY_PTR: return IRT_PTR;
    case TY_ARRAY: return IRT_PTR;
    case TY_FUNC: return IRT_PTR;
    default: return IRT_U64;
    }
}

/* bf16 ↔ f32 的位级转换（值在 IR 里一律 f32，内存里是 u16）。
 *
 *   bf16 → f32：位模式左移 16 位（低 16 位补 0）就是精确值——bf16 的指数域和
 *               尾数高位与 f32 完全对齐，这一步没有舍入。
 *   f32 → bf16：round-to-nearest-even，和 torch / LLVM 的 fptrunc bfloat 同口径：
 *               r = (u + 0x7FFF + ((u >> 16) & 1)) >> 16
 *               NaN 单独保住：尾数小的 NaN 加 0x7FFF 会进位成 Inf，所以先判
 *               「指数全 1 且尾数非 0」，命中取 (u >> 16) | 0x40（安静的 NaN）。
 *               这里没有 select 指令，用 mask = 0 - c 做无分支选择。
 *
 * 两个方向都不开新 IR 操作：常量、移位、位与/或/异或、bitcast 就够，三个后端
 * 现成支持。 */
static u32 bf16_expand(u32 bits)
{
    u32 k16 = irfn_vreg(&FN);
    u32 z = irfn_vreg(&FN);
    u32 sh = irfn_vreg(&FN);
    u32 f = irfn_vreg(&FN);

    irfn_push(&FN, IR_CONST, IRT_U32, k16, 0, 0, 0, 16);
    irfn_push(&FN, IR_ZEXT, IRT_U32, z, bits, 0, 0, 0);
    irfn_push(&FN, IR_SHL, IRT_U32, sh, z, k16, 0, 0);
    irfn_push(&FN, IR_BITCAST, IRT_F32, f, sh, 0, 0, 0);
    return f;
}

/* f32 → bf16 的**位**（u32 低 16 位有效）；store 直接截断写、cast 再 bitcast
 * 回 f32，两条路共用这一份舍入。 */
static u32 bf16_round_bits(u32 f)
{
    u32 u = irfn_vreg(&FN);         /* f32 的位模式 */
    u32 k16 = irfn_vreg(&FN);
    u32 k7f = irfn_vreg(&FN);
    u32 kff = irfn_vreg(&FN);
    u32 ke = irfn_vreg(&FN);
    u32 km = irfn_vreg(&FN);
    u32 k40 = irfn_vreg(&FN);
    u32 zero = irfn_vreg(&FN);
    u32 one = irfn_vreg(&FN);
    u32 hi = irfn_vreg(&FN);
    u32 lsb = irfn_vreg(&FN);
    u32 t1 = irfn_vreg(&FN);
    u32 t2 = irfn_vreg(&FN);
    u32 r = irfn_vreg(&FN);
    u32 ex = irfn_vreg(&FN);
    u32 mn = irfn_vreg(&FN);
    u32 c1 = irfn_vreg(&FN);
    u32 c2 = irfn_vreg(&FN);
    u32 cnan = irfn_vreg(&FN);
    u32 mask = irfn_vreg(&FN);
    u32 ninv = irfn_vreg(&FN);
    u32 nanr = irfn_vreg(&FN);
    u32 a1 = irfn_vreg(&FN);
    u32 a2 = irfn_vreg(&FN);
    u32 res = irfn_vreg(&FN);

    irfn_push(&FN, IR_CONST, IRT_U32, k16, 0, 0, 0, 16);
    irfn_push(&FN, IR_CONST, IRT_U32, k7f, 0, 0, 0, 0x7FFFu);
    irfn_push(&FN, IR_CONST, IRT_U32, kff, 0, 0, 0, 0xFFFFFFFFu);
    irfn_push(&FN, IR_CONST, IRT_U32, ke, 0, 0, 0, 0x7F800000u);
    irfn_push(&FN, IR_CONST, IRT_U32, km, 0, 0, 0, 0x007FFFFFu);
    irfn_push(&FN, IR_CONST, IRT_U32, k40, 0, 0, 0, 0x40u);
    irfn_push(&FN, IR_CONST, IRT_U32, zero, 0, 0, 0, 0);
    irfn_push(&FN, IR_CONST, IRT_U32, one, 0, 0, 0, 1);

    irfn_push(&FN, IR_BITCAST, IRT_U32, u, f, 0, 0, 0);
    /* RNE：加 0x7FFF + 最低保留位，再右移 16 */
    irfn_push(&FN, IR_SHR, IRT_U32, hi, u, k16, 0, 0);
    irfn_push(&FN, IR_AND, IRT_U32, lsb, hi, one, 0, 0);
    irfn_push(&FN, IR_ADD, IRT_U32, t1, u, k7f, 0, 0);
    irfn_push(&FN, IR_ADD, IRT_U32, t2, t1, lsb, 0, 0);
    irfn_push(&FN, IR_SHR, IRT_U32, r, t2, k16, 0, 0);
    /* NaN：指数全 1 且尾数非 0 → (u>>16)|0x40 */
    irfn_push(&FN, IR_AND, IRT_U32, ex, u, ke, 0, 0);
    irfn_push(&FN, IR_CMP, IRT_U32, c1, ex, ke, 0, IRCC_EQ);
    irfn_setcc(&FN, IRCC_EQ);
    irfn_push(&FN, IR_AND, IRT_U32, mn, u, km, 0, 0);
    irfn_push(&FN, IR_CMP, IRT_U32, c2, mn, zero, 0, IRCC_NE);
    irfn_setcc(&FN, IRCC_NE);
    irfn_push(&FN, IR_AND, IRT_U32, cnan, c1, c2, 0, 0);
    /* 无分支选择：mask = 0 - cnan（全 1 / 0） */
    irfn_push(&FN, IR_SUB, IRT_U32, mask, zero, cnan, 0, 0);
    irfn_push(&FN, IR_XOR, IRT_U32, ninv, mask, kff, 0, 0);
    irfn_push(&FN, IR_OR, IRT_U32, nanr, r, k40, 0, 0);
    irfn_push(&FN, IR_AND, IRT_U32, a1, r, ninv, 0, 0);
    irfn_push(&FN, IR_AND, IRT_U32, a2, nanr, mask, 0, 0);
    irfn_push(&FN, IR_OR, IRT_U32, res, a1, a2, 0, 0);
    return res;
}

/* cast / 赋值到 bf16：舍入完再摊回 f32——表达式里看到的已经是舍入过的值，
 * 和 C 的 `(bf16)x` 语义一致（后续若再存一次，舍入是幂等的）。 */
static u32 bf16_round_val(u32 f)
{
    /* 注意：舍入出来的 16 位是 **bf16 的位模式**，要再左移 16 位才是 f32 的值
     * （直接 bitcast 会得到 0x00003F8D 这种次正规数，存回去就变 0）。 */
    return bf16_expand(bf16_round_bits(f));
}

static u32 load_lval(u32 addr, u32 ty)
{
    u32 d = irfn_vreg(&FN);

    /* bf16：只读 2 字节，再摊成 f32（位模式左移 16 位，无舍入）。 */
    if (ty_kind(ty) == TY_BF16) {
        irfn_push(&FN, IR_LOAD, IRT_U16, d, addr, 0, 0, 0);
        return bf16_expand(d);
    }
    irfn_push(&FN, IR_LOAD, ir_ty_of(ty), d, addr, 0, 0, 0);
    return d;
}

/* IR_STORE：dst 字段放地址，a 字段放值（见 x64.c6 的 IR_STORE） */
static void store_lval(u32 addr, u32 ty, u32 val)
{
    /* 聚合赋值（`*out = *in`、`s = t`）必须按字节整块拷：IR_STORE 只有
     * 1/2/4/8 的宽度，写成它只会拷头 8 字节（踩过：结构体拷贝只过前 8 字节，
     * 编译器自己编译自己时整个预处理器都读不出 token）。 */
    if (ty_is_agg(ty) || ty_is_array(ty)) {
        irfn_push(&FN, IR_COPY, IRT_U8, addr, val, 0, 0, ty_size(ty));
        return;
    }
    /* bf16：值在 f32 里，舍入成高 16 位再写 2 字节（重复舍入是幂等的）。 */
    if (ty_kind(ty) == TY_BF16) {
        u32 bits = bf16_round_bits(val);
        u32 lo = irfn_vreg(&FN);

        irfn_push(&FN, IR_TRUNC, IRT_U16, lo, bits, 0, 0, 0);
        irfn_push(&FN, IR_STORE, IRT_U16, addr, lo, 0, 0, 0);
        return;
    }
    irfn_push(&FN, IR_STORE, ir_ty_of(ty), addr, val, 0, 0, 0);
}

/* 位域写入：读存储单元 → 清掉这一段 → 把值左移掩码后或进去 → 写回单元。
 * 单元类型就是成员类型（offs 指向单元起始字节）。 */
static u32 gen_addr_off(u32 base, u32 off);

/* 位域 RMW 的小工具：常数进 vreg、二元运算出一个新 vreg */
static u32 bf_k(u64 c)
{
    u32 v = irfn_vreg(&FN);

    irfn_push(&FN, IR_CONSTK, IRT_U64, v, 0, 0, 0, irfn_kconst(&FN, c));
    return v;
}

static u32 bf_bin(u8 op, u32 a, u32 b)
{
    u32 d = irfn_vreg(&FN);

    irfn_push(&FN, op, IRT_U64, d, a, b, 0, 0);
    return d;
}

static void store_lval_bits(u32 addr, u32 ty, u32 bits, u32 bo, u32 val)
{
    u32 old = 0;

    /* packed 结构体里字段可能跨过 8 字节边界：`int x:12; char y:6; long long z:63;`
     * 的 z 从第 18 位起占 63 位，最后一位落在第 9 个字节上，一个 u64 装不下。
     * 这种跨字的按「u64 + 尾字节」两段做，两段都只碰字段真正覆盖到的字节。 */
    if (bits >= 1 && bits + bo > 64) {
        u64 fmask = (bits >= 64) ? ~0ULL : ((1ULL << bits) - 1);
        u32 alo = addr;
        u32 ahi = gen_addr_off(addr, 8);
        u32 lo = load_lval(alo, ty_ulong());
        u32 hi = load_lval(ahi, ty_uchar());
        u32 virt = bf_bin(IR_AND, val, bf_k(fmask));
        u64 mlo = fmask << bo;                     /* 低段掩码（溢出位自然丢掉） */
        u64 mhi = (bo > 0) ? ((fmask >> (64 - bo)) & 0xFFu) : 0;
        u32 plo = bf_bin(IR_SHL, virt, bf_k(bo));
        u32 phi = bo > 0 ? bf_bin(IR_SHR, virt, bf_k(64 - bo)) : virt;
        u32 rlo = bf_bin(IR_OR, bf_bin(IR_AND, lo, bf_k(~mlo)),
                         bf_bin(IR_AND, plo, bf_k(mlo)));
        u32 rhi = bf_bin(IR_OR, bf_bin(IR_AND, hi, bf_k(~mhi & 0xFFu)),
                         bf_bin(IR_AND, phi, bf_k(mhi)));

        store_lval(alo, ty_ulong(), rlo);
        store_lval(ahi, ty_uchar(), rhi);
        return;
    }
    if (bits >= 1 && bits <= 64 && ty_size(ty) * 8 < bits + bo) {
        u32 need = bits + bo;

        if (need <= 8)
            ty = ty_uchar();
        else if (need <= 16)
            ty = ty_ushort();
        else if (need <= 32)
            ty = ty_uint();
        else
            ty = ty_ulong();
    }
    old = load_lval(addr, ty);
    u32 d = old;

    if (bo > 0) {
        u32 k = irfn_vreg(&FN);

        irfn_push(&FN, IR_CONST, IRT_U64, k, 0, 0, 0, bo);
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_SHL, IRT_U64, d, val, k, 0, 0);
    } else {
        d = val;
    }
    {
        u64 keep = 0;
        u32 mk = irfn_vreg(&FN);
        u32 a1 = irfn_vreg(&FN);
        u32 a2 = irfn_vreg(&FN);
        u64 fmask = (bits >= 64) ? ~0ULL : ((1ULL << bits) - 1);

        keep = ~(fmask << bo);
        irfn_push(&FN, IR_CONSTK, IRT_U64, mk, 0, 0, 0, irfn_kconst(&FN, fmask << bo));
        irfn_push(&FN, IR_AND, IRT_U64, a1, d, mk, 0, 0);
        {
            u32 km = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONSTK, IRT_U64, km, 0, 0, 0, irfn_kconst(&FN, keep));
            irfn_push(&FN, IR_AND, IRT_U64, a2, old, km, 0, 0);
        }
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_OR, IRT_U64, d, a1, a2, 0, 0);
    }
    store_lval(addr, ty, d);
}

/* ---------- 闭包 ----------
 * 闭包是一个机器字，指向堆上的对象：
 *     { void *code; void *target/捕获… }
 * 调用约定：把对象自己当**隐藏的首参**传给 code（code 的签名因此比
 * 声明的签名多一个 `void *`）。捕获的变量是对象里的副本，所以闭包里的
 * 写改的是副本、多次调用之间保留状态——和 c6 的语义一致。 */

static u32 gen_addr_off(u32 base, u32 off);

#define CLOS_THUNK_MAX 64
static u32 CLOS_FTY[CLOS_THUNK_MAX];
static u32 CLOS_SYM[CLOS_THUNK_MAX];
static u32 NCLOS_THUNK;

/* 分配闭包对象：{ code = code_sym, … extra 字节待填 }，返回对象指针（vreg） */
static u32 clos_alloc(u32 code_sym, u32 extra)
{
    u32 msz = irfn_vreg(&FN);
    u32 env = irfn_vreg(&FN);
    u32 code = irfn_vreg(&FN);
    u32 msym = x64_sym(&X64, "malloc");

    irfn_push(&FN, IR_CONST, IRT_U64, msz, 0, 0, 0, 8 + extra);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, msz, 0, 0, 0);
    irfn_push(&FN, IR_CALL, IRT_PTR, env, 0, 0, 0, msym);
    FN.ops[FN.n - 1].narg = 1;
    irfn_push(&FN, IR_ADDR, IRT_PTR, code, 0, 0, 0, code_sym);
    FN.ops[FN.n - 1].flags = 2;
    irfn_push(&FN, IR_STORE, IRT_U64, env, code, 0, 0, 0);
    return env;
}

/* 生成（并按签名缓存）一个中转函数：(void *env, a0…) → env[1](a0…) */
static u32 clos_thunk(u32 fty)
{
    u32 i = 0;
    u32 np = ty_func_nparams(fty);
    u32 slots[18] = {0};
    u32 dst = 0;
    u32 tgt = 0;
    u32 tsym = 0;
    u32 n0 = FN.n;
    u32 nx = 0;
    IrOp *bak = NULL;
    TmplSaved sv = {0};
    char nm[64] = {0};

    for (i = 0; i < NCLOS_THUNK; i++)
        if (CLOS_FTY[i] == fty)
            return CLOS_SYM[i];
    bak = arena_alloc(&A_main, (size_t)(n0 ? n0 : 1) * sizeof(IrOp));
    if (n0)
        memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
    tmpl_save_state(&sv);
    snprintf(nm, sizeof(nm), "c6c_clos_thunk_%u", (unsigned)NCLOS_THUNK);
    tsym = x64_sym(&X64, arena_strndup(&A_main, nm, (u32)strlen(nm)));
    irfn_reset(&FN, nm);
    cv_next();      /* 换一代：CV_* 那张表按 vreg 编号索引 */
    CUR_RET_TY = ty_target(fty);
    FN.is_variadic = 0;
    /* 变参的闭包：thunk 把 env 挤成了第一个显式实参，所以后面的实参整体
     * 往后挪一格。多出来的实参个数在编译 thunk 时是不知道的（同一个类型
     * 可能被 1 个也可能被 5 个实参调用），这里固定多接 8 个槽位往下传：
     * 调用方少传的那些读到的是垃圾，被调方按自己的形参个数/va_arg 只取
     * 该取的那几个，不会看到它们。 */
    nx = ty_func_variadic(fty) ? 8 : 0;
    /* FN.params 只有 16 格：形参个数要在这儿就掐住（以前 `i < 18` 已经能
     * 写越界，只是没人踩到；变参多接 8 格一下就踩到了）。 */
    if (np + 1 + nx > 16)
        nx = np + 1 < 16 ? 15 - np : 0;
    for (i = 0; i < np + 1 + nx && i < 16; i++) {
        slots[i] = irfn_vreg(&FN);
        FN.params[FN.nparams++] = slots[i];
    }
    tgt = irfn_vreg(&FN);
    irfn_push(&FN, IR_LOAD, IRT_PTR, tgt, gen_addr_off(slots[0], 8), 0, 0, 0);
    for (i = 0; i < np + nx && i < 16; i++)
        irfn_push(&FN, IR_ARG, IRT_U64, 0, slots[i + 1], 0, 0, i);
    dst = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALLI, ir_ty_of(ty_target(fty)), dst, tgt, 0, 0, 0);
    FN.ops[FN.n - 1].narg = (u8)(np + nx < 16 ? np + nx : 16);
    irfn_push(&FN, IR_RET, ir_ty_of(ty_target(fty)), 0, dst, 0, 0, 0);
    x64_compile(&X64, &FN, tsym);
    tmpl_restore_state(&sv);
    if (n0)
        memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
    if (NCLOS_THUNK < CLOS_THUNK_MAX) {
        CLOS_FTY[NCLOS_THUNK] = fty;
        CLOS_SYM[NCLOS_THUNK] = tsym;
        NCLOS_THUNK++;
    }
    return tsym;
}

/* 普通函数指针 → 闭包：对象里存 {中转函数, 目标地址} */
static u32 clos_of_fn(u32 tgt, u32 fty)
{
    u32 env = clos_alloc(clos_thunk(fty), 8);
    u32 t8 = gen_addr_off(env, 8);

    irfn_push(&FN, IR_STORE, IRT_U64, t8, tgt, 0, 0, 0);
    return env;
}

/* ---------- spawn / thread ----------
 * `spawn f(a, b)`：实参在 spawn 处求值，拷进堆上的参数块
 *   { 代码指针, 目标地址, a0, a1, … }
 * 再 pthread_create 起线程；返回的 thread 就是那个含 pthread_t 的句柄对象。 */
#define SPN_THUNK_MAX 16
static u32 SPN_SYM[SPN_THUNK_MAX];

static void mgd_release(u32 v);        /* 托管引用的释放（定义在下面） */

/* 中转函数按 (实参个数, 哪些实参是托管引用) 缓存：托管实参要在线程体返回后
 * 放掉实参块那一份计数（"线程活多久对象就活多久"）。 */
static u32 spawn_thunk(int n, u32 mgdmask)
{
    u32 i = 0;
    u32 n0 = FN.n;
    IrOp *bak = NULL;
    TmplSaved sv = {0};
    char nm[64] = {0};
    u32 tsym = 0;
    u32 envs = 0;
    u32 tg = 0;
    u32 dst = 0;

    if (n < SPN_THUNK_MAX && mgdmask == 0 && SPN_SYM[n])
        return SPN_SYM[n];
    bak = arena_alloc(&A_main, (size_t)(n0 ? n0 : 1) * sizeof(IrOp));
    if (n0)
        memcpy(bak, FN.ops, (size_t)n0 * sizeof(IrOp));
    tmpl_save_state(&sv);
    if (mgdmask)
        snprintf(nm, sizeof(nm), "c6c_spawn_%d_%x", n, (unsigned)mgdmask);
    else
        snprintf(nm, sizeof(nm), "c6c_spawn_%d", n);
    tsym = x64_sym(&X64, arena_strndup(&A_main, nm, (u32)strlen(nm)));
    irfn_reset(&FN, nm);
    cv_next();      /* 换一代：CV_* 那张表按 vreg 编号索引 */
    CUR_RET_TY = ty_ptr(ty_void());
    FN.is_variadic = 0;
    envs = irfn_vreg(&FN);
    FN.params[FN.nparams++] = envs;
    tg = irfn_vreg(&FN);
    irfn_push(&FN, IR_LOAD, IRT_PTR, tg, gen_addr_off(envs, 8), 0, 0, 0);
    for (i = 0; i < (u32)n && i < 16; i++) {
        u32 av = irfn_vreg(&FN);

        irfn_push(&FN, IR_LOAD, IRT_U64, av,
                  gen_addr_off(envs, 16 + 8 * i), 0, 0, 0);
        irfn_push(&FN, IR_ARG, IRT_U64, 0, av, 0, 0, i);
    }
    dst = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALLI, IRT_I64, dst, tg, 0, 0, 0);
    FN.ops[FN.n - 1].narg = (u8)(n < 16 ? n : 16);
    /* 托管实参：线程体已经返回，实参块那一份计数该还回去 */
    for (i = 0; i < (u32)n && i < 16; i++)
        if (mgdmask & (1u << i)) {
            u32 rv = irfn_vreg(&FN);

            irfn_push(&FN, IR_LOAD, IRT_U64, rv,
                      gen_addr_off(envs, 16 + 8 * i), 0, 0, 0);
            mgd_release(rv);
        }
    /* 中转函数把被调函数的返回值交出去：句柄的 h->value() 就是它
     * （`thread h = spawn f(x); h->value()`）。 */
    irfn_push(&FN, IR_RET, IRT_I64, 0, dst, 0, 0, 0);
    /* 中转函数也是"函数"：C99/LLVM 后端要按自己的方式发出去，不能只写镜像 */
    pa_emit_fn(&FN, tsym);
    tmpl_restore_state(&sv);
    if (n0)
        memcpy(FN.ops, bak, (size_t)n0 * sizeof(IrOp));
    if (n < SPN_THUNK_MAX && mgdmask == 0)
        SPN_SYM[n] = tsym;
    return tsym;
}

/* 闭包的隐式转换：函数/函数指针 → 闭包对象（包一层中转函数） */
static u32 clos_conv(u32 v, u32 vty)
{
    u32 f = 0;

    if (ty_is_closure(vty, NULL))
        return v;
    /* 变参函数包不成闭包：中转函数得知道实参表长什么样，而变参的长度只有
     * 调用方知道（tests/errors/closure_convert.c6 的 test_variadic）。 */
    if ((ty_is_func(vty) || (ty_is_ptr(vty) && ty_is_func(ty_target(vty))))
        && ty_func_variadic(ty_is_func(vty) ? vty : ty_target(vty)) && in_c6_tu())
        pa_error("a variadic function pointer cannot be wrapped into a closure: a "
                 "trampoline cannot forward an unknown argument list (make it a "
                 "capturing literal instead)");
    if (ty_is_func(vty))
        f = vty;
    else if (ty_is_ptr(vty) && ty_is_func(ty_target(vty)))
        f = ty_target(vty);
    else
        return v;
    return clos_of_fn(v, f);
}

/* 位域取值：单元按实际跨度选（packed 结构体里字段可能跨过声明类型宽度），
 * 取出后右移位偏移、按位宽掩码，有符号再算术右移补符号。 */
static u32 load_bf(u32 addr, u32 ty, u32 bits, u32 bo, int is_signed, int zero_ext)
{
    u32 v2 = 0;
    u32 d = 0;

    if (bits >= 1 && bits + bo > 64) {
        /* 跨 8 字节边界：低 8 字节 + 尾字节拼回整段。这里已经移过位了，
         * 下面的公共尾巴不能再移一次（bo 会被移两遍，值变成 >>2*bo）。 */
        u32 lo = load_lval(addr, ty_ulong());
        u32 hi = load_lval(gen_addr_off(addr, 8), ty_uchar());

        v2 = bf_bin(IR_SHR, lo, bf_k(bo));
        v2 = bf_bin(IR_OR, v2, bf_bin(IR_SHL, hi, bf_k(64 - bo)));
        bo = 0;
    } else {
        if (bits >= 1 && bits <= 64 && ty_size(ty) * 8 < bits + bo) {
            u32 need = bits + bo;

            if (need <= 8)
                ty = ty_uchar();
            else if (need <= 16)
                ty = ty_ushort();
            else if (need <= 32)
                ty = ty_uint();
            else
                ty = ty_ulong();
        }
        v2 = load_lval(addr, ty);
    }
    d = v2;
    if (bo > 0) {
        u32 k = irfn_vreg(&FN);

        irfn_push(&FN, IR_CONST, IRT_U64, k, 0, 0, 0, bo);
        d = irfn_vreg(&FN);
        irfn_push(&FN, IR_SHR, IRT_U64, d, v2, k, 0, 0);
    }
    if (bits < 64) {
        u32 m = irfn_vreg(&FN);
        u32 d2 = irfn_vreg(&FN);
        u64 mask = (1ULL << bits) - 1;

        irfn_push(&FN, IR_CONSTK, IRT_U64, m, 0, 0, 0, irfn_kconst(&FN, mask));
        irfn_push(&FN, IR_AND, IRT_U64, d2, d, m, 0, 0);
        d = d2;
    }
    if (is_signed && !zero_ext && bits < 64) {
        u32 sh = irfn_vreg(&FN);
        u32 a1 = irfn_vreg(&FN);
        u32 a2 = irfn_vreg(&FN);

        irfn_push(&FN, IR_CONST, IRT_U64, sh, 0, 0, 0, 64 - bits);
        irfn_push(&FN, IR_SHL, IRT_U64, a1, d, sh, 0, 0);
        irfn_push(&FN, IR_SAR, IRT_U64, a2, a1, sh, 0, 0);
        d = a2;
    }
    return d;
}

/* 带隐式转换的存值：赋值/初始化把右值转成左值类型（浮点尤其要，否则
 * `float f = <double 字面量>;` 会把 double 位模式的低 4 字节当 float） */
static void store_conv(u32 addr, u32 ty, u32 v, u32 vty)
{
    u32 ifx = 0;
    u32 cft = 0;

    /* 复数（C99 6.5.16.1 的简单赋值转换）：
     *   实数 → 复数：实部 = 值，虚部 = 0；
     *   float _Complex ↔ double _Complex：逐分量转换；
     *   复数 → 实数：C99 要求显式 cast，这里按 cast 的口径取实部（gcc 也只在
     *   显式 cast 时才认；隐式的那条路留给 gen_convert 报"不能转换"）。 */
    if (ty_is_cplx(ty) || ty_is_cplx(vty)) {
        u32 dct = cplx_comp(ty);
        u32 dsz = ty_size(dct);

        if (ty_is_cplx(ty) && ty_is_cplx(vty)) {
            if (ty != vty) {
                u32 sct = cplx_comp(vty);

                store_lval(gen_addr_off(addr, 0), dct,
                           gen_convert(cplx_load(v, sct, 0), sct, dct));
                store_lval(gen_addr_off(addr, dsz), dct,
                           gen_convert(cplx_load(v, sct, ty_size(sct)), sct, dct));
            } else {
                store_lval(addr, ty, v);      /* 同类型：整块拷 */
            }
            return;
        }
        if (ty_is_cplx(ty)) {
            if (vty != dct)
                v = gen_convert(v, vty, dct);
            store_lval(gen_addr_off(addr, 0), dct, v);
            store_lval(gen_addr_off(addr, dsz), dct, cplx_zero(dct));
            return;
        }
        /* 复数 → 实数 */
        {
            u32 sct = cplx_comp(vty);

            v = cplx_load(v, sct, 0);
            vty = sct;
        }
    }

    /* 结构体 → 接口的隐式转换（`Shape s = q;`）：胖指针是 {self, vt}，
     * self 存源对象的地址、vt 存静态 vtable 的地址。
     * 以前这里直接当聚合拷贝，第一字段进了 self、vt 留空，一调方法就跳野指针。 */
    if (TY_HAS_IFACE && NIFACE > 0 && ty_is_iface(ty, &ifx) && ty_is_agg(vty)
        && !ty_is_iface(vty, NULL)) {
        u32 sty = ty_is_ptr(vty) ? ty_target(vty) : vty;
        u32 vv = irfn_vreg(&FN);
        u32 sym = 0;

        /* 转换点先验签名：赋值/初始化也要报"没实现"，否则 vtable 里留空槽，
         * 一调方法就跳野指针（tests/errors/iface.c6 的 test_proto_scope_tag
         * 就是靠这里报出来的）。 */
        iface_check_impl(sty, ifx);
        sym = iface_vtbl(ifx, sty);

        store_conv(gen_addr_off(addr, 0), ty_ptr(ty_void()), v, ty_ptr(ty_void()));
        irfn_push(&FN, IR_ADDR, IRT_PTR, vv, 0, 0, 0, sym);
        FN.ops[FN.n - 1].flags = 2;
        store_conv(gen_addr_off(addr, 8), ty_ptr(ty_void()), vv, ty_ptr(ty_void()));
        return;
    }
    if (TY_HAS_CLOSURE && ty_is_closure(ty, &cft)) {
        v = clos_conv(v, vty);
        store_lval(addr, ty, v);
        return;
    }
    if (vty != ty && (ty_is_float(ty) || ty_is_float(vty)))
        v = gen_convert(v, vty, ty);
    store_lval(addr, ty, v);
}

/* ---------- 托管引用（`@T`）的引用计数 ----------
 * 机器层面 `@T` 就是 `T *`；前端负责在初始化、赋值、退出作用域、return
 * 这几处插 `__c6_gc_retain` / `__c6_gc_release`。没落到托管局部量上的临时
 * 值（`new T;` 丢弃、`f(new T)` 实参）在语句结束/调用返回后立刻释放。 */
#define MGD_TMP_MAX 64
static u32 MGD_TMPV[MGD_TMP_MAX];
static int NMGD_TMP;
static int PEND_MGD;             /* 当前左值是托管局部量 */
static Sym *PEND_MGD_SYM;
/* 当前左值对应的符号（不限托管量）。只用来判"这个对象是不是只读的"，
 * 赋值给 `int *const p` 时要发一条 tcc 口径的 warning。 */
static Sym *PEND_SYM;
/* 多维 VLA 的下标状态：`b[i]` 要乘**声明处算好的行 stride**，不是 sizeof(元素)。
 * 这个状态跟"待取值的左值"同寿命——mark_lval 清零，标识符那条路（名字直接
 * 就是 VLA 对象）设上，gen_postfix_ops 每吃掉一个 `[` 就往下挪一维。
 * 只认"基址是直接声明出来的 VLA 符号"这一种形态：中间隔了任何别的运算
 * （`f()[0]`、`(*p)[0]`）都会在 mark_lval 那里被清掉，不会张冠李戴。 */
static Sym *PEND_VSYM;
static u32 PEND_VDIM;

static u32 mgd_call1(const char *fn, u32 v)
{
    Sym *ms = sym_find(fn, (u32)strlen(fn));
    u32 d = 0;

    if (!ms || !ms->is_func)
        return 0;
    /* v 一定是真的虚寄存器（vreg 0 也是合法的）；槽里存的 0 到运行时就是
     * NULL，release(NULL) 直接返回。 */
    irfn_push(&FN, IR_ARG, IRT_U64, 0, v, 0, 0, 0);
    d = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALL, IRT_VOID, d, 0, 0, 0, (u32)ms->val);
    FN.ops[FN.n - 1].narg = 1;
    return d;
}

static void mgd_retain(u32 v)
{
    mgd_call1("__c6_gc_retain", v);
}

static void mgd_release(u32 v)
{
    mgd_call1("__c6_gc_release", v);   /* 0 就是 NULL，运行时直接返回 */
}

static void mgd_tmp_add(u32 v)
{
    if (NMGD_TMP < MGD_TMP_MAX)
        MGD_TMPV[NMGD_TMP++] = v;
}

/* v 是不是"还没被谁接管的新引用"（`new T` 的结果）？只看不动。 */
static int mgd_tmp_has(u32 v)
{
    int i = 0;

    for (i = 0; i < NMGD_TMP; i++)
        if (MGD_TMPV[i] == v)
            return 1;
    return 0;
}

/* 所有权从"临时值"转给某个托管量：从待释放表里摘掉 */
static int mgd_tmp_take(u32 v)
{
    int i = NMGD_TMP - 1;

    for (; i >= 0; i--)
        if (MGD_TMPV[i] == v) {
            int k = i;

            for (; k + 1 < NMGD_TMP; k++)
                MGD_TMPV[k] = MGD_TMPV[k + 1];
            NMGD_TMP--;
            return 1;
        }
    return 0;
}

static void mgd_tmp_flush(void)
{
    while (NMGD_TMP > 0) {
        NMGD_TMP--;
        mgd_release(MGD_TMPV[NMGD_TMP]);
    }
}

/* `__c6_gc_weak(&槽, 目标)`：把弱槽登记到运行时，目标死亡时置空 */
static void mgd_weak(u32 slot_addr, u32 val)
{
    Sym *ms = sym_find("__c6_gc_weak", 12);

    if (!ms || !ms->is_func)
        return;
    irfn_push(&FN, IR_ARG, IRT_U64, 0, slot_addr, 0, 0, 0);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, val, 0, 0, 1);
    {
        u32 d = irfn_vreg(&FN);

        irfn_push(&FN, IR_CALL, IRT_VOID, d, 0, 0, 0, (u32)ms->val);
        FN.ops[FN.n - 1].narg = 2;
    }
}

static void mgd_defer_push(u32 slot_v);
static void task_defer_push(u32 slot_v);

static void mark_lval(u32 addr, u32 ty)
{
    PEND_LVAL = 1;
    PEND_ADDR = addr;
    PEND_TY = ty;
    PEND_BITS = 0;
    PEND_MGD = 0;
    PEND_MGD_SYM = NULL;
    PEND_SYM = NULL;
    PEND_VSYM = NULL;
    PEND_VDIM = 0;
    GEN_TY = ty;
}

/* 当前操作数的类型：左值取 PEND_TY，但位域要按 C99 6.3.1.1p2 提升——
 * **放得进 int 就提升成 int**，跟声明类型无关（`long long b:2` 也是 int，
 * tests2 的 95_bitfields 用 `sizeof(s->b + 0)` 判打印宽度）；32 位按声明
 * 类型的符号选 int/uint。`s.u3 - 100 < 0` 也靠它按有符号算。 */
static u32 cur_op_ty(void)
{
    u32 t = PEND_LVAL ? PEND_TY : GEN_TY;

    if (PEND_LVAL && PEND_BITS >= 1 && PEND_BITS <= 64) {
        if (PEND_BITS <= 31)
            return ty_int();
        if (PEND_BITS == 32)
            return ty_is_signed(t) ? ty_int() : ty_uint();
    }
    return t;
}

/* 把“待取值”的左值变成值；不是左值就原样返回 */
static u32 value_of(u32 v)
{
    u32 addr = 0;
    u32 ty = 0;

    if (!PEND_LVAL)
        return v;
    PEND_LVAL = 0;
    addr = PEND_ADDR;
    ty = PEND_TY;
    GEN_TY = ty;
    /* 多维 VLA 的"行"左值（`b[i]`）：它的地址就是它的值（整块里的一层），
     * 没有槽可以读。少这一条会去读数组里面那块字节当指针用（踩过）。 */
    if (PEND_VSYM && PEND_VDIM > 0)
        return addr;
    if (ty_is_array(ty)) {
        GEN_TY = ty_ptr(ty_target(ty));   /* 数组自动退化成指向首元素的指针 */
        return addr;
    }
    if (ty_is_func(ty)) {
        /* 函数左值（`*fp` / 函数名）的值就是地址，不能再去读它的头 8 字节。
         * typeof 例外：它要的是函数类型本身，不是退化成指针的类型。 */
        GEN_TY = NO_DECAY ? ty : ty_ptr(ty);
        return addr;
    }
    if (ty_is_agg(ty))
        return addr;                      /* 聚合值用地址代表（只用于拷贝） */
    {
        u32 bits = PEND_BITS;
        u32 bo = PEND_BITOFF;
        u32 v2 = 0;

        if (bits >= 1 && bits <= 64) {
            v2 = load_bf(addr, ty, bits, bo, ty_is_signed(ty), PEND_BF_ENUM);
            /* 位域的整型提升（C99 6.3.1.1p2）：**放得进 int 就提升成 int**，
             * 跟声明类型无关。`long long b:2` 的表达式类型因此是 int——tcc/gcc
             * 都这样（tests2 的 95_bitfields 靠 `sizeof(s->b + 0)` 判断打印宽度）。 */
            if (bits <= 31)
                GEN_TY = ty_int();
            else if (bits == 32)
                GEN_TY = ty_is_signed(ty) ? ty_int() : ty_uint();
            PEND_BITS = 0;
            PEND_BITOFF = 0;
            return v2;
        }
        v2 = load_lval(addr, ty);

        PEND_BITS = 0;
        PEND_BITOFF = 0;
        if (bits >= 1 && bits <= 64 && (bo > 0 || bits < 64 || ty_is_signed(ty))) {
            u32 d = v2;

            if (bo > 0) {
                u32 k = irfn_vreg(&FN);

                irfn_push(&FN, IR_CONST, IRT_U64, k, 0, 0, 0, bo);
                d = irfn_vreg(&FN);
                irfn_push(&FN, IR_SHR, IRT_U64, d, v2, k, 0, 0);
            }
            if (bits < 64) {
                u32 m = irfn_vreg(&FN);
                u32 d2 = irfn_vreg(&FN);
                u64 mask = (1ULL << bits) - 1;

                irfn_push(&FN, IR_CONSTK, IRT_U64, m, 0, 0, 0, irfn_kconst(&FN, mask));
                irfn_push(&FN, IR_AND, IRT_U64, d2, d, m, 0, 0);
                d = d2;
            }
            /* 枚举类型的位域不符号扩展：tcc 对"只用正数的枚举"按零扩展，
             * 这样 8 位枚举位域存 148 这种带 bit7 的值才不会变成负数
             * （tcc tests2 的 92_enum_bitfield 就在验这一点）。 */
            if (ty_is_signed(ty) && !PEND_BF_ENUM && bits < 64) {
                u32 sh = irfn_vreg(&FN);
                u32 a1 = irfn_vreg(&FN);
                u32 a2 = irfn_vreg(&FN);

                irfn_push(&FN, IR_CONST, IRT_U64, sh, 0, 0, 0, 64 - bits);
                irfn_push(&FN, IR_SHL, IRT_U64, a1, d, sh, 0, 0);
                irfn_push(&FN, IR_SAR, IRT_U64, a2, a1, sh, 0, 0);
                d = a2;
            }
            v2 = d;
        }
        if (bits >= 1 && bits <= 31 && !ty_is_signed(ty))
            GEN_TY = ty_int();            /* 位域整型提升 */
        return v2;
    }
}

static u32 ident_addr(Sym *s)
{
    u32 v = irfn_vreg(&FN);

    /* 闭包体里的捕获变量：地址是环境对象里的那一格 */
    if (FLCAP_N > 0 && (s->slot & CAP_SLOT_BIT)) {
        u32 idx = s->slot & ~CAP_SLOT_BIT;
        Sym *ev = sym_find("__env", 5);
        u32 ep = 0;

        if (ev) {
            u32 ea = ident_addr(ev);

            ep = irfn_vreg(&FN);
            irfn_push(&FN, IR_LOAD, IRT_PTR, ep, ea, 0, 0, 0);
            return gen_addr_off(ep, idx < FL_CAP_MAX ? FLCAP_OFF[idx] : 8);
        }
    }
    if (s->kind == SC_GLOBAL) {
        if (s->is_tls) {
            /* `__thread`：地址是 `%fs` 基址 + 数据段偏移。基址每个线程一份
             * （lib/rt.c6 的 c6c_tls_setup 用 arch_prctl 设），所以这里每次
             * 都问一遍——不能缓存到全局，跨线程就错了。 */
            u32 fsfn = x64_sym(&X64, "__c6_fsbase");
            u32 fs = irfn_vreg(&FN);
            u32 off = irfn_vreg(&FN);
            u32 r = irfn_vreg(&FN);

            irfn_push(&FN, IR_CALL, IRT_U64, fs, 0, 0, 0, fsfn);
            FN.ops[FN.n - 1].narg = 0;
            if (s->tls_ref) {
                /* `extern __thread`：偏移这时候还不知道（定义可能在后面的
                 * TU 里），从数据槽里**读**——tls_finish() 在所有 TU 解析完
                 * 之后把定义处的偏移写进去。 */
                u32 ad = irfn_vreg(&FN);

                irfn_push(&FN, IR_ADDR, IRT_PTR, ad, 0, 0, 0, (u32)s->val);
                FN.ops[FN.n - 1].flags = 2;
                irfn_push(&FN, IR_LOAD, IRT_U64, off, ad, 0, 0, 0);
            } else {
                irfn_push(&FN, IR_CONST, IRT_U64, off, 0, 0, 0, s->goff);
            }
            irfn_push(&FN, IR_ADD, IRT_PTR, r, fs, off, 0, 0);
            return r;
        }
        /* 全局符号：rip 相对 + 重定位（位置无关；做 .o 时直接变 R_X86_64_PC32） */
        irfn_push(&FN, IR_ADDR, IRT_PTR, v, 0, 0, 0, (u32)s->val);
        FN.ops[FN.n - 1].flags = 2;
    } else {
        irfn_push(&FN, IR_ADDR, IRT_PTR, v, 0, 0, 0, X64_SLOT(s->slot));
    }
    return v;
}

/* 字符串字面量解码后放进数据段，返回数据段偏移（token 前进一格） */
static u32 NLIT;
static u32 LIT_SYM;

static int WIDE_LIT;
/* 上一次 str_lit_data() 写出的字节数（不含结尾 0），用来推 `char s[] = "…"`
 * 的元素个数——拼接后的长度只有解码完才知道。 */


/* 相邻字符串字面量拼接时的一段（用链表，段数不设上限：tcc 的
 * tcctok.h 一个数组就拼了上百段） */
typedef struct StrChunk {
    struct StrChunk *next;
    const char *p;
    u32 n;
    const u32 *cps;     /* 宽字面量：码点数组 */
    u32 ncp;
} StrChunk;

static u32 str_lit_data(void)
{
    StrChunk *head = NULL;
    StrChunk *tail = NULL;
    int kind = 0;               /* 0 = 窄（UTF-8），2 = u""（UTF-16），4 = U""/L"" */
    u32 total = 0;
    u32 off = 0;
    u32 at = 0;
    StrChunk *c = NULL;

    /* 相邻的字符串字面量在翻译阶段就拼成一个（tcc 的 tcc_keywords 就是
     * 靠 `str "\0"` 连出来的），这里一次性收集再写数据段。 */
    while (pa_cur()->kind == TK_STR) {
        Tok *t = pa_cur();
        const char *s = tok_data(t);
        u32 cap = t->len * 4 + 8;
        u8 *buf = arena_alloc(&A_main, (size_t)cap);
        StrChunk *nk = arena_alloc(&A_main, sizeof(StrChunk));
        u32 n = 0;
        u32 i = 0;

        while (i < t->len && s[i] != '"')
            i++;                       /* 跳过 L/u/U/u8 前缀 */
        if (i > 0 && !(i == 2 && s[0] == 'u' && s[1] == '8'))
            kind = (s[0] == 'u') ? 2 : 4;
        i++;
        nk->cps = arena_alloc(&A_main, (size_t)cap * sizeof(u32));
        nk->ncp = 0;
        while (i + 1 < t->len) {
            u32 ch = 0;
            int esc_ucn = 0;        /* \u / \U：码点，窄字面量要重新编码 */
            int src_utf8 = 0;       /* 源码里直接写的 UTF-8：解成码点后再编码回去 */

            if (s[i] == '\\') {
                const char *p = s + i + 1;

                ch = esc_decode(&p, s + t->len);
                esc_ucn = ESC_IS_UCN;
                i = (u32)(p - s);
            } else {
                ch = (u32)(u8)s[i];
                i++;
                if (ch >= 0xC0) {
                    /* 源码里直接写的 UTF-8 多字节序列：先解成码点，宽字面量
                     * 才拿得到真正的字符（窄字面量随后会重新编码成同样字节） */
                    u32 need = (ch >= 0xF0) ? 3 : (ch >= 0xE0) ? 2 : 1;
                    u32 acc = ch & ((need == 2) ? 0x0F : (need == 1) ? 0x1F : 0x07);
                    u32 k2 = 0;

                    for (k2 = 0; k2 < need && i < t->len; k2++) {
                        acc = (acc << 6) | ((u32)(u8)s[i] & 0x3F);
                        i++;
                    }
                    ch = acc;
                    src_utf8 = 1;
                }
            }
            if (kind == 0 && (esc_ucn || src_utf8) && ch >= 0x80) {
                /* 窄字面量里的非 ASCII 码点按 UTF-8 编码（\uXXXX 和源码里的
                 * UTF-8 字节都走这里） */
                if (ch < 0x800) {
                    buf[n++] = (u8)(0xC0 | (ch >> 6));
                    buf[n++] = (u8)(0x80 | (ch & 0x3F));
                } else if (ch < 0x10000) {
                    buf[n++] = (u8)(0xE0 | (ch >> 12));
                    buf[n++] = (u8)(0x80 | ((ch >> 6) & 0x3F));
                    buf[n++] = (u8)(0x80 | (ch & 0x3F));
                } else {
                    buf[n++] = (u8)(0xF0 | (ch >> 18));
                    buf[n++] = (u8)(0x80 | ((ch >> 12) & 0x3F));
                    buf[n++] = (u8)(0x80 | ((ch >> 6) & 0x3F));
                    buf[n++] = (u8)(0x80 | (ch & 0x3F));
                }
                ((u32 *)nk->cps)[nk->ncp] = ch;
                nk->ncp++;
            } else {
                buf[n++] = (u8)(ch & 0xFF);
                ((u32 *)nk->cps)[nk->ncp] = ch;
                nk->ncp++;
            }
        }
        nk->next = NULL;
        nk->p = (const char *)buf;
        nk->n = n;
        if (tail)
            tail->next = nk;
        else
            head = nk;
        tail = nk;
        pa_advance();
    }
    total = 0;
    for (c = head; c; c = c->next)
        total += (kind == 0) ? c->n : c->ncp;
    STR_LIT_N = total;
    if (kind == 0) {
        off = data_alloc(total + 1, 1);
        for (c = head; c; c = c->next) {
            memcpy(DATA_IMG.p + off + at, c->p, (size_t)c->n);
            at += c->n;
        }
        DATA_IMG.p[off + at] = 0;
        WIDE_LIT = 0;
        STR_LIT_ESZ = 1;
    } else {
        /* u"" 是 2 字节元素（UTF-16），U""/L"" 是 4 字节元素（UTF-32） */
        off = data_alloc((total + 1) * (u32)kind, (u32)kind);
        for (c = head; c; c = c->next) {
            u32 m = 0;

            for (m = 0; m < c->ncp; m++) {
                u32 ch = c->cps[m];
                u32 w = (u32)kind;

                if (kind == 2 && ch >= 0x10000) {
                    /* 代理对 */
                    u32 v2 = ch - 0x10000;

                    DATA_IMG.p[off + at * 2] = (u8)(0xD8 | ((v2 >> 18) & 0x03));
                    DATA_IMG.p[off + at * 2 + 1] = (u8)((v2 >> 10) & 0xFF);
                    at++;
                    DATA_IMG.p[off + at * 2] = (u8)(0xDC | ((v2 >> 8) & 0x03));
                    DATA_IMG.p[off + at * 2 + 1] = (u8)(v2 & 0xFF);
                    at++;
                    continue;
                }
                DATA_IMG.p[off + at * w] = (u8)(ch & 0xFF);
                DATA_IMG.p[off + at * w + 1] = (u8)((ch >> 8) & 0xFF);
                if (w == 4) {
                    DATA_IMG.p[off + at * w + 2] = (u8)((ch >> 16) & 0xFF);
                    DATA_IMG.p[off + at * w + 3] = (u8)((ch >> 24) & 0xFF);
                }
                at++;
            }
        }
        WIDE_LIT = 1;
        STR_LIT_ESZ = (u32)kind;
    }
    /* 每个字面量一个数据符号，命名 .LC<n>（调试/符号表可见，链接器可合并） */
    {
        char nm[32] = {0};

        snprintf(nm, sizeof(nm), ".LC%u", NLIT++);
        LIT_SYM = x64_data_sym(&X64, nm, ELF_HDR + off);
    }
    return off;
}

static u32 gen_str_from(const char *str, u32 len)
{
    u32 off = data_alloc(len + 1, 1);
    u32 v = 0;
    char nm[32] = {0};
    u32 sym = 0;

    memcpy(DATA_IMG.p + off, str, len);
    DATA_IMG.p[off + len] = 0;
    snprintf(nm, sizeof(nm), ".LC%u", NLIT++);
    sym = x64_data_sym(&X64, nm, ELF_HDR + off);
    v = irfn_vreg(&FN);
    irfn_push(&FN, IR_ADDR, IRT_PTR, v, 0, 0, 0, sym);
    FN.ops[FN.n - 1].flags = 2;
    GEN_TY = ty_ptr(ty_char());
    return v;
}

static u32 gen_string(void)
{
    u32 off = str_lit_data();
    u32 v = irfn_vreg(&FN);

    (void)off;
    irfn_push(&FN, IR_ADDR, IRT_PTR, v, 0, 0, 0, LIT_SYM);
    FN.ops[FN.n - 1].flags = 2;
    GEN_TY = ty_ptr(WIDE_LIT ? ty_int() : ty_char());
    return v;
}

static u32 gen_addr_off(u32 addr, u32 off);
static void mark_lval(u32 addr, u32 ty);

/* 结构化接口的满足性检查：方法名 + 签名逐个比（接收者之外）。
 * tests/errors/iface.c6 的那几条诊断都从这里出。 */
static void iface_check_impl(u32 ty, u32 ifx)
{
    u32 k = 0;

    if (!in_c6_tu())
        return;
    for (k = 0; k < IFACE_NM[ifx]; k++) {
        Sym *ms = meth_find(ty, IFACE_MET[ifx][k], IFACE_MLEN[ifx][k]);
        u32 i = 0;

        if (!ms || !ms->is_func) {
            pa_error("'%s' does not implement interface '%.*s': missing method '%.*s'",
                     ty_disp(ty), (int)IFACE_NLEN[ifx], IFACE_NAME[ifx],
                     (int)IFACE_MLEN[ifx][k], IFACE_MET[ifx][k]);
            continue;
        }
        if (ty_func_nparams(ms->type) == 0
            || ty_func_nparams(ms->type) - 1 != IFACE_NP[ifx][k]) {
            pa_error("method '%.*s' of '%.*s' has the wrong number of parameters",
                     (int)IFACE_MLEN[ifx][k], IFACE_MET[ifx][k],
                     (int)IFACE_NLEN[ifx], IFACE_NAME[ifx]);
            continue;
        }
        if (ty_func_ret(ms->type) != IFACE_RET[ifx][k]) {
            pa_error("method '%.*s' of '%.*s' has an incompatible return type",
                     (int)IFACE_MLEN[ifx][k], IFACE_MET[ifx][k],
                     (int)IFACE_NLEN[ifx], IFACE_NAME[ifx]);
        }
        for (i = 0; i < IFACE_NP[ifx][k] && i < IFACE_NPARAM; i++) {
            u32 want = IFACE_PTY[ifx][k][i];
            u32 got = ty_func_param(ms->type, i + 1);

            if (want == got)
                continue;
            if (!ty_is_ptr(want) && !ty_is_ptr(got) && ty_is_int(want) && ty_is_int(got)
                && ty_size(want) == ty_size(got))
                continue;
            if (proto_tag_has(want))
                pa_error("method '%.*s' of '%.*s' has an incompatible parameter: the "
                         "interface's '%s' is a prototype-scope tag",
                         (int)IFACE_MLEN[ifx][k], IFACE_MET[ifx][k],
                         (int)IFACE_NLEN[ifx], IFACE_NAME[ifx], ty_disp(want));
            else
                pa_error("method '%.*s' of '%.*s' has an incompatible parameter",
                         (int)IFACE_MLEN[ifx][k], IFACE_MET[ifx][k],
                         (int)IFACE_NLEN[ifx], IFACE_NAME[ifx]);
            break;
        }
    }
}

/* 聚合按值返回的调用方：在实参表末尾补一个隐藏实参——调用方帧里那块结果槽
 * 的地址（见 CUR_SRET）。返回 0 表示这次调用不走这套。 */
static u32 sret_slot(u32 ret_ty)
{
    u32 addr = 0;

    if (!ret_ty || !ty_is_agg(ret_ty) || ty_size(ret_ty) == 0)
        return 0;
    if (!C99_MODE)
        return 0;
    addr = irfn_vreg(&FN);
    irfn_push(&FN, IR_ADDR, IRT_PTR, addr, 0, 0, 0,
              X64_SLOT(frame_slots_for(ty_size(ret_ty))));
    return addr;
}

static u32 sret_pass(u32 *args, u32 *narg, u32 fty)
{
    u32 addr = 0;

    if (!fty || !agg_ret_abi(fty, ty_target(fty)))
        return 0;
    addr = sret_slot(ty_target(fty));
    if (addr && *narg < 16) {
        args[*narg] = addr;
        (*narg)++;
    }
    return addr;
}

static u32 gen_call(Sym *fs)
{
    /* 记下这次调用可不可失败：catch / 表达式语句要据此判断 */
    E_CALL_FALLIBLE = (fs && fs->fallible) ? 1 : 2;
    u32 args[PA_ARG_MAX] = {0};   /* 必须和 narg 上限一致；16 会在 narg>=16 时栈溢出覆盖 fs */
    u32 narg = 0;
    u32 aty0[PA_ARG_MAX] = {0};   /* 实参**转换前**的类型（重载重选后要从原值重转） */
    u32 av0[PA_ARG_MAX] = {0};    /* 实参转换前的值 */
    u8 argfix[PA_ARG_MAX] = {0};  /* 走接口/切片/聚合特殊路径的实参不再动 */

    if (fs && drop_is_sym((u32)fs->val))
        pa_error("析构函数不能直接调用：最后一个引用放掉时它自己会跑（`p = NULL` 就够了）");
    u32 dst = 0;
    u32 i = 0;
    u32 a0ty = 0;
    u8 argmgd[PA_ARG_MAX] = {0};       /* 哪个实参是托管引用（async 要把它挂住） */
    u32 mgdmask2 = 0;

    pa_expect_ch('(');
    if (!pa_accept_ch(')')) {
        for (;;) {
            if (narg >= PA_ARG_MAX) {
                pa_error("实参太多（上限 64）");
                break;
            }
            {
                u32 av = gen_assign();
                u32 aty = cur_op_ty();
                u32 pty = ty_func_param(fs->type, narg);
                int special = 0;

                if (ty_has_mgd(aty)) {
                    char dnm[160] = {0};

                    agg_disp_name(aty, dnm, sizeof(dnm));
                    pa_error("'%s' holds managed references: a parameter is not possible. "
                             "Allocate it with 'new' and hold it in '@%s'", dnm, dnm);
                }
                if (narg == 0)
                    a0ty = aty;
                closure_lit_check(pty);
                /* 结构化接口：把聚合体传给接口形参时，逐个方法验签名 */
                {
                    u32 ifx5 = 0;

                    if (ty_is_iface(pty, &ifx5) && ty_is_agg(aty))
                        iface_check_impl(aty, ifx5);
                }
                {
                    int amgd = PEND_MGD;

                    av = value_of(av);
                    if (mgd_tmp_has(av))
                        amgd = 1;
                    if (amgd) {
                        argmgd[narg] = 1;
                        mgdmask2 |= 1u << narg;
                    }
                }
                aty0[narg] = aty;
                av0[narg] = av;
                /* c6 切片形参 + 数组实参：隐式转成 `{ptr, len}`（两个机器字）。
                 * 拷进调用者的临时槽，再把地址当实参传（聚合按值传参的既有约定）。 */
                {
                    u32 ifx = 0;

                    if (NIFACE > 0 && pty != 0 && ty_is_iface(pty, &ifx)) {
                        u32 sty2 = ty_is_ptr(aty) ? ty_target(aty) : aty;
                        u32 ts2 = frame_slots_for(16);
                        u32 ta2 = irfn_vreg(&FN);
                        u32 vv2 = irfn_vreg(&FN);
                        u32 sym2 = iface_vtbl(ifx, sty2);

                        irfn_push(&FN, IR_ADDR, IRT_PTR, ta2, 0, 0, 0, X64_SLOT(ts2));
                        store_conv(gen_addr_off(ta2, 0), ty_ptr(ty_void()), av,
                                   ty_ptr(ty_void()));
                        irfn_push(&FN, IR_ADDR, IRT_PTR, vv2, 0, 0, 0, sym2);
                        FN.ops[FN.n - 1].flags = 2;
                        store_conv(gen_addr_off(ta2, 8), ty_ptr(ty_void()), vv2,
                                   ty_ptr(ty_void()));
                        av = ta2;
                        aty = pty;
                        special = 1;
                    }
                }
                if (pty != 0 && ty_is_slice(pty) && ty_is_array(aty)) {
                    u32 tslot = frame_slots_for(16);
                    u32 taddr = irfn_vreg(&FN);
                    u32 lv = irfn_vreg(&FN);
                    u32 a8 = irfn_vreg(&FN);

                    irfn_push(&FN, IR_ADDR, IRT_PTR, taddr, 0, 0, 0, X64_SLOT(tslot));
                    irfn_push(&FN, IR_STORE, IRT_PTR, taddr, av, 0, 0, 0);
                    irfn_push(&FN, IR_CONST, IRT_U64, lv, 0, 0, 0,
                              ty_array_n(aty) ? ty_array_n(aty) : 1);
                    irfn_push(&FN, IR_LEA, IRT_PTR, a8, taddr, 0, 0, 8);
                    irfn_push(&FN, IR_STORE, IRT_U64, a8, lv, 0, 0, 0);
                    av = taddr;
                    aty = pty;
                    special = 1;
                }
                /* 实参按形参类型转换；没有原型（或落在变参部分）时做默认实参
                 * 提升：float → double，否则 printf("%f", f) 拿到 4 字节位模式。 */
                if (pty != 0 && !ty_is_agg(pty)) {
                    if (aty != pty)
                        av = gen_convert(av, aty, pty);
                } else if (pty == 0 && ty_is_float(aty) && ty_size(aty) < 8) {
                    av = gen_convert(av, aty, ty_double());
                }

                /* 聚合按值传参：拷一份到调用者的临时槽，把**地址**当实参传。
                 * 被调方在自己的帧里再拷一份，语义等价。这样只用到"一个 8 字节
                 * 参数"的既有 IR，不必为 SysV 的寄存器分块/栈传递扩 IR。 */
                if (pty && ty_is_agg(pty) && ty_size(pty) > 0 && ty_size(pty) <= 4096) {
                    u32 sz = ty_size(pty);
                    u32 tslot = frame_slots_for(sz);
                    u32 taddr = irfn_vreg(&FN);

                    irfn_push(&FN, IR_ADDR, IRT_PTR, taddr, 0, 0, 0, X64_SLOT(tslot));
                    irfn_push(&FN, IR_COPY, IRT_U8, taddr, av, 0, 0, sz);
                    av = taddr;
                    aty = pty;
                    special = 1;
                }
                argfix[narg] = (u8)special;
                args[narg] = av;
            }
            narg++;
            if (!pa_accept_ch(','))
                break;
        }
        pa_expect_ch(')');
    }
    /* 同名方法按**接收者**挑：`area(&c)` / `area(&r)` 在符号表里是同一个
     * 名字的多个函数（tests/method.c6 的 Circle_area / Rect_area），光按
     * 名字找只会有先注册的那个。第一个实参是指针时，用方法表里按接收者
     * 类型注册的那一条覆盖掉。 */
    {
        Sym *fb = sym_find_fn(fs->name, fs->len, narg, a0ty);
        Sym *fnew = fs;

        if (fb && fb != fs) {
            fnew = fb;
        } else if (narg > 0 && a0ty && ty_is_ptr(a0ty)) {
            Sym *mo = meth_find(ty_target(a0ty), fs->name, fs->len);

            if (mo && mo != fs && mo->is_func)
                fnew = mo;
        }
        if (fnew != fs) {
            u32 k4 = 0;

            /* 形参表换了：先前按旧原型转过的实参要按新的再转一遍。否则
             * `init(&r, buf, 14, 0)`（endian 的 4 参数版）会先按同名 2 参数版
             * 把 buf 当 `int` 截断，指针只剩低 32 位——std-util 的 endian
             * 一段就是这么段错误的。 */
            for (k4 = 0; k4 < narg && k4 < PA_ARG_MAX; k4++) {
                u32 np4 = ty_func_param(fnew->type, k4);

                if (!np4 || argfix[k4] || ty_is_agg(np4))
                    continue;
                if (aty0[k4] != np4)
                    args[k4] = gen_convert(av0[k4], aty0[k4], np4);
                else
                    args[k4] = av0[k4];
            }
            fs = fnew;
        }
    }
    /* 少传的实参按 C 惯例补 0：不补的话，那个寄存器/栈槽留着上一个表达式的
     * 垃圾值（native 后端会真的用上——`__c6_co_run()` 少传一个指针参数，被
     * 调用方就拿上个表达式的值当函数指针去调，直接段错误；C99 后端恰好把
     * 它写成 0，所以只有 native 崩）。 */
    if (!ty_func_variadic(fs->type)) {
        u32 np0 = ty_func_nparams(fs->type);

        while (narg < np0 && narg < 16) {
            u32 z0 = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, z0, 0, 0, 0, 0);
            args[narg] = z0;
            narg++;
        }
    }
    /* `async` 函数的调用：不能就地调用（任务体要能停在第一个 `await` 上）。
     * 照 spawn 的样子搭实参块 {中转函数, 目标地址, 实参…}，起一个协程并推进
     * 到第一个挂起/结束点，表达式的值就是 `__c6_co_task()` 交出的任务结构。 */
    if (ty_is_ptr(ty_target(fs->type)) && ty_is_task(ty_target(ty_target(fs->type)))) {
        /* mgdmask 传 0：async 的托管实参引用归**任务前缀**（创建时 retain、
         * 销毁时 release），不能交给中转函数在返回时放掉。 */
        u32 thunk2 = spawn_thunk((int)narg, 0);
        u32 env2 = clos_alloc(thunk2, 16 + 8 * narg);
        u32 tgv2 = irfn_vreg(&FN);
        u32 cov = irfn_vreg(&FN);
        u32 tsk2 = 0;

        irfn_push(&FN, IR_ADDR, IRT_PTR, tgv2, 0, 0, 0, (u32)fs->val);
        FN.ops[FN.n - 1].flags = 2;
        irfn_push(&FN, IR_STORE, IRT_U64, gen_addr_off(env2, 8), tgv2, 0, 0, 0);
        for (i = 0; i < narg; i++) {
            irfn_push(&FN, IR_STORE, IRT_U64, gen_addr_off(env2, 16 + 8 * i),
                      args[i], 0, 0, 0);
            /* 这里**不** retain：任务体在入口处会为每个托管形参在前缀里留一份
             * （见函数声明那一段），创建者手上那份照旧归自己。 */
        }
        {
            u32 nf = irfn_vreg(&FN);

            irfn_push(&FN, IR_CONST, IRT_U64, nf, 0, 0, 0,
                      (u32)(PA_CO_STMT ? 1 : 0));
            irfn_push(&FN, IR_ARG, IRT_U64, 0, env2, 0, 0, 0);
            irfn_push(&FN, IR_ARG, IRT_U64, 0, nf, 0, 0, 1);
        }
        /* 两个实参都要传：第二个是 `nogate`（`co` 语句处先跑到第一个挂起点，
         * 不参与调度门）。以前这里紧接着被改回 `narg = 1`，第二个实参就没人
         * 填，`__c6_co_new` 拿到寄存器里的垃圾——`std-https` 的 co 那两路就是
         * 这么看到 `wfd=1 / bcap=4592989` 这种值的（第 290 轮）。 */
        irfn_push(&FN, IR_CALL, IRT_PTR, cov, 0, 0, 0,
                  x64_sym(&X64, "__c6_co_new"));
        FN.ops[FN.n - 1].narg = 2;
        irfn_push(&FN, IR_ARG, IRT_U64, 0, cov, 0, 0, 0);
        tsk2 = irfn_vreg(&FN);
        irfn_push(&FN, IR_CALL, IRT_PTR, tsk2, 0, 0, 0,
                  x64_sym(&X64, "__c6_co_launch"));
        FN.ops[FN.n - 1].narg = 1;
        dst = tsk2;
        GEN_TY = ty_target(fs->type);
        E_WAS_CALL = 1;
        return dst;
    }
    (void)sret_pass(args, &narg, fs->type);
    for (i = 0; i < narg; i++)
        irfn_push(&FN, IR_ARG, IRT_U64, 0, args[i], 0, 0, i);
    dst = irfn_vreg(&FN);
    irfn_push(&FN, IR_CALL, ir_ty_of(ty_target(fs->type)), dst, 0, 0, 0,
              (u32)fs->val);
    FN.ops[FN.n - 1].narg = (u8)narg;
    if (ty_func_variadic(fs->type))
        FN.ops[FN.n - 1].flags |= 1;   /* 变参调用（本地约定：浮点也走整型寄存器） */
    GEN_TY = ty_target(fs->type);
    E_WAS_CALL = 1;
    return dst;
}

/* 下标 / 成员 / 自增自减（postfix 链） */
static u32 gen_addr_off(u32 addr, u32 off);
static void mark_lval(u32 addr, u32 ty);
static int sizeof_inner_type_end(void);

static int pa_at_typename(void);
static u32 ident_addr(Sym *s);
static Sym *fnlit_parse_sym(void);
static u32 parse_param_list(u32 fnret, Declarator *d);
static u32 slice_len_load(u32 sadd);

/* ---- -b：数组下标的边界检查 ----
 * 打开 PA_BCHECK 之后，对**数组**类型的下标访问在取址之前插一段检查：
 *
 *   c = (unsigned)idx < n        无符号比较：负数下标变成巨大值，一次抓住
 *   br c ? ok : fail
 * fail: call c6c_bound_fail(idx, n)  不返回（打印一行、退出码 2）
 * ok:   ...原来的取址...
 *
 * 只对"编译期知道长度的数组"生效。指针下标、VLA 的边界要么得在运行期才知道
 * （VLA 的 length 不在类型里）、要么根本不存在（`int *p` 没有边界可言），
 * 那些地方不插检查——这一点和 tcc 的 -b 一样：按手上有的信息来，不假装能查
 * 所有内存访问。
 */
static int PA_BCHECK;

static void pa_set_bcheck(int v) { PA_BCHECK = v ? 1 : 0; }

static void pa_bound_check(u32 idx, u32 n)
{
    u32 k = irfn_vreg(&FN);
    u32 c = irfn_vreg(&FN);
    u32 z = irfn_vreg(&FN);
    u32 lfail = 0;
    u32 lok = 0;

    irfn_push(&FN, IR_CONST, IRT_U64, k, 0, 0, 0, n);
    irfn_push(&FN, IR_CMP, IRT_U64, c, idx, k, 0, 0);
    irfn_setcc(&FN, IRCC_ULT);
    lfail = irfn_label(&FN);
    lok = irfn_label(&FN);
    irfn_push(&FN, IR_BR, IRT_VOID, 0, c, lok, lfail, 0);
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lfail, 0, 0, 0);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, idx, 0, 0, 0);
    irfn_push(&FN, IR_ARG, IRT_U64, 0, k, 0, 0, 1);
    irfn_push(&FN, IR_CALL, IRT_VOID, z, 0, 0, 0, x64_sym(&X64, "c6c_bound_fail"));
    FN.ops[FN.n - 1].narg = 2;
    irfn_push(&FN, IR_LABEL, IRT_VOID, 0, lok, 0, 0, 0);
}

static u32 gen_postfix_ops(u32 v)
{
    for (;;) {
        if (pa_accept_ch('[')) {
            u32 base = 0;
            u32 bty = 0;
            u32 slice_src = 0;
            int was_slice = 0;
            u32 idx = 0;
            u32 ity = 0;               /* 下标表达式的类型（`1[a]` 要交换律） */
            u32 elem = 0;
            u32 esz = 0;
            u32 off = 0;
            int pmgd = PEND_MGD;
            /* 多维 VLA 的基址：这一维要乘的行 stride（见 mark_lval 上面的注释）。
             * 先把状态摘下来（下标表达式里可能还有别的 VLA），算完再按下一维挂回去。 */
            Sym *vsy = NULL;
            u32 vdim = 0;
            u32 vstr = 0;

            if (PEND_LVAL) {
                /* 数组：地址就是首元素地址（自动退化）；
                 * 指针变量：**先取值**再当下标基址（取地址是它的槽地址，不是目标）。 */
                u32 a0 = PEND_ADDR;
                u32 ty0 = PEND_TY;

                vsy = PEND_VSYM;
                vdim = PEND_VDIM;
                PEND_VSYM = NULL;
                PEND_VDIM = 0;
