/* std/encoding/sha3：SHA-3（Keccak）哈希与 SHAKE 可扩展输出。
 *
 *     import std.encoding.sha3;
 *
 *     u8 dig[32] = { 0 };
 *     sha3_hash(256, "abc", 3, dig);
 *
 *     Sha3 s = { 0 };
 *     s.sha3_init(256);            // 224 / 256 / 384 / 512
 *     s.sha3_update("ab", 2);
 *     s.sha3_update("c", 1);
 *     s.sha3_final(dig);           // 输出长度由 init 的参数决定
 *
 *     Sha3 x = { 0 };
 *     x.shake_init(128);           // SHAKE128 / SHAKE256
 *     x.sha3_update("", 0);
 *     x.shake_out(out, 64);        // 任意长度输出，可以多次调用接着挤
 *
 * 约定：
 *
 * - 海绵结构：rate = 200 - 2*输出字节数（SHA3-256 是 136）；填充 SHA-3 用
 *   `0x06`、SHAKE 用 `0x1F`，末字节 `0x80`；
 * - `sha3_final` 之后结构体不可再用（要重来请重新 `sha3_init`）；
 * - `shake_out` 可以连续调用任意多次，内部维护挤压位置；
 * - 只做单向哈希与 XOF，不做 Keccak 原始变体（原始 Keccak 的填充是 `0x01`）。
 */
#include <string.h>

module std.encoding.sha3;
import std.core.types;
import std.text.str;

struct Sha3 {
    u64 st[25];
    int rate;           /* 字节 */
    int pos;
    int digest;         /* 输出字节数 */
    int shake;
    int squeezed;       /* SHAKE 已经补过填充 */
};

static const u64 sha3_rc[24] = {
    0x0000000000000001ULL, 0x0000000000008082ULL, 0x800000000000808aULL,
    0x8000000080008000ULL, 0x000000000000808bULL, 0x0000000080000001ULL,
    0x8000000080008081ULL, 0x8000000000008009ULL, 0x000000000000008aULL,
    0x0000000000000088ULL, 0x0000000080008009ULL, 0x000000008000000aULL,
    0x000000008000808bULL, 0x800000000000008bULL, 0x8000000000008089ULL,
    0x8000000000008003ULL, 0x8000000000008002ULL, 0x8000000000000080ULL,
    0x000000000000800aULL, 0x800000008000000aULL, 0x8000000080008081ULL,
    0x8000000000008080ULL, 0x0000000080000001ULL, 0x8000000080008008ULL,
};

/* 旋转量：r[x][y] 展平成 r[x + 5*y] */
static const int sha3_rot[25] = {
    0, 1, 62, 28, 27,
    36, 44, 6, 55, 20,
    3, 10, 43, 25, 39,
    41, 45, 15, 21, 8,
    18, 2, 61, 56, 14,
};

static u64 sha3_rol(u64 v, int n)
{
    if (n == 0)
        return v;
    return (v << n) | (v >> (64 - n));
}

static void sha3_f1600(u64 *st)
{
    u64 c[5] = { 0 }, b[25] = { 0 };
    int round = 0, x = 0, y = 0;

    for (round = 0; round < 24; round++) {
        /* θ */
        for (x = 0; x < 5; x++)
            c[x] = st[x] ^ st[x + 5] ^ st[x + 10] ^ st[x + 15] ^ st[x + 20];
        for (x = 0; x < 5; x++) {
            u64 t = c[(x + 4) % 5] ^ sha3_rol(c[(x + 1) % 5], 1);

            for (y = 0; y < 25; y += 5)
                st[y + x] ^= t;
        }
        /* ρ 与 π */
        for (x = 0; x < 5; x++)
            for (y = 0; y < 5; y++)
                b[y + 5 * ((2 * x + 3 * y) % 5)] =
                    sha3_rol(st[x + 5 * y], sha3_rot[x + 5 * y]);
        /* χ */
        for (x = 0; x < 5; x++)
            for (y = 0; y < 5; y++)
                st[x + 5 * y] =
                    b[x + 5 * y] ^ ((~b[(x + 1) % 5 + 5 * y]) & b[(x + 2) % 5 + 5 * y]);
        /* ι */
        st[0] ^= sha3_rc[round];
    }
}

static void sha3_absorb(Sha3 *self, const u8 *p, int n)
{
    int i = 0;

    while (i < n) {
        int take = self->rate - self->pos;

        if (take > n - i)
            take = n - i;
        {
            int j = 0;

            for (j = 0; j < take; j++) {
                int lane = (self->pos + j) / 8;
                int sh = ((self->pos + j) % 8) * 8;

                self->st[lane] ^= (u64)p[i + j] << sh;
            }
        }
        self->pos += take;
        i += take;
        if (self->pos == self->rate) {
            sha3_f1600(self->st);
            self->pos = 0;
        }
    }
}

int sha3_init(Sha3 *self, int bits)
{
    int digest = 0;

    if (!self)
        return -1;
    if (bits == 224)
        digest = 28;
    else if (bits == 256)
        digest = 32;
    else if (bits == 384)
        digest = 48;
    else if (bits == 512)
        digest = 64;
    else
        return -1;
    memset(self, 0, sizeof *self);
    self->digest = digest;
    self->rate = 200 - 2 * digest;
    self->shake = 0;
    return 1;
}

int shake_init(Sha3 *self, int bits)
{
    int digest = 0;

    if (!self)
        return -1;
    if (bits == 128)
        digest = 16;
    else if (bits == 256)
        digest = 32;
    else
        return -1;
    memset(self, 0, sizeof *self);
    self->digest = digest;
    self->rate = 200 - 2 * digest;
    self->shake = 1;
    return 1;
}

int sha3_update(Sha3 *self, const void *src, int n)
{
    if (!self || n < 0 || (n > 0 && !src))
        return -1;
    if (self->rate <= 0)
        return -1;
    if (n > 0)
        sha3_absorb(self, (const u8 *)src, n);
    return 1;
}

/* 填充并切换：之后处于「挤压」状态 */
static void sha3_pad(Sha3 *self)
{
    u8 pad[200] = { 0 };
    u8 byte = (u8)(self->shake ? 0x1F : 0x06);

    pad[0] = byte;
    pad[self->rate - self->pos - 1] |= 0x80;
    sha3_absorb(self, pad, self->rate - self->pos);
}

int sha3_final(Sha3 *self, void *dst)
{
    u8 *out = (u8 *)dst;
    int i = 0;

    if (!self || !dst || self->shake)
        return -1;
    sha3_pad(self);
    for (i = 0; i < self->digest; i++) {
        int lane = i / 8;
        int sh = (i % 8) * 8;

        out[i] = (u8)(self->st[lane] >> sh);
    }
    memset(self, 0, sizeof *self);
    return 1;
}

/* SHAKE：挤任意长度 */
int shake_out(Sha3 *self, void *dst, int n)
{
    u8 *out = (u8 *)dst;
    int i = 0;

    if (!self || !dst || n < 0 || !self->shake)
        return -1;
    if (!self->squeezed) {
        sha3_pad(self);
        self->squeezed = 1;
    }
    while (i < n) {
        int take = self->rate - self->pos;

        if (take > n - i)
            take = n - i;
        {
            int j = 0;

            for (j = 0; j < take; j++) {
                int lane = (self->pos + j) / 8;
                int sh = ((self->pos + j) % 8) * 8;

                out[i + j] = (u8)(self->st[lane] >> sh);
            }
        }
        i += take;
        self->pos += take;
        if (self->pos == self->rate) {
            sha3_f1600(self->st);
            self->pos = 0;
        }
    }
    return 1;
}

/* 一步到位：SHA3-224/256/384/512 */
int sha3_hash(int bits, const void *src, int n, void *dst)
{
    Sha3 s = { 0 };

    if (sha3_init(&s, bits) != 1)
        return -1;
    if (sha3_update(&s, src, n) != 1)
        return -1;
    return sha3_final(&s, dst);
}

/* ---- 自测 ---- */

static int hexeq(const u8 *got, const char *want, int n)
{
    static const char *d = "0123456789abcdef";
    int i = 0;

    for (i = 0; i < n; i++) {
        if (d[(got[i] >> 4) & 0xF] != want[2 * i])
            return 0;
        if (d[got[i] & 0xF] != want[2 * i + 1])
            return 0;
    }
    return 1;
}

test "sha3：SHA3-256/512 与增量更新" {
    u8 dig[64] = { 0 };
    Sha3 s = { 0 };

    if (sha3_hash(256, "", 0, dig) != 1)
        return err(1, "空串哈希失败");
    if (!hexeq(dig,
               "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a",
               32))
        return err(2, "SHA3-256(\"\") 不对");
    if (sha3_hash(256, "abc", 3, dig) != 1)
        return err(3, "abc 哈希失败");
    if (!hexeq(dig,
               "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532",
               32))
        return err(4, "SHA3-256(abc) 不对");
    if (sha3_hash(512, "abc", 3, dig) != 1)
        return err(5, "SHA3-512 失败");
    if (!hexeq(dig,
               "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e"
               "10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0",
               64))
        return err(6, "SHA3-512(abc) 不对");
    /* 增量与一次喂完等价 */
    if (s.sha3_init(256) != 1)
        return err(7, "init 失败");
    if (s.sha3_update("a", 1) != 1 || s.sha3_update("bc", 2) != 1)
        return err(8, "update 失败");
    if (s.sha3_final(dig) != 1)
        return err(9, "final 失败");
    if (!hexeq(dig,
               "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532",
               32))
        return err(10, "增量结果不对");
    if (sha3_init(&s, 100) != -1)
        return err(11, "非法位数应该 -1");
    if (sha3_init(&s, 224) != 1 || s.sha3_final(dig) != 1)
        return err(12, "224 空串失败");
    if (!hexeq(dig, "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7", 28))
        return err(13, "SHA3-224(\"\") 不对");
}

test "sha3：SHAKE 与错误处理" {
    u8 out[64] = { 0 };
    Sha3 s = { 0 };

    if (shake_init(&s, 128) != 1)
        return err(14, "SHAKE128 init 失败");
    if (s.sha3_update("", 0) != 1)
        return err(15, "SHAKE update 失败");
    if (s.shake_out(out, 32) != 1)
        return err(16, "SHAKE 输出失败");
    if (!hexeq(out, "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26",
               32))
        return err(17, "SHAKE128(\"\",32) 不对");
    /* 接着挤：后续字节应与一次性挤 64 字节的后半段相同 */
    {
        u8 one[64] = { 0 };
        u8 two[64] = { 0 };
        Sha3 a = { 0 }, b = { 0 };

        if (shake_init(&a, 128) != 1 || shake_init(&b, 128) != 1)
            return err(18, "init 失败");
        a.sha3_update("", 0);
        b.sha3_update("", 0);
        a.shake_out(one, 64);
        b.shake_out(two, 32);
        b.shake_out(two + 32, 32);
        if (memcmp(one, two, 64) != 0)
            return err(19, "分段挤压与一次挤压不一致");
        if (memcmp(one, out, 32) != 0)
            return err(20, "前 32 字节应该一致");
    }
    if (shake_init(&s, 256) != 1 || s.sha3_update("abc", 3) != 1
        || s.shake_out(out, 16) != 1)
        return err(21, "SHAKE256 失败");
    if (!hexeq(out, "483366601360a8771c6863080cc4114d", 16))
        return err(22, "SHAKE256(abc,16) 不对");
    if (sha3_update(0, "x", 1) != -1)
        return err(23, "空指针 update 应该 -1");
    if (sha3_init(&s, 256) != 1 || sha3_final(&s, 0) != -1)
        return err(24, "空输出指针应该 -1");
    if (shake_init(&s, 128) != 1 || sha3_final(&s, out) != -1)
        return err(25, "SHAKE 走 final 应该 -1");
}
