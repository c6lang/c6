            u32 fptr = value_of(v);
            u32 args[16] = {0};
            u32 narg = 0;
            u32 i2 = 0;
            u32 dst = 0;

            pa_advance();
            if (!pa_accept_ch(')')) {
                for (;;) {
                    if (narg >= PA_ARG_MAX) {
                        pa_error("实参太多（上限 64）");
                        break;
                    }
                    args[narg] = value_of(gen_assign());
                    narg++;
                    if (!pa_accept_ch(','))
                        break;
