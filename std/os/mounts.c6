/* std/os/mounts：`/proc/mounts`（与 `/etc/mtab`）的解析。
 *
 *     import std.os.mounts;
 *
 *     MountDoc doc = { 0 };
 *     MountEntry e = { 0 };
 *     doc.open(buf, n);                    // 游标：open / next / count / find
 *     while (doc.next(&e) == 1)
 *         // e.dev / e.path / e.fstype / e.opts
 *     doc.find(S("/home"), &e);
 *
 * 每行六个空格分隔的字段：设备、挂载点、文件系统类型、挂载选项、dump 频率、fsck
 * 顺序。字段里的空格用八进制转义表示（`\040` 是空格、`\011` 是 tab、`\012` 是换行、
 * `\134` 是反斜杠）。
 *
 * 约定：
 *
 * - `MountDoc` 是游标：`open` 数行，`next` 逐条返回，`rewind` 复位；
 * - `MountEntry` 里的字段是**原缓冲区视图**（未反转义）；要反转义后的路径请用
 *   `unescape(src, char *dst, int cap)`；
 * - `find(path, &e)` 按挂载点精确比较（用未反转义的原串比较，所以带空格的路径
 *   要传转义形式）；
 * - 空行与 `#` 开头的行跳过；字段少于 6 个的行视为坏数据返回 -1；
 * - 不解析 `/proc/self/mountinfo` 的「可选字段」格式。
 */
#include <string.h>

module std.os.mounts;
import std.core.types;
import std.text.str;

struct MountEntry {
    Str dev;
    Str path;
    Str fstype;
    Str opts;
    int freq;
    int passno;
};

struct MountDoc {
    const char *src;
    int n;
    int off;
    int nentries;
};

static int mnt_field(const char *p, int end, int *pos, Str *out)
{
    int i = *pos, start = 0;

    while (i < end && (p[i] == ' ' || p[i] == '\t'))
        i++;
    if (i >= end)
        return 0;
    start = i;
    while (i < end && p[i] != ' ' && p[i] != '\t')
        i++;
    out->s = (char[:]){ (char *)p + start, i - start };
    *pos = i;
    return 1;
}

static int mnt_int(Str s, int *out)
{
    int i = 0, v = 0;

    if (s.s.len == 0)
        return 0;
    for (i = 0; i < s.s.len; i++) {
        if (s.s.data[i] < '0' || s.s.data[i] > '9')
            return 0;
        v = v * 10 + (s.s.data[i] - '0');
    }
    *out = v;
    return 1;
}

int next(MountDoc *d, MountEntry *out)
{
    const char *p = 0;

    if (!d || !d->src || !out)
        return -1;
    p = d->src;
    while (d->off < d->n) {
        int line_start = d->off, i = d->off, end = 0;
        Str f[6] = { { (char[:]){ 0, 0 } }, { (char[:]){ 0, 0 } },
                     { (char[:]){ 0, 0 } }, { (char[:]){ 0, 0 } },
                     { (char[:]){ 0, 0 } }, { (char[:]){ 0, 0 } } };
        int k = 0;

        while (i < d->n && p[i] != '\n')
            i++;
        end = i;
        if (end > line_start && p[end - 1] == '\r')
            end--;
        if (i < d->n)
            i++;
        d->off = i;
        if (end == line_start)
            continue;
        if (p[line_start] == '#')
            continue;
        i = line_start;
        for (k = 0; k < 6; k++) {
            if (mnt_field(p, end, &i, &f[k]) != 1)
                return -1;
        }
        memset(out, 0, sizeof *out);
        out->dev = f[0];
        out->path = f[1];
        out->fstype = f[2];
        out->opts = f[3];
        if (mnt_int(f[4], &out->freq) != 1)
            return -1;
        if (mnt_int(f[5], &out->passno) != 1)
            return -1;
        return 1;
    }
    return 0;
}

int count(MountDoc *d)
{
    return d ? d->nentries : 0;
}

int rewind(MountDoc *d)
{
    if (!d)
        return -1;
    d->off = 0;
    return 1;
}

int find(MountDoc *d, char[:] path, MountEntry *out)
{
    MountEntry e = { 0 };

    if (!d || !out || !path.data)
        return -1;
    rewind(d);
    while (next(d, &e) == 1) {
        if (e.path.s.len == path.len
            && memcmp(e.path.s.data, path.data, (size_t)path.len) == 0) {
            *out = e;
            return 1;
        }
    }
    return 0;
}

/* 反转义：\040 空格、\011 tab、\012 换行、\134 反斜杠 */
int unescape(char[:] src, char *dst, int cap)
{
    int i = 0, o = 0;

    if (!dst || cap <= 0 || !src.data)
        return -1;
    for (i = 0; i < src.len; i++) {
        char c = src.data[i];

        if (c == '\\' && i + 3 < src.len && src.data[i + 1] >= '0'
            && src.data[i + 1] <= '7') {
            int v = (src.data[i + 1] - '0') * 64
                    + (src.data[i + 2] - '0') * 8 + (src.data[i + 3] - '0');

            if (o + 1 >= cap)
                return -1;
            dst[o++] = (char)v;
            i += 3;
            continue;
        }
        if (o + 1 >= cap)
            return -1;
        dst[o++] = c;
    }
    dst[o] = 0;
    return o;
}

int open(MountDoc *d, const void *src, int n)
{
    MountEntry e = { 0 };
    int count = 0;

    if (!d || !src || n <= 0)
        return -1;
    memset(d, 0, sizeof *d);
    d->src = (const char *)src;
    d->n = n;
    {
        MountDoc tmp = { 0 };

        tmp.src = d->src;
        tmp.n = n;
        while (next(&tmp, &e) == 1)
            count++;
    }
    d->nentries = count;
    d->off = 0;
    return count;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "mounts：条目与游标" {
    static const char *src =
        "# 设备 挂载点 类型 选项 dump pass\n"
        "/dev/sda1 / ext4 rw,relatime 0 1\n"
        "proc /proc proc rw,nosuid 0 0\n"
        "/dev/sdb1 /mnt/my\\040disk xfs rw 0 2\n";
    MountDoc d = { 0 };
    MountEntry e = { 0 };
    char buf[64] = { 0 };
    int n = 0;

    if (d.open(src, (int)strlen(src)) != 3)
        return err(1, "应该有 3 条挂载记录");
    if (d.count() != 3)
        return err(2, "count() 不对");
    if (d.next(&e) != 1)
        return err(3, "第 1 条读不到");
    if (e.dev.s.len != 9 || memcmp(e.dev.s.data, "/dev/sda1", 9) != 0)
        return err(4, "第 1 条设备不对");
    if (e.path.s.len != 1 || e.path.s.data[0] != '/')
        return err(5, "第 1 条挂载点不对");
    if (e.fstype.s.len != 4 || memcmp(e.fstype.s.data, "ext4", 4) != 0)
        return err(6, "第 1 条类型不对");
    if (e.freq != 0 || e.passno != 1)
        return err(7, "第 1 条 dump/fsck 不对");
    if (d.next(&e) != 1 || e.fstype.s.len != 4)
        return err(8, "第 2 条不对");
    if (d.next(&e) != 1)
        return err(9, "第 3 条读不到");
    if (e.path.s.len != 15)
        return err(10, "第 3 条挂载点长度不对（含转义）");
    if (unescape((char[:]){ e.path.s.data, e.path.s.len }, buf,
                 (int)sizeof buf) != 12
        || memcmp(buf, "/mnt/my disk", 12) != 0)
        return err(11, "反转义 \\040 不对");
    if (d.next(&e) != 0)
        return err(12, "读完应该返回 0");
    n = 0;
    d.rewind();
    while (d.next(&e) == 1)
        n++;
    if (n != 3)
        return err(13, "rewind 之后应该又能读出 3 条");
}

test "mounts：查找与坏数据" {
    static const char *src =
        "/dev/sda1 / ext4 rw 0 1\n"
        "tmpfs /tmp tmpfs rw 0 0\n";
    MountDoc d = { 0 };
    MountEntry e = { 0 };
    char buf[8] = { 0 };

    if (d.open(src, (int)strlen(src)) != 2)
        return err(14, "open 失败");
    if (d.find(S("/tmp"), &e) != 1 || e.fstype.s.len != 5)
        return err(15, "find(/tmp) 不对");
    if (d.find(S("/nope"), &e) != 0)
        return err(16, "找不到应该 0");
    /* 字段不足的行 */
    {
        MountDoc bad = { 0 };

        if (bad.open("dev / ext4 rw\n", 15) != 0)
            return err(17, "字段不足应该计 0 条");
        if (bad.next(&e) != -1)
            return err(18, "字段不足应该 -1");
    }
    if (unescape(S("a\\011b"), buf, (int)sizeof buf) != 3
        || buf[1] != '\t')
        return err(19, "反转义 \\011 不对");
    if (unescape(S("abc"), buf, 3) != -1)
        return err(20, "容量不够应该 -1");
}
