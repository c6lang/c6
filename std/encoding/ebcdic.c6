/* std/encoding/ebcdic：EBCDIC（CP037）与 ASCII 的互转。
 *
 *     import std.encoding.ebcdic;
 *
 *     unsigned char ebc[16] = { 0 };
 *     char back[16] = { 0 };
 *     int n = ebcdic_encode(S("HELLO"), ebc, (int)sizeof ebc);
 *     int m = ebcdic_decode(ebc, n, back, (int)sizeof back);
 *
 * 只做 IBM CP037（美式英语）里与可打印 ASCII 对应的那 95 个字符（`0x20`..`0x7E`）。
 * EBCDIC 的码位是历史遗留的，不是连续的：`A`..`I` 是 `0xC1`..`0xC9`、`J`..`R` 是
 * `0xD1`..`0xD9`、`S`..`Z` 是 `0xE2`..`0xE9`，数字 `0`..`9` 是 `0xF0`..`0xF9`，
 * 空格是 `0x40`。
 *
 * 约定：
 *
 * - `ebcdic_char(c)` 把 ASCII 字符转成 EBCDIC 字节，不在表里返回 -1；
 * - `ebcdic_ascii(b)` 反向查，表外返回 -1；
 * - `ebcdic_encode` 遇到表外字符写 `0x6F`（CP037 的 `?`），返回写出的字节数；
 * - `ebcdic_decode` 遇到表外字节返回 -1（不做替换，避免静默丢数据）；
 * - 不处理国家变体（CP500、CP1047 等）与多字节 EBCDIC。
 */
#include <string.h>

module std.encoding.ebcdic;
import std.core.types;
import std.text.str;

/* ASCII 0x20..0x7E 对应的 EBCDIC 字节 */
static const unsigned char ebc_tab[95] = {
    0x40, 0x5A, 0x7F, 0x7B, 0x5B, 0x6C, 0x50, 0x7D, 0x4D, 0x5D, 0x5C, 0x4E, 0x6B, 0x60, 0x4B, 0x61,
    0xF0, 0xF1, 0xF2, 0xF3, 0xF4, 0xF5, 0xF6, 0xF7, 0xF8, 0xF9, 0x7A, 0x5E, 0x4C, 0x7E, 0x6E, 0x6F,
    0x7C, 0xC1, 0xC2, 0xC3, 0xC4, 0xC5, 0xC6, 0xC7, 0xC8, 0xC9, 0xD1, 0xD2, 0xD3, 0xD4, 0xD5, 0xD6,
    0xD7, 0xD8, 0xD9, 0xE2, 0xE3, 0xE4, 0xE5, 0xE6, 0xE7, 0xE8, 0xE9, 0xBA, 0xE0, 0xBB, 0xB0, 0x6D,
    0x79, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96,
    0x97, 0x98, 0x99, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6, 0xA7, 0xA8, 0xA9, 0xC0, 0x4F, 0xD0, 0xA1,
};

int ebcdic_char(char c)
{
    int a = (int)(unsigned char)c;

    if (a < 0x20 || a > 0x7E)
        return -1;
    return (int)ebc_tab[a - 0x20];
}

int ebcdic_ascii(int b)
{
    int i = 0;

    if (b < 0 || b > 0xFF)
        return -1;
    for (i = 0; i < 95; i++) {
        if (ebc_tab[i] == (unsigned char)b)
            return i + 0x20;
    }
    return -1;
}

int ebcdic_encode(char[:] src, u8 *dst, int cap)
{
    int i = 0;

    if (src.len < 0 || !dst || cap < 0)
        return -1;
    if (src.len > cap)
        return -1;
    for (i = 0; i < src.len; i++) {
        int b = ebcdic_char(src.data[i]);

        dst[i] = (u8)(b < 0 ? 0x6F : b);
    }
    return src.len;
}

int ebcdic_decode(const u8 *src, int n, char *dst, int cap)
{
    int i = 0;

    if (!src || !dst || n < 0 || cap < 0)
        return -1;
    if (n > cap)
        return -1;
    for (i = 0; i < n; i++) {
        int a = ebcdic_ascii((int)src[i]);

        if (a < 0)
            return -1;
        dst[i] = (char)a;
    }
    return n;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "EBCDIC：单字符映射" {
    if (ebcdic_char('A') != 0xC1 || ebcdic_char('I') != 0xC9)
        return err(1, "A..I 的映射不对");
    if (ebcdic_char('J') != 0xD1 || ebcdic_char('R') != 0xD9)
        return err(2, "J..R 的映射不对");
    if (ebcdic_char('S') != 0xE2 || ebcdic_char('Z') != 0xE9)
        return err(3, "S..Z 的映射不对");
    if (ebcdic_char('0') != 0xF0 || ebcdic_char('9') != 0xF9)
        return err(4, "数字的映射不对");
    if (ebcdic_char(' ') != 0x40 || ebcdic_char('a') != 0x81)
        return err(5, "空格或小写字母的映射不对");
    if (ebcdic_char('\t') != -1 || ebcdic_char((char)0x80) != -1)
        return err(6, "表外字符应该 -1");
    if (ebcdic_ascii(0xC1) != 'A' || ebcdic_ascii(0xF0) != '0')
        return err(7, "反向查表不对");
    if (ebcdic_ascii(0x00) != -1 || ebcdic_ascii(0x40) != ' ')
        return err(8, "反向表外应该 -1");
}

test "EBCDIC：串转换与往返" {
    static const unsigned char want[5] = { 0xC8, 0xC5, 0xD3, 0xD3, 0xD6 };
    unsigned char ebc[128] = { 0 };
    char back[128] = { 0 };
    int n = 0, m = 0;

    n = ebcdic_encode(S("HELLO"), ebc, (int)sizeof ebc);
    if (n != 5 || memcmp(ebc, want, 5) != 0)
        return err(9, "HELLO 的编码不对");
    m = ebcdic_decode(ebc, n, back, (int)sizeof back);
    if (m != 5 || memcmp(back, "HELLO", 5) != 0)
        return err(10, "HELLO 的解码不对");
    /* 全表往返 */
    {
        int i = 0;
        char all[95] = { 0 };

        for (i = 0; i < 95; i++)
            all[i] = (char)(0x20 + i);
        n = ebcdic_encode((char[:]){ all, 95 }, ebc, (int)sizeof ebc);
        if (n != 95)
            return err(11, "全表编码长度不对");
        m = ebcdic_decode(ebc, n, back, (int)sizeof back);
        if (m != 95 || memcmp(back, all, 95) != 0)
            return err(12, "全表往返不一致");
    }
    /* 表外字符写 '?' */
    n = ebcdic_encode(S("a\tb"), ebc, (int)sizeof ebc);
    if (n != 3 || ebc[1] != 0x6F)
        return err(13, "表外字符应该写成 0x6F");
    if (ebcdic_decode(ebc, n, back, (int)sizeof back) != 3
        || back[1] != '?')
        return err(14, "0x6F 应该解回 ?");
    /* 容量与坏数据 */
    if (ebcdic_encode(S("HELLO"), ebc, 4) != -1)
        return err(15, "容量不够应该 -1");
    {
        unsigned char bad[1] = { 0x00 };

        if (ebcdic_decode(bad, 1, back, (int)sizeof back) != -1)
            return err(16, "表外字节解码应该 -1");
    }
}
