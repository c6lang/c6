/* std/data/yaml：YAML 1.2 的常用子集读取器（零分配）。
 *
 *     import std.data.yaml;
 *
 *     YamlReader r = yaml_open(text, n);
 *     YamlEntry e = { 0 };
 *     while (r.next(&e) == 1) {
 *         // e.depth / e.kind / e.key / e.value
 *     }
 *
 * 这是一个「扁平事件」读取器：不建树，按出现顺序把
 * `键: 值`、`- 值`、`- 键: 值` 一条条吐出来，用 `depth`（缩进空格数 / 2）
 * 让调用方自己还原层级。够读配置文件、清单、CI 定义这类文档。
 *
 * 支持：
 *
 * - 块映射 `key: value`、块序列 `- value`、序列里的映射 `- key: value`；
 * - 嵌套全靠缩进（嵌套块的值留空，`value.s.len == 0`）；
 * - 注释 `#`（行首或前面是空白的 `#` 到行尾；引号里的 `#` 不算）；
 * - 单引号 `'...'`（`''` 表示一个 `'`）与双引号 `"..."`（`\" \\ \n \t \r
 *   \0 \u` 交给 `yaml_unquote`）；
 * - 文档分隔 `---` / `...`、空行、尾随空白。
 *
 * 不支持（遇到按数据处理，不报错）：流式 `{}`/`[]`、锚点/别名、标签、块标量
 * `|`/`>`、多行折叠、复杂键 `? `、制表符缩进（缩进里出现制表符返回 -1）。
 */
#include <string.h>

module std.data.yaml;
import std.core.types;
import std.text.str;

enum YamlKind {
    YAML_KEY,       /* 映射项：key 有值，value 长度 0 表示下面还有嵌套块 */
    YAML_ITEM,      /* 序列项：value 是标量 */
    YAML_ITEM_KEY,  /* 序列项里又是映射：key/value */
};

struct YamlEntry {
    int kind;
    int depth;
    Str key;
    Str value;
};

struct YamlReader {
    const char *p;
    int n;
    int pos;
    int bad;
};

YamlReader yaml_open(const void *src, int n)
{
    YamlReader r = { 0 };

    if (!src || n <= 0) {
        r.bad = 1;
        return r;
    }
    r.p = (const char *)src;
    r.n = n;
    return r;
}

/* 去掉尾随注释（引号外、`#` 前是空白或行首） */
static int yaml_strip_comment(const char *p, int start, int end)
{
    int i = 0, q = 0;

    for (i = start; i < end; i++) {
        char c = p[i];

        if (q) {
            if (q == '"' && c == '\\') {
                i++;
                continue;
            }
            if (c == q)
                q = 0;
            continue;
        }
        if (c == '"' || c == '\'') {
            q = c;
            continue;
        }
        if (c == '#' && (i == start || p[i - 1] == ' ' || p[i - 1] == '\t'))
            return i;
    }
    return end;
}

/* 去掉两端空白 */
static int yaml_trim(const char *p, int *b, int *e)
{
    while (*b < *e && (p[*b] == ' ' || p[*b] == '\t'))
        (*b)++;
    while (*e > *b && (p[*e - 1] == ' ' || p[*e - 1] == '\t'))
        (*e)--;
    return *e - *b;
}

/* 找映射的冒号：引号外的、后面跟空白或行尾的 `:` */
static int yaml_find_colon(const char *p, int start, int end)
{
    int i = 0, q = 0;

    for (i = start; i < end; i++) {
        char c = p[i];

        if (q) {
            if (q == '"' && c == '\\') {
                i++;
                continue;
            }
            if (c == q)
                q = 0;
            continue;
        }
        if (c == '"' || c == '\'') {
            q = c;
            continue;
        }
        if (c == ':' && (i + 1 == end || p[i + 1] == ' ' || p[i + 1] == '\t'))
            return i;
    }
    return -1;
}

int next(YamlReader *self, YamlEntry *out)
{
    if (!self || self->bad || !out)
        return -1;
    memset(out, 0, sizeof *out);
    while (self->pos < self->n) {
        int line_start = self->pos, line_end = 0, start = 0;
        int b = 0, e = 0, colon = 0, indent = 0;

        while (self->pos < self->n && self->p[self->pos] != '\n')
            self->pos++;
        line_end = self->pos;
        if (self->pos < self->n)
            self->pos++;
        start = line_start;
        while (start < line_end && self->p[start] == ' ')
            start++;
        if (start < line_end && self->p[start] == '\t')
            return -1;                  /* 制表符缩进不支持 */
        indent = start - line_start;
        line_end = yaml_strip_comment(self->p, start, line_end);
        if (yaml_trim(self->p, &start, &line_end) == 0)
            continue;                   /* 空行 / 纯注释行 */
        if (line_end - start == 3
            && (memcmp(self->p + start, "---", 3) == 0
                || memcmp(self->p + start, "...", 3) == 0))
            continue;                   /* 文档分隔符 */
        out->depth = indent / 2;
        if (self->p[start] == '-'
            && (start + 1 == line_end || self->p[start + 1] == ' ')) {
            b = start + 1;
            e = line_end;
            yaml_trim(self->p, &b, &e);
            if (b >= e) {
                out->kind = YAML_ITEM;
                return 1;
            }
            colon = yaml_find_colon(self->p, b, e);
            if (colon > b) {
                int kb = b, ke = colon, vb = colon + 1, ve = e;

                yaml_trim(self->p, &kb, &ke);
                yaml_trim(self->p, &vb, &ve);
                out->kind = YAML_ITEM_KEY;
                out->key.s = (char[:]){ (char *)self->p + kb, ke - kb };
                out->value.s = (char[:]){ (char *)self->p + vb, ve - vb };
                return 1;
            }
            out->kind = YAML_ITEM;
            out->value.s = (char[:]){ (char *)self->p + b, e - b };
            return 1;
        }
        colon = yaml_find_colon(self->p, start, line_end);
        if (colon <= start)
            return -1;                  /* 既不是 `- ` 也不是 `键: 值` */
        b = start;
        e = colon;
        yaml_trim(self->p, &b, &e);
        out->kind = YAML_KEY;
        out->key.s = (char[:]){ (char *)self->p + b, e - b };
        b = colon + 1;
        e = line_end;
        yaml_trim(self->p, &b, &e);
        out->value.s = (char[:]){ (char *)self->p + b, e - b };
        return 1;
    }
    return 0;
}

/* 解引号与转义；不是引号包裹的标量原样拷贝。放不下/坏转义返回 -1。 */
int yaml_unquote(Str raw, char *out, int cap)
{
    int i = 0, o = 0, q = 0, n = raw.s.len;
    const char *p = raw.s.data;

    if (!out || cap <= 0)
        return -1;
    if (n == 0) {
        out[0] = 0;
        return 0;
    }
    q = p[0];
    if ((q != '"' && q != '\'') || n < 2 || p[n - 1] != q) {
        if (n >= cap)
            return -1;
        memcpy(out, p, (size_t)n);
        out[n] = 0;
        return n;
    }
    for (i = 1; i < n - 1; i++) {
        char c = p[i];

        if (q == '\'') {
            if (c == '\'') {
                if (i + 1 < n - 1 && p[i + 1] == '\'') {
                    if (o >= cap - 1)
                        return -1;
                    out[o++] = '\'';
                    i++;
                    continue;
                }
                return -1;
            }
            if (o >= cap - 1)
                return -1;
            out[o++] = c;
            continue;
        }
        if (c != '\\') {
            if (o >= cap - 1)
                return -1;
            out[o++] = c;
            continue;
        }
        i++;
        if (i >= n - 1)
            return -1;
        switch (p[i]) {
        case 'n': c = '\n'; break;
        case 't': c = '\t'; break;
        case 'r': c = '\r'; break;
        case '0': c = 0; break;
        case '"': c = '"'; break;
        case '\\': c = '\\'; break;
        case '/': c = '/'; break;
        default:
            return -1;
        }
        if (o >= cap - 1)
            return -1;
        out[o++] = c;
    }
    out[o] = 0;
    return o;
}

/* null 的几种写法（`~` / `null` / `Null` / `NULL` / 空） */
int yaml_is_null(Str s)
{
    if (s.s.len == 0)
        return 1;
    if (s.s.len == 1 && s.s.data[0] == '~')
        return 1;
    if (s.s.len == 4) {
        if (memcmp(s.s.data, "null", 4) == 0 || memcmp(s.s.data, "Null", 4) == 0
            || memcmp(s.s.data, "NULL", 4) == 0)
            return 1;
    }
    return 0;
}

/* true 的几种写法（true/True/TRUE/yes/on），否则 0 */
int yaml_is_true(Str s)
{
    static const char *yes[] = { "true", "True", "TRUE", "yes", "Yes", "YES",
                                 "on", "On", "ON" };
    int i = 0;

    for (i = 0; i < 9; i++) {
        if (s.s.len == (int)strlen(yes[i])
            && memcmp(s.s.data, yes[i], (size_t)s.s.len) == 0)
            return 1;
    }
    return 0;
}

/* ---- 自测 ---- */

static const char *DOC =
    "# 顶层注释\n"
    "name: superc\n"
    "version: \"1.2.3\"\n"
    "stable: true\n"
    "empty:\n"
    "\n"
    "servers:\n"
    "  - web-1\n"
    "  - web-2    # 行尾注释\n"
    "  - name: db\n"
    "    port: 5432\n"
    "paths:\n"
    "  root: /srv/app\n"
    "  hash: \"a#b\"\n"
    "  note: 'it''s ok'\n"
    "  escape: \"tab\\there\"\n"
    "---\n";

test "YAML：缩进、序列与引号" {
    YamlReader r = yaml_open(DOC, (int)strlen(DOC));
    YamlEntry e = { 0 };
    char buf[64] = { 0 };
    int n = 0;

    if (r.next(&e) != 1 || e.kind != YAML_KEY || e.depth != 0)
        return err(1, "第一个键不对");
    if (e.key.s.len != 4 || memcmp(e.key.s.data, "name", 4) != 0
        || e.value.s.len != 6 || memcmp(e.value.s.data, "superc", 6) != 0)
        return err(2, "name 不对");
    n = r.next(&e);
    if (n != 1 || e.key.s.len != 7)
        return err(3, "version 不对");
    if (yaml_unquote(e.value, buf, (int)sizeof buf) != 5
        || memcmp(buf, "1.2.3", 5) != 0)
        return err(4, "双引号解不出来");
    r.next(&e);
    if (e.key.s.len != 6 || !yaml_is_true(e.value))
        return err(5, "stable 应为 true");
    r.next(&e);
    if (e.key.s.len != 5 || !yaml_is_null(e.value))
        return err(6, "empty 应为 null");
    r.next(&e);
    if (e.key.s.len != 7 || e.value.s.len != 0)
        return err(7, "servers 应该是空值的块键");
    r.next(&e);
    if (e.kind != YAML_ITEM || e.depth != 1 || e.value.s.len != 5
        || memcmp(e.value.s.data, "web-1", 5) != 0)
        return err(8, "第一个序列项不对");
    r.next(&e);
    if (e.kind != YAML_ITEM || e.value.s.len != 5
        || memcmp(e.value.s.data, "web-2", 5) != 0)
        return err(9, "行尾注释没剥掉");
    r.next(&e);
    if (e.kind != YAML_ITEM_KEY || e.key.s.len != 4
        || memcmp(e.key.s.data, "name", 4) != 0 || e.value.s.len != 2)
        return err(10, "序列里的映射项不对");
    r.next(&e);
    if (e.kind != YAML_KEY || e.depth != 2 || e.value.s.len != 4
        || memcmp(e.value.s.data, "5432", 4) != 0)
        return err(11, "嵌套映射的深度不对");
    r.next(&e);
    if (e.key.s.len != 5 || e.value.s.len != 0)
        return err(12, "paths 应该是空值的块键");
    r.next(&e);
    if (e.key.s.len != 4 || e.value.s.len != 8
        || memcmp(e.value.s.data, "/srv/app", 8) != 0)
        return err(12, "root 不对");
    r.next(&e);
    if (e.value.s.len != 5)
        return err(13, "hash 的引号内 # 被误当注释");
    if (yaml_unquote(e.value, buf, (int)sizeof buf) != 3
        || memcmp(buf, "a#b", 3) != 0)
        return err(14, "a#b 解不出来");
    r.next(&e);
    if (yaml_unquote(e.value, buf, (int)sizeof buf) != 7
        || memcmp(buf, "it's ok", 7) != 0)
        return err(15, "单引号转义不对");
    r.next(&e);
    if (yaml_unquote(e.value, buf, (int)sizeof buf) != 8
        || memcmp(buf, "tab\there", 8) != 0)
        return err(16, "双引号转义不对");
    if (r.next(&e) != 0)
        return err(17, "应该读完");
}

test "YAML：坏输入与工具函数" {
    static const char *tabdoc = "a:\n\tb: c\n";
    YamlReader r = yaml_open("a: 1\n- oops\n", 11);
    YamlEntry e = { 0 };
    char buf[8] = { 0 };

    if (yaml_open(0, 5).bad == 0)
        return err(18, "空指针应该 bad");
    if (next(0, &e) != -1)
        return err(19, "空 reader 应该 -1");
    r = yaml_open(tabdoc, (int)strlen(tabdoc));
    if (r.next(&e) != 1 || r.next(&e) != -1)
        return err(20, "制表符缩进应该 -1");
    r = yaml_open("plain line\n", 11);
    if (r.next(&e) != -1)
        return err(21, "既非 `- ` 也非 `键: 值` 应该 -1");
    if (yaml_unquote((Str){ (char[:]){ "abc", 3 } }, buf, 2) != -1)
        return err(22, "放不下应该 -1");
    if (yaml_unquote((Str){ (char[:]){ "\"a\\q\"", 5 } }, buf, (int)sizeof buf)
        != -1)
        return err(23, "坏转义应该 -1");
    if (yaml_unquote((Str){ (char[:]){ "\"abc", 4 } }, buf, (int)sizeof buf)
        != 4)
        return err(24, "只有开头引号按原样拷贝");
    if (yaml_is_null((Str){ (char[:]){ "~", 1 } }) != 1
        || yaml_is_null((Str){ (char[:]){ "", 0 } }) != 1
        || yaml_is_null((Str){ (char[:]){ "x", 1 } }) != 0)
        return err(25, "is_null 不对");
    if (yaml_is_true((Str){ (char[:]){ "on", 2 } }) != 1
        || yaml_is_true((Str){ (char[:]){ "no", 2 } }) != 0)
        return err(26, "is_true 不对");
}
