/* std/container/region：半开区间集合（借用调用方数组，零分配）。
 *
 *     import std.container.region;
 *
 *     i64 lo[8] = { 0 }, hi[8] = { 0 };
 *     Region r = { 0 };
 *     region_init(&r, lo, hi, 8);
 *     r.add(0, 10);                 // [0, 10)
 *     r.add(10, 20);                // 相邻，合并成 [0, 20)
 *     r.contains(19);               // 1；contains(20) 是 0
 *
 * 表示：按 `lo` 升序排好的**互不重叠**的半开区间 `[lo, hi)`；相邻（`hi == 下
 * 一个的 lo`）或重叠的区间在 `add` 时合并，所以集合始终是「规范形式」。典型
 * 用途：内存/地址段管理、时间轴占用、端口段、权限位图之外的范围判断。
 *
 * 约定：
 *
 * - `region_init` 要求 `cap >= 1` 且数组非空；返回 1/0。
 * - `add(lo, hi)`：`hi <= lo` 视为非法返回 0；与已有区间重叠或相邻就合并；
 *   需要新开一段但数组满了返回 0（**不改动已有内容**）。
 * - `contains(v)`：`lo <= v < hi` 才算在里面（右端开）。
 * - `overlaps(lo, hi)`：只看真正相交（相邻不算），空区间返回 0。
 * - `find_gap(from, len)`：找第一个 `[g, g+len)` 完全落在空隙里且 `g >= from`
 *   的位置；找不到返回 0，找到写 `*out` 并返回 1（`len <= 0` 非法）。
 * - `total()` 是所有区间长度之和；`count_region()` 是区间段数。
 * - 坐标是 i64，允许负数；`find_gap` 对 `from + len` 做溢出保护。
 */
#include <string.h>

module std.container.region;
import std.core.types;

struct Region {
    int n;                   /* 区间段数 */
    int cap;                 /* 容量（数组长度） */
    i64 *lo;
    i64 *hi;
};

int region_init(Region *self, i64 *lo, i64 *hi, int cap)
{
    if (!self || !lo || !hi || cap < 1)
        return 0;
    self->n = 0;
    self->cap = cap;
    self->lo = lo;
    self->hi = hi;
    return 1;
}

int count_region(Region *self) { return self ? self->n : 0; }

int capacity(Region *self) { return self ? self->cap : 0; }

int is_empty(Region *self) { return !self || self->n == 0; }

void clear(Region *self)
{
    if (self)
        self->n = 0;
}

/* 总长度（所有段之和） */
i64 total(Region *self)
{
    i64 sum = 0;
    int i = 0;

    if (!self)
        return 0;
    for (i = 0; i < self->n; i++)
        sum += self->hi[i] - self->lo[i];
    return sum;
}

/* 加一段 [lo, hi)；非法/放不下返回 0（失败不改已有内容） */
int add(Region *self, i64 lo, i64 hi)
{
    int i = 0, first = -1, last = -1, pos = 0;

    if (!self || !self->lo || !self->hi || hi <= lo)
        return 0;
    for (i = 0; i < self->n; i++) {
        if (self->hi[i] < lo)
            continue;                 /* 完全在左边 */
        if (self->lo[i] > hi)
            break;                    /* 完全在右边（有序，可以停） */
        /* 重叠或相邻 */
        if (first < 0)
            first = i;
        last = i;
        if (self->lo[i] < lo)
            lo = self->lo[i];
        if (self->hi[i] > hi)
            hi = self->hi[i];
    }
    if (first >= 0) {
        /* 把 first..last 合并成 [lo, hi) */
        self->lo[first] = lo;
        self->hi[first] = hi;
        if (last > first) {
            int k = 0;

            for (k = last + 1; k < self->n; k++) {
                self->lo[first + 1 + k - (last + 1)] = self->lo[k];
                self->hi[first + 1 + k - (last + 1)] = self->hi[k];
            }
            self->n -= last - first;
        }
        return 1;
    }
    /* 新开一段：插到第一个 lo[i] > hi 的位置（之前的都不会重叠） */
    if (self->n >= self->cap)
        return 0;
    pos = i;
    {
        int k = self->n;

        while (k > pos) {
            self->lo[k] = self->lo[k - 1];
            self->hi[k] = self->hi[k - 1];
            k--;
        }
    }
    self->lo[pos] = lo;
    self->hi[pos] = hi;
    self->n++;
    return 1;
}

/* v 是否在集合里（半开区间） */
int contains(Region *self, i64 v)
{
    int a = 0, b = 0;

    if (!self || !self->lo)
        return 0;
    a = 0;
    b = self->n - 1;
    while (a <= b) {
        int m = a + (b - a) / 2;

        if (v < self->lo[m])
            b = m - 1;
        else if (v >= self->hi[m])
            a = m + 1;
        else
            return 1;
    }
    return 0;
}

/* [lo, hi) 是否与集合真正相交（相邻不算） */
int overlaps(Region *self, i64 lo, i64 hi)
{
    int i = 0;

    if (!self || !self->lo || hi <= lo)
        return 0;
    for (i = 0; i < self->n; i++) {
        if (self->hi[i] <= lo)
            continue;
        if (self->lo[i] >= hi)
            break;
        return 1;
    }
    return 0;
}

/* 找第一个 >= from、长度 len 的空隙；找到返回 1 并写 *out */
int find_gap(Region *self, i64 from, i64 len, i64 *out)
{
    i64 start = from;
    int i = 0;

    if (!self || !self->lo || !out || len <= 0)
        return 0;
    if (from > 0 && len > 0x7fffffffffffffffLL - from)
        return 0;                     /* from + len 溢出 */
    for (i = 0; i < self->n; i++) {
        if (self->lo[i] >= start) {
            if (self->lo[i] - start >= len) {
                *out = start;
                return 1;
            }
            start = self->hi[i];
        } else if (self->hi[i] > start) {
            start = self->hi[i];
        }
    }
    *out = start;
    return 1;
}

/* ---- 自测 ---- */

struct RTest {
    Region r;
    i64 lo[8];
    i64 hi[8];
};

static int rt_init(struct RTest *t, int cap)
{
    memset(t, 0, sizeof *t);
    return region_init(&t->r, t->lo, t->hi, cap);
}

test "添加、合并与包含" {
    struct RTest t = { 0 };

    if (!rt_init(&t, 8))
        return err(1, "初始化");
    if (!t.r.add(0, 10) || t.r.count_region() != 1 || t.r.total() != 10)
        return err(2, "第一段");
    if (!t.r.contains(0) || !t.r.contains(9) || t.r.contains(10)
        || t.r.contains(-1))
        return err(3, "半开区间");
    /* 相邻合并 */
    if (!t.r.add(10, 20) || t.r.count_region() != 1 || t.r.total() != 20)
        return err(4, "相邻合并");
    if (t.r.lo[0] != 0 || t.r.hi[0] != 20)
        return err(5, "合并后的边界");
    /* 被包含的一段：不变 */
    if (!t.r.add(3, 7) || t.r.count_region() != 1 || t.r.total() != 20)
        return err(6, "包含在内部的段");
    /* 重叠扩展 */
    if (!t.r.add(-5, 2) || t.r.count_region() != 1 || t.r.lo[0] != -5)
        return err(7, "向左扩展");
    if (!t.r.add(18, 30) || t.r.count_region() != 1 || t.r.hi[0] != 30)
        return err(8, "向右扩展");
    /* 桥接两段 */
    t.r.clear();
    t.r.add(0, 5);
    t.r.add(10, 15);
    if (t.r.count_region() != 2 || t.r.total() != 10)
        return err(9, "两段");
    if (!t.r.add(4, 11) || t.r.count_region() != 1 || t.r.total() != 15)
        return err(10, "桥接");
    /* 非法区间 */
    if (t.r.add(5, 5) || t.r.add(6, 5))
        return err(11, "空/倒置区间");
}

test "排序、重叠与空隙" {
    struct RTest t = { 0 };
    i64 g = 0;

    if (!rt_init(&t, 8))
        return err(12, "初始化");
    /* 乱序插入也要保持有序 */
    t.r.add(100, 110);
    t.r.add(0, 10);
    t.r.add(50, 60);
    if (t.r.count_region() != 3)
        return err(13, "三段");
    if (t.r.lo[0] != 0 || t.r.lo[1] != 50 || t.r.lo[2] != 100)
        return err(14, "有序");
    /* overlaps：真正相交才算 */
    if (!t.r.overlaps(5, 6) || t.r.overlaps(10, 50)
        || !t.r.overlaps(9, 51) || t.r.overlaps(20, 30))
        return err(15, "overlaps");
    /* find_gap */
    if (!t.r.find_gap(0, 10, &g) || g != 10)
        return err(16, "10..20 的空隙");
    if (!t.r.find_gap(10, 40, &g) || g != 10)
        return err(17, "10..50 的空隙");
    if (!t.r.find_gap(10, 41, &g) || g != 110)
        return err(18, "41 长度只能放到 110");
    if (!t.r.find_gap(200, 5, &g) || g != 200)
        return err(19, "末尾之后");
    if (t.r.find_gap(0, 0, &g) || t.r.find_gap(0, -1, &g))
        return err(20, "非法长度");
    /* 负数坐标 */
    {
        struct RTest n = { 0 };

        if (!rt_init(&n, 8))
            return err(21, "负数初始化");
        n.r.add(-10, -5);
        n.r.add(-3, 0);
        if (n.r.count_region() != 2 || !n.r.contains(-10)
            || n.r.contains(-5) || !n.r.contains(-1))
            return err(22, "负数区间");
        if (!n.r.add(-6, -4) || n.r.count_region() != 2
            || n.r.lo[0] != -10 || n.r.hi[0] != -4)
            return err(23, "负数合并");
        if (!n.r.add(-4, -3) || n.r.count_region() != 1
            || n.r.lo[0] != -10 || n.r.hi[0] != 0)
            return err(31, "负数桥接");
    }
    /* 容量：满了不改内容 */
    {
        struct RTest c = { 0 };

        if (!rt_init(&c, 2))
            return err(24, "容量初始化");
        c.r.add(0, 1);
        c.r.add(10, 11);
        if (c.r.add(20, 21) != 0)
            return err(25, "满了要 0");
        if (c.r.count_region() != 2 || c.r.total() != 2)
            return err(26, "满了不改内容");
        /* 合并成一段仍然可以（不需要新槽位） */
        if (!c.r.add(1, 10) || c.r.count_region() != 1)
            return err(27, "合并腾出槽位");
        if (!c.r.add(20, 21) || c.r.count_region() != 2)
            return err(28, "腾出后能再加");
    }
    /* 参数错误 */
    {
        Region bad = { 0 };
        i64 lo2[1] = { 0 }, hi2[1] = { 0 };

        if (region_init((Region *)0, lo2, hi2, 1)
            || region_init(&bad, (i64 *)0, hi2, 1)
            || region_init(&bad, lo2, hi2, 0))
            return err(29, "非法初始化");
        if (bad.add(0, 1) || bad.contains(0) || bad.overlaps(0, 1)
            || bad.find_gap(0, 1, &g))
            return err(30, "未初始化对象");
    }
}
