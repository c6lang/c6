/* wordcount.text：文本行的小统计。
 *
 * 这个文件是「一个文件一个 module、module 名就是它的路径」的例子：
 * 文件在 examples/wordcount/text.c6，所以模块名是 wordcount.text，
 * 别人用 `import wordcount.text;` 时，编译器在搜索路径里找
 * wordcount/text.c6——把 examples 放进 -I 就能找到。
 */
module wordcount.text;

import std.text.str;

/* 单词 = 一段连续的非空白字符 */
int words(char[:] line)
{
    Str s = { line };
    Str *p = &s;
    int i = 0, n = 0, in_word = 0;

    for (i = 0; i < p->count(); i++) {
        char c = p->at(i);

        if (c == ' ' || c == '\t') {
            in_word = 0;
        } else if (!in_word) {
            in_word = 1;
            n++;
        }
    }
    return n;
}

/* 最长单词的字符数 */
int longest(char[:] line)
{
    Str s = { line };
    Str *p = &s;
    int i = 0, best = 0, cur = 0;

    for (i = 0; i < p->count(); i++) {
        char c = p->at(i);

        if (c == ' ' || c == '\t') {
            if (cur > best)
                best = cur;
            cur = 0;
        } else {
            cur++;
        }
    }
    if (cur > best)
        best = cur;
    return best;
}

/* 十进制数字字符的个数 */
int digits(char[:] line)
{
    Str s = { line };
    Str *p = &s;
    int i = 0, n = 0;

    for (i = 0; i < p->count(); i++) {
        char c = p->at(i);

        if (c >= '0' && c <= '9')
            n++;
    }
    return n;
}
