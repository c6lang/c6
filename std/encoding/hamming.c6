/* std/encoding/hamming：汉明码 (7,4)——4 位数据编成 7 位、可纠正 1 位错。
 *
 *     import std.encoding.hamming;
 *
 *     HammingBlock b = { 0 };
 *     u8 data = 0;
 *     b.encode(0x0A);          // 4 位数据 → 7 位码（方法）
 *     b.bits[3] ^= 1;          // 人为打错一位
 *     b.fix();                 // 纠正，返回 1
 *     b.decode(&data);         // 0x0A
 *
 * 位布局按经典 Hamming(7,4)：位置 1/2/4 是校验位（P1/P2/P4），3/5/6/7 是数据位
 * （D1/D2/D3/D4），全部按「位置序号从 1 开始」定义，存储时放在 `bits[0..6]`。
 *
 * 约定：
 *
 * - `HammingBlock.bits[7]` 是码字本体（`bits[0]` 对应位置 1）；
 * - `b.encode(nibble)` 把低 4 位编成 7 位码，返回 1；
 * - `b.syndrome()` 给校验子（0 表示无错，否则按 `1/2/4` 的组合表示出错位置）；
 * - `b.fix()` 按校验子纠正 1 位错，返回纠了几位（0/1），校验子越界返回 -1；
 * - `b.decode(&out)` 先 `fix()` 再取数据位，成功返回 1；
 * - `hamming_encode(data, dst, cap)`/`hamming_decode(src, dst, cap)` 是面向字节
 *   数组的便捷接口：每个字节拆成两个 nibble、编成两个 7 位块（即 `2*n` 个块），
 *   解码时按块流读回并**统计纠正的位数**（可为 0）；
 * - 码距 3 只能纠 1 位错；2 位错会被「纠正」成第三个合法码字，检测不出来。
 */
#include <string.h>

module std.encoding.hamming;
import std.core.types;
import std.text.str;

struct HammingBlock {
    u8 bits[7];
};

static int ham_get(HammingBlock *b, int pos)
{
    return (int)(b->bits[pos - 1] & 1u);
}

static void ham_set(HammingBlock *b, int pos, int v)
{
    b->bits[pos - 1] = (u8)(v & 1);
}

int encode(HammingBlock *b, u8 nibble)
{
    int d1 = 0, d2 = 0, d3 = 0, d4 = 0;

    if (!b)
        return -1;
    d1 = nibble & 1;
    d2 = (nibble >> 1) & 1;
    d3 = (nibble >> 2) & 1;
    d4 = (nibble >> 3) & 1;
    memset(b->bits, 0, sizeof b->bits);
    ham_set(b, 3, d1);
    ham_set(b, 5, d2);
    ham_set(b, 6, d3);
    ham_set(b, 7, d4);
    /* 偶校验 */
    ham_set(b, 1, ham_get(b, 3) ^ ham_get(b, 5) ^ ham_get(b, 7));
    ham_set(b, 2, ham_get(b, 3) ^ ham_get(b, 6) ^ ham_get(b, 7));
    ham_set(b, 4, ham_get(b, 5) ^ ham_get(b, 6) ^ ham_get(b, 7));
    return 1;
}

int syndrome(HammingBlock *b)
{
    int s1 = 0, s2 = 0, s4 = 0;

    if (!b)
        return -1;
    s1 = ham_get(b, 1) ^ ham_get(b, 3) ^ ham_get(b, 5) ^ ham_get(b, 7);
    s2 = ham_get(b, 2) ^ ham_get(b, 3) ^ ham_get(b, 6) ^ ham_get(b, 7);
    s4 = ham_get(b, 4) ^ ham_get(b, 5) ^ ham_get(b, 6) ^ ham_get(b, 7);
    return s1 + s2 * 2 + s4 * 4;
}

int fix(HammingBlock *b)
{
    int s = syndrome(b);

    if (s < 0)
        return -1;
    if (s == 0)
        return 0;
    if (s > 7)
        return -1;
    b->bits[s - 1] = (u8)(b->bits[s - 1] ^ 1u);
    return 1;
}

int decode(HammingBlock *b, u8 *out)
{
    if (!b || !out)
        return -1;
    fix(b);
    *out = (u8)(ham_get(b, 3) | (ham_get(b, 5) << 1) | (ham_get(b, 6) << 2)
                | (ham_get(b, 7) << 3));
    return 1;
}

/* 面向字节：每个字节两个块 */
int hamming_encode(char[:] data, u8 *dst, int cap)
{
    int i = 0, o = 0;

    if (!data.data || !dst || cap < data.len * 14)
        return -1;
    for (i = 0; i < data.len; i++) {
        HammingBlock lo = { { 0 } };
        HammingBlock hi = { { 0 } };
        int k = 0;

        encode(&lo, (u8)((unsigned char)data.data[i] & 0x0F));
        encode(&hi, (u8)(((unsigned char)data.data[i] >> 4) & 0x0F));
        for (k = 0; k < 7; k++)
            dst[o++] = lo.bits[k];
        for (k = 0; k < 7; k++)
            dst[o++] = hi.bits[k];
    }
    return o;
}

int hamming_decode(const u8 *src, int n, char *dst, int cap, int *fixed_bits)
{
    int i = 0, o = 0;

    if (!src || !dst || n % 14 != 0 || cap < n / 14)
        return -1;
    if (fixed_bits)
        *fixed_bits = 0;
    for (i = 0; i + 14 <= n; i += 14) {
        HammingBlock lo = { { 0 } };
        HammingBlock hi = { { 0 } };
        u8 l = 0, h = 0;
        int k = 0;

        for (k = 0; k < 7; k++)
            lo.bits[k] = src[i + k];
        for (k = 0; k < 7; k++)
            hi.bits[k] = src[i + 7 + k];
        if (fixed_bits)
            *fixed_bits += fix(&lo) + fix(&hi);
        decode(&lo, &l);
        decode(&hi, &h);
        dst[o++] = (char)(l | (h << 4));
    }
    return o;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "hamming：编解码往返" {
    HammingBlock b = { { 0 } };
    u8 out = 0;
    int i = 0;

    for (i = 0; i < 16; i++) {
        if (b.encode((u8)i) != 1)
            return err(1, "编码失败");
        if (b.syndrome() != 0)
            return err(2, "刚编出来的码字校验子应该是 0");
        if (b.decode(&out) != 1 || out != (u8)i)
            return err(3, "解码应该还原 nibble");
    }
    /* 已知码字：nibble 0 → 全 0；nibble 0xF → 数据位全 1 */
    b.encode(0);
    if (b.bits[0] != 0 || b.bits[6] != 0)
        return err(4, "0 的码字应该全 0");
    b.encode(0x0F);
    if (ham_get(&b, 3) != 1 || ham_get(&b, 5) != 1 || ham_get(&b, 6) != 1
        || ham_get(&b, 7) != 1)
        return err(5, "0xF 的数据位应该全 1");
}

test "hamming：纠 1 位错" {
    HammingBlock b = { { 0 } };
    u8 out = 0;
    int pos = 0;

    for (pos = 1; pos <= 7; pos++) {
        b.encode(0x0A);
        b.bits[pos - 1] = (u8)(b.bits[pos - 1] ^ 1u);
        if (b.syndrome() != pos)
            return err(6, "校验子应该指出出错位置");
        if (b.fix() != 1)
            return err(7, "应该纠正 1 位");
        if (b.syndrome() != 0)
            return err(8, "纠正后校验子应该归零");
        if (b.decode(&out) != 1 || out != 0x0A)
            return err(9, "纠正后应该解出原数据");
    }
    /* 面向字节的接口 */
    {
        u8 enc[64] = { 0 };
        char dec[8] = { 0 };
        int fixed = 0;
        int n = 0;

        if (hamming_encode(S("Hi!"), enc, (int)sizeof enc) != 42)
            return err(10, "3 字节应该编成 42 个块位");
        if (hamming_decode(enc, 42, dec, (int)sizeof dec, &fixed) != 3)
            return err(11, "解码长度不对");
        if (fixed != 0 || memcmp(dec, "Hi!", 3) != 0)
            return err(12, "无错时应该原样还原");
        enc[2] ^= 1;
        enc[20] ^= 1;
        if (hamming_decode(enc, 42, dec, (int)sizeof dec, &fixed) != 3
            || fixed != 2 || memcmp(dec, "Hi!", 3) != 0)
            return err(13, "两个块各错 1 位应该都能纠正");
    }
}
