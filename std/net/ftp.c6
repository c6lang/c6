/* std/net/ftp：FTP 应答行、PASV 地址、命令与目录列表行的解析。
 *
 *     import std.net.ftp;
 *
 *     FtpReply r = { 0 };
 *     char host[64] = { 0 };
 *     int port = 0;
 *     if (ftp_reply((char[:]){ S("220 Welcome\r\n") }, &r) == 1)
 *         // r.code == 220
 *     if (ftp_pasv((char[:]){ S("227 ... (127,0,0,1,10,20)\r\n") }, host,
 *                  (int)sizeof host, &port) == 1)
 *         // port == 2580
 *
 * 支持：
 *
 * - `ftp_reply`：三位状态码 + 空格/连字符（多行）+ 文本，与 SMTP 同一套规则；
 * - `ftp_pasv`：从 `227` 行括号里的六个十进制数取地址（`h1,h2,h3,h4,p1,p2`，
 *   端口 = `p1*256 + p2`）；
 * - `ftp_cmd`：`VERB arg\r\n`，参数含 CR/LF 判错；
 * - `ftp_list_line`：解 `LIST` 的类 Unix 长格式（`drwxr-xr-x 2 u g 4096 Jan 1
 *   12:00 name`），`mode` 给出 `d`/`-`/`l` 的首字符；
 * - `ftp_mlsd_line`：解 `MLSD` 的 `type=file;size=123; name` 格式。
 *
 * 约定：`ftp_reply`/`ftp_pasv` 只吃一行；`ftp_list_line` 跳过前 8 个字段后把剩下
 * 的全当文件名（所以带空格的文件名可用）；`mode` 是 `'d'`、`'-'`、`'l'` 之一，
 * 认不出返回 -1。
 */
#include <string.h>

module std.net.ftp;
import std.core.types;
import std.text.str;

struct FtpReply {
    int code;
    int more;
    int text_len;
    char text[256];
};

struct FtpEntry {
    int mode;
    i64 size;
    int name_len;
    char name[128];
};

static int ftp_isdigit(char c)
{
    return c >= '0' && c <= '9';
}

int ftp_reply(char[:] line, FtpReply *out)
{
    int i = 0, n = line.len, o = 0;

    if (!line.data || !out || n < 3)
        return -1;
    if (!ftp_isdigit(line.data[0]) || !ftp_isdigit(line.data[1])
        || !ftp_isdigit(line.data[2]))
        return -1;
    memset(out, 0, sizeof *out);
    out->code = (line.data[0] - '0') * 100 + (line.data[1] - '0') * 10
                + (line.data[2] - '0');
    i = 3;
    if (i < n && line.data[i] == '-')
        out->more = 1;
    else if (i < n && line.data[i] != ' ' && line.data[i] != '\r')
        return -1;
    if (i < n)
        i++;
    for (; i < n && line.data[i] != '\r' && line.data[i] != '\n'; i++) {
        if (o + 1 < (int)sizeof out->text)
            out->text[o++] = line.data[i];
    }
    out->text[o] = 0;
    out->text_len = o;
    return 1;
}

int ftp_pasv(char[:] line, char *host, int cap, int *port)
{
    int i = 0, n = line.len, nums[6] = { 0 }, k = 0;
    int open = -1, close = -1;

    if (!line.data || !host || cap <= 0 || !port)
        return -1;
    for (i = 0; i < n; i++) {
        if (line.data[i] == '(') {
            open = i;
            break;
        }
    }
    if (open < 0)
        return -1;
    for (i = open; i < n; i++) {
        if (line.data[i] == ')') {
            close = i;
            break;
        }
    }
    if (close < 0 || close - open < 7)
        return -1;
    i = open + 1;
    for (k = 0; k < 6; k++) {
        int v = 0, digits = 0;

        while (i < close && line.data[i] == ' ')
            i++;
        while (i < close && ftp_isdigit(line.data[i])) {
            v = v * 10 + (line.data[i] - '0');
            digits++;
            i++;
            if (v > 255)
                return -1;
        }
        if (!digits)
            return -1;
        nums[k] = v;
        while (i < close && line.data[i] == ' ')
            i++;
        if (k < 5) {
            if (i >= close || line.data[i] != ',')
                return -1;
            i++;
        }
    }
    {
        int o = 0;

        for (k = 0; k < 4; k++) {
            char tmp[4] = { 0 };
            int t = 0, v = nums[k];

            if (v >= 100) {
                tmp[t++] = (char)('0' + v / 100);
                v %= 100;
            }
            if (t > 0 || v >= 10) {
                tmp[t++] = (char)('0' + v / 10);
                v %= 10;
            }
            tmp[t++] = (char)('0' + v);
            for (t = 0; tmp[t]; t++) {
                if (o + 1 >= cap)
                    return -1;
                host[o++] = tmp[t];
            }
            if (k < 3) {
                if (o + 1 >= cap)
                    return -1;
                host[o++] = '.';
            }
        }
        host[o] = 0;
    }
    *port = nums[4] * 256 + nums[5];
    if (*port <= 0)
        return -1;
    return 1;
}

int ftp_cmd(const char *verb, const char *arg, char *dst, int cap)
{
    int need = 0;

    if (!verb || !dst || cap <= 0)
        return -1;
    need = (int)strlen(verb) + 2;
    if (arg && arg[0]) {
        if (strchr(arg, '\r') || strchr(arg, '\n'))
            return -1;
        need += (int)strlen(arg) + 1;
    }
    if (need > cap)
        return -1;
    {
        int o = 0, i = 0;

        for (i = 0; verb[i]; i++)
            dst[o++] = verb[i];
        if (arg && arg[0]) {
            dst[o++] = ' ';
            for (i = 0; arg[i]; i++)
                dst[o++] = arg[i];
        }
        dst[o++] = '\r';
        dst[o++] = '\n';
        if (o < cap)
            dst[o] = 0;
        return o;
    }
}

/* 跳过一段非空白 + 其后的空白 */
static int ftp_skip_token(char[:] line, int i)
{
    int n = line.len;

    while (i < n && line.data[i] != ' ' && line.data[i] != '\t'
           && line.data[i] != '\r' && line.data[i] != '\n')
        i++;
    while (i < n && (line.data[i] == ' ' || line.data[i] == '\t'))
        i++;
    return i;
}

int ftp_list_line(char[:] line, FtpEntry *out)
{
    int i = 0, n = line.len, k = 0, o = 0;

    if (!line.data || !out || n < 10)
        return -1;
    if (line.data[0] != 'd' && line.data[0] != '-' && line.data[0] != 'l')
        return -1;
    memset(out, 0, sizeof *out);
    out->mode = (int)line.data[0];
    /* 权限串、链接数、属主、属组 */
    for (k = 0; k < 4; k++)
        i = ftp_skip_token(line, i);
    /* 大小 */
    {
        i64 v = 0;
        int start = i;

        while (i < n && ftp_isdigit(line.data[i])) {
            v = v * 10 + (line.data[i] - '0');
            i++;
        }
        if (i == start)
            return -1;
        out->size = v;
    }
    i = ftp_skip_token(line, i);
    /* 月、日、时间（或年份） */
    for (k = 0; k < 3; k++)
        i = ftp_skip_token(line, i);
    for (; i < n && line.data[i] != '\r' && line.data[i] != '\n'; i++) {
        if (o + 1 < (int)sizeof out->name)
            out->name[o++] = line.data[i];
    }
    out->name[o] = 0;
    out->name_len = o;
    if (o == 0)
        return -1;
    return 1;
}

int ftp_mlsd_line(char[:] line, FtpEntry *out)
{
    int i = 0, n = line.len, o = 0;

    if (!line.data || !out || n < 3)
        return -1;
    memset(out, 0, sizeof *out);
    out->mode = '-';
    while (i < n) {
        int fact_start = i, eq = -1;

        while (i < n && line.data[i] != ';' && line.data[i] != ' '
               && line.data[i] != '\r')
            i++;
        {
            int k = 0;

            for (k = fact_start; k < i; k++) {
                if (line.data[k] == '=') {
                    eq = k;
                    break;
                }
            }
        }
        if (eq > fact_start) {
            if (eq - fact_start == 4
                && memcmp(line.data + fact_start, "type", 4) == 0) {
                if (i - eq - 1 == 3
                    && memcmp(line.data + eq + 1, "dir", 3) == 0)
                    out->mode = 'd';
            } else if (eq - fact_start == 4
                       && memcmp(line.data + fact_start, "size", 4) == 0) {
                i64 v = 0;
                int k = eq + 1;

                for (; k < i && ftp_isdigit(line.data[k]); k++)
                    v = v * 10 + (line.data[k] - '0');
                out->size = v;
            }
        }
        if (i < n && line.data[i] == ';')
            i++;
        else
            break;
    }
    while (i < n && line.data[i] == ' ')
        i++;
    for (; i < n && line.data[i] != '\r' && line.data[i] != '\n'; i++) {
        if (o + 1 < (int)sizeof out->name)
            out->name[o++] = line.data[i];
    }
    out->name[o] = 0;
    out->name_len = o;
    if (o == 0 && out->size == 0)
        return -1;
    return 1;
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })

test "ftp：应答与 PASV" {
    FtpReply r = { 0 };
    char host[64] = { 0 };
    int port = 0;

    if (ftp_reply(S("220 Welcome\r\n"), &r) != 1 || r.code != 220
        || r.more != 0)
        return err(1, "220 应答不对");
    if (ftp_reply(S("211-Features:\r\n"), &r) != 1 || r.more != 1)
        return err(2, "多行应答应该 more=1");
    if (ftp_reply(S("bad line\r\n"), &r) != -1)
        return err(3, "非数字应答应该 -1");
    if (ftp_pasv(S("227 Entering Passive Mode (127,0,0,1,10,20)\r\n"), host,
                 (int)sizeof host, &port) != 1)
        return err(4, "PASV 解析失败");
    if (strcmp(host, "127.0.0.1") != 0)
        return err(5, "PASV 地址不对");
    if (port != 2580)
        return err(6, "PASV 端口应该是 2580");
    if (ftp_pasv(S("227 Entering Passive Mode (192,168,100,5,200,30)"), host,
                 (int)sizeof host, &port) != 1)
        return err(7, "PASV 都大于 255 的分量失败");
    if (strcmp(host, "192.168.100.5") != 0 || port != 200 * 256 + 30)
        return err(8, "PASV 三个分量不对");
    if (ftp_pasv(S("227 no parens"), host, (int)sizeof host, &port) != -1)
        return err(9, "没有括号应该 -1");
    if (ftp_pasv(S("227 (127,0,0,1,10)\r\n"), host, (int)sizeof host,
                 &port) != -1)
        return err(10, "只有五个数应该 -1");
}

test "ftp：命令与列表行" {
    FtpEntry e = { 0 };
    char out[128] = { 0 };

    if (ftp_cmd("USER", "alice", out, (int)sizeof out) != 12
        || memcmp(out, "USER alice\r\n", 12) != 0)
        return err(11, "USER 命令不对");
    if (ftp_cmd("PWD", 0, out, (int)sizeof out) != 5
        || memcmp(out, "PWD\r\n", 5) != 0)
        return err(12, "PWD 命令不对");
    if (ftp_cmd("USER", "a\rb", out, (int)sizeof out) != -1)
        return err(13, "参数含 CR 应该 -1");
    if (ftp_list_line(S("-rw-r--r--  1 user group 1234 Jan  1 12:00 file.txt"),
                      &e) != 1)
        return err(14, "LIST 文件行失败");
    if (e.mode != '-' || e.size != 1234 || e.name_len != 8)
        return err(15, "LIST 文件行字段不对");
    if (memcmp(e.name, "file.txt", 8) != 0)
        return err(16, "LIST 文件名不对");
    if (ftp_list_line(S("drwxr-xr-x  2 user group 4096 Jan  1 12:00 docs"),
                      &e) != 1 || e.mode != 'd')
        return err(17, "LIST 目录行不对");
    if (ftp_mlsd_line(S("type=file;size=99;modify=20240101; report.pdf"), &e)
        != 1)
        return err(18, "MLSD 行解析失败");
    if (e.mode != '-' || e.size != 99 || memcmp(e.name, "report.pdf", 10) != 0)
        return err(19, "MLSD 字段不对");
    if (ftp_mlsd_line(S("type=dir;size=0; sub"), &e) != 1 || e.mode != 'd')
        return err(20, "MLSD 目录行不对");
}
