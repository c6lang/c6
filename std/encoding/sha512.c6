/* std/encoding/sha512：SHA-512 / SHA-384（FIPS 180-4）与 HMAC-SHA-512（RFC 2104）。
 *
 *     import std.encoding.sha512;
 *
 *     u8 d[64] = { 0 };
 *     sha512("abc", 3, d);                  // 摘要 64 字节
 *     u8 d48[48] = { 0 };
 *     sha384("abc", 3, d48);                // SHA-384 截到 48 字节
 *
 *     char hex[129] = { 0 };
 *     sha512_hex("abc", 3, hex);            // 128 个小写十六进制 + NUL
 *
 *     Sha512 st = { 0 };                    // 流式：任意切分结果相同
 *     st.init();                            // SHA-384 用 st.init384()
 *     st.update("a", 1);
 *     st.update("bc", 2);
 *     st.final(d);                          // 之后状态失效
 *
 *     u8 mac[64] = { 0 };                   // HMAC-SHA-512
 *     hmac_sha512(key, klen, msg, mlen, mac);
 *     if (sha512_eq(mac, want)) ...         // 64 字节常数时间比较
 *
 * 为什么手写：和 `std.encoding.sha256` 同一个理由——同一份输入在任何平台给出
 * 同一串字节、零分配、不依赖宿主的加密库。64 位字、80 轮，旋转借
 * `std.core.bits` 的 `rotr64`；长度按 128 位记（`n_hi`/`n_lo` 两个 u64 字节计数，
 * 收尾时换算成比特），所以超过 2^61 字节也不会绕回。
 *
 * 空指针约定与 sha256 一致：`p == 0` 当 0 字节输入，`out == 0` 直接返回。
 * `final` 永远写 64 字节；SHA-384 是「不同的 IV + 截到 48 字节」，所以
 * `sha384`/`sha384_hex` 用 SHA-384 的 IV、再把 64 字节结果截到 48 字节。
 */
#include <string.h>

module std.encoding.sha512;
import std.core.types;
import std.core.bits;

struct Sha512 {
    u64 h[8];
    u64 n_lo;      /* 已喂入字节数（低 64 位） */
    u64 n_hi;      /* 高 64 位 */
    u8  buf[128];  /* 未满一块的尾巴 */
    u32 used;
};

/* FIPS 180-4 §4.2.3：前 80 个素数立方根小数部分的前 64 位 */
static const u64 sha512_k[80] = {
    0x428a2f98d728ae22ull, 0x7137449123ef65cdull,
    0xb5c0fbcfec4d3b2full, 0xe9b5dba58189dbbcull,
    0x3956c25bf348b538ull, 0x59f111f1b605d019ull,
    0x923f82a4af194f9bull, 0xab1c5ed5da6d8118ull,
    0xd807aa98a3030242ull, 0x12835b0145706fbeull,
    0x243185be4ee4b28cull, 0x550c7dc3d5ffb4e2ull,
    0x72be5d74f27b896full, 0x80deb1fe3b1696b1ull,
    0x9bdc06a725c71235ull, 0xc19bf174cf692694ull,
    0xe49b69c19ef14ad2ull, 0xefbe4786384f25e3ull,
    0x0fc19dc68b8cd5b5ull, 0x240ca1cc77ac9c65ull,
    0x2de92c6f592b0275ull, 0x4a7484aa6ea6e483ull,
    0x5cb0a9dcbd41fbd4ull, 0x76f988da831153b5ull,
    0x983e5152ee66dfabull, 0xa831c66d2db43210ull,
    0xb00327c898fb213full, 0xbf597fc7beef0ee4ull,
    0xc6e00bf33da88fc2ull, 0xd5a79147930aa725ull,
    0x06ca6351e003826full, 0x142929670a0e6e70ull,
    0x27b70a8546d22ffcull, 0x2e1b21385c26c926ull,
    0x4d2c6dfc5ac42aedull, 0x53380d139d95b3dfull,
    0x650a73548baf63deull, 0x766a0abb3c77b2a8ull,
    0x81c2c92e47edaee6ull, 0x92722c851482353bull,
    0xa2bfe8a14cf10364ull, 0xa81a664bbc423001ull,
    0xc24b8b70d0f89791ull, 0xc76c51a30654be30ull,
    0xd192e819d6ef5218ull, 0xd69906245565a910ull,
    0xf40e35855771202aull, 0x106aa07032bbd1b8ull,
    0x19a4c116b8d2d0c8ull, 0x1e376c085141ab53ull,
    0x2748774cdf8eeb99ull, 0x34b0bcb5e19b48a8ull,
    0x391c0cb3c5c95a63ull, 0x4ed8aa4ae3418acbull,
    0x5b9cca4f7763e373ull, 0x682e6ff3d6b2b8a3ull,
    0x748f82ee5defb2fcull, 0x78a5636f43172f60ull,
    0x84c87814a1f0ab72ull, 0x8cc702081a6439ecull,
    0x90befffa23631e28ull, 0xa4506cebde82bde9ull,
    0xbef9a3f7b2c67915ull, 0xc67178f2e372532bull,
    0xca273eceea26619cull, 0xd186b8c721c0c207ull,
    0xeada7dd6cde0eb1eull, 0xf57d4f7fee6ed178ull,
    0x06f067aa72176fbaull, 0x0a637dc5a2c898a6ull,
    0x113f9804bef90daeull, 0x1b710b35131c471bull,
    0x28db77f523047d84ull, 0x32caab7b40c72493ull,
    0x3c9ebe0a15c9bebcull, 0x431d67c49c100d4cull,
    0x4cc5d4becb3e42b6ull, 0x597f299cfc657e2aull,
    0x5fcb6fab3ad6faecull, 0x6c44198c4a475817ull,
};

static u64 sha512_load_be(const u8 *p)
{
    return ((u64)p[0] << 56) | ((u64)p[1] << 48) | ((u64)p[2] << 40)
           | ((u64)p[3] << 32) | ((u64)p[4] << 24) | ((u64)p[5] << 16)
           | ((u64)p[6] << 8) | (u64)p[7];
}

/* 压一块（128 字节） */
static void sha512_block(Sha512 *self, const u8 *p)
{
    u64 w[80] = { 0 };
    u64 a = 0, b = 0, c = 0, d = 0, e = 0, f = 0, g = 0, h = 0;
    int i = 0;

    for (i = 0; i < 16; i++)
        w[i] = sha512_load_be(p + i * 8);
    for (i = 16; i < 80; i++) {
        u64 s0 = rotr64(w[i - 15], 1) ^ rotr64(w[i - 15], 8)
                 ^ (w[i - 15] >> 7);
        u64 s1 = rotr64(w[i - 2], 19) ^ rotr64(w[i - 2], 61)
                 ^ (w[i - 2] >> 6);

        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    a = self->h[0];
    b = self->h[1];
    c = self->h[2];
    d = self->h[3];
    e = self->h[4];
    f = self->h[5];
    g = self->h[6];
    h = self->h[7];
    for (i = 0; i < 80; i++) {
        u64 t1 = h + (rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41))
                 + ((e & f) ^ (~e & g)) + sha512_k[i] + w[i];
        u64 t2 = (rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39))
                 + ((a & b) ^ (a & c) ^ (b & c));

        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }
    self->h[0] += a;
    self->h[1] += b;
    self->h[2] += c;
    self->h[3] += d;
    self->h[4] += e;
    self->h[5] += f;
    self->h[6] += g;
    self->h[7] += h;
}

void init(Sha512 *self)
{
    /* §5.3.5：前 8 个素数平方根小数部分的前 64 位 */
    static const u64 iv[8] = {
        0x6a09e667f3bcc908ull, 0xbb67ae8584caa73bull,
        0x3c6ef372fe94f82bull, 0xa54ff53a5f1d36f1ull,
        0x510e527fade682d1ull, 0x9b05688c2b3e6c1full,
        0x1f83d9abfb41bd6bull, 0x5be0cd19137e2179ull,
    };
    int i = 0;

    if (!self)
        return;
    for (i = 0; i < 8; i++)
        self->h[i] = iv[i];
    self->n_lo = 0ull;
    self->n_hi = 0ull;
    self->used = 0u;
    memset(self->buf, 0, sizeof self->buf);
}

/* SHA-384 的 IV 只有前 8 个素数换成第 9..16 个 */
void init384(Sha512 *self)
{
    static const u64 iv[8] = {
        0xcbbb9d5dc1059ed8ull, 0x629a292a367cd507ull,
        0x9159015a3070dd17ull, 0x152fecd8f70e5939ull,
        0x67332667ffc00b31ull, 0x8eb44a8768581511ull,
        0xdb0c2e0d64f98fa7ull, 0x47b5481dbefa4fa4ull,
    };
    int i = 0;

    if (!self)
        return;
    for (i = 0; i < 8; i++)
        self->h[i] = iv[i];
    self->n_lo = 0ull;
    self->n_hi = 0ull;
    self->used = 0u;
    memset(self->buf, 0, sizeof self->buf);
}

void update(Sha512 *self, const void *p, usize n)
{
    const u8 *b = (const u8 *)p;
    usize i = 0;

    if (!self || !b)
        return;
    self->n_lo += (u64)n;
    if (self->n_lo < (u64)n)
        self->n_hi++;
    if (self->used != 0u) {
        while (self->used < 128u && i < n)
            self->buf[self->used++] = b[i++];
        if (self->used < 128u)
            return;
        sha512_block(self, self->buf);
        self->used = 0u;
    }
    for (; i + 128 <= n; i += 128)
        sha512_block(self, b + i);
    while (i < n)
        self->buf[self->used++] = b[i++];
}

/* 收尾：0x80 + 填充 + 128 位比特长度（大端），交出 64 字节摘要 */
void final(Sha512 *self, u8 *out64)
{
    u64 bits_hi = 0ull, bits_lo = 0ull;
    int i = 0;

    if (!self || !out64)
        return;
    bits_hi = (self->n_hi << 3) | (self->n_lo >> 61);
    bits_lo = self->n_lo << 3;
    self->buf[self->used++] = 0x80;
    if (self->used > 112u) {
        while (self->used < 128u)
            self->buf[self->used++] = 0;
        sha512_block(self, self->buf);
        self->used = 0u;
    }
    while (self->used < 112u)
        self->buf[self->used++] = 0;
    for (i = 0; i < 8; i++) {
        self->buf[112 + i] = (u8)(bits_hi >> (56 - i * 8));
        self->buf[120 + i] = (u8)(bits_lo >> (56 - i * 8));
    }
    sha512_block(self, self->buf);
    for (i = 0; i < 8; i++) {
        u64 v = self->h[i];
        int j = 0;

        for (j = 0; j < 8; j++)
            out64[i * 8 + j] = (u8)(v >> (56 - j * 8));
    }
    memset(self, 0, sizeof(Sha512));
}

void sha512(const void *p, usize n, u8 *out64)
{
    Sha512 st = { 0 };

    if (!out64)
        return;
    st.init();
    st.update(p, n);
    st.final(out64);
}

void sha384(const void *p, usize n, u8 *out48)
{
    u8 full[64] = { 0 };
    Sha512 st = { 0 };

    if (!out48)
        return;
    st.init384();
    st.update(p, n);
    st.final(full);
    memcpy(out48, full, 48);
    memset(full, 0, sizeof full);
}

static const char sha512_hex_digits[] = "0123456789abcdef";

/* 64 字节摘要 → 128 个小写十六进制 + NUL（调用方给 129 字节） */
void sha512_hex(const void *p, usize n, char *out129)
{
    u8 d[64] = { 0 };
    int i = 0;

    if (!out129)
        return;
    sha512(p, n, d);
    for (i = 0; i < 64; i++) {
        out129[i * 2] = sha512_hex_digits[(d[i] >> 4) & 0xf];
        out129[i * 2 + 1] = sha512_hex_digits[d[i] & 0xf];
    }
    out129[128] = 0;
    memset(d, 0, sizeof d);
}

/* SHA-384 的小写 hex（out97 至少 97 字节） */
void sha384_hex(const void *p, usize n, char *out97)
{
    u8 d[48] = { 0 };
    int i = 0;

    if (!out97)
        return;
    sha384(p, n, d);
    for (i = 0; i < 48; i++) {
        out97[i * 2] = sha512_hex_digits[(d[i] >> 4) & 0xf];
        out97[i * 2 + 1] = sha512_hex_digits[d[i] & 0xf];
    }
    out97[96] = 0;
    memset(d, 0, sizeof d);
}

/* HMAC-SHA-512：key > 128 字节先 sha512，ipad 0x36 / opad 0x5c */
void hmac_sha512(const void *key, usize klen, const void *msg, usize mlen,
                 u8 *out64)
{
    u8 kblock[128] = { 0 };
    u8 pad[128] = { 0 };
    u8 inner[64] = { 0 };
    Sha512 st = { 0 };
    int i = 0;

    if (!out64)
        return;
    if (key) {
        if (klen > sizeof kblock)
            sha512(key, klen, kblock);
        else if (klen > 0)
            memcpy(kblock, key, klen);
    }
    for (i = 0; i < 128; i++)
        pad[i] = (u8)(kblock[i] ^ 0x36);
    st.init();
    st.update(pad, sizeof pad);
    st.update(msg, mlen);
    st.final(inner);
    for (i = 0; i < 128; i++)
        pad[i] = (u8)(kblock[i] ^ 0x5c);
    st.init();
    st.update(pad, sizeof pad);
    st.update(inner, sizeof inner);
    st.final(out64);
    memset(kblock, 0, sizeof kblock);
    memset(pad, 0, sizeof pad);
    memset(inner, 0, sizeof inner);
}

/* HMAC-SHA-384：同样的 ipad/opad，只是用 SHA-384 的 IV，结果截到 48 字节 */
void hmac_sha384(const void *key, usize klen, const void *msg, usize mlen,
                 u8 *out48)
{
    u8 kblock[128] = { 0 };
    u8 pad[128] = { 0 };
    u8 inner[64] = { 0 }, full[64] = { 0 };
    Sha512 st = { 0 };
    int i = 0;

    if (!out48)
        return;
    if (key) {
        if (klen > sizeof kblock)
            sha384(key, klen, kblock);
        else if (klen > 0)
            memcpy(kblock, key, klen);
    }
    for (i = 0; i < 128; i++)
        pad[i] = (u8)(kblock[i] ^ 0x36);
    st.init384();
    st.update(pad, sizeof pad);
    st.update(msg, mlen);
    st.final(inner);
    for (i = 0; i < 128; i++)
        pad[i] = (u8)(kblock[i] ^ 0x5c);
    st.init384();
    st.update(pad, sizeof pad);
    st.update(inner, 48);               /* SHA-384 的中间值是 48 字节 */
    st.final(full);
    memcpy(out48, full, 48);
    memset(kblock, 0, sizeof kblock);
    memset(pad, 0, sizeof pad);
    memset(inner, 0, sizeof inner);
    memset(full, 0, sizeof full);
}

/* HMAC-SHA-512 的小写 hex（out129 至少 129 字节） */
void hmac_sha512_hex(const void *key, usize klen, const void *msg, usize mlen,
                     char *out129)
{
    u8 d[64] = { 0 };
    int i = 0;

    if (!out129)
        return;
    hmac_sha512(key, klen, msg, mlen, d);
    for (i = 0; i < 64; i++) {
        out129[i * 2] = sha512_hex_digits[(d[i] >> 4) & 0xf];
        out129[i * 2 + 1] = sha512_hex_digits[d[i] & 0xf];
    }
    out129[128] = 0;
    memset(d, 0, sizeof d);
}

/* 64 字节常数时间比较：相等 1，否则 0（不短路，空指针一律 0） */
int sha512_eq(const u8 *a, const u8 *b)
{
    u64 diff = 0ull;
    int i = 0;

    if (!a || !b)
        return 0;
    for (i = 0; i < 64; i++)
        diff |= (u64)(a[i] ^ b[i]);
    return diff == 0ull ? 1 : 0;
}

/* ---- 自测 ---- */

static int hex_is(int which, const char *msg, int n, const char *want)
{
    char got[129] = { 0 };

    if (which == 384)
        sha384_hex(msg, (usize)n, got);
    else
        sha512_hex(msg, (usize)n, got);
    return strcmp(got, want) == 0;
}

static int hmac_hex_is(const char *key, int klen, const char *msg, int mlen,
                       const char *want)
{
    char got[129] = { 0 };

    hmac_sha512_hex(key, (usize)klen, msg, (usize)mlen, got);
    return strcmp(got, want) == 0;
}

test "SHA-512 与 SHA-384 的已知向量" {
    if (!hex_is(512, "", 0,
                "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce"
                "47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"))
        return err(1, "SHA-512 空串不对");
    if (!hex_is(512, "abc", 3,
                "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a"
                "2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"))
        return err(2, "SHA-512 abc 不对");
    if (!hex_is(384, "", 0,
                "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da"
                "274edebfe76f65fbd51ad2f14898b95b"))
        return err(3, "SHA-384 空串不对");
    if (!hex_is(384, "abc", 3,
                "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed"
                "8086072ba1e7cc2358baeca134c825a7"))
        return err(4, "SHA-384 abc 不对");
    if (!hex_is(512,
                "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmn"
                "hijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
                112,
                "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018"
                "501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"))
        return err(5, "SHA-512 112 字节向量不对");
}

test "流式喂入、截断与常数时间比较" {
    char all[129] = { 0 }, got[129] = { 0 };
    u8 a[64] = { 0 }, b[64] = { 0 }, c[64] = { 0 }, d48[48] = { 0 };
    Sha512 st = { 0 };
    int i = 0;

    sha512_hex("a", 1, all);
    st.init();
    st.update("a", 1);
    st.final(a);
    st.init();
    st.update("a", 1);
    st.final(b);
    if (!sha512_eq(a, b))
        return err(6, "同一输入两次结果不一致");
    /* 1 字节一喂 vs 一次性（1000 个 'a'） */
    {
        char text[1000] = { 0 };

        memset(text, 'a', sizeof text);
        sha512_hex(text, (usize)sizeof text, all);
        st.init();
        for (i = 0; i < (int)sizeof text; i++)
            st.update(text + i, 1);
        st.final(c);
        for (i = 0; i < 64; i++) {
            got[i * 2] = "0123456789abcdef"[(c[i] >> 4) & 0xf];
            got[i * 2 + 1] = "0123456789abcdef"[c[i] & 0xf];
        }
        got[128] = 0;
        if (strcmp(got, all) != 0)
            return err(7, "1 字节一喂和一次性不一致");
        if (strcmp(all,
                   "67ba5535a46e3f86dbfbed8cbbaf0125c76ed549ff8b0b9e03e0c88cf90fa634"
                   "fa7b12b47d77b694de488ace8d9a65967dc96df599727d3292a8d9d447709c97")
            != 0)
            return err(8, "1000 个 a 的摘要不对");
    }
    /* 128 字节块边界：127/128/129 */
    {
        char text[300] = { 0 };
        char one[129] = { 0 }, two[129] = { 0 };

        for (i = 0; i < (int)sizeof text; i++)
            text[i] = (char)('0' + i % 10);
        sha512_hex(text, (usize)sizeof text, one);
        st.init();
        st.update(text, 127);
        st.update(text + 127, 128);
        st.update(text + 255, (usize)sizeof text - 255);
        st.final(c);
        for (i = 0; i < 64; i++) {
            two[i * 2] = "0123456789abcdef"[(c[i] >> 4) & 0xf];
            two[i * 2 + 1] = "0123456789abcdef"[c[i] & 0xf];
        }
        two[128] = 0;
        if (strcmp(one, two) != 0)
            return err(9, "127/128/129 切分结果不一致");
    }
    /* SHA-384 就是 SHA-512 截 48 字节（IV 不同，长度也不同） */
    sha384("abc", 3, d48);
    sha512("abc", 3, a);
    if (memcmp(d48, a, 48) == 0)
        return err(10, "SHA-384 不该和 SHA-512 前 48 字节相同");
    /* 常数时间比较 */
    memcpy(b, a, sizeof a);
    if (!sha512_eq(a, b))
        return err(11, "相同摘要应该相等");
    b[63] ^= 1;
    if (sha512_eq(a, b))
        return err(12, "改一字节应该不相等");
    if (sha512_eq(0, b) || sha512_eq(a, 0))
        return err(13, "空指针比较应该给 0");
    /* 空指针输入 == 空输入 */
    sha512(0, 0, a);
    sha512("", 0, b);
    if (!sha512_eq(a, b))
        return err(14, "NULL 输入应该等于空输入");
}

test "HMAC-SHA-512 的 RFC 4231 向量" {
    if (!hmac_hex_is("\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b"
                     "\x0b\x0b\x0b\x0b\x0b\x0b",
                     20, "Hi There", 8,
                     "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cde"
                     "daa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854"))
        return err(15, "HMAC case 1 不对");
    if (!hmac_hex_is("Jefe", 4, "what do ya want for nothing?", 28,
                     "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea250554"
                     "9758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"))
        return err(16, "HMAC case 2 不对");
    /* key 比块长（128）还长：先压成 64 字节摘要 */
    {
        char key[131] = { 0 };

        memset(key, 0xaa, sizeof key);
        if (!hmac_hex_is(key, 131,
                         "Test Using Larger Than Block-Size Key - Hash Key First",
                         54,
                         "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f352"
                         "6b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598"))
            return err(17, "HMAC 长 key 不对");
    }
    /* key 为空 / msg 为空 / key 指针为 0 */
    {
        char a[129] = { 0 }, b[129] = { 0 };

        hmac_sha512_hex("", 0, "x", 1, a);
        hmac_sha512_hex(0, 0, "x", 1, b);
        if (strcmp(a, b) != 0)
            return err(18, "空 key 和 NULL key 应该一致");
        hmac_sha512_hex("k", 1, "", 0, a);
        hmac_sha512_hex("k", 1, 0, 0, b);
        if (strcmp(a, b) != 0)
            return err(19, "空 msg 和 NULL msg 应该一致");
        hmac_sha512(0, 0, 0, 0, 0);        /* 都不写，也不崩 */
    }
}
