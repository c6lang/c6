+/* Compose 'outer' and 'inner' into a single prefix.  Nesting is not a
+   separate namespace layer: 'package a { package b { ... } }' simply
+   prefixes twice, so a symbol declared inside becomes 'a__b__sym'. */
+static char *superc_pkg_compose(const char *outer, char *inner)
 {
-    char *name;
-    if (*ptok < TOK_UIDENT)
-        expect("identifier");
-    name = tcc_strdup(get_tok_str(*ptok, NULL));
-    next();
-    return name;
+    char buf[128];
+    int n;
+
+    n = snprintf(buf, sizeof buf, "%s__%s", outer, inner);
+    tcc_free(inner);
+    if (n >= (int)sizeof buf)
+        tcc_error("package name too long");
+    return tcc_strdup(buf);
 }
 
 static void superc_package_parse(void)
@@ -7401,11 +7526,11 @@ static void superc_package_parse(void)
     char *name, *saved;
 
     next();  /* skip 'package' */
-    name = superc_ident_str(&tok);
+    name = superc_pkg_name(&tok);
+    if (tcc_state->superc_package)
+        name = superc_pkg_compose(tcc_state->superc_package, name);
     if (tok == '{') {
         /* 'package NAME { ... }': the package ends with the block */
-        if (tcc_state->superc_package)
-            tcc_error("nested 'package' is not allowed");
         saved = tcc_state->superc_package;
         tcc_state->superc_package = name;
         next();
@@ -7413,9 +7538,11 @@ static void superc_package_parse(void)
             decl(VT_CONST);
         skip('}');
         tcc_state->superc_package = saved;
+        tcc_free(name);
     } else {
         /* 'package NAME;' names the rest of the file (or until the next
            'package' statement); include system headers before it */
+        tcc_free(tcc_state->superc_package);
         tcc_state->superc_package = name;
         skip(';');
     }
@@ -7424,8 +7551,9 @@ static void superc_package_parse(void)
 static void superc_import_parse(void)
 {
     char *name;
+
     next();  /* skip 'import' */
-    name = superc_ident_str(&tok);
+    name = superc_pkg_name(&tok);
     skip(';');
     dynarray_add(&tcc_state->superc_imports,
                  &tcc_state->superc_nb_imports, name);
diff --git a/tests/tests2/166_superc_pkg_dot.c b/tests/tests2/166_superc_pkg_dot.c
new file mode 100644
index 0000000..2111b47
--- /dev/null
+++ b/tests/tests2/166_superc_pkg_dot.c
@@ -0,0 +1,62 @@
+/* superc extension: 'pkg.member' explicit package access */
+#include <stdio.h>
+
+package math {
+    int counter = 0;
+    int add(int a, int b) { return a + b; }
+    /* inside 'package math' the qualified spelling needs no import */
+    int twice(int a) { return math.add(a, a); }
+    struct Point { int x, y; };
+    struct Point origin = {3, 4};
+    int bump(void) { return ++counter; }
+}
+
+/* 'import' is allowed inside a package block and names the rest of it */
+package text {
+    import math;
+    int len(const char *s)
+    {
+        int n = 0;
+        while (s[n])
+            n++;
+        return n;
+    }
+    int len_plus(int k) { return len("ab") + math.add(k, 1); }
+}
+
+import math;
+import text;
+
+/* a qualified package function is an ordinary symbol: its address works */
+int (*add_ref)(int, int) = math.add;
+
+int main(void)
+{
+    /* qualified access, mixed with unqualified access from 'import' */
+    printf("add=%d %d\n", math.add(2, 3), add(4, 5));
+    printf("twice=%d len=%d\n", math.twice(21), text.len("hello"));
+    printf("len_plus=%d\n", text.len_plus(1));
+
+    /* package globals: read, address-of and assignment */
+    printf("counter=%d\n", math.counter);
+    printf("bump=%d\n", math.bump());
+    printf("bump=%d\n", math.bump());
+    math.counter = 10;
+    printf("counter=%d\n", math.counter);
+    printf("origin=%d,%d\n", math.origin.x, math.origin.y);
+    *&math.origin.x = 8;
+    printf("origin=%d\n", math.origin.x);
+    printf("add_ref=%d\n", add_ref(20, 22));
+
+    /* the mangled spelling keeps working and names the same object */
+    math__counter = 42;
+    printf("mangled=%d %d\n", math__add(10, 20), math__counter);
+
+    /* a visible object wins over the package name: plain C member access */
+    {
+        struct Point math = {7, 8};
+        printf("shadow=%d\n", math.x);
+    }
+
+    return 0;
+}
