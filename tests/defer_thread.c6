/* c6 自测：defer 在多线程里不需要任何线程级状态
 *
 * 哪些清理点已注册（帧里的位图）和正在服务的清理请求（两个 int）都是本帧的
 * 局部变量，所以 'spawn' 起来的线程和主线程可以同时反复进出带 defer 的作用域、
 * 递归若干层、走错误路径，谁的清理点都跑不到对方的帧里去。这里每个线程把
 * 结果记在自己的计数器里，最后逐个核对。
 *
 * 运行（仓库根目录）：
 *   make selftest
 * 或单个文件：
 *   ./tcc/tcc -B tcc -test tests/defer_thread.c6
 */
#include <stdio.h>

#define ROUNDS 500
#define DEPTH  100

/* 空转等待，有上界：出错时报失败而不是挂住 */
static int wait_nonzero(volatile int *p)
{
    int i = 0;

    for (i = 0; i < 20000000 && *p == 0; i++)
        ;
    return *p;
}

static volatile int gate = 0;
static volatile int done_a = 0;
static volatile int done_b = 0;

static int count_a = 0;
static int count_b = 0;
static int count_main = 0;

/* 每一帧：ROUNDS 次块作用域进出，然后往下一层递归 */
static int churn(int *counter, int depth)
{
    int i = 0;

    for (i = 0; i < ROUNDS; i++) {
        {
            defer *counter += 1;
        }
    }
    if (depth > 0)
        return churn(counter, depth - 1);
    return 0;
}

static int worker_a(void)
{
    (void)wait_nonzero(&gate);
    churn(&count_a, DEPTH);
    done_a = 1;
    return 0;
}

static int worker_b(void)
{
    (void)wait_nonzero(&gate);
    churn(&count_b, DEPTH);
    done_b = 1;
    return 0;
}

test "spawn 线程和主线程同时跑带 defer 的代码" {
    gate = 0;
    done_a = 0;
    done_b = 0;
    count_a = 0;
    count_b = 0;
    count_main = 0;

    spawn worker_a();
    spawn worker_b();
    churn(&count_main, DEPTH);          /* 主线程同时做同样的事 */
    gate = 1;                           /* 走到这里说明 spawn 没有阻塞 */

    (void)wait_nonzero(&done_a);
    (void)wait_nonzero(&done_b);
    __c6_th_join_all();

    if (count_a != ROUNDS * (DEPTH + 1))
        return err(1, "线程 A 的清理次数不对（帧之间串了）");
    if (count_b != ROUNDS * (DEPTH + 1))
        return err(2, "线程 B 的清理次数不对（帧之间串了）");
    if (count_main != ROUNDS * (DEPTH + 1))
        return err(3, "主线程的清理次数不对（帧之间串了）");
}

/* ---- 线程里走错误路径：defer + errdefer 都要跑 ---- */
static volatile int done_err = 0;
static volatile int err_seen = 0;
static int count_err = 0;

static int!error th_fail(int n)
{
    defer count_err += 1;
    errdefer count_err += 10;
    return err(n, "thread");
    return 0;
}

static int worker_err(void)
{
    (void)wait_nonzero(&gate);
    th_fail(42) catch e {
        err_seen = e.id == 42 ? 1 : -1;
        done_err = 1;
        return 0;
    };
    done_err = 1;
    return 0;
}

test "线程里的错误路径照样跑清理" {
    gate = 0;
    done_err = 0;
    err_seen = 0;
    count_err = 0;

    spawn worker_err();
    gate = 1;

    (void)wait_nonzero(&done_err);
    __c6_th_join_all();

    if (err_seen != 1)
        return err(1, "线程里没有拿到错误码");
    if (count_err != 11)
        return err(2, "线程里错误路径的清理次数不对（defer 1 次 + errdefer 1 次）");
}

/* ---- 同一个 'spawn' 线程里反复进出带着清理点的函数 ---- */
static volatile int done_many = 0;
static int count_many = 0;

static int many_calls(int n)
{
    int i = 0;

    for (i = 0; i < n; i++) {
        {
            defer count_many += 1;
        }
    }
    return 0;
}

static int worker_many(void)
{
    (void)wait_nonzero(&gate);
    many_calls(ROUNDS);
    many_calls(ROUNDS);                 /* 同一个线程里的另一帧 */
    done_many = 1;
    return 0;
}

test "一个线程里连续两次调用带清理的函数" {
    gate = 0;
    done_many = 0;
    count_many = 0;

    spawn worker_many();
    gate = 1;

    (void)wait_nonzero(&done_many);
    __c6_th_join_all();

    if (count_many != 2 * ROUNDS)
        return err(1, "两帧的清理次数不对");
}
