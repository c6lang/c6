/* c6 编译期诊断：析构方法 drop（引用计数 GC，阶段 P4）
 *
 * 运行（仓库根目录）：
 *   tests/run-tests.sh errors/drop_bad
 *
 * 'drop' 是 T 的析构：计数归零、对象真正被释放时由运行时调用一次。它跑
 * 在“对象正在消失”的那一刻，所以不能有返回值、不能失败、不能挂起，也
 * 不能手动调用 —— 生死只由引用决定。
 */
struct File { int fd; };
struct Other { int v; };
int!error boom(void);

// EXPECT drop_bad_return: error: 'drop' must return void: it runs while the object is being released, where a value has nowhere to go
// EXPECT drop_bad_fail: error: 'drop' cannot fail ('!error'): it runs while the object is being released, where an error has nowhere to go
// EXPECT drop_bad_dup: error: redefinition of 'File_drop'
// EXPECT drop_bad_call: error: a destructor cannot be called: it runs when the last reference is released (use 'p = NULL')
// EXPECT drop_bad_call_plain: error: a destructor cannot be called: it runs when the last reference is released (use 'p = NULL')
// EXPECT drop_bad_go: error: a destructor cannot suspend: it runs while the object is being released
// EXPECT drop_bad_try: error: a destructor cannot fail: it runs while the object is being released, where an error has nowhere to go
// EXPECT drop_bad_async: error: 'async' functions cannot be methods: 'drop'

#if defined drop_bad_return
int drop(struct File *self)
{
    (void)self;
    return 0;
}
int main(void)
{
    return 0;
}
#elif defined drop_bad_fail
void!error drop(struct File *self)
{
    (void)self;
    return err(1, "no");
}
int main(void)
{
    return 0;
}
#elif defined drop_bad_dup
void drop(struct File *self)
{
    (void)self;
}
void drop(struct File *self)
{
    self->fd = 0;
}
int main(void)
{
    return 0;
}
#elif defined drop_bad_call
void drop(struct File *self)
{
    self->fd = 0;
}
int main(void)
{
    @File f = new File;
    f->drop();
    return 0;
}
#elif defined drop_bad_call_plain
void drop(struct File *self)
{
    self->fd = 0;
}
int main(void)
{
    @File f = new File;
    drop(f);
    return 0;
}
#elif defined drop_bad_go
static void work(void)
{
}
void drop(struct File *self)
{
    (void)self;
    spawn work();
}
int main(void)
{
    return 0;
}
#elif defined drop_bad_try
void drop(struct File *self)
{
    int v = boom() catch e { return; };
    self->fd = v;
}
int main(void)
{
    return 0;
}
#elif defined drop_bad_async
async void drop(struct File *self)
{
    (void)self;
}
int main(void)
{
    return 0;
}
#else
/* 正常路径：合法的析构，编译通过并跑一遍 */
static int runs = 0;
void drop(struct File *self)
{
    runs += self->fd;
}
static int runs_of(struct Other *o)
{
    (void)o;
    return 0;
}
int main(void)
{
    @File f = new File;
    f->fd = 2;
    f = NULL;
    if (runs != 2)
        return 1;
    if (runs_of(NULL) != 0)
        return 2;
    return 0;
}
#endif
