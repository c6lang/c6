/* std/net/router：方法与路径模式匹配的路由表（零分配，纯值）。
 *
 *     import std.net.router;
 *
 *     Router r = { 0 };
 *     r.add("GET", "/", 1);
 *     r.add("GET", "/users/:id", 2);
 *     r.add("GET", "/files/*path", 3);
 *
 *     Match m = { 0 };
 *     if (r.match(method, path, &m)) {
 *         Str id = m.param(SS("id"));      // "/users/42" -> "42"
 *         Str rest = m.rest;               // "/files/a/b" -> "a/b"
 *     }
 *
 * 这一层只做**匹配**：不碰 socket、不解析报文，`std.net.httpd` 的处理器里拿
 * `Request` 的 `method`/`path` 喂进来即可。路由表是固定 32 条的数组，模式串
 * 拷贝进结构体（96 字节上限），参数值是从传入路径上切下来的视图——所以
 * `Match` 的生命周期不能超过 `path` 指向的缓冲。
 *
 * 语法：
 *
 * - 模式以 `/` 开头，按 `/` 切段；**空段也参与比较**，所以 `/a/` 和 `/a`
 *   不是同一条路由，`/a//b` 也不等于 `/a/b`（匹配是严格的，不做归一化）。
 * - `:name` 捕获**一段**（不含 `/`），名字 1..15 个字符，允许字母/数字/`_`
 *   但不能以数字开头；一条路由最多 4 个参数。
 * - `*` 或 `*name` 捕获**剩余全部**（含中间的 `/`），只能是最后一段；`rest`
 *   不含开头那个 `/`（`/files/a/b` 对 `/files/*path` 得到 `a/b`）。
 * - 方法大小写不敏感；`"*"` 匹配任意方法。同一条路径注册多条时**先注册的赢**。
 *
 * 匹配失败时 `Match` 不被写（调用方可以复用上一次的），成功时 `id` 是注册时
 * 给的值，`index` 是命中的路由下标（调试/统计用）。
 */
#include <stdio.h>
#include <string.h>

module std.net.router;
import std.core.types;
import std.text.str;

#define ROUTER_MAX 32
#define ROUTE_PARAM_MAX 4
#define ROUTE_NAME_MAX 16
#define ROUTE_PATTERN_MAX 96
#define ROUTE_METHOD_MAX 12

struct Route {
    char method[ROUTE_METHOD_MAX];
    char pattern[ROUTE_PATTERN_MAX];
    int id;
    int nparams;
    char names[ROUTE_PARAM_MAX][ROUTE_NAME_MAX];
};

struct Router {
    Route routes[ROUTER_MAX];
    int n;
};

struct Param {
    Str name;
    Str value;
};

struct Match {
    int id;
    int index;
    int n;
    Param params[ROUTE_PARAM_MAX];
    int wildcard;
    Str rest;
};

static Str str_empty(void)
{
    Str s = { { (char *)0, 0 } };

    return s;
}

static int lower(int c) { return (c >= 'A' && c <= 'Z') ? c + 32 : c; }

/* 方法名和 C 字符串比较（忽略大小写） */
static int ieq_z(Str a, char *z)
{
    int i = 0, n = (int)strlen(z);

    if (!a.s.data || a.s.len != n)
        return 0;
    for (i = 0; i < n; i++)
        if (lower((int)(u8)a.s.data[i]) != lower((int)(u8)z[i]))
            return 0;
    return 1;
}

/* 两段视图相等（大小写敏感，路径是大小写敏感的） */
static int seg_eq(Str a, Str b)
{
    if (a.s.len != b.s.len)
        return 0;
    if (a.s.len == 0)
        return 1;
    return memcmp(a.s.data, b.s.data, (size_t)a.s.len) == 0;
}

/* 按 '/' 切下一段；*pos 超过 len 表示切完了 */
static int next_seg(Str s, int *pos, Str *out)
{
    int start = 0, i = 0;

    if (*pos > s.s.len)
        return 0;
    start = *pos;
    for (i = start; i < s.s.len && s.s.data[i] != '/'; i++)
        ;
    *out = (Str){ (char[:]){ s.s.data + start, i - start } };
    *pos = (i < s.s.len) ? i + 1 : s.s.len + 1;
    return 1;
}

static int name_char(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
           || (c >= '0' && c <= '9') || c == '_';
}

/* 校验一条模式，顺便把参数名填进 route；1 有效 / 0 无效 */
static int route_compile(Route *r, char *pattern)
{
    int len = (int)strlen(pattern);
    int pos = 0, wildcard = 0;
    Str seg = { 0 };

    if (len <= 0 || len >= ROUTE_PATTERN_MAX || pattern[0] != '/')
        return 0;
    memcpy(r->pattern, pattern, (size_t)len + 1);
    r->nparams = 0;
    while (next_seg((Str){ (char[:]){ pattern, len } }, &pos, &seg)) {
        int i = 0;
        int is_last = 1;

        /* 看后面还有没有段（决定 * 能不能出现） */
        {
            int probe = pos;
            Str tmp = { 0 };

            is_last = !next_seg((Str){ (char[:]){ pattern, len } }, &probe, &tmp);
        }
        if (seg.s.len == 0)
            continue;
        if (seg.s.data[0] == ':') {
            int n = seg.s.len - 1;

            if (n <= 0 || n >= ROUTE_NAME_MAX || r->nparams >= ROUTE_PARAM_MAX)
                return 0;
            if (!((seg.s.data[1] >= 'a' && seg.s.data[1] <= 'z')
                  || (seg.s.data[1] >= 'A' && seg.s.data[1] <= 'Z')
                  || seg.s.data[1] == '_'))
                return 0;
            for (i = 1; i < seg.s.len; i++)
                if (!name_char((int)(u8)seg.s.data[i]))
                    return 0;
            memcpy(r->names[r->nparams], seg.s.data + 1, (size_t)n);
            r->names[r->nparams][n] = 0;
            r->nparams++;
            continue;
        }
        if (seg.s.data[0] == '*') {
            int n = seg.s.len - 1;

            if (!is_last || wildcard)
                return 0;
            if (n >= ROUTE_NAME_MAX)
                return 0;
            for (i = 1; i < seg.s.len; i++)
                if (!name_char((int)(u8)seg.s.data[i]))
                    return 0;
            wildcard = 1;
            continue;
        }
        /* 字面量段里不允许再出现 : 或 * */
        for (i = 0; i < seg.s.len; i++)
            if (seg.s.data[i] == ':' || seg.s.data[i] == '*')
                return 0;
    }
    return 1;
}

/* 往表里加一条：1 加入 / 0 满了 / -1 参数或模式不合法 */
int add(Router *self, char *method, char *pattern, int id)
{
    Route r = { 0 };
    int n = 0, i = 0;

    if (!self || !method || !pattern)
        return -1;
    n = (int)strlen(method);
    if (n <= 0 || n >= ROUTE_METHOD_MAX)
        return -1;
    if (strcmp(method, "*") != 0)
        for (i = 0; i < n; i++)
            if (!name_char((int)(u8)method[i]) && method[i] != '-')
                return -1;
    if (!route_compile(&r, pattern))
        return -1;
    if (self->n >= ROUTER_MAX)
        return 0;
    memcpy(r.method, method, (size_t)n + 1);
    r.id = id;
    self->routes[self->n] = r;
    self->n++;
    return 1;
}

int count(Router *self) { return self ? self->n : 0; }

void clear(Router *self)
{
    if (self)
        self->n = 0;
}

/* 一条路由对一条路径：1 命中 / 0 不命中；命中时写 *out */
static int route_match(Route *r, Str method, Str path, Match *out, int index)
{
    Str pat = { (char[:]){ r->pattern, (int)strlen(r->pattern) } };
    int ppos = 0, spos = 0, np = 0;
    Str pseg = { 0 }, sseg = { 0 };
    Match m = { 0 };

    if (strcmp(r->method, "*") != 0 && !ieq_z(method, r->method))
        return 0;
    if (path.s.len <= 0 || path.s.data[0] != '/')
        return 0;
    m.index = index;
    m.id = r->id;
    for (;;) {
        int hp = next_seg(pat, &ppos, &pseg);
        int hs = next_seg(path, &spos, &sseg);

        if (!hp) {
            if (hs)
                return 0;
            *out = m;
            return 1;
        }
        if (pseg.s.len > 0 && pseg.s.data[0] == '*') {
            m.wildcard = 1;
            if (hs) {
                int off = (int)(sseg.s.data - path.s.data);

                m.rest = (Str){ (char[:]){ path.s.data + off,
                                           path.s.len - off } };
            } else {
                m.rest = str_empty();
            }
            m.id = r->id;
            *out = m;
            return 1;
        }
        if (!hs)
            return 0;
        if (pseg.s.len > 0 && pseg.s.data[0] == ':') {
            if (np >= ROUTE_PARAM_MAX)
                return 0;
            m.params[np].name = (Str){ (char[:]){ r->names[np],
                                                 (int)strlen(r->names[np]) } };
            m.params[np].value = sseg;
            np++;
            continue;
        }
        if (!seg_eq(pseg, sseg))
            return 0;
    }
}

/* 依次尝试；1 命中（写 *out）/ 0 没命中 */
int match(Router *self, Str method, Str path, Match *out)
{
    int i = 0;

    if (!self || !out)
        return 0;
    for (i = 0; i < self->n; i++)
        if (route_match(&self->routes[i], method, path, out, i)) {
            out->n = self->routes[i].nparams;
            return 1;
        }
    return 0;
}

int has(Match *self, Str name)
{
    int i = 0;

    if (!self)
        return 0;
    for (i = 0; i < self->n; i++)
        if (seg_eq(self->params[i].name, name))
            return 1;
    return 0;
}

/* 按名字取参数值；没有给空视图 */
Str param(Match *self, Str name)
{
    int i = 0;

    if (!self)
        return str_empty();
    for (i = 0; i < self->n; i++)
        if (seg_eq(self->params[i].name, name))
            return self->params[i].value;
    return str_empty();
}

/* ---- 自测 ---- */

#define S(lit) ((char[:]){ (char *)(lit), (int)(sizeof(lit) - 1) })
#define SS(lit) ((Str){ S(lit) })

test "字面量、参数与通配符" {
    Router r = { 0 };
    Match m = { 0 };

    if (r.add("GET", "/", 1) != 1)
        return err(1, "注册 / 失败");
    if (r.add("GET", "/users/:id", 2) != 1)
        return err(2, "注册 /users/:id 失败");
    if (r.add("GET", "/users/:id/posts/:pid", 3) != 1)
        return err(3, "注册双参数路由失败");
    if (r.add("GET", "/files/*path", 4) != 1)
        return err(4, "注册通配符路由失败");
    if (r.count() != 4)
        return err(5, "路由条数不对");
    if (!r.match(SS("GET"), SS("/"), &m) || m.id != 1)
        return err(6, "/ 没命中");
    if (!r.match(SS("GET"), SS("/users/42"), &m) || m.id != 2)
        return err(7, "/users/42 没命中");
    if (m.param(SS("id")).s.len != 2
        || memcmp(m.param(SS("id")).s.data, "42", 2) != 0
        || m.param(SS("ID")).s.len != 0)
        return err(8, "参数 id 不对（名字大小写敏感）");
    if (!m.has(SS("id")) || m.has(SS("pid")))
        return err(9, "has 不对");
    if (!r.match(SS("GET"), SS("/users/7/posts/9"), &m) || m.id != 3)
        return err(10, "双参数路由没命中");
    if (m.param(SS("id")).s.len != 1 || m.param(SS("id")).s.data[0] != '7'
        || m.param(SS("pid")).s.len != 1 || m.param(SS("pid")).s.data[0] != '9')
        return err(11, "双参数值不对");
    if (!r.match(SS("GET"), SS("/files/a/b.txt"), &m) || m.id != 4)
        return err(12, "通配符路由没命中");
    if (!m.wildcard || m.rest.s.len != 7
        || memcmp(m.rest.s.data, "a/b.txt", 7) != 0)
        return err(13, "通配符捕获不对");
    if (!r.match(SS("GET"), SS("/files"), &m) || m.id != 4
        || m.rest.s.len != 0)
        return err(14, "/files 应该被通配符接住（rest 为空）");
}

test "方法过滤、严格路径与未命中" {
    Router r = { 0 };
    Match m = { 0 };

    if (r.add("GET", "/a", 1) != 1 || r.add("POST", "/a", 2) != 1
        || r.add("*", "/any", 3) != 1)
        return err(15, "注册失败");
    if (!r.match(SS("get"), SS("/a"), &m) || m.id != 1)
        return err(16, "方法应该大小写不敏感");
    if (!r.match(SS("POST"), SS("/a"), &m) || m.id != 2)
        return err(17, "POST 路由没命中");
    if (r.match(SS("DELETE"), SS("/a"), &m))
        return err(18, "方法不匹配不该命中");
    if (!r.match(SS("DELETE"), SS("/any"), &m) || m.id != 3)
        return err(19, "* 方法应该匹配任意方法");
    if (r.match(SS("GET"), SS("/a/"), &m))
        return err(20, "结尾多一个 / 不该命中");
    if (r.match(SS("GET"), SS("/a?x=1"), &m))
        return err(21, "带查询串的路径不该命中（调用方先切 path）");
    if (r.match(SS("GET"), SS("/"), &m))
        return err(22, "没注册的 / 不该命中");
    if (r.match(SS("GET"), SS("a"), &m))
        return err(23, "不以 / 开头的路径不该命中");
    /* 先注册的赢 */
    if (r.add("GET", "/a", 9) != 1 || !r.match(SS("GET"), SS("/a"), &m)
        || m.id != 1)
        return err(24, "重复注册应该先注册的赢");
    /* 参数名不存在时给空视图 */
    if (!r.match(SS("GET"), SS("/a"), &m) || m.param(SS("nope")).s.len != 0)
        return err(25, "不存在的参数应该给空视图");
    r.clear();
    if (r.count() != 0 || r.match(SS("GET"), SS("/a"), &m))
        return err(26, "clear 之后不该命中");
}

test "非法模式与容量上限" {
    Router r = { 0 };
    Match m = { 0 };
    int i = 0;
    char pat[ROUTE_PATTERN_MAX] = { 0 };

    if (r.add("GET", "", 1) != -1)
        return err(27, "空模式应该被拒");
    if (r.add("GET", "a", 1) != -1)
        return err(28, "不以 / 开头的模式应该被拒");
    if (r.add("GET", "/a/:1x", 1) != -1)
        return err(29, "参数名带数字开头应该被拒");
    if (r.add("GET", "/a/:", 1) != -1)
        return err(30, "空参数名应该被拒");
    if (r.add("GET", "/a/*x/b", 1) != -1)
        return err(31, "通配符不在最后应该被拒");
    if (r.add("GET", "/a/b*c", 1) != -1)
        return err(32, "字面量段里的 * 应该被拒");
    if (r.add("GET", "/a/:x/:y/:z/:w/:v", 1) != -1)
        return err(33, "超过 4 个参数应该被拒");
    if (r.add("GET", "/a", 1) != 1 || r.add("", "/b", 1) != -1)
        return err(34, "空方法应该被拒");
    if (r.add("G ET", "/b", 1) != -1)
        return err(35, "方法里的空格应该被拒");
    /* 容量：塞满 32 条之后返回 0（用新表，避免前面成功的那条占位） */
    {
        Router full = { 0 };

        for (i = 0; i < ROUTER_MAX; i++) {
            snprintf(pat, sizeof pat, "/r%d", i);
            if (full.add("GET", pat, i) != 1)
                return err(36, "填满路由表失败");
        }
        if (full.add("GET", "/overflow", 99) != 0)
            return err(37, "满了应该返回 0");
        if (full.count() != ROUTER_MAX)
            return err(38, "条数应该停在上限");
        if (!full.match(SS("GET"), SS("/r31"), &m) || m.id != 31)
            return err(39, "上限内的路由应该能命中");
    }
    if (r.add(0, "/x", 1) != -1 || r.add("GET", 0, 1) != -1
        || add(0, "GET", "/x", 1) != -1)
        return err(40, "空参数应该被拒");
}
